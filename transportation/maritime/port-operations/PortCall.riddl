// Port Operations - PortCall Entity
// // A port call is its own aggregate: one visit of one vessel to the port, from
// the request for a berth through to departure and charging. PortCallStatus
// enumerates its eight stages, which is why they live here -- a Berth is a
// fixed piece of quay that outlives every call made against it, and cannot
// meaningfully be "Arriving" or "Departing".
aggregate entity PortCall as flow is {
  type PortCallCommand is one of {
    PortCall.RequestBerth or PortCall.ConfirmBerthAssignment or PortCall.AssignPilot or PortCall.OrderTugs or PortCall.RecordVesselArrival or PortCall.RecordMooring or PortCall.StartCargoOperations or PortCall.CompleteCargoOperations or PortCall.RecordVesselDeparture or PortCall.GeneratePortCharges or PortCall.CancelPortCall
  } with {
    briefly "Port call command alternation"
    described as {
      |Commands accepted by the PortCall entity.
    }
  }
  type PortCallEvent is one of {
    PortCall.BerthRequested or PortCall.BerthAssignmentConfirmed or PortCall.PilotAssigned or PortCall.TugsOrdered or PortCall.VesselArrived or PortCall.MooringCompleted or PortCall.CargoOperationsStarted or PortCall.CargoOperationsCompleted or PortCall.VesselDeparted or PortCall.PortChargesGenerated or PortCall.PortCallCancelled
  } with {
    briefly "Port call event alternation"
    described as {
      |Events published by the PortCall entity.
    }
  }
  inlet PortCallCommands is type PortCallCommand  outlet PortCallEvents is type PortCallEvent
  query GetPortCall replies result PortCall.PortCallResult is  {
    portCallId: PortCallId with {
      briefly "ID"
      described as {
        |Identifier of the port call to retrieve.
      }
    }
  } with {
    briefly "Get port call"
    described as {
      |Retrieve port call data by identifier.
    }
  }
  result PortCallResult is  {
    portCallData: PortCall.RequestedStateData with {
      briefly "Port call data"
      described as {
        |The requested port call data.
      }
    }
  } with {
    briefly "Port call result"
    described as {
      |Result carrying the requested port call data.
    }
  }
  command RequestBerth is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    request: PortCallRequest with {
      briefly "Request"
      described as {
        |Port call request.
      }
    }
  } with {
    briefly "Request berth"
    described as {
      |Requests berth allocation for port call.
    }
  }
  command ConfirmBerthAssignment is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    assignment: BerthAssignment with {
      briefly "Assignment"
      described as {
        |Berth assignment details.
      }
    }
  } with {
    briefly "Confirm berth"
    described as {
      |Confirms berth assignment.
    }
  }
  command AssignPilot is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    pilotage: PilotageInfo with {
      briefly "Pilotage"
      described as {
        |Pilotage details.
      }
    }
  } with {
    briefly "Assign pilot"
    described as {
      |Assigns pilot for arrival.
    }
  }
  command OrderTugs is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    tugs: TugService with {
      briefly "Tugs"
      described as {
        |Tug service details.
      }
    }
  } with {
    briefly "Order tugs"
    described as {
      |Orders tug assistance.
    }
  }
  command RecordVesselArrival is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    arrivedAt: TimeStamp with {
      briefly "Arrived"
      described as {
        |Arrival time.
      }
    }
    actualDraft: Decimal(4,2) with {
      briefly "Draft"
      described as {
        |Actual draft.
      }
    }
  } with {
    briefly "Record arrival"
    described as {
      |Records vessel arrival.
    }
  }
  command RecordMooring is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    mooring: MooringOperation with {
      briefly "Mooring"
      described as {
        |Mooring details.
      }
    }
  } with {
    briefly "Record mooring"
    described as {
      |Records mooring completion.
    }
  }
  command StartCargoOperations is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    operation: CargoOperation with {
      briefly "Operation"
      described as {
        |Cargo operation details.
      }
    }
  } with {
    briefly "Start cargo operations"
    described as {
      |Starts cargo handling.
    }
  }
  command CompleteCargoOperations is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    completion: CargoOperation with {
      briefly "Completion"
      described as {
        |Completed operation.
      }
    }
  } with {
    briefly "Complete cargo operations"
    described as {
      |Completes cargo handling.
    }
  }
  command RecordVesselDeparture is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    departedAt: TimeStamp with {
      briefly "Departed"
      described as {
        |Departure time.
      }
    }
    nextPort: String(1,200) with {
      briefly "Next port"
      described as {
        |Next destination.
      }
    }
  } with {
    briefly "Record departure"
    described as {
      |Records vessel departure.
    }
  }
  command GeneratePortCharges is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    charges: PortCharges with {
      briefly "Charges"
      described as {
        |Port charges.
      }
    }
  } with {
    briefly "Generate charges"
    described as {
      |Generates port call charges.
    }
  }
  command CancelPortCall is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth identifier.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call identifier.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel port call"
    described as {
      |Cancels scheduled port call.
    }
  }
  event BerthRequested is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    request: PortCallRequest with {
      briefly "Request"
      described as {
        |Port call request.
      }
    }
    requestedAt: TimeStamp with {
      briefly "Requested"
      described as {
        |Request time.
      }
    }
  } with {
    briefly "Berth requested"
    described as {
      |Emitted when berth is requested.
    }
  }
  event BerthAssignmentConfirmed is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    assignment: BerthAssignment with {
      briefly "Assignment"
      described as {
        |Assignment details.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed"
      described as {
        |Confirmation time.
      }
    }
  } with {
    briefly "Berth confirmed"
    described as {
      |Emitted when berth is confirmed.
    }
  }
  event PilotAssigned is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    pilotage: PilotageInfo with {
      briefly "Pilotage"
      described as {
        |Pilotage details.
      }
    }
  } with {
    briefly "Pilot assigned"
    described as {
      |Emitted when pilot is assigned.
    }
  }
  event TugsOrdered is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    tugs: TugService with {
      briefly "Tugs"
      described as {
        |Tug details.
      }
    }
    orderedAt: TimeStamp with {
      briefly "Ordered"
      described as {
        |Order time.
      }
    }
  } with {
    briefly "Tugs ordered"
    described as {
      |Emitted when tugs are ordered.
    }
  }
  event VesselArrived is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    arrivedAt: TimeStamp with {
      briefly "Arrived"
      described as {
        |Arrival time.
      }
    }
  } with {
    briefly "Vessel arrived"
    described as {
      |Emitted when vessel arrives.
    }
  }
  event MooringCompleted is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    mooring: MooringOperation with {
      briefly "Mooring"
      described as {
        |Mooring details.
      }
    }
  } with {
    briefly "Mooring completed"
    described as {
      |Emitted when mooring is done.
    }
  }
  event CargoOperationsStarted is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    operation: CargoOperation with {
      briefly "Operation"
      described as {
        |Cargo operation.
      }
    }
  } with {
    briefly "Cargo operations started"
    described as {
      |Emitted when cargo handling starts.
    }
  }
  event CargoOperationsCompleted is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    operation: CargoOperation with {
      briefly "Operation"
      described as {
        |Cargo operation.
      }
    }
  } with {
    briefly "Cargo operations completed"
    described as {
      |Emitted when cargo handling completes.
    }
  }
  event VesselDeparted is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    departedAt: TimeStamp with {
      briefly "Departed"
      described as {
        |Departure time.
      }
    }
    nextPort: String(1,200) with {
      briefly "Next port"
      described as {
        |Next destination.
      }
    }
  } with {
    briefly "Vessel departed"
    described as {
      |Emitted when vessel departs.
    }
  }
  event PortChargesGenerated is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    charges: PortCharges with {
      briefly "Charges"
      described as {
        |Port charges.
      }
    }
    generatedAt: TimeStamp with {
      briefly "Generated"
      described as {
        |Generation time.
      }
    }
  } with {
    briefly "Port charges generated"
    described as {
      |Emitted when charges are calculated.
    }
  }
  event PortCallCancelled is  {
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |Berth ID.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |Port call ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Port call cancelled"
    described as {
      |Emitted when port call is cancelled.
    }
  }
  record RequestedStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Requested port call"
    described as {
      |A port call where a berth has been requested but not yet confirmed.
    }
  }
  record ConfirmedStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Confirmed port call"
    described as {
      |A port call where the berth assignment is confirmed and the vessel is expected.
    }
  }
  record ArrivingStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Arriving port call"
    described as {
      |A port call where pilot and tugs are arranged and the vessel is approaching.
    }
  }
  record BerthedStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Berthed port call"
    described as {
      |A port call where the vessel is moored alongside.
    }
  }
  record CargoOperationsStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "CargoOperations port call"
    described as {
      |A port call where cargo is being worked.
    }
  }
  record DepartingStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Departing port call"
    described as {
      |A port call where cargo work is complete and the vessel is unmooring.
    }
  }
  record CompletedStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Completed port call"
    described as {
      |A port call where the vessel has sailed and charges are raised.
    }
  }
  record CancelledStateData is  {
    stateValue: PortCallStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    portCallId: PortCallId with {
      briefly "Port call"
      described as {
        |The port call this state belongs to.
      }
    }
    berthId: BerthId with {
      briefly "Berth"
      described as {
        |The berth this call is made against.
      }
    }
  } with {
    briefly "Cancelled port call"
    described as {
      |A port call where the port call was abandoned.
    }
  }
  initial state RequestedState of record PortCall.RequestedStateData is {
    initial handler RequestedInitHandler is {
      on init is {
        set state RequestedState to "initialize from the preceding event"
        set field PortCall.RequestedStateData.stateValue to "Requested"
      }
    } with {
      briefly "Requested init handler"
      described as {
        |Initializes a port call on entry to the Requested state.
      }
    }
  } with {
    briefly "Requested state"
    described as {
      |A port call where a berth has been requested but not yet confirmed.
    }
  }
  state ConfirmedState of record PortCall.ConfirmedStateData is {
    initial handler ConfirmedInitHandler is {
      on init is {
        set state ConfirmedState to "initialize from the preceding event"
        set field PortCall.ConfirmedStateData.stateValue to "Confirmed"
      }
    } with {
      briefly "Confirmed init handler"
      described as {
        |Initializes a port call on entry to the Confirmed state.
      }
    }
  } with {
    briefly "Confirmed state"
    described as {
      |A port call where the berth assignment is confirmed and the vessel is expected.
    }
  }
  state ArrivingState of record PortCall.ArrivingStateData is {
    initial handler ArrivingInitHandler is {
      on init is {
        set state ArrivingState to "initialize from the preceding event"
        set field PortCall.ArrivingStateData.stateValue to "Arriving"
      }
    } with {
      briefly "Arriving init handler"
      described as {
        |Initializes a port call on entry to the Arriving state.
      }
    }
  } with {
    briefly "Arriving state"
    described as {
      |A port call where pilot and tugs are arranged and the vessel is approaching.
    }
  }
  state BerthedState of record PortCall.BerthedStateData is {
    initial handler BerthedInitHandler is {
      on init is {
        set state BerthedState to "initialize from the preceding event"
        set field PortCall.BerthedStateData.stateValue to "Berthed"
      }
    } with {
      briefly "Berthed init handler"
      described as {
        |Initializes a port call on entry to the Berthed state.
      }
    }
  } with {
    briefly "Berthed state"
    described as {
      |A port call where the vessel is moored alongside.
    }
  }
  state CargoOperationsState of record PortCall.CargoOperationsStateData is {
    initial handler CargoOperationsInitHandler is {
      on init is {
        set state CargoOperationsState to "initialize from the preceding event"
        set field PortCall.CargoOperationsStateData.stateValue to "CargoOperations"
      }
    } with {
      briefly "CargoOperations init handler"
      described as {
        |Initializes a port call on entry to the CargoOperations state.
      }
    }
  } with {
    briefly "CargoOperations state"
    described as {
      |A port call where cargo is being worked.
    }
  }
  state DepartingState of record PortCall.DepartingStateData is {
    initial handler DepartingInitHandler is {
      on init is {
        set state DepartingState to "initialize from the preceding event"
        set field PortCall.DepartingStateData.stateValue to "Departing"
      }
    } with {
      briefly "Departing init handler"
      described as {
        |Initializes a port call on entry to the Departing state.
      }
    }
  } with {
    briefly "Departing state"
    described as {
      |A port call where cargo work is complete and the vessel is unmooring.
    }
  }
  state CompletedState of record PortCall.CompletedStateData is {
    initial handler CompletedInitHandler is {
      on init is {
        set state CompletedState to "initialize from the preceding event"
        set field PortCall.CompletedStateData.stateValue to "Completed"
      }
      on query GetPortCall is {
        let portCallResult: type PortCall.PortCallResult = prompt("read the port call from the store")
        reply portCallResult
      }
      on other is {
        error "a completed port call is read-only; it reports itself but accepts no changes"
      }
    } with {
      briefly "Completed init handler"
      described as {
        |Initializes a port call on entry to the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |A port call where the vessel has sailed and charges are raised.
    }
  }
  state CancelledState of record PortCall.CancelledStateData is {
    initial handler CancelledInitHandler is {
      on init is {
        set state CancelledState to "initialize from the preceding event"
        set field PortCall.CancelledStateData.stateValue to "Cancelled"
      }
      on other is {
        error "the port call was cancelled and accepts no further activity"
      }
    } with {
      briefly "Cancelled init handler"
      described as {
        |Initializes a port call on entry to the Cancelled state.
      }
    }
  } with {
    briefly "Cancelled state"
    described as {
      |A port call where the port call was abandoned.
    }
  }
  handler PortCallHandler is {
    on query GetPortCall is {
      let portCallResult: type PortCall.PortCallResult = prompt("read the port call from the store")
      reply portCallResult
    }
    on requestBerth: command RequestBerth is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.RequestedState with record PortCall.RequestedStateData(berthId = requestBerth.berthId, stateValue = prompt("the state value of this requested state data"), portCallId = prompt("the port call id of this requested state data"))
      send event PortCall.BerthRequested(berthId = requestBerth.berthId, request = requestBerth.request, requestedAt = prompt("the requested at of this berth requested")) to outlet PortCallEvents
    }
    on confirmBerthAssignment: command ConfirmBerthAssignment is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.ConfirmedState with record PortCall.ConfirmedStateData(portCallId = confirmBerthAssignment.portCallId, berthId = confirmBerthAssignment.berthId, stateValue = prompt("the state value of this confirmed state data"))
      send event PortCall.BerthAssignmentConfirmed(berthId = confirmBerthAssignment.berthId, portCallId = confirmBerthAssignment.portCallId, assignment = confirmBerthAssignment.assignment, confirmedAt = prompt("the confirmed at of this berth assignment confirmed")) to outlet PortCallEvents
    }
    on assignPilot: command AssignPilot is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.ArrivingState with record PortCall.ArrivingStateData(portCallId = assignPilot.portCallId, berthId = assignPilot.berthId, stateValue = prompt("the state value of this arriving state data"))
      send event PortCall.PilotAssigned(berthId = assignPilot.berthId, portCallId = assignPilot.portCallId, pilotage = assignPilot.pilotage) to outlet PortCallEvents
    }
    on command PortCall.OrderTugs is {
      let tugsOrdered: type PortCall.TugsOrdered = prompt("the tugs ordered that results from order tugs")
    }
    on recordVesselArrival: command RecordVesselArrival is {
      send event PortCall.VesselArrived(berthId = recordVesselArrival.berthId, portCallId = recordVesselArrival.portCallId, arrivedAt = recordVesselArrival.arrivedAt) to outlet PortCallEvents
    }
    on recordMooring: command RecordMooring is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.BerthedState with record PortCall.BerthedStateData(portCallId = recordMooring.portCallId, berthId = recordMooring.berthId, stateValue = prompt("the state value of this berthed state data"))
      send event PortCall.MooringCompleted(berthId = recordMooring.berthId, portCallId = recordMooring.portCallId, mooring = recordMooring.mooring) to outlet PortCallEvents
    }
    on startCargoOperations: command StartCargoOperations is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.CargoOperationsState with record PortCall.CargoOperationsStateData(portCallId = startCargoOperations.portCallId, berthId = startCargoOperations.berthId, stateValue = prompt("the state value of this cargo operations state data"))
      send event PortCall.CargoOperationsStarted(berthId = startCargoOperations.berthId, portCallId = startCargoOperations.portCallId, operation = startCargoOperations.operation) to outlet PortCallEvents
    }
    on completeCargoOperations: command CompleteCargoOperations is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.DepartingState with record PortCall.DepartingStateData(portCallId = completeCargoOperations.portCallId, berthId = completeCargoOperations.berthId, stateValue = prompt("the state value of this departing state data"))
      send event PortCall.CargoOperationsCompleted(berthId = completeCargoOperations.berthId, portCallId = completeCargoOperations.portCallId, operation = prompt("the operation of this cargo operations completed")) to outlet PortCallEvents
    }
    on recordVesselDeparture: command RecordVesselDeparture is {
      send event PortCall.VesselDeparted(berthId = recordVesselDeparture.berthId, portCallId = recordVesselDeparture.portCallId, departedAt = recordVesselDeparture.departedAt, nextPort = recordVesselDeparture.nextPort) to outlet PortCallEvents
    }
    on generatePortCharges: command GeneratePortCharges is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.CompletedState with record PortCall.CompletedStateData(portCallId = generatePortCharges.portCallId, berthId = generatePortCharges.berthId, stateValue = prompt("the state value of this completed state data"))
      send event PortCall.PortChargesGenerated(berthId = generatePortCharges.berthId, portCallId = generatePortCharges.portCallId, charges = generatePortCharges.charges, generatedAt = prompt("the generated at of this port charges generated")) to outlet PortCallEvents
    }
    on cancelPortCall: command CancelPortCall is {
      morph entity BerthContext.PortCall to state BerthContext.PortCall.CancelledState with record PortCall.CancelledStateData(portCallId = cancelPortCall.portCallId, berthId = cancelPortCall.berthId, stateValue = prompt("the state value of this cancelled state data"))
      send event PortCall.PortCallCancelled(berthId = cancelPortCall.berthId, portCallId = cancelPortCall.portCallId, reason = cancelPortCall.reason, cancelledAt = prompt("the cancelled at of this port call cancelled")) to outlet PortCallEvents
    }
  } with {
    briefly "Port call command handler"
    described as {
      |Walks a port call through its eight stages, from the berth request to
      |departure and charging, or to cancellation.
    }
  }
} with {
  briefly "A vessel's call at the port"
  described as {
    |One visit of one vessel: berth request, confirmation, arrival, mooring,
    |cargo work, departure and charges. Its own aggregate, because a berth
    |outlives every call made against it.
  }
}
