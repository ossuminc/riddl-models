// Port Operations Domain Model
// Maritime port terminal and berth management
domain PortOperations is {
  persistent connector 'VesselTrafficServiceReply Stream' is from outlet VesselTrafficService.VesselTrafficServiceRepliesOut to inlet BerthContext.ToVesselTrafficService.ToVesselTrafficServiceReplies with {
    briefly "What VesselTrafficService answers BerthContext"
  }
  persistent connector 'TowageServiceReply Stream' is from outlet TowageService.TowageServiceRepliesOut to inlet BerthContext.ToTowageService.ToTowageServiceReplies with {
    briefly "What TowageService answers BerthContext"
  }
  persistent connector 'TerminalOperatingSystemReply Stream' is from outlet TerminalOperatingSystem.TerminalOperatingSystemRepliesOut to inlet BerthContext.ToTerminalOperatingSystem.ToTerminalOperatingSystemReplies with {
    briefly "What TerminalOperatingSystem answers BerthContext"
  }
  persistent connector 'PilotCoordinationServiceReply Stream' is from outlet PilotCoordinationService.PilotCoordinationServiceRepliesOut to inlet BerthContext.ToPilotCoordinationService.ToPilotCoordinationServiceReplies with {
    briefly "What PilotCoordinationService answers BerthContext"
  }
  persistent connector 'CustomsServiceEvent Stream' is from outlet CustomsService.CustomsServiceEventsOut to inlet BerthContext.FromCustomsService.FromCustomsServiceIn with {
    briefly "What CustomsService tells BerthContext, unasked"
  }
  persistent connector 'PilotCoordinationServiceEvent Stream' is from outlet PilotCoordinationService.PilotCoordinationServiceEventsOut to inlet BerthContext.FromPilotCoordinationService.FromPilotCoordinationServiceIn with {
    briefly "What PilotCoordinationService tells BerthContext, unasked"
  }
  persistent connector 'PortBillingServiceEvent Stream' is from outlet PortBillingService.PortBillingServiceEventsOut to inlet BerthContext.FromPortBillingService.FromPortBillingServiceIn with {
    briefly "What PortBillingService tells BerthContext, unasked"
  }
  persistent connector 'TerminalOperatingSystemEvent Stream' is from outlet TerminalOperatingSystem.TerminalOperatingSystemEventsOut to inlet BerthContext.FromTerminalOperatingSystem.FromTerminalOperatingSystemIn with {
    briefly "What TerminalOperatingSystem tells BerthContext, unasked"
  }
  persistent connector 'TowageServiceEvent Stream' is from outlet TowageService.TowageServiceEventsOut to inlet BerthContext.FromTowageService.FromTowageServiceIn with {
    briefly "What TowageService tells BerthContext, unasked"
  }
  persistent connector 'VesselTrafficServiceEvent Stream' is from outlet VesselTrafficService.VesselTrafficServiceEventsOut to inlet BerthContext.FromVesselTrafficService.FromVesselTrafficServiceIn with {
    briefly "What VesselTrafficService tells BerthContext, unasked"
  }
  persistent connector 'VesselTrafficServiceRequest Stream' is from outlet BerthContext.ToVesselTrafficService.ToVesselTrafficServiceOut to inlet VesselTrafficService.VesselTrafficServiceRequests with {
    briefly "What BerthContext asks VesselTrafficService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PortOperator is "person managing port operations" with {
    briefly "Port Operator"
    described as {
      |Staff managing terminal operations.
    }
  }
  user VesselAgent is "person representing vessel interests" with {
    briefly "Vessel Agent"
    described as {
      |Agent handling vessel port calls.
    }
  }
  user HarborMaster is "person overseeing port safety" with {
    briefly "Harbor Master"
    described as {
      |Official overseeing maritime safety.
    }
  }
  epic PortEpic is {
    user VesselAgent wants to "to schedule vessel port calls" so that "cargo can be loaded and unloaded"
    case SchedulePortCall is {
      user VesselAgent wants to "to book a berth for vessel arrival" so that "the vessel can dock safely"
      step is "Agent submits" "port call request" "with vessel details" with {
        briefly "Submit request"
        described as {
          |Request berth allocation.
        }
      }
      step take input PortOperationsApp.PortOperationsScreen.RequestBerthInput from user VesselAgent with {
        briefly "Request berth"
        described as {
          |Allocate berth.
        }
      }
      step is "Port assigns" "berth and services" "based on availability" with {
        briefly "Assign berth"
        described as {
          |Allocate resources.
        }
      }
    } with {
      briefly "Schedule port call"
      described as {
        |Vessel port call scheduling workflow.
      }
    }
  } with {
    briefly "Port operations"
    described as {
      | Epic covering berth allocation, cargo handling,
      | and vessel services.
    }
  }
  include "BerthContext.riddl"
  include "external-contexts.riddl"
  application context PortOperationsApp as split is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PortOperations are delivered.
      }
    }
    outlet AppPortCallCommands is type BerthContext.PortCall.PortCallCommand
    group PortOperationsScreen is {
      input RequestBerthInput acquires command BerthContext.PortCall.RequestBerth with {
        briefly "Request berth control"
        described as {
          |The control through which a user submits the request berth request.
        }
      }
    } with {
      briefly "Port operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppBerthCommands is type BerthContext.Berth.BerthCommand
    inlet AppBerthRepositoryResponses is result BerthContext.Berth.BerthResult    handler PortOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context PortOperationsApp"
      }
    } with {
      briefly "PortOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PortOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TowageServiceRequest Stream' is from outlet BerthContext.ToTowageService.ToTowageServiceOut to inlet TowageService.TowageServiceRequests with {
    briefly "What BerthContext asks TowageService to send"
  }
  persistent connector 'TerminalOperatingSystemRequest Stream' is from outlet BerthContext.ToTerminalOperatingSystem.ToTerminalOperatingSystemOut to inlet TerminalOperatingSystem.TerminalOperatingSystemRequests with {
    briefly "What BerthContext asks TerminalOperatingSystem to send"
  }
  persistent connector 'PilotCoordinationServiceRequest Stream' is from outlet BerthContext.ToPilotCoordinationService.ToPilotCoordinationServiceOut to inlet PilotCoordinationService.PilotCoordinationServiceRequests with {
    briefly "What BerthContext asks PilotCoordinationService to send"
  }
  persistent connector 'CustomsServiceRequest Stream' is from outlet BerthContext.ToCustomsService.ToCustomsServiceOut to inlet CustomsService.CustomsServiceRequests with {
    briefly "What BerthContext asks CustomsService to send"
  }
  persistent connector 'PortBillingServiceRequest Stream' is from outlet BerthContext.ToPortBillingService.ToPortBillingServiceOut to inlet PortBillingService.PortBillingServiceRequests with {
    briefly "What BerthContext asks PortBillingService to send"
  }
  persistent connector 'PortCallCommand Stream' is from outlet PortOperationsApp.AppPortCallCommands to inlet BerthContext.PortCallCommandStreamIn with {
    briefly "Application commands to port call"
    described as {
      |Carries port call commands from the application.
    }
  }
  persistent connector 'BerthCommand Stream' is from outlet PortOperationsApp.AppBerthCommands to inlet BerthContext.BerthCommandStreamIn with {
    briefly "Berth commands from the application"
  }
  persistent connector 'BerthResult Stream' is from outlet BerthContext.BerthResultStreamOut to inlet PortOperationsApp.AppBerthRepositoryResponses with {
    briefly "Berth query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PortOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Port operations domain"
  described as {
    | The PortOperations domain handles maritime
    | terminal and berth management.
  }
}
