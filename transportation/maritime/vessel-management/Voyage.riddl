// Vessel Management - Voyage Entity
// // A voyage is its own aggregate. Its lifecycle -- planned, under way, complete
// or cancelled -- is what VoyageStatus enumerates, and it belongs here rather
// than on Vessel: a vessel is not "Planned", and it outlives any one voyage.
aggregate entity Voyage as flow is {
  type VoyageCommand is one of {
    Voyage.CreateVoyage or Voyage.UpdateVoyage or Voyage.RecordPortArrival or Voyage.RecordPortDeparture or Voyage.CompleteVoyage or Voyage.CancelVoyage
  } with {
    briefly "Voyage command alternation"
    described as {
      |Commands accepted by the Voyage entity.
    }
  }
  type VoyageEvent is one of {
    Voyage.VoyageCreated or Voyage.VoyageUpdated or Voyage.PortArrivalRecorded or Voyage.PortDepartureRecorded or Voyage.VoyageCompleted or Voyage.VoyageCancelled
  } with {
    briefly "Voyage event alternation"
    described as {
      |Events published by the Voyage entity.
    }
  }
  inlet VoyageCommands is type VoyageCommand  outlet VoyageEvents is type VoyageEvent
  query GetVoyage replies result Voyage.VoyageResult is {
    voyageId: VoyageId with {
      briefly "ID"
      described as {
        |Identifier of the Voyage to retrieve.
      }
    }
  } with {
    briefly "Get Voyage"
    described as {
      |Retrieve Voyage data by identifier.
    }
  }
  result VoyageResult is {
    voyageData: Voyage.PlannedStateData with {
      briefly "Voyage data"
      described as {
        |The requested Voyage data.
      }
    }
  } with {
    briefly "Voyage result"
    described as {
      |Result carrying the requested Voyage data.
    }
  }
  command CreateVoyage is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage being planned.
      }
    }
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |The vessel that will sail it.
      }
    }
    details: VoyageDetails with {
      briefly "Details"
      described as {
        |Route, voyage number and commencement date.
      }
    }
  } with {
    briefly "Plan a voyage"
    described as {
      |Creates a voyage in the planned state.
    }
  }
  command UpdateVoyage is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage being amended.
      }
    }
    details: VoyageDetails with {
      briefly "Details"
      described as {
        |The amended voyage details.
      }
    }
  } with {
    briefly "Amend a voyage"
    described as {
      |Changes the details of a voyage.
    }
  }
  command RecordPortArrival is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage arriving.
      }
    }
    portCall: PortCallInfo with {
      briefly "Port call"
      described as {
        |The arrival being recorded.
      }
    }
  } with {
    briefly "Record an arrival"
    described as {
      |Records the vessel's arrival at a port on this voyage. The first
      |arrival is what puts the voyage under way.
    }
  }
  command RecordPortDeparture is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage departing.
      }
    }
    portCall: PortCallInfo with {
      briefly "Port call"
      described as {
        |The departure being recorded.
      }
    }
  } with {
    briefly "Record a departure"
    described as {
      |Records the vessel's departure from a port on this voyage.
    }
  }
  command CompleteVoyage is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage being completed.
      }
    }
    completedAt: Date with {
      briefly "Completed"
      described as {
        |When the voyage ended.
      }
    }
  } with {
    briefly "Complete a voyage"
    described as {
      |Closes a voyage that has reached its final port.
    }
  }
  command CancelVoyage is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage being cancelled.
      }
    }
    cancellationReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Why the voyage was cancelled.
      }
    }
  } with {
    briefly "Cancel a voyage"
    described as {
      |Abandons a voyage, whether or not it has begun.
    }
  }
  event VoyageCreated is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage that was planned.
      }
    }
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |The vessel assigned to it.
      }
    }
  } with {
    briefly "A voyage was planned"
    described as {
      |Records that a voyage came into existence.
    }
  }
  event VoyageUpdated is {
    vesselId: VesselId with {
      briefly "Vessel addressed"
      described as {
        |Which vessel this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage that was amended.
      }
    }
  } with {
    briefly "A voyage was amended"
    described as {
      |Records a change to voyage details.
    }
  }
  event PortArrivalRecorded is {
    vesselId: VesselId with {
      briefly "Vessel addressed"
      described as {
        |Which vessel this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage that arrived.
      }
    }
  } with {
    briefly "An arrival was recorded"
    described as {
      |Records the vessel's arrival at a port on this voyage.
    }
  }
  event PortDepartureRecorded is {
    vesselId: VesselId with {
      briefly "Vessel addressed"
      described as {
        |Which vessel this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage that departed.
      }
    }
  } with {
    briefly "A departure was recorded"
    described as {
      |Records the vessel's departure from a port on this voyage.
    }
  }
  event VoyageCompleted is {
    vesselId: VesselId with {
      briefly "Vessel addressed"
      described as {
        |Which vessel this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage that ended.
      }
    }
  } with {
    briefly "A voyage completed"
    described as {
      |Records that a voyage reached its final port.
    }
  }
  event VoyageCancelled is {
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage that was abandoned.
      }
    }
  } with {
    briefly "A voyage was cancelled"
    described as {
      |Records that a voyage was abandoned.
    }
  }
  record PlannedStateData is {
    stateValue: VoyageStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage this state belongs to.
      }
    }
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |The vessel assigned to it.
      }
    }
    details: VoyageDetails with {
      briefly "Details"
      described as {
        |Route, voyage number and commencement date.
      }
    }
  } with {
    briefly "Planned voyage"
    described as {
      |A voyage that has been planned but has not yet begun.
    }
  }
  record InProgressStateData is {
    stateValue: VoyageStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage this state belongs to.
      }
    }
    currentPort: PortCallInfo with {
      briefly "Current port"
      described as {
        |The most recent port call on this voyage.
      }
    }
  } with {
    briefly "Voyage under way"
    described as {
      |A voyage that has begun and has not yet ended.
    }
  }
  record CompletedStateData is {
    stateValue: VoyageStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage this state belongs to.
      }
    }
    completedAt: Date with {
      briefly "Completed"
      described as {
        |When the voyage ended.
      }
    }
  } with {
    briefly "Completed voyage"
    described as {
      |A voyage that reached its final port.
    }
  }
  record CancelledStateData is {
    stateValue: VoyageStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    voyageId: VoyageId with {
      briefly "Voyage"
      described as {
        |The voyage this state belongs to.
      }
    }
    cancellationReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Why the voyage was cancelled.
      }
    }
  } with {
    briefly "Cancelled voyage"
    described as {
      |A voyage abandoned before completion.
    }
  }
  initial state PlannedState of record Voyage.PlannedStateData is {
    initial handler PlannedInitHandler is {
      on init is {
        set state PlannedState to "initialize from the creating message"
        set field Voyage.PlannedStateData.stateValue to "Planned"
      }
    } with {
      briefly "Planned init handler"
      described as {
        |Initializes a voyage on entry to the planned state.
      }
    }
  } with {
    briefly "Planned state"
    described as {
      |The voyage is scheduled but has not sailed.
    }
  }
  state InProgressState of record Voyage.InProgressStateData is {
    initial handler InProgressInitHandler is {
      on init is {
        set state InProgressState to "initialize from the first arrival"
        set field Voyage.InProgressStateData.stateValue to "InProgress"
      }
    } with {
      briefly "In-progress init handler"
      described as {
        |Initializes a voyage on entry to the under-way state.
      }
    }
  } with {
    briefly "In-progress state"
    described as {
      |The voyage is under way and calling at ports.
    }
  }
  state CompletedState of record Voyage.CompletedStateData is {
    initial handler CompletedInitHandler is {
      on init is {
        set state CompletedState to "initialize from the completion event"
        set field Voyage.CompletedStateData.stateValue to "Completed"
      }
      on query GetVoyage is {
        let voyageResult: type Voyage.VoyageResult = prompt("read the voyage from the store")
        reply voyageResult
      }
      on other is {
        error "a completed voyage is read-only; it reports itself but accepts no changes"
      }
    } with {
      briefly "Completed init handler"
      described as {
        |Initializes a completed voyage. Readable, but immovable.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |The voyage reached its final port. Terminal but readable.
    }
  }
  state CancelledState of record Voyage.CancelledStateData is {
    initial handler CancelledInitHandler is {
      on init is {
        set state CancelledState to "initialize from the cancellation event"
        set field Voyage.CancelledStateData.stateValue to "Cancelled"
      }
      on other is {
        error "the voyage is cancelled and accepts no further activity"
      }
    } with {
      briefly "Cancelled init handler"
      described as {
        |Initializes a cancelled voyage and refuses everything thereafter.
      }
    }
  } with {
    briefly "Cancelled state"
    described as {
      |The voyage was abandoned. Terminal.
    }
  }
  handler VoyageHandler is {
    on query GetVoyage is {
      let voyageResult: type Voyage.VoyageResult = prompt("read the voyage from the store")
      reply voyageResult
    }
    on createVoyage: command CreateVoyage is {
      morph entity VesselContext.Voyage to state VesselContext.Voyage.PlannedState with record Voyage.PlannedStateData(voyageId = createVoyage.voyageId, vesselId = createVoyage.vesselId, details = createVoyage.details, stateValue = prompt("the state value of this planned state data"))
      send event Voyage.VoyageCreated(voyageId = createVoyage.voyageId, vesselId = createVoyage.vesselId) to outlet VoyageEvents
    }
    on updateVoyage: command UpdateVoyage is {
      send event Voyage.VoyageUpdated(voyageId = updateVoyage.voyageId, vesselId = prompt("the vessel id of this voyage updated")) to outlet VoyageEvents
    }
    on recordPortArrival: command RecordPortArrival is {
      morph entity VesselContext.Voyage to state VesselContext.Voyage.InProgressState with record Voyage.InProgressStateData(voyageId = recordPortArrival.voyageId, stateValue = prompt("the state value of this in progress state data"), currentPort = prompt("the current port of this in progress state data"))
      send event Voyage.PortArrivalRecorded(voyageId = recordPortArrival.voyageId, vesselId = prompt("the vessel id of this port arrival recorded")) to outlet VoyageEvents
    }
    on recordPortDeparture: command RecordPortDeparture is {
      send event Voyage.PortDepartureRecorded(voyageId = recordPortDeparture.voyageId, vesselId = prompt("the vessel id of this port departure recorded")) to outlet VoyageEvents
    }
    on completeVoyage: command CompleteVoyage is {
      morph entity VesselContext.Voyage to state VesselContext.Voyage.CompletedState with record Voyage.CompletedStateData(voyageId = completeVoyage.voyageId, completedAt = completeVoyage.completedAt, stateValue = prompt("the state value of this completed state data"))
      send event Voyage.VoyageCompleted(voyageId = completeVoyage.voyageId, vesselId = prompt("the vessel id of this voyage completed")) to outlet VoyageEvents
    }
    on cancelVoyage: command CancelVoyage is {
      morph entity VesselContext.Voyage to state VesselContext.Voyage.CancelledState with record Voyage.CancelledStateData(voyageId = cancelVoyage.voyageId, cancellationReason = cancelVoyage.cancellationReason, stateValue = prompt("the state value of this cancelled state data"))
      send event Voyage.VoyageCancelled(voyageId = cancelVoyage.voyageId) to outlet VoyageEvents
    }
  } with {
    briefly "Voyage command handler"
    described as {
      |Walks a voyage through its lifecycle: planned, under way on first
      |arrival, then either completed or cancelled.
    }
  }
} with {
  briefly "A vessel voyage"
  described as {
    |One passage of a vessel from commencement to final port. Its own
    |aggregate: a vessel outlives any voyage, and VoyageStatus describes
    |the voyage rather than the ship.
  }
}
