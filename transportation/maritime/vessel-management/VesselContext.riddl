// Vessel Management - Vessel Context
context VesselContext as router is {
  inlet VoyageCommandStreamIn is type VoyageCommand  outlet VoyageCommandStreamOut is type VoyageCommand
  inlet VesselCommandStreamIn is type VesselCommand  outlet VesselCommandStreamOut is type VesselCommand
  inlet VesselResultStreamIn is result Vessel.VesselResult  outlet VesselResultStreamOut is result Vessel.VesselResult
  handler VesselContextBoundary is {
    on createVoyage: command Voyage.CreateVoyage is {
      send createVoyage to outlet VesselContext.VoyageCommandStreamOut
    }
    on updateVoyage: command Voyage.UpdateVoyage is {
      send updateVoyage to outlet VesselContext.VoyageCommandStreamOut
    }
    on recordPortArrival: command Voyage.RecordPortArrival is {
      send recordPortArrival to outlet VesselContext.VoyageCommandStreamOut
    }
    on recordPortDeparture: command Voyage.RecordPortDeparture is {
      send recordPortDeparture to outlet VesselContext.VoyageCommandStreamOut
    }
    on completeVoyage: command Voyage.CompleteVoyage is {
      send completeVoyage to outlet VesselContext.VoyageCommandStreamOut
    }
    on cancelVoyage: command Voyage.CancelVoyage is {
      send cancelVoyage to outlet VesselContext.VoyageCommandStreamOut
    }
    on registerVessel: command Vessel.RegisterVessel is {
      send registerVessel to outlet VesselContext.VesselCommandStreamOut
    }
    on updateSpecifications: command Vessel.UpdateSpecifications is {
      send updateSpecifications to outlet VesselContext.VesselCommandStreamOut
    }
    on updatePosition: command Vessel.UpdatePosition is {
      send updatePosition to outlet VesselContext.VesselCommandStreamOut
    }
    on addCrewMember: command Vessel.AddCrewMember is {
      send addCrewMember to outlet VesselContext.VesselCommandStreamOut
    }
    on removeCrewMember: command Vessel.RemoveCrewMember is {
      send removeCrewMember to outlet VesselContext.VesselCommandStreamOut
    }
    on addCertificate: command Vessel.AddCertificate is {
      send addCertificate to outlet VesselContext.VesselCommandStreamOut
    }
    on renewCertificate: command Vessel.RenewCertificate is {
      send renewCertificate to outlet VesselContext.VesselCommandStreamOut
    }
    on submitBunkerReport: command Vessel.SubmitBunkerReport is {
      send submitBunkerReport to outlet VesselContext.VesselCommandStreamOut
    }
    on recordMaintenance: command Vessel.RecordMaintenance is {
      send recordMaintenance to outlet VesselContext.VesselCommandStreamOut
    }
    on setVesselStatus: command Vessel.SetVesselStatus is {
      send setVesselStatus to outlet VesselContext.VesselCommandStreamOut
    }
    on vesselResult: result Vessel.VesselResult is {
      send vesselResult to outlet VesselContext.VesselResultStreamOut
    }
    on other is {
      error "Unexpected message at the VesselContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'VoyageEvent Feed' is from outlet VesselContext.Voyage.VoyageEvents to inlet VesselContext.FleetAnalytics.FleetAnalyticsFromVoyage with {
    briefly "Voyage events feeding the FleetAnalytics projection"
  }
  connector 'VoyageCommand Stream Intake' is from outlet VesselContext.VoyageCommandStreamOut to inlet VesselContext.Voyage.VoyageCommands  connector 'VesselCommand Stream Intake' is from outlet VesselContext.VesselCommandStreamOut to inlet VesselContext.Vessel.VesselCommands  connector 'VesselResult Stream Egress' is from outlet VesselContext.VesselRepository.VesselRepositoryResponses to inlet VesselContext.VesselResultStreamIn  adaptor FromAISService from context AISService is { 
    handler FromAISServiceHandler is {
      on event AISService.GeofenceAlert is {
        do "the model receives geofence alert"
      }
      on event AISService.PositionReportReceived is {
        do "the model receives position report received"
      }
      on result AISService.VesselAISResult is {
        do "the model receives vessel ais result"
      }
      on other is {
        error "Unexpected message for adaptor FromAISService"
      }
    } with {
      briefly "from ais service"
      described as {
        |Carries messages from the external AISService.
      }
    }
  } with {
    briefly "AISService integration"
    described as {
      |The model's side of the AISService conversation.
    }
  }
  adaptor ToAISService to context AISService is { 
    handler ToAISServiceHandler is {
      on query AISService.GetVesselAIS is {
        do "the model sends get vessel ais"
      }
      on other is {
        error "Unexpected message for adaptor ToAISService"
      }
    } with {
      briefly "to ais service"
      described as {
        |Carries messages to the external AISService.
      }
    }
  } with {
    briefly "AISService integration"
    described as {
      |The model's side of the AISService conversation.
    }
  }
  adaptor FromBunkerSupplierService from context BunkerSupplierService is { 
    handler FromBunkerSupplierServiceHandler is {
      on result BunkerSupplierService.BunkerAvailabilityResult is {
        do "the model receives bunker availability result"
      }
      on event BunkerSupplierService.BunkerDelivered is {
        do "the model receives bunker delivered"
      }
      on event BunkerSupplierService.BunkerOrderConfirmed is {
        do "the model receives bunker order confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromBunkerSupplierService"
      }
    } with {
      briefly "from bunker supplier service"
      described as {
        |Carries messages from the external BunkerSupplierService.
      }
    }
  } with {
    briefly "BunkerSupplierService integration"
    described as {
      |The model's side of the BunkerSupplierService conversation.
    }
  }
  adaptor ToBunkerSupplierService to context BunkerSupplierService is { 
    handler ToBunkerSupplierServiceHandler is {
      on query BunkerSupplierService.GetBunkerAvailability is {
        do "the model sends get bunker availability"
      }
      on command BunkerSupplierService.OrderBunkers is {
        do "the model sends order bunkers"
      }
      on other is {
        error "Unexpected message for adaptor ToBunkerSupplierService"
      }
    } with {
      briefly "to bunker supplier service"
      described as {
        |Carries messages to the external BunkerSupplierService.
      }
    }
  } with {
    briefly "BunkerSupplierService integration"
    described as {
      |The model's side of the BunkerSupplierService conversation.
    }
  }
  adaptor FromCharterPartyService from context CharterPartyService is { 
    handler FromCharterPartyServiceHandler is {
      on event CharterPartyService.CharterCommenced is {
        do "the model receives charter commenced"
      }
      on result CharterPartyService.CharterPartyResult is {
        do "the model receives charter party result"
      }
      on event CharterPartyService.CharterTerminated is {
        do "the model receives charter terminated"
      }
      on other is {
        error "Unexpected message for adaptor FromCharterPartyService"
      }
    } with {
      briefly "from charter party service"
      described as {
        |Carries messages from the external CharterPartyService.
      }
    }
  } with {
    briefly "CharterPartyService integration"
    described as {
      |The model's side of the CharterPartyService conversation.
    }
  }
  adaptor ToCharterPartyService to context CharterPartyService is { 
    handler ToCharterPartyServiceHandler is {
      on query CharterPartyService.GetCharterParty is {
        do "the model sends get charter party"
      }
      on other is {
        error "Unexpected message for adaptor ToCharterPartyService"
      }
    } with {
      briefly "to charter party service"
      described as {
        |Carries messages to the external CharterPartyService.
      }
    }
  } with {
    briefly "CharterPartyService integration"
    described as {
      |The model's side of the CharterPartyService conversation.
    }
  }
  adaptor FromClassificationSocietyService from context ClassificationSocietyService is { 
    handler FromClassificationSocietyServiceHandler is {
      on event ClassificationSocietyService.CertificateIssued is {
        do "the model receives certificate issued"
      }
      on result ClassificationSocietyService.CertificateStatusResult is {
        do "the model receives certificate status result"
      }
      on event ClassificationSocietyService.ClassSuspended is {
        do "the model receives class suspended"
      }
      on event ClassificationSocietyService.SurveyDue is {
        do "the model receives survey due"
      }
      on other is {
        error "Unexpected message for adaptor FromClassificationSocietyService"
      }
    } with {
      briefly "from classification society service"
      described as {
        |Carries messages from the external ClassificationSocietyService.
      }
    }
  } with {
    briefly "ClassificationSocietyService integration"
    described as {
      |The model's side of the ClassificationSocietyService conversation.
    }
  }
  adaptor ToClassificationSocietyService to context ClassificationSocietyService is { 
    handler ToClassificationSocietyServiceHandler is {
      on query ClassificationSocietyService.GetCertificateStatus is {
        do "the model sends get certificate status"
      }
      on other is {
        error "Unexpected message for adaptor ToClassificationSocietyService"
      }
    } with {
      briefly "to classification society service"
      described as {
        |Carries messages to the external ClassificationSocietyService.
      }
    }
  } with {
    briefly "ClassificationSocietyService integration"
    described as {
      |The model's side of the ClassificationSocietyService conversation.
    }
  }
  adaptor FromCrewManagementService from context CrewManagementService is { 
    handler FromCrewManagementServiceHandler is {
      on result CrewManagementService.AvailableCrewResult is {
        do "the model receives available crew result"
      }
      on event CrewManagementService.CertificateExpiring is {
        do "the model receives certificate expiring"
      }
      on event CrewManagementService.CrewChangeConfirmed is {
        do "the model receives crew change confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromCrewManagementService"
      }
    } with {
      briefly "from crew management service"
      described as {
        |Carries messages from the external CrewManagementService.
      }
    }
  } with {
    briefly "CrewManagementService integration"
    described as {
      |The model's side of the CrewManagementService conversation.
    }
  }
  adaptor ToCrewManagementService to context CrewManagementService is { 
    handler ToCrewManagementServiceHandler is {
      on query CrewManagementService.GetAvailableCrew is {
        do "the model sends get available crew"
      }
      on command CrewManagementService.RequestCrewChange is {
        do "the model sends request crew change"
      }
      on other is {
        error "Unexpected message for adaptor ToCrewManagementService"
      }
    } with {
      briefly "to crew management service"
      described as {
        |Carries messages to the external CrewManagementService.
      }
    }
  } with {
    briefly "CrewManagementService integration"
    described as {
      |The model's side of the CrewManagementService conversation.
    }
  }
  adaptor FromWeatherService from context WeatherService is { 
    handler FromWeatherServiceHandler is {
      on result WeatherService.RouteWeatherResult is {
        do "the model receives route weather result"
      }
      on event WeatherService.WeatherWarningIssued is {
        do "the model receives weather warning issued"
      }
      on other is {
        error "Unexpected message for adaptor FromWeatherService"
      }
    } with {
      briefly "from weather service"
      described as {
        |Carries messages from the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  adaptor ToWeatherService to context WeatherService is { 
    handler ToWeatherServiceHandler is {
      on query WeatherService.GetRouteWeather is {
        do "the model sends get route weather"
      }
      on query WeatherService.GetWeatherForecast is {
        do "the model sends get weather forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToWeatherService"
      }
    } with {
      briefly "to weather service"
      described as {
        |Carries messages to the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  include "types.riddl"
  include "Vessel.riddl"
  include "Voyage.riddl"
  // Repository for vessel persistence
  type VesselRepositoryCommand is one of {
    VesselContext.VesselRepository.PersistBunkerReportSubmitted or VesselContext.VesselRepository.PersistCertificateAdded or VesselContext.VesselRepository.PersistCertificateRenewed or VesselContext.VesselRepository.PersistCrewMemberAdded or VesselContext.VesselRepository.PersistCrewMemberRemoved or VesselContext.VesselRepository.PersistMaintenanceRecorded or VesselContext.VesselRepository.PersistPortArrivalRecorded or VesselContext.VesselRepository.PersistPortDepartureRecorded or VesselContext.VesselRepository.PersistPositionUpdated or VesselContext.VesselRepository.PersistSpecificationsUpdated or VesselContext.VesselRepository.PersistVesselRegistered or VesselContext.VesselRepository.PersistVesselStatusChanged or VesselContext.VesselRepository.PersistVoyageCompleted or VesselContext.VesselRepository.PersistVoyageCreated or VesselContext.VesselRepository.PersistVoyageUpdated or VesselContext.VesselRepository.PersistVoyageCancelled
  } with {
    briefly "Anything that writes VesselRepository"
    described as {
      |The persistence commands VesselRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository VesselRepository as flow is {
    command PersistVoyageCancelled is  {
      voyageId: VoyageId with {
        briefly "Row addressed"
        described as {
          |Which stored row VoyageCancelled applies to.
        }
      }
    } with {
      briefly "Persist VoyageCancelled"
      described as {
        |Instructs this repository to apply VoyageCancelled to the stored row.
      }
    }
    inlet VesselRepositoryFromFleetAnalytics is type VesselRepositoryCommand
    command PersistBunkerReportSubmitted is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row BunkerReportSubmitted applies to.
        }
      }
    } with {
      briefly "Persist BunkerReportSubmitted"
      described as {
        |Instructs this repository to apply BunkerReportSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCertificateAdded is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row CertificateAdded applies to.
        }
      }
    } with {
      briefly "Persist CertificateAdded"
      described as {
        |Instructs this repository to apply CertificateAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCrewMemberRemoved is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewMemberRemoved applies to.
        }
      }
    } with {
      briefly "Persist CrewMemberRemoved"
      described as {
        |Instructs this repository to apply CrewMemberRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceRecorded is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceRecorded applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceRecorded"
      described as {
        |Instructs this repository to apply MaintenanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortArrivalRecorded is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortArrivalRecorded applies to.
        }
      }
    } with {
      briefly "Persist PortArrivalRecorded"
      described as {
        |Instructs this repository to apply PortArrivalRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPortDepartureRecorded is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row PortDepartureRecorded applies to.
        }
      }
    } with {
      briefly "Persist PortDepartureRecorded"
      described as {
        |Instructs this repository to apply PortDepartureRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPositionUpdated is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row PositionUpdated applies to.
        }
      }
    } with {
      briefly "Persist PositionUpdated"
      described as {
        |Instructs this repository to apply PositionUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSpecificationsUpdated is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row SpecificationsUpdated applies to.
        }
      }
    } with {
      briefly "Persist SpecificationsUpdated"
      described as {
        |Instructs this repository to apply SpecificationsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVoyageUpdated is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row VoyageUpdated applies to.
        }
      }
    } with {
      briefly "Persist VoyageUpdated"
      described as {
        |Instructs this repository to apply VoyageUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCertificateRenewed is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row CertificateRenewed applies to.
        }
      }
    } with {
      briefly "Persist CertificateRenewed"
      described as {
        |Instructs this repository to apply CertificateRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCrewMemberAdded is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewMemberAdded applies to.
        }
      }
    } with {
      briefly "Persist CrewMemberAdded"
      described as {
        |Instructs this repository to apply CrewMemberAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVesselRegistered is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row VesselRegistered applies to.
        }
      }
    } with {
      briefly "Persist VesselRegistered"
      described as {
        |Instructs this repository to apply VesselRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVesselStatusChanged is  {
      vesselId: VesselId with {
        briefly "Row addressed"
        described as {
          |Which stored row VesselStatusChanged applies to.
        }
      }
    } with {
      briefly "Persist VesselStatusChanged"
      described as {
        |Instructs this repository to apply VesselStatusChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVoyageCompleted is  {
      voyageId: VoyageId with {
        briefly "Row addressed"
        described as {
          |Which stored row VoyageCompleted applies to.
        }
      }
    } with {
      briefly "Persist VoyageCompleted"
      described as {
        |Instructs this repository to apply VoyageCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVoyageCreated is  {
      voyageId: VoyageId with {
        briefly "Row addressed"
        described as {
          |Which stored row VoyageCreated applies to.
        }
      }
    } with {
      briefly "Persist VoyageCreated"
      described as {
        |Instructs this repository to apply VoyageCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet VesselRepositoryResponses is result Vessel.VesselResult
    record StoredVessel is  {
      vesselId: VesselId with {
        briefly "vesselId"
        described as {
          |The vesselId column of the stored vessel row.
        }
      }
      specifications: VesselSpecifications with {
        briefly "specifications"
        described as {
          |The specifications column of the stored vessel row.
        }
      }
      status: VesselStatus with {
        briefly "status"
        described as {
          |The status column of the stored vessel row.
        }
      }
    } with {
      briefly "Stored vessel row"
      described as {
        |The persistence shape of vessel data as this repository stores it.
      }
    }
    schema VesselData is relational
      of vessels as record StoredVessel
        index on field StoredVessel.vesselId
        index on field StoredVessel.specifications.imoNumber
        index on field StoredVessel.specifications.name
        index on field StoredVessel.status
 with {
      briefly "Vessel data schema"
      described as {
        |The relational schema holding vessel data for the VesselRepository.
      }
    }
    handler VesselPersistence is {
      on command VesselRepository.PersistVoyageCancelled is {
        do "apply VoyageCancelled to the stored row"
      }
      on persistBunkerReportSubmitted: command PersistBunkerReportSubmitted is {
        do "apply BunkerReportSubmitted to the stored row"
      }
      on persistCertificateAdded: command PersistCertificateAdded is {
        do "apply CertificateAdded to the stored row"
      }
      on persistCrewMemberRemoved: command PersistCrewMemberRemoved is {
        do "apply CrewMemberRemoved to the stored row"
      }
      on persistMaintenanceRecorded: command PersistMaintenanceRecorded is {
        do "apply MaintenanceRecorded to the stored row"
      }
      on persistPortArrivalRecorded: command PersistPortArrivalRecorded is {
        do "apply PortArrivalRecorded to the stored row"
      }
      on persistPortDepartureRecorded: command PersistPortDepartureRecorded is {
        do "apply PortDepartureRecorded to the stored row"
      }
      on persistPositionUpdated: command PersistPositionUpdated is {
        do "apply PositionUpdated to the stored row"
      }
      on persistSpecificationsUpdated: command PersistSpecificationsUpdated is {
        do "apply SpecificationsUpdated to the stored row"
      }
      on persistVoyageUpdated: command PersistVoyageUpdated is {
        do "apply VoyageUpdated to the stored row"
      }
      on persistCertificateRenewed: command PersistCertificateRenewed is {
        do "apply CertificateRenewed to the stored row"
      }
      on persistCrewMemberAdded: command PersistCrewMemberAdded is {
        do "apply CrewMemberAdded to the stored row"
      }
      on persistVesselRegistered: command PersistVesselRegistered is {
        do "apply VesselRegistered to the stored row"
      }
      on persistVesselStatusChanged: command PersistVesselStatusChanged is {
        do "apply VesselStatusChanged to the stored row"
      }
      on persistVoyageCompleted: command PersistVoyageCompleted is {
        do "apply VoyageCompleted to the stored row"
      }
      on persistVoyageCreated: command PersistVoyageCreated is {
        do "apply VoyageCreated to the stored row"
      }
      on query GetFleetStats is {
        let fleetStatsView: type FleetStatsView = prompt("read the fleet stats projection")
        reply fleetStatsView
      }
    } with {
      briefly "Persists vessel commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Vessel data persistence"
    described as {
      | The VesselRepository provides persistent storage
      | for vessel fleet data.
    }
  }
  // Projector for fleet analytics
  query GetFleetStats replies result FleetStatsView is  {
    fleetStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fleet stats to retrieve.
      }
    }
  } with {
    briefly "Get fleet stats"
    described as {
      |Retrieves the fleet stats projection.
    }
  }
  result FleetStatsView is  {
    fleetStats: FleetAnalytics.FleetStats with {
      briefly "Fleet stats"
      described as {
        |The fleet stats being returned.
      }
    }
  } with {
    briefly "Fleet stats view"
    described as {
      |Read model view carrying the fleet stats projection.
    }
  }
  projector FleetAnalytics as merge is {
    inlet FleetAnalyticsFromVoyage is type VoyageEvent
    outlet FleetAnalyticsToRepository is type VesselRepositoryCommand
    updates repository VesselContext.VesselRepository
    inlet FleetAnalyticsFromVessel is type VesselEvent
    record FleetStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalVessels: Natural with {
        briefly "Total"
        described as {
          |Total vessels in fleet.
        }
      }
      vesselsAtSea: Natural with {
        briefly "At sea"
        described as {
          |Vessels at sea.
        }
      }
      vesselsInPort: Natural with {
        briefly "In port"
        described as {
          |Vessels in port.
        }
      }
      vesselsUnderRepair: Natural with {
        briefly "Repair"
        described as {
          |Vessels under repair.
        }
      }
      activeVoyages: Natural with {
        briefly "Voyages"
        described as {
          |Active voyages.
        }
      }
      totalCrew: Natural with {
        briefly "Crew"
        described as {
          |Total crew count.
        }
      }
      certificatesExpiringSoon: Natural with {
        briefly "Expiring"
        described as {
          |Certificates expiring soon.
        }
      }
    } with {
      briefly "Fleet statistics"
      described as {
        |Daily fleet metrics.
      }
    }
    handler AnalyticsHandler is {
      on voyageCancelled: event Voyage.VoyageCancelled is {
        tell command VesselContext.VesselRepository.PersistVoyageCancelled(voyageId = voyageCancelled.voyageId) to repository VesselContext.VesselRepository
      }
      on bunkerReportSubmitted: event Vessel.BunkerReportSubmitted is {
        tell command VesselContext.VesselRepository.PersistBunkerReportSubmitted(vesselId = bunkerReportSubmitted.vesselId) to repository VesselContext.VesselRepository
        do "apply BunkerReportSubmitted to the FleetAnalytics projection"
      }
      on certificateAdded: event Vessel.CertificateAdded is {
        tell command VesselContext.VesselRepository.PersistCertificateAdded(vesselId = certificateAdded.vesselId) to repository VesselContext.VesselRepository
        do "apply CertificateAdded to the FleetAnalytics projection"
      }
      on crewMemberRemoved: event Vessel.CrewMemberRemoved is {
        tell command VesselContext.VesselRepository.PersistCrewMemberRemoved(vesselId = crewMemberRemoved.vesselId) to repository VesselContext.VesselRepository
        do "apply CrewMemberRemoved to the FleetAnalytics projection"
      }
      on maintenanceRecorded: event Vessel.MaintenanceRecorded is {
        tell command VesselContext.VesselRepository.PersistMaintenanceRecorded(vesselId = maintenanceRecorded.vesselId) to repository VesselContext.VesselRepository
        do "apply MaintenanceRecorded to the FleetAnalytics projection"
      }
      on portArrivalRecorded: event Voyage.PortArrivalRecorded is {
        tell command VesselContext.VesselRepository.PersistPortArrivalRecorded(vesselId = portArrivalRecorded.vesselId) to repository VesselContext.VesselRepository
        do "apply PortArrivalRecorded to the FleetAnalytics projection"
      }
      on portDepartureRecorded: event Voyage.PortDepartureRecorded is {
        tell command VesselContext.VesselRepository.PersistPortDepartureRecorded(vesselId = portDepartureRecorded.vesselId) to repository VesselContext.VesselRepository
        do "apply PortDepartureRecorded to the FleetAnalytics projection"
      }
      on positionUpdated: event Vessel.PositionUpdated is {
        tell command VesselContext.VesselRepository.PersistPositionUpdated(vesselId = positionUpdated.vesselId) to repository VesselContext.VesselRepository
        do "apply PositionUpdated to the FleetAnalytics projection"
      }
      on specificationsUpdated: event Vessel.SpecificationsUpdated is {
        tell command VesselContext.VesselRepository.PersistSpecificationsUpdated(vesselId = specificationsUpdated.vesselId) to repository VesselContext.VesselRepository
        do "apply SpecificationsUpdated to the FleetAnalytics projection"
      }
      on voyageUpdated: event Voyage.VoyageUpdated is {
        tell command VesselContext.VesselRepository.PersistVoyageUpdated(vesselId = voyageUpdated.vesselId) to repository VesselContext.VesselRepository
        do "apply VoyageUpdated to the FleetAnalytics projection"
      }
      on vesselRegistered: event Vessel.VesselRegistered is {
        tell command VesselContext.VesselRepository.PersistVesselRegistered(vesselId = vesselRegistered.vesselId) to repository VesselContext.VesselRepository
        do "Update fleet count"
      }
      on vesselStatusChanged: event Vessel.VesselStatusChanged is {
        tell command VesselContext.VesselRepository.PersistVesselStatusChanged(vesselId = vesselStatusChanged.vesselId) to repository VesselContext.VesselRepository
        do "Update status metrics"
      }
      on voyageCreated: event Voyage.VoyageCreated is {
        tell command VesselContext.VesselRepository.PersistVoyageCreated(voyageId = voyageCreated.voyageId) to repository VesselContext.VesselRepository
        do "Update voyage metrics"
      }
      on voyageCompleted: event Voyage.VoyageCompleted is {
        tell command VesselContext.VesselRepository.PersistVoyageCompleted(voyageId = voyageCompleted.voyageId) to repository VesselContext.VesselRepository
        do "Update completion metrics"
      }
      on crewMemberAdded: event Vessel.CrewMemberAdded is {
        tell command VesselContext.VesselRepository.PersistCrewMemberAdded(vesselId = crewMemberAdded.vesselId) to repository VesselContext.VesselRepository
        do "Update crew metrics"
      }
      on certificateRenewed: event Vessel.CertificateRenewed is {
        tell command VesselContext.VesselRepository.PersistCertificateRenewed(vesselId = certificateRenewed.vesselId) to repository VesselContext.VesselRepository
        do "Update certificate metrics"
      }
    } with {
      briefly "Maintains fleet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Fleet analytics projections"
    described as {
      |Maintains fleet operational analytics.
    }
  }
  // ---- Event publication for Vessel ----
  type VesselEvent is one of {
    VesselContext.Vessel.VesselRegistered or VesselContext.Vessel.SpecificationsUpdated or VesselContext.Vessel.PositionUpdated or VesselContext.Voyage.VoyageCreated or VesselContext.Voyage.VoyageUpdated or VesselContext.Voyage.PortArrivalRecorded or VesselContext.Voyage.PortDepartureRecorded or VesselContext.Voyage.VoyageCompleted or VesselContext.Vessel.CrewMemberAdded or VesselContext.Vessel.CrewMemberRemoved or VesselContext.Vessel.CertificateAdded or VesselContext.Vessel.CertificateRenewed or VesselContext.Vessel.BunkerReportSubmitted or VesselContext.Vessel.MaintenanceRecorded or VesselContext.Vessel.VesselStatusChanged
  } with {
    briefly "Vessel event alternation"
    described as {
      |Union of all Vessel events, for streaming and event-sourced
      |persistence.
    }
  }
  processor VesselEventSplit as flow is {
    inlet VesselEventSplitIn is type VesselEvent
    outlet VesselEventSplitToFleetAnalytics is type VesselEvent
    handler VesselEventSplitHandler is {
      on vesselRegistered: event Vessel.VesselRegistered is {
        send vesselRegistered to outlet VesselEventSplitToFleetAnalytics
        tell vesselRegistered to entity VesselContext.Vessel
      }
      on specificationsUpdated: event Vessel.SpecificationsUpdated is {
        send specificationsUpdated to outlet VesselEventSplitToFleetAnalytics
        tell specificationsUpdated to entity VesselContext.Vessel
      }
      on positionUpdated: event Vessel.PositionUpdated is {
        send positionUpdated to outlet VesselEventSplitToFleetAnalytics
        tell positionUpdated to entity VesselContext.Vessel
      }
      on voyageCreated: event Voyage.VoyageCreated is {
        send voyageCreated to outlet VesselEventSplitToFleetAnalytics
        tell voyageCreated to entity VesselContext.Vessel
      }
      on voyageUpdated: event Voyage.VoyageUpdated is {
        send voyageUpdated to outlet VesselEventSplitToFleetAnalytics
        tell voyageUpdated to entity VesselContext.Vessel
      }
      on portArrivalRecorded: event Voyage.PortArrivalRecorded is {
        send portArrivalRecorded to outlet VesselEventSplitToFleetAnalytics
        tell portArrivalRecorded to entity VesselContext.Vessel
      }
      on portDepartureRecorded: event Voyage.PortDepartureRecorded is {
        send portDepartureRecorded to outlet VesselEventSplitToFleetAnalytics
        tell portDepartureRecorded to entity VesselContext.Vessel
      }
      on voyageCompleted: event Voyage.VoyageCompleted is {
        send voyageCompleted to outlet VesselEventSplitToFleetAnalytics
        tell voyageCompleted to entity VesselContext.Vessel
      }
      on crewMemberAdded: event Vessel.CrewMemberAdded is {
        send crewMemberAdded to outlet VesselEventSplitToFleetAnalytics
        tell crewMemberAdded to entity VesselContext.Vessel
      }
      on crewMemberRemoved: event Vessel.CrewMemberRemoved is {
        send crewMemberRemoved to outlet VesselEventSplitToFleetAnalytics
        tell crewMemberRemoved to entity VesselContext.Vessel
      }
      on certificateAdded: event Vessel.CertificateAdded is {
        send certificateAdded to outlet VesselEventSplitToFleetAnalytics
        tell certificateAdded to entity VesselContext.Vessel
      }
      on certificateRenewed: event Vessel.CertificateRenewed is {
        send certificateRenewed to outlet VesselEventSplitToFleetAnalytics
        tell certificateRenewed to entity VesselContext.Vessel
      }
      on bunkerReportSubmitted: event Vessel.BunkerReportSubmitted is {
        send bunkerReportSubmitted to outlet VesselEventSplitToFleetAnalytics
        tell bunkerReportSubmitted to entity VesselContext.Vessel
      }
      on maintenanceRecorded: event Vessel.MaintenanceRecorded is {
        send maintenanceRecorded to outlet VesselEventSplitToFleetAnalytics
        tell maintenanceRecorded to entity VesselContext.Vessel
      }
      on vesselStatusChanged: event Vessel.VesselStatusChanged is {
        send vesselStatusChanged to outlet VesselEventSplitToFleetAnalytics
        tell vesselStatusChanged to entity VesselContext.Vessel
      }
      on other is {
        error "Unexpected message for processor VesselEventSplit"
      }
    } with {
      briefly "Vessel event fan-out handler"
      described as {
        |Delivers each Vessel event to all of its consumers.
      }
    }
  } with {
    briefly "Vessel event fan-out"
    described as {
      |Fans Vessel events out to the repository and projectors.
    }
  }
  connector 'VesselEvent Stream' is from outlet VesselContext.Vessel.VesselEvents2 to inlet VesselContext.VesselEventSplit.VesselEventSplitIn with {
    briefly "Vessel events, fanned out to storage and read models"
  }
  connector 'FleetAnalytics Feed' is from outlet VesselContext.VesselEventSplit.VesselEventSplitToFleetAnalytics to inlet VesselContext.FleetAnalytics.FleetAnalyticsFromVessel with {
    briefly "Vessel events feeding the FleetAnalytics projection"
  }
  connector 'FleetAnalytics Storage' is from outlet VesselContext.FleetAnalytics.FleetAnalyticsToRepository to inlet VesselContext.VesselRepository.VesselRepositoryFromFleetAnalytics with {
    briefly "FleetAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for vessel management"
  described as {
    | The VesselContext is the bounded context for
    | vessel fleet and voyage management.
  }
}
