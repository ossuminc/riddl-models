// Vessel Management - Vessel Context
context VesselContext is {
  adaptor FromAISService from context AISService is { 
    handler FromAISServiceHandler is {
      on event AISService.GeofenceAlert is {
        do "the model receives geofence alert"
      }
      on event AISService.PositionReportReceived is {
        do "the model receives position report received"
      }
      on result AISService.VesselAISResult is {
        do "the model receives vessel ais result"
      }
      on other is {
        error "Unexpected message for adaptor FromAISService"
      }
    } with {
      briefly "from ais service"
      described as {
        |Carries messages from the external AISService.
      }
    }
  } with {
    briefly "AISService integration"
    described as {
      |The model's side of the AISService conversation.
    }
  }
  adaptor ToAISService to context AISService is { 
    handler ToAISServiceHandler is {
      on query AISService.GetVesselAIS is {
        do "the model sends get vessel ais"
      }
      on other is {
        error "Unexpected message for adaptor ToAISService"
      }
    } with {
      briefly "to ais service"
      described as {
        |Carries messages to the external AISService.
      }
    }
  } with {
    briefly "AISService integration"
    described as {
      |The model's side of the AISService conversation.
    }
  }
  adaptor FromBunkerSupplierService from context BunkerSupplierService is { 
    handler FromBunkerSupplierServiceHandler is {
      on result BunkerSupplierService.BunkerAvailabilityResult is {
        do "the model receives bunker availability result"
      }
      on event BunkerSupplierService.BunkerDelivered is {
        do "the model receives bunker delivered"
      }
      on event BunkerSupplierService.BunkerOrderConfirmed is {
        do "the model receives bunker order confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromBunkerSupplierService"
      }
    } with {
      briefly "from bunker supplier service"
      described as {
        |Carries messages from the external BunkerSupplierService.
      }
    }
  } with {
    briefly "BunkerSupplierService integration"
    described as {
      |The model's side of the BunkerSupplierService conversation.
    }
  }
  adaptor ToBunkerSupplierService to context BunkerSupplierService is { 
    handler ToBunkerSupplierServiceHandler is {
      on query BunkerSupplierService.GetBunkerAvailability is {
        do "the model sends get bunker availability"
      }
      on command BunkerSupplierService.OrderBunkers is {
        do "the model sends order bunkers"
      }
      on other is {
        error "Unexpected message for adaptor ToBunkerSupplierService"
      }
    } with {
      briefly "to bunker supplier service"
      described as {
        |Carries messages to the external BunkerSupplierService.
      }
    }
  } with {
    briefly "BunkerSupplierService integration"
    described as {
      |The model's side of the BunkerSupplierService conversation.
    }
  }
  adaptor FromCharterPartyService from context CharterPartyService is { 
    handler FromCharterPartyServiceHandler is {
      on event CharterPartyService.CharterCommenced is {
        do "the model receives charter commenced"
      }
      on result CharterPartyService.CharterPartyResult is {
        do "the model receives charter party result"
      }
      on event CharterPartyService.CharterTerminated is {
        do "the model receives charter terminated"
      }
      on other is {
        error "Unexpected message for adaptor FromCharterPartyService"
      }
    } with {
      briefly "from charter party service"
      described as {
        |Carries messages from the external CharterPartyService.
      }
    }
  } with {
    briefly "CharterPartyService integration"
    described as {
      |The model's side of the CharterPartyService conversation.
    }
  }
  adaptor ToCharterPartyService to context CharterPartyService is { 
    handler ToCharterPartyServiceHandler is {
      on query CharterPartyService.GetCharterParty is {
        do "the model sends get charter party"
      }
      on other is {
        error "Unexpected message for adaptor ToCharterPartyService"
      }
    } with {
      briefly "to charter party service"
      described as {
        |Carries messages to the external CharterPartyService.
      }
    }
  } with {
    briefly "CharterPartyService integration"
    described as {
      |The model's side of the CharterPartyService conversation.
    }
  }
  adaptor FromClassificationSocietyService from context ClassificationSocietyService is { 
    handler FromClassificationSocietyServiceHandler is {
      on event ClassificationSocietyService.CertificateIssued is {
        do "the model receives certificate issued"
      }
      on result ClassificationSocietyService.CertificateStatusResult is {
        do "the model receives certificate status result"
      }
      on event ClassificationSocietyService.ClassSuspended is {
        do "the model receives class suspended"
      }
      on event ClassificationSocietyService.SurveyDue is {
        do "the model receives survey due"
      }
      on other is {
        error "Unexpected message for adaptor FromClassificationSocietyService"
      }
    } with {
      briefly "from classification society service"
      described as {
        |Carries messages from the external ClassificationSocietyService.
      }
    }
  } with {
    briefly "ClassificationSocietyService integration"
    described as {
      |The model's side of the ClassificationSocietyService conversation.
    }
  }
  adaptor ToClassificationSocietyService to context ClassificationSocietyService is { 
    handler ToClassificationSocietyServiceHandler is {
      on query ClassificationSocietyService.GetCertificateStatus is {
        do "the model sends get certificate status"
      }
      on other is {
        error "Unexpected message for adaptor ToClassificationSocietyService"
      }
    } with {
      briefly "to classification society service"
      described as {
        |Carries messages to the external ClassificationSocietyService.
      }
    }
  } with {
    briefly "ClassificationSocietyService integration"
    described as {
      |The model's side of the ClassificationSocietyService conversation.
    }
  }
  adaptor FromCrewManagementService from context CrewManagementService is { 
    handler FromCrewManagementServiceHandler is {
      on result CrewManagementService.AvailableCrewResult is {
        do "the model receives available crew result"
      }
      on event CrewManagementService.CertificateExpiring is {
        do "the model receives certificate expiring"
      }
      on event CrewManagementService.CrewChangeConfirmed is {
        do "the model receives crew change confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromCrewManagementService"
      }
    } with {
      briefly "from crew management service"
      described as {
        |Carries messages from the external CrewManagementService.
      }
    }
  } with {
    briefly "CrewManagementService integration"
    described as {
      |The model's side of the CrewManagementService conversation.
    }
  }
  adaptor ToCrewManagementService to context CrewManagementService is { 
    handler ToCrewManagementServiceHandler is {
      on query CrewManagementService.GetAvailableCrew is {
        do "the model sends get available crew"
      }
      on command CrewManagementService.RequestCrewChange is {
        do "the model sends request crew change"
      }
      on other is {
        error "Unexpected message for adaptor ToCrewManagementService"
      }
    } with {
      briefly "to crew management service"
      described as {
        |Carries messages to the external CrewManagementService.
      }
    }
  } with {
    briefly "CrewManagementService integration"
    described as {
      |The model's side of the CrewManagementService conversation.
    }
  }
  adaptor FromWeatherService from context WeatherService is { 
    handler FromWeatherServiceHandler is {
      on result WeatherService.RouteWeatherResult is {
        do "the model receives route weather result"
      }
      on event WeatherService.WeatherWarningIssued is {
        do "the model receives weather warning issued"
      }
      on other is {
        error "Unexpected message for adaptor FromWeatherService"
      }
    } with {
      briefly "from weather service"
      described as {
        |Carries messages from the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  adaptor ToWeatherService to context WeatherService is { 
    handler ToWeatherServiceHandler is {
      on query WeatherService.GetRouteWeather is {
        do "the model sends get route weather"
      }
      on query WeatherService.GetWeatherForecast is {
        do "the model sends get weather forecast"
      }
      on other is {
        error "Unexpected message for adaptor ToWeatherService"
      }
    } with {
      briefly "to weather service"
      described as {
        |Carries messages to the external WeatherService.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  include "types.riddl"
  include "Vessel.riddl"
  include "Voyage.riddl"
  // Repository for vessel persistence
  repository VesselRepository is {
    inlet VesselRepositoryFromVessel is type VesselEvent    inlet VesselRepositoryFromFleetAnalytics is type VesselEvent    inlet VesselRepositoryFromVoyage is type Voyage.VoyageEvent    outlet VesselRepositoryResponses is type Vessel.VesselResult
    record StoredVessel is  {
      vesselId: VesselId with {
        briefly "vesselId"
        described as {
          |The vesselId column of the stored vessel row.
        }
      }
      specifications: VesselSpecifications with {
        briefly "specifications"
        described as {
          |The specifications column of the stored vessel row.
        }
      }
      status: VesselStatus with {
        briefly "status"
        described as {
          |The status column of the stored vessel row.
        }
      }
    } with {
      briefly "Stored vessel row"
      described as {
        |The persistence shape of vessel data as this repository stores it.
      }
    }
    schema VesselData is relational
      of vessels as type StoredVessel
        index on field StoredVessel.vesselId
        index on field StoredVessel.specifications.imoNumber
        index on field StoredVessel.specifications.name
        index on field StoredVessel.status
 with {
      briefly "Vessel data schema"
      described as {
        |The relational schema holding vessel data for the VesselRepository.
      }
    }
    handler VesselPersistence is {
      on query GetFleetStats is {
        do "read the fleet stats projection"
        yield result FleetStatsView
      }
      on command Vessel.RegisterVessel is {
        do "Store new vessel"
      }
      on command Vessel.UpdateSpecifications is {
        tell event Vessel.SpecificationsUpdated to entity VesselContext.Vessel
        do "Update vessel specs"
      }
      on command Vessel.UpdatePosition is {
        tell event Vessel.PositionUpdated to entity VesselContext.Vessel
        do "Store position update"
      }
      on command Voyage.CreateVoyage is {
        tell event Voyage.VoyageCreated to entity VesselContext.Vessel
        do "Store new voyage"
      }
      on command Voyage.UpdateVoyage is {
        tell event Voyage.VoyageUpdated to entity VesselContext.Vessel
        do "Update voyage details"
      }
      on command Voyage.RecordPortArrival is {
        tell event Voyage.PortArrivalRecorded to entity VesselContext.Vessel
        do "Update port call arrival"
      }
      on command Voyage.RecordPortDeparture is {
        tell event Voyage.PortDepartureRecorded to entity VesselContext.Vessel
        do "Update port call departure"
      }
      on command Voyage.CompleteVoyage is {
        tell event Voyage.VoyageCompleted to entity VesselContext.Vessel
        do "Update voyage to completed"
      }
      on command Vessel.AddCrewMember is {
        tell event Vessel.CrewMemberAdded to entity VesselContext.Vessel
        do "Store crew assignment"
      }
      on command Vessel.RemoveCrewMember is {
        tell event Vessel.CrewMemberRemoved to entity VesselContext.Vessel
        do "Update crew departure"
      }
      on command Vessel.AddCertificate is {
        tell event Vessel.CertificateAdded to entity VesselContext.Vessel
        do "Store certificate"
      }
      on command Vessel.RenewCertificate is {
        do "Update certificate expiry"
      }
      on command Vessel.SubmitBunkerReport is {
        tell event Vessel.BunkerReportSubmitted to entity VesselContext.Vessel
        do "Store bunker report"
      }
      on command Vessel.RecordMaintenance is {
        tell event Vessel.MaintenanceRecorded to entity VesselContext.Vessel
        do "Store maintenance record"
      }
      on command Vessel.SetVesselStatus is {
        do "Update vessel status"
      }
    } with {
      briefly "Persists vessel commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Vessel data persistence"
    described as {
      | The VesselRepository provides persistent storage
      | for vessel fleet data.
    }
  }
  // Projector for fleet analytics
  query GetFleetStats is  {
    fleetStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fleet stats to retrieve.
      }
    }
  } with {
    briefly "Get fleet stats"
    described as {
      |Retrieves the fleet stats projection.
    }
  }
  result FleetStatsView is  {
    fleetStats: FleetAnalytics.FleetStats with {
      briefly "Fleet stats"
      described as {
        |The fleet stats being returned.
      }
    }
  } with {
    briefly "Fleet stats view"
    described as {
      |Read model view carrying the fleet stats projection.
    }
  }
  projector FleetAnalytics is {
    updates repository VesselContext.VesselRepository
    inlet FleetAnalyticsFromVessel is type VesselEvent    outlet FleetAnalyticsOut is type VesselEvent
    record FleetStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalVessels: Natural with {
        briefly "Total"
        described as {
          |Total vessels in fleet.
        }
      }
      vesselsAtSea: Natural with {
        briefly "At sea"
        described as {
          |Vessels at sea.
        }
      }
      vesselsInPort: Natural with {
        briefly "In port"
        described as {
          |Vessels in port.
        }
      }
      vesselsUnderRepair: Natural with {
        briefly "Repair"
        described as {
          |Vessels under repair.
        }
      }
      activeVoyages: Natural with {
        briefly "Voyages"
        described as {
          |Active voyages.
        }
      }
      totalCrew: Natural with {
        briefly "Crew"
        described as {
          |Total crew count.
        }
      }
      certificatesExpiringSoon: Natural with {
        briefly "Expiring"
        described as {
          |Certificates expiring soon.
        }
      }
    } with {
      briefly "Fleet statistics"
      described as {
        |Daily fleet metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Vessel.VesselRegistered is {
        tell event Vessel.VesselRegistered to repository VesselContext.VesselRepository
        do "Update fleet count"
      }
      on event Vessel.VesselStatusChanged is {
        tell event Vessel.VesselStatusChanged to repository VesselContext.VesselRepository
        do "Update status metrics"
      }
      on event Voyage.VoyageCreated is {
        tell event Voyage.VoyageCreated to repository VesselContext.VesselRepository
        do "Update voyage metrics"
      }
      on event Voyage.VoyageCompleted is {
        tell event Voyage.VoyageCompleted to repository VesselContext.VesselRepository
        do "Update completion metrics"
      }
      on event Vessel.CrewMemberAdded is {
        tell event Vessel.CrewMemberAdded to repository VesselContext.VesselRepository
        do "Update crew metrics"
      }
      on event Vessel.CertificateRenewed is {
        tell event Vessel.CertificateRenewed to repository VesselContext.VesselRepository
        do "Update certificate metrics"
      }
    } with {
      briefly "Maintains fleet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Fleet analytics projections"
    described as {
      |Maintains fleet operational analytics.
    }
  }
  // ---- Event publication for Vessel ----
  type VesselEvent is one of {
    VesselContext.Vessel.VesselRegistered or VesselContext.Vessel.SpecificationsUpdated or VesselContext.Vessel.PositionUpdated or VesselContext.Voyage.VoyageCreated or VesselContext.Voyage.VoyageUpdated or VesselContext.Voyage.PortArrivalRecorded or VesselContext.Voyage.PortDepartureRecorded or VesselContext.Voyage.VoyageCompleted or VesselContext.Vessel.CrewMemberAdded or VesselContext.Vessel.CrewMemberRemoved or VesselContext.Vessel.CertificateAdded or VesselContext.Vessel.CertificateRenewed or VesselContext.Vessel.BunkerReportSubmitted or VesselContext.Vessel.MaintenanceRecorded or VesselContext.Vessel.VesselStatusChanged
  } with {
    briefly "Vessel event alternation"
    described as {
      |Union of all Vessel events, for streaming and event-sourced
      |persistence.
    }
  }
  processor VesselEventSource as source is {
    outlet VesselEvents is type VesselEvent
    handler VesselSourceHandler is {
      on event Vessel.VesselRegistered is {
        send event Vessel.VesselRegistered to outlet VesselEvents
      }
      on event Vessel.SpecificationsUpdated is {
        send event Vessel.SpecificationsUpdated to outlet VesselEvents
      }
      on event Vessel.PositionUpdated is {
        send event Vessel.PositionUpdated to outlet VesselEvents
      }
      on event Voyage.VoyageCreated is {
        send event Voyage.VoyageCreated to outlet VesselEvents
      }
      on event Voyage.VoyageUpdated is {
        send event Voyage.VoyageUpdated to outlet VesselEvents
      }
      on event Voyage.PortArrivalRecorded is {
        send event Voyage.PortArrivalRecorded to outlet VesselEvents
      }
      on event Voyage.PortDepartureRecorded is {
        send event Voyage.PortDepartureRecorded to outlet VesselEvents
      }
      on event Voyage.VoyageCompleted is {
        send event Voyage.VoyageCompleted to outlet VesselEvents
      }
      on event Vessel.CrewMemberAdded is {
        send event Vessel.CrewMemberAdded to outlet VesselEvents
      }
      on event Vessel.CrewMemberRemoved is {
        send event Vessel.CrewMemberRemoved to outlet VesselEvents
      }
      on event Vessel.CertificateAdded is {
        send event Vessel.CertificateAdded to outlet VesselEvents
      }
      on event Vessel.CertificateRenewed is {
        send event Vessel.CertificateRenewed to outlet VesselEvents
      }
      on event Vessel.BunkerReportSubmitted is {
        send event Vessel.BunkerReportSubmitted to outlet VesselEvents
      }
      on event Vessel.MaintenanceRecorded is {
        send event Vessel.MaintenanceRecorded to outlet VesselEvents
      }
      on event Vessel.VesselStatusChanged is {
        send event Vessel.VesselStatusChanged to outlet VesselEvents
      }
      on other is {
        error "Unexpected message for source VesselEventSource"
      }
    } with {
      briefly "Vessel source handler"
      described as {
        |Publishes Vessel events onto the outlet.
      }
    }
  } with {
    briefly "Vessel event source"
    described as {
      |Publishes Vessel entity events into the streaming topology.
    }
  }
  processor VesselEventSink as sink is {
    inlet VesselInlet is type VesselEvent    handler VesselSinkHandler is {
      on event Vessel.VesselRegistered is {
        tell event Vessel.VesselRegistered to repository VesselContext.VesselRepository
      }
      on event Vessel.SpecificationsUpdated is {
        tell event Vessel.SpecificationsUpdated to repository VesselContext.VesselRepository
      }
      on event Vessel.PositionUpdated is {
        tell event Vessel.PositionUpdated to repository VesselContext.VesselRepository
      }
      on event Voyage.VoyageCreated is {
        tell event Voyage.VoyageCreated to repository VesselContext.VesselRepository
      }
      on event Voyage.VoyageUpdated is {
        tell event Voyage.VoyageUpdated to repository VesselContext.VesselRepository
      }
      on event Voyage.PortArrivalRecorded is {
        tell event Voyage.PortArrivalRecorded to repository VesselContext.VesselRepository
      }
      on event Voyage.PortDepartureRecorded is {
        tell event Voyage.PortDepartureRecorded to repository VesselContext.VesselRepository
      }
      on event Voyage.VoyageCompleted is {
        tell event Voyage.VoyageCompleted to repository VesselContext.VesselRepository
      }
      on event Vessel.CrewMemberAdded is {
        tell event Vessel.CrewMemberAdded to repository VesselContext.VesselRepository
      }
      on event Vessel.CrewMemberRemoved is {
        tell event Vessel.CrewMemberRemoved to repository VesselContext.VesselRepository
      }
      on event Vessel.CertificateAdded is {
        tell event Vessel.CertificateAdded to repository VesselContext.VesselRepository
      }
      on event Vessel.CertificateRenewed is {
        tell event Vessel.CertificateRenewed to repository VesselContext.VesselRepository
      }
      on event Vessel.BunkerReportSubmitted is {
        tell event Vessel.BunkerReportSubmitted to repository VesselContext.VesselRepository
      }
      on event Vessel.MaintenanceRecorded is {
        tell event Vessel.MaintenanceRecorded to repository VesselContext.VesselRepository
      }
      on event Vessel.VesselStatusChanged is {
        tell event Vessel.VesselStatusChanged to repository VesselContext.VesselRepository
      }
      on other is {
        error "Unexpected message for sink VesselEventSink"
      }
    } with {
      briefly "Vessel sink handler"
      described as {
        |Persists Vessel events via the repository.
      }
    }
  } with {
    briefly "Vessel event sink"
    described as {
      |Receives Vessel events for persistence.
    }
  }
  connector LinkVoyageToVesselRepository is from outlet VesselContext.Voyage.VoyageEvents to inlet VesselContext.VesselRepository.VesselRepositoryFromVoyage with {
    briefly "Voyage events to repository"
    described as {
      |Carries voyage events to the repository that persists them.
    }
  }
  connector VesselEventFlow is from outlet VesselContext.VesselEventSource.VesselEvents to inlet VesselContext.VesselEventSink.VesselInlet with {
    briefly "Vessel event flow"
    described as {
      |Connects the Vessel source to its sink.
    }
  }
  processor VesselEventSplit is {
    inlet VesselEventSplitIn is type VesselEvent    outlet VesselEventSplitToVesselRepository is type VesselEvent
    outlet VesselEventSplitToFleetAnalytics is type VesselEvent
    handler VesselEventSplitHandler is {
      on event Vessel.VesselRegistered is {
        send event Vessel.VesselRegistered to outlet VesselEventSplitToVesselRepository
        send event Vessel.VesselRegistered to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.VesselRegistered to entity VesselContext.Vessel
      }
      on event Vessel.SpecificationsUpdated is {
        send event Vessel.SpecificationsUpdated to outlet VesselEventSplitToVesselRepository
        send event Vessel.SpecificationsUpdated to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.SpecificationsUpdated to entity VesselContext.Vessel
      }
      on event Vessel.PositionUpdated is {
        send event Vessel.PositionUpdated to outlet VesselEventSplitToVesselRepository
        send event Vessel.PositionUpdated to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.PositionUpdated to entity VesselContext.Vessel
      }
      on event Voyage.VoyageCreated is {
        send event Voyage.VoyageCreated to outlet VesselEventSplitToVesselRepository
        send event Voyage.VoyageCreated to outlet VesselEventSplitToFleetAnalytics
        tell event Voyage.VoyageCreated to entity VesselContext.Vessel
      }
      on event Voyage.VoyageUpdated is {
        send event Voyage.VoyageUpdated to outlet VesselEventSplitToVesselRepository
        send event Voyage.VoyageUpdated to outlet VesselEventSplitToFleetAnalytics
        tell event Voyage.VoyageUpdated to entity VesselContext.Vessel
      }
      on event Voyage.PortArrivalRecorded is {
        send event Voyage.PortArrivalRecorded to outlet VesselEventSplitToVesselRepository
        send event Voyage.PortArrivalRecorded to outlet VesselEventSplitToFleetAnalytics
        tell event Voyage.PortArrivalRecorded to entity VesselContext.Vessel
      }
      on event Voyage.PortDepartureRecorded is {
        send event Voyage.PortDepartureRecorded to outlet VesselEventSplitToVesselRepository
        send event Voyage.PortDepartureRecorded to outlet VesselEventSplitToFleetAnalytics
        tell event Voyage.PortDepartureRecorded to entity VesselContext.Vessel
      }
      on event Voyage.VoyageCompleted is {
        send event Voyage.VoyageCompleted to outlet VesselEventSplitToVesselRepository
        send event Voyage.VoyageCompleted to outlet VesselEventSplitToFleetAnalytics
        tell event Voyage.VoyageCompleted to entity VesselContext.Vessel
      }
      on event Vessel.CrewMemberAdded is {
        send event Vessel.CrewMemberAdded to outlet VesselEventSplitToVesselRepository
        send event Vessel.CrewMemberAdded to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.CrewMemberAdded to entity VesselContext.Vessel
      }
      on event Vessel.CrewMemberRemoved is {
        send event Vessel.CrewMemberRemoved to outlet VesselEventSplitToVesselRepository
        send event Vessel.CrewMemberRemoved to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.CrewMemberRemoved to entity VesselContext.Vessel
      }
      on event Vessel.CertificateAdded is {
        send event Vessel.CertificateAdded to outlet VesselEventSplitToVesselRepository
        send event Vessel.CertificateAdded to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.CertificateAdded to entity VesselContext.Vessel
      }
      on event Vessel.CertificateRenewed is {
        send event Vessel.CertificateRenewed to outlet VesselEventSplitToVesselRepository
        send event Vessel.CertificateRenewed to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.CertificateRenewed to entity VesselContext.Vessel
      }
      on event Vessel.BunkerReportSubmitted is {
        send event Vessel.BunkerReportSubmitted to outlet VesselEventSplitToVesselRepository
        send event Vessel.BunkerReportSubmitted to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.BunkerReportSubmitted to entity VesselContext.Vessel
      }
      on event Vessel.MaintenanceRecorded is {
        send event Vessel.MaintenanceRecorded to outlet VesselEventSplitToVesselRepository
        send event Vessel.MaintenanceRecorded to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.MaintenanceRecorded to entity VesselContext.Vessel
      }
      on event Vessel.VesselStatusChanged is {
        send event Vessel.VesselStatusChanged to outlet VesselEventSplitToVesselRepository
        send event Vessel.VesselStatusChanged to outlet VesselEventSplitToFleetAnalytics
        tell event Vessel.VesselStatusChanged to entity VesselContext.Vessel
      }
      on other is {
        error "Unexpected message for processor VesselEventSplit"
      }
    } with {
      briefly "Vessel event fan-out handler"
      described as {
        |Delivers each Vessel event to all of its consumers.
      }
    }
  } with {
    briefly "Vessel event fan-out"
    described as {
      |Fans Vessel events out to the repository and projectors.
    }
  }
  connector LinkVesselToVesselEventSplit is from outlet VesselContext.Vessel.VesselEvents2 to inlet VesselContext.VesselEventSplit.VesselEventSplitIn with {
    briefly "LinkVesselToVesselEventSplit"
  }
  connector LinkVesselEventSplitToVesselRepository is from outlet VesselContext.VesselEventSplit.VesselEventSplitToVesselRepository to inlet VesselContext.VesselRepository.VesselRepositoryFromVessel with {
    briefly "LinkVesselEventSplitToVesselRepository"
  }
  connector LinkVesselEventSplitToFleetAnalytics is from outlet VesselContext.VesselEventSplit.VesselEventSplitToFleetAnalytics to inlet VesselContext.FleetAnalytics.FleetAnalyticsFromVessel with {
    briefly "LinkVesselEventSplitToFleetAnalytics"
  }
  connector LinkFleetAnalyticsToVesselRepository is from outlet VesselContext.FleetAnalytics.FleetAnalyticsOut to inlet VesselContext.VesselRepository.VesselRepositoryFromFleetAnalytics with {
    briefly "LinkFleetAnalyticsToVesselRepository"
  }
} with {
  briefly "Bounded context for vessel management"
  described as {
    | The VesselContext is the bounded context for
    | vessel fleet and voyage management.
