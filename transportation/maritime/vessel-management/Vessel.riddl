// Vessel Management - Vessel Entity
entity Vessel as flow is {
  type VesselCommand is one of {
    Vessel.RegisterVessel or Vessel.UpdateSpecifications or Vessel.UpdatePosition or Vessel.AddCrewMember or Vessel.RemoveCrewMember or Vessel.AddCertificate or Vessel.RenewCertificate or Vessel.SubmitBunkerReport or Vessel.RecordMaintenance or Vessel.SetVesselStatus
  } with {
    briefly "Vessel command alternation"
    described as {
      |Commands accepted by the Vessel entity.
    }
  }
  inlet VesselCommands is type VesselCommand  outlet VesselEvents2 is type VesselEvent
  query GetVessel replies result VesselResult is {
    vesselId: VesselId with {
      briefly "ID"
      described as {
        |Identifier of the Vessel to retrieve.
      }
    }
  } with {
    briefly "Get Vessel"
    described as {
      |Retrieve Vessel data by identifier.
    }
  }
  result VesselResult is  {
    vesselId: VesselId with {
      briefly "Vessel addressed"
      described as {
        |Which vessel this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    vesselData: Vessel.ActiveStateData with {
      briefly "Vessel data"
      described as {
        |The requested Vessel data.
      }
    }
  } with {
    briefly "Vessel result"
    described as {
      |Result carrying the requested Vessel data.
    }
  }
  // Commands
  command RegisterVessel is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |New vessel identifier.
      }
    }
    specifications: VesselSpecifications with {
      briefly "Specs"
      described as {
        |Vessel specifications.
      }
    }
  } with {
    briefly "Register vessel"
    described as {
      |Registers a new vessel in the fleet.
    }
  }
  command UpdateSpecifications is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    specifications: VesselSpecifications with {
      briefly "Specs"
      described as {
        |Updated specifications.
      }
    }
  } with {
    briefly "Update specifications"
    described as {
      |Updates vessel specifications.
    }
  }
  command UpdatePosition is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    position: VesselPosition with {
      briefly "Position"
      described as {
        |Current position.
      }
    }
  } with {
    briefly "Update position"
    described as {
      |Updates vessel position.
    }
  }
  command AddCrewMember is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    crew: CrewMember with {
      briefly "Crew"
      described as {
        |Crew member details.
      }
    }
  } with {
    briefly "Add crew member"
    described as {
      |Adds crew member to vessel.
    }
  }
  command RemoveCrewMember is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    crewMemberId: CrewMemberId with {
      briefly "Crew"
      described as {
        |Crew member ID.
      }
    }
    signOffDate: Date with {
      briefly "Sign off"
      described as {
        |Departure date.
      }
    }
  } with {
    briefly "Remove crew member"
    described as {
      |Removes crew member from vessel.
    }
  }
  command AddCertificate is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    certificate: VesselCertificate with {
      briefly "Certificate"
      described as {
        |Certificate details.
      }
    }
  } with {
    briefly "Add certificate"
    described as {
      |Adds vessel certificate.
    }
  }
  command RenewCertificate is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    certificateId: CertificateId with {
      briefly "Certificate"
      described as {
        |Certificate ID.
      }
    }
    newExpiryDate: Date with {
      briefly "Expiry"
      described as {
        |New expiry date.
      }
    }
    newSurveyDate: Date? with {
      briefly "Survey"
      described as {
        |Next survey date.
      }
    }
  } with {
    briefly "Renew certificate"
    described as {
      |Renews vessel certificate.
    }
  }
  command SubmitBunkerReport is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    report: BunkerReport with {
      briefly "Report"
      described as {
        |Bunker report.
      }
    }
  } with {
    briefly "Submit bunker report"
    described as {
      |Submits fuel consumption report.
    }
  }
  command RecordMaintenance is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    maintenance: MaintenanceRecord with {
      briefly "Maintenance"
      described as {
        |Maintenance record.
      }
    }
  } with {
    briefly "Record maintenance"
    described as {
      |Records maintenance activity.
    }
  }
  command SetVesselStatus is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel identifier.
      }
    }
    status: VesselStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
    updatedReason: String(1,500)? with {
      briefly "Reason"
      described as {
        |Status change reason.
      }
    }
  } with {
    briefly "Set vessel status"
    described as {
      |Changes vessel operational status.
    }
  }
  // Events
  event VesselRegistered is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    specifications: VesselSpecifications with {
      briefly "Specs"
      described as {
        |Vessel specs.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Vessel registered"
    described as {
      |Emitted when vessel is registered.
    }
  }
  event SpecificationsUpdated is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    specifications: VesselSpecifications with {
      briefly "Specs"
      described as {
        |New specs.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Specifications updated"
    described as {
      |Emitted when specs are updated.
    }
  }
  event PositionUpdated is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    position: VesselPosition with {
      briefly "Position"
      described as {
        |New position.
      }
    }
  } with {
    briefly "Position updated"
    described as {
      |Emitted when position is updated.
    }
  }
  event CrewMemberAdded is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    crew: CrewMember with {
      briefly "Crew"
      described as {
        |Crew member.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "Crew member added"
    described as {
      |Emitted when crew joins.
    }
  }
  event CrewMemberRemoved is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    crewMemberId: CrewMemberId with {
      briefly "Crew"
      described as {
        |Crew member ID.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |Removal time.
      }
    }
  } with {
    briefly "Crew member removed"
    described as {
      |Emitted when crew departs.
    }
  }
  event CertificateAdded is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    certificate: VesselCertificate with {
      briefly "Certificate"
      described as {
        |Certificate.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "Certificate added"
    described as {
      |Emitted when certificate is added.
    }
  }
  event CertificateRenewed is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    certificateId: CertificateId with {
      briefly "Certificate"
      described as {
        |Certificate ID.
      }
    }
    newExpiryDate: Date with {
      briefly "Expiry"
      described as {
        |New expiry.
      }
    }
    renewedAt: TimeStamp with {
      briefly "Renewed"
      described as {
        |Renewal time.
      }
    }
  } with {
    briefly "Certificate renewed"
    described as {
      |Emitted when certificate is renewed.
    }
  }
  event BunkerReportSubmitted is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    report: BunkerReport with {
      briefly "Report"
      described as {
        |Bunker report.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Bunker report submitted"
    described as {
      |Emitted when bunker report is filed.
    }
  }
  event MaintenanceRecorded is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    maintenance: MaintenanceRecord with {
      briefly "Maintenance"
      described as {
        |Maintenance record.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Maintenance recorded"
    described as {
      |Emitted when maintenance is logged.
    }
  }
  event VesselStatusChanged is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    previousStatus: VesselStatus with {
      briefly "Previous"
      described as {
        |Previous status.
      }
    }
    newStatus: VesselStatus with {
      briefly "New"
      described as {
        |New status.
      }
    }
    changedAt: TimeStamp with {
      briefly "Changed"
      described as {
        |Change time.
      }
    }
  } with {
    briefly "Vessel status changed"
    described as {
      |Emitted when status changes.
    }
  }
  // State Records
  record ActiveStateData is  {
    vesselId: VesselId with {
      briefly "Vessel"
      described as {
        |Vessel ID.
      }
    }
    specifications: VesselSpecifications with {
      briefly "Specs"
      described as {
        |Vessel specs.
      }
    }
    status: VesselStatus with {
      briefly "Status"
      described as {
        |Vessel status.
      }
    }
    currentPosition: VesselPosition? with {
      briefly "Position"
      described as {
        |Current position.
      }
    }
    currentVoyage: VoyageDetails? with {
      briefly "Voyage"
      described as {
        |Current voyage.
      }
    }
    scheduledPortCalls: PortCallInfo* with {
      briefly "Port calls"
      described as {
        |Scheduled calls.
      }
    }
    currentCrew: CrewMember* with {
      briefly "Crew"
      described as {
        |Current crew.
      }
    }
    vesselCertificates: VesselCertificate* with {
      briefly "Certificates"
      described as {
        |Valid certificates.
      }
    }
    lastBunkerReport: BunkerReport? with {
      briefly "Bunker"
      described as {
        |Last bunker report.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |State for active vessel.
    }
  }
  // States
  initial state ActiveState of record Vessel.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on query GetVessel is {
        let vesselResult: type VesselResult = prompt("read the vessel from the store")
        reply vesselResult
      }
      on init is {
        set state ActiveState to "initialize Vessel.ActiveStateData fields from the creating message"
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the Vessel entity, carrying ActiveStateData.
    }
  }
  // Handler
  initial handler VesselHandler is {
    on registerVessel: command RegisterVessel is {
      morph entity VesselContext.Vessel to state VesselContext.Vessel.ActiveState with record Vessel.ActiveStateData(vesselId = registerVessel.vesselId, specifications = registerVessel.specifications, status = prompt("the status of this active state data"), currentPosition = empty, currentVoyage = empty, scheduledPortCalls = empty, currentCrew = empty, vesselCertificates = empty, lastBunkerReport = empty, registeredAt = prompt("the registered at of this active state data"))
      tell event VesselRegistered(vesselId = registerVessel.vesselId, specifications = registerVessel.specifications, registeredAt = prompt("the registered at of this vessel registered")) to entity VesselContext.Vessel
    }
    on updateSpecifications: command UpdateSpecifications is {
      tell event SpecificationsUpdated(vesselId = updateSpecifications.vesselId, specifications = updateSpecifications.specifications, updatedAt = prompt("the updated at of this specifications updated")) to entity VesselContext.Vessel
    }
    on updatePosition: command UpdatePosition is {
      tell event PositionUpdated(vesselId = updatePosition.vesselId, position = updatePosition.position) to entity VesselContext.Vessel
    }
    on addCrewMember: command AddCrewMember is {
      tell event CrewMemberAdded(vesselId = addCrewMember.vesselId, crew = addCrewMember.crew, addedAt = prompt("the added at of this crew member added")) to entity VesselContext.Vessel
    }
    on removeCrewMember: command RemoveCrewMember is {
      tell event CrewMemberRemoved(vesselId = removeCrewMember.vesselId, crewMemberId = removeCrewMember.crewMemberId, removedAt = prompt("the removed at of this crew member removed")) to entity VesselContext.Vessel
    }
    on addCertificate: command AddCertificate is {
      tell event CertificateAdded(vesselId = addCertificate.vesselId, certificate = addCertificate.certificate, addedAt = prompt("the added at of this certificate added")) to entity VesselContext.Vessel
    }
    on renewCertificate: command RenewCertificate is {
      tell event CertificateRenewed(vesselId = renewCertificate.vesselId, certificateId = renewCertificate.certificateId, newExpiryDate = renewCertificate.newExpiryDate, renewedAt = prompt("the renewed at of this certificate renewed")) to entity VesselContext.Vessel
    }
    on submitBunkerReport: command SubmitBunkerReport is {
      tell event BunkerReportSubmitted(vesselId = submitBunkerReport.vesselId, report = submitBunkerReport.report, submittedAt = prompt("the submitted at of this bunker report submitted")) to entity VesselContext.Vessel
    }
    on recordMaintenance: command RecordMaintenance is {
      tell event MaintenanceRecorded(vesselId = recordMaintenance.vesselId, maintenance = recordMaintenance.maintenance, recordedAt = prompt("the recorded at of this maintenance recorded")) to entity VesselContext.Vessel
    }
    on setVesselStatus: command SetVesselStatus is {
      tell event VesselStatusChanged(vesselId = setVesselStatus.vesselId, previousStatus = prompt("the previous status of this vessel status changed"), newStatus = prompt("the new status of this vessel status changed"), changedAt = prompt("the changed at of this vessel status changed")) to entity VesselContext.Vessel
    }
      on bunkerReportSubmitted: event BunkerReportSubmitted is {
      do "apply BunkerReportSubmitted to the vessel so it can be persisted and replayed"
    }
    on certificateAdded: event CertificateAdded is {
      do "apply CertificateAdded to the vessel so it can be persisted and replayed"
    }
    on certificateRenewed: event CertificateRenewed is {
      do "apply CertificateRenewed to the vessel so it can be persisted and replayed"
    }
    on crewMemberAdded: event CrewMemberAdded is {
      do "apply CrewMemberAdded to the vessel so it can be persisted and replayed"
    }
    on crewMemberRemoved: event CrewMemberRemoved is {
      do "apply CrewMemberRemoved to the vessel so it can be persisted and replayed"
    }
    on maintenanceRecorded: event MaintenanceRecorded is {
      do "apply MaintenanceRecorded to the vessel so it can be persisted and replayed"
    }
    on portArrivalRecorded: event PortArrivalRecorded is {
      do "apply PortArrivalRecorded to the vessel so it can be persisted and replayed"
    }
    on portDepartureRecorded: event PortDepartureRecorded is {
      do "apply PortDepartureRecorded to the vessel so it can be persisted and replayed"
    }
    on positionUpdated: event PositionUpdated is {
      do "apply PositionUpdated to the vessel so it can be persisted and replayed"
    }
    on specificationsUpdated: event SpecificationsUpdated is {
      do "apply SpecificationsUpdated to the vessel so it can be persisted and replayed"
    }
    on vesselRegistered: event VesselRegistered is {
      do "apply VesselRegistered to the vessel so it can be persisted and replayed"
    }
    on vesselStatusChanged: event VesselStatusChanged is {
      do "apply VesselStatusChanged to the vessel so it can be persisted and replayed"
    }
    on voyageCompleted: event VoyageCompleted is {
      do "apply VoyageCompleted to the vessel so it can be persisted and replayed"
    }
    on voyageCreated: event VoyageCreated is {
      do "apply VoyageCreated to the vessel so it can be persisted and replayed"
    }
    on voyageUpdated: event VoyageUpdated is {
      do "apply VoyageUpdated to the vessel so it can be persisted and replayed"
    }
} with {
    briefly "Processes vessel commands"
    described as {
      | Handles vessel lifecycle from registration
      | through voyages and maintenance.
    }
  }
} with {
  briefly "Vessel aggregate"
  described as {
    | The Vessel entity manages ship fleet
    | and voyage operations.
  }
}
