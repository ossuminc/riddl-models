// Vessel Management Domain Model
// Ship fleet and voyage management
domain VesselManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FleetManager is "person managing vessel fleet" with {
    briefly "Fleet Manager"
    described as {
      |Manager overseeing vessel operations.
    }
  }
  user Captain is "person commanding a vessel" with {
    briefly "Captain"
    described as {
      |Master of the vessel.
    }
  }
  user ChartererPlanner is "person planning vessel charters" with {
    briefly "Charterer Planner"
    described as {
      |Staff managing vessel scheduling.
    }
  }
  epic VesselEpic is {
    user FleetManager wants to "to track vessel positions and voyages" so that "fleet operations are efficient"
    case PlanVoyage is {
      user ChartererPlanner wants to "to schedule a vessel voyage" so that "cargo can be transported"
      step is "Planner creates" "voyage itinerary" "with port calls" with {
        briefly "Create voyage"
        described as {
          |Plan voyage route.
        }
      }
      step take input VesselManagementApp.VesselManagementScreen.CreateVoyageInput from user ChartererPlanner with {
        briefly "Schedule voyage"
        described as {
          |Record voyage plan.
        }
      }
      step is "Captain receives" "voyage instructions" "for execution" with {
        briefly "Dispatch"
        described as {
          |Send to vessel.
        }
      }
    } with {
      briefly "Plan voyage"
      described as {
        |Voyage planning workflow.
      }
    }
  } with {
    briefly "Vessel management"
    described as {
      | Epic covering vessel tracking, voyage planning,
      | and fleet operations.
    }
  }
  include "VesselContext.riddl"
  include "external-contexts.riddl"
  application context VesselManagementApp is {
    outlet AppVoyageCommands is type VesselContext.Voyage.VoyageCommand
    group VesselManagementScreen is {
      input CreateVoyageInput acquires command VesselContext.Voyage.CreateVoyage with {
        briefly "Create voyage control"
        described as {
          |The control through which a user submits the create voyage request.
        }
      }
    } with {
      briefly "Vessel management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppVesselCommands is type VesselContext.Vessel.VesselCommand
    inlet AppVesselRepositoryResponses is type VesselContext.Vessel.VesselResult    handler VesselManagementAppHandler is {
      on other is {
        error "Unexpected message for application context VesselManagementApp"
      }
    } with {
      briefly "VesselManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "VesselManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppVoyageCommands is from outlet VesselManagementApp.AppVoyageCommands to inlet VesselContext.Voyage.VoyageCommands with {
    option persistent()
    briefly "Application commands to voyage"
    described as {
      |Carries voyage commands from the application.
    }
  }
  connector LinkAppVesselCommands is from outlet VesselManagementApp.AppVesselCommands to inlet VesselContext.Vessel.VesselCommands with {
    option persistent()
    briefly "LinkAppVesselCommands"
  }
  connector LinkAppVesselRepositoryResponses is from outlet VesselContext.VesselRepository.VesselRepositoryResponses to inlet VesselManagementApp.AppVesselRepositoryResponses with {
    option persistent()
    briefly "LinkAppVesselRepositoryResponses"
  }
} with {
  briefly "Vessel management domain"
  described as {
    | The VesselManagement domain handles ship
    | fleet and voyage management.
  }
}
