// Transaction Management - Transaction Context
context TransactionContext is {
  include "types.riddl"
  include "Transaction.riddl"
  // Repository for transaction persistence
  repository TransactionRepository is {
    inlet TransactionRepositoryFromTransaction is type TransactionEvent
    inlet TransactionRepositoryFromTransactionAnalytics is type TransactionEvent
    outlet TransactionRepositoryResponses is type Transaction.TransactionResult
    schema TransactionData is relational
      of transactions as type Transaction
        index on field Transaction.transactionId
        index on field Transaction.property.propertyId

    handler TransactionPersistence is {
      on command Transaction.InitiateTransaction is {
        tell event Transaction.TransactionInitiated to entity TransactionContext.Transaction
        prompt "Store new transaction record"
      }
      on command Transaction.SubmitOffer is {
        tell event Transaction.OfferSubmitted to entity TransactionContext.Transaction
        prompt "Store offer record"
      }
      on command Transaction.ExecuteContract is {
        prompt "Store contract record"
      }
      on command Transaction.CompleteClosing is {
        tell event Transaction.ClosingCompleted to entity TransactionContext.Transaction
        prompt "Update transaction as closed"
      }
      on command Transaction.CancelTransaction is {
        tell event Transaction.TransactionCancelled to entity TransactionContext.Transaction
        prompt "Update transaction as cancelled"
      }
    } with {
      briefly "Persists transaction commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Transaction data persistence"
    described as {
      | The TransactionRepository provides persistent storage for
      | real estate transactions and related documents.
    }
  }
  // Projector for transaction analytics
  projector TransactionAnalytics is {
    inlet TransactionAnalyticsFromTransaction is type TransactionEvent
    outlet TransactionAnalyticsOut is type TransactionEvent
    updates repository TransactionContext.TransactionRepository
    record TransactionSummary is  {
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      totalTransactions: Natural with {
        briefly "Total"
        described as {
          |Total transactions.
        }
      }
      totalVolume: Money with {
        briefly "Volume"
        described as {
          |Total dollar volume.
        }
      }
      averagePrice: Money with {
        briefly "Average"
        described as {
          |Average sale price.
        }
      }
      averageDaysToClose: Natural with {
        briefly "Days"
        described as {
          |Average days to close.
        }
      }
    } with {
      briefly "Transaction summary"
      described as {
        |Transaction metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on event Transaction.ClosingCompleted is {
        tell event Transaction.ClosingCompleted to repository TransactionContext.TransactionRepository
        prompt "Update transaction volume and averages"
      }
      on event Transaction.TransactionCancelled is {
        tell event Transaction.TransactionCancelled to repository TransactionContext.TransactionRepository
        prompt "Update cancellation metrics"
      }
    } with {
      briefly "Maintains transaction analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Transaction analytics projections"
    described as {
      |Maintains transaction analytics data.
    }
  }
  // ---- Event publication for Transaction ----
  type TransactionEvent is one of {
    TransactionContext.Transaction.TransactionInitiated,
    TransactionContext.Transaction.OfferSubmitted,
    TransactionContext.Transaction.OfferCountered,
    TransactionContext.Transaction.OfferAccepted,
    TransactionContext.Transaction.ContractExecuted,
    TransactionContext.Transaction.ContingencySatisfied,
    TransactionContext.Transaction.ContingencyWaived,
    TransactionContext.Transaction.EscrowEntered,
    TransactionContext.Transaction.ClosingScheduled,
    TransactionContext.Transaction.ClosingCompleted,
    TransactionContext.Transaction.TransactionCancelled
  } with {
    briefly "Transaction event alternation"
    described as {
      |Union of all Transaction events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TransactionEventSource as source is {
    outlet TransactionEvents is type TransactionEvent
    handler TransactionSourceHandler is {
      on event Transaction.TransactionInitiated is {
        send event Transaction.TransactionInitiated to outlet TransactionEvents
      }
      on event Transaction.OfferSubmitted is {
        send event Transaction.OfferSubmitted to outlet TransactionEvents
      }
      on event Transaction.OfferCountered is {
        send event Transaction.OfferCountered to outlet TransactionEvents
      }
      on event Transaction.OfferAccepted is {
        send event Transaction.OfferAccepted to outlet TransactionEvents
      }
      on event Transaction.ContractExecuted is {
        send event Transaction.ContractExecuted to outlet TransactionEvents
      }
      on event Transaction.ContingencySatisfied is {
        send event Transaction.ContingencySatisfied to outlet TransactionEvents
      }
      on event Transaction.ContingencyWaived is {
        send event Transaction.ContingencyWaived to outlet TransactionEvents
      }
      on event Transaction.EscrowEntered is {
        send event Transaction.EscrowEntered to outlet TransactionEvents
      }
      on event Transaction.ClosingScheduled is {
        send event Transaction.ClosingScheduled to outlet TransactionEvents
      }
      on event Transaction.ClosingCompleted is {
        send event Transaction.ClosingCompleted to outlet TransactionEvents
      }
      on event Transaction.TransactionCancelled is {
        send event Transaction.TransactionCancelled to outlet TransactionEvents
      }
      on other is {
        error "Unexpected message for source TransactionEventSource"
      }
    } with {
      briefly "Transaction source handler"
      described as {
        |Publishes Transaction events onto the outlet.
      }
    }
  } with {
    briefly "Transaction event source"
    described as {
      |Publishes Transaction entity events into the streaming topology.
    }
  }
  processor TransactionEventSink as sink is {
    inlet TransactionInlet is type TransactionEvent
    handler TransactionSinkHandler is {
      on event Transaction.TransactionInitiated is {
        tell event Transaction.TransactionInitiated to repository TransactionContext.TransactionRepository
      }
      on event Transaction.OfferSubmitted is {
        tell event Transaction.OfferSubmitted to repository TransactionContext.TransactionRepository
      }
      on event Transaction.OfferCountered is {
        tell event Transaction.OfferCountered to repository TransactionContext.TransactionRepository
      }
      on event Transaction.OfferAccepted is {
        tell event Transaction.OfferAccepted to repository TransactionContext.TransactionRepository
      }
      on event Transaction.ContractExecuted is {
        tell event Transaction.ContractExecuted to repository TransactionContext.TransactionRepository
      }
      on event Transaction.ContingencySatisfied is {
        tell event Transaction.ContingencySatisfied to repository TransactionContext.TransactionRepository
      }
      on event Transaction.ContingencyWaived is {
        tell event Transaction.ContingencyWaived to repository TransactionContext.TransactionRepository
      }
      on event Transaction.EscrowEntered is {
        tell event Transaction.EscrowEntered to repository TransactionContext.TransactionRepository
      }
      on event Transaction.ClosingScheduled is {
        tell event Transaction.ClosingScheduled to repository TransactionContext.TransactionRepository
      }
      on event Transaction.ClosingCompleted is {
        tell event Transaction.ClosingCompleted to repository TransactionContext.TransactionRepository
      }
      on event Transaction.TransactionCancelled is {
        tell event Transaction.TransactionCancelled to repository TransactionContext.TransactionRepository
      }
      on other is {
        error "Unexpected message for sink TransactionEventSink"
      }
    } with {
      briefly "Transaction sink handler"
      described as {
        |Persists Transaction events via the repository.
      }
    }
  } with {
    briefly "Transaction event sink"
    described as {
      |Receives Transaction events for persistence.
    }
  }
  connector TransactionEventFlow is {
    from outlet TransactionContext.TransactionEventSource.TransactionEvents to
      inlet TransactionContext.TransactionEventSink.TransactionInlet
  } with {
    briefly "Transaction event flow"
    described as {
      |Connects the Transaction source to its sink.
    }
  }
  processor TransactionEventSplit is {
    inlet TransactionEventSplitIn is type TransactionEvent
    outlet TransactionEventSplitToTransactionRepository is type TransactionEvent
    outlet TransactionEventSplitToTransactionAnalytics is type TransactionEvent
    handler TransactionEventSplitHandler is {
      on event Transaction.TransactionInitiated is {
        send event Transaction.TransactionInitiated to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.TransactionInitiated to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.TransactionInitiated to entity TransactionContext.Transaction
      }
      on event Transaction.OfferSubmitted is {
        send event Transaction.OfferSubmitted to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.OfferSubmitted to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.OfferSubmitted to entity TransactionContext.Transaction
      }
      on event Transaction.OfferCountered is {
        send event Transaction.OfferCountered to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.OfferCountered to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.OfferCountered to entity TransactionContext.Transaction
      }
      on event Transaction.OfferAccepted is {
        send event Transaction.OfferAccepted to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.OfferAccepted to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.OfferAccepted to entity TransactionContext.Transaction
      }
      on event Transaction.ContractExecuted is {
        send event Transaction.ContractExecuted to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.ContractExecuted to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.ContractExecuted to entity TransactionContext.Transaction
      }
      on event Transaction.ContingencySatisfied is {
        send event Transaction.ContingencySatisfied to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.ContingencySatisfied to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.ContingencySatisfied to entity TransactionContext.Transaction
      }
      on event Transaction.ContingencyWaived is {
        send event Transaction.ContingencyWaived to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.ContingencyWaived to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.ContingencyWaived to entity TransactionContext.Transaction
      }
      on event Transaction.EscrowEntered is {
        send event Transaction.EscrowEntered to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.EscrowEntered to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.EscrowEntered to entity TransactionContext.Transaction
      }
      on event Transaction.ClosingScheduled is {
        send event Transaction.ClosingScheduled to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.ClosingScheduled to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.ClosingScheduled to entity TransactionContext.Transaction
      }
      on event Transaction.ClosingCompleted is {
        send event Transaction.ClosingCompleted to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.ClosingCompleted to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.ClosingCompleted to entity TransactionContext.Transaction
      }
      on event Transaction.TransactionCancelled is {
        send event Transaction.TransactionCancelled to outlet TransactionEventSplitToTransactionRepository
        send event Transaction.TransactionCancelled to outlet TransactionEventSplitToTransactionAnalytics
        tell event Transaction.TransactionCancelled to entity TransactionContext.Transaction
      }
      on other is {
        error "Unexpected message for processor TransactionEventSplit"
      }
    } with {
      briefly "Transaction event fan-out handler"
      described as {
        |Delivers each Transaction event to all of its consumers.
      }
    }
  } with {
    briefly "Transaction event fan-out"
    described as {
      |Fans Transaction events out to the repository and projectors.
    }
  }
  connector LinkTransactionToTransactionEventSplit is {
    from outlet TransactionContext.Transaction.TransactionEvents2 to
      inlet TransactionContext.TransactionEventSplit.TransactionEventSplitIn
  } with {
    briefly "LinkTransactionToTransactionEventSplit"
  }
  connector LinkTransactionEventSplitToTransactionRepository is {
    from outlet TransactionContext.TransactionEventSplit.TransactionEventSplitToTransactionRepository to
      inlet TransactionContext.TransactionRepository.TransactionRepositoryFromTransaction
  } with {
    briefly "LinkTransactionEventSplitToTransactionRepository"
  }
  connector LinkTransactionEventSplitToTransactionAnalytics is {
    from outlet TransactionContext.TransactionEventSplit.TransactionEventSplitToTransactionAnalytics to
      inlet TransactionContext.TransactionAnalytics.TransactionAnalyticsFromTransaction
  } with {
    briefly "LinkTransactionEventSplitToTransactionAnalytics"
  }
  connector LinkTransactionAnalyticsToTransactionRepository is {
    from outlet TransactionContext.TransactionAnalytics.TransactionAnalyticsOut to
      inlet TransactionContext.TransactionRepository.TransactionRepositoryFromTransactionAnalytics
  } with {
    briefly "LinkTransactionAnalyticsToTransactionRepository"
  }
} with {
  briefly "Bounded context for transaction management"
  described as {
    | The TransactionContext is the bounded context for real estate
    | transactions including offers, contracts, and closings.
  }
}
