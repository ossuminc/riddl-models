// Transaction Management - Transaction Context
context TransactionContext as router is {
  inlet TransactionCommandStreamIn is type TransactionCommand  outlet TransactionCommandStreamOut is type TransactionCommand
  inlet TransactionResultStreamIn is result Transaction.TransactionResult  outlet TransactionResultStreamOut is result Transaction.TransactionResult
  handler TransactionContextBoundary is {
    on initiateTransaction: command Transaction.InitiateTransaction is {
      send initiateTransaction to outlet TransactionContext.TransactionCommandStreamOut
    }
    on submitOffer: command Transaction.SubmitOffer is {
      send submitOffer to outlet TransactionContext.TransactionCommandStreamOut
    }
    on counterOffer: command Transaction.CounterOffer is {
      send counterOffer to outlet TransactionContext.TransactionCommandStreamOut
    }
    on acceptOffer: command Transaction.AcceptOffer is {
      send acceptOffer to outlet TransactionContext.TransactionCommandStreamOut
    }
    on executeContract: command Transaction.ExecuteContract is {
      send executeContract to outlet TransactionContext.TransactionCommandStreamOut
    }
    on satisfyContingency: command Transaction.SatisfyContingency is {
      send satisfyContingency to outlet TransactionContext.TransactionCommandStreamOut
    }
    on waiveContingency: command Transaction.WaiveContingency is {
      send waiveContingency to outlet TransactionContext.TransactionCommandStreamOut
    }
    on enterEscrow: command Transaction.EnterEscrow is {
      send enterEscrow to outlet TransactionContext.TransactionCommandStreamOut
    }
    on scheduleClosing: command Transaction.ScheduleClosing is {
      send scheduleClosing to outlet TransactionContext.TransactionCommandStreamOut
    }
    on completeClosing: command Transaction.CompleteClosing is {
      send completeClosing to outlet TransactionContext.TransactionCommandStreamOut
    }
    on cancelTransaction: command Transaction.CancelTransaction is {
      send cancelTransaction to outlet TransactionContext.TransactionCommandStreamOut
    }
    on transactionResult: result Transaction.TransactionResult is {
      send transactionResult to outlet TransactionContext.TransactionResultStreamOut
    }
    on other is {
      error "Unexpected message at the TransactionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TransactionCommand Stream Intake' is from outlet TransactionContext.TransactionCommandStreamOut to inlet TransactionContext.Transaction.TransactionCommands  connector 'TransactionResult Stream Egress' is from outlet TransactionContext.TransactionRepository.TransactionRepositoryResponses to inlet TransactionContext.TransactionResultStreamIn  adaptor FromDocumentService from context DocumentService is { 
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is { 
    handler ToDocumentServiceHandler is {
      on command DocumentService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromEscrowService from context EscrowService is { 
    handler FromEscrowServiceHandler is {
      on event EscrowService.EscrowOpened is {
        do "the model receives escrow opened"
      }
      on event EscrowService.FundsDisbursed is {
        do "the model receives funds disbursed"
      }
      on other is {
        error "Unexpected message for adaptor FromEscrowService"
      }
    } with {
      briefly "from escrow service"
      described as {
        |Carries messages from the external EscrowService.
      }
    }
  } with {
    briefly "EscrowService integration"
    described as {
      |The model's side of the EscrowService conversation.
    }
  }
  adaptor ToEscrowService to context EscrowService is { 
    handler ToEscrowServiceHandler is {
      on command EscrowService.DisburseFunds is {
        do "the model sends disburse funds"
      }
      on command EscrowService.OpenEscrow is {
        do "the model sends open escrow"
      }
      on other is {
        error "Unexpected message for adaptor ToEscrowService"
      }
    } with {
      briefly "to escrow service"
      described as {
        |Carries messages to the external EscrowService.
      }
    }
  } with {
    briefly "EscrowService integration"
    described as {
      |The model's side of the EscrowService conversation.
    }
  }
  adaptor FromLenderService from context LenderService is { 
    handler FromLenderServiceHandler is {
      on event LenderService.AppraisalCompleted is {
        do "the model receives appraisal completed"
      }
      on event LenderService.LoanApproved is {
        do "the model receives loan approved"
      }
      on other is {
        error "Unexpected message for adaptor FromLenderService"
      }
    } with {
      briefly "from lender service"
      described as {
        |Carries messages from the external LenderService.
      }
    }
  } with {
    briefly "LenderService integration"
    described as {
      |The model's side of the LenderService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTransactionNotification is {
        do "the model sends send transaction notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromTitleService from context TitleService is { 
    handler FromTitleServiceHandler is {
      on event TitleService.TitleSearchCompleted is {
        do "the model receives title search completed"
      }
      on other is {
        error "Unexpected message for adaptor FromTitleService"
      }
    } with {
      briefly "from title service"
      described as {
        |Carries messages from the external TitleService.
      }
    }
  } with {
    briefly "TitleService integration"
    described as {
      |The model's side of the TitleService conversation.
    }
  }
  adaptor ToTitleService to context TitleService is { 
    handler ToTitleServiceHandler is {
      on command TitleService.RequestTitleSearch is {
        do "the model sends request title search"
      }
      on other is {
        error "Unexpected message for adaptor ToTitleService"
      }
    } with {
      briefly "to title service"
      described as {
        |Carries messages to the external TitleService.
      }
    }
  } with {
    briefly "TitleService integration"
    described as {
      |The model's side of the TitleService conversation.
    }
  }
  include "types.riddl"
  include "Transaction.riddl"
  // Repository for transaction persistence
  type TransactionRepositoryCommand is one of {
    TransactionContext.TransactionRepository.PersistClosingCompleted or TransactionContext.TransactionRepository.PersistClosingScheduled or TransactionContext.TransactionRepository.PersistContingencySatisfied or TransactionContext.TransactionRepository.PersistContingencyWaived or TransactionContext.TransactionRepository.PersistContractExecuted or TransactionContext.TransactionRepository.PersistEscrowEntered or TransactionContext.TransactionRepository.PersistOfferAccepted or TransactionContext.TransactionRepository.PersistOfferCountered or TransactionContext.TransactionRepository.PersistOfferSubmitted or TransactionContext.TransactionRepository.PersistTransactionCancelled or TransactionContext.TransactionRepository.PersistTransactionInitiated
  } with {
    briefly "Anything that writes TransactionRepository"
    described as {
      |The persistence commands TransactionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository TransactionRepository as flow is {
    inlet TransactionRepositoryFromTransactionAnalytics is type TransactionRepositoryCommand    command PersistClosingScheduled is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClosingScheduled applies to.
        }
      }
    } with {
      briefly "Persist ClosingScheduled"
      described as {
        |Instructs this repository to apply ClosingScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContingencySatisfied is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContingencySatisfied applies to.
        }
      }
    } with {
      briefly "Persist ContingencySatisfied"
      described as {
        |Instructs this repository to apply ContingencySatisfied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContingencyWaived is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContingencyWaived applies to.
        }
      }
    } with {
      briefly "Persist ContingencyWaived"
      described as {
        |Instructs this repository to apply ContingencyWaived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContractExecuted is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContractExecuted applies to.
        }
      }
    } with {
      briefly "Persist ContractExecuted"
      described as {
        |Instructs this repository to apply ContractExecuted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEscrowEntered is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row EscrowEntered applies to.
        }
      }
    } with {
      briefly "Persist EscrowEntered"
      described as {
        |Instructs this repository to apply EscrowEntered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOfferAccepted is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OfferAccepted applies to.
        }
      }
    } with {
      briefly "Persist OfferAccepted"
      described as {
        |Instructs this repository to apply OfferAccepted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOfferCountered is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OfferCountered applies to.
        }
      }
    } with {
      briefly "Persist OfferCountered"
      described as {
        |Instructs this repository to apply OfferCountered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOfferSubmitted is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row OfferSubmitted applies to.
        }
      }
    } with {
      briefly "Persist OfferSubmitted"
      described as {
        |Instructs this repository to apply OfferSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionInitiated is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionInitiated applies to.
        }
      }
    } with {
      briefly "Persist TransactionInitiated"
      described as {
        |Instructs this repository to apply TransactionInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClosingCompleted is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClosingCompleted applies to.
        }
      }
    } with {
      briefly "Persist ClosingCompleted"
      described as {
        |Instructs this repository to apply ClosingCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTransactionCancelled is {
      transactionId: TransactionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TransactionCancelled applies to.
        }
      }
    } with {
      briefly "Persist TransactionCancelled"
      described as {
        |Instructs this repository to apply TransactionCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet TransactionRepositoryResponses is result Transaction.TransactionResult
    record StoredTransaction is {
      transactionId: TransactionId with {
        briefly "transactionId"
        described as {
          |The transactionId column of the stored transaction row.
        }
      }
      property: PropertyDetails with {
        briefly "property"
        described as {
          |The property column of the stored transaction row.
        }
      }
    } with {
      briefly "Stored transaction row"
      described as {
        |The persistence shape of transaction data as this repository stores it.
      }
    }
    schema TransactionData is relational
      of transactions as record StoredTransaction
        index on field StoredTransaction.transactionId
        index on field StoredTransaction.property.propertyId
 with {
      briefly "Transaction data schema"
      described as {
        |The relational schema holding transaction data for the TransactionRepository.
      }
    }
    handler TransactionPersistence is {
      on persistClosingScheduled: command PersistClosingScheduled is {
        do "apply ClosingScheduled to the stored row"
      }
      on persistContingencySatisfied: command PersistContingencySatisfied is {
        do "apply ContingencySatisfied to the stored row"
      }
      on persistContingencyWaived: command PersistContingencyWaived is {
        do "apply ContingencyWaived to the stored row"
      }
      on persistContractExecuted: command PersistContractExecuted is {
        do "apply ContractExecuted to the stored row"
      }
      on persistEscrowEntered: command PersistEscrowEntered is {
        do "apply EscrowEntered to the stored row"
      }
      on persistOfferAccepted: command PersistOfferAccepted is {
        do "apply OfferAccepted to the stored row"
      }
      on persistOfferCountered: command PersistOfferCountered is {
        do "apply OfferCountered to the stored row"
      }
      on persistOfferSubmitted: command PersistOfferSubmitted is {
        do "apply OfferSubmitted to the stored row"
      }
      on persistTransactionInitiated: command PersistTransactionInitiated is {
        do "apply TransactionInitiated to the stored row"
      }
      on persistClosingCompleted: command PersistClosingCompleted is {
        do "apply ClosingCompleted to the stored row"
      }
      on persistTransactionCancelled: command PersistTransactionCancelled is {
        do "apply TransactionCancelled to the stored row"
      }
      on query GetTransactionSummary is {
        let transactionSummaryView: type TransactionSummaryView = prompt("read the transaction summary projection")
        reply transactionSummaryView
      }
    } with {
      briefly "Persists transaction commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Transaction data persistence"
    described as {
      | The TransactionRepository provides persistent storage for
      | real estate transactions and related documents.
    }
  }
  // Projector for transaction analytics
  query GetTransactionSummary replies result TransactionSummaryView is {
    transactionSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which transaction summary to retrieve.
      }
    }
  } with {
    briefly "Get transaction summary"
    described as {
      |Retrieves the transaction summary projection.
    }
  }
  result TransactionSummaryView is {
    transactionSummary: TransactionAnalytics.TransactionSummary with {
      briefly "Transaction summary"
      described as {
        |The transaction summary being returned.
      }
    }
  } with {
    briefly "Transaction summary view"
    described as {
      |Read model view carrying the transaction summary projection.
    }
  }
  projector TransactionAnalytics as flow is {
    updates repository TransactionContext.TransactionRepository
    outlet TransactionAnalyticsToRepository is type TransactionRepositoryCommand
    inlet TransactionAnalyticsFromTransaction is type TransactionEvent    record TransactionSummary is {
      periodStart: Date with {
        briefly "Start"
        described as {
          |Period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Period end.
        }
      }
      totalTransactions: Natural with {
        briefly "Total"
        described as {
          |Total transactions.
        }
      }
      totalVolume: Money with {
        briefly "Volume"
        described as {
          |Total dollar volume.
        }
      }
      averagePrice: Money with {
        briefly "Average"
        described as {
          |Average sale price.
        }
      }
      averageDaysToClose: Natural with {
        briefly "Days"
        described as {
          |Average days to close.
        }
      }
    } with {
      briefly "Transaction summary"
      described as {
        |Transaction metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on closingScheduled: event Transaction.ClosingScheduled is {
        tell command TransactionContext.TransactionRepository.PersistClosingScheduled(transactionId = closingScheduled.transactionId) to repository TransactionContext.TransactionRepository
        do "apply ClosingScheduled to the TransactionAnalytics projection"
      }
      on contingencySatisfied: event Transaction.ContingencySatisfied is {
        tell command TransactionContext.TransactionRepository.PersistContingencySatisfied(transactionId = contingencySatisfied.transactionId) to repository TransactionContext.TransactionRepository
        do "apply ContingencySatisfied to the TransactionAnalytics projection"
      }
      on contingencyWaived: event Transaction.ContingencyWaived is {
        tell command TransactionContext.TransactionRepository.PersistContingencyWaived(transactionId = contingencyWaived.transactionId) to repository TransactionContext.TransactionRepository
        do "apply ContingencyWaived to the TransactionAnalytics projection"
      }
      on contractExecuted: event Transaction.ContractExecuted is {
        tell command TransactionContext.TransactionRepository.PersistContractExecuted(transactionId = contractExecuted.transactionId) to repository TransactionContext.TransactionRepository
        do "apply ContractExecuted to the TransactionAnalytics projection"
      }
      on escrowEntered: event Transaction.EscrowEntered is {
        tell command TransactionContext.TransactionRepository.PersistEscrowEntered(transactionId = escrowEntered.transactionId) to repository TransactionContext.TransactionRepository
        do "apply EscrowEntered to the TransactionAnalytics projection"
      }
      on offerAccepted: event Transaction.OfferAccepted is {
        tell command TransactionContext.TransactionRepository.PersistOfferAccepted(transactionId = offerAccepted.transactionId) to repository TransactionContext.TransactionRepository
        do "apply OfferAccepted to the TransactionAnalytics projection"
      }
      on offerCountered: event Transaction.OfferCountered is {
        tell command TransactionContext.TransactionRepository.PersistOfferCountered(transactionId = offerCountered.transactionId) to repository TransactionContext.TransactionRepository
        do "apply OfferCountered to the TransactionAnalytics projection"
      }
      on offerSubmitted: event Transaction.OfferSubmitted is {
        tell command TransactionContext.TransactionRepository.PersistOfferSubmitted(transactionId = offerSubmitted.transactionId) to repository TransactionContext.TransactionRepository
        do "apply OfferSubmitted to the TransactionAnalytics projection"
      }
      on transactionInitiated: event Transaction.TransactionInitiated is {
        tell command TransactionContext.TransactionRepository.PersistTransactionInitiated(transactionId = transactionInitiated.transactionId) to repository TransactionContext.TransactionRepository
        do "apply TransactionInitiated to the TransactionAnalytics projection"
      }
      on closingCompleted: event Transaction.ClosingCompleted is {
        tell command TransactionContext.TransactionRepository.PersistClosingCompleted(transactionId = closingCompleted.transactionId) to repository TransactionContext.TransactionRepository
        do "Update transaction volume and averages"
      }
      on transactionCancelled: event Transaction.TransactionCancelled is {
        tell command TransactionContext.TransactionRepository.PersistTransactionCancelled(transactionId = transactionCancelled.transactionId) to repository TransactionContext.TransactionRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains transaction analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Transaction analytics projections"
    described as {
      |Maintains transaction analytics data.
    }
  }
  // ---- Event publication for Transaction ----
  type TransactionEvent is one of {
    TransactionContext.Transaction.TransactionInitiated or TransactionContext.Transaction.OfferSubmitted or TransactionContext.Transaction.OfferCountered or TransactionContext.Transaction.OfferAccepted or TransactionContext.Transaction.ContractExecuted or TransactionContext.Transaction.ContingencySatisfied or TransactionContext.Transaction.ContingencyWaived or TransactionContext.Transaction.EscrowEntered or TransactionContext.Transaction.ClosingScheduled or TransactionContext.Transaction.ClosingCompleted or TransactionContext.Transaction.TransactionCancelled
  } with {
    briefly "Transaction event alternation"
    described as {
      |Union of all Transaction events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TransactionEventSplit as flow is {
    inlet TransactionEventSplitIn is type TransactionEvent    outlet TransactionEventSplitToTransactionAnalytics is type TransactionEvent
    handler TransactionEventSplitHandler is {
      on transactionInitiated: event Transaction.TransactionInitiated is {
        send transactionInitiated to outlet TransactionEventSplitToTransactionAnalytics
        tell transactionInitiated to entity TransactionContext.Transaction
      }
      on offerSubmitted: event Transaction.OfferSubmitted is {
        send offerSubmitted to outlet TransactionEventSplitToTransactionAnalytics
        tell offerSubmitted to entity TransactionContext.Transaction
      }
      on offerCountered: event Transaction.OfferCountered is {
        send offerCountered to outlet TransactionEventSplitToTransactionAnalytics
        tell offerCountered to entity TransactionContext.Transaction
      }
      on offerAccepted: event Transaction.OfferAccepted is {
        send offerAccepted to outlet TransactionEventSplitToTransactionAnalytics
        tell offerAccepted to entity TransactionContext.Transaction
      }
      on contractExecuted: event Transaction.ContractExecuted is {
        send contractExecuted to outlet TransactionEventSplitToTransactionAnalytics
        tell contractExecuted to entity TransactionContext.Transaction
      }
      on contingencySatisfied: event Transaction.ContingencySatisfied is {
        send contingencySatisfied to outlet TransactionEventSplitToTransactionAnalytics
        tell contingencySatisfied to entity TransactionContext.Transaction
      }
      on contingencyWaived: event Transaction.ContingencyWaived is {
        send contingencyWaived to outlet TransactionEventSplitToTransactionAnalytics
        tell contingencyWaived to entity TransactionContext.Transaction
      }
      on escrowEntered: event Transaction.EscrowEntered is {
        send escrowEntered to outlet TransactionEventSplitToTransactionAnalytics
        tell escrowEntered to entity TransactionContext.Transaction
      }
      on closingScheduled: event Transaction.ClosingScheduled is {
        send closingScheduled to outlet TransactionEventSplitToTransactionAnalytics
        tell closingScheduled to entity TransactionContext.Transaction
      }
      on closingCompleted: event Transaction.ClosingCompleted is {
        send closingCompleted to outlet TransactionEventSplitToTransactionAnalytics
        tell closingCompleted to entity TransactionContext.Transaction
      }
      on transactionCancelled: event Transaction.TransactionCancelled is {
        send transactionCancelled to outlet TransactionEventSplitToTransactionAnalytics
        tell transactionCancelled to entity TransactionContext.Transaction
      }
      on other is {
        error "Unexpected message for processor TransactionEventSplit"
      }
    } with {
      briefly "Transaction event fan-out handler"
      described as {
        |Delivers each Transaction event to all of its consumers.
      }
    }
  } with {
    briefly "Transaction event fan-out"
    described as {
      |Fans Transaction events out to the repository and projectors.
    }
  }
  connector 'TransactionEvent Stream' is from outlet TransactionContext.Transaction.TransactionEvents2 to inlet TransactionContext.TransactionEventSplit.TransactionEventSplitIn with {
    briefly "Transaction events, fanned out to storage and read models"
  }
  connector 'TransactionAnalytics Feed' is from outlet TransactionContext.TransactionEventSplit.TransactionEventSplitToTransactionAnalytics to inlet TransactionContext.TransactionAnalytics.TransactionAnalyticsFromTransaction with {
    briefly "Transaction events feeding the TransactionAnalytics projection"
  }
  connector 'TransactionAnalytics Storage' is from outlet TransactionContext.TransactionAnalytics.TransactionAnalyticsToRepository to inlet TransactionContext.TransactionRepository.TransactionRepositoryFromTransactionAnalytics with {
    briefly "TransactionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for transaction management"
  described as {
    | The TransactionContext is the bounded context for real estate
    | transactions including offers, contracts, and closings.
  }
}
