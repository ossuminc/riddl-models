// Transaction Management - Transaction Entity
entity Transaction as flow is {
  type TransactionCommand is one of {
    Transaction.InitiateTransaction or Transaction.SubmitOffer or Transaction.CounterOffer or Transaction.AcceptOffer or Transaction.ExecuteContract or Transaction.SatisfyContingency or Transaction.WaiveContingency or Transaction.EnterEscrow or Transaction.ScheduleClosing or Transaction.CompleteClosing or Transaction.CancelTransaction
  } with {
    briefly "Transaction command alternation"
    described as {
      |Commands accepted by the Transaction entity.
    }
  }
  inlet TransactionCommands is type TransactionCommand  outlet TransactionEvents2 is type TransactionEvent
  query GetTransaction replies result TransactionResult is {
    transactionId: TransactionId with {
      briefly "ID"
      described as {
        |Identifier of the Transaction to retrieve.
      }
    }
  } with {
    briefly "Get Transaction"
    described as {
      |Retrieve Transaction data by identifier.
    }
  }
  result TransactionResult is  {
    transactionId: TransactionId with {
      briefly "Transaction addressed"
      described as {
        |Which transaction this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    transactionData: Transaction.PendingTransactionData with {
      briefly "Transaction data"
      described as {
        |The requested Transaction data.
      }
    }
  } with {
    briefly "Transaction result"
    described as {
      |Result carrying the requested Transaction data.
    }
  }
  // Commands
  command InitiateTransaction is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |New transaction identifier.
      }
    }
    transactionType: TransactionType with {
      briefly "Type"
      described as {
        |Transaction type.
      }
    }
    property: PropertyDetails with {
      briefly "Property"
      described as {
        |Property details.
      }
    }
    seller: Party with {
      briefly "Seller"
      described as {
        |Selling party.
      }
    }
  } with {
    briefly "Initiate transaction"
    described as {
      |Starts a new transaction.
    }
  }
  command SubmitOffer is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    buyer: Party with {
      briefly "Buyer"
      described as {
        |Buying party.
      }
    }
    offer: Offer with {
      briefly "Offer"
      described as {
        |Purchase offer.
      }
    }
  } with {
    briefly "Submit offer"
    described as {
      |Submits a purchase offer.
    }
  }
  command CounterOffer is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    counteredBy: PartyType with {
      briefly "By"
      described as {
        |Who countered.
      }
    }
    offer: Offer with {
      briefly "Offer"
      described as {
        |Counter offer.
      }
    }
  } with {
    briefly "Counter offer"
    described as {
      |Submits a counter offer.
    }
  }
  command AcceptOffer is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    offerId: UUID with {
      briefly "Offer ID"
      described as {
        |Offer to accept.
      }
    }
    acceptedBy: PartyType with {
      briefly "By"
      described as {
        |Who accepted.
      }
    }
  } with {
    briefly "Accept offer"
    described as {
      |Accepts an offer.
    }
  }
  command ExecuteContract is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    contract: Contract with {
      briefly "Contract"
      described as {
        |Purchase contract.
      }
    }
  } with {
    briefly "Execute contract"
    described as {
      |Executes the purchase contract.
    }
  }
  command SatisfyContingency is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    contingencyType: ContingencyType with {
      briefly "Type"
      described as {
        |Contingency type.
      }
    }
    notes: String(1,500)? with {
      briefly "Notes"
      described as {
        |Satisfaction notes.
      }
    }
  } with {
    briefly "Satisfy contingency"
    described as {
      |Marks contingency as satisfied.
    }
  }
  command WaiveContingency is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    contingencyType: ContingencyType with {
      briefly "Type"
      described as {
        |Contingency to waive.
      }
    }
    waivedBy: PartyType with {
      briefly "By"
      described as {
        |Who waived.
      }
    }
  } with {
    briefly "Waive contingency"
    described as {
      |Waives a contingency.
    }
  }
  command EnterEscrow is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    escrowAgent: Party with {
      briefly "Escrow agent"
      described as {
        |Escrow agent.
      }
    }
    escrowAccountNumber: String(1,50) with {
      briefly "Account"
      described as {
        |Escrow account number.
      }
    }
  } with {
    briefly "Enter escrow"
    described as {
      |Transaction enters escrow.
    }
  }
  command ScheduleClosing is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    closingDate: Date with {
      briefly "Date"
      described as {
        |Closing date.
      }
    }
    closingLocation: String(1,500) with {
      briefly "Location"
      described as {
        |Closing location.
      }
    }
  } with {
    briefly "Schedule closing"
    described as {
      |Schedules the closing.
    }
  }
  command CompleteClosing is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    finalClosingCosts: ClosingCosts with {
      briefly "Costs"
      described as {
        |Final closing costs.
      }
    }
    documents: ClosingDocument+ with {
      briefly "Documents"
      described as {
        |Closing documents.
      }
    }
  } with {
    briefly "Complete closing"
    described as {
      |Completes the transaction closing.
    }
  }
  command CancelTransaction is  {
    transactionId: TransactionId with {
      briefly "Transaction ID"
      described as {
        |Transaction ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledBy: PartyType with {
      briefly "By"
      described as {
        |Who cancelled.
      }
    }
  } with {
    briefly "Cancel transaction"
    described as {
      |Cancels the transaction.
    }
  }
  // Events
  event TransactionInitiated is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    transactionType: TransactionType with {
      briefly "Type"
      described as {
        |Transaction type.
      }
    }
    property: PropertyDetails with {
      briefly "Property"
      described as {
        |Property details.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated"
      described as {
        |Initiation time.
      }
    }
  } with {
    briefly "Transaction was initiated"
    described as {
      |Emitted when transaction starts.
    }
  }
  event OfferSubmitted is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    offer: Offer with {
      briefly "Offer"
      described as {
        |Submitted offer.
      }
    }
    buyer: Party with {
      briefly "Buyer"
      described as {
        |Buying party.
      }
    }
  } with {
    briefly "Offer was submitted"
    described as {
      |Emitted when offer is submitted.
    }
  }
  event OfferCountered is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    offer: Offer with {
      briefly "Offer"
      described as {
        |Counter offer.
      }
    }
    counteredBy: PartyType with {
      briefly "By"
      described as {
        |Who countered.
      }
    }
  } with {
    briefly "Offer was countered"
    described as {
      |Emitted when offer is countered.
    }
  }
  event OfferAccepted is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    offerId: UUID with {
      briefly "Offer"
      described as {
        |Accepted offer ID.
      }
    }
    acceptedAt: TimeStamp with {
      briefly "Accepted"
      described as {
        |Acceptance time.
      }
    }
  } with {
    briefly "Offer was accepted"
    described as {
      |Emitted when offer is accepted.
    }
  }
  event ContractExecuted is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    contract: Contract with {
      briefly "Contract"
      described as {
        |Executed contract.
      }
    }
  } with {
    briefly "Contract was executed"
    described as {
      |Emitted when contract is signed.
    }
  }
  event ContingencySatisfied is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    contingencyType: ContingencyType with {
      briefly "Type"
      described as {
        |Contingency type.
      }
    }
    satisfiedAt: TimeStamp with {
      briefly "Satisfied"
      described as {
        |Satisfaction time.
      }
    }
  } with {
    briefly "Contingency was satisfied"
    described as {
      |Emitted when contingency is met.
    }
  }
  event ContingencyWaived is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    contingencyType: ContingencyType with {
      briefly "Type"
      described as {
        |Contingency type.
      }
    }
    waivedAt: TimeStamp with {
      briefly "Waived"
      described as {
        |Waiver time.
      }
    }
  } with {
    briefly "Contingency was waived"
    described as {
      |Emitted when contingency is waived.
    }
  }
  event EscrowEntered is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    escrowAccountNumber: String(1,50) with {
      briefly "Account"
      described as {
        |Escrow account.
      }
    }
    enteredAt: TimeStamp with {
      briefly "Entered"
      described as {
        |Entry time.
      }
    }
  } with {
    briefly "Escrow was entered"
    described as {
      |Emitted when transaction enters escrow.
    }
  }
  event ClosingScheduled is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    closingDate: Date with {
      briefly "Date"
      described as {
        |Closing date.
      }
    }
    scheduledAt: TimeStamp with {
      briefly "Scheduled"
      described as {
        |Schedule time.
      }
    }
  } with {
    briefly "Closing was scheduled"
    described as {
      |Emitted when closing is scheduled.
    }
  }
  event ClosingCompleted is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    finalClosingCosts: ClosingCosts with {
      briefly "Costs"
      described as {
        |Final costs.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Close time.
      }
    }
  } with {
    briefly "Closing was completed"
    described as {
      |Emitted when transaction closes.
    }
  }
  event TransactionCancelled is  {
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Transaction was cancelled"
    described as {
      |Emitted when transaction is cancelled.
    }
  }
  // State Records
  record PendingTransactionData is  {
    stateValue: TransactionStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    transactionType: TransactionType with {
      briefly "Type"
      described as {
        |Transaction type.
      }
    }
    property: PropertyDetails with {
      briefly "Property"
      described as {
        |Property details.
      }
    }
    seller: Party with {
      briefly "Seller"
      described as {
        |Selling party.
      }
    }
    offers: Offer+ with {
      briefly "Offers"
      described as {
        |Submitted offers.
      }
    }
    initiatedAt: TimeStamp with {
      briefly "Initiated"
      described as {
        |Initiation time.
      }
    }
  } with {
    briefly "Pending transaction data"
    described as {
      |State data for pending transaction.
    }
  }
  record UnderContractData is  {
    stateValue: TransactionStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    transactionType: TransactionType with {
      briefly "Type"
      described as {
        |Transaction type.
      }
    }
    property: PropertyDetails with {
      briefly "Property"
      described as {
        |Property details.
      }
    }
    seller: Party with {
      briefly "Seller"
      described as {
        |Selling party.
      }
    }
    buyer: Party with {
      briefly "Buyer"
      described as {
        |Buying party.
      }
    }
    contract: Contract with {
      briefly "Contract"
      described as {
        |Purchase contract.
      }
    }
    contingencies: Contingency+ with {
      briefly "Contingencies"
      described as {
        |Contract contingencies.
      }
    }
  } with {
    briefly "Under contract data"
    described as {
      |State data for contract execution.
    }
  }
  record InEscrowData is  {
    stateValue: TransactionStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    transactionType: TransactionType with {
      briefly "Type"
      described as {
        |Transaction type.
      }
    }
    property: PropertyDetails with {
      briefly "Property"
      described as {
        |Property details.
      }
    }
    seller: Party with {
      briefly "Seller"
      described as {
        |Selling party.
      }
    }
    buyer: Party with {
      briefly "Buyer"
      described as {
        |Buying party.
      }
    }
    contract: Contract with {
      briefly "Contract"
      described as {
        |Purchase contract.
      }
    }
    escrowAccountNumber: String(1,50) with {
      briefly "Escrow"
      described as {
        |Escrow account.
      }
    }
    updatedClosingDate: Date? with {
      briefly "Closing"
      described as {
        |Scheduled closing.
      }
    }
  } with {
    briefly "In escrow data"
    described as {
      |State data for escrow period.
    }
  }
  record ClosedTransactionData is  {
    stateValue: TransactionStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    transactionType: TransactionType with {
      briefly "Type"
      described as {
        |Transaction type.
      }
    }
    property: PropertyDetails with {
      briefly "Property"
      described as {
        |Property details.
      }
    }
    seller: Party with {
      briefly "Seller"
      described as {
        |Selling party.
      }
    }
    buyer: Party with {
      briefly "Buyer"
      described as {
        |Buying party.
      }
    }
    finalClosingCosts: ClosingCosts with {
      briefly "Costs"
      described as {
        |Final costs.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Close time.
      }
    }
  } with {
    briefly "Closed transaction data"
    described as {
      |State data for closed transaction.
    }
  }
  record CancelledTransactionData is  {
    stateValue: TransactionStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    transactionId: TransactionId with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    property: PropertyDetails with {
      briefly "Property"
      described as {
        |Property details.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Cancelled transaction data"
    described as {
      |State data for cancelled transaction.
    }
  }
  // States
  initial state PendingState of record Transaction.PendingTransactionData is {
    initial handler PendingStateInitHandler is {
      on query GetTransaction is {
        let transactionResult: type TransactionResult = prompt("read the transaction from the store")
        reply transactionResult
      }
      on init is {
        set state PendingState to "initialize from prior event"
        set field PendingTransactionData.stateValue to "Pending"
      }
    } with {
      briefly "PendingState init handler"
      described as {
        |Initializes the PendingState state.
      }
    }
  } with {
    briefly "PendingState state"
    described as {
      |The PendingState state of the Transaction.
    }
  }
  state UnderContractState of record Transaction.UnderContractData is {
    initial handler UnderContractStateInitHandler is {
      on init is {
        set state UnderContractState to "initialize from prior event"
        set field UnderContractData.stateValue to "UnderContract"
      }
    } with {
      briefly "UnderContractState init handler"
      described as {
        |Initializes the UnderContractState state.
      }
    }
  } with {
    briefly "UnderContractState state"
    described as {
      |The UnderContractState state of the Transaction.
    }
  }
  state InEscrowState of record Transaction.InEscrowData is {
    initial handler InEscrowStateInitHandler is {
      on init is {
        set state InEscrowState to "initialize from prior event"
        set field InEscrowData.stateValue to "InEscrow"
      }
    } with {
      briefly "InEscrowState init handler"
      described as {
        |Initializes the InEscrowState state.
      }
    }
  } with {
    briefly "InEscrowState state"
    described as {
      |The InEscrowState state of the Transaction.
    }
  }
  state ClosedState of record Transaction.ClosedTransactionData is {
    initial handler ClosedStateInitHandler is {
      on init is {
        set state ClosedState to "initialize from prior event"
        set field ClosedTransactionData.stateValue to "Closed"
      }
    } with {
      briefly "ClosedState init handler"
      described as {
        |Initializes the ClosedState state.
      }
    }
  } with {
    briefly "ClosedState state"
    described as {
      |The ClosedState state of the Transaction.
    }
  }
  state CancelledState of record Transaction.CancelledTransactionData is {
    initial handler CancelledStateInitHandler is {
      on init is {
        set state CancelledState to "initialize from prior event"
        set field CancelledTransactionData.stateValue to "Cancelled"
      }
    } with {
      briefly "CancelledState init handler"
      described as {
        |Initializes the CancelledState state.
      }
    }
  } with {
    briefly "CancelledState state"
    described as {
      |The CancelledState state of the Transaction.
    }
  }
  // Handler
  handler TransactionHandler is {
    on initiateTransaction: command InitiateTransaction is {
      morph entity TransactionContext.Transaction to state TransactionContext.Transaction.PendingState with record Transaction.PendingTransactionData(transactionId = initiateTransaction.transactionId, transactionType = initiateTransaction.transactionType, property = initiateTransaction.property, seller = initiateTransaction.seller)
      tell event TransactionInitiated(transactionId = initiateTransaction.transactionId, transactionType = initiateTransaction.transactionType, property = initiateTransaction.property) to entity TransactionContext.Transaction
    }
    on submitOffer: command SubmitOffer is {
      tell event OfferSubmitted(transactionId = submitOffer.transactionId, offer = submitOffer.offer, buyer = submitOffer.buyer) to entity TransactionContext.Transaction
    }
    on counterOffer: command CounterOffer is {
      tell event OfferCountered(transactionId = counterOffer.transactionId, offer = counterOffer.offer, counteredBy = counterOffer.counteredBy) to entity TransactionContext.Transaction
    }
    on acceptOffer: command AcceptOffer is {
      tell event OfferAccepted(transactionId = acceptOffer.transactionId, offerId = acceptOffer.offerId) to entity TransactionContext.Transaction
    }
    on executeContract: command ExecuteContract is {
      morph entity TransactionContext.Transaction to state TransactionContext.Transaction.UnderContractState with record Transaction.UnderContractData(transactionId = executeContract.transactionId, contract = executeContract.contract)
      tell event ContractExecuted(transactionId = executeContract.transactionId, contract = executeContract.contract) to entity TransactionContext.Transaction
    }
    on satisfyContingency: command SatisfyContingency is {
      tell event ContingencySatisfied(transactionId = satisfyContingency.transactionId, contingencyType = satisfyContingency.contingencyType) to entity TransactionContext.Transaction
    }
    on waiveContingency: command WaiveContingency is {
      tell event ContingencyWaived(transactionId = waiveContingency.transactionId, contingencyType = waiveContingency.contingencyType) to entity TransactionContext.Transaction
    }
    on enterEscrow: command EnterEscrow is {
      morph entity TransactionContext.Transaction to state TransactionContext.Transaction.InEscrowState with record Transaction.InEscrowData(transactionId = enterEscrow.transactionId, escrowAccountNumber = enterEscrow.escrowAccountNumber)
      tell event EscrowEntered(transactionId = enterEscrow.transactionId, escrowAccountNumber = enterEscrow.escrowAccountNumber) to entity TransactionContext.Transaction
    }
    on scheduleClosing: command ScheduleClosing is {
      tell event ClosingScheduled(transactionId = scheduleClosing.transactionId, closingDate = scheduleClosing.closingDate) to entity TransactionContext.Transaction
    }
    on completeClosing: command CompleteClosing is {
      morph entity TransactionContext.Transaction to state TransactionContext.Transaction.ClosedState with record Transaction.ClosedTransactionData(transactionId = completeClosing.transactionId, finalClosingCosts = completeClosing.finalClosingCosts)
      tell event ClosingCompleted(transactionId = completeClosing.transactionId, finalClosingCosts = completeClosing.finalClosingCosts) to entity TransactionContext.Transaction
    }
    on cancelTransaction: command CancelTransaction is {
      morph entity TransactionContext.Transaction to state TransactionContext.Transaction.CancelledState with record Transaction.CancelledTransactionData(transactionId = cancelTransaction.transactionId, reason = cancelTransaction.reason)
      tell event TransactionCancelled(transactionId = cancelTransaction.transactionId, reason = cancelTransaction.reason) to entity TransactionContext.Transaction
    }
  } with {
    briefly "Processes transaction commands"
    described as {
      | Handles transaction lifecycle from initiation
      | through offers, contract, escrow, and closing.
    }
  }
} with {
  briefly "Transaction aggregate"
  described as {
    | The Transaction entity manages real estate transactions
    | from initial listing through closing.
  }
}
