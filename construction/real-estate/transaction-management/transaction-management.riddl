// Transaction Management Domain Model
// Real estate purchase and sale transactions
domain TransactionManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Agent is "real estate agent handling transactions" with {
    briefly "Agent"
    described as {
      |Licensed real estate agent.
    }
  }
  user Buyer is "person purchasing property" with {
    briefly "Buyer"
    described as {
      |Person or entity buying property.
    }
  }
  user Seller is "person selling property" with {
    briefly "Seller"
    described as {
      |Person or entity selling property.
    }
  }
  epic PurchaseTransactionEpic is {
    user Agent wants to "to manage property purchase transactions" so that "buyers and sellers can complete property transfers"
    case ProcessPurchase is {
      user Agent wants to "to guide a buyer through property purchase" so that "the transaction closes successfully"
      step is "Agent receives offer" "from buyer" "with terms" with {
        briefly "Receive offer"
        described as {
          |Agent receives purchase offer.
        }
      }
      step is "Agent negotiates terms" "between parties" "to agreement" with {
        briefly "Negotiate"
        described as {
          |Agent facilitates negotiation.
        }
      }
      step take input TransactionManagementApp.TransactionManagementScreen.ExecuteContractInput from user Agent with {
        briefly "Execute contract"
        described as {
          |Send contract execution command.
        }
      }
      step is "System initiates closing" "with title and escrow" "processes" with {
        briefly "Initiate closing"
        described as {
          |System starts closing process.
        }
      }
    } with {
      briefly "Purchase processing workflow"
      described as {
        |Standard flow for property purchases.
      }
    }
  } with {
    briefly "Purchase transaction processing"
    described as {
      | Epic covering real estate purchase from offer
      | through negotiation and closing.
    }
  }
  include "TransactionContext.riddl"
  include "external-contexts.riddl"
  application context TransactionManagementApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TransactionManagement are delivered.
      }
    }
    group TransactionManagementScreen is {
      input ExecuteContractInput acquires command TransactionContext.Transaction.ExecuteContract with {
        briefly "Execute contract control"
        described as {
          |The control through which a user submits the execute contract request.
        }
      }
    } with {
      briefly "Transaction management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTransactionCommands is type TransactionContext.Transaction.TransactionCommand
    inlet AppTransactionRepositoryResponses is type TransactionContext.Transaction.TransactionResult    handler TransactionManagementAppHandler is {
      on other is {
        error "Unexpected message for application context TransactionManagementApp"
      }
    } with {
      briefly "TransactionManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TransactionManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'TransactionCommand Stream' is from outlet TransactionManagementApp.AppTransactionCommands to inlet TransactionContext.Transaction.TransactionCommands with {
    option persistent()
    briefly "Transaction commands from the application"
  }
  connector 'TransactionResult Stream' is from outlet TransactionContext.TransactionRepository.TransactionRepositoryResponses to inlet TransactionManagementApp.AppTransactionRepositoryResponses with {
    option persistent()
    briefly "Transaction query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TransactionManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Transaction management domain"
  described as {
    | The TransactionManagement domain handles real estate
    | transactions including purchases, sales, and closings.
  }
}
