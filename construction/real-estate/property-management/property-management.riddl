// Property Management Domain Model
// Commercial and residential property operations and tenant management
domain PropertyManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PropertyManager is "manager overseeing properties" with {
    briefly "Property manager"
    described as {
      |Staff managing property operations.
    }
  }
  user Tenant is "tenant renting property" with {
    briefly "Tenant"
    described as {
      |Person or business renting space.
    }
  }
  user MaintenanceStaff is "staff handling maintenance" with {
    briefly "Maintenance staff"
    described as {
      |Staff performing property maintenance.
    }
  }
  epic LeaseManagementEpic is {
    user PropertyManager wants to "to manage tenant leases" so that "properties are fully occupied and profitable"
    case ProcessLeaseApplication is {
      user PropertyManager wants to "to evaluate and approve lease applications" so that "qualified tenants can occupy units"
      step is "Manager receives application" "with tenant information" "and references" with {
        briefly "Receive app"
        described as {
          |Manager receives lease application.
        }
      }
      step is "Manager verifies tenant" "checking credit" "and background" with {
        briefly "Verify tenant"
        described as {
          |Manager performs verification.
        }
      }
      step take input PropertyManagementApp.PropertyManagementScreen.ApproveLeaseInput from user PropertyManager with {
        briefly "Approve lease"
        described as {
          |Send lease approval command.
        }
      }
      step is "System generates lease" "and notifies tenant" "of approval" with {
        briefly "Generate lease"
        described as {
          |System creates lease documents.
        }
      }
    } with {
      briefly "Lease processing workflow"
      described as {
        |Standard flow for processing lease applications.
      }
    }
  } with {
    briefly "Lease management processing"
    described as {
      | Epic covering lease management from application
      | through approval and move-in.
    }
  }
  include "PropertyContext.riddl"
  include "external-contexts.riddl"
  application context PropertyManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PropertyManagement are delivered.
      }
    }
    group PropertyManagementScreen is {
      input ApproveLeaseInput acquires command PropertyContext.Property.ApproveLease with {
        briefly "Approve lease control"
        described as {
          |The control through which a user submits the approve lease request.
        }
      }
    } with {
      briefly "Property management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPropertyCommands is type PropertyContext.Property.PropertyCommand
    inlet AppPropertyRepositoryResponses is type PropertyContext.Property.PropertyResult    handler PropertyManagementAppHandler is {
      on other is {
        error "Unexpected message for application context PropertyManagementApp"
      }
    } with {
      briefly "PropertyManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PropertyManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'PropertyCommand Stream' is from outlet PropertyManagementApp.AppPropertyCommands to inlet PropertyContext.Property.PropertyCommands with {
    briefly "Property commands from the application"
  }
  persistent connector 'PropertyResult Stream' is from outlet PropertyContext.PropertyRepository.PropertyRepositoryResponses to inlet PropertyManagementApp.AppPropertyRepositoryResponses with {
    briefly "Property query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PropertyManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Property management domain"
  described as {
    | The PropertyManagement domain handles real estate property
    | operations including leasing, maintenance, and tenant services.
  }
}
