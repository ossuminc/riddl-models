// Property Management - Property Context
context PropertyContext is {
  adaptor FromMaintenanceDispatchService from context MaintenanceDispatchService is { 
    handler FromMaintenanceDispatchServiceHandler is {
      on event MaintenanceDispatchService.TechnicianDispatched is {
        do "the model receives technician dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceDispatchService"
      }
    } with {
      briefly "from maintenance dispatch service"
      described as {
        |Carries messages from the external MaintenanceDispatchService.
      }
    }
  } with {
    briefly "MaintenanceDispatchService integration"
    described as {
      |The model's side of the MaintenanceDispatchService conversation.
    }
  }
  adaptor ToMaintenanceDispatchService to context MaintenanceDispatchService is { 
    handler ToMaintenanceDispatchServiceHandler is {
      on command MaintenanceDispatchService.DispatchTechnician is {
        do "the model sends dispatch technician"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceDispatchService"
      }
    } with {
      briefly "to maintenance dispatch service"
      described as {
        |Carries messages to the external MaintenanceDispatchService.
      }
    }
  } with {
    briefly "MaintenanceDispatchService integration"
    described as {
      |The model's side of the MaintenanceDispatchService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTenantNotification is {
        do "the model sends send tenant notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.RentPaymentProcessed is {
        do "the model receives rent payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessRentPayment is {
        do "the model sends process rent payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromTenantScreeningService from context TenantScreeningService is { 
    handler FromTenantScreeningServiceHandler is {
      on event TenantScreeningService.ScreeningCompleted is {
        do "the model receives screening completed"
      }
      on other is {
        error "Unexpected message for adaptor FromTenantScreeningService"
      }
    } with {
      briefly "from tenant screening service"
      described as {
        |Carries messages from the external TenantScreeningService.
      }
    }
  } with {
    briefly "TenantScreeningService integration"
    described as {
      |The model's side of the TenantScreeningService conversation.
    }
  }
  adaptor ToTenantScreeningService to context TenantScreeningService is { 
    handler ToTenantScreeningServiceHandler is {
      on command TenantScreeningService.ScreenTenant is {
        do "the model sends screen tenant"
      }
      on other is {
        error "Unexpected message for adaptor ToTenantScreeningService"
      }
    } with {
      briefly "to tenant screening service"
      described as {
        |Carries messages to the external TenantScreeningService.
      }
    }
  } with {
    briefly "TenantScreeningService integration"
    described as {
      |The model's side of the TenantScreeningService conversation.
    }
  }
  include "types.riddl"
  include "Property.riddl"
  // Repository for property persistence
  repository PropertyRepository as merge is {
    inlet PropertyRepositoryFromProperty is type PropertyEvent    inlet PropertyRepositoryFromPropertyAnalytics is type PropertyEvent    outlet PropertyRepositoryResponses is type Property.PropertyResult
    record StoredProperty is  {
      propertyId: PropertyId with {
        briefly "propertyId"
        described as {
          |The propertyId column of the stored property row.
        }
      }
    } with {
      briefly "Stored property row"
      described as {
        |The persistence shape of property data as this repository stores it.
      }
    }
    schema PropertyData is relational
      of properties as type StoredProperty
        index on field StoredProperty.propertyId
 with {
      briefly "Property data schema"
      described as {
        |The relational schema holding property data for the PropertyRepository.
      }
    }
    handler PropertyPersistence is {
      on query GetPropertySummary is {
        do "read the property summary projection"
        yield result PropertySummaryView
      }
      on command Property.AddProperty is {
        tell event Property.PropertyAdded to entity PropertyContext.Property
        do "Store new property record"
      }
      on command Property.ApproveLease is {
        tell event Property.LeaseApproved to entity PropertyContext.Property
        do "Store lease and update unit status"
      }
      on command Property.RecordPayment is {
        tell event Property.PaymentRecorded to entity PropertyContext.Property
        do "Store rent payment"
      }
      on command Property.SubmitMaintenanceRequest is {
        tell event Property.MaintenanceRequestSubmitted to entity PropertyContext.Property
        do "Store maintenance request"
      }
      on command Property.CompleteMaintenanceRequest is {
        tell event Property.MaintenanceRequestCompleted to entity PropertyContext.Property
        do "Update request as completed"
      }
    } with {
      briefly "Persists property commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Property data persistence"
    described as {
      | The PropertyRepository provides persistent storage for
      | properties, leases, and maintenance records.
    }
  }
  // Projector for property analytics
  query GetPropertySummary is  {
    propertySummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which property summary to retrieve.
      }
    }
  } with {
    briefly "Get property summary"
    described as {
      |Retrieves the property summary projection.
    }
  }
  result PropertySummaryView is  {
    propertySummary: PropertyAnalytics.PropertySummary with {
      briefly "Property summary"
      described as {
        |The property summary being returned.
      }
    }
  } with {
    briefly "Property summary view"
    described as {
      |Read model view carrying the property summary projection.
    }
  }
  projector PropertyAnalytics as flow is {
    updates repository PropertyContext.PropertyRepository
    inlet PropertyAnalyticsFromProperty is type PropertyEvent    outlet PropertyAnalyticsOut is type PropertyEvent
    record PropertySummary is  {
      propertyId: PropertyId with {
        briefly "Property"
        described as {
          |Property ID.
        }
      }
      occupancyRate: Decimal(5,2) with {
        briefly "Occupancy"
        described as {
          |Occupancy percentage.
        }
      }
      monthlyRevenue: Money with {
        briefly "Revenue"
        described as {
          |Monthly revenue.
        }
      }
      openMaintenanceCount: Natural with {
        briefly "Maintenance"
        described as {
          |Open requests.
        }
      }
      delinquentCount: Natural with {
        briefly "Delinquent"
        described as {
          |Delinquent accounts.
        }
      }
    } with {
      briefly "Property summary"
      described as {
        |Property metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on event Property.LeaseApproved is {
        tell event Property.LeaseApproved to repository PropertyContext.PropertyRepository
        do "Update occupancy rate"
      }
      on event Property.LeaseTerminated is {
        tell event Property.LeaseTerminated to repository PropertyContext.PropertyRepository
        do "Update occupancy rate"
      }
      on event Property.PaymentRecorded is {
        tell event Property.PaymentRecorded to repository PropertyContext.PropertyRepository
        do "Update revenue metrics"
      }
      on event Property.MaintenanceRequestSubmitted is {
        tell event Property.MaintenanceRequestSubmitted to repository PropertyContext.PropertyRepository
        do "Increment open request count"
      }
    } with {
      briefly "Maintains property analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Property analytics projections"
    described as {
      |Maintains property analytics data.
    }
  }
  // ---- Event publication for Property ----
  type PropertyEvent is one of {
    PropertyContext.Property.PropertyAdded or PropertyContext.Property.UnitAdded or PropertyContext.Property.UnitUpdated or PropertyContext.Property.LeaseApproved or PropertyContext.Property.LeaseRenewed or PropertyContext.Property.LeaseTerminated or PropertyContext.Property.PaymentRecorded or PropertyContext.Property.MaintenanceRequestSubmitted or PropertyContext.Property.MaintenanceRequestCompleted
  } with {
    briefly "Property event alternation"
    described as {
      |Union of all Property events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PropertyEventSource as source is {
    outlet PropertyEvents is type PropertyEvent
    handler PropertySourceHandler is {
      on event Property.PropertyAdded is {
        send event Property.PropertyAdded to outlet PropertyEvents
      }
      on event Property.UnitAdded is {
        send event Property.UnitAdded to outlet PropertyEvents
      }
      on event Property.UnitUpdated is {
        send event Property.UnitUpdated to outlet PropertyEvents
      }
      on event Property.LeaseApproved is {
        send event Property.LeaseApproved to outlet PropertyEvents
      }
      on event Property.LeaseRenewed is {
        send event Property.LeaseRenewed to outlet PropertyEvents
      }
      on event Property.LeaseTerminated is {
        send event Property.LeaseTerminated to outlet PropertyEvents
      }
      on event Property.PaymentRecorded is {
        send event Property.PaymentRecorded to outlet PropertyEvents
      }
      on event Property.MaintenanceRequestSubmitted is {
        send event Property.MaintenanceRequestSubmitted to outlet PropertyEvents
      }
      on event Property.MaintenanceRequestCompleted is {
        send event Property.MaintenanceRequestCompleted to outlet PropertyEvents
      }
      on other is {
        error "Unexpected message for source PropertyEventSource"
      }
    } with {
      briefly "Property source handler"
      described as {
        |Publishes Property events onto the outlet.
      }
    }
  } with {
    briefly "Property event source"
    described as {
      |Publishes Property entity events into the streaming topology.
    }
  }
  processor PropertyEventSink as sink is {
    inlet PropertyInlet is type PropertyEvent    handler PropertySinkHandler is {
      on event Property.PropertyAdded is {
        tell event Property.PropertyAdded to repository PropertyContext.PropertyRepository
      }
      on event Property.UnitAdded is {
        tell event Property.UnitAdded to repository PropertyContext.PropertyRepository
      }
      on event Property.UnitUpdated is {
        tell event Property.UnitUpdated to repository PropertyContext.PropertyRepository
      }
      on event Property.LeaseApproved is {
        tell event Property.LeaseApproved to repository PropertyContext.PropertyRepository
      }
      on event Property.LeaseRenewed is {
        tell event Property.LeaseRenewed to repository PropertyContext.PropertyRepository
      }
      on event Property.LeaseTerminated is {
        tell event Property.LeaseTerminated to repository PropertyContext.PropertyRepository
      }
      on event Property.PaymentRecorded is {
        tell event Property.PaymentRecorded to repository PropertyContext.PropertyRepository
      }
      on event Property.MaintenanceRequestSubmitted is {
        tell event Property.MaintenanceRequestSubmitted to repository PropertyContext.PropertyRepository
      }
      on event Property.MaintenanceRequestCompleted is {
        tell event Property.MaintenanceRequestCompleted to repository PropertyContext.PropertyRepository
      }
      on other is {
        error "Unexpected message for sink PropertyEventSink"
      }
    } with {
      briefly "Property sink handler"
      described as {
        |Persists Property events via the repository.
      }
    }
  } with {
    briefly "Property event sink"
    described as {
      |Receives Property events for persistence.
    }
  }
  connector PropertyEventFlow is from outlet PropertyContext.PropertyEventSource.PropertyEvents to inlet PropertyContext.PropertyEventSink.PropertyInlet with {
    briefly "Property event flow"
    described as {
      |Connects the Property source to its sink.
    }
  }
  processor PropertyEventSplit as split is {
    inlet PropertyEventSplitIn is type PropertyEvent    outlet PropertyEventSplitToPropertyRepository is type PropertyEvent
    outlet PropertyEventSplitToPropertyAnalytics is type PropertyEvent
    handler PropertyEventSplitHandler is {
      on event Property.PropertyAdded is {
        send event Property.PropertyAdded to outlet PropertyEventSplitToPropertyRepository
        send event Property.PropertyAdded to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.PropertyAdded to entity PropertyContext.Property
      }
      on event Property.UnitAdded is {
        send event Property.UnitAdded to outlet PropertyEventSplitToPropertyRepository
        send event Property.UnitAdded to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.UnitAdded to entity PropertyContext.Property
      }
      on event Property.UnitUpdated is {
        send event Property.UnitUpdated to outlet PropertyEventSplitToPropertyRepository
        send event Property.UnitUpdated to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.UnitUpdated to entity PropertyContext.Property
      }
      on event Property.LeaseApproved is {
        send event Property.LeaseApproved to outlet PropertyEventSplitToPropertyRepository
        send event Property.LeaseApproved to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.LeaseApproved to entity PropertyContext.Property
      }
      on event Property.LeaseRenewed is {
        send event Property.LeaseRenewed to outlet PropertyEventSplitToPropertyRepository
        send event Property.LeaseRenewed to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.LeaseRenewed to entity PropertyContext.Property
      }
      on event Property.LeaseTerminated is {
        send event Property.LeaseTerminated to outlet PropertyEventSplitToPropertyRepository
        send event Property.LeaseTerminated to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.LeaseTerminated to entity PropertyContext.Property
      }
      on event Property.PaymentRecorded is {
        send event Property.PaymentRecorded to outlet PropertyEventSplitToPropertyRepository
        send event Property.PaymentRecorded to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.PaymentRecorded to entity PropertyContext.Property
      }
      on event Property.MaintenanceRequestSubmitted is {
        send event Property.MaintenanceRequestSubmitted to outlet PropertyEventSplitToPropertyRepository
        send event Property.MaintenanceRequestSubmitted to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.MaintenanceRequestSubmitted to entity PropertyContext.Property
      }
      on event Property.MaintenanceRequestCompleted is {
        send event Property.MaintenanceRequestCompleted to outlet PropertyEventSplitToPropertyRepository
        send event Property.MaintenanceRequestCompleted to outlet PropertyEventSplitToPropertyAnalytics
        tell event Property.MaintenanceRequestCompleted to entity PropertyContext.Property
      }
      on other is {
        error "Unexpected message for processor PropertyEventSplit"
      }
    } with {
      briefly "Property event fan-out handler"
      described as {
        |Delivers each Property event to all of its consumers.
      }
    }
  } with {
    briefly "Property event fan-out"
    described as {
      |Fans Property events out to the repository and projectors.
    }
  }
  connector 'PropertyEvent Stream' is from outlet PropertyContext.Property.PropertyEvents2 to inlet PropertyContext.PropertyEventSplit.PropertyEventSplitIn with {
    briefly "Property events, fanned out to storage and read models"
  }
  connector 'PropertyEvent Storage' is from outlet PropertyContext.PropertyEventSplit.PropertyEventSplitToPropertyRepository to inlet PropertyContext.PropertyRepository.PropertyRepositoryFromProperty with {
    briefly "Property events on their way to storage"
  }
  connector 'PropertyAnalytics Feed' is from outlet PropertyContext.PropertyEventSplit.PropertyEventSplitToPropertyAnalytics to inlet PropertyContext.PropertyAnalytics.PropertyAnalyticsFromProperty with {
    briefly "Property events feeding the PropertyAnalytics projection"
  }
  connector 'PropertyAnalytics Storage' is from outlet PropertyContext.PropertyAnalytics.PropertyAnalyticsOut to inlet PropertyContext.PropertyRepository.PropertyRepositoryFromPropertyAnalytics with {
    briefly "The PropertyAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for property management"
  described as {
    | The PropertyContext is the bounded context for property
    | management including leasing and maintenance.
  }
}
