// Property Management - Property Context
context PropertyContext as router is {
  inlet PropertyCommandStreamIn is type PropertyCommand  outlet PropertyCommandStreamOut is type PropertyCommand
  inlet PropertyResultStreamIn is result Property.PropertyResult  outlet PropertyResultStreamOut is result Property.PropertyResult
  handler PropertyContextBoundary is {
    on addProperty: command Property.AddProperty is {
      send addProperty to outlet PropertyContext.PropertyCommandStreamOut
    }
    on addUnit: command Property.AddUnit is {
      send addUnit to outlet PropertyContext.PropertyCommandStreamOut
    }
    on updateUnit: command Property.UpdateUnit is {
      send updateUnit to outlet PropertyContext.PropertyCommandStreamOut
    }
    on approveLease: command Property.ApproveLease is {
      send approveLease to outlet PropertyContext.PropertyCommandStreamOut
    }
    on renewLease: command Property.RenewLease is {
      send renewLease to outlet PropertyContext.PropertyCommandStreamOut
    }
    on terminateLease: command Property.TerminateLease is {
      send terminateLease to outlet PropertyContext.PropertyCommandStreamOut
    }
    on recordPayment: command Property.RecordPayment is {
      send recordPayment to outlet PropertyContext.PropertyCommandStreamOut
    }
    on submitMaintenanceRequest: command Property.SubmitMaintenanceRequest is {
      send submitMaintenanceRequest to outlet PropertyContext.PropertyCommandStreamOut
    }
    on completeMaintenanceRequest: command Property.CompleteMaintenanceRequest is {
      send completeMaintenanceRequest to outlet PropertyContext.PropertyCommandStreamOut
    }
    on propertyResult: result Property.PropertyResult is {
      send propertyResult to outlet PropertyContext.PropertyResultStreamOut
    }
    on other is {
      error "Unexpected message at the PropertyContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PropertyCommand Stream Intake' is from outlet PropertyContext.PropertyCommandStreamOut to inlet PropertyContext.Property.PropertyCommands  connector 'PropertyResult Stream Egress' is from outlet PropertyContext.PropertyRepository.PropertyRepositoryResponses to inlet PropertyContext.PropertyResultStreamIn  adaptor FromMaintenanceDispatchService from context MaintenanceDispatchService is { 
    handler FromMaintenanceDispatchServiceHandler is {
      on event MaintenanceDispatchService.TechnicianDispatched is {
        do "the model receives technician dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceDispatchService"
      }
    } with {
      briefly "from maintenance dispatch service"
      described as {
        |Carries messages from the external MaintenanceDispatchService.
      }
    }
  } with {
    briefly "MaintenanceDispatchService integration"
    described as {
      |The model's side of the MaintenanceDispatchService conversation.
    }
  }
  adaptor ToMaintenanceDispatchService to context MaintenanceDispatchService is { 
    handler ToMaintenanceDispatchServiceHandler is {
      on command MaintenanceDispatchService.DispatchTechnician is {
        do "the model sends dispatch technician"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceDispatchService"
      }
    } with {
      briefly "to maintenance dispatch service"
      described as {
        |Carries messages to the external MaintenanceDispatchService.
      }
    }
  } with {
    briefly "MaintenanceDispatchService integration"
    described as {
      |The model's side of the MaintenanceDispatchService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendTenantNotification is {
        do "the model sends send tenant notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.RentPaymentProcessed is {
        do "the model receives rent payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessRentPayment is {
        do "the model sends process rent payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromTenantScreeningService from context TenantScreeningService is { 
    handler FromTenantScreeningServiceHandler is {
      on event TenantScreeningService.ScreeningCompleted is {
        do "the model receives screening completed"
      }
      on other is {
        error "Unexpected message for adaptor FromTenantScreeningService"
      }
    } with {
      briefly "from tenant screening service"
      described as {
        |Carries messages from the external TenantScreeningService.
      }
    }
  } with {
    briefly "TenantScreeningService integration"
    described as {
      |The model's side of the TenantScreeningService conversation.
    }
  }
  adaptor ToTenantScreeningService to context TenantScreeningService is { 
    handler ToTenantScreeningServiceHandler is {
      on command TenantScreeningService.ScreenTenant is {
        do "the model sends screen tenant"
      }
      on other is {
        error "Unexpected message for adaptor ToTenantScreeningService"
      }
    } with {
      briefly "to tenant screening service"
      described as {
        |Carries messages to the external TenantScreeningService.
      }
    }
  } with {
    briefly "TenantScreeningService integration"
    described as {
      |The model's side of the TenantScreeningService conversation.
    }
  }
  include "types.riddl"
  include "Property.riddl"
  // Repository for property persistence
  type PropertyRepositoryCommand is one of {
    PropertyContext.PropertyRepository.PersistLeaseApproved or PropertyContext.PropertyRepository.PersistLeaseRenewed or PropertyContext.PropertyRepository.PersistLeaseTerminated or PropertyContext.PropertyRepository.PersistMaintenanceRequestCompleted or PropertyContext.PropertyRepository.PersistMaintenanceRequestSubmitted or PropertyContext.PropertyRepository.PersistPaymentRecorded or PropertyContext.PropertyRepository.PersistPropertyAdded or PropertyContext.PropertyRepository.PersistUnitAdded or PropertyContext.PropertyRepository.PersistUnitUpdated
  } with {
    briefly "Anything that writes PropertyRepository"
    described as {
      |The persistence commands PropertyRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PropertyRepository as flow is {
    inlet PropertyRepositoryFromPropertyAnalytics is type PropertyRepositoryCommand
    command PersistLeaseRenewed is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeaseRenewed applies to.
        }
      }
    } with {
      briefly "Persist LeaseRenewed"
      described as {
        |Instructs this repository to apply LeaseRenewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceRequestCompleted is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceRequestCompleted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceRequestCompleted"
      described as {
        |Instructs this repository to apply MaintenanceRequestCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPropertyAdded is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PropertyAdded applies to.
        }
      }
    } with {
      briefly "Persist PropertyAdded"
      described as {
        |Instructs this repository to apply PropertyAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitAdded is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitAdded applies to.
        }
      }
    } with {
      briefly "Persist UnitAdded"
      described as {
        |Instructs this repository to apply UnitAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistUnitUpdated is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row UnitUpdated applies to.
        }
      }
    } with {
      briefly "Persist UnitUpdated"
      described as {
        |Instructs this repository to apply UnitUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeaseApproved is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeaseApproved applies to.
        }
      }
    } with {
      briefly "Persist LeaseApproved"
      described as {
        |Instructs this repository to apply LeaseApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeaseTerminated is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeaseTerminated applies to.
        }
      }
    } with {
      briefly "Persist LeaseTerminated"
      described as {
        |Instructs this repository to apply LeaseTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceRequestSubmitted is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceRequestSubmitted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceRequestSubmitted"
      described as {
        |Instructs this repository to apply MaintenanceRequestSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentRecorded is  {
      propertyId: PropertyId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentRecorded applies to.
        }
      }
    } with {
      briefly "Persist PaymentRecorded"
      described as {
        |Instructs this repository to apply PaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PropertyRepositoryResponses is result Property.PropertyResult
    record StoredProperty is  {
      propertyId: PropertyId with {
        briefly "propertyId"
        described as {
          |The propertyId column of the stored property row.
        }
      }
    } with {
      briefly "Stored property row"
      described as {
        |The persistence shape of property data as this repository stores it.
      }
    }
    schema PropertyData is relational
      of properties as record StoredProperty
        index on field StoredProperty.propertyId
 with {
      briefly "Property data schema"
      described as {
        |The relational schema holding property data for the PropertyRepository.
      }
    }
    handler PropertyPersistence is {
      on persistLeaseRenewed: command PersistLeaseRenewed is {
        do "apply LeaseRenewed to the stored row"
      }
      on persistMaintenanceRequestCompleted: command PersistMaintenanceRequestCompleted is {
        do "apply MaintenanceRequestCompleted to the stored row"
      }
      on persistPropertyAdded: command PersistPropertyAdded is {
        do "apply PropertyAdded to the stored row"
      }
      on persistUnitAdded: command PersistUnitAdded is {
        do "apply UnitAdded to the stored row"
      }
      on persistUnitUpdated: command PersistUnitUpdated is {
        do "apply UnitUpdated to the stored row"
      }
      on persistLeaseApproved: command PersistLeaseApproved is {
        do "apply LeaseApproved to the stored row"
      }
      on persistLeaseTerminated: command PersistLeaseTerminated is {
        do "apply LeaseTerminated to the stored row"
      }
      on persistMaintenanceRequestSubmitted: command PersistMaintenanceRequestSubmitted is {
        do "apply MaintenanceRequestSubmitted to the stored row"
      }
      on persistPaymentRecorded: command PersistPaymentRecorded is {
        do "apply PaymentRecorded to the stored row"
      }
      on query GetPropertySummary is {
        let propertySummaryView: type PropertySummaryView = prompt("read the property summary projection")
        reply propertySummaryView
      }
    } with {
      briefly "Persists property commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Property data persistence"
    described as {
      | The PropertyRepository provides persistent storage for
      | properties, leases, and maintenance records.
    }
  }
  // Projector for property analytics
  query GetPropertySummary replies result PropertySummaryView is  {
    propertySummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which property summary to retrieve.
      }
    }
  } with {
    briefly "Get property summary"
    described as {
      |Retrieves the property summary projection.
    }
  }
  result PropertySummaryView is  {
    propertySummary: PropertyAnalytics.PropertySummary with {
      briefly "Property summary"
      described as {
        |The property summary being returned.
      }
    }
  } with {
    briefly "Property summary view"
    described as {
      |Read model view carrying the property summary projection.
    }
  }
  projector PropertyAnalytics as flow is {
    outlet PropertyAnalyticsToRepository is type PropertyRepositoryCommand
    updates repository PropertyContext.PropertyRepository
    inlet PropertyAnalyticsFromProperty is type PropertyEvent
    record PropertySummary is  {
      propertyId: PropertyId with {
        briefly "Property"
        described as {
          |Property ID.
        }
      }
      occupancyRate: Decimal(5,2) with {
        briefly "Occupancy"
        described as {
          |Occupancy percentage.
        }
      }
      monthlyRevenue: Money with {
        briefly "Revenue"
        described as {
          |Monthly revenue.
        }
      }
      openMaintenanceCount: Natural with {
        briefly "Maintenance"
        described as {
          |Open requests.
        }
      }
      delinquentCount: Natural with {
        briefly "Delinquent"
        described as {
          |Delinquent accounts.
        }
      }
    } with {
      briefly "Property summary"
      described as {
        |Property metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on leaseRenewed: event Property.LeaseRenewed is {
        tell command PropertyContext.PropertyRepository.PersistLeaseRenewed(propertyId = leaseRenewed.propertyId) to repository PropertyContext.PropertyRepository
        do "apply LeaseRenewed to the PropertyAnalytics projection"
      }
      on maintenanceRequestCompleted: event Property.MaintenanceRequestCompleted is {
        tell command PropertyContext.PropertyRepository.PersistMaintenanceRequestCompleted(propertyId = maintenanceRequestCompleted.propertyId) to repository PropertyContext.PropertyRepository
        do "apply MaintenanceRequestCompleted to the PropertyAnalytics projection"
      }
      on propertyAdded: event Property.PropertyAdded is {
        tell command PropertyContext.PropertyRepository.PersistPropertyAdded(propertyId = propertyAdded.propertyId) to repository PropertyContext.PropertyRepository
        do "apply PropertyAdded to the PropertyAnalytics projection"
      }
      on unitAdded: event Property.UnitAdded is {
        tell command PropertyContext.PropertyRepository.PersistUnitAdded(propertyId = unitAdded.propertyId) to repository PropertyContext.PropertyRepository
        do "apply UnitAdded to the PropertyAnalytics projection"
      }
      on unitUpdated: event Property.UnitUpdated is {
        tell command PropertyContext.PropertyRepository.PersistUnitUpdated(propertyId = unitUpdated.propertyId) to repository PropertyContext.PropertyRepository
        do "apply UnitUpdated to the PropertyAnalytics projection"
      }
      on leaseApproved: event Property.LeaseApproved is {
        tell command PropertyContext.PropertyRepository.PersistLeaseApproved(propertyId = leaseApproved.propertyId) to repository PropertyContext.PropertyRepository
        do "Update occupancy rate"
      }
      on leaseTerminated: event Property.LeaseTerminated is {
        tell command PropertyContext.PropertyRepository.PersistLeaseTerminated(propertyId = leaseTerminated.propertyId) to repository PropertyContext.PropertyRepository
        do "Update occupancy rate"
      }
      on paymentRecorded: event Property.PaymentRecorded is {
        tell command PropertyContext.PropertyRepository.PersistPaymentRecorded(propertyId = paymentRecorded.propertyId) to repository PropertyContext.PropertyRepository
        do "Update revenue metrics"
      }
      on maintenanceRequestSubmitted: event Property.MaintenanceRequestSubmitted is {
        tell command PropertyContext.PropertyRepository.PersistMaintenanceRequestSubmitted(propertyId = maintenanceRequestSubmitted.propertyId) to repository PropertyContext.PropertyRepository
        do "Increment open request count"
      }
    } with {
      briefly "Maintains property analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Property analytics projections"
    described as {
      |Maintains property analytics data.
    }
  }
  // ---- Event publication for Property ----
  type PropertyEvent is one of {
    PropertyContext.Property.PropertyAdded or PropertyContext.Property.UnitAdded or PropertyContext.Property.UnitUpdated or PropertyContext.Property.LeaseApproved or PropertyContext.Property.LeaseRenewed or PropertyContext.Property.LeaseTerminated or PropertyContext.Property.PaymentRecorded or PropertyContext.Property.MaintenanceRequestSubmitted or PropertyContext.Property.MaintenanceRequestCompleted
  } with {
    briefly "Property event alternation"
    described as {
      |Union of all Property events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PropertyEventSplit as flow is {
    inlet PropertyEventSplitIn is type PropertyEvent
    outlet PropertyEventSplitToPropertyAnalytics is type PropertyEvent
    handler PropertyEventSplitHandler is {
      on propertyAdded: event Property.PropertyAdded is {
        send propertyAdded to outlet PropertyEventSplitToPropertyAnalytics
        tell propertyAdded to entity PropertyContext.Property
      }
      on unitAdded: event Property.UnitAdded is {
        send unitAdded to outlet PropertyEventSplitToPropertyAnalytics
        tell unitAdded to entity PropertyContext.Property
      }
      on unitUpdated: event Property.UnitUpdated is {
        send unitUpdated to outlet PropertyEventSplitToPropertyAnalytics
        tell unitUpdated to entity PropertyContext.Property
      }
      on leaseApproved: event Property.LeaseApproved is {
        send leaseApproved to outlet PropertyEventSplitToPropertyAnalytics
        tell leaseApproved to entity PropertyContext.Property
      }
      on leaseRenewed: event Property.LeaseRenewed is {
        send leaseRenewed to outlet PropertyEventSplitToPropertyAnalytics
        tell leaseRenewed to entity PropertyContext.Property
      }
      on leaseTerminated: event Property.LeaseTerminated is {
        send leaseTerminated to outlet PropertyEventSplitToPropertyAnalytics
        tell leaseTerminated to entity PropertyContext.Property
      }
      on paymentRecorded: event Property.PaymentRecorded is {
        send paymentRecorded to outlet PropertyEventSplitToPropertyAnalytics
        tell paymentRecorded to entity PropertyContext.Property
      }
      on maintenanceRequestSubmitted: event Property.MaintenanceRequestSubmitted is {
        send maintenanceRequestSubmitted to outlet PropertyEventSplitToPropertyAnalytics
        tell maintenanceRequestSubmitted to entity PropertyContext.Property
      }
      on maintenanceRequestCompleted: event Property.MaintenanceRequestCompleted is {
        send maintenanceRequestCompleted to outlet PropertyEventSplitToPropertyAnalytics
        tell maintenanceRequestCompleted to entity PropertyContext.Property
      }
      on other is {
        error "Unexpected message for processor PropertyEventSplit"
      }
    } with {
      briefly "Property event fan-out handler"
      described as {
        |Delivers each Property event to all of its consumers.
      }
    }
  } with {
    briefly "Property event fan-out"
    described as {
      |Fans Property events out to the repository and projectors.
    }
  }
  connector 'PropertyEvent Stream' is from outlet PropertyContext.Property.PropertyEvents2 to inlet PropertyContext.PropertyEventSplit.PropertyEventSplitIn with {
    briefly "Property events, fanned out to storage and read models"
  }
  connector 'PropertyAnalytics Feed' is from outlet PropertyContext.PropertyEventSplit.PropertyEventSplitToPropertyAnalytics to inlet PropertyContext.PropertyAnalytics.PropertyAnalyticsFromProperty with {
    briefly "Property events feeding the PropertyAnalytics projection"
  }
  connector 'PropertyAnalytics Storage' is from outlet PropertyContext.PropertyAnalytics.PropertyAnalyticsToRepository to inlet PropertyContext.PropertyRepository.PropertyRepositoryFromPropertyAnalytics with {
    briefly "PropertyAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for property management"
  described as {
    | The PropertyContext is the bounded context for property
    | management including leasing and maintenance.
  }
}
