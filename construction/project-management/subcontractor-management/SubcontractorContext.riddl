// Subcontractor Management - Subcontractor Context
context SubcontractorContext as router is {
  inlet SubcontractorCommandStreamIn is type SubcontractorCommand  outlet SubcontractorCommandStreamOut is type SubcontractorCommand
  inlet SubcontractorResultStreamIn is result Subcontractor.SubcontractorResult  outlet SubcontractorResultStreamOut is result Subcontractor.SubcontractorResult
  handler SubcontractorContextBoundary is {
    on registerSubcontractor: command Subcontractor.RegisterSubcontractor is {
      send registerSubcontractor to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on approveSubcontractor: command Subcontractor.ApproveSubcontractor is {
      send approveSubcontractor to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on updateInfo: command Subcontractor.UpdateInfo is {
      send updateInfo to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on updateInsurance: command Subcontractor.UpdateInsurance is {
      send updateInsurance to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on awardSubcontract: command Subcontractor.AwardSubcontract is {
      send awardSubcontract to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on submitPayApplication: command Subcontractor.SubmitPayApplication is {
      send submitPayApplication to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on approvePayApplication: command Subcontractor.ApprovePayApplication is {
      send approvePayApplication to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on ratePerformance: command Subcontractor.RatePerformance is {
      send ratePerformance to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on putOnHold: command Subcontractor.PutOnHold is {
      send putOnHold to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on reactivateSubcontractor: command Subcontractor.ReactivateSubcontractor is {
      send reactivateSubcontractor to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on terminateSubcontractor: command Subcontractor.TerminateSubcontractor is {
      send terminateSubcontractor to outlet SubcontractorContext.SubcontractorCommandStreamOut
    }
    on subcontractorResult: result Subcontractor.SubcontractorResult is {
      send subcontractorResult to outlet SubcontractorContext.SubcontractorResultStreamOut
    }
    on other is {
      error "Unexpected message at the SubcontractorContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SubcontractorCommand Stream Intake' is from outlet SubcontractorContext.SubcontractorCommandStreamOut to inlet SubcontractorContext.Subcontractor.SubcontractorCommands  connector 'SubcontractorResult Stream Egress' is from outlet SubcontractorContext.SubcontractorRepository.SubcontractorRepositoryResponses to inlet SubcontractorContext.SubcontractorResultStreamIn  adaptor FromInsuranceVerificationService from context InsuranceVerificationService is { 
    handler FromInsuranceVerificationServiceHandler is {
      on event InsuranceVerificationService.InsuranceVerified is {
        do "the model receives insurance verified"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceVerificationService"
      }
    } with {
      briefly "from insurance verification service"
      described as {
        |Carries messages from the external InsuranceVerificationService.
      }
    }
  } with {
    briefly "InsuranceVerificationService integration"
    described as {
      |The model's side of the InsuranceVerificationService conversation.
    }
  }
  adaptor ToInsuranceVerificationService to context InsuranceVerificationService is { 
    handler ToInsuranceVerificationServiceHandler is {
      on command InsuranceVerificationService.VerifyInsurance is {
        do "the model sends verify insurance"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceVerificationService"
      }
    } with {
      briefly "to insurance verification service"
      described as {
        |Carries messages to the external InsuranceVerificationService.
      }
    }
  } with {
    briefly "InsuranceVerificationService integration"
    described as {
      |The model's side of the InsuranceVerificationService conversation.
    }
  }
  adaptor FromLicenseVerificationService from context LicenseVerificationService is { 
    handler FromLicenseVerificationServiceHandler is {
      on event LicenseVerificationService.LicenseVerified is {
        do "the model receives license verified"
      }
      on other is {
        error "Unexpected message for adaptor FromLicenseVerificationService"
      }
    } with {
      briefly "from license verification service"
      described as {
        |Carries messages from the external LicenseVerificationService.
      }
    }
  } with {
    briefly "LicenseVerificationService integration"
    described as {
      |The model's side of the LicenseVerificationService conversation.
    }
  }
  adaptor ToLicenseVerificationService to context LicenseVerificationService is { 
    handler ToLicenseVerificationServiceHandler is {
      on command LicenseVerificationService.VerifyLicense is {
        do "the model sends verify license"
      }
      on other is {
        error "Unexpected message for adaptor ToLicenseVerificationService"
      }
    } with {
      briefly "to license verification service"
      described as {
        |Carries messages to the external LicenseVerificationService.
      }
    }
  } with {
    briefly "LicenseVerificationService integration"
    described as {
      |The model's side of the LicenseVerificationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendSubcontractorNotification is {
        do "the model sends send subcontractor notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  include "types.riddl"
  include "Subcontractor.riddl"
  // Repository for subcontractor persistence
  type SubcontractorRepositoryCommand is one of {
    SubcontractorContext.SubcontractorRepository.PersistInfoUpdated or SubcontractorContext.SubcontractorRepository.PersistInsuranceUpdated or SubcontractorContext.SubcontractorRepository.PersistPayApplicationApproved or SubcontractorContext.SubcontractorRepository.PersistPayApplicationSubmitted or SubcontractorContext.SubcontractorRepository.PersistPerformanceRated or SubcontractorContext.SubcontractorRepository.PersistSubcontractAwarded or SubcontractorContext.SubcontractorRepository.PersistSubcontractorApproved or SubcontractorContext.SubcontractorRepository.PersistSubcontractorPutOnHold or SubcontractorContext.SubcontractorRepository.PersistSubcontractorReactivated or SubcontractorContext.SubcontractorRepository.PersistSubcontractorRegistered or SubcontractorContext.SubcontractorRepository.PersistSubcontractorTerminated
  } with {
    briefly "Anything that writes SubcontractorRepository"
    described as {
      |The persistence commands SubcontractorRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SubcontractorRepository as flow is {
    inlet SubcontractorRepositoryFromSubcontractorAnalytics is type SubcontractorRepositoryCommand    command PersistInfoUpdated is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row InfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist InfoUpdated"
      described as {
        |Instructs this repository to apply InfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInsuranceUpdated is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row InsuranceUpdated applies to.
        }
      }
    } with {
      briefly "Persist InsuranceUpdated"
      described as {
        |Instructs this repository to apply InsuranceUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayApplicationSubmitted is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayApplicationSubmitted applies to.
        }
      }
    } with {
      briefly "Persist PayApplicationSubmitted"
      described as {
        |Instructs this repository to apply PayApplicationSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubcontractorApproved is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubcontractorApproved applies to.
        }
      }
    } with {
      briefly "Persist SubcontractorApproved"
      described as {
        |Instructs this repository to apply SubcontractorApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubcontractorPutOnHold is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubcontractorPutOnHold applies to.
        }
      }
    } with {
      briefly "Persist SubcontractorPutOnHold"
      described as {
        |Instructs this repository to apply SubcontractorPutOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubcontractorReactivated is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubcontractorReactivated applies to.
        }
      }
    } with {
      briefly "Persist SubcontractorReactivated"
      described as {
        |Instructs this repository to apply SubcontractorReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubcontractorRegistered is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubcontractorRegistered applies to.
        }
      }
    } with {
      briefly "Persist SubcontractorRegistered"
      described as {
        |Instructs this repository to apply SubcontractorRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubcontractorTerminated is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubcontractorTerminated applies to.
        }
      }
    } with {
      briefly "Persist SubcontractorTerminated"
      described as {
        |Instructs this repository to apply SubcontractorTerminated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPayApplicationApproved is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row PayApplicationApproved applies to.
        }
      }
    } with {
      briefly "Persist PayApplicationApproved"
      described as {
        |Instructs this repository to apply PayApplicationApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPerformanceRated is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceRated applies to.
        }
      }
    } with {
      briefly "Persist PerformanceRated"
      described as {
        |Instructs this repository to apply PerformanceRated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubcontractAwarded is {
      subcontractorId: SubcontractorId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubcontractAwarded applies to.
        }
      }
    } with {
      briefly "Persist SubcontractAwarded"
      described as {
        |Instructs this repository to apply SubcontractAwarded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SubcontractorRepositoryResponses is result Subcontractor.SubcontractorResult
    record StoredSubcontractor is {
      subcontractorId: SubcontractorId with {
        briefly "subcontractorId"
        described as {
          |The subcontractorId column of the stored subcontractor row.
        }
      }
    } with {
      briefly "Stored subcontractor row"
      described as {
        |The persistence shape of subcontractor data as this repository stores it.
      }
    }
    schema SubcontractorData is relational
      of subcontractors as record StoredSubcontractor
        index on field StoredSubcontractor.subcontractorId
 with {
      briefly "Subcontractor data schema"
      described as {
        |The relational schema holding subcontractor data for the SubcontractorRepository.
      }
    }
    handler SubcontractorPersistence is {
      on persistInfoUpdated: command PersistInfoUpdated is {
        do "apply InfoUpdated to the stored row"
      }
      on persistInsuranceUpdated: command PersistInsuranceUpdated is {
        do "apply InsuranceUpdated to the stored row"
      }
      on persistPayApplicationSubmitted: command PersistPayApplicationSubmitted is {
        do "apply PayApplicationSubmitted to the stored row"
      }
      on persistSubcontractorApproved: command PersistSubcontractorApproved is {
        do "apply SubcontractorApproved to the stored row"
      }
      on persistSubcontractorPutOnHold: command PersistSubcontractorPutOnHold is {
        do "apply SubcontractorPutOnHold to the stored row"
      }
      on persistSubcontractorReactivated: command PersistSubcontractorReactivated is {
        do "apply SubcontractorReactivated to the stored row"
      }
      on persistSubcontractorRegistered: command PersistSubcontractorRegistered is {
        do "apply SubcontractorRegistered to the stored row"
      }
      on persistSubcontractorTerminated: command PersistSubcontractorTerminated is {
        do "apply SubcontractorTerminated to the stored row"
      }
      on persistPayApplicationApproved: command PersistPayApplicationApproved is {
        do "apply PayApplicationApproved to the stored row"
      }
      on persistPerformanceRated: command PersistPerformanceRated is {
        do "apply PerformanceRated to the stored row"
      }
      on persistSubcontractAwarded: command PersistSubcontractAwarded is {
        do "apply SubcontractAwarded to the stored row"
      }
      on query GetSubcontractorSummary is {
        let subcontractorSummaryView: type SubcontractorSummaryView = prompt("read the subcontractor summary projection")
        reply subcontractorSummaryView
      }
    } with {
      briefly "Persists subcontractor commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subcontractor data persistence"
    described as {
      | The SubcontractorRepository provides persistent storage for
      | subcontractors, contracts, and performance history.
    }
  }
  // Projector for subcontractor analytics
  query GetSubcontractorSummary replies result SubcontractorSummaryView is {
    subcontractorSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which subcontractor summary to retrieve.
      }
    }
  } with {
    briefly "Get subcontractor summary"
    described as {
      |Retrieves the subcontractor summary projection.
    }
  }
  result SubcontractorSummaryView is {
    subcontractorSummary: SubcontractorAnalytics.SubcontractorSummary with {
      briefly "Subcontractor summary"
      described as {
        |The subcontractor summary being returned.
      }
    }
  } with {
    briefly "Subcontractor summary view"
    described as {
      |Read model view carrying the subcontractor summary projection.
    }
  }
  projector SubcontractorAnalytics as flow is {
    updates repository SubcontractorContext.SubcontractorRepository
    outlet SubcontractorAnalyticsToRepository is type SubcontractorRepositoryCommand
    inlet SubcontractorAnalyticsFromSubcontractor is type SubcontractorEvent    record SubcontractorSummary is {
      subcontractorId: SubcontractorId with {
        briefly "Subcontractor"
        described as {
          |Subcontractor ID.
        }
      }
      activeContracts: Natural with {
        briefly "Contracts"
        described as {
          |Active contract count.
        }
      }
      totalContractValue: Money with {
        briefly "Value"
        described as {
          |Total contract value.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      pendingPayments: Money with {
        briefly "Pending"
        described as {
          |Pending payment amount.
        }
      }
    } with {
      briefly "Subcontractor summary"
      described as {
        |Subcontractor metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on infoUpdated: event Subcontractor.InfoUpdated is {
        tell command SubcontractorContext.SubcontractorRepository.PersistInfoUpdated(subcontractorId = infoUpdated.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply InfoUpdated to the SubcontractorAnalytics projection"
      }
      on insuranceUpdated: event Subcontractor.InsuranceUpdated is {
        tell command SubcontractorContext.SubcontractorRepository.PersistInsuranceUpdated(subcontractorId = insuranceUpdated.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply InsuranceUpdated to the SubcontractorAnalytics projection"
      }
      on payApplicationSubmitted: event Subcontractor.PayApplicationSubmitted is {
        tell command SubcontractorContext.SubcontractorRepository.PersistPayApplicationSubmitted(subcontractorId = payApplicationSubmitted.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply PayApplicationSubmitted to the SubcontractorAnalytics projection"
      }
      on subcontractorApproved: event Subcontractor.SubcontractorApproved is {
        tell command SubcontractorContext.SubcontractorRepository.PersistSubcontractorApproved(subcontractorId = subcontractorApproved.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply SubcontractorApproved to the SubcontractorAnalytics projection"
      }
      on subcontractorPutOnHold: event Subcontractor.SubcontractorPutOnHold is {
        tell command SubcontractorContext.SubcontractorRepository.PersistSubcontractorPutOnHold(subcontractorId = subcontractorPutOnHold.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply SubcontractorPutOnHold to the SubcontractorAnalytics projection"
      }
      on subcontractorReactivated: event Subcontractor.SubcontractorReactivated is {
        tell command SubcontractorContext.SubcontractorRepository.PersistSubcontractorReactivated(subcontractorId = subcontractorReactivated.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply SubcontractorReactivated to the SubcontractorAnalytics projection"
      }
      on subcontractorRegistered: event Subcontractor.SubcontractorRegistered is {
        tell command SubcontractorContext.SubcontractorRepository.PersistSubcontractorRegistered(subcontractorId = subcontractorRegistered.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply SubcontractorRegistered to the SubcontractorAnalytics projection"
      }
      on subcontractorTerminated: event Subcontractor.SubcontractorTerminated is {
        tell command SubcontractorContext.SubcontractorRepository.PersistSubcontractorTerminated(subcontractorId = subcontractorTerminated.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "apply SubcontractorTerminated to the SubcontractorAnalytics projection"
      }
      on subcontractAwarded: event Subcontractor.SubcontractAwarded is {
        tell command SubcontractorContext.SubcontractorRepository.PersistSubcontractAwarded(subcontractorId = subcontractAwarded.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "Update contract metrics"
      }
      on payApplicationApproved: event Subcontractor.PayApplicationApproved is {
        tell command SubcontractorContext.SubcontractorRepository.PersistPayApplicationApproved(subcontractorId = payApplicationApproved.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "Update payment metrics"
      }
      on performanceRated: event Subcontractor.PerformanceRated is {
        tell command SubcontractorContext.SubcontractorRepository.PersistPerformanceRated(subcontractorId = performanceRated.subcontractorId) to repository SubcontractorContext.SubcontractorRepository
        do "Update rating average"
      }
    } with {
      briefly "Maintains subcontractor analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Subcontractor analytics projections"
    described as {
      |Maintains subcontractor analytics data.
    }
  }
  // ---- Event publication for Subcontractor ----
  type SubcontractorEvent is one of {
    SubcontractorContext.Subcontractor.SubcontractorRegistered or SubcontractorContext.Subcontractor.SubcontractorApproved or SubcontractorContext.Subcontractor.InfoUpdated or SubcontractorContext.Subcontractor.InsuranceUpdated or SubcontractorContext.Subcontractor.SubcontractAwarded or SubcontractorContext.Subcontractor.PayApplicationSubmitted or SubcontractorContext.Subcontractor.PayApplicationApproved or SubcontractorContext.Subcontractor.PerformanceRated or SubcontractorContext.Subcontractor.SubcontractorPutOnHold or SubcontractorContext.Subcontractor.SubcontractorReactivated or SubcontractorContext.Subcontractor.SubcontractorTerminated
  } with {
    briefly "Subcontractor event alternation"
    described as {
      |Union of all Subcontractor events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SubcontractorEventSplit as flow is {
    inlet SubcontractorEventSplitIn is type SubcontractorEvent    outlet SubcontractorEventSplitToSubcontractorAnalytics is type SubcontractorEvent
    handler SubcontractorEventSplitHandler is {
      on subcontractorRegistered: event Subcontractor.SubcontractorRegistered is {
        send subcontractorRegistered to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell subcontractorRegistered to entity SubcontractorContext.Subcontractor
      }
      on subcontractorApproved: event Subcontractor.SubcontractorApproved is {
        send subcontractorApproved to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell subcontractorApproved to entity SubcontractorContext.Subcontractor
      }
      on infoUpdated: event Subcontractor.InfoUpdated is {
        send infoUpdated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell infoUpdated to entity SubcontractorContext.Subcontractor
      }
      on insuranceUpdated: event Subcontractor.InsuranceUpdated is {
        send insuranceUpdated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell insuranceUpdated to entity SubcontractorContext.Subcontractor
      }
      on subcontractAwarded: event Subcontractor.SubcontractAwarded is {
        send subcontractAwarded to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell subcontractAwarded to entity SubcontractorContext.Subcontractor
      }
      on payApplicationSubmitted: event Subcontractor.PayApplicationSubmitted is {
        send payApplicationSubmitted to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell payApplicationSubmitted to entity SubcontractorContext.Subcontractor
      }
      on payApplicationApproved: event Subcontractor.PayApplicationApproved is {
        send payApplicationApproved to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell payApplicationApproved to entity SubcontractorContext.Subcontractor
      }
      on performanceRated: event Subcontractor.PerformanceRated is {
        send performanceRated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell performanceRated to entity SubcontractorContext.Subcontractor
      }
      on subcontractorPutOnHold: event Subcontractor.SubcontractorPutOnHold is {
        send subcontractorPutOnHold to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell subcontractorPutOnHold to entity SubcontractorContext.Subcontractor
      }
      on subcontractorReactivated: event Subcontractor.SubcontractorReactivated is {
        send subcontractorReactivated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell subcontractorReactivated to entity SubcontractorContext.Subcontractor
      }
      on subcontractorTerminated: event Subcontractor.SubcontractorTerminated is {
        send subcontractorTerminated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell subcontractorTerminated to entity SubcontractorContext.Subcontractor
      }
      on other is {
        error "Unexpected message for processor SubcontractorEventSplit"
      }
    } with {
      briefly "Subcontractor event fan-out handler"
      described as {
        |Delivers each Subcontractor event to all of its consumers.
      }
    }
  } with {
    briefly "Subcontractor event fan-out"
    described as {
      |Fans Subcontractor events out to the repository and projectors.
    }
  }
  connector 'SubcontractorEvent Stream' is from outlet SubcontractorContext.Subcontractor.SubcontractorEvents2 to inlet SubcontractorContext.SubcontractorEventSplit.SubcontractorEventSplitIn with {
    briefly "Subcontractor events, fanned out to storage and read models"
  }
  connector 'SubcontractorAnalytics Feed' is from outlet SubcontractorContext.SubcontractorEventSplit.SubcontractorEventSplitToSubcontractorAnalytics to inlet SubcontractorContext.SubcontractorAnalytics.SubcontractorAnalyticsFromSubcontractor with {
    briefly "Subcontractor events feeding the SubcontractorAnalytics projection"
  }
  connector 'SubcontractorAnalytics Storage' is from outlet SubcontractorContext.SubcontractorAnalytics.SubcontractorAnalyticsToRepository to inlet SubcontractorContext.SubcontractorRepository.SubcontractorRepositoryFromSubcontractorAnalytics with {
    briefly "SubcontractorAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for subcontractor management"
  described as {
    | The SubcontractorContext is the bounded context for
    | subcontractor relationships and performance tracking.
  }
}
