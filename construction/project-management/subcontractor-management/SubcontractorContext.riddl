// Subcontractor Management - Subcontractor Context
context SubcontractorContext is {
  adaptor FromInsuranceVerificationService from context InsuranceVerificationService is { 
    handler FromInsuranceVerificationServiceHandler is {
      on event InsuranceVerificationService.InsuranceVerified is {
        do "the model receives insurance verified"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceVerificationService"
      }
    } with {
      briefly "from insurance verification service"
      described as {
        |Carries messages from the external InsuranceVerificationService.
      }
    }
  } with {
    briefly "InsuranceVerificationService integration"
    described as {
      |The model's side of the InsuranceVerificationService conversation.
    }
  }
  adaptor ToInsuranceVerificationService to context InsuranceVerificationService is { 
    handler ToInsuranceVerificationServiceHandler is {
      on command InsuranceVerificationService.VerifyInsurance is {
        do "the model sends verify insurance"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceVerificationService"
      }
    } with {
      briefly "to insurance verification service"
      described as {
        |Carries messages to the external InsuranceVerificationService.
      }
    }
  } with {
    briefly "InsuranceVerificationService integration"
    described as {
      |The model's side of the InsuranceVerificationService conversation.
    }
  }
  adaptor FromLicenseVerificationService from context LicenseVerificationService is { 
    handler FromLicenseVerificationServiceHandler is {
      on event LicenseVerificationService.LicenseVerified is {
        do "the model receives license verified"
      }
      on other is {
        error "Unexpected message for adaptor FromLicenseVerificationService"
      }
    } with {
      briefly "from license verification service"
      described as {
        |Carries messages from the external LicenseVerificationService.
      }
    }
  } with {
    briefly "LicenseVerificationService integration"
    described as {
      |The model's side of the LicenseVerificationService conversation.
    }
  }
  adaptor ToLicenseVerificationService to context LicenseVerificationService is { 
    handler ToLicenseVerificationServiceHandler is {
      on command LicenseVerificationService.VerifyLicense is {
        do "the model sends verify license"
      }
      on other is {
        error "Unexpected message for adaptor ToLicenseVerificationService"
      }
    } with {
      briefly "to license verification service"
      described as {
        |Carries messages to the external LicenseVerificationService.
      }
    }
  } with {
    briefly "LicenseVerificationService integration"
    described as {
      |The model's side of the LicenseVerificationService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendSubcontractorNotification is {
        do "the model sends send subcontractor notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentService from context PaymentService is { 
    handler FromPaymentServiceHandler is {
      on event PaymentService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentService"
      }
    } with {
      briefly "from payment service"
      described as {
        |Carries messages from the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  adaptor ToPaymentService to context PaymentService is { 
    handler ToPaymentServiceHandler is {
      on command PaymentService.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentService"
      }
    } with {
      briefly "to payment service"
      described as {
        |Carries messages to the external PaymentService.
      }
    }
  } with {
    briefly "PaymentService integration"
    described as {
      |The model's side of the PaymentService conversation.
    }
  }
  include "types.riddl"
  include "Subcontractor.riddl"
  // Repository for subcontractor persistence
  repository SubcontractorRepository is {
    inlet SubcontractorRepositoryFromSubcontractor is type SubcontractorEvent    inlet SubcontractorRepositoryFromSubcontractorAnalytics is type SubcontractorEvent    outlet SubcontractorRepositoryResponses is type Subcontractor.SubcontractorResult
    record StoredSubcontractor is  {
      subcontractorId: SubcontractorId with {
        briefly "subcontractorId"
        described as {
          |The subcontractorId column of the stored subcontractor row.
        }
      }
    } with {
      briefly "Stored subcontractor row"
      described as {
        |The persistence shape of subcontractor data as this repository stores it.
      }
    }
    schema SubcontractorData is relational
      of subcontractors as type StoredSubcontractor
        index on field StoredSubcontractor.subcontractorId
 with {
      briefly "Subcontractor data schema"
      described as {
        |The relational schema holding subcontractor data for the SubcontractorRepository.
      }
    }
    handler SubcontractorPersistence is {
      on query GetSubcontractorSummary is {
        do "read the subcontractor summary projection"
        yield result SubcontractorSummaryView
      }
      on command Subcontractor.RegisterSubcontractor is {
        do "Store new subcontractor record"
      }
      on command Subcontractor.ApproveSubcontractor is {
        tell event Subcontractor.SubcontractorApproved to entity SubcontractorContext.Subcontractor
        do "Update status to approved"
      }
      on command Subcontractor.AwardSubcontract is {
        do "Store subcontract record"
      }
      on command Subcontractor.ApprovePayApplication is {
        tell event Subcontractor.PayApplicationApproved to entity SubcontractorContext.Subcontractor
        do "Update pay application status"
      }
      on command Subcontractor.RatePerformance is {
        do "Store performance rating"
      }
    } with {
      briefly "Persists subcontractor commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Subcontractor data persistence"
    described as {
      | The SubcontractorRepository provides persistent storage for
      | subcontractors, contracts, and performance history.
    }
  }
  // Projector for subcontractor analytics
  query GetSubcontractorSummary is  {
    subcontractorSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which subcontractor summary to retrieve.
      }
    }
  } with {
    briefly "Get subcontractor summary"
    described as {
      |Retrieves the subcontractor summary projection.
    }
  }
  result SubcontractorSummaryView is  {
    subcontractorSummary: SubcontractorAnalytics.SubcontractorSummary with {
      briefly "Subcontractor summary"
      described as {
        |The subcontractor summary being returned.
      }
    }
  } with {
    briefly "Subcontractor summary view"
    described as {
      |Read model view carrying the subcontractor summary projection.
    }
  }
  projector SubcontractorAnalytics is {
    updates repository SubcontractorContext.SubcontractorRepository
    inlet SubcontractorAnalyticsFromSubcontractor is type SubcontractorEvent    outlet SubcontractorAnalyticsOut is type SubcontractorEvent
    record SubcontractorSummary is  {
      subcontractorId: SubcontractorId with {
        briefly "Subcontractor"
        described as {
          |Subcontractor ID.
        }
      }
      activeContracts: Natural with {
        briefly "Contracts"
        described as {
          |Active contract count.
        }
      }
      totalContractValue: Money with {
        briefly "Value"
        described as {
          |Total contract value.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      pendingPayments: Money with {
        briefly "Pending"
        described as {
          |Pending payment amount.
        }
      }
    } with {
      briefly "Subcontractor summary"
      described as {
        |Subcontractor metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on event Subcontractor.SubcontractAwarded is {
        tell event Subcontractor.SubcontractAwarded to repository SubcontractorContext.SubcontractorRepository
        do "Update contract metrics"
      }
      on event Subcontractor.PayApplicationApproved is {
        tell event Subcontractor.PayApplicationApproved to repository SubcontractorContext.SubcontractorRepository
        do "Update payment metrics"
      }
      on event Subcontractor.PerformanceRated is {
        tell event Subcontractor.PerformanceRated to repository SubcontractorContext.SubcontractorRepository
        do "Update rating average"
      }
    } with {
      briefly "Maintains subcontractor analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Subcontractor analytics projections"
    described as {
      |Maintains subcontractor analytics data.
    }
  }
  // ---- Event publication for Subcontractor ----
  type SubcontractorEvent is one of {
    SubcontractorContext.Subcontractor.SubcontractorRegistered or SubcontractorContext.Subcontractor.SubcontractorApproved or SubcontractorContext.Subcontractor.InfoUpdated or SubcontractorContext.Subcontractor.InsuranceUpdated or SubcontractorContext.Subcontractor.SubcontractAwarded or SubcontractorContext.Subcontractor.PayApplicationSubmitted or SubcontractorContext.Subcontractor.PayApplicationApproved or SubcontractorContext.Subcontractor.PerformanceRated or SubcontractorContext.Subcontractor.SubcontractorPutOnHold or SubcontractorContext.Subcontractor.SubcontractorReactivated or SubcontractorContext.Subcontractor.SubcontractorTerminated
  } with {
    briefly "Subcontractor event alternation"
    described as {
      |Union of all Subcontractor events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SubcontractorEventSource as source is {
    outlet SubcontractorEvents is type SubcontractorEvent
    handler SubcontractorSourceHandler is {
      on event Subcontractor.SubcontractorRegistered is {
        send event Subcontractor.SubcontractorRegistered to outlet SubcontractorEvents
      }
      on event Subcontractor.SubcontractorApproved is {
        send event Subcontractor.SubcontractorApproved to outlet SubcontractorEvents
      }
      on event Subcontractor.InfoUpdated is {
        send event Subcontractor.InfoUpdated to outlet SubcontractorEvents
      }
      on event Subcontractor.InsuranceUpdated is {
        send event Subcontractor.InsuranceUpdated to outlet SubcontractorEvents
      }
      on event Subcontractor.SubcontractAwarded is {
        send event Subcontractor.SubcontractAwarded to outlet SubcontractorEvents
      }
      on event Subcontractor.PayApplicationSubmitted is {
        send event Subcontractor.PayApplicationSubmitted to outlet SubcontractorEvents
      }
      on event Subcontractor.PayApplicationApproved is {
        send event Subcontractor.PayApplicationApproved to outlet SubcontractorEvents
      }
      on event Subcontractor.PerformanceRated is {
        send event Subcontractor.PerformanceRated to outlet SubcontractorEvents
      }
      on event Subcontractor.SubcontractorPutOnHold is {
        send event Subcontractor.SubcontractorPutOnHold to outlet SubcontractorEvents
      }
      on event Subcontractor.SubcontractorReactivated is {
        send event Subcontractor.SubcontractorReactivated to outlet SubcontractorEvents
      }
      on event Subcontractor.SubcontractorTerminated is {
        send event Subcontractor.SubcontractorTerminated to outlet SubcontractorEvents
      }
      on other is {
        error "Unexpected message for source SubcontractorEventSource"
      }
    } with {
      briefly "Subcontractor source handler"
      described as {
        |Publishes Subcontractor events onto the outlet.
      }
    }
  } with {
    briefly "Subcontractor event source"
    described as {
      |Publishes Subcontractor entity events into the streaming topology.
    }
  }
  processor SubcontractorEventSink as sink is {
    inlet SubcontractorInlet is type SubcontractorEvent    handler SubcontractorSinkHandler is {
      on event Subcontractor.SubcontractorRegistered is {
        tell event Subcontractor.SubcontractorRegistered to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.SubcontractorApproved is {
        tell event Subcontractor.SubcontractorApproved to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.InfoUpdated is {
        tell event Subcontractor.InfoUpdated to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.InsuranceUpdated is {
        tell event Subcontractor.InsuranceUpdated to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.SubcontractAwarded is {
        tell event Subcontractor.SubcontractAwarded to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.PayApplicationSubmitted is {
        tell event Subcontractor.PayApplicationSubmitted to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.PayApplicationApproved is {
        tell event Subcontractor.PayApplicationApproved to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.PerformanceRated is {
        tell event Subcontractor.PerformanceRated to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.SubcontractorPutOnHold is {
        tell event Subcontractor.SubcontractorPutOnHold to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.SubcontractorReactivated is {
        tell event Subcontractor.SubcontractorReactivated to repository SubcontractorContext.SubcontractorRepository
      }
      on event Subcontractor.SubcontractorTerminated is {
        tell event Subcontractor.SubcontractorTerminated to repository SubcontractorContext.SubcontractorRepository
      }
      on other is {
        error "Unexpected message for sink SubcontractorEventSink"
      }
    } with {
      briefly "Subcontractor sink handler"
      described as {
        |Persists Subcontractor events via the repository.
      }
    }
  } with {
    briefly "Subcontractor event sink"
    described as {
      |Receives Subcontractor events for persistence.
    }
  }
  connector SubcontractorEventFlow is from outlet SubcontractorContext.SubcontractorEventSource.SubcontractorEvents to inlet SubcontractorContext.SubcontractorEventSink.SubcontractorInlet with {
    briefly "Subcontractor event flow"
    described as {
      |Connects the Subcontractor source to its sink.
    }
  }
  processor SubcontractorEventSplit is {
    inlet SubcontractorEventSplitIn is type SubcontractorEvent    outlet SubcontractorEventSplitToSubcontractorRepository is type SubcontractorEvent
    outlet SubcontractorEventSplitToSubcontractorAnalytics is type SubcontractorEvent
    handler SubcontractorEventSplitHandler is {
      on event Subcontractor.SubcontractorRegistered is {
        send event Subcontractor.SubcontractorRegistered to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.SubcontractorRegistered to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.SubcontractorRegistered to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.SubcontractorApproved is {
        send event Subcontractor.SubcontractorApproved to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.SubcontractorApproved to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.SubcontractorApproved to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.InfoUpdated is {
        send event Subcontractor.InfoUpdated to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.InfoUpdated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.InfoUpdated to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.InsuranceUpdated is {
        send event Subcontractor.InsuranceUpdated to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.InsuranceUpdated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.InsuranceUpdated to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.SubcontractAwarded is {
        send event Subcontractor.SubcontractAwarded to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.SubcontractAwarded to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.SubcontractAwarded to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.PayApplicationSubmitted is {
        send event Subcontractor.PayApplicationSubmitted to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.PayApplicationSubmitted to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.PayApplicationSubmitted to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.PayApplicationApproved is {
        send event Subcontractor.PayApplicationApproved to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.PayApplicationApproved to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.PayApplicationApproved to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.PerformanceRated is {
        send event Subcontractor.PerformanceRated to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.PerformanceRated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.PerformanceRated to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.SubcontractorPutOnHold is {
        send event Subcontractor.SubcontractorPutOnHold to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.SubcontractorPutOnHold to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.SubcontractorPutOnHold to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.SubcontractorReactivated is {
        send event Subcontractor.SubcontractorReactivated to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.SubcontractorReactivated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.SubcontractorReactivated to entity SubcontractorContext.Subcontractor
      }
      on event Subcontractor.SubcontractorTerminated is {
        send event Subcontractor.SubcontractorTerminated to outlet SubcontractorEventSplitToSubcontractorRepository
        send event Subcontractor.SubcontractorTerminated to outlet SubcontractorEventSplitToSubcontractorAnalytics
        tell event Subcontractor.SubcontractorTerminated to entity SubcontractorContext.Subcontractor
      }
      on other is {
        error "Unexpected message for processor SubcontractorEventSplit"
      }
    } with {
      briefly "Subcontractor event fan-out handler"
      described as {
        |Delivers each Subcontractor event to all of its consumers.
      }
    }
  } with {
    briefly "Subcontractor event fan-out"
    described as {
      |Fans Subcontractor events out to the repository and projectors.
    }
  }
  connector SubcontractorEventStream is from outlet SubcontractorContext.Subcontractor.SubcontractorEvents2 to inlet SubcontractorContext.SubcontractorEventSplit.SubcontractorEventSplitIn with {
    briefly "Subcontractor events, fanned out to storage and read models"
  }
  connector SubcontractorEventStorage is from outlet SubcontractorContext.SubcontractorEventSplit.SubcontractorEventSplitToSubcontractorRepository to inlet SubcontractorContext.SubcontractorRepository.SubcontractorRepositoryFromSubcontractor with {
    briefly "Subcontractor events on their way to storage"
  }
  connector SubcontractorAnalyticsFeed is from outlet SubcontractorContext.SubcontractorEventSplit.SubcontractorEventSplitToSubcontractorAnalytics to inlet SubcontractorContext.SubcontractorAnalytics.SubcontractorAnalyticsFromSubcontractor with {
    briefly "Subcontractor events feeding the SubcontractorAnalytics projection"
  }
  connector SubcontractorAnalyticsStorage is from outlet SubcontractorContext.SubcontractorAnalytics.SubcontractorAnalyticsOut to inlet SubcontractorContext.SubcontractorRepository.SubcontractorRepositoryFromSubcontractorAnalytics with {
    briefly "The SubcontractorAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for subcontractor management"
  described as {
    | The SubcontractorContext is the bounded context for
    | subcontractor relationships and performance tracking.
  }
}
