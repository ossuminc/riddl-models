// Subcontractor Management - Subcontractor Entity
entity Subcontractor as flow is {
  type SubcontractorCommand is one of {
    Subcontractor.RegisterSubcontractor or Subcontractor.ApproveSubcontractor or Subcontractor.UpdateInfo or Subcontractor.UpdateInsurance or Subcontractor.AwardSubcontract or Subcontractor.SubmitPayApplication or Subcontractor.ApprovePayApplication or Subcontractor.RatePerformance or Subcontractor.PutOnHold or Subcontractor.ReactivateSubcontractor or Subcontractor.TerminateSubcontractor
  } with {
    briefly "Subcontractor command alternation"
    described as {
      |Commands accepted by the Subcontractor entity.
    }
  }
  inlet SubcontractorCommands is type SubcontractorCommand  outlet SubcontractorEvents2 is type SubcontractorEvent
  query GetSubcontractor is  {
    subcontractorId: SubcontractorId with {
      briefly "ID"
      described as {
        |Identifier of the Subcontractor to retrieve.
      }
    }
  } with {
    briefly "Get Subcontractor"
    described as {
      |Retrieve Subcontractor data by identifier.
    }
  }
  result SubcontractorResult is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor addressed"
      described as {
        |Which subcontractor this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    subcontractorData: Subcontractor.PendingSubcontractorData with {
      briefly "Subcontractor data"
      described as {
        |The requested Subcontractor data.
      }
    }
  } with {
    briefly "Subcontractor result"
    described as {
      |Result carrying the requested Subcontractor data.
    }
  }
  // Commands
  command RegisterSubcontractor is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |New subcontractor identifier.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Subcontractor information.
      }
    }
    insurance: Insurance+ with {
      briefly "Insurance"
      described as {
        |Insurance policies.
      }
    }
  } with {
    briefly "Register subcontractor"
    described as {
      |Registers a new subcontractor.
    }
  }
  command ApproveSubcontractor is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor to approve.
      }
    }
    approvedBy: String(1,100) with {
      briefly "Approved by"
      described as {
        |Who approved.
      }
    }
  } with {
    briefly "Approve subcontractor"
    described as {
      |Approves subcontractor for work.
    }
  }
  command UpdateInfo is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Updated information.
      }
    }
  } with {
    briefly "Update info"
    described as {
      |Updates subcontractor information.
    }
  }
  command UpdateInsurance is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    insurance: Insurance+ with {
      briefly "Insurance"
      described as {
        |Updated insurance.
      }
    }
  } with {
    briefly "Update insurance"
    described as {
      |Updates insurance policies.
    }
  }
  command AwardSubcontract is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    subcontract: Subcontract with {
      briefly "Subcontract"
      described as {
        |Subcontract details.
      }
    }
  } with {
    briefly "Award subcontract"
    described as {
      |Awards a subcontract.
    }
  }
  command SubmitPayApplication is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    application: PayApplication with {
      briefly "Application"
      described as {
        |Pay application.
      }
    }
  } with {
    briefly "Submit pay application"
    described as {
      |Submits payment request.
    }
  }
  command ApprovePayApplication is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    applicationId: UUID with {
      briefly "Application ID"
      described as {
        |Application to approve.
      }
    }
    amountApproved: Money with {
      briefly "Amount"
      described as {
        |Approved amount.
      }
    }
    approvedBy: String(1,100) with {
      briefly "Approved by"
      described as {
        |Who approved.
      }
    }
  } with {
    briefly "Approve pay application"
    described as {
      |Approves payment request.
    }
  }
  command RatePerformance is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    rating: PerformanceRating with {
      briefly "Rating"
      described as {
        |Performance rating.
      }
    }
  } with {
    briefly "Rate performance"
    described as {
      |Records performance rating.
    }
  }
  command PutOnHold is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
  } with {
    briefly "Put on hold"
    described as {
      |Puts subcontractor on hold.
    }
  }
  command ReactivateSubcontractor is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
  } with {
    briefly "Reactivate"
    described as {
      |Reactivates subcontractor.
    }
  }
  command TerminateSubcontractor is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor ID"
      described as {
        |Subcontractor ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedBy: String(1,100) with {
      briefly "Terminated by"
      described as {
        |Who terminated.
      }
    }
  } with {
    briefly "Terminate"
    described as {
      |Terminates subcontractor relationship.
    }
  }
  // Events
  event SubcontractorRegistered is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Subcontractor info.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Subcontractor was registered"
    described as {
      |Emitted when subcontractor registers.
    }
  }
  event SubcontractorApproved is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Subcontractor was approved"
    described as {
      |Emitted when subcontractor is approved.
    }
  }
  event InfoUpdated is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Updated info.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Info was updated"
    described as {
      |Emitted when information is updated.
    }
  }
  event InsuranceUpdated is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Insurance was updated"
    described as {
      |Emitted when insurance is updated.
    }
  }
  event SubcontractAwarded is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    subcontract: Subcontract with {
      briefly "Subcontract"
      described as {
        |Awarded subcontract.
      }
    }
    awardedAt: TimeStamp with {
      briefly "Awarded"
      described as {
        |Award time.
      }
    }
  } with {
    briefly "Subcontract was awarded"
    described as {
      |Emitted when subcontract is awarded.
    }
  }
  event PayApplicationSubmitted is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    application: PayApplication with {
      briefly "Application"
      described as {
        |Pay application.
      }
    }
  } with {
    briefly "Pay application was submitted"
    described as {
      |Emitted when pay app is submitted.
    }
  }
  event PayApplicationApproved is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    applicationId: UUID with {
      briefly "Application"
      described as {
        |Application ID.
      }
    }
    amountApproved: Money with {
      briefly "Amount"
      described as {
        |Approved amount.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Pay application was approved"
    described as {
      |Emitted when pay app is approved.
    }
  }
  event PerformanceRated is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    rating: PerformanceRating with {
      briefly "Rating"
      described as {
        |Performance rating.
      }
    }
  } with {
    briefly "Performance was rated"
    described as {
      |Emitted when rating is recorded.
    }
  }
  event SubcontractorPutOnHold is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
    heldAt: TimeStamp with {
      briefly "Held"
      described as {
        |Hold time.
      }
    }
  } with {
    briefly "Subcontractor was put on hold"
    described as {
      |Emitted when subcontractor is held.
    }
  }
  event SubcontractorReactivated is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    reactivatedAt: TimeStamp with {
      briefly "Reactivated"
      described as {
        |Reactivation time.
      }
    }
  } with {
    briefly "Subcontractor was reactivated"
    described as {
      |Emitted when subcontractor is reactivated.
    }
  }
  event SubcontractorTerminated is  {
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedAt: TimeStamp with {
      briefly "Terminated"
      described as {
        |Termination time.
      }
    }
  } with {
    briefly "Subcontractor was terminated"
    described as {
      |Emitted when relationship ends.
    }
  }
  // State Records
  record PendingSubcontractorData is  {
    stateValue: SubcontractorStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Subcontractor info.
      }
    }
    insurance: Insurance+ with {
      briefly "Insurance"
      described as {
        |Insurance policies.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Pending subcontractor data"
    described as {
      |State data for pending subcontractor.
    }
  }
  record ApprovedSubcontractorData is  {
    stateValue: SubcontractorStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Subcontractor info.
      }
    }
    insurance: Insurance+ with {
      briefly "Insurance"
      described as {
        |Insurance policies.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Approved subcontractor data"
    described as {
      |State data for approved subcontractor.
    }
  }
  record ActiveSubcontractorData is  {
    stateValue: SubcontractorStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Subcontractor info.
      }
    }
    insurance: Insurance+ with {
      briefly "Insurance"
      described as {
        |Insurance policies.
      }
    }
    subcontracts: Subcontract+ with {
      briefly "Subcontracts"
      described as {
        |Active subcontracts.
      }
    }
    payApplications: PayApplication+ with {
      briefly "Pay apps"
      described as {
        |Pay applications.
      }
    }
    ratings: PerformanceRating+ with {
      briefly "Ratings"
      described as {
        |Performance ratings.
      }
    }
  } with {
    briefly "Active subcontractor data"
    described as {
      |State data for active subcontractor.
    }
  }
  record OnHoldSubcontractorData is  {
    stateValue: SubcontractorStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Subcontractor info.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
    heldAt: TimeStamp with {
      briefly "Held"
      described as {
        |Hold time.
      }
    }
  } with {
    briefly "On hold subcontractor data"
    described as {
      |State data for held subcontractor.
    }
  }
  record TerminatedSubcontractorData is  {
    stateValue: SubcontractorStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    subcontractorId: SubcontractorId with {
      briefly "Subcontractor"
      described as {
        |Subcontractor ID.
      }
    }
    info: SubcontractorInfo with {
      briefly "Info"
      described as {
        |Subcontractor info.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Termination reason.
      }
    }
    terminatedAt: TimeStamp with {
      briefly "Terminated"
      described as {
        |Termination time.
      }
    }
  } with {
    briefly "Terminated subcontractor data"
    described as {
      |State data for terminated subcontractor.
    }
  }
  // States
  initial state PendingState of record Subcontractor.PendingSubcontractorData is {
    initial handler PendingStateInitHandler is {
      on query GetSubcontractor is {
        let subcontractorResult: type SubcontractorResult = prompt("read the subcontractor from the store")
        tell subcontractorResult to entity SubcontractorContext.Subcontractor
      }
      on init is {
        set state PendingState to "initialize from prior event"
        set field PendingSubcontractorData.stateValue to "Pending"
      }
    } with {
      briefly "PendingState init handler"
      described as {
        |Initializes the PendingState state.
      }
    }
  } with {
    briefly "PendingState state"
    described as {
      |The PendingState state of the Subcontractor.
    }
  }
  state ApprovedState of record Subcontractor.ApprovedSubcontractorData is {
    initial handler ApprovedStateInitHandler is {
      on init is {
        set state ApprovedState to "initialize from prior event"
        set field ApprovedSubcontractorData.stateValue to "Approved"
      }
    } with {
      briefly "ApprovedState init handler"
      described as {
        |Initializes the ApprovedState state.
      }
    }
  } with {
    briefly "ApprovedState state"
    described as {
      |The ApprovedState state of the Subcontractor.
    }
  }
  state ActiveState of record Subcontractor.ActiveSubcontractorData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from prior event"
        set field ActiveSubcontractorData.stateValue to "Active"
      }
    } with {
      briefly "ActiveState init handler"
      described as {
        |Initializes the ActiveState state.
      }
    }
  } with {
    briefly "ActiveState state"
    described as {
      |The ActiveState state of the Subcontractor.
    }
  }
  state OnHoldState of record Subcontractor.OnHoldSubcontractorData is {
    initial handler OnHoldStateInitHandler is {
      on init is {
        set state OnHoldState to "initialize from prior event"
        set field OnHoldSubcontractorData.stateValue to "OnHold"
      }
    } with {
      briefly "OnHoldState init handler"
      described as {
        |Initializes the OnHoldState state.
      }
    }
  } with {
    briefly "OnHoldState state"
    described as {
      |The OnHoldState state of the Subcontractor.
    }
  }
  state TerminatedState of record Subcontractor.TerminatedSubcontractorData is {
    initial handler TerminatedStateInitHandler is {
      on init is {
        set state TerminatedState to "initialize from prior event"
        set field TerminatedSubcontractorData.stateValue to "Terminated"
      }
    } with {
      briefly "TerminatedState init handler"
      described as {
        |Initializes the TerminatedState state.
      }
    }
  } with {
    briefly "TerminatedState state"
    described as {
      |The TerminatedState state of the Subcontractor.
    }
  }
  // Handler
  handler SubcontractorHandler is {
    on registerSubcontractor: command RegisterSubcontractor is {
      morph entity SubcontractorContext.Subcontractor to state SubcontractorContext.Subcontractor.PendingState with record Subcontractor.PendingSubcontractorData(subcontractorId = registerSubcontractor.subcontractorId, info = registerSubcontractor.info, insurance = registerSubcontractor.insurance)
      tell event SubcontractorRegistered(subcontractorId = registerSubcontractor.subcontractorId, info = registerSubcontractor.info) to entity SubcontractorContext.Subcontractor
    }
    on approveSubcontractor: command ApproveSubcontractor is {
      morph entity SubcontractorContext.Subcontractor to state SubcontractorContext.Subcontractor.ApprovedState with record Subcontractor.ApprovedSubcontractorData(subcontractorId = approveSubcontractor.subcontractorId)
      tell event SubcontractorApproved(subcontractorId = approveSubcontractor.subcontractorId) to entity SubcontractorContext.Subcontractor
    }
    on updateInfo: command UpdateInfo is {
      tell event InfoUpdated(subcontractorId = updateInfo.subcontractorId, info = updateInfo.info) to entity SubcontractorContext.Subcontractor
    }
    on updateInsurance: command UpdateInsurance is {
      tell event InsuranceUpdated(subcontractorId = updateInsurance.subcontractorId) to entity SubcontractorContext.Subcontractor
    }
    on awardSubcontract: command AwardSubcontract is {
      morph entity SubcontractorContext.Subcontractor to state SubcontractorContext.Subcontractor.ActiveState with record Subcontractor.ActiveSubcontractorData(subcontractorId = awardSubcontract.subcontractorId)
      tell event SubcontractAwarded(subcontractorId = awardSubcontract.subcontractorId, subcontract = awardSubcontract.subcontract) to entity SubcontractorContext.Subcontractor
    }
    on submitPayApplication: command SubmitPayApplication is {
      tell event PayApplicationSubmitted(subcontractorId = submitPayApplication.subcontractorId, application = submitPayApplication.application) to entity SubcontractorContext.Subcontractor
    }
    on approvePayApplication: command ApprovePayApplication is {
      tell event PayApplicationApproved(subcontractorId = approvePayApplication.subcontractorId, applicationId = approvePayApplication.applicationId, amountApproved = approvePayApplication.amountApproved) to entity SubcontractorContext.Subcontractor
    }
    on ratePerformance: command RatePerformance is {
      tell event PerformanceRated(subcontractorId = ratePerformance.subcontractorId, rating = ratePerformance.rating) to entity SubcontractorContext.Subcontractor
    }
    on putOnHold: command PutOnHold is {
      morph entity SubcontractorContext.Subcontractor to state SubcontractorContext.Subcontractor.OnHoldState with record Subcontractor.OnHoldSubcontractorData(subcontractorId = putOnHold.subcontractorId, reason = putOnHold.reason)
      tell event SubcontractorPutOnHold(subcontractorId = putOnHold.subcontractorId, reason = putOnHold.reason) to entity SubcontractorContext.Subcontractor
    }
    on reactivateSubcontractor: command ReactivateSubcontractor is {
      morph entity SubcontractorContext.Subcontractor to state SubcontractorContext.Subcontractor.ActiveState with record Subcontractor.ActiveSubcontractorData(subcontractorId = reactivateSubcontractor.subcontractorId)
      tell event SubcontractorReactivated(subcontractorId = reactivateSubcontractor.subcontractorId) to entity SubcontractorContext.Subcontractor
    }
    on terminateSubcontractor: command TerminateSubcontractor is {
      morph entity SubcontractorContext.Subcontractor to state SubcontractorContext.Subcontractor.TerminatedState with record Subcontractor.TerminatedSubcontractorData(subcontractorId = terminateSubcontractor.subcontractorId, reason = terminateSubcontractor.reason)
      tell event SubcontractorTerminated(subcontractorId = terminateSubcontractor.subcontractorId, reason = terminateSubcontractor.reason) to entity SubcontractorContext.Subcontractor
    }
  } with {
    briefly "Processes subcontractor commands"
    described as {
      | Handles subcontractor lifecycle including registration,
      | contracts, payments, and performance.
    }
  }
} with {
  briefly "Subcontractor aggregate"
  described as {
    | The Subcontractor entity manages subcontractor
    | relationships from registration through contracts and payments.
  }
}
