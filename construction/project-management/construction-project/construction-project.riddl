// Construction Project Domain Model
// Construction project planning, scheduling, and management
domain ConstructionProject is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProjectManager is "manager overseeing construction project" with {
    briefly "Project manager"
    described as {
      |Staff managing project timeline and resources.
    }
  }
  user Scheduler is "staff managing project schedule" with {
    briefly "Scheduler"
    described as {
      |Staff responsible for project scheduling.
    }
  }
  user Owner is "project owner or client" with {
    briefly "Owner"
    described as {
      |Client who owns the project.
    }
  }
  epic ProjectPlanningEpic is {
    user ProjectManager wants to "to plan and track project progress" so that "projects are completed on time and within budget"
    case PlanProject is {
      user ProjectManager wants to "to create a comprehensive project plan" so that "all stakeholders understand scope and timeline"
      step is "Manager defines project scope" "with deliverables" "and milestones" with {
        briefly "Define scope"
        described as {
          |Manager establishes project scope.
        }
      }
      step is "Scheduler creates work breakdown" "structure and dependencies" "for tasks" with {
        briefly "Create WBS"
        described as {
          |Scheduler breaks down work.
        }
      }
      step take input ConstructionProjectApp.ConstructionProjectScreen.ApproveProjectInput from user Owner with {
        briefly "Approve project"
        described as {
          |Owner approves project plan.
        }
      }
      step is "System notifies team" "of approved project" "and timeline" with {
        briefly "Notify team"
        described as {
          |System sends notifications.
        }
      }
    } with {
      briefly "Project planning workflow"
      described as {
        |Standard flow for planning construction projects.
      }
    }
  } with {
    briefly "Project planning processing"
    described as {
      | Epic covering project planning from scope definition
      | through schedule creation and approval.
    }
  }
  include "ProjectContext.riddl"
  include "external-contexts.riddl"
  application context ConstructionProjectApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ConstructionProject are delivered.
      }
    }
    group ConstructionProjectScreen is {
      input ApproveProjectInput acquires command ProjectContext.Project.ApproveProject with {
        briefly "Approve project control"
        described as {
          |The control through which a user submits the approve project request.
        }
      }
    } with {
      briefly "Construction project screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppProjectCommands is type ProjectContext.Project.ProjectCommand
    inlet AppProjectRepositoryResponses is type ProjectContext.Project.ProjectResult    handler ConstructionProjectAppHandler is {
      on other is {
        error "Unexpected message for application context ConstructionProjectApp"
      }
    } with {
      briefly "ConstructionProjectApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ConstructionProjectApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppProjectCommands is from outlet ConstructionProjectApp.AppProjectCommands to inlet ProjectContext.Project.ProjectCommands with {
    option persistent()
    briefly "LinkAppProjectCommands"
  }
  connector LinkAppProjectRepositoryResponses is from outlet ProjectContext.ProjectRepository.ProjectRepositoryResponses to inlet ConstructionProjectApp.AppProjectRepositoryResponses with {
    option persistent()
    briefly "LinkAppProjectRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ConstructionProjectApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Construction project domain"
  described as {
    | The ConstructionProject domain handles construction project
    | management including planning, scheduling, and progress tracking.
  }
}
