// Construction Project Domain Model
// Construction project planning, scheduling, and management
domain ConstructionProject is {
  persistent connector 'AccountingServiceEvent Stream' is from outlet AccountingService.AccountingServiceEventsOut to inlet ProjectContext.FromAccountingService.FromAccountingServiceIn with {
    briefly "What AccountingService tells ProjectContext, unasked"
  }
  persistent connector 'DocumentServiceEvent Stream' is from outlet DocumentService.DocumentServiceEventsOut to inlet ProjectContext.FromDocumentService.FromDocumentServiceIn with {
    briefly "What DocumentService tells ProjectContext, unasked"
  }
  persistent connector 'SchedulingServiceEvent Stream' is from outlet SchedulingService.SchedulingServiceEventsOut to inlet ProjectContext.FromSchedulingService.FromSchedulingServiceIn with {
    briefly "What SchedulingService tells ProjectContext, unasked"
  }
  persistent connector 'AccountingServiceRequest Stream' is from outlet ProjectContext.ToAccountingService.ToAccountingServiceOut to inlet AccountingService.AccountingServiceRequests with {
    briefly "What ProjectContext asks AccountingService to send"
  }
  persistent connector 'DocumentServiceRequest Stream' is from outlet ProjectContext.ToDocumentService.ToDocumentServiceOut to inlet DocumentService.DocumentServiceRequests with {
    briefly "What ProjectContext asks DocumentService to send"
  }
  persistent connector 'SchedulingServiceRequest Stream' is from outlet ProjectContext.ToSchedulingService.ToSchedulingServiceOut to inlet SchedulingService.SchedulingServiceRequests with {
    briefly "What ProjectContext asks SchedulingService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet ProjectContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What ProjectContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProjectManager is "manager overseeing construction project" with {
    briefly "Project manager"
    described as {
      |Staff managing project timeline and resources.
    }
  }
  user Scheduler is "staff managing project schedule" with {
    briefly "Scheduler"
    described as {
      |Staff responsible for project scheduling.
    }
  }
  user Owner is "project owner or client" with {
    briefly "Owner"
    described as {
      |Client who owns the project.
    }
  }
  epic ProjectPlanningEpic is {
    user ProjectManager wants to "to plan and track project progress" so that "projects are completed on time and within budget"
    case PlanProject is {
      user ProjectManager wants to "to create a comprehensive project plan" so that "all stakeholders understand scope and timeline"
      step is "Manager defines project scope" "with deliverables" "and milestones" with {
        briefly "Define scope"
        described as {
          |Manager establishes project scope.
        }
      }
      step is "Scheduler creates work breakdown" "structure and dependencies" "for tasks" with {
        briefly "Create WBS"
        described as {
          |Scheduler breaks down work.
        }
      }
      step take input ConstructionProjectApp.ConstructionProjectScreen.ApproveProjectInput from user Owner with {
        briefly "Approve project"
        described as {
          |Owner approves project plan.
        }
      }
      step is "System notifies team" "of approved project" "and timeline" with {
        briefly "Notify team"
        described as {
          |System sends notifications.
        }
      }
    } with {
      briefly "Project planning workflow"
      described as {
        |Standard flow for planning construction projects.
      }
    }
  } with {
    briefly "Project planning processing"
    described as {
      | Epic covering project planning from scope definition
      | through schedule creation and approval.
    }
  }
  include "ProjectContext.riddl"
  include "external-contexts.riddl"
  application context ConstructionProjectApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ConstructionProject are delivered.
      }
    }
    group ConstructionProjectScreen is {
      input GetProjectSummaryInput acquires query ProjectContext.GetProjectSummary with {
        briefly "Get project summary control"
        described as {
          |The control through which a user asks the get project summary question.
        }
      }
      input GetProjectInput acquires query ProjectContext.Project.GetProject with {
        briefly "Get project control"
        described as {
          |The control through which a user asks the get project question.
        }
      }
      input CreateProjectInput acquires command ProjectContext.CreateProject with {
        briefly "Create project control"
        described as {
          |The control through which a user submits the create project request.
        }
      }
      input AddTaskInput acquires command ProjectContext.Project.AddTask with {
        briefly "Add task control"
        described as {
          |The control through which a user submits the add task request.
        }
      }
      input ApproveChangeOrderInput acquires command ProjectContext.Project.ApproveChangeOrder with {
        briefly "Approve change order control"
        described as {
          |The control through which a user submits the approve change order request.
        }
      }
      input CancelProjectInput acquires command ProjectContext.Project.CancelProject with {
        briefly "Cancel project control"
        described as {
          |The control through which a user submits the cancel project request.
        }
      }
      input CompleteMilestoneInput acquires command ProjectContext.Project.CompleteMilestone with {
        briefly "Complete milestone control"
        described as {
          |The control through which a user submits the complete milestone request.
        }
      }
      input CompleteProjectInput acquires command ProjectContext.Project.CompleteProject with {
        briefly "Complete project control"
        described as {
          |The control through which a user submits the complete project request.
        }
      }
      input PutOnHoldInput acquires command ProjectContext.Project.PutOnHold with {
        briefly "Put on hold control"
        described as {
          |The control through which a user submits the put on hold request.
        }
      }
      input ResumeProjectInput acquires command ProjectContext.Project.ResumeProject with {
        briefly "Resume project control"
        described as {
          |The control through which a user submits the resume project request.
        }
      }
      input StartProjectInput acquires command ProjectContext.Project.StartProject with {
        briefly "Start project control"
        described as {
          |The control through which a user submits the start project request.
        }
      }
      input SubmitChangeOrderInput acquires command ProjectContext.Project.SubmitChangeOrder with {
        briefly "Submit change order control"
        described as {
          |The control through which a user submits the submit change order request.
        }
      }
      input UpdateTaskProgressInput acquires command ProjectContext.Project.UpdateTaskProgress with {
        briefly "Update task progress control"
        described as {
          |The control through which a user submits the update task progress request.
        }
      }
      input ApproveProjectInput acquires command ProjectContext.Project.ApproveProject with {
        briefly "Approve project control"
        described as {
          |The control through which a user submits the approve project request.
        }
      }
    } with {
      briefly "Construction project screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppProjectRepositoryQueries is query ProjectContext.GetProjectSummary
    inlet AppProjectRepositoryReplies is result ProjectContext.ProjectSummaryView
    outlet AppProjectQueries is query ProjectContext.Project.GetProject
    outlet AppProjectCommands is type ProjectContext.ProjectRequest
    inlet AppProjectRepositoryResponses is result ProjectContext.Project.ProjectResult
    handler ConstructionProjectAppHandler is {
      on other is {
        error "Unexpected message for application context ConstructionProjectApp"
      }
    } with {
      briefly "ConstructionProjectApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ConstructionProjectApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ProjectRepositoryQuery Stream' is from outlet ConstructionProjectApp.AppProjectRepositoryQueries to inlet ProjectContext.ProjectRepositoryQueriesIn with {
    briefly "ConstructionProjectApp's look-ups of the project repository"
  }
  persistent connector 'ProjectRepositoryReply Stream' is from outlet ProjectContext.ProjectRepositoryRepliesOut to inlet ConstructionProjectApp.AppProjectRepositoryReplies with {
    briefly "The project repository's answers returned to ConstructionProjectApp"
  }
  persistent connector 'ProjectQuery Stream' is from outlet ConstructionProjectApp.AppProjectQueries to inlet ProjectContext.ProjectQueriesIn with {
    briefly "ConstructionProjectApp's look-ups of the project"
  }
  persistent connector 'ProjectCommand Stream' is from outlet ConstructionProjectApp.AppProjectCommands to inlet ProjectContext.ProjectCommandStreamIn with {
    briefly "Project commands from the application"
  }
  persistent connector 'ProjectResult Stream' is from outlet ProjectContext.ProjectResultStreamOut to inlet ConstructionProjectApp.AppProjectRepositoryResponses with {
    briefly "Project query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ConstructionProjectApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Construction project domain"
  described as {
    | The ConstructionProject domain handles construction project
    | management including planning, scheduling, and progress tracking.
  }
}
