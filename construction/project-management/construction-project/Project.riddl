// Construction Project - Project Entity
entity Project as flow is {
  type ProjectCommand is one of {
    Project.CreateProject or Project.ApproveProject or Project.StartProject or Project.AddTask or Project.UpdateTaskProgress or Project.CompleteMilestone or Project.SubmitChangeOrder or Project.ApproveChangeOrder or Project.UpdateBudget or Project.PutOnHold or Project.ResumeProject or Project.CompleteProject or Project.CancelProject
  } with {
    briefly "Project command alternation"
    described as {
      |Commands accepted by the Project entity.
    }
  }
  inlet ProjectCommands is type ProjectCommand  outlet ProjectEvents2 is type ProjectEvent
  query GetProject replies result ProjectResult is {
    projectId: ProjectId with {
      briefly "ID"
      described as {
        |Identifier of the Project to retrieve.
      }
    }
  } with {
    briefly "Get Project"
    described as {
      |Retrieve Project data by identifier.
    }
  }
  result ProjectResult is {
    projectId: ProjectId with {
      briefly "Project addressed"
      described as {
        |Which project this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    projectData: Project.PlanningProjectData with {
      briefly "Project data"
      described as {
        |The requested Project data.
      }
    }
  } with {
    briefly "Project result"
    described as {
      |Result carrying the requested Project data.
    }
  }
  // Commands
  command CreateProject is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |New project identifier.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project information.
      }
    }
    budget: ProjectBudget with {
      briefly "Budget"
      described as {
        |Project budget.
      }
    }
    schedule: ProjectSchedule with {
      briefly "Schedule"
      described as {
        |Project schedule.
      }
    }
  } with {
    briefly "Create project"
    described as {
      |Creates a new construction project.
    }
  }
  command ApproveProject is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project to approve.
      }
    }
    approvedBy: String(1,100) with {
      briefly "Approved by"
      described as {
        |Who approved.
      }
    }
  } with {
    briefly "Approve project"
    described as {
      |Approves project to proceed.
    }
  }
  command StartProject is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project to start.
      }
    }
    actualStart: Date with {
      briefly "Start date"
      described as {
        |Actual start date.
      }
    }
  } with {
    briefly "Start project"
    described as {
      |Marks project as started.
    }
  }
  command AddTask is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project ID.
      }
    }
    task: ProjectTask with {
      briefly "Task"
      described as {
        |Task to add.
      }
    }
  } with {
    briefly "Add task"
    described as {
      |Adds a task to the project.
    }
  }
  command UpdateTaskProgress is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project ID.
      }
    }
    taskId: TaskId with {
      briefly "Task ID"
      described as {
        |Task to update.
      }
    }
    percentComplete: Natural with {
      briefly "Complete"
      described as {
        |New completion percentage.
      }
    }
  } with {
    briefly "Update task progress"
    described as {
      |Updates task completion.
    }
  }
  command CompleteMilestone is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project ID.
      }
    }
    milestoneId: UUID with {
      briefly "Milestone ID"
      described as {
        |Milestone to complete.
      }
    }
    completedDate: Date with {
      briefly "Completed"
      described as {
        |Completion date.
      }
    }
  } with {
    briefly "Complete milestone"
    described as {
      |Marks milestone as complete.
    }
  }
  command SubmitChangeOrder is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project ID.
      }
    }
    changeOrder: ChangeOrder with {
      briefly "Change order"
      described as {
        |Change order details.
      }
    }
  } with {
    briefly "Submit change order"
    described as {
      |Submits a change order.
    }
  }
  command ApproveChangeOrder is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project ID.
      }
    }
    changeOrderId: UUID with {
      briefly "CO ID"
      described as {
        |Change order to approve.
      }
    }
    approvedBy: String(1,100) with {
      briefly "Approved by"
      described as {
        |Who approved.
      }
    }
  } with {
    briefly "Approve change order"
    described as {
      |Approves a change order.
    }
  }
  command UpdateBudget is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project ID.
      }
    }
    budget: ProjectBudget with {
      briefly "Budget"
      described as {
        |Updated budget.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Update reason.
      }
    }
  } with {
    briefly "Update budget"
    described as {
      |Updates project budget.
    }
  }
  command PutOnHold is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project to hold.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
  } with {
    briefly "Put on hold"
    described as {
      |Puts project on hold.
    }
  }
  command ResumeProject is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project to resume.
      }
    }
  } with {
    briefly "Resume project"
    described as {
      |Resumes held project.
    }
  }
  command CompleteProject is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project to complete.
      }
    }
    actualEnd: Date with {
      briefly "End date"
      described as {
        |Actual end date.
      }
    }
    completedBy: String(1,100) with {
      briefly "Completed by"
      described as {
        |Who completed.
      }
    }
  } with {
    briefly "Complete project"
    described as {
      |Marks project as complete.
    }
  }
  command CancelProject is {
    projectId: ProjectId with {
      briefly "Project ID"
      described as {
        |Project to cancel.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledBy: String(1,100) with {
      briefly "Cancelled by"
      described as {
        |Who cancelled.
      }
    }
  } with {
    briefly "Cancel project"
    described as {
      |Cancels the project.
    }
  }
  // Events
  event ProjectCreated is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project info.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Project was created"
    described as {
      |Emitted when project is created.
    }
  }
  event ProjectApproved is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Project was approved"
    described as {
      |Emitted when project is approved.
    }
  }
  event ProjectStarted is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    actualStart: Date with {
      briefly "Start"
      described as {
        |Start date.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Started time.
      }
    }
  } with {
    briefly "Project was started"
    described as {
      |Emitted when project starts.
    }
  }
  event TaskAdded is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    task: ProjectTask with {
      briefly "Task"
      described as {
        |Added task.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "Task was added"
    described as {
      |Emitted when task is added.
    }
  }
  event TaskProgressUpdated is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    taskId: TaskId with {
      briefly "Task"
      described as {
        |Task ID.
      }
    }
    percentComplete: Natural with {
      briefly "Complete"
      described as {
        |Completion %.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Task progress was updated"
    described as {
      |Emitted when task progress changes.
    }
  }
  event MilestoneCompleted is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    milestoneId: UUID with {
      briefly "Milestone"
      described as {
        |Milestone ID.
      }
    }
    completedDate: Date with {
      briefly "Completed"
      described as {
        |Completion date.
      }
    }
  } with {
    briefly "Milestone was completed"
    described as {
      |Emitted when milestone completes.
    }
  }
  event ChangeOrderSubmitted is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    changeOrder: ChangeOrder with {
      briefly "CO"
      described as {
        |Change order.
      }
    }
  } with {
    briefly "Change order was submitted"
    described as {
      |Emitted when change order is submitted.
    }
  }
  event ChangeOrderApproved is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    changeOrderId: UUID with {
      briefly "CO ID"
      described as {
        |Change order ID.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Change order was approved"
    described as {
      |Emitted when change order is approved.
    }
  }
  event BudgetUpdated is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    budget: ProjectBudget with {
      briefly "Budget"
      described as {
        |Updated budget.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Budget was updated"
    described as {
      |Emitted when budget changes.
    }
  }
  event ProjectPutOnHold is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
    heldAt: TimeStamp with {
      briefly "Held"
      described as {
        |Hold time.
      }
    }
  } with {
    briefly "Project was put on hold"
    described as {
      |Emitted when project is held.
    }
  }
  event ProjectResumed is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    resumedAt: TimeStamp with {
      briefly "Resumed"
      described as {
        |Resume time.
      }
    }
  } with {
    briefly "Project was resumed"
    described as {
      |Emitted when project resumes.
    }
  }
  event ProjectCompleted is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    actualEnd: Date with {
      briefly "End"
      described as {
        |End date.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Project was completed"
    described as {
      |Emitted when project completes.
    }
  }
  event ProjectCancelled is {
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Project was cancelled"
    described as {
      |Emitted when project is cancelled.
    }
  }
  // State Records
  record PlanningProjectData is {
    stateValue: ProjectStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project info.
      }
    }
    budget: ProjectBudget with {
      briefly "Budget"
      described as {
        |Budget.
      }
    }
    schedule: ProjectSchedule with {
      briefly "Schedule"
      described as {
        |Schedule.
      }
    }
    tasks: ProjectTask+ with {
      briefly "Tasks"
      described as {
        |Project tasks.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Planning project data"
    described as {
      |State data for project in planning.
    }
  }
  record ApprovedProjectData is {
    stateValue: ProjectStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project info.
      }
    }
    budget: ProjectBudget with {
      briefly "Budget"
      described as {
        |Budget.
      }
    }
    schedule: ProjectSchedule with {
      briefly "Schedule"
      described as {
        |Schedule.
      }
    }
    tasks: ProjectTask+ with {
      briefly "Tasks"
      described as {
        |Project tasks.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Approved project data"
    described as {
      |State data for approved project.
    }
  }
  record InProgressProjectData is {
    stateValue: ProjectStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project info.
      }
    }
    budget: ProjectBudget with {
      briefly "Budget"
      described as {
        |Budget.
      }
    }
    schedule: ProjectSchedule with {
      briefly "Schedule"
      described as {
        |Schedule.
      }
    }
    tasks: ProjectTask+ with {
      briefly "Tasks"
      described as {
        |Project tasks.
      }
    }
    changeOrders: ChangeOrder+ with {
      briefly "COs"
      described as {
        |Change orders.
      }
    }
    currentPhase: ProjectPhase with {
      briefly "Phase"
      described as {
        |Current phase.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "In progress project data"
    described as {
      |State data for active project.
    }
  }
  record OnHoldProjectData is {
    stateValue: ProjectStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project info.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
    heldAt: TimeStamp with {
      briefly "Held"
      described as {
        |Hold time.
      }
    }
  } with {
    briefly "On hold project data"
    described as {
      |State data for held project.
    }
  }
  record CompletedProjectData is {
    stateValue: ProjectStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project info.
      }
    }
    finalBudget: ProjectBudget with {
      briefly "Budget"
      described as {
        |Final budget.
      }
    }
    actualEnd: Date with {
      briefly "End"
      described as {
        |End date.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Completed project data"
    described as {
      |State data for completed project.
    }
  }
  record CancelledProjectData is {
    stateValue: ProjectStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    info: ProjectInfo with {
      briefly "Info"
      described as {
        |Project info.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Cancelled project data"
    described as {
      |State data for cancelled project.
    }
  }
  // States
  initial state PlanningState of record Project.PlanningProjectData is {
    initial handler PlanningStateInitHandler is {
      on query GetProject is {
        let projectResult: type ProjectResult = prompt("read the project from the store")
        reply projectResult
      }
      on init is {
        set state PlanningState to "initialize from prior event"
        set field PlanningProjectData.stateValue to "Planning"
      }
    } with {
      briefly "PlanningState init handler"
      described as {
        |Initializes the PlanningState state.
      }
    }
  } with {
    briefly "PlanningState state"
    described as {
      |The PlanningState state of the Project.
    }
  }
  state ApprovedState of record Project.ApprovedProjectData is {
    initial handler ApprovedStateInitHandler is {
      on init is {
        set state ApprovedState to "initialize from prior event"
        set field ApprovedProjectData.stateValue to "Approved"
      }
    } with {
      briefly "ApprovedState init handler"
      described as {
        |Initializes the ApprovedState state.
      }
    }
  } with {
    briefly "ApprovedState state"
    described as {
      |The ApprovedState state of the Project.
    }
  }
  state InProgressState of record Project.InProgressProjectData is {
    initial handler InProgressStateInitHandler is {
      on init is {
        set state InProgressState to "initialize from prior event"
        set field InProgressProjectData.stateValue to "InProgress"
      }
    } with {
      briefly "InProgressState init handler"
      described as {
        |Initializes the InProgressState state.
      }
    }
  } with {
    briefly "InProgressState state"
    described as {
      |The InProgressState state of the Project.
    }
  }
  state OnHoldState of record Project.OnHoldProjectData is {
    initial handler OnHoldStateInitHandler is {
      on init is {
        set state OnHoldState to "initialize from prior event"
        set field OnHoldProjectData.stateValue to "OnHold"
      }
    } with {
      briefly "OnHoldState init handler"
      described as {
        |Initializes the OnHoldState state.
      }
    }
  } with {
    briefly "OnHoldState state"
    described as {
      |The OnHoldState state of the Project.
    }
  }
  state CompletedState of record Project.CompletedProjectData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from prior event"
        set field CompletedProjectData.stateValue to "Completed"
      }
    } with {
      briefly "CompletedState init handler"
      described as {
        |Initializes the CompletedState state.
      }
    }
  } with {
    briefly "CompletedState state"
    described as {
      |The CompletedState state of the Project.
    }
  }
  state CancelledState of record Project.CancelledProjectData is {
    initial handler CancelledStateInitHandler is {
      on init is {
        set state CancelledState to "initialize from prior event"
        set field CancelledProjectData.stateValue to "Cancelled"
      }
    } with {
      briefly "CancelledState init handler"
      described as {
        |Initializes the CancelledState state.
      }
    }
  } with {
    briefly "CancelledState state"
    described as {
      |The CancelledState state of the Project.
    }
  }
  // Handler
  handler ProjectHandler is {
    on createProject: command CreateProject is {
      morph entity ProjectContext.Project to state ProjectContext.Project.PlanningState with record Project.PlanningProjectData(projectId = createProject.projectId, info = createProject.info, budget = createProject.budget, schedule = createProject.schedule, stateValue = prompt("the state value of this planning project data"), tasks = prompt("the tasks of this planning project data"), createdAt = prompt("the created at of this planning project data"))
      tell event ProjectCreated(projectId = createProject.projectId, info = createProject.info, createdAt = prompt("the created at of this project created")) to entity ProjectContext.Project
    }
    on approveProject: command ApproveProject is {
      morph entity ProjectContext.Project to state ProjectContext.Project.ApprovedState with record Project.ApprovedProjectData(projectId = approveProject.projectId, stateValue = prompt("the state value of this approved project data"), info = prompt("the info of this approved project data"), budget = prompt("the budget of this approved project data"), schedule = prompt("the schedule of this approved project data"), tasks = prompt("the tasks of this approved project data"), approvedAt = prompt("the approved at of this approved project data"))
      tell event ProjectApproved(projectId = approveProject.projectId, approvedAt = prompt("the approved at of this project approved")) to entity ProjectContext.Project
    }
    on startProject: command StartProject is {
      morph entity ProjectContext.Project to state ProjectContext.Project.InProgressState with record Project.InProgressProjectData(projectId = startProject.projectId, stateValue = prompt("the state value of this in progress project data"), info = prompt("the info of this in progress project data"), budget = prompt("the budget of this in progress project data"), schedule = prompt("the schedule of this in progress project data"), tasks = prompt("the tasks of this in progress project data"), changeOrders = prompt("the change orders of this in progress project data"), currentPhase = prompt("the current phase of this in progress project data"), startedAt = prompt("the started at of this in progress project data"))
      tell event ProjectStarted(projectId = startProject.projectId, actualStart = startProject.actualStart, startedAt = prompt("the started at of this project started")) to entity ProjectContext.Project
    }
    on addTask: command AddTask is {
      tell event TaskAdded(projectId = addTask.projectId, task = addTask.task, addedAt = prompt("the added at of this task added")) to entity ProjectContext.Project
    }
    on updateTaskProgress: command UpdateTaskProgress is {
      tell event TaskProgressUpdated(projectId = updateTaskProgress.projectId, taskId = updateTaskProgress.taskId, percentComplete = updateTaskProgress.percentComplete, updatedAt = prompt("the updated at of this task progress updated")) to entity ProjectContext.Project
    }
    on completeMilestone: command CompleteMilestone is {
      tell event MilestoneCompleted(projectId = completeMilestone.projectId, milestoneId = completeMilestone.milestoneId, completedDate = completeMilestone.completedDate) to entity ProjectContext.Project
    }
    on submitChangeOrder: command SubmitChangeOrder is {
      tell event ChangeOrderSubmitted(projectId = submitChangeOrder.projectId, changeOrder = submitChangeOrder.changeOrder) to entity ProjectContext.Project
    }
    on approveChangeOrder: command ApproveChangeOrder is {
      tell event ChangeOrderApproved(projectId = approveChangeOrder.projectId, changeOrderId = approveChangeOrder.changeOrderId, approvedAt = prompt("the approved at of this change order approved")) to entity ProjectContext.Project
    }
    on updateBudget: command UpdateBudget is {
      tell event BudgetUpdated(projectId = updateBudget.projectId, budget = updateBudget.budget, updatedAt = prompt("the updated at of this budget updated")) to entity ProjectContext.Project
    }
    on putOnHold: command PutOnHold is {
      morph entity ProjectContext.Project to state ProjectContext.Project.OnHoldState with record Project.OnHoldProjectData(projectId = putOnHold.projectId, reason = putOnHold.reason, stateValue = prompt("the state value of this on hold project data"), info = prompt("the info of this on hold project data"), heldAt = prompt("the held at of this on hold project data"))
      tell event ProjectPutOnHold(projectId = putOnHold.projectId, reason = putOnHold.reason, heldAt = prompt("the held at of this project put on hold")) to entity ProjectContext.Project
    }
    on resumeProject: command ResumeProject is {
      morph entity ProjectContext.Project to state ProjectContext.Project.InProgressState with record Project.InProgressProjectData(projectId = resumeProject.projectId, stateValue = prompt("the state value of this in progress project data"), info = prompt("the info of this in progress project data"), budget = prompt("the budget of this in progress project data"), schedule = prompt("the schedule of this in progress project data"), tasks = prompt("the tasks of this in progress project data"), changeOrders = prompt("the change orders of this in progress project data"), currentPhase = prompt("the current phase of this in progress project data"), startedAt = prompt("the started at of this in progress project data"))
      tell event ProjectResumed(projectId = resumeProject.projectId, resumedAt = prompt("the resumed at of this project resumed")) to entity ProjectContext.Project
    }
    on completeProject: command CompleteProject is {
      morph entity ProjectContext.Project to state ProjectContext.Project.CompletedState with record Project.CompletedProjectData(projectId = completeProject.projectId, actualEnd = completeProject.actualEnd, stateValue = prompt("the state value of this completed project data"), info = prompt("the info of this completed project data"), finalBudget = prompt("the final budget of this completed project data"), completedAt = prompt("the completed at of this completed project data"))
      tell event ProjectCompleted(projectId = completeProject.projectId, actualEnd = completeProject.actualEnd, completedAt = prompt("the completed at of this project completed")) to entity ProjectContext.Project
    }
    on cancelProject: command CancelProject is {
      morph entity ProjectContext.Project to state ProjectContext.Project.CancelledState with record Project.CancelledProjectData(projectId = cancelProject.projectId, reason = cancelProject.reason, stateValue = prompt("the state value of this cancelled project data"), info = prompt("the info of this cancelled project data"), cancelledAt = prompt("the cancelled at of this cancelled project data"))
      tell event ProjectCancelled(projectId = cancelProject.projectId, reason = cancelProject.reason, cancelledAt = prompt("the cancelled at of this project cancelled")) to entity ProjectContext.Project
    }
    on budgetUpdated: event BudgetUpdated is {
      do "apply BudgetUpdated to the project so it can be persisted and replayed"
    }
    on changeOrderApproved: event ChangeOrderApproved is {
      do "apply ChangeOrderApproved to the project so it can be persisted and replayed"
    }
    on changeOrderSubmitted: event ChangeOrderSubmitted is {
      do "apply ChangeOrderSubmitted to the project so it can be persisted and replayed"
    }
    on milestoneCompleted: event MilestoneCompleted is {
      do "apply MilestoneCompleted to the project so it can be persisted and replayed"
    }
    on projectApproved: event ProjectApproved is {
      do "apply ProjectApproved to the project so it can be persisted and replayed"
    }
    on projectCancelled: event ProjectCancelled is {
      do "apply ProjectCancelled to the project so it can be persisted and replayed"
    }
    on projectCompleted: event ProjectCompleted is {
      do "apply ProjectCompleted to the project so it can be persisted and replayed"
    }
    on projectCreated: event ProjectCreated is {
      do "apply ProjectCreated to the project so it can be persisted and replayed"
    }
    on projectPutOnHold: event ProjectPutOnHold is {
      do "apply ProjectPutOnHold to the project so it can be persisted and replayed"
    }
    on projectResumed: event ProjectResumed is {
      do "apply ProjectResumed to the project so it can be persisted and replayed"
    }
    on projectStarted: event ProjectStarted is {
      do "apply ProjectStarted to the project so it can be persisted and replayed"
    }
    on taskAdded: event TaskAdded is {
      do "apply TaskAdded to the project so it can be persisted and replayed"
    }
    on taskProgressUpdated: event TaskProgressUpdated is {
      do "apply TaskProgressUpdated to the project so it can be persisted and replayed"
    }
  } with {
    briefly "Processes project commands"
    described as {
      | Handles project lifecycle including planning,
      | execution, changes, and completion.
    }
  }
} with {
  briefly "Construction project aggregate"
  described as {
    | The Project entity manages construction project
    | lifecycle from planning through completion.
  }
}
