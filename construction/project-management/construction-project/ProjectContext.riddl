// Construction Project - Project Context
context ProjectContext as router is {
  inlet ProjectCommandStreamIn is type ProjectCommand  outlet ProjectCommandStreamOut is type ProjectCommand
  inlet ProjectResultStreamIn is result Project.ProjectResult  outlet ProjectResultStreamOut is result Project.ProjectResult
  handler ProjectContextBoundary is {
    on createProject: command Project.CreateProject is {
      send createProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on approveProject: command Project.ApproveProject is {
      send approveProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on startProject: command Project.StartProject is {
      send startProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on addTask: command Project.AddTask is {
      send addTask to outlet ProjectContext.ProjectCommandStreamOut
    }
    on updateTaskProgress: command Project.UpdateTaskProgress is {
      send updateTaskProgress to outlet ProjectContext.ProjectCommandStreamOut
    }
    on completeMilestone: command Project.CompleteMilestone is {
      send completeMilestone to outlet ProjectContext.ProjectCommandStreamOut
    }
    on submitChangeOrder: command Project.SubmitChangeOrder is {
      send submitChangeOrder to outlet ProjectContext.ProjectCommandStreamOut
    }
    on approveChangeOrder: command Project.ApproveChangeOrder is {
      send approveChangeOrder to outlet ProjectContext.ProjectCommandStreamOut
    }
    on updateBudget: command Project.UpdateBudget is {
      send updateBudget to outlet ProjectContext.ProjectCommandStreamOut
    }
    on putOnHold: command Project.PutOnHold is {
      send putOnHold to outlet ProjectContext.ProjectCommandStreamOut
    }
    on resumeProject: command Project.ResumeProject is {
      send resumeProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on completeProject: command Project.CompleteProject is {
      send completeProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on cancelProject: command Project.CancelProject is {
      send cancelProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on projectResult: result Project.ProjectResult is {
      send projectResult to outlet ProjectContext.ProjectResultStreamOut
    }
    on other is {
      error "Unexpected message at the ProjectContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ProjectCommand Stream Intake' is from outlet ProjectContext.ProjectCommandStreamOut to inlet ProjectContext.Project.ProjectCommands  connector 'ProjectResult Stream Egress' is from outlet ProjectContext.ProjectRepository.ProjectRepositoryResponses to inlet ProjectContext.ProjectResultStreamIn  adaptor FromAccountingService from context AccountingService is { 
    handler FromAccountingServiceHandler is {
      on event AccountingService.ExpenseRecorded is {
        do "the model receives expense recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromAccountingService"
      }
    } with {
      briefly "from accounting service"
      described as {
        |Carries messages from the external AccountingService.
      }
    }
  } with {
    briefly "AccountingService integration"
    described as {
      |The model's side of the AccountingService conversation.
    }
  }
  adaptor ToAccountingService to context AccountingService is { 
    handler ToAccountingServiceHandler is {
      on command AccountingService.RecordExpense is {
        do "the model sends record expense"
      }
      on other is {
        error "Unexpected message for adaptor ToAccountingService"
      }
    } with {
      briefly "to accounting service"
      described as {
        |Carries messages to the external AccountingService.
      }
    }
  } with {
    briefly "AccountingService integration"
    described as {
      |The model's side of the AccountingService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService is { 
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is { 
    handler ToDocumentServiceHandler is {
      on command DocumentService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendProjectNotification is {
        do "the model sends send project notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSchedulingService from context SchedulingService is { 
    handler FromSchedulingServiceHandler is {
      on event SchedulingService.ResourceScheduled is {
        do "the model receives resource scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromSchedulingService"
      }
    } with {
      briefly "from scheduling service"
      described as {
        |Carries messages from the external SchedulingService.
      }
    }
  } with {
    briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  adaptor ToSchedulingService to context SchedulingService is { 
    handler ToSchedulingServiceHandler is {
      on command SchedulingService.ScheduleResource is {
        do "the model sends schedule resource"
      }
      on other is {
        error "Unexpected message for adaptor ToSchedulingService"
      }
    } with {
      briefly "to scheduling service"
      described as {
        |Carries messages to the external SchedulingService.
      }
    }
  } with {
    briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  include "types.riddl"
  include "Project.riddl"
  // Repository for project persistence
  type ProjectRepositoryCommand is one of {
    ProjectContext.ProjectRepository.PersistBudgetUpdated or ProjectContext.ProjectRepository.PersistChangeOrderApproved or ProjectContext.ProjectRepository.PersistChangeOrderSubmitted or ProjectContext.ProjectRepository.PersistMilestoneCompleted or ProjectContext.ProjectRepository.PersistProjectApproved or ProjectContext.ProjectRepository.PersistProjectCancelled or ProjectContext.ProjectRepository.PersistProjectCompleted or ProjectContext.ProjectRepository.PersistProjectCreated or ProjectContext.ProjectRepository.PersistProjectPutOnHold or ProjectContext.ProjectRepository.PersistProjectResumed or ProjectContext.ProjectRepository.PersistProjectStarted or ProjectContext.ProjectRepository.PersistTaskAdded or ProjectContext.ProjectRepository.PersistTaskProgressUpdated
  } with {
    briefly "Anything that writes ProjectRepository"
    described as {
      |The persistence commands ProjectRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ProjectRepository as flow is {
    inlet ProjectRepositoryFromProjectAnalytics is type ProjectRepositoryCommand    command PersistChangeOrderSubmitted is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChangeOrderSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ChangeOrderSubmitted"
      described as {
        |Instructs this repository to apply ChangeOrderSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneCompleted is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneCompleted applies to.
        }
      }
    } with {
      briefly "Persist MilestoneCompleted"
      described as {
        |Instructs this repository to apply MilestoneCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectApproved is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectApproved applies to.
        }
      }
    } with {
      briefly "Persist ProjectApproved"
      described as {
        |Instructs this repository to apply ProjectApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectCancelled is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectCancelled applies to.
        }
      }
    } with {
      briefly "Persist ProjectCancelled"
      described as {
        |Instructs this repository to apply ProjectCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectCompleted is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectCompleted applies to.
        }
      }
    } with {
      briefly "Persist ProjectCompleted"
      described as {
        |Instructs this repository to apply ProjectCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectCreated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectCreated applies to.
        }
      }
    } with {
      briefly "Persist ProjectCreated"
      described as {
        |Instructs this repository to apply ProjectCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectPutOnHold is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectPutOnHold applies to.
        }
      }
    } with {
      briefly "Persist ProjectPutOnHold"
      described as {
        |Instructs this repository to apply ProjectPutOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectResumed is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectResumed applies to.
        }
      }
    } with {
      briefly "Persist ProjectResumed"
      described as {
        |Instructs this repository to apply ProjectResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectStarted is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectStarted applies to.
        }
      }
    } with {
      briefly "Persist ProjectStarted"
      described as {
        |Instructs this repository to apply ProjectStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskAdded is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskAdded applies to.
        }
      }
    } with {
      briefly "Persist TaskAdded"
      described as {
        |Instructs this repository to apply TaskAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBudgetUpdated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row BudgetUpdated applies to.
        }
      }
    } with {
      briefly "Persist BudgetUpdated"
      described as {
        |Instructs this repository to apply BudgetUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistChangeOrderApproved is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChangeOrderApproved applies to.
        }
      }
    } with {
      briefly "Persist ChangeOrderApproved"
      described as {
        |Instructs this repository to apply ChangeOrderApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskProgressUpdated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskProgressUpdated applies to.
        }
      }
    } with {
      briefly "Persist TaskProgressUpdated"
      described as {
        |Instructs this repository to apply TaskProgressUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ProjectRepositoryResponses is result Project.ProjectResult
    record StoredProject is {
      projectId: ProjectId with {
        briefly "projectId"
        described as {
          |The projectId column of the stored project row.
        }
      }
    } with {
      briefly "Stored project row"
      described as {
        |The persistence shape of project data as this repository stores it.
      }
    }
    schema ProjectData is relational
      of projects as record StoredProject
        index on field StoredProject.projectId
 with {
      briefly "Project data schema"
      described as {
        |The relational schema holding project data for the ProjectRepository.
      }
    }
    handler ProjectPersistence is {
      on persistChangeOrderSubmitted: command PersistChangeOrderSubmitted is {
        do "apply ChangeOrderSubmitted to the stored row"
      }
      on persistMilestoneCompleted: command PersistMilestoneCompleted is {
        do "apply MilestoneCompleted to the stored row"
      }
      on persistProjectApproved: command PersistProjectApproved is {
        do "apply ProjectApproved to the stored row"
      }
      on persistProjectCancelled: command PersistProjectCancelled is {
        do "apply ProjectCancelled to the stored row"
      }
      on persistProjectCompleted: command PersistProjectCompleted is {
        do "apply ProjectCompleted to the stored row"
      }
      on persistProjectCreated: command PersistProjectCreated is {
        do "apply ProjectCreated to the stored row"
      }
      on persistProjectPutOnHold: command PersistProjectPutOnHold is {
        do "apply ProjectPutOnHold to the stored row"
      }
      on persistProjectResumed: command PersistProjectResumed is {
        do "apply ProjectResumed to the stored row"
      }
      on persistProjectStarted: command PersistProjectStarted is {
        do "apply ProjectStarted to the stored row"
      }
      on persistTaskAdded: command PersistTaskAdded is {
        do "apply TaskAdded to the stored row"
      }
      on persistBudgetUpdated: command PersistBudgetUpdated is {
        do "apply BudgetUpdated to the stored row"
      }
      on persistChangeOrderApproved: command PersistChangeOrderApproved is {
        do "apply ChangeOrderApproved to the stored row"
      }
      on persistTaskProgressUpdated: command PersistTaskProgressUpdated is {
        do "apply TaskProgressUpdated to the stored row"
      }
      on query GetProjectSummary is {
        let projectSummaryView: type ProjectSummaryView = prompt("read the project summary projection")
        reply projectSummaryView
      }
    } with {
      briefly "Persists project commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Project data persistence"
    described as {
      | The ProjectRepository provides persistent storage for
      | construction projects and their tasks.
    }
  }
  // Projector for project analytics
  query GetProjectSummary replies result ProjectSummaryView is {
    projectSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which project summary to retrieve.
      }
    }
  } with {
    briefly "Get project summary"
    described as {
      |Retrieves the project summary projection.
    }
  }
  result ProjectSummaryView is {
    projectSummary: ProjectAnalytics.ProjectSummary with {
      briefly "Project summary"
      described as {
        |The project summary being returned.
      }
    }
  } with {
    briefly "Project summary view"
    described as {
      |Read model view carrying the project summary projection.
    }
  }
  projector ProjectAnalytics as flow is {
    updates repository ProjectContext.ProjectRepository
    outlet ProjectAnalyticsToRepository is type ProjectRepositoryCommand
    inlet ProjectAnalyticsFromProject is type ProjectEvent    record ProjectSummary is {
      projectId: ProjectId with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      percentComplete: Natural with {
        briefly "Complete"
        described as {
          |Overall completion %.
        }
      }
      budgetVariance: Money with {
        briefly "Budget variance"
        described as {
          |Budget over/under.
        }
      }
      scheduleVariance: Integer with {
        briefly "Schedule variance"
        described as {
          |Days ahead/behind.
        }
      }
      openChangeOrders: Natural with {
        briefly "Open COs"
        described as {
          |Pending change orders.
        }
      }
    } with {
      briefly "Project summary"
      described as {
        |Project metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on changeOrderSubmitted: event Project.ChangeOrderSubmitted is {
        tell command ProjectContext.ProjectRepository.PersistChangeOrderSubmitted(projectId = changeOrderSubmitted.projectId) to repository ProjectContext.ProjectRepository
        do "apply ChangeOrderSubmitted to the ProjectAnalytics projection"
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        tell command ProjectContext.ProjectRepository.PersistMilestoneCompleted(projectId = milestoneCompleted.projectId) to repository ProjectContext.ProjectRepository
        do "apply MilestoneCompleted to the ProjectAnalytics projection"
      }
      on projectApproved: event Project.ProjectApproved is {
        tell command ProjectContext.ProjectRepository.PersistProjectApproved(projectId = projectApproved.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectApproved to the ProjectAnalytics projection"
      }
      on projectCancelled: event Project.ProjectCancelled is {
        tell command ProjectContext.ProjectRepository.PersistProjectCancelled(projectId = projectCancelled.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectCancelled to the ProjectAnalytics projection"
      }
      on projectCompleted: event Project.ProjectCompleted is {
        tell command ProjectContext.ProjectRepository.PersistProjectCompleted(projectId = projectCompleted.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectCompleted to the ProjectAnalytics projection"
      }
      on projectCreated: event Project.ProjectCreated is {
        tell command ProjectContext.ProjectRepository.PersistProjectCreated(projectId = projectCreated.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectCreated to the ProjectAnalytics projection"
      }
      on projectPutOnHold: event Project.ProjectPutOnHold is {
        tell command ProjectContext.ProjectRepository.PersistProjectPutOnHold(projectId = projectPutOnHold.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectPutOnHold to the ProjectAnalytics projection"
      }
      on projectResumed: event Project.ProjectResumed is {
        tell command ProjectContext.ProjectRepository.PersistProjectResumed(projectId = projectResumed.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectResumed to the ProjectAnalytics projection"
      }
      on projectStarted: event Project.ProjectStarted is {
        tell command ProjectContext.ProjectRepository.PersistProjectStarted(projectId = projectStarted.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectStarted to the ProjectAnalytics projection"
      }
      on taskAdded: event Project.TaskAdded is {
        tell command ProjectContext.ProjectRepository.PersistTaskAdded(projectId = taskAdded.projectId) to repository ProjectContext.ProjectRepository
        do "apply TaskAdded to the ProjectAnalytics projection"
      }
      on taskProgressUpdated: event Project.TaskProgressUpdated is {
        tell command ProjectContext.ProjectRepository.PersistTaskProgressUpdated(projectId = taskProgressUpdated.projectId) to repository ProjectContext.ProjectRepository
        do "Recalculate project completion percentage"
      }
      on budgetUpdated: event Project.BudgetUpdated is {
        tell command ProjectContext.ProjectRepository.PersistBudgetUpdated(projectId = budgetUpdated.projectId) to repository ProjectContext.ProjectRepository
        do "Update budget variance"
      }
      on changeOrderApproved: event Project.ChangeOrderApproved is {
        tell command ProjectContext.ProjectRepository.PersistChangeOrderApproved(projectId = changeOrderApproved.projectId) to repository ProjectContext.ProjectRepository
        do "Update change order metrics"
      }
    } with {
      briefly "Maintains project analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Project analytics projections"
    described as {
      |Maintains project analytics data.
    }
  }
  // ---- Event publication for Project ----
  type ProjectEvent is one of {
    ProjectContext.Project.ProjectCreated or ProjectContext.Project.ProjectApproved or ProjectContext.Project.ProjectStarted or ProjectContext.Project.TaskAdded or ProjectContext.Project.TaskProgressUpdated or ProjectContext.Project.MilestoneCompleted or ProjectContext.Project.ChangeOrderSubmitted or ProjectContext.Project.ChangeOrderApproved or ProjectContext.Project.BudgetUpdated or ProjectContext.Project.ProjectPutOnHold or ProjectContext.Project.ProjectResumed or ProjectContext.Project.ProjectCompleted or ProjectContext.Project.ProjectCancelled
  } with {
    briefly "Project event alternation"
    described as {
      |Union of all Project events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ProjectEventSplit as flow is {
    inlet ProjectEventSplitIn is type ProjectEvent    outlet ProjectEventSplitToProjectAnalytics is type ProjectEvent
    handler ProjectEventSplitHandler is {
      on projectCreated: event Project.ProjectCreated is {
        send projectCreated to outlet ProjectEventSplitToProjectAnalytics
        tell projectCreated to entity ProjectContext.Project
      }
      on projectApproved: event Project.ProjectApproved is {
        send projectApproved to outlet ProjectEventSplitToProjectAnalytics
        tell projectApproved to entity ProjectContext.Project
      }
      on projectStarted: event Project.ProjectStarted is {
        send projectStarted to outlet ProjectEventSplitToProjectAnalytics
        tell projectStarted to entity ProjectContext.Project
      }
      on taskAdded: event Project.TaskAdded is {
        send taskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell taskAdded to entity ProjectContext.Project
      }
      on taskProgressUpdated: event Project.TaskProgressUpdated is {
        send taskProgressUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell taskProgressUpdated to entity ProjectContext.Project
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        send milestoneCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell milestoneCompleted to entity ProjectContext.Project
      }
      on changeOrderSubmitted: event Project.ChangeOrderSubmitted is {
        send changeOrderSubmitted to outlet ProjectEventSplitToProjectAnalytics
        tell changeOrderSubmitted to entity ProjectContext.Project
      }
      on changeOrderApproved: event Project.ChangeOrderApproved is {
        send changeOrderApproved to outlet ProjectEventSplitToProjectAnalytics
        tell changeOrderApproved to entity ProjectContext.Project
      }
      on budgetUpdated: event Project.BudgetUpdated is {
        send budgetUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell budgetUpdated to entity ProjectContext.Project
      }
      on projectPutOnHold: event Project.ProjectPutOnHold is {
        send projectPutOnHold to outlet ProjectEventSplitToProjectAnalytics
        tell projectPutOnHold to entity ProjectContext.Project
      }
      on projectResumed: event Project.ProjectResumed is {
        send projectResumed to outlet ProjectEventSplitToProjectAnalytics
        tell projectResumed to entity ProjectContext.Project
      }
      on projectCompleted: event Project.ProjectCompleted is {
        send projectCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell projectCompleted to entity ProjectContext.Project
      }
      on projectCancelled: event Project.ProjectCancelled is {
        send projectCancelled to outlet ProjectEventSplitToProjectAnalytics
        tell projectCancelled to entity ProjectContext.Project
      }
      on other is {
        error "Unexpected message for processor ProjectEventSplit"
      }
    } with {
      briefly "Project event fan-out handler"
      described as {
        |Delivers each Project event to all of its consumers.
      }
    }
  } with {
    briefly "Project event fan-out"
    described as {
      |Fans Project events out to the repository and projectors.
    }
  }
  connector 'ProjectEvent Stream' is from outlet ProjectContext.Project.ProjectEvents2 to inlet ProjectContext.ProjectEventSplit.ProjectEventSplitIn with {
    briefly "Project events, fanned out to storage and read models"
  }
  connector 'ProjectAnalytics Feed' is from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectAnalytics to inlet ProjectContext.ProjectAnalytics.ProjectAnalyticsFromProject with {
    briefly "Project events feeding the ProjectAnalytics projection"
  }
  connector 'ProjectAnalytics Storage' is from outlet ProjectContext.ProjectAnalytics.ProjectAnalyticsToRepository to inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProjectAnalytics with {
    briefly "ProjectAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for construction projects"
  described as {
    | The ProjectContext is the bounded context for construction
    | project management including planning and tracking.
  }
}
