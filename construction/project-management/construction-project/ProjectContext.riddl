// Construction Project - Project Context
context ProjectContext is {
  adaptor FromAccountingService from context AccountingService is {
    handler FromAccountingServiceHandler is {
      on event AccountingService.ExpenseRecorded is {
        do "the model receives expense recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromAccountingService"
      }
    } with {
      briefly "from accounting service"
      described as {
        |Carries messages from the external AccountingService.
      }
    }
  } with {
      briefly "AccountingService integration"
    described as {
      |The model's side of the AccountingService conversation.
    }
  }
  adaptor ToAccountingService to context AccountingService is {
    handler ToAccountingServiceHandler is {
      on command AccountingService.RecordExpense is {
        do "the model sends record expense"
      }
      on other is {
        error "Unexpected message for adaptor ToAccountingService"
      }
    } with {
      briefly "to accounting service"
      described as {
        |Carries messages to the external AccountingService.
      }
    }
  } with {
      briefly "AccountingService integration"
    described as {
      |The model's side of the AccountingService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService is {
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
      briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is {
    handler ToDocumentServiceHandler is {
      on command DocumentService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
      briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendProjectNotification is {
        do "the model sends send project notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSchedulingService from context SchedulingService is {
    handler FromSchedulingServiceHandler is {
      on event SchedulingService.ResourceScheduled is {
        do "the model receives resource scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromSchedulingService"
      }
    } with {
      briefly "from scheduling service"
      described as {
        |Carries messages from the external SchedulingService.
      }
    }
  } with {
      briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  adaptor ToSchedulingService to context SchedulingService is {
    handler ToSchedulingServiceHandler is {
      on command SchedulingService.ScheduleResource is {
        do "the model sends schedule resource"
      }
      on other is {
        error "Unexpected message for adaptor ToSchedulingService"
      }
    } with {
      briefly "to scheduling service"
      described as {
        |Carries messages to the external SchedulingService.
      }
    }
  } with {
      briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  include "types.riddl"
  include "Project.riddl"
  // Repository for project persistence
  repository ProjectRepository is {
    inlet ProjectRepositoryFromProject is type ProjectEvent
    inlet ProjectRepositoryFromProjectAnalytics is type ProjectEvent
    outlet ProjectRepositoryResponses is type Project.ProjectResult
    record StoredProject is {
      projectId: ProjectId with {
        briefly "projectId"
        described as {
          |The projectId column of the stored project row.
        }
      }
    } with {
      briefly "Stored project row"
      described as {
        |The persistence shape of project data as this repository stores it.
      }
    }
    schema ProjectData is relational
      of projects as type StoredProject
        index on field StoredProject.projectId
      with {
      briefly "Project data schema"
      described as {
        |The relational schema holding project data for the ProjectRepository.
      }
    }

    handler ProjectPersistence is {
      on query GetProjectSummary is {
        do "read the project summary projection"
        yield result ProjectSummaryView
      }
      on command Project.CreateProject is {
        tell event Project.ProjectCreated to entity ProjectContext.Project
        do "Store new project record"
      }
      on command Project.StartProject is {
        tell event Project.ProjectStarted to entity ProjectContext.Project
        do "Update project as in progress"
      }
      on command Project.UpdateTaskProgress is {
        tell event Project.TaskProgressUpdated to entity ProjectContext.Project
        do "Update task progress"
      }
      on command Project.UpdateBudget is {
        tell event Project.BudgetUpdated to entity ProjectContext.Project
        do "Update budget record"
      }
      on command Project.CompleteProject is {
        tell event Project.ProjectCompleted to entity ProjectContext.Project
        do "Update project as completed"
      }
    } with {
      briefly "Persists project commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Project data persistence"
    described as {
      | The ProjectRepository provides persistent storage for
      | construction projects and their tasks.
    }
  }
  // Projector for project analytics
  query GetProjectSummary is {
    projectSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which project summary to retrieve.
      }
    }
  } with {
    briefly "Get project summary"
    described as {
      |Retrieves the project summary projection.
    }
  }
  result ProjectSummaryView is {
    projectSummary: ProjectAnalytics.ProjectSummary with {
      briefly "Project summary"
      described as {
        |The project summary being returned.
      }
    }
  } with {
    briefly "Project summary view"
    described as {
      |Read model view carrying the project summary projection.
    }
  }
  projector ProjectAnalytics is {
    inlet ProjectAnalyticsFromProject is type ProjectEvent
    outlet ProjectAnalyticsOut is type ProjectEvent
    updates repository ProjectContext.ProjectRepository
    record ProjectSummary is  {
      projectId: ProjectId with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      percentComplete: Natural with {
        briefly "Complete"
        described as {
          |Overall completion %.
        }
      }
      budgetVariance: Money with {
        briefly "Budget variance"
        described as {
          |Budget over/under.
        }
      }
      scheduleVariance: Integer with {
        briefly "Schedule variance"
        described as {
          |Days ahead/behind.
        }
      }
      openChangeOrders: Natural with {
        briefly "Open COs"
        described as {
          |Pending change orders.
        }
      }
    } with {
      briefly "Project summary"
      described as {
        |Project metrics summary.
      }
    }
    handler AnalyticsHandler is {
      on event Project.TaskProgressUpdated is {
        tell event Project.TaskProgressUpdated to repository ProjectContext.ProjectRepository
        do "Recalculate project completion percentage"
      }
      on event Project.BudgetUpdated is {
        tell event Project.BudgetUpdated to repository ProjectContext.ProjectRepository
        do "Update budget variance"
      }
      on event Project.ChangeOrderApproved is {
        tell event Project.ChangeOrderApproved to repository ProjectContext.ProjectRepository
        do "Update change order metrics"
      }
    } with {
      briefly "Maintains project analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Project analytics projections"
    described as {
      |Maintains project analytics data.
    }
  }
  // ---- Event publication for Project ----
  type ProjectEvent is one of {
    ProjectContext.Project.ProjectCreated,
    ProjectContext.Project.ProjectApproved,
    ProjectContext.Project.ProjectStarted,
    ProjectContext.Project.TaskAdded,
    ProjectContext.Project.TaskProgressUpdated,
    ProjectContext.Project.MilestoneCompleted,
    ProjectContext.Project.ChangeOrderSubmitted,
    ProjectContext.Project.ChangeOrderApproved,
    ProjectContext.Project.BudgetUpdated,
    ProjectContext.Project.ProjectPutOnHold,
    ProjectContext.Project.ProjectResumed,
    ProjectContext.Project.ProjectCompleted,
    ProjectContext.Project.ProjectCancelled
  } with {
    briefly "Project event alternation"
    described as {
      |Union of all Project events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ProjectEventSource as source is {
    outlet ProjectEvents is type ProjectEvent
    handler ProjectSourceHandler is {
      on event Project.ProjectCreated is {
        send event Project.ProjectCreated to outlet ProjectEvents
      }
      on event Project.ProjectApproved is {
        send event Project.ProjectApproved to outlet ProjectEvents
      }
      on event Project.ProjectStarted is {
        send event Project.ProjectStarted to outlet ProjectEvents
      }
      on event Project.TaskAdded is {
        send event Project.TaskAdded to outlet ProjectEvents
      }
      on event Project.TaskProgressUpdated is {
        send event Project.TaskProgressUpdated to outlet ProjectEvents
      }
      on event Project.MilestoneCompleted is {
        send event Project.MilestoneCompleted to outlet ProjectEvents
      }
      on event Project.ChangeOrderSubmitted is {
        send event Project.ChangeOrderSubmitted to outlet ProjectEvents
      }
      on event Project.ChangeOrderApproved is {
        send event Project.ChangeOrderApproved to outlet ProjectEvents
      }
      on event Project.BudgetUpdated is {
        send event Project.BudgetUpdated to outlet ProjectEvents
      }
      on event Project.ProjectPutOnHold is {
        send event Project.ProjectPutOnHold to outlet ProjectEvents
      }
      on event Project.ProjectResumed is {
        send event Project.ProjectResumed to outlet ProjectEvents
      }
      on event Project.ProjectCompleted is {
        send event Project.ProjectCompleted to outlet ProjectEvents
      }
      on event Project.ProjectCancelled is {
        send event Project.ProjectCancelled to outlet ProjectEvents
      }
      on other is {
        error "Unexpected message for source ProjectEventSource"
      }
    } with {
      briefly "Project source handler"
      described as {
        |Publishes Project events onto the outlet.
      }
    }
  } with {
    briefly "Project event source"
    described as {
      |Publishes Project entity events into the streaming topology.
    }
  }
  processor ProjectEventSink as sink is {
    inlet ProjectInlet is type ProjectEvent
    handler ProjectSinkHandler is {
      on event Project.ProjectCreated is {
        tell event Project.ProjectCreated to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectApproved is {
        tell event Project.ProjectApproved to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectStarted is {
        tell event Project.ProjectStarted to repository ProjectContext.ProjectRepository
      }
      on event Project.TaskAdded is {
        tell event Project.TaskAdded to repository ProjectContext.ProjectRepository
      }
      on event Project.TaskProgressUpdated is {
        tell event Project.TaskProgressUpdated to repository ProjectContext.ProjectRepository
      }
      on event Project.MilestoneCompleted is {
        tell event Project.MilestoneCompleted to repository ProjectContext.ProjectRepository
      }
      on event Project.ChangeOrderSubmitted is {
        tell event Project.ChangeOrderSubmitted to repository ProjectContext.ProjectRepository
      }
      on event Project.ChangeOrderApproved is {
        tell event Project.ChangeOrderApproved to repository ProjectContext.ProjectRepository
      }
      on event Project.BudgetUpdated is {
        tell event Project.BudgetUpdated to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectPutOnHold is {
        tell event Project.ProjectPutOnHold to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectResumed is {
        tell event Project.ProjectResumed to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectCompleted is {
        tell event Project.ProjectCompleted to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectCancelled is {
        tell event Project.ProjectCancelled to repository ProjectContext.ProjectRepository
      }
      on other is {
        error "Unexpected message for sink ProjectEventSink"
      }
    } with {
      briefly "Project sink handler"
      described as {
        |Persists Project events via the repository.
      }
    }
  } with {
    briefly "Project event sink"
    described as {
      |Receives Project events for persistence.
    }
  }
  connector ProjectEventFlow is {
    from outlet ProjectContext.ProjectEventSource.ProjectEvents to
      inlet ProjectContext.ProjectEventSink.ProjectInlet
  } with {
    briefly "Project event flow"
    described as {
      |Connects the Project source to its sink.
    }
  }
  processor ProjectEventSplit is {
    inlet ProjectEventSplitIn is type ProjectEvent
    outlet ProjectEventSplitToProjectRepository is type ProjectEvent
    outlet ProjectEventSplitToProjectAnalytics is type ProjectEvent
    handler ProjectEventSplitHandler is {
      on event Project.ProjectCreated is {
        send event Project.ProjectCreated to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectCreated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectCreated to entity ProjectContext.Project
      }
      on event Project.ProjectApproved is {
        send event Project.ProjectApproved to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectApproved to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectApproved to entity ProjectContext.Project
      }
      on event Project.ProjectStarted is {
        send event Project.ProjectStarted to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectStarted to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectStarted to entity ProjectContext.Project
      }
      on event Project.TaskAdded is {
        send event Project.TaskAdded to outlet ProjectEventSplitToProjectRepository
        send event Project.TaskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.TaskAdded to entity ProjectContext.Project
      }
      on event Project.TaskProgressUpdated is {
        send event Project.TaskProgressUpdated to outlet ProjectEventSplitToProjectRepository
        send event Project.TaskProgressUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.TaskProgressUpdated to entity ProjectContext.Project
      }
      on event Project.MilestoneCompleted is {
        send event Project.MilestoneCompleted to outlet ProjectEventSplitToProjectRepository
        send event Project.MilestoneCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.MilestoneCompleted to entity ProjectContext.Project
      }
      on event Project.ChangeOrderSubmitted is {
        send event Project.ChangeOrderSubmitted to outlet ProjectEventSplitToProjectRepository
        send event Project.ChangeOrderSubmitted to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ChangeOrderSubmitted to entity ProjectContext.Project
      }
      on event Project.ChangeOrderApproved is {
        send event Project.ChangeOrderApproved to outlet ProjectEventSplitToProjectRepository
        send event Project.ChangeOrderApproved to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ChangeOrderApproved to entity ProjectContext.Project
      }
      on event Project.BudgetUpdated is {
        send event Project.BudgetUpdated to outlet ProjectEventSplitToProjectRepository
        send event Project.BudgetUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.BudgetUpdated to entity ProjectContext.Project
      }
      on event Project.ProjectPutOnHold is {
        send event Project.ProjectPutOnHold to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectPutOnHold to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectPutOnHold to entity ProjectContext.Project
      }
      on event Project.ProjectResumed is {
        send event Project.ProjectResumed to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectResumed to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectResumed to entity ProjectContext.Project
      }
      on event Project.ProjectCompleted is {
        send event Project.ProjectCompleted to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectCompleted to entity ProjectContext.Project
      }
      on event Project.ProjectCancelled is {
        send event Project.ProjectCancelled to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectCancelled to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectCancelled to entity ProjectContext.Project
      }
      on other is {
        error "Unexpected message for processor ProjectEventSplit"
      }
    } with {
      briefly "Project event fan-out handler"
      described as {
        |Delivers each Project event to all of its consumers.
      }
    }
  } with {
    briefly "Project event fan-out"
    described as {
      |Fans Project events out to the repository and projectors.
    }
  }
  connector LinkProjectToProjectEventSplit is {
    from outlet ProjectContext.Project.ProjectEvents2 to
      inlet ProjectContext.ProjectEventSplit.ProjectEventSplitIn
  } with {
    briefly "LinkProjectToProjectEventSplit"
  }
  connector LinkProjectEventSplitToProjectRepository is {
    from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectRepository to
      inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProject
  } with {
    briefly "LinkProjectEventSplitToProjectRepository"
  }
  connector LinkProjectEventSplitToProjectAnalytics is {
    from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectAnalytics to
      inlet ProjectContext.ProjectAnalytics.ProjectAnalyticsFromProject
  } with {
    briefly "LinkProjectEventSplitToProjectAnalytics"
  }
  connector LinkProjectAnalyticsToProjectRepository is {
    from outlet ProjectContext.ProjectAnalytics.ProjectAnalyticsOut to
      inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProjectAnalytics
  } with {
    briefly "LinkProjectAnalyticsToProjectRepository"
  }
} with {
  briefly "Bounded context for construction projects"
  described as {
    | The ProjectContext is the bounded context for construction
    | project management including planning and tracking.
  }
}
