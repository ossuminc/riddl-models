// Bid Management - Bid Entity
entity Bid as flow is {
  type BidCommand is one of {
    Bid.CreateBid or Bid.SubmitProposal or Bid.ReviseProposal or Bid.WithdrawBid or Bid.BeginReview or Bid.ScoreBid or Bid.ShortlistBid or Bid.AwardBid or Bid.RejectBid
  } with {
    briefly "Bid command alternation"
    described as {
      |Commands accepted by the Bid entity.
    }
  }
  inlet BidCommands is type BidCommand  outlet BidEvents2 is type BidEvent
  query GetBid replies result BidResult is  {
    bidId: BidId with {
      briefly "ID"
      described as {
        |Identifier of the Bid to retrieve.
      }
    }
  } with {
    briefly "Get Bid"
    described as {
      |Retrieve Bid data by identifier.
    }
  }
  result BidResult is  {
    bidId: BidId with {
      briefly "Bid addressed"
      described as {
        |Which bid this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    bidData: Bid.DraftBidData with {
      briefly "Bid data"
      described as {
        |The requested Bid data.
      }
    }
  } with {
    briefly "Bid result"
    described as {
      |Result carrying the requested Bid data.
    }
  }
  // Commands
  command CreateBid is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |New bid identifier.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP being responded to.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Bidding contractor.
      }
    }
  } with {
    briefly "Create bid"
    described as {
      |Creates a new bid draft.
    }
  }
  command SubmitProposal is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid identifier.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Bid proposal details.
      }
    }
  } with {
    briefly "Submit proposal"
    described as {
      |Submits bid proposal.
    }
  }
  command ReviseProposal is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid identifier.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Revised proposal.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Revision reason.
      }
    }
  } with {
    briefly "Revise proposal"
    described as {
      |Revises submitted proposal.
    }
  }
  command WithdrawBid is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid to withdraw.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Withdrawal reason.
      }
    }
  } with {
    briefly "Withdraw bid"
    described as {
      |Withdraws bid from consideration.
    }
  }
  command BeginReview is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid to review.
      }
    }
    reviewer: String(1,100) with {
      briefly "Reviewer"
      described as {
        |Assigned reviewer.
      }
    }
  } with {
    briefly "Begin review"
    described as {
      |Starts bid review process.
    }
  }
  command ScoreBid is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid to score.
      }
    }
    score: BidScore with {
      briefly "Score"
      described as {
        |Evaluation score.
      }
    }
  } with {
    briefly "Score bid"
    described as {
      |Records bid evaluation score.
    }
  }
  command ShortlistBid is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid to shortlist.
      }
    }
    shortlistedBy: String(1,100) with {
      briefly "By"
      described as {
        |Who shortlisted.
      }
    }
  } with {
    briefly "Shortlist bid"
    described as {
      |Adds bid to shortlist.
    }
  }
  command AwardBid is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid to award.
      }
    }
    awardedBy: String(1,100) with {
      briefly "By"
      described as {
        |Who awarded.
      }
    }
    notes: String(1,1000)? with {
      briefly "Notes"
      described as {
        |Award notes.
      }
    }
  } with {
    briefly "Award bid"
    described as {
      |Awards contract to bidder.
    }
  }
  command RejectBid is  {
    bidId: BidId with {
      briefly "Bid ID"
      described as {
        |Bid to reject.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Rejection reason.
      }
    }
    rejectedBy: String(1,100) with {
      briefly "By"
      described as {
        |Who rejected.
      }
    }
  } with {
    briefly "Reject bid"
    described as {
      |Rejects bid from consideration.
    }
  }
  // Events
  event BidCreated is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Bid was created"
    described as {
      |Emitted when bid draft is created.
    }
  }
  event ProposalSubmitted is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Submitted proposal.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Proposal was submitted"
    described as {
      |Emitted when proposal is submitted.
    }
  }
  event ProposalRevised is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Revised proposal.
      }
    }
    revisedAt: TimeStamp with {
      briefly "Revised"
      described as {
        |Revision time.
      }
    }
  } with {
    briefly "Proposal was revised"
    described as {
      |Emitted when proposal is revised.
    }
  }
  event BidWithdrawn is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Withdrawal reason.
      }
    }
    withdrawnAt: TimeStamp with {
      briefly "Withdrawn"
      described as {
        |Withdrawal time.
      }
    }
  } with {
    briefly "Bid was withdrawn"
    described as {
      |Emitted when bid is withdrawn.
    }
  }
  event ReviewBegan is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    reviewer: String(1,100) with {
      briefly "Reviewer"
      described as {
        |Assigned reviewer.
      }
    }
    beganAt: TimeStamp with {
      briefly "Began"
      described as {
        |Review start time.
      }
    }
  } with {
    briefly "Review began"
    described as {
      |Emitted when bid review starts.
    }
  }
  event BidScored is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    score: BidScore with {
      briefly "Score"
      described as {
        |Evaluation score.
      }
    }
  } with {
    briefly "Bid was scored"
    described as {
      |Emitted when bid is scored.
    }
  }
  event BidShortlisted is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    shortlistedAt: TimeStamp with {
      briefly "Shortlisted"
      described as {
        |Shortlist time.
      }
    }
  } with {
    briefly "Bid was shortlisted"
    described as {
      |Emitted when bid is shortlisted.
    }
  }
  event BidAwarded is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    awardedAt: TimeStamp with {
      briefly "Awarded"
      described as {
        |Award time.
      }
    }
  } with {
    briefly "Bid was awarded"
    described as {
      |Emitted when bid is awarded.
    }
  }
  event BidRejected is  {
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Rejection reason.
      }
    }
    rejectedAt: TimeStamp with {
      briefly "Rejected"
      described as {
        |Rejection time.
      }
    }
  } with {
    briefly "Bid was rejected"
    described as {
      |Emitted when bid is rejected.
    }
  }
  // State Records
  record DraftBidData is  {
    stateValue: BidStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Draft bid data"
    described as {
      |State data for draft bid.
    }
  }
  record SubmittedBidData is  {
    stateValue: BidStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Submitted proposal.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Submitted bid data"
    described as {
      |State data for submitted bid.
    }
  }
  record UnderReviewBidData is  {
    stateValue: BidStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Proposal.
      }
    }
    reviewer: String(1,100) with {
      briefly "Reviewer"
      described as {
        |Assigned reviewer.
      }
    }
    updatedScore: BidScore? with {
      briefly "Score"
      described as {
        |Evaluation score.
      }
    }
    reviewBeganAt: TimeStamp with {
      briefly "Began"
      described as {
        |Review start.
      }
    }
  } with {
    briefly "Under review bid data"
    described as {
      |State data for bid under review.
    }
  }
  record ShortlistedBidData is  {
    stateValue: BidStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Proposal.
      }
    }
    score: BidScore with {
      briefly "Score"
      described as {
        |Evaluation score.
      }
    }
    shortlistedAt: TimeStamp with {
      briefly "Shortlisted"
      described as {
        |Shortlist time.
      }
    }
  } with {
    briefly "Shortlisted bid data"
    described as {
      |State data for shortlisted bid.
    }
  }
  record AwardedBidData is  {
    stateValue: BidStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    proposal: BidProposal with {
      briefly "Proposal"
      described as {
        |Winning proposal.
      }
    }
    awardedAt: TimeStamp with {
      briefly "Awarded"
      described as {
        |Award time.
      }
    }
  } with {
    briefly "Awarded bid data"
    described as {
      |State data for awarded bid.
    }
  }
  record RejectedBidData is  {
    stateValue: BidStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Rejection reason.
      }
    }
    rejectedAt: TimeStamp with {
      briefly "Rejected"
      described as {
        |Rejection time.
      }
    }
  } with {
    briefly "Rejected bid data"
    described as {
      |State data for rejected bid.
    }
  }
  record WithdrawnBidData is  {
    stateValue: BidStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    bidId: BidId with {
      briefly "Bid"
      described as {
        |Bid ID.
      }
    }
    rfpId: UUID with {
      briefly "RFP"
      described as {
        |RFP ID.
      }
    }
    contractorId: ContractorId with {
      briefly "Contractor"
      described as {
        |Contractor ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Withdrawal reason.
      }
    }
    withdrawnAt: TimeStamp with {
      briefly "Withdrawn"
      described as {
        |Withdrawal time.
      }
    }
  } with {
    briefly "Withdrawn bid data"
    described as {
      |State data for withdrawn bid.
    }
  }
  // States
  initial state DraftState of record Bid.DraftBidData is {
    initial handler DraftStateInitHandler is {
      on query GetBid is {
        let bidResult: type BidResult = prompt("read the bid from the store")
        reply bidResult
      }
      on init is {
        set state DraftState to "initialize from prior event"
        set field DraftBidData.stateValue to "Draft"
      }
    } with {
      briefly "DraftState init handler"
      described as {
        |Initializes the DraftState state.
      }
    }
  } with {
    briefly "DraftState state"
    described as {
      |The DraftState state of the Bid.
    }
  }
  state SubmittedState of record Bid.SubmittedBidData is {
    initial handler SubmittedStateInitHandler is {
      on init is {
        set state SubmittedState to "initialize from prior event"
        set field SubmittedBidData.stateValue to "Submitted"
      }
    } with {
      briefly "SubmittedState init handler"
      described as {
        |Initializes the SubmittedState state.
      }
    }
  } with {
    briefly "SubmittedState state"
    described as {
      |The SubmittedState state of the Bid.
    }
  }
  state UnderReviewState of record Bid.UnderReviewBidData is {
    initial handler UnderReviewStateInitHandler is {
      on init is {
        set state UnderReviewState to "initialize from prior event"
        set field UnderReviewBidData.stateValue to "UnderReview"
      }
    } with {
      briefly "UnderReviewState init handler"
      described as {
        |Initializes the UnderReviewState state.
      }
    }
  } with {
    briefly "UnderReviewState state"
    described as {
      |The UnderReviewState state of the Bid.
    }
  }
  state ShortlistedState of record Bid.ShortlistedBidData is {
    initial handler ShortlistedStateInitHandler is {
      on init is {
        set state ShortlistedState to "initialize from prior event"
        set field ShortlistedBidData.stateValue to "Shortlisted"
      }
    } with {
      briefly "ShortlistedState init handler"
      described as {
        |Initializes the ShortlistedState state.
      }
    }
  } with {
    briefly "ShortlistedState state"
    described as {
      |The ShortlistedState state of the Bid.
    }
  }
  state AwardedState of record Bid.AwardedBidData is {
    initial handler AwardedStateInitHandler is {
      on init is {
        set state AwardedState to "initialize from prior event"
        set field AwardedBidData.stateValue to "Awarded"
      }
    } with {
      briefly "AwardedState init handler"
      described as {
        |Initializes the AwardedState state.
      }
    }
  } with {
    briefly "AwardedState state"
    described as {
      |The AwardedState state of the Bid.
    }
  }
  state RejectedState of record Bid.RejectedBidData is {
    initial handler RejectedStateInitHandler is {
      on init is {
        set state RejectedState to "initialize from prior event"
        set field RejectedBidData.stateValue to "Rejected"
      }
    } with {
      briefly "RejectedState init handler"
      described as {
        |Initializes the RejectedState state.
      }
    }
  } with {
    briefly "RejectedState state"
    described as {
      |The RejectedState state of the Bid.
    }
  }
  state WithdrawnState of record Bid.WithdrawnBidData is {
    initial handler WithdrawnStateInitHandler is {
      on init is {
        set state WithdrawnState to "initialize from prior event"
        set field WithdrawnBidData.stateValue to "Withdrawn"
      }
    } with {
      briefly "WithdrawnState init handler"
      described as {
        |Initializes the WithdrawnState state.
      }
    }
  } with {
    briefly "WithdrawnState state"
    described as {
      |The WithdrawnState state of the Bid.
    }
  }
  // Handler
  handler BidHandler is {
    on createBid: command CreateBid is {
      morph entity BidContext.Bid to state BidContext.Bid.DraftState with record Bid.DraftBidData(bidId = createBid.bidId, rfpId = createBid.rfpId, contractorId = createBid.contractorId, stateValue = prompt("the state value of this draft bid data"), createdAt = prompt("the created at of this draft bid data"))
      tell event BidCreated(bidId = createBid.bidId, rfpId = createBid.rfpId, contractorId = createBid.contractorId, createdAt = prompt("the created at of this bid created")) to entity BidContext.Bid
    }
    on submitProposal: command SubmitProposal is {
      morph entity BidContext.Bid to state BidContext.Bid.SubmittedState with record Bid.SubmittedBidData(bidId = submitProposal.bidId, proposal = submitProposal.proposal, stateValue = prompt("the state value of this submitted bid data"), rfpId = prompt("the rfp id of this submitted bid data"), contractorId = prompt("the contractor id of this submitted bid data"), submittedAt = prompt("the submitted at of this submitted bid data"))
      tell event ProposalSubmitted(bidId = submitProposal.bidId, proposal = submitProposal.proposal, submittedAt = prompt("the submitted at of this proposal submitted")) to entity BidContext.Bid
    }
    on reviseProposal: command ReviseProposal is {
      tell event ProposalRevised(bidId = reviseProposal.bidId, proposal = reviseProposal.proposal, revisedAt = prompt("the revised at of this proposal revised")) to entity BidContext.Bid
    }
    on withdrawBid: command WithdrawBid is {
      morph entity BidContext.Bid to state BidContext.Bid.WithdrawnState with record Bid.WithdrawnBidData(bidId = withdrawBid.bidId, reason = withdrawBid.reason, stateValue = prompt("the state value of this withdrawn bid data"), rfpId = prompt("the rfp id of this withdrawn bid data"), contractorId = prompt("the contractor id of this withdrawn bid data"), withdrawnAt = prompt("the withdrawn at of this withdrawn bid data"))
      tell event BidWithdrawn(bidId = withdrawBid.bidId, reason = withdrawBid.reason, withdrawnAt = prompt("the withdrawn at of this bid withdrawn")) to entity BidContext.Bid
    }
    on beginReview: command BeginReview is {
      morph entity BidContext.Bid to state BidContext.Bid.UnderReviewState with record Bid.UnderReviewBidData(bidId = beginReview.bidId, reviewer = beginReview.reviewer, stateValue = prompt("the state value of this under review bid data"), rfpId = prompt("the rfp id of this under review bid data"), contractorId = prompt("the contractor id of this under review bid data"), proposal = prompt("the proposal of this under review bid data"), updatedScore = empty, reviewBeganAt = prompt("the review began at of this under review bid data"))
      tell event ReviewBegan(bidId = beginReview.bidId, reviewer = beginReview.reviewer, beganAt = prompt("the began at of this review began")) to entity BidContext.Bid
    }
    on scoreBid: command ScoreBid is {
      tell event BidScored(bidId = scoreBid.bidId, score = scoreBid.score) to entity BidContext.Bid
    }
    on shortlistBid: command ShortlistBid is {
      morph entity BidContext.Bid to state BidContext.Bid.ShortlistedState with record Bid.ShortlistedBidData(bidId = shortlistBid.bidId, stateValue = prompt("the state value of this shortlisted bid data"), rfpId = prompt("the rfp id of this shortlisted bid data"), contractorId = prompt("the contractor id of this shortlisted bid data"), proposal = prompt("the proposal of this shortlisted bid data"), score = prompt("the score of this shortlisted bid data"), shortlistedAt = prompt("the shortlisted at of this shortlisted bid data"))
      tell event BidShortlisted(bidId = shortlistBid.bidId, shortlistedAt = prompt("the shortlisted at of this bid shortlisted")) to entity BidContext.Bid
    }
    on awardBid: command AwardBid is {
      morph entity BidContext.Bid to state BidContext.Bid.AwardedState with record Bid.AwardedBidData(bidId = awardBid.bidId, stateValue = prompt("the state value of this awarded bid data"), rfpId = prompt("the rfp id of this awarded bid data"), contractorId = prompt("the contractor id of this awarded bid data"), proposal = prompt("the proposal of this awarded bid data"), awardedAt = prompt("the awarded at of this awarded bid data"))
      tell event BidAwarded(bidId = awardBid.bidId, awardedAt = prompt("the awarded at of this bid awarded")) to entity BidContext.Bid
    }
    on rejectBid: command RejectBid is {
      morph entity BidContext.Bid to state BidContext.Bid.RejectedState with record Bid.RejectedBidData(bidId = rejectBid.bidId, reason = rejectBid.reason, stateValue = prompt("the state value of this rejected bid data"), rfpId = prompt("the rfp id of this rejected bid data"), contractorId = prompt("the contractor id of this rejected bid data"), rejectedAt = prompt("the rejected at of this rejected bid data"))
      tell event BidRejected(bidId = rejectBid.bidId, reason = rejectBid.reason, rejectedAt = prompt("the rejected at of this bid rejected")) to entity BidContext.Bid
    }
    on bidAwarded: event BidAwarded is {
      do "apply BidAwarded to the bid so it can be persisted and replayed"
    }
    on bidCreated: event BidCreated is {
      do "apply BidCreated to the bid so it can be persisted and replayed"
    }
    on bidRejected: event BidRejected is {
      do "apply BidRejected to the bid so it can be persisted and replayed"
    }
    on bidScored: event BidScored is {
      do "apply BidScored to the bid so it can be persisted and replayed"
    }
    on bidShortlisted: event BidShortlisted is {
      do "apply BidShortlisted to the bid so it can be persisted and replayed"
    }
    on bidWithdrawn: event BidWithdrawn is {
      do "apply BidWithdrawn to the bid so it can be persisted and replayed"
    }
    on proposalRevised: event ProposalRevised is {
      do "apply ProposalRevised to the bid so it can be persisted and replayed"
    }
    on proposalSubmitted: event ProposalSubmitted is {
      do "apply ProposalSubmitted to the bid so it can be persisted and replayed"
    }
    on reviewBegan: event ReviewBegan is {
      do "apply ReviewBegan to the bid so it can be persisted and replayed"
    }
  } with {
    briefly "Processes bid commands"
    described as {
      | Handles bid lifecycle including creation,
      | submission, evaluation, and award.
    }
  }
} with {
  briefly "Bid aggregate"
  described as {
    | The Bid entity manages construction bids
    | from creation through evaluation and award.
  }
}
