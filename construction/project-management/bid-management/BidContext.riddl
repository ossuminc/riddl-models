// Bid Management - Bid Context
context BidContext is {
  adaptor FromContractService from context ContractService is { 
    handler FromContractServiceHandler is {
      on event ContractService.ContractGenerated is {
        do "the model receives contract generated"
      }
      on other is {
        error "Unexpected message for adaptor FromContractService"
      }
    } with {
      briefly "from contract service"
      described as {
        |Carries messages from the external ContractService.
      }
    }
  } with {
    briefly "ContractService integration"
    described as {
      |The model's side of the ContractService conversation.
    }
  }
  adaptor ToContractService to context ContractService is { 
    handler ToContractServiceHandler is {
      on command ContractService.GenerateContract is {
        do "the model sends generate contract"
      }
      on other is {
        error "Unexpected message for adaptor ToContractService"
      }
    } with {
      briefly "to contract service"
      described as {
        |Carries messages to the external ContractService.
      }
    }
  } with {
    briefly "ContractService integration"
    described as {
      |The model's side of the ContractService conversation.
    }
  }
  adaptor FromContractorService from context ContractorService is { 
    handler FromContractorServiceHandler is {
      on event ContractorService.ContractorQualified is {
        do "the model receives contractor qualified"
      }
      on other is {
        error "Unexpected message for adaptor FromContractorService"
      }
    } with {
      briefly "from contractor service"
      described as {
        |Carries messages from the external ContractorService.
      }
    }
    handler ContractorEvents is {
      on event ContractorService.ContractorRegistered is {
        do "Store contractor information for bidding"
      }
      on other is {
        error "Unexpected message for adaptor ContractorAdapter"
      }
    } with {
      briefly "Handles contractor events"
      described as {
        |Processes contractor registrations.
      }
    }
  } with {
    briefly "ContractorService integration"
    described as {
      |The model's side of the ContractorService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.NotifyAwardDecision is {
        do "the model sends notify award decision"
      }
      on command NotificationService.NotifyBidReceived is {
        do "the model sends notify bid received"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromProjectService from context ProjectService is { 
    handler FromProjectServiceHandler is {
      on event ProjectService.RFPCancelled is {
        do "the model receives rfp cancelled"
      }
      on event ProjectService.RFPClosed is {
        do "the model receives rfp closed"
      }
      on other is {
        error "Unexpected message for adaptor FromProjectService"
      }
    } with {
      briefly "from project service"
      described as {
        |Carries messages from the external ProjectService.
      }
    }
    handler ProjectEvents is {
      on event ProjectService.RFPPublished is {
        do "Create bid opportunities for contractors"
      }
      on other is {
        error "Unexpected message for adaptor ProjectAdapter"
      }
    } with {
      briefly "Handles project events"
      described as {
        |Processes RFP publications.
      }
    }
  } with {
    briefly "ProjectService integration"
    described as {
      |The model's side of the ProjectService conversation.
    }
  }
  include "types.riddl"
  include "Bid.riddl"
  // Adaptor for contractor service integration
  // Adaptor for project service integration
  // Repository for bid persistence
  repository BidRepository as merge is {
    inlet BidRepositoryFromBid is type BidEvent    inlet BidRepositoryFromBidAnalytics is type BidEvent    outlet BidRepositoryResponses is type Bid.BidResult
    record StoredBid is  {
      bidId: BidId with {
        briefly "bidId"
        described as {
          |The bidId column of the stored bid row.
        }
      }
      contractorId: ContractorId with {
        briefly "contractorId"
        described as {
          |The contractorId column of the stored bid row.
        }
      }
      rfpId: UUID with {
        briefly "rfpId"
        described as {
          |The rfpId column of the stored bid row.
        }
      }
    } with {
      briefly "Stored bid row"
      described as {
        |The persistence shape of bid data as this repository stores it.
      }
    }
    schema BidData is relational
      of bids as type StoredBid
        index on field StoredBid.bidId
        index on field StoredBid.rfpId
        index on field StoredBid.contractorId
 with {
      briefly "Bid data schema"
      described as {
        |The relational schema holding bid data for the BidRepository.
      }
    }
    handler BidPersistence is {
      on query GetRFPSummary is {
        do "read the rfp summary projection"
        reply result RFPSummaryView
      }
      on createBid: command Bid.CreateBid is {
        tell event Bid.BidCreated(bidId = createBid.bidId, rfpId = createBid.rfpId, contractorId = createBid.contractorId) to entity BidContext.Bid
        do "Store new bid record"
      }
      on submitProposal: command Bid.SubmitProposal is {
        tell event Bid.ProposalSubmitted(bidId = submitProposal.bidId, proposal = submitProposal.proposal) to entity BidContext.Bid
        do "Update bid with proposal"
      }
      on command Bid.ScoreBid is {
        do "Store evaluation scores"
      }
      on command Bid.AwardBid is {
        do "Update bid as awarded"
      }
      on rejectBid: command Bid.RejectBid is {
        tell event Bid.BidRejected(bidId = rejectBid.bidId, reason = rejectBid.reason) to entity BidContext.Bid
        do "Update bid as rejected"
      }
    } with {
      briefly "Persists bid commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Bid data persistence"
    described as {
      | The BidRepository provides persistent storage for
      | bids, proposals, and evaluation scores.
    }
  }
  // Projector for bid analytics
  query GetRFPSummary is  {
    rFPSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which rfp summary to retrieve.
      }
    }
  } with {
    briefly "Get rfp summary"
    described as {
      |Retrieves the rfp summary projection.
    }
  }
  result RFPSummaryView is  {
    rFPSummary: BidAnalytics.RFPSummary with {
      briefly "Rfp summary"
      described as {
        |The rfp summary being returned.
      }
    }
  } with {
    briefly "Rfp summary view"
    described as {
      |Read model view carrying the rfp summary projection.
    }
  }
  projector BidAnalytics as flow is {
    updates repository BidContext.BidRepository
    inlet BidAnalyticsFromBid is type BidEvent    outlet BidAnalyticsOut is type BidEvent
    record RFPSummary is  {
      rfpId: UUID with {
        briefly "RFP"
        described as {
          |RFP ID.
        }
      }
      bidCount: Natural with {
        briefly "Bids"
        described as {
          |Number of bids.
        }
      }
      averagePrice: Money with {
        briefly "Avg price"
        described as {
          |Average bid price.
        }
      }
      lowestPrice: Money with {
        briefly "Low price"
        described as {
          |Lowest bid price.
        }
      }
      highestPrice: Money with {
        briefly "High price"
        described as {
          |Highest bid price.
        }
      }
    } with {
      briefly "RFP summary"
      described as {
        |Bid summary for an RFP.
      }
    }
    handler AnalyticsHandler is {
      on proposalSubmitted: event Bid.ProposalSubmitted is {
        tell proposalSubmitted to repository BidContext.BidRepository
        do "Update RFP bid statistics"
      }
      on bidWithdrawn: event Bid.BidWithdrawn is {
        tell bidWithdrawn to repository BidContext.BidRepository
        do "Update RFP bid count"
      }
      on bidAwarded: event Bid.BidAwarded is {
        tell bidAwarded to repository BidContext.BidRepository
        do "Mark RFP as awarded"
      }
    } with {
      briefly "Maintains bid analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Bid analytics projections"
    described as {
      |Maintains bid analytics data.
    }
  }
  // ---- Event publication for Bid ----
  type BidEvent is one of {
    BidContext.Bid.BidCreated or BidContext.Bid.ProposalSubmitted or BidContext.Bid.ProposalRevised or BidContext.Bid.BidWithdrawn or BidContext.Bid.ReviewBegan or BidContext.Bid.BidScored or BidContext.Bid.BidShortlisted or BidContext.Bid.BidAwarded or BidContext.Bid.BidRejected
  } with {
    briefly "Bid event alternation"
    described as {
      |Union of all Bid events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BidEventSource as source is {
    outlet BidEvents is type BidEvent
    handler BidSourceHandler is {
      on bidCreated: event Bid.BidCreated is {
        send bidCreated to outlet BidEvents
      }
      on proposalSubmitted: event Bid.ProposalSubmitted is {
        send proposalSubmitted to outlet BidEvents
      }
      on proposalRevised: event Bid.ProposalRevised is {
        send proposalRevised to outlet BidEvents
      }
      on bidWithdrawn: event Bid.BidWithdrawn is {
        send bidWithdrawn to outlet BidEvents
      }
      on reviewBegan: event Bid.ReviewBegan is {
        send reviewBegan to outlet BidEvents
      }
      on bidScored: event Bid.BidScored is {
        send bidScored to outlet BidEvents
      }
      on bidShortlisted: event Bid.BidShortlisted is {
        send bidShortlisted to outlet BidEvents
      }
      on bidAwarded: event Bid.BidAwarded is {
        send bidAwarded to outlet BidEvents
      }
      on bidRejected: event Bid.BidRejected is {
        send bidRejected to outlet BidEvents
      }
      on other is {
        error "Unexpected message for source BidEventSource"
      }
    } with {
      briefly "Bid source handler"
      described as {
        |Publishes Bid events onto the outlet.
      }
    }
  } with {
    briefly "Bid event source"
    described as {
      |Publishes Bid entity events into the streaming topology.
    }
  }
  processor BidEventSink as sink is {
    inlet BidInlet is type BidEvent    handler BidSinkHandler is {
      on bidCreated: event Bid.BidCreated is {
        tell bidCreated to repository BidContext.BidRepository
      }
      on proposalSubmitted: event Bid.ProposalSubmitted is {
        tell proposalSubmitted to repository BidContext.BidRepository
      }
      on proposalRevised: event Bid.ProposalRevised is {
        tell proposalRevised to repository BidContext.BidRepository
      }
      on bidWithdrawn: event Bid.BidWithdrawn is {
        tell bidWithdrawn to repository BidContext.BidRepository
      }
      on reviewBegan: event Bid.ReviewBegan is {
        tell reviewBegan to repository BidContext.BidRepository
      }
      on bidScored: event Bid.BidScored is {
        tell bidScored to repository BidContext.BidRepository
      }
      on bidShortlisted: event Bid.BidShortlisted is {
        tell bidShortlisted to repository BidContext.BidRepository
      }
      on bidAwarded: event Bid.BidAwarded is {
        tell bidAwarded to repository BidContext.BidRepository
      }
      on bidRejected: event Bid.BidRejected is {
        tell bidRejected to repository BidContext.BidRepository
      }
      on other is {
        error "Unexpected message for sink BidEventSink"
      }
    } with {
      briefly "Bid sink handler"
      described as {
        |Persists Bid events via the repository.
      }
    }
  } with {
    briefly "Bid event sink"
    described as {
      |Receives Bid events for persistence.
    }
  }
  connector BidEventFlow is from outlet BidContext.BidEventSource.BidEvents to inlet BidContext.BidEventSink.BidInlet with {
    briefly "Bid event flow"
    described as {
      |Connects the Bid source to its sink.
    }
  }
  processor BidEventSplit as split is {
    inlet BidEventSplitIn is type BidEvent    outlet BidEventSplitToBidRepository is type BidEvent
    outlet BidEventSplitToBidAnalytics is type BidEvent
    handler BidEventSplitHandler is {
      on bidCreated: event Bid.BidCreated is {
        send bidCreated to outlet BidEventSplitToBidRepository
        send bidCreated to outlet BidEventSplitToBidAnalytics
        tell bidCreated to entity BidContext.Bid
      }
      on proposalSubmitted: event Bid.ProposalSubmitted is {
        send proposalSubmitted to outlet BidEventSplitToBidRepository
        send proposalSubmitted to outlet BidEventSplitToBidAnalytics
        tell proposalSubmitted to entity BidContext.Bid
      }
      on proposalRevised: event Bid.ProposalRevised is {
        send proposalRevised to outlet BidEventSplitToBidRepository
        send proposalRevised to outlet BidEventSplitToBidAnalytics
        tell proposalRevised to entity BidContext.Bid
      }
      on bidWithdrawn: event Bid.BidWithdrawn is {
        send bidWithdrawn to outlet BidEventSplitToBidRepository
        send bidWithdrawn to outlet BidEventSplitToBidAnalytics
        tell bidWithdrawn to entity BidContext.Bid
      }
      on reviewBegan: event Bid.ReviewBegan is {
        send reviewBegan to outlet BidEventSplitToBidRepository
        send reviewBegan to outlet BidEventSplitToBidAnalytics
        tell reviewBegan to entity BidContext.Bid
      }
      on bidScored: event Bid.BidScored is {
        send bidScored to outlet BidEventSplitToBidRepository
        send bidScored to outlet BidEventSplitToBidAnalytics
        tell bidScored to entity BidContext.Bid
      }
      on bidShortlisted: event Bid.BidShortlisted is {
        send bidShortlisted to outlet BidEventSplitToBidRepository
        send bidShortlisted to outlet BidEventSplitToBidAnalytics
        tell bidShortlisted to entity BidContext.Bid
      }
      on bidAwarded: event Bid.BidAwarded is {
        send bidAwarded to outlet BidEventSplitToBidRepository
        send bidAwarded to outlet BidEventSplitToBidAnalytics
        tell bidAwarded to entity BidContext.Bid
      }
      on bidRejected: event Bid.BidRejected is {
        send bidRejected to outlet BidEventSplitToBidRepository
        send bidRejected to outlet BidEventSplitToBidAnalytics
        tell bidRejected to entity BidContext.Bid
      }
      on other is {
        error "Unexpected message for processor BidEventSplit"
      }
    } with {
      briefly "Bid event fan-out handler"
      described as {
        |Delivers each Bid event to all of its consumers.
      }
    }
  } with {
    briefly "Bid event fan-out"
    described as {
      |Fans Bid events out to the repository and projectors.
    }
  }
  connector 'BidEvent Stream' is from outlet BidContext.Bid.BidEvents2 to inlet BidContext.BidEventSplit.BidEventSplitIn with {
    briefly "Bid events, fanned out to storage and read models"
  }
  connector 'BidEvent Storage' is from outlet BidContext.BidEventSplit.BidEventSplitToBidRepository to inlet BidContext.BidRepository.BidRepositoryFromBid with {
    briefly "Bid events on their way to storage"
  }
  connector 'BidAnalytics Feed' is from outlet BidContext.BidEventSplit.BidEventSplitToBidAnalytics to inlet BidContext.BidAnalytics.BidAnalyticsFromBid with {
    briefly "Bid events feeding the BidAnalytics projection"
  }
  connector 'BidAnalytics Storage' is from outlet BidContext.BidAnalytics.BidAnalyticsOut to inlet BidContext.BidRepository.BidRepositoryFromBidAnalytics with {
    briefly "The BidAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for bid management"
  described as {
    | The BidContext is the bounded context for construction
    | bid management including proposals and evaluations.
  }
}
