// Bid Management - Bid Context
context BidContext is {
  include "types.riddl"
  include "Bid.riddl"
  // Adaptor for contractor service integration
  adaptor ContractorAdapter from context ContractorService is { 
    handler ContractorEvents is {
      on event ContractorService.ContractorRegistered is {
        do "Store contractor information for bidding"
      }
      on other is {
        error "Unexpected message for adaptor ContractorAdapter"
      }
    } with {
      briefly "Handles contractor events"
      described as {
        |Processes contractor registrations.
      }
    }
  } with {
    briefly "Contractor service integration"
    described as {
      |Receives contractor data.
    }
  }
  // Adaptor for project service integration
  adaptor ProjectAdapter from context ProjectService is { 
    handler ProjectEvents is {
      on event ProjectService.RFPPublished is {
        do "Create bid opportunities for contractors"
      }
      on other is {
        error "Unexpected message for adaptor ProjectAdapter"
      }
    } with {
      briefly "Handles project events"
      described as {
        |Processes RFP publications.
      }
    }
  } with {
    briefly "Project service integration"
    described as {
      |Receives project and RFP data.
    }
  }
  // Repository for bid persistence
  repository BidRepository is {
    inlet BidRepositoryFromBid is type BidEvent
    inlet BidRepositoryFromBidAnalytics is type BidEvent
    outlet BidRepositoryResponses is type Bid.BidResult
    schema BidData is relational
      of bids as type Bid
        index on field Bid.bidId
        index on field Bid.rfpId
        index on field Bid.contractorId
      with {
      briefly "Bid data schema"
      described as {
        |The relational schema holding bid data for the BidRepository.
      }
    }

    handler BidPersistence is {
      on command Bid.CreateBid is {
        tell event Bid.BidCreated to entity BidContext.Bid
        do "Store new bid record"
      }
      on command Bid.SubmitProposal is {
        tell event Bid.ProposalSubmitted to entity BidContext.Bid
        do "Update bid with proposal"
      }
      on command Bid.ScoreBid is {
        do "Store evaluation scores"
      }
      on command Bid.AwardBid is {
        do "Update bid as awarded"
      }
      on command Bid.RejectBid is {
        tell event Bid.BidRejected to entity BidContext.Bid
        do "Update bid as rejected"
      }
    } with {
      briefly "Persists bid commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Bid data persistence"
    described as {
      | The BidRepository provides persistent storage for
      | bids, proposals, and evaluation scores.
    }
  }
  // Projector for bid analytics
  projector BidAnalytics is {
    inlet BidAnalyticsFromBid is type BidEvent
    outlet BidAnalyticsOut is type BidEvent
    updates repository BidContext.BidRepository
    record RFPSummary is  {
      rfpId: UUID with {
        briefly "RFP"
        described as {
          |RFP ID.
        }
      }
      bidCount: Natural with {
        briefly "Bids"
        described as {
          |Number of bids.
        }
      }
      averagePrice: Money with {
        briefly "Avg price"
        described as {
          |Average bid price.
        }
      }
      lowestPrice: Money with {
        briefly "Low price"
        described as {
          |Lowest bid price.
        }
      }
      highestPrice: Money with {
        briefly "High price"
        described as {
          |Highest bid price.
        }
      }
    } with {
      briefly "RFP summary"
      described as {
        |Bid summary for an RFP.
      }
    }
    handler AnalyticsHandler is {
      on event Bid.ProposalSubmitted is {
        tell event Bid.ProposalSubmitted to repository BidContext.BidRepository
        do "Update RFP bid statistics"
      }
      on event Bid.BidWithdrawn is {
        tell event Bid.BidWithdrawn to repository BidContext.BidRepository
        do "Update RFP bid count"
      }
      on event Bid.BidAwarded is {
        tell event Bid.BidAwarded to repository BidContext.BidRepository
        do "Mark RFP as awarded"
      }
    } with {
      briefly "Maintains bid analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Bid analytics projections"
    described as {
      |Maintains bid analytics data.
    }
  }
  // ---- Event publication for Bid ----
  type BidEvent is one of {
    BidContext.Bid.BidCreated,
    BidContext.Bid.ProposalSubmitted,
    BidContext.Bid.ProposalRevised,
    BidContext.Bid.BidWithdrawn,
    BidContext.Bid.ReviewBegan,
    BidContext.Bid.BidScored,
    BidContext.Bid.BidShortlisted,
    BidContext.Bid.BidAwarded,
    BidContext.Bid.BidRejected
  } with {
    briefly "Bid event alternation"
    described as {
      |Union of all Bid events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BidEventSource as source is {
    outlet BidEvents is type BidEvent
    handler BidSourceHandler is {
      on event Bid.BidCreated is {
        send event Bid.BidCreated to outlet BidEvents
      }
      on event Bid.ProposalSubmitted is {
        send event Bid.ProposalSubmitted to outlet BidEvents
      }
      on event Bid.ProposalRevised is {
        send event Bid.ProposalRevised to outlet BidEvents
      }
      on event Bid.BidWithdrawn is {
        send event Bid.BidWithdrawn to outlet BidEvents
      }
      on event Bid.ReviewBegan is {
        send event Bid.ReviewBegan to outlet BidEvents
      }
      on event Bid.BidScored is {
        send event Bid.BidScored to outlet BidEvents
      }
      on event Bid.BidShortlisted is {
        send event Bid.BidShortlisted to outlet BidEvents
      }
      on event Bid.BidAwarded is {
        send event Bid.BidAwarded to outlet BidEvents
      }
      on event Bid.BidRejected is {
        send event Bid.BidRejected to outlet BidEvents
      }
      on other is {
        error "Unexpected message for source BidEventSource"
      }
    } with {
      briefly "Bid source handler"
      described as {
        |Publishes Bid events onto the outlet.
      }
    }
  } with {
    briefly "Bid event source"
    described as {
      |Publishes Bid entity events into the streaming topology.
    }
  }
  processor BidEventSink as sink is {
    inlet BidInlet is type BidEvent
    handler BidSinkHandler is {
      on event Bid.BidCreated is {
        tell event Bid.BidCreated to repository BidContext.BidRepository
      }
      on event Bid.ProposalSubmitted is {
        tell event Bid.ProposalSubmitted to repository BidContext.BidRepository
      }
      on event Bid.ProposalRevised is {
        tell event Bid.ProposalRevised to repository BidContext.BidRepository
      }
      on event Bid.BidWithdrawn is {
        tell event Bid.BidWithdrawn to repository BidContext.BidRepository
      }
      on event Bid.ReviewBegan is {
        tell event Bid.ReviewBegan to repository BidContext.BidRepository
      }
      on event Bid.BidScored is {
        tell event Bid.BidScored to repository BidContext.BidRepository
      }
      on event Bid.BidShortlisted is {
        tell event Bid.BidShortlisted to repository BidContext.BidRepository
      }
      on event Bid.BidAwarded is {
        tell event Bid.BidAwarded to repository BidContext.BidRepository
      }
      on event Bid.BidRejected is {
        tell event Bid.BidRejected to repository BidContext.BidRepository
      }
      on other is {
        error "Unexpected message for sink BidEventSink"
      }
    } with {
      briefly "Bid sink handler"
      described as {
        |Persists Bid events via the repository.
      }
    }
  } with {
    briefly "Bid event sink"
    described as {
      |Receives Bid events for persistence.
    }
  }
  connector BidEventFlow is {
    from outlet BidContext.BidEventSource.BidEvents to
      inlet BidContext.BidEventSink.BidInlet
  } with {
    briefly "Bid event flow"
    described as {
      |Connects the Bid source to its sink.
    }
  }
  processor BidEventSplit is {
    inlet BidEventSplitIn is type BidEvent
    outlet BidEventSplitToBidRepository is type BidEvent
    outlet BidEventSplitToBidAnalytics is type BidEvent
    handler BidEventSplitHandler is {
      on event Bid.BidCreated is {
        send event Bid.BidCreated to outlet BidEventSplitToBidRepository
        send event Bid.BidCreated to outlet BidEventSplitToBidAnalytics
        tell event Bid.BidCreated to entity BidContext.Bid
      }
      on event Bid.ProposalSubmitted is {
        send event Bid.ProposalSubmitted to outlet BidEventSplitToBidRepository
        send event Bid.ProposalSubmitted to outlet BidEventSplitToBidAnalytics
        tell event Bid.ProposalSubmitted to entity BidContext.Bid
      }
      on event Bid.ProposalRevised is {
        send event Bid.ProposalRevised to outlet BidEventSplitToBidRepository
        send event Bid.ProposalRevised to outlet BidEventSplitToBidAnalytics
        tell event Bid.ProposalRevised to entity BidContext.Bid
      }
      on event Bid.BidWithdrawn is {
        send event Bid.BidWithdrawn to outlet BidEventSplitToBidRepository
        send event Bid.BidWithdrawn to outlet BidEventSplitToBidAnalytics
        tell event Bid.BidWithdrawn to entity BidContext.Bid
      }
      on event Bid.ReviewBegan is {
        send event Bid.ReviewBegan to outlet BidEventSplitToBidRepository
        send event Bid.ReviewBegan to outlet BidEventSplitToBidAnalytics
        tell event Bid.ReviewBegan to entity BidContext.Bid
      }
      on event Bid.BidScored is {
        send event Bid.BidScored to outlet BidEventSplitToBidRepository
        send event Bid.BidScored to outlet BidEventSplitToBidAnalytics
        tell event Bid.BidScored to entity BidContext.Bid
      }
      on event Bid.BidShortlisted is {
        send event Bid.BidShortlisted to outlet BidEventSplitToBidRepository
        send event Bid.BidShortlisted to outlet BidEventSplitToBidAnalytics
        tell event Bid.BidShortlisted to entity BidContext.Bid
      }
      on event Bid.BidAwarded is {
        send event Bid.BidAwarded to outlet BidEventSplitToBidRepository
        send event Bid.BidAwarded to outlet BidEventSplitToBidAnalytics
        tell event Bid.BidAwarded to entity BidContext.Bid
      }
      on event Bid.BidRejected is {
        send event Bid.BidRejected to outlet BidEventSplitToBidRepository
        send event Bid.BidRejected to outlet BidEventSplitToBidAnalytics
        tell event Bid.BidRejected to entity BidContext.Bid
      }
      on other is {
        error "Unexpected message for processor BidEventSplit"
      }
    } with {
      briefly "Bid event fan-out handler"
      described as {
        |Delivers each Bid event to all of its consumers.
      }
    }
  } with {
    briefly "Bid event fan-out"
    described as {
      |Fans Bid events out to the repository and projectors.
    }
  }
  connector LinkBidToBidEventSplit is {
    from outlet BidContext.Bid.BidEvents2 to
      inlet BidContext.BidEventSplit.BidEventSplitIn
  } with {
    briefly "LinkBidToBidEventSplit"
  }
  connector LinkBidEventSplitToBidRepository is {
    from outlet BidContext.BidEventSplit.BidEventSplitToBidRepository to
      inlet BidContext.BidRepository.BidRepositoryFromBid
  } with {
    briefly "LinkBidEventSplitToBidRepository"
  }
  connector LinkBidEventSplitToBidAnalytics is {
    from outlet BidContext.BidEventSplit.BidEventSplitToBidAnalytics to
      inlet BidContext.BidAnalytics.BidAnalyticsFromBid
  } with {
    briefly "LinkBidEventSplitToBidAnalytics"
  }
  connector LinkBidAnalyticsToBidRepository is {
    from outlet BidContext.BidAnalytics.BidAnalyticsOut to
      inlet BidContext.BidRepository.BidRepositoryFromBidAnalytics
  } with {
    briefly "LinkBidAnalyticsToBidRepository"
  }
} with {
  briefly "Bounded context for bid management"
  described as {
    | The BidContext is the bounded context for construction
    | bid management including proposals and evaluations.
  }
}
