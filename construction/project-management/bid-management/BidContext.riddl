// Bid Management - Bid Context
context BidContext as router is {
  inlet BidCommandStreamIn is type BidCommand  outlet BidCommandStreamOut is type BidCommand
  inlet BidResultStreamIn is result Bid.BidResult  outlet BidResultStreamOut is result Bid.BidResult
  handler BidContextBoundary is {
    on createBid: command Bid.CreateBid is {
      send createBid to outlet BidContext.BidCommandStreamOut
    }
    on submitProposal: command Bid.SubmitProposal is {
      send submitProposal to outlet BidContext.BidCommandStreamOut
    }
    on reviseProposal: command Bid.ReviseProposal is {
      send reviseProposal to outlet BidContext.BidCommandStreamOut
    }
    on withdrawBid: command Bid.WithdrawBid is {
      send withdrawBid to outlet BidContext.BidCommandStreamOut
    }
    on beginReview: command Bid.BeginReview is {
      send beginReview to outlet BidContext.BidCommandStreamOut
    }
    on scoreBid: command Bid.ScoreBid is {
      send scoreBid to outlet BidContext.BidCommandStreamOut
    }
    on shortlistBid: command Bid.ShortlistBid is {
      send shortlistBid to outlet BidContext.BidCommandStreamOut
    }
    on awardBid: command Bid.AwardBid is {
      send awardBid to outlet BidContext.BidCommandStreamOut
    }
    on rejectBid: command Bid.RejectBid is {
      send rejectBid to outlet BidContext.BidCommandStreamOut
    }
    on bidResult: result Bid.BidResult is {
      send bidResult to outlet BidContext.BidResultStreamOut
    }
    on other is {
      error "Unexpected message at the BidContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BidCommand Stream Intake' is from outlet BidContext.BidCommandStreamOut to inlet BidContext.Bid.BidCommands  connector 'BidResult Stream Egress' is from outlet BidContext.BidRepository.BidRepositoryResponses to inlet BidContext.BidResultStreamIn  adaptor FromContractService from context ContractService is { 
    handler FromContractServiceHandler is {
      on event ContractService.ContractGenerated is {
        do "the model receives contract generated"
      }
      on other is {
        error "Unexpected message for adaptor FromContractService"
      }
    } with {
      briefly "from contract service"
      described as {
        |Carries messages from the external ContractService.
      }
    }
  } with {
    briefly "ContractService integration"
    described as {
      |The model's side of the ContractService conversation.
    }
  }
  adaptor ToContractService to context ContractService is { 
    handler ToContractServiceHandler is {
      on command ContractService.GenerateContract is {
        do "the model sends generate contract"
      }
      on other is {
        error "Unexpected message for adaptor ToContractService"
      }
    } with {
      briefly "to contract service"
      described as {
        |Carries messages to the external ContractService.
      }
    }
  } with {
    briefly "ContractService integration"
    described as {
      |The model's side of the ContractService conversation.
    }
  }
  adaptor FromContractorService from context ContractorService is { 
    handler FromContractorServiceHandler is {
      on event ContractorService.ContractorQualified is {
        do "the model receives contractor qualified"
      }
      on other is {
        error "Unexpected message for adaptor FromContractorService"
      }
    } with {
      briefly "from contractor service"
      described as {
        |Carries messages from the external ContractorService.
      }
    }
    handler ContractorEvents is {
      on event ContractorService.ContractorRegistered is {
        do "Store contractor information for bidding"
      }
      on other is {
        error "Unexpected message for adaptor ContractorAdapter"
      }
    } with {
      briefly "Handles contractor events"
      described as {
        |Processes contractor registrations.
      }
    }
  } with {
    briefly "ContractorService integration"
    described as {
      |The model's side of the ContractorService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.NotifyAwardDecision is {
        do "the model sends notify award decision"
      }
      on command NotificationService.NotifyBidReceived is {
        do "the model sends notify bid received"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromProjectService from context ProjectService is { 
    handler FromProjectServiceHandler is {
      on event ProjectService.RFPCancelled is {
        do "the model receives rfp cancelled"
      }
      on event ProjectService.RFPClosed is {
        do "the model receives rfp closed"
      }
      on other is {
        error "Unexpected message for adaptor FromProjectService"
      }
    } with {
      briefly "from project service"
      described as {
        |Carries messages from the external ProjectService.
      }
    }
    handler ProjectEvents is {
      on event ProjectService.RFPPublished is {
        do "Create bid opportunities for contractors"
      }
      on other is {
        error "Unexpected message for adaptor ProjectAdapter"
      }
    } with {
      briefly "Handles project events"
      described as {
        |Processes RFP publications.
      }
    }
  } with {
    briefly "ProjectService integration"
    described as {
      |The model's side of the ProjectService conversation.
    }
  }
  include "types.riddl"
  include "Bid.riddl"
  // Adaptor for contractor service integration
  // Adaptor for project service integration
  // Repository for bid persistence
  type BidRepositoryCommand is one of {
    BidContext.BidRepository.PersistBidAwarded or BidContext.BidRepository.PersistBidCreated or BidContext.BidRepository.PersistBidRejected or BidContext.BidRepository.PersistBidScored or BidContext.BidRepository.PersistBidShortlisted or BidContext.BidRepository.PersistBidWithdrawn or BidContext.BidRepository.PersistProposalRevised or BidContext.BidRepository.PersistProposalSubmitted or BidContext.BidRepository.PersistReviewBegan
  } with {
    briefly "Anything that writes BidRepository"
    described as {
      |The persistence commands BidRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BidRepository as flow is {
    inlet BidRepositoryFromBidAnalytics is type BidRepositoryCommand    command PersistBidCreated is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row BidCreated applies to.
        }
      }
    } with {
      briefly "Persist BidCreated"
      described as {
        |Instructs this repository to apply BidCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBidRejected is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row BidRejected applies to.
        }
      }
    } with {
      briefly "Persist BidRejected"
      described as {
        |Instructs this repository to apply BidRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBidScored is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row BidScored applies to.
        }
      }
    } with {
      briefly "Persist BidScored"
      described as {
        |Instructs this repository to apply BidScored to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBidShortlisted is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row BidShortlisted applies to.
        }
      }
    } with {
      briefly "Persist BidShortlisted"
      described as {
        |Instructs this repository to apply BidShortlisted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProposalRevised is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProposalRevised applies to.
        }
      }
    } with {
      briefly "Persist ProposalRevised"
      described as {
        |Instructs this repository to apply ProposalRevised to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewBegan is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewBegan applies to.
        }
      }
    } with {
      briefly "Persist ReviewBegan"
      described as {
        |Instructs this repository to apply ReviewBegan to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBidAwarded is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row BidAwarded applies to.
        }
      }
    } with {
      briefly "Persist BidAwarded"
      described as {
        |Instructs this repository to apply BidAwarded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBidWithdrawn is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row BidWithdrawn applies to.
        }
      }
    } with {
      briefly "Persist BidWithdrawn"
      described as {
        |Instructs this repository to apply BidWithdrawn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProposalSubmitted is {
      bidId: BidId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProposalSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ProposalSubmitted"
      described as {
        |Instructs this repository to apply ProposalSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BidRepositoryResponses is result Bid.BidResult
    record StoredBid is {
      bidId: BidId with {
        briefly "bidId"
        described as {
          |The bidId column of the stored bid row.
        }
      }
      contractorId: ContractorId with {
        briefly "contractorId"
        described as {
          |The contractorId column of the stored bid row.
        }
      }
      rfpId: UUID with {
        briefly "rfpId"
        described as {
          |The rfpId column of the stored bid row.
        }
      }
    } with {
      briefly "Stored bid row"
      described as {
        |The persistence shape of bid data as this repository stores it.
      }
    }
    schema BidData is relational
      of bids as record StoredBid
        index on field StoredBid.bidId
        index on field StoredBid.rfpId
        index on field StoredBid.contractorId
 with {
      briefly "Bid data schema"
      described as {
        |The relational schema holding bid data for the BidRepository.
      }
    }
    handler BidPersistence is {
      on persistBidCreated: command PersistBidCreated is {
        do "apply BidCreated to the stored row"
      }
      on persistBidRejected: command PersistBidRejected is {
        do "apply BidRejected to the stored row"
      }
      on persistBidScored: command PersistBidScored is {
        do "apply BidScored to the stored row"
      }
      on persistBidShortlisted: command PersistBidShortlisted is {
        do "apply BidShortlisted to the stored row"
      }
      on persistProposalRevised: command PersistProposalRevised is {
        do "apply ProposalRevised to the stored row"
      }
      on persistReviewBegan: command PersistReviewBegan is {
        do "apply ReviewBegan to the stored row"
      }
      on persistBidAwarded: command PersistBidAwarded is {
        do "apply BidAwarded to the stored row"
      }
      on persistBidWithdrawn: command PersistBidWithdrawn is {
        do "apply BidWithdrawn to the stored row"
      }
      on persistProposalSubmitted: command PersistProposalSubmitted is {
        do "apply ProposalSubmitted to the stored row"
      }
      on query GetRFPSummary is {
        let rFPSummaryView: type RFPSummaryView = prompt("read the rfp summary projection")
        reply rFPSummaryView
      }
    } with {
      briefly "Persists bid commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Bid data persistence"
    described as {
      | The BidRepository provides persistent storage for
      | bids, proposals, and evaluation scores.
    }
  }
  // Projector for bid analytics
  query GetRFPSummary replies result RFPSummaryView is {
    rFPSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which rfp summary to retrieve.
      }
    }
  } with {
    briefly "Get rfp summary"
    described as {
      |Retrieves the rfp summary projection.
    }
  }
  result RFPSummaryView is {
    rFPSummary: BidAnalytics.RFPSummary with {
      briefly "Rfp summary"
      described as {
        |The rfp summary being returned.
      }
    }
  } with {
    briefly "Rfp summary view"
    described as {
      |Read model view carrying the rfp summary projection.
    }
  }
  projector BidAnalytics as flow is {
    updates repository BidContext.BidRepository
    outlet BidAnalyticsToRepository is type BidRepositoryCommand
    inlet BidAnalyticsFromBid is type BidEvent    record RFPSummary is {
      rfpId: UUID with {
        briefly "RFP"
        described as {
          |RFP ID.
        }
      }
      bidCount: Natural with {
        briefly "Bids"
        described as {
          |Number of bids.
        }
      }
      averagePrice: Money with {
        briefly "Avg price"
        described as {
          |Average bid price.
        }
      }
      lowestPrice: Money with {
        briefly "Low price"
        described as {
          |Lowest bid price.
        }
      }
      highestPrice: Money with {
        briefly "High price"
        described as {
          |Highest bid price.
        }
      }
    } with {
      briefly "RFP summary"
      described as {
        |Bid summary for an RFP.
      }
    }
    handler AnalyticsHandler is {
      on bidCreated: event Bid.BidCreated is {
        tell command BidContext.BidRepository.PersistBidCreated(bidId = bidCreated.bidId) to repository BidContext.BidRepository
        do "apply BidCreated to the BidAnalytics projection"
      }
      on bidRejected: event Bid.BidRejected is {
        tell command BidContext.BidRepository.PersistBidRejected(bidId = bidRejected.bidId) to repository BidContext.BidRepository
        do "apply BidRejected to the BidAnalytics projection"
      }
      on bidScored: event Bid.BidScored is {
        tell command BidContext.BidRepository.PersistBidScored(bidId = bidScored.bidId) to repository BidContext.BidRepository
        do "apply BidScored to the BidAnalytics projection"
      }
      on bidShortlisted: event Bid.BidShortlisted is {
        tell command BidContext.BidRepository.PersistBidShortlisted(bidId = bidShortlisted.bidId) to repository BidContext.BidRepository
        do "apply BidShortlisted to the BidAnalytics projection"
      }
      on proposalRevised: event Bid.ProposalRevised is {
        tell command BidContext.BidRepository.PersistProposalRevised(bidId = proposalRevised.bidId) to repository BidContext.BidRepository
        do "apply ProposalRevised to the BidAnalytics projection"
      }
      on reviewBegan: event Bid.ReviewBegan is {
        tell command BidContext.BidRepository.PersistReviewBegan(bidId = reviewBegan.bidId) to repository BidContext.BidRepository
        do "apply ReviewBegan to the BidAnalytics projection"
      }
      on proposalSubmitted: event Bid.ProposalSubmitted is {
        tell command BidContext.BidRepository.PersistProposalSubmitted(bidId = proposalSubmitted.bidId) to repository BidContext.BidRepository
        do "Update RFP bid statistics"
      }
      on bidWithdrawn: event Bid.BidWithdrawn is {
        tell command BidContext.BidRepository.PersistBidWithdrawn(bidId = bidWithdrawn.bidId) to repository BidContext.BidRepository
        do "Update RFP bid count"
      }
      on bidAwarded: event Bid.BidAwarded is {
        tell command BidContext.BidRepository.PersistBidAwarded(bidId = bidAwarded.bidId) to repository BidContext.BidRepository
        do "Mark RFP as awarded"
      }
    } with {
      briefly "Maintains bid analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Bid analytics projections"
    described as {
      |Maintains bid analytics data.
    }
  }
  // ---- Event publication for Bid ----
  type BidEvent is one of {
    BidContext.Bid.BidCreated or BidContext.Bid.ProposalSubmitted or BidContext.Bid.ProposalRevised or BidContext.Bid.BidWithdrawn or BidContext.Bid.ReviewBegan or BidContext.Bid.BidScored or BidContext.Bid.BidShortlisted or BidContext.Bid.BidAwarded or BidContext.Bid.BidRejected
  } with {
    briefly "Bid event alternation"
    described as {
      |Union of all Bid events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet BidEventSplit as flow is {
    inlet BidEventSplitIn is type BidEvent    outlet BidEventSplitToBidAnalytics is type BidEvent
    handler BidEventSplitHandler is {
      on bidCreated: event Bid.BidCreated is {
        send bidCreated to outlet BidEventSplitToBidAnalytics
        tell bidCreated to entity BidContext.Bid
      }
      on proposalSubmitted: event Bid.ProposalSubmitted is {
        send proposalSubmitted to outlet BidEventSplitToBidAnalytics
        tell proposalSubmitted to entity BidContext.Bid
      }
      on proposalRevised: event Bid.ProposalRevised is {
        send proposalRevised to outlet BidEventSplitToBidAnalytics
        tell proposalRevised to entity BidContext.Bid
      }
      on bidWithdrawn: event Bid.BidWithdrawn is {
        send bidWithdrawn to outlet BidEventSplitToBidAnalytics
        tell bidWithdrawn to entity BidContext.Bid
      }
      on reviewBegan: event Bid.ReviewBegan is {
        send reviewBegan to outlet BidEventSplitToBidAnalytics
        tell reviewBegan to entity BidContext.Bid
      }
      on bidScored: event Bid.BidScored is {
        send bidScored to outlet BidEventSplitToBidAnalytics
        tell bidScored to entity BidContext.Bid
      }
      on bidShortlisted: event Bid.BidShortlisted is {
        send bidShortlisted to outlet BidEventSplitToBidAnalytics
        tell bidShortlisted to entity BidContext.Bid
      }
      on bidAwarded: event Bid.BidAwarded is {
        send bidAwarded to outlet BidEventSplitToBidAnalytics
        tell bidAwarded to entity BidContext.Bid
      }
      on bidRejected: event Bid.BidRejected is {
        send bidRejected to outlet BidEventSplitToBidAnalytics
        tell bidRejected to entity BidContext.Bid
      }
      on other is {
        error "Unexpected message for processor BidEventSplit"
      }
    } with {
      briefly "Bid event fan-out handler"
      described as {
        |Delivers each Bid event to all of its consumers.
      }
    }
  } with {
    briefly "Bid event fan-out"
    described as {
      |Fans Bid events out to the repository and projectors.
    }
  }
  connector 'BidEvent Stream' is from outlet BidContext.Bid.BidEvents2 to inlet BidContext.BidEventSplit.BidEventSplitIn with {
    briefly "Bid events, fanned out to storage and read models"
  }
  connector 'BidAnalytics Feed' is from outlet BidContext.BidEventSplit.BidEventSplitToBidAnalytics to inlet BidContext.BidAnalytics.BidAnalyticsFromBid with {
    briefly "Bid events feeding the BidAnalytics projection"
  }
  connector 'BidAnalytics Storage' is from outlet BidContext.BidAnalytics.BidAnalyticsToRepository to inlet BidContext.BidRepository.BidRepositoryFromBidAnalytics with {
    briefly "BidAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for bid management"
  described as {
    | The BidContext is the bounded context for construction
    | bid management including proposals and evaluations.
  }
}
