// Bid Management Domain Model
// Construction project bidding, proposals, and contractor selection
domain BidManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Estimator is "staff preparing bid estimates" with {
    briefly "Estimator"
    described as {
      |Staff responsible for cost estimation.
    }
  }
  user BidManager is "manager overseeing bid process" with {
    briefly "Bid manager"
    described as {
      |Staff managing bid submissions and evaluations.
    }
  }
  user Contractor is "contractor submitting bids" with {
    briefly "Contractor"
    described as {
      |External contractor bidding on projects.
    }
  }
  epic BidEvaluationEpic is {
    user BidManager wants to "to evaluate contractor bids" so that "the best contractor is selected for projects"
    case EvaluateBids is {
      user BidManager wants to "to compare and score submitted bids" so that "an informed selection can be made"
      step is "Manager reviews bid submissions" "checking completeness" "and compliance" with {
        briefly "Review bids"
        described as {
          |Manager reviews submitted bids.
        }
      }
      step is "Manager scores bids" "on price, experience," "and qualifications" with {
        briefly "Score bids"
        described as {
          |Manager evaluates and scores.
        }
      }
      step take input BidManagementApp.BidManagementScreen.AwardBidInput from user BidManager with {
        briefly "Award bid"
        described as {
          |Send award decision.
        }
      }
      step is "System notifies contractors" "of selection decision" "and next steps" with {
        briefly "Notify contractors"
        described as {
          |System sends notifications.
        }
      }
    } with {
      briefly "Bid evaluation workflow"
      described as {
        |Standard flow for evaluating bids.
      }
    }
  } with {
    briefly "Bid evaluation processing"
    described as {
      | Epic covering bid evaluation from submission review
      | through scoring and contractor selection.
    }
  }
  include "BidContext.riddl"
  include "external-contexts.riddl"
  application context BidManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in BidManagement are delivered.
      }
    }
    group BidManagementScreen is {
      input AwardBidInput acquires command BidContext.Bid.AwardBid with {
        briefly "Award bid control"
        described as {
          |The control through which a user submits the award bid request.
        }
      }
    } with {
      briefly "Bid management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppBidCommands is type BidContext.Bid.BidCommand
    inlet AppBidRepositoryResponses is type BidContext.Bid.BidResult    handler BidManagementAppHandler is {
      on other is {
        error "Unexpected message for application context BidManagementApp"
      }
    } with {
      briefly "BidManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "BidManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppBidCommands is from outlet BidManagementApp.AppBidCommands to inlet BidContext.Bid.BidCommands with {
    option persistent()
    briefly "LinkAppBidCommands"
  }
  connector LinkAppBidRepositoryResponses is from outlet BidContext.BidRepository.BidRepositoryResponses to inlet BidManagementApp.AppBidRepositoryResponses with {
    option persistent()
    briefly "LinkAppBidRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet BidManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Bid management domain"
  described as {
    | The BidManagement domain handles construction project
    | bidding including RFPs, proposals, and contractor selection.
  }
}
