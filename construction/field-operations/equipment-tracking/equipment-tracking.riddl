// Equipment Tracking Domain Model
// Construction equipment lifecycle, location, and maintenance tracking
domain EquipmentTracking is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user FleetManager is "staff managing equipment fleet" with {
    briefly "Fleet manager"
    described as {
      |Staff responsible for equipment allocation.
    }
  }
  user FieldSupervisor is "supervisor at job sites" with {
    briefly "Field supervisor"
    described as {
      |Staff overseeing equipment at sites.
    }
  }
  user MaintenanceTech is "maintenance technician" with {
    briefly "Maintenance tech"
    described as {
      |Staff performing equipment maintenance.
    }
  }
  epic EquipmentAllocationEpic is {
    user FleetManager wants to "to allocate equipment to job sites" so that "projects have necessary resources"
    case AllocateEquipment is {
      user FleetManager wants to "to assign equipment to a project" so that "work can proceed as scheduled"
      step is "Manager reviews equipment availability" "checking current assignments" "and location" with {
        briefly "Check availability"
        described as {
          |Manager checks equipment status.
        }
      }
      step is "Manager selects appropriate equipment" "based on project needs" "and proximity" with {
        briefly "Select equipment"
        described as {
          |Manager chooses equipment.
        }
      }
      step take input EquipmentTrackingApp.EquipmentTrackingScreen.AssignToSiteInput from user FleetManager with {
        briefly "Assign equipment"
        described as {
          |Send assignment command.
        }
      }
      step is "System updates equipment location" "and notifies site supervisor" "of arrival" with {
        briefly "Update location"
        described as {
          |System records assignment.
        }
      }
    } with {
      briefly "Equipment allocation workflow"
      described as {
        |Standard flow for assigning equipment to sites.
      }
    }
  } with {
    briefly "Equipment allocation processing"
    described as {
      | Epic covering equipment allocation from request through
      | assignment and delivery to job sites.
    }
  }
  include "EquipmentContext.riddl"
  include "external-contexts.riddl"
  application context EquipmentTrackingApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EquipmentTracking are delivered.
      }
    }
    group EquipmentTrackingScreen is {
      input AssignToSiteInput acquires command EquipmentContext.Equipment.AssignToSite with {
        briefly "Assign to site control"
        described as {
          |The control through which a user submits the assign to site request.
        }
      }
    } with {
      briefly "Equipment tracking screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppEquipmentCommands is type EquipmentContext.Equipment.EquipmentCommand
    inlet AppEquipmentRepositoryResponses is type EquipmentContext.Equipment.EquipmentResult    handler EquipmentTrackingAppHandler is {
      on other is {
        error "Unexpected message for application context EquipmentTrackingApp"
      }
    } with {
      briefly "EquipmentTrackingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EquipmentTrackingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector EquipmentCommandStream is from outlet EquipmentTrackingApp.AppEquipmentCommands to inlet EquipmentContext.Equipment.EquipmentCommands with {
    option persistent()
    briefly "Equipment commands from the application"
  }
  connector EquipmentQueryResults is from outlet EquipmentContext.EquipmentRepository.EquipmentRepositoryResponses to inlet EquipmentTrackingApp.AppEquipmentRepositoryResponses with {
    option persistent()
    briefly "Equipment query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EquipmentTrackingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Equipment tracking management domain"
  described as {
    | The EquipmentTracking domain handles construction equipment
    | lifecycle including acquisition, allocation, maintenance, and disposal.
  }
}
