// Equipment Tracking - Equipment Entity
entity Equipment as flow is {
  type EquipmentCommand is one of {
    Equipment.RegisterEquipment or Equipment.AssignToSite or Equipment.ReturnFromSite or Equipment.UpdateLocation or Equipment.RecordMeterReading or Equipment.ScheduleMaintenance or Equipment.CompleteMaintenance or Equipment.MarkOutOfService or Equipment.ReturnToService or Equipment.DisposeEquipment
  } with {
    briefly "Equipment command alternation"
    described as {
      |Commands accepted by the Equipment entity.
    }
  }
  inlet EquipmentCommands is type EquipmentCommand  outlet EquipmentEvents2 is type EquipmentEvent
  query GetEquipment replies result EquipmentResult is  {
    equipmentId: EquipmentId with {
      briefly "ID"
      described as {
        |Identifier of the Equipment to retrieve.
      }
    }
  } with {
    briefly "Get Equipment"
    described as {
      |Retrieve Equipment data by identifier.
    }
  }
  result EquipmentResult is  {
    equipmentId: EquipmentId with {
      briefly "Equipment addressed"
      described as {
        |Which equipment this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    equipmentData: Equipment.AvailableEquipmentData with {
      briefly "Equipment data"
      described as {
        |The requested Equipment data.
      }
    }
  } with {
    briefly "Equipment result"
    described as {
      |Result carrying the requested Equipment data.
    }
  }
  // Commands
  command RegisterEquipment is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |New equipment identifier.
      }
    }
    equipmentType: EquipmentType with {
      briefly "Type"
      described as {
        |Equipment category.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Equipment name.
      }
    }
    make: String(1,100) with {
      briefly "Make"
      described as {
        |Manufacturer.
      }
    }
    model: String(1,100) with {
      briefly "Model"
      described as {
        |Model name.
      }
    }
    serialNumber: String(1,50) with {
      briefly "Serial"
      described as {
        |Serial number.
      }
    }
    purchaseDate: Date with {
      briefly "Purchased"
      described as {
        |Purchase date.
      }
    }
    purchaseCost: Money with {
      briefly "Cost"
      described as {
        |Purchase cost.
      }
    }
  } with {
    briefly "Register equipment"
    described as {
      |Adds new equipment to the fleet.
    }
  }
  command AssignToSite is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment to assign.
      }
    }
    assignment: Assignment with {
      briefly "Assignment"
      described as {
        |Assignment details.
      }
    }
  } with {
    briefly "Assign to site"
    described as {
      |Assigns equipment to a job site.
    }
  }
  command ReturnFromSite is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment returning.
      }
    }
    returnedAt: TimeStamp with {
      briefly "Returned"
      described as {
        |Return timestamp.
      }
    }
    condition: String(1,500) with {
      briefly "Condition"
      described as {
        |Condition on return.
      }
    }
  } with {
    briefly "Return from site"
    described as {
      |Returns equipment from job site.
    }
  }
  command UpdateLocation is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment to update.
      }
    }
    location: GeoLocation with {
      briefly "Location"
      described as {
        |New location.
      }
    }
  } with {
    briefly "Update location"
    described as {
      |Updates equipment GPS location.
    }
  }
  command RecordMeterReading is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment ID.
      }
    }
    reading: MeterReading with {
      briefly "Reading"
      described as {
        |Meter reading.
      }
    }
  } with {
    briefly "Record meter reading"
    described as {
      |Records operating hours/mileage.
    }
  }
  command ScheduleMaintenance is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment ID.
      }
    }
    maintenanceType: MaintenanceType with {
      briefly "Type"
      described as {
        |Maintenance type.
      }
    }
    scheduledDate: Date with {
      briefly "Scheduled"
      described as {
        |Scheduled date.
      }
    }
    description: String(1,1000) with {
      briefly "Description"
      described as {
        |Work to perform.
      }
    }
  } with {
    briefly "Schedule maintenance"
    described as {
      |Schedules maintenance work.
    }
  }
  command CompleteMaintenance is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment ID.
      }
    }
    record: MaintenanceRecord with {
      briefly "Record"
      described as {
        |Maintenance record.
      }
    }
  } with {
    briefly "Complete maintenance"
    described as {
      |Records completed maintenance.
    }
  }
  command MarkOutOfService is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Out of service reason.
      }
    }
  } with {
    briefly "Mark out of service"
    described as {
      |Marks equipment as non-operational.
    }
  }
  command ReturnToService is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment ID.
      }
    }
  } with {
    briefly "Return to service"
    described as {
      |Returns equipment to operational status.
    }
  }
  command DisposeEquipment is  {
    equipmentId: EquipmentId with {
      briefly "Equipment ID"
      described as {
        |Equipment ID.
      }
    }
    disposalType: String(1,50) with {
      briefly "Type"
      described as {
        |Sold, scrapped, etc.
      }
    }
    disposalValue: Money? with {
      briefly "Value"
      described as {
        |Sale proceeds.
      }
    }
    disposedBy: String(1,100) with {
      briefly "Disposed by"
      described as {
        |Who disposed.
      }
    }
  } with {
    briefly "Dispose equipment"
    described as {
      |Removes equipment from fleet.
    }
  }
  // Events
  event EquipmentRegistered is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    equipmentType: EquipmentType with {
      briefly "Type"
      described as {
        |Equipment type.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Equipment name.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Equipment was registered"
    described as {
      |Emitted when equipment is added to fleet.
    }
  }
  event EquipmentAssigned is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    assignment: Assignment with {
      briefly "Assignment"
      described as {
        |Assignment details.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned"
      described as {
        |Assignment time.
      }
    }
  } with {
    briefly "Equipment was assigned"
    described as {
      |Emitted when equipment is assigned to site.
    }
  }
  event EquipmentReturned is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    fromSiteId: JobSiteId with {
      briefly "From site"
      described as {
        |Site returned from.
      }
    }
    returnedAt: TimeStamp with {
      briefly "Returned"
      described as {
        |Return time.
      }
    }
  } with {
    briefly "Equipment was returned"
    described as {
      |Emitted when equipment returns from site.
    }
  }
  event LocationUpdated is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    location: GeoLocation with {
      briefly "Location"
      described as {
        |New location.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Location was updated"
    described as {
      |Emitted when GPS location changes.
    }
  }
  event MeterReadingRecorded is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    reading: MeterReading with {
      briefly "Reading"
      described as {
        |Meter reading.
      }
    }
  } with {
    briefly "Meter reading was recorded"
    described as {
      |Emitted when usage metrics recorded.
    }
  }
  event MaintenanceScheduled is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    maintenanceType: MaintenanceType with {
      briefly "Type"
      described as {
        |Maintenance type.
      }
    }
    scheduledDate: Date with {
      briefly "Scheduled"
      described as {
        |Scheduled date.
      }
    }
  } with {
    briefly "Maintenance was scheduled"
    described as {
      |Emitted when maintenance is scheduled.
    }
  }
  event MaintenanceCompleted is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    record: MaintenanceRecord with {
      briefly "Record"
      described as {
        |Maintenance record.
      }
    }
  } with {
    briefly "Maintenance was completed"
    described as {
      |Emitted when maintenance is done.
    }
  }
  event MarkedOutOfService is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason.
      }
    }
    markedAt: TimeStamp with {
      briefly "Marked"
      described as {
        |When marked.
      }
    }
  } with {
    briefly "Equipment marked out of service"
    described as {
      |Emitted when equipment becomes non-operational.
    }
  }
  event ReturnedToService is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    returnedAt: TimeStamp with {
      briefly "Returned"
      described as {
        |When returned.
      }
    }
  } with {
    briefly "Equipment returned to service"
    described as {
      |Emitted when equipment becomes operational.
    }
  }
  event EquipmentDisposed is  {
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    disposalType: String(1,50) with {
      briefly "Type"
      described as {
        |Disposal type.
      }
    }
    disposedAt: TimeStamp with {
      briefly "Disposed"
      described as {
        |Disposal time.
      }
    }
  } with {
    briefly "Equipment was disposed"
    described as {
      |Emitted when equipment is removed from fleet.
    }
  }
  // State Records
  record AvailableEquipmentData is  {
    stateValue: EquipmentStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    equipmentType: EquipmentType with {
      briefly "Type"
      described as {
        |Equipment type.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Equipment name.
      }
    }
    make: String(1,100) with {
      briefly "Make"
      described as {
        |Manufacturer.
      }
    }
    model: String(1,100) with {
      briefly "Model"
      described as {
        |Model.
      }
    }
    serialNumber: String(1,50) with {
      briefly "Serial"
      described as {
        |Serial number.
      }
    }
    location: GeoLocation with {
      briefly "Location"
      described as {
        |Current location.
      }
    }
    lastReading: MeterReading? with {
      briefly "Reading"
      described as {
        |Last meter reading.
      }
    }
    maintenanceHistory: MaintenanceRecord+ with {
      briefly "History"
      described as {
        |Maintenance records.
      }
    }
  } with {
    briefly "Available equipment data"
    described as {
      |State data for available equipment.
    }
  }
  record AssignedEquipmentData is  {
    stateValue: EquipmentStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    equipmentType: EquipmentType with {
      briefly "Type"
      described as {
        |Equipment type.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Equipment name.
      }
    }
    make: String(1,100) with {
      briefly "Make"
      described as {
        |Manufacturer.
      }
    }
    model: String(1,100) with {
      briefly "Model"
      described as {
        |Model.
      }
    }
    serialNumber: String(1,50) with {
      briefly "Serial"
      described as {
        |Serial number.
      }
    }
    currentAssignment: Assignment with {
      briefly "Assignment"
      described as {
        |Current assignment.
      }
    }
    location: GeoLocation with {
      briefly "Location"
      described as {
        |Current location.
      }
    }
    lastReading: MeterReading? with {
      briefly "Reading"
      described as {
        |Last meter reading.
      }
    }
    maintenanceHistory: MaintenanceRecord+ with {
      briefly "History"
      described as {
        |Maintenance records.
      }
    }
  } with {
    briefly "Assigned equipment data"
    described as {
      |State data for assigned equipment.
    }
  }
  record MaintenanceEquipmentData is  {
    stateValue: EquipmentStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    equipmentType: EquipmentType with {
      briefly "Type"
      described as {
        |Equipment type.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Equipment name.
      }
    }
    scheduledWork: String(1,1000) with {
      briefly "Work"
      described as {
        |Scheduled work.
      }
    }
    scheduledDate: Date with {
      briefly "Scheduled"
      described as {
        |Scheduled date.
      }
    }
    maintenanceHistory: MaintenanceRecord+ with {
      briefly "History"
      described as {
        |Maintenance records.
      }
    }
  } with {
    briefly "Maintenance equipment data"
    described as {
      |State data for equipment in maintenance.
    }
  }
  record OutOfServiceEquipmentData is  {
    stateValue: EquipmentStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    equipmentType: EquipmentType with {
      briefly "Type"
      described as {
        |Equipment type.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Equipment name.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Out of service reason.
      }
    }
    outOfServiceSince: TimeStamp with {
      briefly "Since"
      described as {
        |When went out of service.
      }
    }
  } with {
    briefly "Out of service equipment data"
    described as {
      |State data for non-operational equipment.
    }
  }
  record DisposedEquipmentData is  {
    stateValue: EquipmentStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    equipmentId: EquipmentId with {
      briefly "Equipment"
      described as {
        |Equipment ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Equipment name.
      }
    }
    disposalType: String(1,50) with {
      briefly "Type"
      described as {
        |Disposal type.
      }
    }
    disposedAt: TimeStamp with {
      briefly "Disposed"
      described as {
        |Disposal time.
      }
    }
  } with {
    briefly "Disposed equipment data"
    described as {
      |State data for disposed equipment.
    }
  }
  // States
  initial state AvailableState of record Equipment.AvailableEquipmentData is {
    initial handler AvailableStateInitHandler is {
      on query GetEquipment is {
        let equipmentResult: type EquipmentResult = prompt("read the equipment from the store")
        reply equipmentResult
      }
      on init is {
        set state AvailableState to "initialize from prior event"
        set field AvailableEquipmentData.stateValue to "AvailableStatus"
      }
    } with {
      briefly "AvailableState init handler"
      described as {
        |Initializes the AvailableState state.
      }
    }
  } with {
    briefly "AvailableState state"
    described as {
      |The AvailableState state of the Equipment.
    }
  }
  state AssignedState of record Equipment.AssignedEquipmentData is {
    initial handler AssignedStateInitHandler is {
      on init is {
        set state AssignedState to "initialize from prior event"
        set field AssignedEquipmentData.stateValue to "AssignedStatus"
      }
    } with {
      briefly "AssignedState init handler"
      described as {
        |Initializes the AssignedState state.
      }
    }
  } with {
    briefly "AssignedState state"
    described as {
      |The AssignedState state of the Equipment.
    }
  }
  state MaintenanceState of record Equipment.MaintenanceEquipmentData is {
    initial handler MaintenanceStateInitHandler is {
      on init is {
        set state MaintenanceState to "initialize from prior event"
        set field MaintenanceEquipmentData.stateValue to "MaintenanceStatus"
      }
    } with {
      briefly "MaintenanceState init handler"
      described as {
        |Initializes the MaintenanceState state.
      }
    }
  } with {
    briefly "MaintenanceState state"
    described as {
      |The MaintenanceState state of the Equipment.
    }
  }
  state OutOfServiceState of record Equipment.OutOfServiceEquipmentData is {
    initial handler OutOfServiceStateInitHandler is {
      on init is {
        set state OutOfServiceState to "initialize from prior event"
        set field OutOfServiceEquipmentData.stateValue to "OutOfServiceStatus"
      }
    } with {
      briefly "OutOfServiceState init handler"
      described as {
        |Initializes the OutOfServiceState state.
      }
    }
  } with {
    briefly "OutOfServiceState state"
    described as {
      |The OutOfServiceState state of the Equipment.
    }
  }
  state DisposedState of record Equipment.DisposedEquipmentData is {
    initial handler DisposedStateInitHandler is {
      on init is {
        set state DisposedState to "initialize from prior event"
        set field DisposedEquipmentData.stateValue to "DisposedStatus"
      }
    } with {
      briefly "DisposedState init handler"
      described as {
        |Initializes the DisposedState state.
      }
    }
  } with {
    briefly "DisposedState state"
    described as {
      |The DisposedState state of the Equipment.
    }
  }
  // Handler
  handler EquipmentHandler is {
    on registerEquipment: command RegisterEquipment is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.AvailableState with record Equipment.AvailableEquipmentData(equipmentId = registerEquipment.equipmentId, equipmentType = registerEquipment.equipmentType, name = registerEquipment.name, make = registerEquipment.make, model = registerEquipment.model, serialNumber = registerEquipment.serialNumber, stateValue = prompt("the state value of this available equipment data"), location = prompt("the location of this available equipment data"), lastReading = empty, maintenanceHistory = prompt("the maintenance history of this available equipment data"))
      tell event EquipmentRegistered(equipmentId = registerEquipment.equipmentId, equipmentType = registerEquipment.equipmentType, name = registerEquipment.name, registeredAt = prompt("the registered at of this equipment registered")) to entity EquipmentContext.Equipment
    }
    on assignToSite: command AssignToSite is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.AssignedState with record Equipment.AssignedEquipmentData(equipmentId = assignToSite.equipmentId, stateValue = prompt("the state value of this assigned equipment data"), equipmentType = prompt("the equipment type of this assigned equipment data"), name = prompt("the name of this assigned equipment data"), make = prompt("the make of this assigned equipment data"), model = prompt("the model of this assigned equipment data"), serialNumber = prompt("the serial number of this assigned equipment data"), currentAssignment = prompt("the current assignment of this assigned equipment data"), location = prompt("the location of this assigned equipment data"), lastReading = empty, maintenanceHistory = prompt("the maintenance history of this assigned equipment data"))
      tell event EquipmentAssigned(equipmentId = assignToSite.equipmentId, assignment = assignToSite.assignment, assignedAt = prompt("the assigned at of this equipment assigned")) to entity EquipmentContext.Equipment
    }
    on returnFromSite: command ReturnFromSite is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.AvailableState with record Equipment.AvailableEquipmentData(equipmentId = returnFromSite.equipmentId, stateValue = prompt("the state value of this available equipment data"), equipmentType = prompt("the equipment type of this available equipment data"), name = prompt("the name of this available equipment data"), make = prompt("the make of this available equipment data"), model = prompt("the model of this available equipment data"), serialNumber = prompt("the serial number of this available equipment data"), location = prompt("the location of this available equipment data"), lastReading = empty, maintenanceHistory = prompt("the maintenance history of this available equipment data"))
      tell event EquipmentReturned(equipmentId = returnFromSite.equipmentId, returnedAt = returnFromSite.returnedAt, fromSiteId = prompt("the from site id of this equipment returned")) to entity EquipmentContext.Equipment
    }
    on updateLocation: command UpdateLocation is {
      tell event LocationUpdated(equipmentId = updateLocation.equipmentId, location = updateLocation.location, updatedAt = prompt("the updated at of this location updated")) to entity EquipmentContext.Equipment
    }
    on recordMeterReading: command RecordMeterReading is {
      tell event MeterReadingRecorded(equipmentId = recordMeterReading.equipmentId, reading = recordMeterReading.reading) to entity EquipmentContext.Equipment
    }
    on scheduleMaintenance: command ScheduleMaintenance is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.MaintenanceState with record Equipment.MaintenanceEquipmentData(equipmentId = scheduleMaintenance.equipmentId, scheduledDate = scheduleMaintenance.scheduledDate, stateValue = prompt("the state value of this maintenance equipment data"), equipmentType = prompt("the equipment type of this maintenance equipment data"), name = prompt("the name of this maintenance equipment data"), scheduledWork = prompt("the scheduled work of this maintenance equipment data"), maintenanceHistory = prompt("the maintenance history of this maintenance equipment data"))
      tell event MaintenanceScheduled(equipmentId = scheduleMaintenance.equipmentId, maintenanceType = scheduleMaintenance.maintenanceType, scheduledDate = scheduleMaintenance.scheduledDate) to entity EquipmentContext.Equipment
    }
    on completeMaintenance: command CompleteMaintenance is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.AvailableState with record Equipment.AvailableEquipmentData(equipmentId = completeMaintenance.equipmentId, stateValue = prompt("the state value of this available equipment data"), equipmentType = prompt("the equipment type of this available equipment data"), name = prompt("the name of this available equipment data"), make = prompt("the make of this available equipment data"), model = prompt("the model of this available equipment data"), serialNumber = prompt("the serial number of this available equipment data"), location = prompt("the location of this available equipment data"), lastReading = empty, maintenanceHistory = prompt("the maintenance history of this available equipment data"))
      tell event MaintenanceCompleted(equipmentId = completeMaintenance.equipmentId, record = completeMaintenance.record) to entity EquipmentContext.Equipment
    }
    on markOutOfService: command MarkOutOfService is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.OutOfServiceState with record Equipment.OutOfServiceEquipmentData(equipmentId = markOutOfService.equipmentId, reason = markOutOfService.reason, stateValue = prompt("the state value of this out of service equipment data"), equipmentType = prompt("the equipment type of this out of service equipment data"), name = prompt("the name of this out of service equipment data"), outOfServiceSince = prompt("the out of service since of this out of service equipment data"))
      tell event MarkedOutOfService(equipmentId = markOutOfService.equipmentId, reason = markOutOfService.reason, markedAt = prompt("the marked at of this marked out of service")) to entity EquipmentContext.Equipment
    }
    on returnToService: command ReturnToService is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.AvailableState with record Equipment.AvailableEquipmentData(equipmentId = returnToService.equipmentId, stateValue = prompt("the state value of this available equipment data"), equipmentType = prompt("the equipment type of this available equipment data"), name = prompt("the name of this available equipment data"), make = prompt("the make of this available equipment data"), model = prompt("the model of this available equipment data"), serialNumber = prompt("the serial number of this available equipment data"), location = prompt("the location of this available equipment data"), lastReading = empty, maintenanceHistory = prompt("the maintenance history of this available equipment data"))
      tell event ReturnedToService(equipmentId = returnToService.equipmentId, returnedAt = prompt("the returned at of this returned to service")) to entity EquipmentContext.Equipment
    }
    on disposeEquipment: command DisposeEquipment is {
      morph entity EquipmentContext.Equipment to state EquipmentContext.Equipment.DisposedState with record Equipment.DisposedEquipmentData(equipmentId = disposeEquipment.equipmentId, disposalType = disposeEquipment.disposalType, stateValue = prompt("the state value of this disposed equipment data"), name = prompt("the name of this disposed equipment data"), disposedAt = prompt("the disposed at of this disposed equipment data"))
      tell event EquipmentDisposed(equipmentId = disposeEquipment.equipmentId, disposalType = disposeEquipment.disposalType, disposedAt = prompt("the disposed at of this equipment disposed")) to entity EquipmentContext.Equipment
    }
    on equipmentAssigned: event EquipmentAssigned is {
      do "apply EquipmentAssigned to the equipment so it can be persisted and replayed"
    }
    on equipmentDisposed: event EquipmentDisposed is {
      do "apply EquipmentDisposed to the equipment so it can be persisted and replayed"
    }
    on equipmentRegistered: event EquipmentRegistered is {
      do "apply EquipmentRegistered to the equipment so it can be persisted and replayed"
    }
    on equipmentReturned: event EquipmentReturned is {
      do "apply EquipmentReturned to the equipment so it can be persisted and replayed"
    }
    on locationUpdated: event LocationUpdated is {
      do "apply LocationUpdated to the equipment so it can be persisted and replayed"
    }
    on maintenanceCompleted: event MaintenanceCompleted is {
      do "apply MaintenanceCompleted to the equipment so it can be persisted and replayed"
    }
    on maintenanceScheduled: event MaintenanceScheduled is {
      do "apply MaintenanceScheduled to the equipment so it can be persisted and replayed"
    }
    on markedOutOfService: event MarkedOutOfService is {
      do "apply MarkedOutOfService to the equipment so it can be persisted and replayed"
    }
    on meterReadingRecorded: event MeterReadingRecorded is {
      do "apply MeterReadingRecorded to the equipment so it can be persisted and replayed"
    }
    on returnedToService: event ReturnedToService is {
      do "apply ReturnedToService to the equipment so it can be persisted and replayed"
    }
  } with {
    briefly "Processes equipment commands"
    described as {
      | Handles equipment lifecycle including registration,
      | assignment, maintenance, and disposal.
    }
  }
} with {
  briefly "Equipment aggregate"
  described as {
    | The Equipment entity manages construction equipment
    | lifecycle, location tracking, and maintenance history.
  }
}
