// Equipment Tracking - Equipment Context
context EquipmentContext is {
  adaptor FromJobSiteService from context JobSiteService is { 
    handler FromJobSiteServiceHandler is {
      on event JobSiteService.SiteClosed is {
        do "the model receives site closed"
      }
      on event JobSiteService.SiteCreated is {
        do "the model receives site created"
      }
      on other is {
        error "Unexpected message for adaptor FromJobSiteService"
      }
    } with {
      briefly "from job site service"
      described as {
        |Carries messages from the external JobSiteService.
      }
    }
  } with {
    briefly "JobSiteService integration"
    described as {
      |The model's side of the JobSiteService conversation.
    }
  }
  adaptor FromMaintenanceService from context MaintenanceService is { 
    handler FromMaintenanceServiceHandler is {
      on event MaintenanceService.WorkOrderCompleted is {
        do "the model receives work order completed"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceService"
      }
    } with {
      briefly "from maintenance service"
      described as {
        |Carries messages from the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendLocationAlert is {
        do "the model sends send location alert"
      }
      on command NotificationService.SendMaintenanceAlert is {
        do "the model sends send maintenance alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Equipment.riddl"
  // Adaptor for GPS tracking integration
  adaptor GPSAdapter from context GPSTrackingService is { 
    handler GPSEvents is {
      on event GPSTrackingService.LocationPing is {
        do "Update equipment location from GPS"
      }
      on other is {
        error "Unexpected message for adaptor GPSAdapter"
      }
    } with {
      briefly "Handles GPS events"
      described as {
        |Processes GPS location updates.
      }
    }
  } with {
    briefly "GPS tracking integration"
    described as {
      |Receives GPS location data.
    }
  }
  // Adaptor for maintenance system integration
  adaptor MaintenanceAdapter to context MaintenanceService is { 
    handler MaintenanceIntegration is {
      on command MaintenanceService.CreateWorkOrder is {
        do "Create work order in maintenance system"
      }
      on other is {
        error "Unexpected message for adaptor MaintenanceAdapter"
      }
    } with {
      briefly "Handles maintenance commands"
      described as {
        |Creates external work orders.
      }
    }
  } with {
    briefly "Maintenance system integration"
    described as {
      |Integrates with maintenance management.
    }
  }
  // Repository for equipment persistence
  repository EquipmentRepository as merge is {
    inlet EquipmentRepositoryFromEquipment is type EquipmentEvent    inlet EquipmentRepositoryFromFleetAnalytics is type EquipmentEvent    outlet EquipmentRepositoryResponses is type Equipment.EquipmentResult
    record StoredEquipment is  {
      equipmentId: EquipmentId with {
        briefly "equipmentId"
        described as {
          |The equipmentId column of the stored equipment row.
        }
      }
      equipmentType: EquipmentType with {
        briefly "equipmentType"
        described as {
          |The equipmentType column of the stored equipment row.
        }
      }
    } with {
      briefly "Stored equipment row"
      described as {
        |The persistence shape of equipment data as this repository stores it.
      }
    }
    schema EquipmentData is relational
      of equipment as type StoredEquipment
        index on field StoredEquipment.equipmentId
        index on field StoredEquipment.equipmentType
 with {
      briefly "Equipment data schema"
      described as {
        |The relational schema holding equipment data for the EquipmentRepository.
      }
    }
    handler EquipmentPersistence is {
      on query GetFleetUtilization is {
        do "read the fleet utilization projection"
        yield result FleetUtilizationView
      }
      on command Equipment.RegisterEquipment is {
        do "Store new equipment record"
      }
      on command Equipment.AssignToSite is {
        do "Update equipment assignment"
      }
      on command Equipment.ReturnFromSite is {
        do "Update equipment as available"
      }
      on command Equipment.UpdateLocation is {
        tell event Equipment.LocationUpdated to entity EquipmentContext.Equipment
        do "Update equipment location"
      }
      on command Equipment.CompleteMaintenance is {
        tell event Equipment.MaintenanceCompleted to entity EquipmentContext.Equipment
        do "Update maintenance history"
      }
      on command Equipment.DisposeEquipment is {
        do "Archive equipment record"
      }
    } with {
      briefly "Persists equipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Equipment data persistence"
    described as {
      | The EquipmentRepository provides persistent storage for
      | equipment records and location history.
    }
  }
  // Projector for fleet analytics
  query GetFleetUtilization is  {
    fleetUtilizationKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fleet utilization to retrieve.
      }
    }
  } with {
    briefly "Get fleet utilization"
    described as {
      |Retrieves the fleet utilization projection.
    }
  }
  result FleetUtilizationView is  {
    fleetUtilization: FleetAnalytics.FleetUtilization with {
      briefly "Fleet utilization"
      described as {
        |The fleet utilization being returned.
      }
    }
  } with {
    briefly "Fleet utilization view"
    described as {
      |Read model view carrying the fleet utilization projection.
    }
  }
  projector FleetAnalytics as flow is {
    updates repository EquipmentContext.EquipmentRepository
    inlet FleetAnalyticsFromEquipment is type EquipmentEvent    outlet FleetAnalyticsOut is type EquipmentEvent
    record FleetUtilization is  {
      equipmentType: EquipmentType with {
        briefly "Type"
        described as {
          |Equipment type.
        }
      }
      totalCount: Natural with {
        briefly "Total"
        described as {
          |Total equipment.
        }
      }
      assignedCount: Natural with {
        briefly "Assigned"
        described as {
          |Currently assigned.
        }
      }
      maintenanceCount: Natural with {
        briefly "Maintenance"
        described as {
          |In maintenance.
        }
      }
      utilizationRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Utilization percentage.
        }
      }
    } with {
      briefly "Fleet utilization"
      described as {
        |Equipment utilization metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Equipment.EquipmentAssigned is {
        tell event Equipment.EquipmentAssigned to repository EquipmentContext.EquipmentRepository
        do "Update utilization metrics"
      }
      on event Equipment.EquipmentReturned is {
        tell event Equipment.EquipmentReturned to repository EquipmentContext.EquipmentRepository
        do "Update utilization metrics"
      }
      on event Equipment.MaintenanceScheduled is {
        tell event Equipment.MaintenanceScheduled to repository EquipmentContext.EquipmentRepository
        do "Update maintenance metrics"
      }
    } with {
      briefly "Maintains fleet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Fleet analytics projections"
    described as {
      |Maintains fleet utilization data.
    }
  }
  // ---- Event publication for Equipment ----
  type EquipmentEvent is one of {
    EquipmentContext.Equipment.EquipmentRegistered or EquipmentContext.Equipment.EquipmentAssigned or EquipmentContext.Equipment.EquipmentReturned or EquipmentContext.Equipment.LocationUpdated or EquipmentContext.Equipment.MeterReadingRecorded or EquipmentContext.Equipment.MaintenanceScheduled or EquipmentContext.Equipment.MaintenanceCompleted or EquipmentContext.Equipment.MarkedOutOfService or EquipmentContext.Equipment.ReturnedToService or EquipmentContext.Equipment.EquipmentDisposed
  } with {
    briefly "Equipment event alternation"
    described as {
      |Union of all Equipment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EquipmentEventSource as source is {
    outlet EquipmentEvents is type EquipmentEvent
    handler EquipmentSourceHandler is {
      on event Equipment.EquipmentRegistered is {
        send event Equipment.EquipmentRegistered to outlet EquipmentEvents
      }
      on event Equipment.EquipmentAssigned is {
        send event Equipment.EquipmentAssigned to outlet EquipmentEvents
      }
      on event Equipment.EquipmentReturned is {
        send event Equipment.EquipmentReturned to outlet EquipmentEvents
      }
      on event Equipment.LocationUpdated is {
        send event Equipment.LocationUpdated to outlet EquipmentEvents
      }
      on event Equipment.MeterReadingRecorded is {
        send event Equipment.MeterReadingRecorded to outlet EquipmentEvents
      }
      on event Equipment.MaintenanceScheduled is {
        send event Equipment.MaintenanceScheduled to outlet EquipmentEvents
      }
      on event Equipment.MaintenanceCompleted is {
        send event Equipment.MaintenanceCompleted to outlet EquipmentEvents
      }
      on event Equipment.MarkedOutOfService is {
        send event Equipment.MarkedOutOfService to outlet EquipmentEvents
      }
      on event Equipment.ReturnedToService is {
        send event Equipment.ReturnedToService to outlet EquipmentEvents
      }
      on event Equipment.EquipmentDisposed is {
        send event Equipment.EquipmentDisposed to outlet EquipmentEvents
      }
      on other is {
        error "Unexpected message for source EquipmentEventSource"
      }
    } with {
      briefly "Equipment source handler"
      described as {
        |Publishes Equipment events onto the outlet.
      }
    }
  } with {
    briefly "Equipment event source"
    described as {
      |Publishes Equipment entity events into the streaming topology.
    }
  }
  processor EquipmentEventSink as sink is {
    inlet EquipmentInlet is type EquipmentEvent    handler EquipmentSinkHandler is {
      on event Equipment.EquipmentRegistered is {
        tell event Equipment.EquipmentRegistered to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.EquipmentAssigned is {
        tell event Equipment.EquipmentAssigned to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.EquipmentReturned is {
        tell event Equipment.EquipmentReturned to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.LocationUpdated is {
        tell event Equipment.LocationUpdated to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.MeterReadingRecorded is {
        tell event Equipment.MeterReadingRecorded to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.MaintenanceScheduled is {
        tell event Equipment.MaintenanceScheduled to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.MaintenanceCompleted is {
        tell event Equipment.MaintenanceCompleted to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.MarkedOutOfService is {
        tell event Equipment.MarkedOutOfService to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.ReturnedToService is {
        tell event Equipment.ReturnedToService to repository EquipmentContext.EquipmentRepository
      }
      on event Equipment.EquipmentDisposed is {
        tell event Equipment.EquipmentDisposed to repository EquipmentContext.EquipmentRepository
      }
      on other is {
        error "Unexpected message for sink EquipmentEventSink"
      }
    } with {
      briefly "Equipment sink handler"
      described as {
        |Persists Equipment events via the repository.
      }
    }
  } with {
    briefly "Equipment event sink"
    described as {
      |Receives Equipment events for persistence.
    }
  }
  connector EquipmentEventFlow is from outlet EquipmentContext.EquipmentEventSource.EquipmentEvents to inlet EquipmentContext.EquipmentEventSink.EquipmentInlet with {
    briefly "Equipment event flow"
    described as {
      |Connects the Equipment source to its sink.
    }
  }
  processor EquipmentEventSplit as split is {
    inlet EquipmentEventSplitIn is type EquipmentEvent    outlet EquipmentEventSplitToEquipmentRepository is type EquipmentEvent
    outlet EquipmentEventSplitToFleetAnalytics is type EquipmentEvent
    handler EquipmentEventSplitHandler is {
      on event Equipment.EquipmentRegistered is {
        send event Equipment.EquipmentRegistered to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.EquipmentRegistered to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.EquipmentRegistered to entity EquipmentContext.Equipment
      }
      on event Equipment.EquipmentAssigned is {
        send event Equipment.EquipmentAssigned to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.EquipmentAssigned to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.EquipmentAssigned to entity EquipmentContext.Equipment
      }
      on event Equipment.EquipmentReturned is {
        send event Equipment.EquipmentReturned to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.EquipmentReturned to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.EquipmentReturned to entity EquipmentContext.Equipment
      }
      on event Equipment.LocationUpdated is {
        send event Equipment.LocationUpdated to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.LocationUpdated to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.LocationUpdated to entity EquipmentContext.Equipment
      }
      on event Equipment.MeterReadingRecorded is {
        send event Equipment.MeterReadingRecorded to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.MeterReadingRecorded to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.MeterReadingRecorded to entity EquipmentContext.Equipment
      }
      on event Equipment.MaintenanceScheduled is {
        send event Equipment.MaintenanceScheduled to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.MaintenanceScheduled to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.MaintenanceScheduled to entity EquipmentContext.Equipment
      }
      on event Equipment.MaintenanceCompleted is {
        send event Equipment.MaintenanceCompleted to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.MaintenanceCompleted to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.MaintenanceCompleted to entity EquipmentContext.Equipment
      }
      on event Equipment.MarkedOutOfService is {
        send event Equipment.MarkedOutOfService to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.MarkedOutOfService to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.MarkedOutOfService to entity EquipmentContext.Equipment
      }
      on event Equipment.ReturnedToService is {
        send event Equipment.ReturnedToService to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.ReturnedToService to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.ReturnedToService to entity EquipmentContext.Equipment
      }
      on event Equipment.EquipmentDisposed is {
        send event Equipment.EquipmentDisposed to outlet EquipmentEventSplitToEquipmentRepository
        send event Equipment.EquipmentDisposed to outlet EquipmentEventSplitToFleetAnalytics
        tell event Equipment.EquipmentDisposed to entity EquipmentContext.Equipment
      }
      on other is {
        error "Unexpected message for processor EquipmentEventSplit"
      }
    } with {
      briefly "Equipment event fan-out handler"
      described as {
        |Delivers each Equipment event to all of its consumers.
      }
    }
  } with {
    briefly "Equipment event fan-out"
    described as {
      |Fans Equipment events out to the repository and projectors.
    }
  }
  connector 'EquipmentEvent Stream' is from outlet EquipmentContext.Equipment.EquipmentEvents2 to inlet EquipmentContext.EquipmentEventSplit.EquipmentEventSplitIn with {
    briefly "Equipment events, fanned out to storage and read models"
  }
  connector 'EquipmentEvent Storage' is from outlet EquipmentContext.EquipmentEventSplit.EquipmentEventSplitToEquipmentRepository to inlet EquipmentContext.EquipmentRepository.EquipmentRepositoryFromEquipment with {
    briefly "Equipment events on their way to storage"
  }
  connector 'FleetAnalytics Feed' is from outlet EquipmentContext.EquipmentEventSplit.EquipmentEventSplitToFleetAnalytics to inlet EquipmentContext.FleetAnalytics.FleetAnalyticsFromEquipment with {
    briefly "Equipment events feeding the FleetAnalytics projection"
  }
  connector 'FleetAnalytics Storage' is from outlet EquipmentContext.FleetAnalytics.FleetAnalyticsOut to inlet EquipmentContext.EquipmentRepository.EquipmentRepositoryFromFleetAnalytics with {
    briefly "The FleetAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for equipment tracking"
  described as {
    | The EquipmentContext is the bounded context for construction
    | equipment management including tracking, allocation, and maintenance.
  }
}
