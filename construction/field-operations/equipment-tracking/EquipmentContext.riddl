// Equipment Tracking - Equipment Context
context EquipmentContext as router is {
  inlet EquipmentCommandStreamIn is type EquipmentCommand  outlet EquipmentCommandStreamOut is type EquipmentCommand
  inlet EquipmentResultStreamIn is result Equipment.EquipmentResult  outlet EquipmentResultStreamOut is result Equipment.EquipmentResult
  handler EquipmentContextBoundary is {
    on registerEquipment: command Equipment.RegisterEquipment is {
      send registerEquipment to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on assignToSite: command Equipment.AssignToSite is {
      send assignToSite to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on returnFromSite: command Equipment.ReturnFromSite is {
      send returnFromSite to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on updateLocation: command Equipment.UpdateLocation is {
      send updateLocation to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on recordMeterReading: command Equipment.RecordMeterReading is {
      send recordMeterReading to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on scheduleMaintenance: command Equipment.ScheduleMaintenance is {
      send scheduleMaintenance to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on completeMaintenance: command Equipment.CompleteMaintenance is {
      send completeMaintenance to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on markOutOfService: command Equipment.MarkOutOfService is {
      send markOutOfService to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on returnToService: command Equipment.ReturnToService is {
      send returnToService to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on disposeEquipment: command Equipment.DisposeEquipment is {
      send disposeEquipment to outlet EquipmentContext.EquipmentCommandStreamOut
    }
    on equipmentResult: result Equipment.EquipmentResult is {
      send equipmentResult to outlet EquipmentContext.EquipmentResultStreamOut
    }
    on other is {
      error "Unexpected message at the EquipmentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EquipmentCommand Stream Intake' is from outlet EquipmentContext.EquipmentCommandStreamOut to inlet EquipmentContext.Equipment.EquipmentCommands  connector 'EquipmentResult Stream Egress' is from outlet EquipmentContext.EquipmentRepository.EquipmentRepositoryResponses to inlet EquipmentContext.EquipmentResultStreamIn  adaptor FromJobSiteService from context JobSiteService is { 
    handler FromJobSiteServiceHandler is {
      on event JobSiteService.SiteClosed is {
        do "the model receives site closed"
      }
      on event JobSiteService.SiteCreated is {
        do "the model receives site created"
      }
      on other is {
        error "Unexpected message for adaptor FromJobSiteService"
      }
    } with {
      briefly "from job site service"
      described as {
        |Carries messages from the external JobSiteService.
      }
    }
  } with {
    briefly "JobSiteService integration"
    described as {
      |The model's side of the JobSiteService conversation.
    }
  }
  adaptor FromMaintenanceService from context MaintenanceService is { 
    handler FromMaintenanceServiceHandler is {
      on event MaintenanceService.WorkOrderCompleted is {
        do "the model receives work order completed"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceService"
      }
    } with {
      briefly "from maintenance service"
      described as {
        |Carries messages from the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendLocationAlert is {
        do "the model sends send location alert"
      }
      on command NotificationService.SendMaintenanceAlert is {
        do "the model sends send maintenance alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  include "types.riddl"
  include "Equipment.riddl"
  // Adaptor for GPS tracking integration
  adaptor GPSAdapter from context GPSTrackingService is { 
    handler GPSEvents is {
      on event GPSTrackingService.LocationPing is {
        do "Update equipment location from GPS"
      }
      on other is {
        error "Unexpected message for adaptor GPSAdapter"
      }
    } with {
      briefly "Handles GPS events"
      described as {
        |Processes GPS location updates.
      }
    }
  } with {
    briefly "GPS tracking integration"
    described as {
      |Receives GPS location data.
    }
  }
  // Adaptor for maintenance system integration
  adaptor MaintenanceAdapter to context MaintenanceService is { 
    handler MaintenanceIntegration is {
      on command MaintenanceService.CreateWorkOrder is {
        do "Create work order in maintenance system"
      }
      on other is {
        error "Unexpected message for adaptor MaintenanceAdapter"
      }
    } with {
      briefly "Handles maintenance commands"
      described as {
        |Creates external work orders.
      }
    }
  } with {
    briefly "Maintenance system integration"
    described as {
      |Integrates with maintenance management.
    }
  }
  // Repository for equipment persistence
  type EquipmentRepositoryCommand is one of {
    EquipmentContext.EquipmentRepository.PersistEquipmentAssigned or EquipmentContext.EquipmentRepository.PersistEquipmentDisposed or EquipmentContext.EquipmentRepository.PersistEquipmentRegistered or EquipmentContext.EquipmentRepository.PersistEquipmentReturned or EquipmentContext.EquipmentRepository.PersistLocationUpdated or EquipmentContext.EquipmentRepository.PersistMaintenanceCompleted or EquipmentContext.EquipmentRepository.PersistMaintenanceScheduled or EquipmentContext.EquipmentRepository.PersistMarkedOutOfService or EquipmentContext.EquipmentRepository.PersistMeterReadingRecorded or EquipmentContext.EquipmentRepository.PersistReturnedToService
  } with {
    briefly "Anything that writes EquipmentRepository"
    described as {
      |The persistence commands EquipmentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository EquipmentRepository as flow is {
    inlet EquipmentRepositoryFromFleetAnalytics is type EquipmentRepositoryCommand
    command PersistEquipmentDisposed is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentDisposed applies to.
        }
      }
    } with {
      briefly "Persist EquipmentDisposed"
      described as {
        |Instructs this repository to apply EquipmentDisposed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEquipmentRegistered is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentRegistered applies to.
        }
      }
    } with {
      briefly "Persist EquipmentRegistered"
      described as {
        |Instructs this repository to apply EquipmentRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLocationUpdated is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row LocationUpdated applies to.
        }
      }
    } with {
      briefly "Persist LocationUpdated"
      described as {
        |Instructs this repository to apply LocationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceCompleted is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceCompleted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceCompleted"
      described as {
        |Instructs this repository to apply MaintenanceCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMarkedOutOfService is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MarkedOutOfService applies to.
        }
      }
    } with {
      briefly "Persist MarkedOutOfService"
      described as {
        |Instructs this repository to apply MarkedOutOfService to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeterReadingRecorded is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeterReadingRecorded applies to.
        }
      }
    } with {
      briefly "Persist MeterReadingRecorded"
      described as {
        |Instructs this repository to apply MeterReadingRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnedToService is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnedToService applies to.
        }
      }
    } with {
      briefly "Persist ReturnedToService"
      described as {
        |Instructs this repository to apply ReturnedToService to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEquipmentAssigned is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentAssigned applies to.
        }
      }
    } with {
      briefly "Persist EquipmentAssigned"
      described as {
        |Instructs this repository to apply EquipmentAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEquipmentReturned is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row EquipmentReturned applies to.
        }
      }
    } with {
      briefly "Persist EquipmentReturned"
      described as {
        |Instructs this repository to apply EquipmentReturned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceScheduled is  {
      equipmentId: EquipmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceScheduled applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceScheduled"
      described as {
        |Instructs this repository to apply MaintenanceScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet EquipmentRepositoryResponses is result Equipment.EquipmentResult
    record StoredEquipment is  {
      equipmentId: EquipmentId with {
        briefly "equipmentId"
        described as {
          |The equipmentId column of the stored equipment row.
        }
      }
      equipmentType: EquipmentType with {
        briefly "equipmentType"
        described as {
          |The equipmentType column of the stored equipment row.
        }
      }
    } with {
      briefly "Stored equipment row"
      described as {
        |The persistence shape of equipment data as this repository stores it.
      }
    }
    schema EquipmentData is relational
      of equipment as record StoredEquipment
        index on field StoredEquipment.equipmentId
        index on field StoredEquipment.equipmentType
 with {
      briefly "Equipment data schema"
      described as {
        |The relational schema holding equipment data for the EquipmentRepository.
      }
    }
    handler EquipmentPersistence is {
      on persistEquipmentDisposed: command PersistEquipmentDisposed is {
        do "apply EquipmentDisposed to the stored row"
      }
      on persistEquipmentRegistered: command PersistEquipmentRegistered is {
        do "apply EquipmentRegistered to the stored row"
      }
      on persistLocationUpdated: command PersistLocationUpdated is {
        do "apply LocationUpdated to the stored row"
      }
      on persistMaintenanceCompleted: command PersistMaintenanceCompleted is {
        do "apply MaintenanceCompleted to the stored row"
      }
      on persistMarkedOutOfService: command PersistMarkedOutOfService is {
        do "apply MarkedOutOfService to the stored row"
      }
      on persistMeterReadingRecorded: command PersistMeterReadingRecorded is {
        do "apply MeterReadingRecorded to the stored row"
      }
      on persistReturnedToService: command PersistReturnedToService is {
        do "apply ReturnedToService to the stored row"
      }
      on persistEquipmentAssigned: command PersistEquipmentAssigned is {
        do "apply EquipmentAssigned to the stored row"
      }
      on persistEquipmentReturned: command PersistEquipmentReturned is {
        do "apply EquipmentReturned to the stored row"
      }
      on persistMaintenanceScheduled: command PersistMaintenanceScheduled is {
        do "apply MaintenanceScheduled to the stored row"
      }
      on query GetFleetUtilization is {
        let fleetUtilizationView: type FleetUtilizationView = prompt("read the fleet utilization projection")
        reply fleetUtilizationView
      }
    } with {
      briefly "Persists equipment commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Equipment data persistence"
    described as {
      | The EquipmentRepository provides persistent storage for
      | equipment records and location history.
    }
  }
  // Projector for fleet analytics
  query GetFleetUtilization replies result FleetUtilizationView is  {
    fleetUtilizationKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which fleet utilization to retrieve.
      }
    }
  } with {
    briefly "Get fleet utilization"
    described as {
      |Retrieves the fleet utilization projection.
    }
  }
  result FleetUtilizationView is  {
    fleetUtilization: FleetAnalytics.FleetUtilization with {
      briefly "Fleet utilization"
      described as {
        |The fleet utilization being returned.
      }
    }
  } with {
    briefly "Fleet utilization view"
    described as {
      |Read model view carrying the fleet utilization projection.
    }
  }
  projector FleetAnalytics as flow is {
    outlet FleetAnalyticsToRepository is type EquipmentRepositoryCommand
    updates repository EquipmentContext.EquipmentRepository
    inlet FleetAnalyticsFromEquipment is type EquipmentEvent
    record FleetUtilization is  {
      equipmentType: EquipmentType with {
        briefly "Type"
        described as {
          |Equipment type.
        }
      }
      totalCount: Natural with {
        briefly "Total"
        described as {
          |Total equipment.
        }
      }
      assignedCount: Natural with {
        briefly "Assigned"
        described as {
          |Currently assigned.
        }
      }
      maintenanceCount: Natural with {
        briefly "Maintenance"
        described as {
          |In maintenance.
        }
      }
      utilizationRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Utilization percentage.
        }
      }
    } with {
      briefly "Fleet utilization"
      described as {
        |Equipment utilization metrics.
      }
    }
    handler AnalyticsHandler is {
      on equipmentDisposed: event Equipment.EquipmentDisposed is {
        tell command EquipmentContext.EquipmentRepository.PersistEquipmentDisposed(equipmentId = equipmentDisposed.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "apply EquipmentDisposed to the FleetAnalytics projection"
      }
      on equipmentRegistered: event Equipment.EquipmentRegistered is {
        tell command EquipmentContext.EquipmentRepository.PersistEquipmentRegistered(equipmentId = equipmentRegistered.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "apply EquipmentRegistered to the FleetAnalytics projection"
      }
      on locationUpdated: event Equipment.LocationUpdated is {
        tell command EquipmentContext.EquipmentRepository.PersistLocationUpdated(equipmentId = locationUpdated.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "apply LocationUpdated to the FleetAnalytics projection"
      }
      on maintenanceCompleted: event Equipment.MaintenanceCompleted is {
        tell command EquipmentContext.EquipmentRepository.PersistMaintenanceCompleted(equipmentId = maintenanceCompleted.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "apply MaintenanceCompleted to the FleetAnalytics projection"
      }
      on markedOutOfService: event Equipment.MarkedOutOfService is {
        tell command EquipmentContext.EquipmentRepository.PersistMarkedOutOfService(equipmentId = markedOutOfService.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "apply MarkedOutOfService to the FleetAnalytics projection"
      }
      on meterReadingRecorded: event Equipment.MeterReadingRecorded is {
        tell command EquipmentContext.EquipmentRepository.PersistMeterReadingRecorded(equipmentId = meterReadingRecorded.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "apply MeterReadingRecorded to the FleetAnalytics projection"
      }
      on returnedToService: event Equipment.ReturnedToService is {
        tell command EquipmentContext.EquipmentRepository.PersistReturnedToService(equipmentId = returnedToService.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "apply ReturnedToService to the FleetAnalytics projection"
      }
      on equipmentAssigned: event Equipment.EquipmentAssigned is {
        tell command EquipmentContext.EquipmentRepository.PersistEquipmentAssigned(equipmentId = equipmentAssigned.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "Update utilization metrics"
      }
      on equipmentReturned: event Equipment.EquipmentReturned is {
        tell command EquipmentContext.EquipmentRepository.PersistEquipmentReturned(equipmentId = equipmentReturned.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "Update utilization metrics"
      }
      on maintenanceScheduled: event Equipment.MaintenanceScheduled is {
        tell command EquipmentContext.EquipmentRepository.PersistMaintenanceScheduled(equipmentId = maintenanceScheduled.equipmentId) to repository EquipmentContext.EquipmentRepository
        do "Update maintenance metrics"
      }
    } with {
      briefly "Maintains fleet analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Fleet analytics projections"
    described as {
      |Maintains fleet utilization data.
    }
  }
  // ---- Event publication for Equipment ----
  type EquipmentEvent is one of {
    EquipmentContext.Equipment.EquipmentRegistered or EquipmentContext.Equipment.EquipmentAssigned or EquipmentContext.Equipment.EquipmentReturned or EquipmentContext.Equipment.LocationUpdated or EquipmentContext.Equipment.MeterReadingRecorded or EquipmentContext.Equipment.MaintenanceScheduled or EquipmentContext.Equipment.MaintenanceCompleted or EquipmentContext.Equipment.MarkedOutOfService or EquipmentContext.Equipment.ReturnedToService or EquipmentContext.Equipment.EquipmentDisposed
  } with {
    briefly "Equipment event alternation"
    described as {
      |Union of all Equipment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EquipmentEventSplit as flow is {
    inlet EquipmentEventSplitIn is type EquipmentEvent
    outlet EquipmentEventSplitToFleetAnalytics is type EquipmentEvent
    handler EquipmentEventSplitHandler is {
      on equipmentRegistered: event Equipment.EquipmentRegistered is {
        send equipmentRegistered to outlet EquipmentEventSplitToFleetAnalytics
        tell equipmentRegistered to entity EquipmentContext.Equipment
      }
      on equipmentAssigned: event Equipment.EquipmentAssigned is {
        send equipmentAssigned to outlet EquipmentEventSplitToFleetAnalytics
        tell equipmentAssigned to entity EquipmentContext.Equipment
      }
      on equipmentReturned: event Equipment.EquipmentReturned is {
        send equipmentReturned to outlet EquipmentEventSplitToFleetAnalytics
        tell equipmentReturned to entity EquipmentContext.Equipment
      }
      on locationUpdated: event Equipment.LocationUpdated is {
        send locationUpdated to outlet EquipmentEventSplitToFleetAnalytics
        tell locationUpdated to entity EquipmentContext.Equipment
      }
      on meterReadingRecorded: event Equipment.MeterReadingRecorded is {
        send meterReadingRecorded to outlet EquipmentEventSplitToFleetAnalytics
        tell meterReadingRecorded to entity EquipmentContext.Equipment
      }
      on maintenanceScheduled: event Equipment.MaintenanceScheduled is {
        send maintenanceScheduled to outlet EquipmentEventSplitToFleetAnalytics
        tell maintenanceScheduled to entity EquipmentContext.Equipment
      }
      on maintenanceCompleted: event Equipment.MaintenanceCompleted is {
        send maintenanceCompleted to outlet EquipmentEventSplitToFleetAnalytics
        tell maintenanceCompleted to entity EquipmentContext.Equipment
      }
      on markedOutOfService: event Equipment.MarkedOutOfService is {
        send markedOutOfService to outlet EquipmentEventSplitToFleetAnalytics
        tell markedOutOfService to entity EquipmentContext.Equipment
      }
      on returnedToService: event Equipment.ReturnedToService is {
        send returnedToService to outlet EquipmentEventSplitToFleetAnalytics
        tell returnedToService to entity EquipmentContext.Equipment
      }
      on equipmentDisposed: event Equipment.EquipmentDisposed is {
        send equipmentDisposed to outlet EquipmentEventSplitToFleetAnalytics
        tell equipmentDisposed to entity EquipmentContext.Equipment
      }
      on other is {
        error "Unexpected message for processor EquipmentEventSplit"
      }
    } with {
      briefly "Equipment event fan-out handler"
      described as {
        |Delivers each Equipment event to all of its consumers.
      }
    }
  } with {
    briefly "Equipment event fan-out"
    described as {
      |Fans Equipment events out to the repository and projectors.
    }
  }
  connector 'EquipmentEvent Stream' is from outlet EquipmentContext.Equipment.EquipmentEvents2 to inlet EquipmentContext.EquipmentEventSplit.EquipmentEventSplitIn with {
    briefly "Equipment events, fanned out to storage and read models"
  }
  connector 'FleetAnalytics Feed' is from outlet EquipmentContext.EquipmentEventSplit.EquipmentEventSplitToFleetAnalytics to inlet EquipmentContext.FleetAnalytics.FleetAnalyticsFromEquipment with {
    briefly "Equipment events feeding the FleetAnalytics projection"
  }
  connector 'FleetAnalytics Storage' is from outlet EquipmentContext.FleetAnalytics.FleetAnalyticsToRepository to inlet EquipmentContext.EquipmentRepository.EquipmentRepositoryFromFleetAnalytics with {
    briefly "FleetAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for equipment tracking"
  described as {
    | The EquipmentContext is the bounded context for construction
    | equipment management including tracking, allocation, and maintenance.
  }
}
