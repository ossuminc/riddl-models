// Job Site Management - JobSite Entity
entity JobSite as flow is {
  type JobSiteCommand is one of {
    JobSite.EstablishSite or JobSite.ActivateSite or JobSite.AssignCrew or JobSite.RemoveCrew or JobSite.SubmitDailyReport or JobSite.RecordSafetyInspection or JobSite.ReportIssue or JobSite.ResolveIssue or JobSite.SuspendSite or JobSite.ResumeSite or JobSite.CompleteSite or JobSite.CloseSite
  } with {
    briefly "JobSite command alternation"
    described as {
      |Commands accepted by the JobSite entity.
    }
  }
  inlet JobSiteCommands is type JobSiteCommand  outlet JobSiteEvents2 is type JobSiteEvent
  query GetJobSite is  {
    jobSiteId: JobSiteId with {
      briefly "ID"
      described as {
        |Identifier of the JobSite to retrieve.
      }
    }
  } with {
    briefly "Get JobSite"
    described as {
      |Retrieve JobSite data by identifier.
    }
  }
  result JobSiteResult is  {
    jobSiteId: JobSiteId with {
      briefly "JobSite addressed"
      described as {
        |Which jobsite this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    jobSiteData: JobSite.PreConstructionSiteData with {
      briefly "JobSite data"
      described as {
        |The requested JobSite data.
      }
    }
  } with {
    briefly "JobSite result"
    described as {
      |Result carrying the requested JobSite data.
    }
  }
  // Commands
  command EstablishSite is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |New site identifier.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Associated project.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Site name.
      }
    }
    location: GeoLocation with {
      briefly "Location"
      described as {
        |Site location.
      }
    }
    startDate: Date with {
      briefly "Start"
      described as {
        |Planned start date.
      }
    }
  } with {
    briefly "Establish site"
    described as {
      |Creates a new job site.
    }
  }
  command ActivateSite is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site to activate.
      }
    }
    activatedBy: String(1,100) with {
      briefly "Activated by"
      described as {
        |Who activated.
      }
    }
  } with {
    briefly "Activate site"
    described as {
      |Activates site for construction.
    }
  }
  command AssignCrew is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site ID.
      }
    }
    crew: Crew with {
      briefly "Crew"
      described as {
        |Crew to assign.
      }
    }
    assignedDate: Date with {
      briefly "Date"
      described as {
        |Assignment date.
      }
    }
  } with {
    briefly "Assign crew"
    described as {
      |Assigns a crew to the site.
    }
  }
  command RemoveCrew is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site ID.
      }
    }
    crewId: CrewId with {
      briefly "Crew"
      described as {
        |Crew to remove.
      }
    }
  } with {
    briefly "Remove crew"
    described as {
      |Removes a crew from the site.
    }
  }
  command SubmitDailyReport is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site ID.
      }
    }
    report: DailyReport with {
      briefly "Report"
      described as {
        |Daily report data.
      }
    }
  } with {
    briefly "Submit daily report"
    described as {
      |Submits daily progress report.
    }
  }
  command RecordSafetyInspection is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site ID.
      }
    }
    inspection: SafetyInspection with {
      briefly "Inspection"
      described as {
        |Inspection data.
      }
    }
  } with {
    briefly "Record safety inspection"
    described as {
      |Records a safety inspection.
    }
  }
  command ReportIssue is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site ID.
      }
    }
    issue: SiteIssue with {
      briefly "Issue"
      described as {
        |Issue to report.
      }
    }
  } with {
    briefly "Report issue"
    described as {
      |Reports a site issue.
    }
  }
  command ResolveIssue is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site ID.
      }
    }
    issueId: UUID with {
      briefly "Issue ID"
      described as {
        |Issue to resolve.
      }
    }
    resolution: String(1,1000) with {
      briefly "Resolution"
      described as {
        |How resolved.
      }
    }
    resolvedBy: String(1,100) with {
      briefly "Resolved by"
      described as {
        |Who resolved.
      }
    }
  } with {
    briefly "Resolve issue"
    described as {
      |Resolves a reported issue.
    }
  }
  command SuspendSite is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site to suspend.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
    suspendedBy: String(1,100) with {
      briefly "Suspended by"
      described as {
        |Who suspended.
      }
    }
  } with {
    briefly "Suspend site"
    described as {
      |Suspends site operations.
    }
  }
  command ResumeSite is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site to resume.
      }
    }
    resumedBy: String(1,100) with {
      briefly "Resumed by"
      described as {
        |Who resumed.
      }
    }
  } with {
    briefly "Resume site"
    described as {
      |Resumes site operations.
    }
  }
  command CompleteSite is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site to complete.
      }
    }
    completedBy: String(1,100) with {
      briefly "Completed by"
      described as {
        |Who marked complete.
      }
    }
  } with {
    briefly "Complete site"
    described as {
      |Marks site as construction complete.
    }
  }
  command CloseSite is  {
    jobSiteId: JobSiteId with {
      briefly "Site ID"
      described as {
        |Site to close.
      }
    }
    closedBy: String(1,100) with {
      briefly "Closed by"
      described as {
        |Who closed.
      }
    }
  } with {
    briefly "Close site"
    described as {
      |Closes site permanently.
    }
  }
  // Events
  event SiteEstablished is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Site name.
      }
    }
    establishedAt: TimeStamp with {
      briefly "Established"
      described as {
        |Establishment time.
      }
    }
  } with {
    briefly "Site was established"
    described as {
      |Emitted when job site is created.
    }
  }
  event SiteActivated is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Site was activated"
    described as {
      |Emitted when site becomes active.
    }
  }
  event CrewAssigned is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    crew: Crew with {
      briefly "Crew"
      described as {
        |Assigned crew.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned"
      described as {
        |Assignment time.
      }
    }
  } with {
    briefly "Crew was assigned"
    described as {
      |Emitted when crew is assigned.
    }
  }
  event CrewRemoved is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    crewId: CrewId with {
      briefly "Crew"
      described as {
        |Removed crew.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |Removal time.
      }
    }
  } with {
    briefly "Crew was removed"
    described as {
      |Emitted when crew is removed.
    }
  }
  event DailyReportSubmitted is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    report: DailyReport with {
      briefly "Report"
      described as {
        |Submitted report.
      }
    }
  } with {
    briefly "Daily report was submitted"
    described as {
      |Emitted when report is submitted.
    }
  }
  event SafetyInspectionRecorded is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    inspection: SafetyInspection with {
      briefly "Inspection"
      described as {
        |Inspection data.
      }
    }
  } with {
    briefly "Safety inspection was recorded"
    described as {
      |Emitted when inspection is recorded.
    }
  }
  event IssueReported is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    issue: SiteIssue with {
      briefly "Issue"
      described as {
        |Reported issue.
      }
    }
  } with {
    briefly "Issue was reported"
    described as {
      |Emitted when issue is reported.
    }
  }
  event IssueResolved is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    issueId: UUID with {
      briefly "Issue"
      described as {
        |Issue ID.
      }
    }
    resolvedAt: TimeStamp with {
      briefly "Resolved"
      described as {
        |Resolution time.
      }
    }
  } with {
    briefly "Issue was resolved"
    described as {
      |Emitted when issue is resolved.
    }
  }
  event SiteSuspended is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspension time.
      }
    }
  } with {
    briefly "Site was suspended"
    described as {
      |Emitted when site is suspended.
    }
  }
  event SiteResumed is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    resumedAt: TimeStamp with {
      briefly "Resumed"
      described as {
        |Resume time.
      }
    }
  } with {
    briefly "Site was resumed"
    described as {
      |Emitted when site resumes.
    }
  }
  event SiteCompleted is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Site was completed"
    described as {
      |Emitted when construction completes.
    }
  }
  event SiteClosed is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Close time.
      }
    }
  } with {
    briefly "Site was closed"
    described as {
      |Emitted when site is closed.
    }
  }
  // State Records
  record PreConstructionSiteData is  {
    stateValue: SiteStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Site name.
      }
    }
    location: GeoLocation with {
      briefly "Location"
      described as {
        |Site location.
      }
    }
    plannedStart: Date with {
      briefly "Start"
      described as {
        |Planned start.
      }
    }
    establishedAt: TimeStamp with {
      briefly "Established"
      described as {
        |Established time.
      }
    }
  } with {
    briefly "Pre-construction site data"
    described as {
      |State data for site before construction.
    }
  }
  record ActiveSiteData is  {
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Site name.
      }
    }
    location: GeoLocation with {
      briefly "Location"
      described as {
        |Site location.
      }
    }
    crews: Crew+ with {
      briefly "Crews"
      described as {
        |Assigned crews.
      }
    }
    dailyReports: DailyReport+ with {
      briefly "Reports"
      described as {
        |Daily reports.
      }
    }
    inspections: SafetyInspection+ with {
      briefly "Inspections"
      described as {
        |Safety inspections.
      }
    }
    openIssues: SiteIssue+ with {
      briefly "Issues"
      described as {
        |Open issues.
      }
    }
    activatedAt: TimeStamp with {
      briefly "Activated"
      described as {
        |Activation time.
      }
    }
  } with {
    briefly "Active site data"
    described as {
      |State data for active construction site.
    }
  }
  record SuspendedSiteData is  {
    stateValue: SiteStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Site name.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Suspension reason.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended"
      described as {
        |Suspension time.
      }
    }
  } with {
    briefly "Suspended site data"
    described as {
      |State data for suspended site.
    }
  }
  record CompletedSiteData is  {
    stateValue: SiteStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Site name.
      }
    }
    totalReports: Natural with {
      briefly "Reports"
      described as {
        |Total daily reports.
      }
    }
    totalInspections: Natural with {
      briefly "Inspections"
      described as {
        |Total inspections.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Completed site data"
    described as {
      |State data for completed site.
    }
  }
  record ClosedSiteData is  {
    stateValue: SiteStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    jobSiteId: JobSiteId with {
      briefly "Site"
      described as {
        |Site ID.
      }
    }
    projectId: ProjectId with {
      briefly "Project"
      described as {
        |Project ID.
      }
    }
    name: String(1,200) with {
      briefly "Name"
      described as {
        |Site name.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed"
      described as {
        |Close time.
      }
    }
  } with {
    briefly "Closed site data"
    described as {
      |State data for closed site.
    }
  }
  // States
  initial state PreConstructionState of record JobSite.PreConstructionSiteData is {
    initial handler PreConstructionStateInitHandler is {
      on query GetJobSite is {
        let jobSiteResult: type JobSiteResult = prompt("read the job site from the store")
        tell jobSiteResult to entity JobSiteContext.JobSite
      }
      on init is {
        set state PreConstructionState to "initialize from prior event"
        set field PreConstructionSiteData.stateValue to "PreConstruction"
      }
    } with {
      briefly "PreConstructionState init handler"
      described as {
        |Initializes the PreConstructionState state.
      }
    }
  } with {
    briefly "PreConstructionState state"
    described as {
      |The PreConstructionState state of the JobSite.
    }
  }
  state ActiveState of record JobSite.ActiveSiteData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from prior event"
      }
    } with {
      briefly "ActiveState init handler"
      described as {
        |Initializes the ActiveState state.
      }
    }
  } with {
    briefly "ActiveState state"
    described as {
      |The ActiveState state of the JobSite.
    }
  }
  state SuspendedState of record JobSite.SuspendedSiteData is {
    initial handler SuspendedStateInitHandler is {
      on init is {
        set state SuspendedState to "initialize from prior event"
        set field SuspendedSiteData.stateValue to "Suspended"
      }
    } with {
      briefly "SuspendedState init handler"
      described as {
        |Initializes the SuspendedState state.
      }
    }
  } with {
    briefly "SuspendedState state"
    described as {
      |The SuspendedState state of the JobSite.
    }
  }
  state CompletedState of record JobSite.CompletedSiteData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from prior event"
        set field CompletedSiteData.stateValue to "Completed"
      }
    } with {
      briefly "CompletedState init handler"
      described as {
        |Initializes the CompletedState state.
      }
    }
  } with {
    briefly "CompletedState state"
    described as {
      |The CompletedState state of the JobSite.
    }
  }
  state ClosedState of record JobSite.ClosedSiteData is {
    initial handler ClosedStateInitHandler is {
      on init is {
        set state ClosedState to "initialize from prior event"
        set field ClosedSiteData.stateValue to "Closed"
      }
    } with {
      briefly "ClosedState init handler"
      described as {
        |Initializes the ClosedState state.
      }
    }
  } with {
    briefly "ClosedState state"
    described as {
      |The ClosedState state of the JobSite.
    }
  }
  // Handler
  handler JobSiteHandler is {
    on establishSite: command EstablishSite is {
      morph entity JobSiteContext.JobSite to state JobSiteContext.JobSite.PreConstructionState with record JobSite.PreConstructionSiteData(jobSiteId = establishSite.jobSiteId, projectId = establishSite.projectId, name = establishSite.name, location = establishSite.location)
      tell event SiteEstablished(jobSiteId = establishSite.jobSiteId, projectId = establishSite.projectId, name = establishSite.name) to entity JobSiteContext.JobSite
    }
    on activateSite: command ActivateSite is {
      morph entity JobSiteContext.JobSite to state JobSiteContext.JobSite.ActiveState with record JobSite.ActiveSiteData(jobSiteId = activateSite.jobSiteId)
      tell event SiteActivated(jobSiteId = activateSite.jobSiteId) to entity JobSiteContext.JobSite
    }
    on assignCrew: command AssignCrew is {
      tell event CrewAssigned(jobSiteId = assignCrew.jobSiteId, crew = assignCrew.crew) to entity JobSiteContext.JobSite
    }
    on removeCrew: command RemoveCrew is {
      tell event CrewRemoved(jobSiteId = removeCrew.jobSiteId, crewId = removeCrew.crewId) to entity JobSiteContext.JobSite
    }
    on submitDailyReport: command SubmitDailyReport is {
      tell event DailyReportSubmitted(jobSiteId = submitDailyReport.jobSiteId, report = submitDailyReport.report) to entity JobSiteContext.JobSite
    }
    on recordSafetyInspection: command RecordSafetyInspection is {
      tell event SafetyInspectionRecorded(jobSiteId = recordSafetyInspection.jobSiteId, inspection = recordSafetyInspection.inspection) to entity JobSiteContext.JobSite
    }
    on reportIssue: command ReportIssue is {
      tell event IssueReported(jobSiteId = reportIssue.jobSiteId, issue = reportIssue.issue) to entity JobSiteContext.JobSite
    }
    on resolveIssue: command ResolveIssue is {
      tell event IssueResolved(jobSiteId = resolveIssue.jobSiteId, issueId = resolveIssue.issueId) to entity JobSiteContext.JobSite
    }
    on suspendSite: command SuspendSite is {
      morph entity JobSiteContext.JobSite to state JobSiteContext.JobSite.SuspendedState with record JobSite.SuspendedSiteData(jobSiteId = suspendSite.jobSiteId, reason = suspendSite.reason)
      tell event SiteSuspended(jobSiteId = suspendSite.jobSiteId, reason = suspendSite.reason) to entity JobSiteContext.JobSite
    }
    on resumeSite: command ResumeSite is {
      morph entity JobSiteContext.JobSite to state JobSiteContext.JobSite.ActiveState with record JobSite.ActiveSiteData(jobSiteId = resumeSite.jobSiteId)
      tell event SiteResumed(jobSiteId = resumeSite.jobSiteId) to entity JobSiteContext.JobSite
    }
    on completeSite: command CompleteSite is {
      morph entity JobSiteContext.JobSite to state JobSiteContext.JobSite.CompletedState with record JobSite.CompletedSiteData(jobSiteId = completeSite.jobSiteId)
      tell event SiteCompleted(jobSiteId = completeSite.jobSiteId) to entity JobSiteContext.JobSite
    }
    on closeSite: command CloseSite is {
      morph entity JobSiteContext.JobSite to state JobSiteContext.JobSite.ClosedState with record JobSite.ClosedSiteData(jobSiteId = closeSite.jobSiteId)
      tell event SiteClosed(jobSiteId = closeSite.jobSiteId) to entity JobSiteContext.JobSite
    }
  } with {
    briefly "Processes job site commands"
    described as {
      | Handles job site lifecycle including establishment,
      | daily operations, safety, and closure.
    }
  }
} with {
  briefly "Job site aggregate"
  described as {
    | The JobSite entity manages construction job site
    | lifecycle, daily reporting, and safety compliance.
  }
}
