// Job Site Management - JobSite Context
context JobSiteContext is {
  include "types.riddl"
  include "JobSite.riddl"
  // Adaptor for weather service integration
  adaptor WeatherAdapter from context WeatherService is { 
    handler WeatherEvents is {
      on event WeatherService.WeatherAlert is {
        prompt "Notify site of weather conditions"
      }
      on other is {
        error "Unexpected message for adaptor WeatherAdapter"
      }
    } with {
      briefly "Handles weather events"
      described as {
        |Processes weather alerts for sites.
      }
    }
  } with {
    briefly "Weather service integration"
    described as {
      |Receives weather data and alerts.
    }
  }
  // Adaptor for project service integration
  adaptor ProjectAdapter from context ProjectService is { 
    handler ProjectEvents is {
      on event ProjectService.ProjectUpdated is {
        prompt "Update site with project changes"
      }
      on other is {
        error "Unexpected message for adaptor ProjectAdapter"
      }
    } with {
      briefly "Handles project events"
      described as {
        |Syncs site with project updates.
      }
    }
  } with {
    briefly "Project service integration"
    described as {
      |Receives project updates.
    }
  }
  // Repository for job site persistence
  repository JobSiteRepository is {
    schema JobSiteData is relational
      of sites as type JobSite
        index on field JobSite.jobSiteId
        index on field JobSite.projectId

    handler JobSitePersistence is {
      on command JobSite.EstablishSite is {
        prompt "Store new job site record"
      }
      on command JobSite.ActivateSite is {
        prompt "Update site status to active"
      }
      on command JobSite.SubmitDailyReport is {
        tell event JobSite.DailyReportSubmitted to entity JobSiteContext.JobSite
        prompt "Store daily report"
      }
      on command JobSite.RecordSafetyInspection is {
        tell event JobSite.SafetyInspectionRecorded to entity JobSiteContext.JobSite
        prompt "Store inspection record"
      }
      on command JobSite.ReportIssue is {
        prompt "Store issue record"
      }
      on command JobSite.CloseSite is {
        tell event JobSite.SiteClosed to entity JobSiteContext.JobSite
        prompt "Archive site record"
      }
    } with {
      briefly "Persists job site events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Job site data persistence"
    described as {
      | The JobSiteRepository provides persistent storage for
      | job sites, daily reports, and inspections.
    }
  }
  // Projector for site analytics
  projector SiteAnalytics is {
    updates repository JobSiteContext.JobSiteRepository
    record SiteSummary is  {
      jobSiteId: JobSiteId with {
        briefly "Site"
        described as {
          |Site ID.
        }
      }
      totalLaborHours: Decimal(10,2) with {
        briefly "Hours"
        described as {
          |Total labor hours.
        }
      }
      openIssueCount: Natural with {
        briefly "Issues"
        described as {
          |Open issue count.
        }
      }
      lastInspectionDate: Date? with {
        briefly "Inspection"
        described as {
          |Last inspection.
        }
      }
      inspectionStatus: InspectionStatus? with {
        briefly "Status"
        described as {
          |Last inspection status.
        }
      }
    } with {
      briefly "Site summary"
      described as {
        |Job site summary metrics.
      }
    }
    handler AnalyticsHandler is {
      on event JobSite.DailyReportSubmitted is {
        tell event JobSite.DailyReportSubmitted to repository JobSiteContext.JobSiteRepository
        prompt "Update labor hour totals"
      }
      on event JobSite.IssueReported is {
        tell event JobSite.IssueReported to repository JobSiteContext.JobSiteRepository
        prompt "Increment open issue count"
      }
      on event JobSite.IssueResolved is {
        tell event JobSite.IssueResolved to repository JobSiteContext.JobSiteRepository
        prompt "Decrement open issue count"
      }
      on event JobSite.SafetyInspectionRecorded is {
        tell event JobSite.SafetyInspectionRecorded to repository JobSiteContext.JobSiteRepository
        prompt "Update inspection metrics"
      }
    } with {
      briefly "Maintains site analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Site analytics projections"
    described as {
      |Maintains job site analytics data.
    }
  }
  // ---- Event publication for JobSite ----
  type JobSiteEvent is one of {
    JobSiteContext.JobSite.SiteEstablished,
    JobSiteContext.JobSite.SiteActivated,
    JobSiteContext.JobSite.CrewAssigned,
    JobSiteContext.JobSite.CrewRemoved,
    JobSiteContext.JobSite.DailyReportSubmitted,
    JobSiteContext.JobSite.SafetyInspectionRecorded,
    JobSiteContext.JobSite.IssueReported,
    JobSiteContext.JobSite.IssueResolved,
    JobSiteContext.JobSite.SiteSuspended,
    JobSiteContext.JobSite.SiteResumed,
    JobSiteContext.JobSite.SiteCompleted,
    JobSiteContext.JobSite.SiteClosed
  } with {
    briefly "JobSite event alternation"
    described as {
      |Union of all JobSite events, for streaming and event-sourced
      |persistence.
    }
  }
  source JobSiteEventSource is {
    outlet JobSiteEvents is type JobSiteEvent
    handler JobSiteSourceHandler is {
      on event JobSite.SiteEstablished is {
        send event JobSite.SiteEstablished to outlet JobSiteEvents
      }
      on event JobSite.SiteActivated is {
        send event JobSite.SiteActivated to outlet JobSiteEvents
      }
      on event JobSite.CrewAssigned is {
        send event JobSite.CrewAssigned to outlet JobSiteEvents
      }
      on event JobSite.CrewRemoved is {
        send event JobSite.CrewRemoved to outlet JobSiteEvents
      }
      on event JobSite.DailyReportSubmitted is {
        send event JobSite.DailyReportSubmitted to outlet JobSiteEvents
      }
      on event JobSite.SafetyInspectionRecorded is {
        send event JobSite.SafetyInspectionRecorded to outlet JobSiteEvents
      }
      on event JobSite.IssueReported is {
        send event JobSite.IssueReported to outlet JobSiteEvents
      }
      on event JobSite.IssueResolved is {
        send event JobSite.IssueResolved to outlet JobSiteEvents
      }
      on event JobSite.SiteSuspended is {
        send event JobSite.SiteSuspended to outlet JobSiteEvents
      }
      on event JobSite.SiteResumed is {
        send event JobSite.SiteResumed to outlet JobSiteEvents
      }
      on event JobSite.SiteCompleted is {
        send event JobSite.SiteCompleted to outlet JobSiteEvents
      }
      on event JobSite.SiteClosed is {
        send event JobSite.SiteClosed to outlet JobSiteEvents
      }
      on other is {
        error "Unexpected message for source JobSiteEventSource"
      }
    } with {
      briefly "JobSite source handler"
      described as {
        |Publishes JobSite events onto the outlet.
      }
    }
  } with {
    briefly "JobSite event source"
    described as {
      |Publishes JobSite entity events into the streaming topology.
    }
  }
  sink JobSiteEventSink is {
    inlet JobSiteInlet is type JobSiteEvent
    handler JobSiteSinkHandler is {
      on event JobSite.SiteEstablished is {
        tell event JobSite.SiteEstablished to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.SiteActivated is {
        tell event JobSite.SiteActivated to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.CrewAssigned is {
        tell event JobSite.CrewAssigned to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.CrewRemoved is {
        tell event JobSite.CrewRemoved to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.DailyReportSubmitted is {
        tell event JobSite.DailyReportSubmitted to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.SafetyInspectionRecorded is {
        tell event JobSite.SafetyInspectionRecorded to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.IssueReported is {
        tell event JobSite.IssueReported to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.IssueResolved is {
        tell event JobSite.IssueResolved to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.SiteSuspended is {
        tell event JobSite.SiteSuspended to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.SiteResumed is {
        tell event JobSite.SiteResumed to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.SiteCompleted is {
        tell event JobSite.SiteCompleted to repository JobSiteContext.JobSiteRepository
      }
      on event JobSite.SiteClosed is {
        tell event JobSite.SiteClosed to repository JobSiteContext.JobSiteRepository
      }
      on other is {
        error "Unexpected message for sink JobSiteEventSink"
      }
    } with {
      briefly "JobSite sink handler"
      described as {
        |Persists JobSite events via the repository.
      }
    }
  } with {
    briefly "JobSite event sink"
    described as {
      |Receives JobSite events for persistence.
    }
  }
  connector JobSiteEventFlow is {
    from outlet JobSiteContext.JobSiteEventSource.JobSiteEvents to
      inlet JobSiteContext.JobSiteEventSink.JobSiteInlet
  } with {
    briefly "JobSite event flow"
    described as {
      |Connects the JobSite source to its sink.
    }
  }
} with {
  briefly "Bounded context for job site management"
  described as {
    | The JobSiteContext is the bounded context for construction
    | job site operations including reporting and safety.
  }
}
