// Job Site Management - JobSite Context
context JobSiteContext as router is {
  inlet JobSiteCommandStreamIn is type JobSiteCommand  outlet JobSiteCommandStreamOut is type JobSiteCommand
  inlet JobSiteResultStreamIn is result JobSite.JobSiteResult  outlet JobSiteResultStreamOut is result JobSite.JobSiteResult
  handler JobSiteContextBoundary is {
    on establishSite: command JobSite.EstablishSite is {
      send establishSite to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on activateSite: command JobSite.ActivateSite is {
      send activateSite to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on assignCrew: command JobSite.AssignCrew is {
      send assignCrew to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on removeCrew: command JobSite.RemoveCrew is {
      send removeCrew to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on submitDailyReport: command JobSite.SubmitDailyReport is {
      send submitDailyReport to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on recordSafetyInspection: command JobSite.RecordSafetyInspection is {
      send recordSafetyInspection to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on reportIssue: command JobSite.ReportIssue is {
      send reportIssue to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on resolveIssue: command JobSite.ResolveIssue is {
      send resolveIssue to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on suspendSite: command JobSite.SuspendSite is {
      send suspendSite to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on resumeSite: command JobSite.ResumeSite is {
      send resumeSite to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on completeSite: command JobSite.CompleteSite is {
      send completeSite to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on closeSite: command JobSite.CloseSite is {
      send closeSite to outlet JobSiteContext.JobSiteCommandStreamOut
    }
    on jobSiteResult: result JobSite.JobSiteResult is {
      send jobSiteResult to outlet JobSiteContext.JobSiteResultStreamOut
    }
    on other is {
      error "Unexpected message at the JobSiteContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'JobSiteCommand Stream Intake' is from outlet JobSiteContext.JobSiteCommandStreamOut to inlet JobSiteContext.JobSite.JobSiteCommands  connector 'JobSiteResult Stream Egress' is from outlet JobSiteContext.JobSiteRepository.JobSiteRepositoryResponses to inlet JobSiteContext.JobSiteResultStreamIn  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.AlertSent is {
        do "the model receives alert sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendDailyReportNotification is {
        do "the model sends send daily report notification"
      }
      on command NotificationService.SendSiteAlert is {
        do "the model sends send site alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromProjectService from context ProjectService is { 
    handler FromProjectServiceHandler is {
      on event ProjectService.ScheduleChanged is {
        do "the model receives schedule changed"
      }
      on other is {
        error "Unexpected message for adaptor FromProjectService"
      }
    } with {
      briefly "from project service"
      described as {
        |Carries messages from the external ProjectService.
      }
    }
    handler ProjectEvents is {
      on event ProjectService.ProjectUpdated is {
        do "Update site with project changes"
      }
      on other is {
        error "Unexpected message for adaptor ProjectAdapter"
      }
    } with {
      briefly "Handles project events"
      described as {
        |Syncs site with project updates.
      }
    }
  } with {
    briefly "ProjectService integration"
    described as {
      |The model's side of the ProjectService conversation.
    }
  }
  adaptor FromSafetyComplianceService from context SafetyComplianceService is { 
    handler FromSafetyComplianceServiceHandler is {
      on event SafetyComplianceService.ComplianceStatusUpdated is {
        do "the model receives compliance status updated"
      }
      on other is {
        error "Unexpected message for adaptor FromSafetyComplianceService"
      }
    } with {
      briefly "from safety compliance service"
      described as {
        |Carries messages from the external SafetyComplianceService.
      }
    }
  } with {
    briefly "SafetyComplianceService integration"
    described as {
      |The model's side of the SafetyComplianceService conversation.
    }
  }
  adaptor ToSafetyComplianceService to context SafetyComplianceService is { 
    handler ToSafetyComplianceServiceHandler is {
      on command SafetyComplianceService.SubmitInspectionReport is {
        do "the model sends submit inspection report"
      }
      on other is {
        error "Unexpected message for adaptor ToSafetyComplianceService"
      }
    } with {
      briefly "to safety compliance service"
      described as {
        |Carries messages to the external SafetyComplianceService.
      }
    }
  } with {
    briefly "SafetyComplianceService integration"
    described as {
      |The model's side of the SafetyComplianceService conversation.
    }
  }
  adaptor FromWeatherService from context WeatherService is { 
    handler FromWeatherServiceHandler is {
      on event WeatherService.ForecastUpdated is {
        do "the model receives forecast updated"
      }
      on other is {
        error "Unexpected message for adaptor FromWeatherService"
      }
    } with {
      briefly "from weather service"
      described as {
        |Carries messages from the external WeatherService.
      }
    }
    handler WeatherEvents is {
      on event WeatherService.WeatherAlert is {
        do "Notify site of weather conditions"
      }
      on other is {
        error "Unexpected message for adaptor WeatherAdapter"
      }
    } with {
      briefly "Handles weather events"
      described as {
        |Processes weather alerts for sites.
      }
    }
  } with {
    briefly "WeatherService integration"
    described as {
      |The model's side of the WeatherService conversation.
    }
  }
  include "types.riddl"
  include "JobSite.riddl"
  // Adaptor for weather service integration
  // Adaptor for project service integration
  // Repository for job site persistence
  type JobSiteRepositoryCommand is one of {
    JobSiteContext.JobSiteRepository.PersistCrewAssigned or JobSiteContext.JobSiteRepository.PersistCrewRemoved or JobSiteContext.JobSiteRepository.PersistDailyReportSubmitted or JobSiteContext.JobSiteRepository.PersistIssueReported or JobSiteContext.JobSiteRepository.PersistIssueResolved or JobSiteContext.JobSiteRepository.PersistSafetyInspectionRecorded or JobSiteContext.JobSiteRepository.PersistSiteActivated or JobSiteContext.JobSiteRepository.PersistSiteClosed or JobSiteContext.JobSiteRepository.PersistSiteCompleted or JobSiteContext.JobSiteRepository.PersistSiteEstablished or JobSiteContext.JobSiteRepository.PersistSiteResumed or JobSiteContext.JobSiteRepository.PersistSiteSuspended
  } with {
    briefly "Anything that writes JobSiteRepository"
    described as {
      |The persistence commands JobSiteRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository JobSiteRepository as flow is {
    inlet JobSiteRepositoryFromSiteAnalytics is type JobSiteRepositoryCommand    command PersistCrewAssigned is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewAssigned applies to.
        }
      }
    } with {
      briefly "Persist CrewAssigned"
      described as {
        |Instructs this repository to apply CrewAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCrewRemoved is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row CrewRemoved applies to.
        }
      }
    } with {
      briefly "Persist CrewRemoved"
      described as {
        |Instructs this repository to apply CrewRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSiteActivated is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row SiteActivated applies to.
        }
      }
    } with {
      briefly "Persist SiteActivated"
      described as {
        |Instructs this repository to apply SiteActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSiteClosed is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row SiteClosed applies to.
        }
      }
    } with {
      briefly "Persist SiteClosed"
      described as {
        |Instructs this repository to apply SiteClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSiteCompleted is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row SiteCompleted applies to.
        }
      }
    } with {
      briefly "Persist SiteCompleted"
      described as {
        |Instructs this repository to apply SiteCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSiteEstablished is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row SiteEstablished applies to.
        }
      }
    } with {
      briefly "Persist SiteEstablished"
      described as {
        |Instructs this repository to apply SiteEstablished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSiteResumed is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row SiteResumed applies to.
        }
      }
    } with {
      briefly "Persist SiteResumed"
      described as {
        |Instructs this repository to apply SiteResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSiteSuspended is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row SiteSuspended applies to.
        }
      }
    } with {
      briefly "Persist SiteSuspended"
      described as {
        |Instructs this repository to apply SiteSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDailyReportSubmitted is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row DailyReportSubmitted applies to.
        }
      }
    } with {
      briefly "Persist DailyReportSubmitted"
      described as {
        |Instructs this repository to apply DailyReportSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIssueReported is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row IssueReported applies to.
        }
      }
    } with {
      briefly "Persist IssueReported"
      described as {
        |Instructs this repository to apply IssueReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIssueResolved is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row IssueResolved applies to.
        }
      }
    } with {
      briefly "Persist IssueResolved"
      described as {
        |Instructs this repository to apply IssueResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSafetyInspectionRecorded is  {
      jobSiteId: JobSiteId with {
        briefly "Row addressed"
        described as {
          |Which stored row SafetyInspectionRecorded applies to.
        }
      }
    } with {
      briefly "Persist SafetyInspectionRecorded"
      described as {
        |Instructs this repository to apply SafetyInspectionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet JobSiteRepositoryResponses is result JobSite.JobSiteResult
    record StoredJobSite is  {
      jobSiteId: JobSiteId with {
        briefly "jobSiteId"
        described as {
          |The jobSiteId column of the stored jobSite row.
        }
      }
      projectId: ProjectId with {
        briefly "projectId"
        described as {
          |The projectId column of the stored jobSite row.
        }
      }
    } with {
      briefly "Stored jobSite row"
      described as {
        |The persistence shape of jobSite data as this repository stores it.
      }
    }
    schema JobSiteData is relational
      of sites as record StoredJobSite
        index on field StoredJobSite.jobSiteId
        index on field StoredJobSite.projectId
 with {
      briefly "Job site data schema"
      described as {
        |The relational schema holding job site data for the JobSiteRepository.
      }
    }
    handler JobSitePersistence is {
      on persistCrewAssigned: command PersistCrewAssigned is {
        do "apply CrewAssigned to the stored row"
      }
      on persistCrewRemoved: command PersistCrewRemoved is {
        do "apply CrewRemoved to the stored row"
      }
      on persistSiteActivated: command PersistSiteActivated is {
        do "apply SiteActivated to the stored row"
      }
      on persistSiteClosed: command PersistSiteClosed is {
        do "apply SiteClosed to the stored row"
      }
      on persistSiteCompleted: command PersistSiteCompleted is {
        do "apply SiteCompleted to the stored row"
      }
      on persistSiteEstablished: command PersistSiteEstablished is {
        do "apply SiteEstablished to the stored row"
      }
      on persistSiteResumed: command PersistSiteResumed is {
        do "apply SiteResumed to the stored row"
      }
      on persistSiteSuspended: command PersistSiteSuspended is {
        do "apply SiteSuspended to the stored row"
      }
      on persistDailyReportSubmitted: command PersistDailyReportSubmitted is {
        do "apply DailyReportSubmitted to the stored row"
      }
      on persistIssueReported: command PersistIssueReported is {
        do "apply IssueReported to the stored row"
      }
      on persistIssueResolved: command PersistIssueResolved is {
        do "apply IssueResolved to the stored row"
      }
      on persistSafetyInspectionRecorded: command PersistSafetyInspectionRecorded is {
        do "apply SafetyInspectionRecorded to the stored row"
      }
      on query GetSiteSummary is {
        let siteSummaryView: type SiteSummaryView = prompt("read the site summary projection")
        reply siteSummaryView
      }
    } with {
      briefly "Persists job site events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Job site data persistence"
    described as {
      | The JobSiteRepository provides persistent storage for
      | job sites, daily reports, and inspections.
    }
  }
  // Projector for site analytics
  query GetSiteSummary replies result SiteSummaryView is  {
    siteSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which site summary to retrieve.
      }
    }
  } with {
    briefly "Get site summary"
    described as {
      |Retrieves the site summary projection.
    }
  }
  result SiteSummaryView is  {
    siteSummary: SiteAnalytics.SiteSummary with {
      briefly "Site summary"
      described as {
        |The site summary being returned.
      }
    }
  } with {
    briefly "Site summary view"
    described as {
      |Read model view carrying the site summary projection.
    }
  }
  projector SiteAnalytics as flow is {
    updates repository JobSiteContext.JobSiteRepository
    outlet SiteAnalyticsToRepository is type JobSiteRepositoryCommand
    inlet SiteAnalyticsFromJobSite is type JobSiteEvent    record SiteSummary is  {
      jobSiteId: JobSiteId with {
        briefly "Site"
        described as {
          |Site ID.
        }
      }
      totalLaborHours: Decimal(10,2) with {
        briefly "Hours"
        described as {
          |Total labor hours.
        }
      }
      openIssueCount: Natural with {
        briefly "Issues"
        described as {
          |Open issue count.
        }
      }
      lastInspectionDate: Date? with {
        briefly "Inspection"
        described as {
          |Last inspection.
        }
      }
      inspectionStatus: InspectionStatus? with {
        briefly "Status"
        described as {
          |Last inspection status.
        }
      }
    } with {
      briefly "Site summary"
      described as {
        |Job site summary metrics.
      }
    }
    handler AnalyticsHandler is {
      on crewAssigned: event JobSite.CrewAssigned is {
        tell command JobSiteContext.JobSiteRepository.PersistCrewAssigned(jobSiteId = crewAssigned.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply CrewAssigned to the SiteAnalytics projection"
      }
      on crewRemoved: event JobSite.CrewRemoved is {
        tell command JobSiteContext.JobSiteRepository.PersistCrewRemoved(jobSiteId = crewRemoved.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply CrewRemoved to the SiteAnalytics projection"
      }
      on siteActivated: event JobSite.SiteActivated is {
        tell command JobSiteContext.JobSiteRepository.PersistSiteActivated(jobSiteId = siteActivated.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply SiteActivated to the SiteAnalytics projection"
      }
      on siteClosed: event JobSite.SiteClosed is {
        tell command JobSiteContext.JobSiteRepository.PersistSiteClosed(jobSiteId = siteClosed.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply SiteClosed to the SiteAnalytics projection"
      }
      on siteCompleted: event JobSite.SiteCompleted is {
        tell command JobSiteContext.JobSiteRepository.PersistSiteCompleted(jobSiteId = siteCompleted.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply SiteCompleted to the SiteAnalytics projection"
      }
      on siteEstablished: event JobSite.SiteEstablished is {
        tell command JobSiteContext.JobSiteRepository.PersistSiteEstablished(jobSiteId = siteEstablished.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply SiteEstablished to the SiteAnalytics projection"
      }
      on siteResumed: event JobSite.SiteResumed is {
        tell command JobSiteContext.JobSiteRepository.PersistSiteResumed(jobSiteId = siteResumed.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply SiteResumed to the SiteAnalytics projection"
      }
      on siteSuspended: event JobSite.SiteSuspended is {
        tell command JobSiteContext.JobSiteRepository.PersistSiteSuspended(jobSiteId = siteSuspended.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "apply SiteSuspended to the SiteAnalytics projection"
      }
      on dailyReportSubmitted: event JobSite.DailyReportSubmitted is {
        tell command JobSiteContext.JobSiteRepository.PersistDailyReportSubmitted(jobSiteId = dailyReportSubmitted.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "Update labor hour totals"
      }
      on issueReported: event JobSite.IssueReported is {
        tell command JobSiteContext.JobSiteRepository.PersistIssueReported(jobSiteId = issueReported.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "Increment open issue count"
      }
      on issueResolved: event JobSite.IssueResolved is {
        tell command JobSiteContext.JobSiteRepository.PersistIssueResolved(jobSiteId = issueResolved.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "Decrement open issue count"
      }
      on safetyInspectionRecorded: event JobSite.SafetyInspectionRecorded is {
        tell command JobSiteContext.JobSiteRepository.PersistSafetyInspectionRecorded(jobSiteId = safetyInspectionRecorded.jobSiteId) to repository JobSiteContext.JobSiteRepository
        do "Update inspection metrics"
      }
    } with {
      briefly "Maintains site analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Site analytics projections"
    described as {
      |Maintains job site analytics data.
    }
  }
  // ---- Event publication for JobSite ----
  type JobSiteEvent is one of {
    JobSiteContext.JobSite.SiteEstablished or JobSiteContext.JobSite.SiteActivated or JobSiteContext.JobSite.CrewAssigned or JobSiteContext.JobSite.CrewRemoved or JobSiteContext.JobSite.DailyReportSubmitted or JobSiteContext.JobSite.SafetyInspectionRecorded or JobSiteContext.JobSite.IssueReported or JobSiteContext.JobSite.IssueResolved or JobSiteContext.JobSite.SiteSuspended or JobSiteContext.JobSite.SiteResumed or JobSiteContext.JobSite.SiteCompleted or JobSiteContext.JobSite.SiteClosed
  } with {
    briefly "JobSite event alternation"
    described as {
      |Union of all JobSite events, for streaming and event-sourced
      |persistence.
    }
  }
  processor JobSiteEventSplit as flow is {
    inlet JobSiteEventSplitIn is type JobSiteEvent    outlet JobSiteEventSplitToSiteAnalytics is type JobSiteEvent
    handler JobSiteEventSplitHandler is {
      on siteEstablished: event JobSite.SiteEstablished is {
        send siteEstablished to outlet JobSiteEventSplitToSiteAnalytics
        tell siteEstablished to entity JobSiteContext.JobSite
      }
      on siteActivated: event JobSite.SiteActivated is {
        send siteActivated to outlet JobSiteEventSplitToSiteAnalytics
        tell siteActivated to entity JobSiteContext.JobSite
      }
      on crewAssigned: event JobSite.CrewAssigned is {
        send crewAssigned to outlet JobSiteEventSplitToSiteAnalytics
        tell crewAssigned to entity JobSiteContext.JobSite
      }
      on crewRemoved: event JobSite.CrewRemoved is {
        send crewRemoved to outlet JobSiteEventSplitToSiteAnalytics
        tell crewRemoved to entity JobSiteContext.JobSite
      }
      on dailyReportSubmitted: event JobSite.DailyReportSubmitted is {
        send dailyReportSubmitted to outlet JobSiteEventSplitToSiteAnalytics
        tell dailyReportSubmitted to entity JobSiteContext.JobSite
      }
      on safetyInspectionRecorded: event JobSite.SafetyInspectionRecorded is {
        send safetyInspectionRecorded to outlet JobSiteEventSplitToSiteAnalytics
        tell safetyInspectionRecorded to entity JobSiteContext.JobSite
      }
      on issueReported: event JobSite.IssueReported is {
        send issueReported to outlet JobSiteEventSplitToSiteAnalytics
        tell issueReported to entity JobSiteContext.JobSite
      }
      on issueResolved: event JobSite.IssueResolved is {
        send issueResolved to outlet JobSiteEventSplitToSiteAnalytics
        tell issueResolved to entity JobSiteContext.JobSite
      }
      on siteSuspended: event JobSite.SiteSuspended is {
        send siteSuspended to outlet JobSiteEventSplitToSiteAnalytics
        tell siteSuspended to entity JobSiteContext.JobSite
      }
      on siteResumed: event JobSite.SiteResumed is {
        send siteResumed to outlet JobSiteEventSplitToSiteAnalytics
        tell siteResumed to entity JobSiteContext.JobSite
      }
      on siteCompleted: event JobSite.SiteCompleted is {
        send siteCompleted to outlet JobSiteEventSplitToSiteAnalytics
        tell siteCompleted to entity JobSiteContext.JobSite
      }
      on siteClosed: event JobSite.SiteClosed is {
        send siteClosed to outlet JobSiteEventSplitToSiteAnalytics
        tell siteClosed to entity JobSiteContext.JobSite
      }
      on other is {
        error "Unexpected message for processor JobSiteEventSplit"
      }
    } with {
      briefly "JobSite event fan-out handler"
      described as {
        |Delivers each JobSite event to all of its consumers.
      }
    }
  } with {
    briefly "JobSite event fan-out"
    described as {
      |Fans JobSite events out to the repository and projectors.
    }
  }
  connector 'JobSiteEvent Stream' is from outlet JobSiteContext.JobSite.JobSiteEvents2 to inlet JobSiteContext.JobSiteEventSplit.JobSiteEventSplitIn with {
    briefly "JobSite events, fanned out to storage and read models"
  }
  connector 'SiteAnalytics Feed' is from outlet JobSiteContext.JobSiteEventSplit.JobSiteEventSplitToSiteAnalytics to inlet JobSiteContext.SiteAnalytics.SiteAnalyticsFromJobSite with {
    briefly "JobSite events feeding the SiteAnalytics projection"
  }
  connector 'SiteAnalytics Storage' is from outlet JobSiteContext.SiteAnalytics.SiteAnalyticsToRepository to inlet JobSiteContext.JobSiteRepository.JobSiteRepositoryFromSiteAnalytics with {
    briefly "SiteAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for job site management"
  described as {
    | The JobSiteContext is the bounded context for construction
    | job site operations including reporting and safety.
  }
}
