// Job Site Management Domain Model
// Construction job site operations, safety, and daily reporting
domain JobSiteManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user SiteSupervisor is "supervisor managing job site" with {
    briefly "Site supervisor"
    described as {
      |Staff overseeing daily site operations.
    }
  }
  user SafetyOfficer is "officer ensuring site safety" with {
    briefly "Safety officer"
    described as {
      |Staff responsible for safety compliance.
    }
  }
  user ProjectManager is "manager overseeing project" with {
    briefly "Project manager"
    described as {
      |Staff managing project timeline and resources.
    }
  }
  epic DailyOperationsEpic is {
    user SiteSupervisor wants to "to manage daily site activities" so that "work progresses safely and on schedule"
    case DailyReporting is {
      user SiteSupervisor wants to "to submit daily progress reports" so that "stakeholders are informed of site status"
      step is "Supervisor reviews work completed" "documenting progress" "and issues" with {
        briefly "Review work"
        described as {
          |Supervisor reviews daily progress.
        }
      }
      step is "Supervisor records labor hours" "for each crew" "and trade" with {
        briefly "Record hours"
        described as {
          |Supervisor logs labor time.
        }
      }
      step take input JobSiteManagementApp.JobSiteManagementScreen.SubmitDailyReportInput from user SiteSupervisor with {
        briefly "Submit report"
        described as {
          |Send daily report command.
        }
      }
      step is "System notifies project manager" "of report submission" "and highlights" with {
        briefly "Notify PM"
        described as {
          |System sends report notification.
        }
      }
    } with {
      briefly "Daily reporting workflow"
      described as {
        |Standard flow for daily site reports.
      }
    }
  } with {
    briefly "Daily operations processing"
    described as {
      | Epic covering daily job site operations including
      | reporting, safety checks, and crew management.
    }
  }
  include "JobSiteContext.riddl"
  include "external-contexts.riddl"
  application context JobSiteManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in JobSiteManagement are delivered.
      }
    }
    group JobSiteManagementScreen is {
      input SubmitDailyReportInput acquires command JobSiteContext.JobSite.SubmitDailyReport with {
        briefly "Submit daily report control"
        described as {
          |The control through which a user submits the submit daily report request.
        }
      }
    } with {
      briefly "Job site management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppJobSiteCommands is type JobSiteContext.JobSite.JobSiteCommand
    inlet AppJobSiteRepositoryResponses is type JobSiteContext.JobSite.JobSiteResult    handler JobSiteManagementAppHandler is {
      on other is {
        error "Unexpected message for application context JobSiteManagementApp"
      }
    } with {
      briefly "JobSiteManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "JobSiteManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'JobSiteCommand Stream' is from outlet JobSiteManagementApp.AppJobSiteCommands to inlet JobSiteContext.JobSiteCommandStreamIn with {
    briefly "JobSite commands from the application"
  }
  persistent connector 'JobSiteResult Stream' is from outlet JobSiteContext.JobSiteResultStreamOut to inlet JobSiteManagementApp.AppJobSiteRepositoryResponses with {
    briefly "JobSite query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet JobSiteManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Job site management domain"
  described as {
    | The JobSiteManagement domain handles construction job site
    | operations including daily reporting, safety, and resource tracking.
  }
}
