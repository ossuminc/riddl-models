// Apparel Manufacturing Domain Model
// Cut-Sew-Trim (CST) production for garment manufacturing
domain ApparelManufacturing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProductionSupervisor is "person overseeing garment production floor" with {
    briefly "Production Supervisor"
    described as {
      |Person managing production schedules and supervising operators.
    }
  }
  user SewingOperator is "person operating sewing machines and assembling garments" with {
    briefly "Sewing Operator"
    described as {
      |Person performing sewing operations on garment bundles.
    }
  }
  user CuttingOperator is "person operating cutting equipment to cut fabric" with {
    briefly "Cutting Operator"
    described as {
      |Person executing fabric cutting based on markers.
    }
  }
  user QualityChecker is "person inspecting garments for quality standards" with {
    briefly "Quality Checker"
    described as {
      |Person performing quality inspection at various stages.
    }
  }
  epic CutSewTrimEpic is {
    user ProductionSupervisor wants to "to manage cut-sew-trim production orders" so that "garments are manufactured efficiently and on schedule"
    case ExecuteCutOrder is {
      user CuttingOperator wants to "to complete fabric cutting for a style order" so that "cut pieces are ready for sewing"
      step is "Cutting operator receives" "cut order with marker layout" "and fabric allocation" with {
        briefly "Receive order"
        described as {
          |Get cutting instructions.
        }
      }
      step is "Operator spreads" "fabric layers on cutting table" "per marker requirements" with {
        briefly "Spread fabric"
        described as {
          |Prepare fabric layers.
        }
      }
      step take input ApparelManufacturingApp.ApparelManufacturingScreen.CutFabricInput from user CuttingOperator with {
        briefly "Cut fabric"
        described as {
          |Execute cutting operation.
        }
      }
      step take input ApparelManufacturingApp.ApparelManufacturingScreen.CreateBundlesInput from user CuttingOperator with {
        briefly "Create bundles"
        described as {
          |Bundle cut pieces by size.
        }
      }
    } with {
      briefly "Fabric cutting execution"
      described as {
        |Executing fabric cutting and bundle creation.
      }
    }
    case ExecuteSewing is {
      user SewingOperator wants to "to sew assigned bundles" so that "garments are assembled correctly"
      step take input ApparelManufacturingApp.ApparelManufacturingScreen.AssignBundleInput from user ProductionSupervisor with {
        briefly "Assign bundle"
        described as {
          |Assign bundle to operator.
        }
      }
      step is "Sewing operator receives" "bundle with sewing instructions" "and thread requirements" with {
        briefly "Receive bundle"
        described as {
          |Get bundle and instructions.
        }
      }
      step is "Operator performs" "sewing operations" "per production standards" with {
        briefly "Sew garments"
        described as {
          |Execute sewing operations.
        }
      }
      step take input ApparelManufacturingApp.ApparelManufacturingScreen.CompleteSewingInput from user SewingOperator with {
        briefly "Complete sewing"
        described as {
          |Report sewing completion.
        }
      }
    } with {
      briefly "Sewing operations"
      described as {
        |Executing sewing operations on bundles.
      }
    }
    case ExecuteFinishing is {
      user QualityChecker wants to "to inspect and finish garments" so that "only quality garments are shipped"
      step take input ApparelManufacturingApp.ApparelManufacturingScreen.CompleteTrimmingInput from user SewingOperator with {
        briefly "Complete trimming"
        described as {
          |Complete trim attachment.
        }
      }
      step is "Quality checker inspects" "garments for defects" "and measurements" with {
        briefly "Inspect garments"
        described as {
          |Perform quality inspection.
        }
      }
      step take input ApparelManufacturingApp.ApparelManufacturingScreen.PackGarmentsInput from user QualityChecker with {
        briefly "Pack garments"
        described as {
          |Pack approved garments.
        }
      }
    } with {
      briefly "Finishing and packing"
      described as {
        |Executing trim, inspection, and packing.
      }
    }
  } with {
    briefly "Cut-Sew-Trim production"
    described as {
      | Epic covering the complete cut-sew-trim (CST) apparel
      | production process from fabric cutting through packing.
    }
  }
  include "ApparelContext.riddl"
  include "external-contexts.riddl"
  application context ApparelManufacturingApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ApparelManufacturing are delivered.
      }
    }
    group ApparelManufacturingScreen is {
      input CutFabricInput acquires command ApparelContext.CutOrder.CutFabric with {
        briefly "Cut fabric control"
        described as {
          |The control through which a user submits the cut fabric request.
        }
      }
      input CreateBundlesInput acquires command ApparelContext.CutOrder.CreateBundles with {
        briefly "Create bundles control"
        described as {
          |The control through which a user submits the create bundles request.
        }
      }
      input AssignBundleInput acquires command ApparelContext.CutOrder.AssignBundle with {
        briefly "Assign bundle control"
        described as {
          |The control through which a user submits the assign bundle request.
        }
      }
      input CompleteSewingInput acquires command ApparelContext.CutOrder.CompleteSewing with {
        briefly "Complete sewing control"
        described as {
          |The control through which a user submits the complete sewing request.
        }
      }
      input CompleteTrimmingInput acquires command ApparelContext.CutOrder.CompleteTrimming with {
        briefly "Complete trimming control"
        described as {
          |The control through which a user submits the complete trimming request.
        }
      }
      input PackGarmentsInput acquires command ApparelContext.CutOrder.PackGarments with {
        briefly "Pack garments control"
        described as {
          |The control through which a user submits the pack garments request.
        }
      }
    } with {
      briefly "Apparel manufacturing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCutOrderCommands is type ApparelContext.CutOrder.CutOrderCommand
    inlet AppCutOrderRepositoryResponses is type ApparelContext.CutOrder.CutOrderResult    handler ApparelManufacturingAppHandler is {
      on other is {
        error "Unexpected message for application context ApparelManufacturingApp"
      }
    } with {
      briefly "ApparelManufacturingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ApparelManufacturingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppCutOrderCommands is from outlet ApparelManufacturingApp.AppCutOrderCommands to inlet ApparelContext.CutOrder.CutOrderCommands with {
    option persistent()
    briefly "LinkAppCutOrderCommands"
  }
  connector LinkAppCutOrderRepositoryResponses is from outlet ApparelContext.CutOrderRepository.CutOrderRepositoryResponses to inlet ApparelManufacturingApp.AppCutOrderRepositoryResponses with {
    option persistent()
    briefly "LinkAppCutOrderRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ApparelManufacturingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Apparel manufacturing domain"
  described as {
    | The ApparelManufacturing domain handles cut-sew-trim
    | garment production including cutting, bundling, sewing,
    | trimming, finishing, and packing operations.
  }
}
