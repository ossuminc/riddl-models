  projector BundleThroughputProjector as flow is {
    updates repository ApparelContext.CutOrderRepository
    outlet BundleThroughputProjectorToRepository is type CutOrderRepositoryCommand
 with {
      briefly "What BundleThroughputProjector publishes to CutOrderRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to CutOrderRepository needs this port to travel on.
      }
    }
    inlet BundleThroughputProjectorFromCutOrder is type CutOrderEvent    record BundleThroughputStats is {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of period.
        }
      }
      bundlesCreated: Natural with {
        briefly "Created"
        described as {
          |Bundles created.
        }
      }
      bundlesAssigned: Natural with {
        briefly "Assigned"
        described as {
          |Bundles assigned.
        }
      }
      bundlesCompleted: Natural with {
        briefly "Completed"
        described as {
          |Bundles completed.
        }
      }
      bundlesPacked: Natural with {
        briefly "Packed"
        described as {
          |Bundles packed.
        }
      }
      averageCycleTime: Decimal(8,2) with {
        briefly "Cycle time"
        described as {
          |Average bundle cycle time (hours).
        }
      }
      wipBundles: Natural with {
        briefly "WIP"
        described as {
          |Work-in-progress bundles.
        }
      }
    } with {
      briefly "Bundle throughput statistics"
      described as {
        |Bundle flow and cycle time metrics.
      }
    }
    handler BundleThroughputHandler is {
      on machineBreakdownRecorded: event CutOrder.MachineBreakdownRecorded is {
        tell command ApparelContext.CutOrderRepository.PersistMachineBreakdownRecorded(cutOrderId = machineBreakdownRecorded.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply MachineBreakdownRecorded to the BundleThroughputProjector projection"
      }
      on cutOrderCancelled: event CutOrder.CutOrderCancelled is {
        tell command ApparelContext.CutOrderRepository.PersistCutOrderCancelled(cutOrderId = cutOrderCancelled.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply CutOrderCancelled to the BundleThroughputProjector projection"
      }
