// Apparel Manufacturing - Apparel Context
context ApparelContext is {
  adaptor FromFabricInventory from context FabricInventory is {
    handler FromFabricInventoryHandler is {
      on result FabricInventory.AvailableFabricRolls is {
        do "the model receives available fabric rolls"
      }
      on event FabricInventory.FabricConsumed is {
        do "the model receives fabric consumed"
      }
      on event FabricInventory.FabricReserved is {
        do "the model receives fabric reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromFabricInventory"
      }
    } with {
      briefly "from fabric inventory"
      described as {
        |Carries messages from the external FabricInventory.
      }
    }
  } with {
      briefly "FabricInventory integration"
    described as {
      |The model's side of the FabricInventory conversation.
    }
  }
  adaptor ToFabricInventory to context FabricInventory is {
    handler ToFabricInventoryHandler is {
      on command FabricInventory.ConsumeFabric is {
        do "the model sends consume fabric"
      }
      on query FabricInventory.GetAvailableFabric is {
        do "the model sends get available fabric"
      }
      on query FabricInventory.GetFabricRoll is {
        do "the model sends get fabric roll"
      }
      on command FabricInventory.ReserveFabric is {
        do "the model sends reserve fabric"
      }
      on other is {
        error "Unexpected message for adaptor ToFabricInventory"
      }
    } with {
      briefly "to fabric inventory"
      described as {
        |Carries messages to the external FabricInventory.
      }
    }
  } with {
      briefly "FabricInventory integration"
    described as {
      |The model's side of the FabricInventory conversation.
    }
  }
  adaptor FromMachineMaintenance from context MachineMaintenance is {
    handler FromMachineMaintenanceHandler is {
      on event MachineMaintenance.MachineBreakdownReported is {
        do "the model receives machine breakdown reported"
      }
      on result MachineMaintenance.MachineStatusResult is {
        do "the model receives machine status result"
      }
      on other is {
        error "Unexpected message for adaptor FromMachineMaintenance"
      }
    } with {
      briefly "from machine maintenance"
      described as {
        |Carries messages from the external MachineMaintenance.
      }
    }
  } with {
      briefly "MachineMaintenance integration"
    described as {
      |The model's side of the MachineMaintenance conversation.
    }
  }
  adaptor ToMachineMaintenance to context MachineMaintenance is {
    handler ToMachineMaintenanceHandler is {
      on query MachineMaintenance.GetMachineStatus is {
        do "the model sends get machine status"
      }
      on command MachineMaintenance.ReportMachineBreakdown is {
        do "the model sends report machine breakdown"
      }
      on other is {
        error "Unexpected message for adaptor ToMachineMaintenance"
      }
    } with {
      briefly "to machine maintenance"
      described as {
        |Carries messages to the external MachineMaintenance.
      }
    }
  } with {
      briefly "MachineMaintenance integration"
    described as {
      |The model's side of the MachineMaintenance conversation.
    }
  }
  adaptor FromOrderManagement from context OrderManagement is {
    handler FromOrderManagementHandler is {
      on event OrderManagement.DeliveryShortageReported is {
        do "the model receives delivery shortage reported"
      }
      on event OrderManagement.ProductionStatusUpdated is {
        do "the model receives production status updated"
      }
      on event OrderManagement.ReadyToShipNotified is {
        do "the model receives ready to ship notified"
      }
      on result OrderManagement.SalesOrderInfo is {
        do "the model receives sales order info"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagement"
      }
    } with {
      briefly "from order management"
      described as {
        |Carries messages from the external OrderManagement.
      }
    }
  } with {
      briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor ToOrderManagement to context OrderManagement is {
    handler ToOrderManagementHandler is {
      on query OrderManagement.GetSalesOrder is {
        do "the model sends get sales order"
      }
      on command OrderManagement.NotifyReadyToShip is {
        do "the model sends notify ready to ship"
      }
      on command OrderManagement.ReportDeliveryShortage is {
        do "the model sends report delivery shortage"
      }
      on command OrderManagement.UpdateProductionStatus is {
        do "the model sends update production status"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderManagement"
      }
    } with {
      briefly "to order management"
      described as {
        |Carries messages to the external OrderManagement.
      }
    }
  } with {
      briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor FromStyleMaster from context StyleMaster is {
    handler FromStyleMasterHandler is {
      on result StyleMaster.OperationSequenceResult is {
        do "the model receives operation sequence result"
      }
      on result StyleMaster.StyleSpecResult is {
        do "the model receives style spec result"
      }
      on result StyleMaster.TrimRequirementsResult is {
        do "the model receives trim requirements result"
      }
      on other is {
        error "Unexpected message for adaptor FromStyleMaster"
      }
    } with {
      briefly "from style master"
      described as {
        |Carries messages from the external StyleMaster.
      }
    }
  } with {
      briefly "StyleMaster integration"
    described as {
      |The model's side of the StyleMaster conversation.
    }
  }
  adaptor ToStyleMaster to context StyleMaster is {
    handler ToStyleMasterHandler is {
      on query StyleMaster.GetOperationSequence is {
        do "the model sends get operation sequence"
      }
      on query StyleMaster.GetStyleSpec is {
        do "the model sends get style spec"
      }
      on query StyleMaster.GetTrimRequirements is {
        do "the model sends get trim requirements"
      }
      on other is {
        error "Unexpected message for adaptor ToStyleMaster"
      }
    } with {
      briefly "to style master"
      described as {
        |Carries messages to the external StyleMaster.
      }
    }
  } with {
      briefly "StyleMaster integration"
    described as {
      |The model's side of the StyleMaster conversation.
    }
  }
  adaptor FromTrimInventory from context TrimInventory is {
    handler FromTrimInventoryHandler is {
      on result TrimInventory.TrimAvailabilityResult is {
        do "the model receives trim availability result"
      }
      on event TrimInventory.TrimConsumed is {
        do "the model receives trim consumed"
      }
      on result TrimInventory.TrimItemInfo is {
        do "the model receives trim item info"
      }
      on event TrimInventory.TrimReserved is {
        do "the model receives trim reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromTrimInventory"
      }
    } with {
      briefly "from trim inventory"
      described as {
        |Carries messages from the external TrimInventory.
      }
    }
  } with {
      briefly "TrimInventory integration"
    described as {
      |The model's side of the TrimInventory conversation.
    }
  }
  adaptor ToTrimInventory to context TrimInventory is {
    handler ToTrimInventoryHandler is {
      on command TrimInventory.ConsumeTrim is {
        do "the model sends consume trim"
      }
      on query TrimInventory.GetTrimAvailability is {
        do "the model sends get trim availability"
      }
      on query TrimInventory.GetTrimItem is {
        do "the model sends get trim item"
      }
      on command TrimInventory.ReserveTrim is {
        do "the model sends reserve trim"
      }
      on other is {
        error "Unexpected message for adaptor ToTrimInventory"
      }
    } with {
      briefly "to trim inventory"
      described as {
        |Carries messages to the external TrimInventory.
      }
    }
  } with {
      briefly "TrimInventory integration"
    described as {
      |The model's side of the TrimInventory conversation.
    }
  }
  include "types.riddl"
  include "CutOrder.riddl"
  // Repository for cut order persistence
  repository CutOrderRepository is {
    inlet CutOrderRepositoryFromCutOrder is type CutOrderEvent
    inlet CutOrderRepositoryFromSAMEfficiencyProjector is type CutOrderEvent
    inlet CutOrderRepositoryFromBundleThroughputProjector is type CutOrderEvent
    inlet CutOrderRepositoryFromOperatorPerformanceProjector is type CutOrderEvent
    inlet CutOrderRepositoryFromQualityMetricsProjector is type CutOrderEvent
    outlet CutOrderRepositoryResponses is type CutOrder.CutOrderResult
    schema CutOrderData is relational
      of cutOrders as type CutOrder
        index on field CutOrder.cutOrderId
        index on field CutOrder.styleSpec.styleId
        index on field CutOrder.status
      with {
      briefly "Cut order data schema"
      described as {
        |The relational schema holding cut order data for the CutOrderRepository.
      }
    }

    handler CutOrderPersistence is {
      on command CutOrder.CreateCutOrder is {
        tell event CutOrder.CutOrderCreated to entity ApparelContext.CutOrder
        do "Store new cut order"
      }
      on command CutOrder.GenerateMarker is {
        do "Update marker data"
      }
      on command CutOrder.CutFabric is {
        do "Update cutting completion"
      }
      on command CutOrder.CreateBundles is {
        tell event CutOrder.BundlesCreated to entity ApparelContext.CutOrder
        do "Store bundle records"
      }
      on command CutOrder.AssignBundle is {
        tell event CutOrder.BundleAssigned to entity ApparelContext.CutOrder
        do "Update bundle assignment"
      }
      on command CutOrder.CompleteSewing is {
        tell event CutOrder.SewingCompleted to entity ApparelContext.CutOrder
        do "Update sewing completion"
      }
      on command CutOrder.CompleteTrimming is {
        tell event CutOrder.TrimmingCompleted to entity ApparelContext.CutOrder
        do "Update trimming completion"
      }
      on command CutOrder.RecordQualityCheck is {
        tell event CutOrder.QualityCheckRecorded to entity ApparelContext.CutOrder
        do "Store quality inspection"
      }
      on command CutOrder.PackGarments is {
        do "Store packing record"
      }
      on command CutOrder.CancelCutOrder is {
        tell event CutOrder.CutOrderCancelled to entity ApparelContext.CutOrder
        do "Update to cancelled"
      }
    } with {
      briefly "Persists cut order events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Cut order data persistence"
    described as {
      | The CutOrderRepository provides persistent storage for
      | cut orders, bundles, and production tracking data.
    }
  }
  // Projector for SAM efficiency tracking
  projector SAMEfficiencyProjector is {
    inlet SAMEfficiencyProjectorFromCutOrder is type CutOrderEvent
    outlet SAMEfficiencyProjectorOut is type CutOrderEvent
    updates repository ApparelContext.CutOrderRepository
    record SAMEfficiencyStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of measurement period.
        }
      }
      totalEarnedMinutes: Decimal(12,2) with {
        briefly "Earned"
        described as {
          |Total earned SAM.
        }
      }
      totalAttendedMinutes: Decimal(12,2) with {
        briefly "Attended"
        described as {
          |Total attended minutes.
        }
      }
      overallEfficiency: Decimal(5,2) with {
        briefly "Efficiency"
        described as {
          |Overall efficiency percent.
        }
      }
      operatorCount: Natural with {
        briefly "Operators"
        described as {
          |Number of operators.
        }
      }
      topPerformers: ProductionEfficiency+ with {
        briefly "Top performers"
        described as {
          |Top performing operators.
        }
      }
    } with {
      briefly "SAM efficiency statistics"
      described as {
        |Standard Allowed Minutes efficiency metrics.
      }
    }
    handler SAMEfficiencyHandler is {
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update operator earned minutes and efficiency"
      }
      on event CutOrder.TrimmingCompleted is {
        tell event CutOrder.TrimmingCompleted to repository ApparelContext.CutOrderRepository
        do "Update trim operation efficiency"
      }
    } with {
      briefly "Maintains SAM efficiency metrics"
      described as {
        |Projects sewing events into efficiency analytics.
      }
    }
  } with {
    briefly "SAM efficiency projections"
    described as {
      |Maintains operator efficiency based on SAM standards.
    }
  }
  // Projector for bundle throughput tracking
  projector BundleThroughputProjector is {
    inlet BundleThroughputProjectorFromCutOrder is type CutOrderEvent
    outlet BundleThroughputProjectorOut is type CutOrderEvent
    updates repository ApparelContext.CutOrderRepository
    record BundleThroughputStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of period.
        }
      }
      bundlesCreated: Natural with {
        briefly "Created"
        described as {
          |Bundles created.
        }
      }
      bundlesAssigned: Natural with {
        briefly "Assigned"
        described as {
          |Bundles assigned.
        }
      }
      bundlesCompleted: Natural with {
        briefly "Completed"
        described as {
          |Bundles completed.
        }
      }
      bundlesPacked: Natural with {
        briefly "Packed"
        described as {
          |Bundles packed.
        }
      }
      averageCycleTime: Decimal(8,2) with {
        briefly "Cycle time"
        described as {
          |Average bundle cycle time (hours).
        }
      }
      wipBundles: Natural with {
        briefly "WIP"
        described as {
          |Work-in-progress bundles.
        }
      }
    } with {
      briefly "Bundle throughput statistics"
      described as {
        |Bundle flow and cycle time metrics.
      }
    }
    handler BundleThroughputHandler is {
      on event CutOrder.BundlesCreated is {
        tell event CutOrder.BundlesCreated to repository ApparelContext.CutOrderRepository
        do "Increment bundles created counter"
      }
      on event CutOrder.BundleAssigned is {
        tell event CutOrder.BundleAssigned to repository ApparelContext.CutOrderRepository
        do "Increment bundles assigned counter"
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update bundle completion metrics"
      }
      on event CutOrder.GarmentsPacked is {
        tell event CutOrder.GarmentsPacked to repository ApparelContext.CutOrderRepository
        do "Update packed bundles and cycle time"
      }
    } with {
      briefly "Maintains bundle throughput metrics"
      described as {
        |Projects bundle events into throughput analytics.
      }
    }
  } with {
    briefly "Bundle throughput projections"
    described as {
      |Maintains bundle flow and WIP tracking data.
    }
  }
  // Projector for operator performance tracking
  projector OperatorPerformanceProjector is {
    inlet OperatorPerformanceProjectorFromCutOrder is type CutOrderEvent
    outlet OperatorPerformanceProjectorOut is type CutOrderEvent
    updates repository ApparelContext.CutOrderRepository
    record OperatorPerformanceStats is  {
      operatorId: OperatorId with {
        briefly "Operator"
        described as {
          |Operator identifier.
        }
      }
      operatorName: String(1,200) with {
        briefly "Name"
        described as {
          |Operator name.
        }
      }
      bundlesCompleted: Natural with {
        briefly "Bundles"
        described as {
          |Bundles completed.
        }
      }
      piecesProduced: Natural with {
        briefly "Pieces"
        described as {
          |Pieces produced.
        }
      }
      defectsProduced: Natural with {
        briefly "Defects"
        described as {
          |Defects produced.
        }
      }
      qualityRate: Decimal(5,2) with {
        briefly "Quality rate"
        described as {
          |Quality rate percent.
        }
      }
      earnedMinutes: Decimal(10,2) with {
        briefly "Earned"
        described as {
          |Earned SAM.
        }
      }
      attendedMinutes: Decimal(10,2) with {
        briefly "Attended"
        described as {
          |Attended minutes.
        }
      }
      efficiency: Decimal(5,2) with {
        briefly "Efficiency"
        described as {
          |Efficiency percent.
        }
      }
      avgBundleTime: Decimal(8,2) with {
        briefly "Avg bundle time"
        described as {
          |Average minutes per bundle.
        }
      }
    } with {
      briefly "Operator performance statistics"
      described as {
        |Individual operator performance metrics.
      }
    }
    handler OperatorPerformanceHandler is {
      on event CutOrder.BundleAssigned is {
        tell event CutOrder.BundleAssigned to repository ApparelContext.CutOrderRepository
        do "Track bundle assignment to operator"
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update operator production metrics"
      }
      on event CutOrder.TrimmingCompleted is {
        tell event CutOrder.TrimmingCompleted to repository ApparelContext.CutOrderRepository
        do "Update operator trim metrics"
      }
      on event CutOrder.QualityCheckRecorded is {
        tell event CutOrder.QualityCheckRecorded to repository ApparelContext.CutOrderRepository
        do "Update operator quality metrics"
      }
    } with {
      briefly "Maintains operator performance metrics"
      described as {
        |Projects production events into operator analytics.
      }
    }
  } with {
    briefly "Operator performance projections"
    described as {
      |Maintains individual operator performance data.
    }
  }
  // Projector for quality metrics
  projector QualityMetricsProjector is {
    inlet QualityMetricsProjectorFromCutOrder is type CutOrderEvent
    outlet QualityMetricsProjectorOut is type CutOrderEvent
    updates repository ApparelContext.CutOrderRepository
    record QualityMetricsStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of period.
        }
      }
      totalInspected: Natural with {
        briefly "Inspected"
        described as {
          |Total garments inspected.
        }
      }
      totalPassed: Natural with {
        briefly "Passed"
        described as {
          |Total garments passed.
        }
      }
      totalFailed: Natural with {
        briefly "Failed"
        described as {
          |Total garments failed.
        }
      }
      firstPassYield: Decimal(5,2) with {
        briefly "FPY"
        described as {
          |First pass yield percent.
        }
      }
      defectsByType: DefectSummary+ with {
        briefly "Defects"
        described as {
          |Defects by type.
        }
      }
      topDefectOperations: String(1,200)+ with {
        briefly "Problem ops"
        described as {
          |Operations with most defects.
        }
      }
    } with {
      briefly "Quality metrics statistics"
      described as {
        |Quality inspection and defect metrics.
      }
    }
    record DefectSummary is  {
      defectType: DefectType with {
        briefly "Type"
        described as {
          |Defect type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Defect count.
        }
      }
      percentage: Decimal(5,2) with {
        briefly "Percentage"
        described as {
          |Percentage of total defects.
        }
      }
    } with {
      briefly "Defect summary"
      described as {
        |Summary of defects by type.
      }
    }
    handler QualityMetricsHandler is {
      on event CutOrder.QualityCheckRecorded is {
        tell event CutOrder.QualityCheckRecorded to repository ApparelContext.CutOrderRepository
        do "Update quality metrics and defect tracking"
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update defect counts from sewing"
      }
    } with {
      briefly "Maintains quality metrics"
      described as {
        |Projects quality events into analytics.
      }
    }
  } with {
    briefly "Quality metrics projections"
    described as {
      |Maintains quality and defect tracking data.
    }
  }
  // ---- Event publication for CutOrder ----
  type CutOrderEvent is one of {
    ApparelContext.CutOrder.CutOrderCreated,
    ApparelContext.CutOrder.MarkerGenerated,
    ApparelContext.CutOrder.FabricCut,
    ApparelContext.CutOrder.BundlesCreated,
    ApparelContext.CutOrder.BundleAssigned,
    ApparelContext.CutOrder.SewingCompleted,
    ApparelContext.CutOrder.TrimmingCompleted,
    ApparelContext.CutOrder.QualityCheckRecorded,
    ApparelContext.CutOrder.GarmentsPacked,
    ApparelContext.CutOrder.CutOrderCancelled
  } with {
    briefly "CutOrder event alternation"
    described as {
      |Union of all CutOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CutOrderEventSource as source is {
    outlet CutOrderEvents is type CutOrderEvent
    handler CutOrderSourceHandler is {
      on event CutOrder.CutOrderCreated is {
        send event CutOrder.CutOrderCreated to outlet CutOrderEvents
      }
      on event CutOrder.MarkerGenerated is {
        send event CutOrder.MarkerGenerated to outlet CutOrderEvents
      }
      on event CutOrder.FabricCut is {
        send event CutOrder.FabricCut to outlet CutOrderEvents
      }
      on event CutOrder.BundlesCreated is {
        send event CutOrder.BundlesCreated to outlet CutOrderEvents
      }
      on event CutOrder.BundleAssigned is {
        send event CutOrder.BundleAssigned to outlet CutOrderEvents
      }
      on event CutOrder.SewingCompleted is {
        send event CutOrder.SewingCompleted to outlet CutOrderEvents
      }
      on event CutOrder.TrimmingCompleted is {
        send event CutOrder.TrimmingCompleted to outlet CutOrderEvents
      }
      on event CutOrder.QualityCheckRecorded is {
        send event CutOrder.QualityCheckRecorded to outlet CutOrderEvents
      }
      on event CutOrder.GarmentsPacked is {
        send event CutOrder.GarmentsPacked to outlet CutOrderEvents
      }
      on event CutOrder.CutOrderCancelled is {
        send event CutOrder.CutOrderCancelled to outlet CutOrderEvents
      }
      on other is {
        error "Unexpected message for source CutOrderEventSource"
      }
    } with {
      briefly "CutOrder source handler"
      described as {
        |Publishes CutOrder events onto the outlet.
      }
    }
  } with {
    briefly "CutOrder event source"
    described as {
      |Publishes CutOrder entity events into the streaming topology.
    }
  }
  processor CutOrderEventSink as sink is {
    inlet CutOrderInlet is type CutOrderEvent
    handler CutOrderSinkHandler is {
      on event CutOrder.CutOrderCreated is {
        tell event CutOrder.CutOrderCreated to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.MarkerGenerated is {
        tell event CutOrder.MarkerGenerated to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.FabricCut is {
        tell event CutOrder.FabricCut to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.BundlesCreated is {
        tell event CutOrder.BundlesCreated to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.BundleAssigned is {
        tell event CutOrder.BundleAssigned to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.TrimmingCompleted is {
        tell event CutOrder.TrimmingCompleted to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.QualityCheckRecorded is {
        tell event CutOrder.QualityCheckRecorded to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.GarmentsPacked is {
        tell event CutOrder.GarmentsPacked to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.CutOrderCancelled is {
        tell event CutOrder.CutOrderCancelled to repository ApparelContext.CutOrderRepository
      }
      on other is {
        error "Unexpected message for sink CutOrderEventSink"
      }
    } with {
      briefly "CutOrder sink handler"
      described as {
        |Persists CutOrder events via the repository.
      }
    }
  } with {
    briefly "CutOrder event sink"
    described as {
      |Receives CutOrder events for persistence.
    }
  }
  connector CutOrderEventFlow is {
    from outlet ApparelContext.CutOrderEventSource.CutOrderEvents to
      inlet ApparelContext.CutOrderEventSink.CutOrderInlet
  } with {
    briefly "CutOrder event flow"
    described as {
      |Connects the CutOrder source to its sink.
    }
  }
  processor CutOrderEventSplit is {
    inlet CutOrderEventSplitIn is type CutOrderEvent
    outlet CutOrderEventSplitToCutOrderRepository is type CutOrderEvent
    outlet CutOrderEventSplitToSAMEfficiencyProjector is type CutOrderEvent
    outlet CutOrderEventSplitToBundleThroughputProjector is type CutOrderEvent
    outlet CutOrderEventSplitToOperatorPerformanceProjector is type CutOrderEvent
    outlet CutOrderEventSplitToQualityMetricsProjector is type CutOrderEvent
    handler CutOrderEventSplitHandler is {
      on event CutOrder.CutOrderCreated is {
        send event CutOrder.CutOrderCreated to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.CutOrderCreated to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.CutOrderCreated to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.CutOrderCreated to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.CutOrderCreated to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.CutOrderCreated to entity ApparelContext.CutOrder
      }
      on event CutOrder.MarkerGenerated is {
        send event CutOrder.MarkerGenerated to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.MarkerGenerated to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.MarkerGenerated to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.MarkerGenerated to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.MarkerGenerated to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.MarkerGenerated to entity ApparelContext.CutOrder
      }
      on event CutOrder.FabricCut is {
        send event CutOrder.FabricCut to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.FabricCut to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.FabricCut to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.FabricCut to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.FabricCut to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.FabricCut to entity ApparelContext.CutOrder
      }
      on event CutOrder.BundlesCreated is {
        send event CutOrder.BundlesCreated to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.BundlesCreated to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.BundlesCreated to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.BundlesCreated to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.BundlesCreated to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.BundlesCreated to entity ApparelContext.CutOrder
      }
      on event CutOrder.BundleAssigned is {
        send event CutOrder.BundleAssigned to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.BundleAssigned to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.BundleAssigned to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.BundleAssigned to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.BundleAssigned to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.BundleAssigned to entity ApparelContext.CutOrder
      }
      on event CutOrder.SewingCompleted is {
        send event CutOrder.SewingCompleted to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.SewingCompleted to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.SewingCompleted to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.SewingCompleted to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.SewingCompleted to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.SewingCompleted to entity ApparelContext.CutOrder
      }
      on event CutOrder.TrimmingCompleted is {
        send event CutOrder.TrimmingCompleted to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.TrimmingCompleted to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.TrimmingCompleted to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.TrimmingCompleted to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.TrimmingCompleted to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.TrimmingCompleted to entity ApparelContext.CutOrder
      }
      on event CutOrder.QualityCheckRecorded is {
        send event CutOrder.QualityCheckRecorded to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.QualityCheckRecorded to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.QualityCheckRecorded to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.QualityCheckRecorded to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.QualityCheckRecorded to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.QualityCheckRecorded to entity ApparelContext.CutOrder
      }
      on event CutOrder.GarmentsPacked is {
        send event CutOrder.GarmentsPacked to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.GarmentsPacked to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.GarmentsPacked to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.GarmentsPacked to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.GarmentsPacked to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.GarmentsPacked to entity ApparelContext.CutOrder
      }
      on event CutOrder.CutOrderCancelled is {
        send event CutOrder.CutOrderCancelled to outlet CutOrderEventSplitToCutOrderRepository
        send event CutOrder.CutOrderCancelled to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send event CutOrder.CutOrderCancelled to outlet CutOrderEventSplitToBundleThroughputProjector
        send event CutOrder.CutOrderCancelled to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send event CutOrder.CutOrderCancelled to outlet CutOrderEventSplitToQualityMetricsProjector
        tell event CutOrder.CutOrderCancelled to entity ApparelContext.CutOrder
      }
      on other is {
        error "Unexpected message for processor CutOrderEventSplit"
      }
    } with {
      briefly "CutOrder event fan-out handler"
      described as {
        |Delivers each CutOrder event to all of its consumers.
      }
    }
  } with {
    briefly "CutOrder event fan-out"
    described as {
      |Fans CutOrder events out to the repository and projectors.
    }
  }
  connector LinkCutOrderToCutOrderEventSplit is {
    from outlet ApparelContext.CutOrder.CutOrderEvents2 to
      inlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitIn
  } with {
    briefly "LinkCutOrderToCutOrderEventSplit"
  }
  connector LinkCutOrderEventSplitToCutOrderRepository is {
    from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToCutOrderRepository to
      inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromCutOrder
  } with {
    briefly "LinkCutOrderEventSplitToCutOrderRepository"
  }
  connector LinkCutOrderEventSplitToSAMEfficiencyProjector is {
    from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToSAMEfficiencyProjector to
      inlet ApparelContext.SAMEfficiencyProjector.SAMEfficiencyProjectorFromCutOrder
  } with {
    briefly "LinkCutOrderEventSplitToSAMEfficiencyProjector"
  }
  connector LinkCutOrderEventSplitToBundleThroughputProjector is {
    from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToBundleThroughputProjector to
      inlet ApparelContext.BundleThroughputProjector.BundleThroughputProjectorFromCutOrder
  } with {
    briefly "LinkCutOrderEventSplitToBundleThroughputProjector"
  }
  connector LinkCutOrderEventSplitToOperatorPerformanceProjector is {
    from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToOperatorPerformanceProjector to
      inlet ApparelContext.OperatorPerformanceProjector.OperatorPerformanceProjectorFromCutOrder
  } with {
    briefly "LinkCutOrderEventSplitToOperatorPerformanceProjector"
  }
  connector LinkCutOrderEventSplitToQualityMetricsProjector is {
    from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToQualityMetricsProjector to
      inlet ApparelContext.QualityMetricsProjector.QualityMetricsProjectorFromCutOrder
  } with {
    briefly "LinkCutOrderEventSplitToQualityMetricsProjector"
  }
  connector LinkSAMEfficiencyProjectorToCutOrderRepository is {
    from outlet ApparelContext.SAMEfficiencyProjector.SAMEfficiencyProjectorOut to
      inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromSAMEfficiencyProjector
  } with {
    briefly "LinkSAMEfficiencyProjectorToCutOrderRepository"
  }
  connector LinkBundleThroughputProjectorToCutOrderRepository is {
    from outlet ApparelContext.BundleThroughputProjector.BundleThroughputProjectorOut to
      inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromBundleThroughputProjector
  } with {
    briefly "LinkBundleThroughputProjectorToCutOrderRepository"
  }
  connector LinkOperatorPerformanceProjectorToCutOrderRepository is {
    from outlet ApparelContext.OperatorPerformanceProjector.OperatorPerformanceProjectorOut to
      inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromOperatorPerformanceProjector
  } with {
    briefly "LinkOperatorPerformanceProjectorToCutOrderRepository"
  }
  connector LinkQualityMetricsProjectorToCutOrderRepository is {
    from outlet ApparelContext.QualityMetricsProjector.QualityMetricsProjectorOut to
      inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromQualityMetricsProjector
  } with {
    briefly "LinkQualityMetricsProjectorToCutOrderRepository"
  }
} with {
  briefly "Bounded context for apparel manufacturing"
  described as {
    | The ApparelContext is the bounded context for
    | cut-sew-trim apparel production and tracking.
  }
}
