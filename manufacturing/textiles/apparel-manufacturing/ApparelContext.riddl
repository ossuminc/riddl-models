        tell command ApparelContext.CutOrderRepository.PersistCutOrderCreated(cutOrderId = cutOrderCreated.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply CutOrderCreated to the BundleThroughputProjector projection"
      }
      on fabricCut: event CutOrder.FabricCut is {
        tell command ApparelContext.CutOrderRepository.PersistFabricCut(cutOrderId = fabricCut.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply FabricCut to the BundleThroughputProjector projection"
      }
      on markerGenerated: event CutOrder.MarkerGenerated is {
        tell command ApparelContext.CutOrderRepository.PersistMarkerGenerated(cutOrderId = markerGenerated.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply MarkerGenerated to the BundleThroughputProjector projection"
      }
      on qualityCheckRecorded: event CutOrder.QualityCheckRecorded is {
        tell command ApparelContext.CutOrderRepository.PersistQualityCheckRecorded(cutOrderId = qualityCheckRecorded.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply QualityCheckRecorded to the BundleThroughputProjector projection"
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        tell command ApparelContext.CutOrderRepository.PersistTrimmingCompleted(cutOrderId = trimmingCompleted.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply TrimmingCompleted to the BundleThroughputProjector projection"
      }
      on bundlesCreatedEvent: event CutOrder.BundlesCreated is {
        tell command ApparelContext.CutOrderRepository.PersistBundlesCreated(cutOrderId = bundlesCreatedEvent.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "Increment bundles created counter"
      }
      on bundleAssigned: event CutOrder.BundleAssigned is {
        tell command ApparelContext.CutOrderRepository.PersistBundleAssigned(cutOrderId = bundleAssigned.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "Increment bundles assigned counter"
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        tell command ApparelContext.CutOrderRepository.PersistSewingCompleted(cutOrderId = sewingCompleted.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "Update bundle completion metrics"
      }
      on garmentsPacked: event CutOrder.GarmentsPacked is {
        tell command ApparelContext.CutOrderRepository.PersistGarmentsPacked(cutOrderId = garmentsPacked.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "Update packed bundles and cycle time"
      }
    } with {
      briefly "Maintains bundle throughput metrics"
      described as {
        |Projects bundle events into throughput analytics.
      }
    }
  } with {
    briefly "Bundle throughput projections"
    described as {
      |Maintains bundle flow and WIP tracking data.
    }
  }
  // Projector for operator performance tracking
  query GetOperatorPerformanceStats replies result OperatorPerformanceStatsView is {
    operatorPerformanceStatsKey: String(1,100) with {
      briefly "Key"
      described as {
