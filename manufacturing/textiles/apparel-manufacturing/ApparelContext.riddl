// Apparel Manufacturing - Apparel Context
context ApparelContext as router is {
  connector 'QualityMetricsProjector Storage' is from outlet ApparelContext.QualityMetricsProjector.QualityMetricsProjectorToRepository to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromQualityMetricsProjector with {
    briefly "QualityMetricsProjector messages on their way to CutOrderRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'OperatorPerformanceProjector Storage' is from outlet ApparelContext.OperatorPerformanceProjector.OperatorPerformanceProjectorToRepository to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromOperatorPerformanceProjector with {
    briefly "OperatorPerformanceProjector messages on their way to CutOrderRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'BundleThroughputProjector Storage' is from outlet ApparelContext.BundleThroughputProjector.BundleThroughputProjectorToRepository to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromBundleThroughputProjector with {
    briefly "BundleThroughputProjector messages on their way to CutOrderRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet CutOrderCommandStreamIn is type CutOrderCommand  outlet CutOrderCommandStreamOut is type CutOrderCommand
  inlet CutOrderResultStreamIn is result CutOrder.CutOrderResult  outlet CutOrderResultStreamOut is result CutOrder.CutOrderResult
  handler ApparelContextBoundary is {
    on createCutOrder: command CutOrder.CreateCutOrder is {
      send createCutOrder to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on recordMachineBreakdown: command CutOrder.RecordMachineBreakdown is {
      send recordMachineBreakdown to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on generateMarker: command CutOrder.GenerateMarker is {
      send generateMarker to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on cutFabric: command CutOrder.CutFabric is {
      send cutFabric to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on createBundles: command CutOrder.CreateBundles is {
      send createBundles to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on assignBundle: command CutOrder.AssignBundle is {
      send assignBundle to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on completeSewing: command CutOrder.CompleteSewing is {
      send completeSewing to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on completeTrimming: command CutOrder.CompleteTrimming is {
      send completeTrimming to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on recordQualityCheck: command CutOrder.RecordQualityCheck is {
      send recordQualityCheck to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on packGarments: command CutOrder.PackGarments is {
      send packGarments to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on cancelCutOrder: command CutOrder.CancelCutOrder is {
      send cancelCutOrder to outlet ApparelContext.CutOrderCommandStreamOut
    }
    on cutOrderResult: result CutOrder.CutOrderResult is {
      send cutOrderResult to outlet ApparelContext.CutOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the ApparelContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CutOrderCommand Stream Intake' is from outlet ApparelContext.CutOrderCommandStreamOut to inlet ApparelContext.CutOrder.CutOrderCommands  connector 'CutOrderResult Stream Egress' is from outlet ApparelContext.CutOrderRepository.CutOrderRepositoryResponses to inlet ApparelContext.CutOrderResultStreamIn  adaptor FromFabricInventory from context FabricInventory is { 
    inlet FromFabricInventoryIn is type FabricInventory.FabricInventoryEvent    handler FromFabricInventoryHandler is {
      on fabricConsumed: event FabricInventory.FabricConsumed is {
        do "the roll is drawn down; cutting was recorded here"
      }
      on fabricReserved: event FabricInventory.FabricReserved is {
        do "the fabric is held; cutting starts when the floor does"
      }
      on other is {
        error "Unexpected message for adaptor FromFabricInventory"
      }
    } with {
      briefly "from fabric inventory"
      described as {
        |Carries messages from the external FabricInventory.
      }
    }
  } with {
    briefly "FabricInventory integration"
    described as {
      |The model's side of the FabricInventory conversation.
    }
  }
  adaptor ToFabricInventory to context FabricInventory as merge is { 
    inlet ToFabricInventoryIn is type CutOrderEvent    inlet ToFabricInventoryReplies is result FabricInventory.AvailableFabricRolls    outlet ToFabricInventoryOut is type FabricInventory.FabricInventoryCommand
    handler ToFabricInventoryHandler is {
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        let askAnswer: type FabricInventory.AvailableFabricRolls = ask query FabricInventory.GetAvailableFabric of context FabricInventory
        do "a cut order needing fabric that exists before it is planned"
        let claim: type FabricInventory.ReserveFabric = prompt("translate the cutOrderCreated event into a ReserveFabric claiming the cloth this cut order commits to")
        send claim to outlet ApparelContext.ToFabricInventory.ToFabricInventoryOut
      }
      on fabricCut: event CutOrder.FabricCut is {
        let consumption: type FabricInventory.ConsumeFabric = prompt("translate the fabricCut event into a ConsumeFabric, cutting being where the cloth is irreversibly used")
        send consumption to outlet ApparelContext.ToFabricInventory.ToFabricInventoryOut
      }
      on markerGenerated: event CutOrder.MarkerGenerated is {
        let askAnswer: type FabricInventory.AvailableFabricRolls = ask query FabricInventory.GetFabricRoll of context FabricInventory
        do "the marker needing the roll's actual width and length"
      }
      on other is {
        error "Unexpected message for adaptor ToFabricInventory"
      }
    } with {
      briefly "to fabric inventory"
      described as {
        |Carries messages to the external FabricInventory.
      }
    }
  } with {
    briefly "FabricInventory integration"
    described as {
      |The model's side of the FabricInventory conversation.
    }
  }
  adaptor FromMachineMaintenance from context MachineMaintenance is { 
    inlet FromMachineMaintenanceIn is event MachineMaintenance.MachineBreakdownReported    handler FromMachineMaintenanceHandler is {
      on machineBreakdownReported: event MachineMaintenance.MachineBreakdownReported is {
        do "maintenance has the breakdown; recording it here came first"
      }
      on other is {
        error "Unexpected message for adaptor FromMachineMaintenance"
      }
    } with {
      briefly "from machine maintenance"
      described as {
        |Carries messages from the external MachineMaintenance.
      }
    }
  } with {
    briefly "MachineMaintenance integration"
    described as {
      |The model's side of the MachineMaintenance conversation.
    }
  }
  adaptor ToMachineMaintenance to context MachineMaintenance as flow is { 
    outlet ToMachineMaintenanceOut is type MachineMaintenance.MachineMaintenanceRequest
    handler ToMachineMaintenanceHandler is {
      on sewingCompleted: event CutOrder.SewingCompleted is {
        let askAnswer: type MachineMaintenance.MachineStatusResult = ask query MachineMaintenance.GetMachineStatus of context MachineMaintenance
        do "a completed sewing run being when the line's condition is worth checking"
      }
      on machineBreakdownRecorded: event CutOrder.MachineBreakdownRecorded is {
        let item0: type MachineMaintenance.ReportMachineBreakdown = prompt("translate the machineBreakdownRecorded event into a ReportMachineBreakdown, a machine failing on the floor being what maintenance is called for")
        send item0 to outlet ApparelContext.ToMachineMaintenance.ToMachineMaintenanceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMachineMaintenance"
      }
    } with {
      briefly "to machine maintenance"
      described as {
        |Carries messages to the external MachineMaintenance.
      }
    }
  } with {
    briefly "MachineMaintenance integration"
    described as {
      |The model's side of the MachineMaintenance conversation.
    }
  }
  adaptor FromOrderManagement from context OrderManagement is { 
    inlet FromOrderManagementIn is type OrderManagement.OrderManagementEvent    handler FromOrderManagementHandler is {
      on deliveryShortageReported: event OrderManagement.DeliveryShortageReported is {
        do "the customer's order shows the shortfall; cancelling was recorded here"
      }
      on productionStatusUpdated: event OrderManagement.ProductionStatusUpdated is {
        do "the order shows our progress; nothing here changes"
      }
      on readyToShipNotified: event OrderManagement.ReadyToShipNotified is {
        do "order management knows the garments are packed; packing was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagement"
      }
    } with {
      briefly "from order management"
      described as {
        |Carries messages from the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor ToOrderManagement to context OrderManagement as merge is { 
    inlet ToOrderManagementIn is type CutOrderEvent    inlet ToOrderManagementReplies is result OrderManagement.SalesOrderInfo    outlet ToOrderManagementOut is type OrderManagement.OrderManagementCommand
    handler ToOrderManagementHandler is {
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        let askAnswer: type OrderManagement.SalesOrderInfo = ask query OrderManagement.GetSalesOrder of context OrderManagement
        do "and the sales order it is cut against"
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        let item0: type OrderManagement.UpdateProductionStatus = prompt("translate the sewingCompleted event into a UpdateProductionStatus, sewing being the milestone the buyer watches")
        send item0 to outlet ApparelContext.ToOrderManagement.ToOrderManagementOut
      }
      on garmentsPacked: event CutOrder.GarmentsPacked is {
        let item0: type OrderManagement.NotifyReadyToShip = prompt("translate the garmentsPacked event into a NotifyReadyToShip, packing being when the goods can leave")
        send item0 to outlet ApparelContext.ToOrderManagement.ToOrderManagementOut
      }
      on cutOrderCancelled: event CutOrder.CutOrderCancelled is {
        let item0: type OrderManagement.ReportDeliveryShortage = prompt("translate the cutOrderCancelled event into a ReportDeliveryShortage, cancellation being what leaves the order short")
        send item0 to outlet ApparelContext.ToOrderManagement.ToOrderManagementOut
      }
      on other is {
        error "Unexpected message for adaptor ToOrderManagement"
      }
    } with {
      briefly "to order management"
      described as {
        |Carries messages to the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor ToStyleMaster to context StyleMaster as merge is { 
    inlet ToStyleMasterIn is type CutOrderEvent    inlet ToStyleMasterReplies is type StyleMaster.StyleMasterReply    outlet ToStyleMasterOut is type StyleMaster.StyleMasterRequest
    handler ToStyleMasterHandler is {
      on bundlesCreatedAsk: event CutOrder.BundlesCreated is {
        let askAnswer: type StyleMaster.OperationSequenceResult = ask query StyleMaster.GetOperationSequence of context StyleMaster
        do "bundles needing the operation sequence they will move through"
      }
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        let askAnswer: type StyleMaster.StyleSpecResult = ask query StyleMaster.GetStyleSpec of context StyleMaster
        do "a new cut order needing the style it is cutting to"
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        let askAnswer: type StyleMaster.TrimRequirementsResult = ask query StyleMaster.GetTrimRequirements of context StyleMaster
        do "finished trimming needing the requirements to be checked against"
      }
      on other is {
        error "Unexpected message for adaptor ToStyleMaster"
      }
    } with {
      briefly "to style master"
      described as {
        |Carries messages to the external StyleMaster.
      }
    }
  } with {
    briefly "StyleMaster integration"
    described as {
      |The model's side of the StyleMaster conversation.
    }
  }
  adaptor FromTrimInventory from context TrimInventory is { 
    inlet FromTrimInventoryIn is type TrimInventory.TrimInventoryEvent    handler FromTrimInventoryHandler is {
      on trimConsumed: event TrimInventory.TrimConsumed is {
        do "the trim is drawn down; trimming was recorded here"
      }
      on trimReserved: event TrimInventory.TrimReserved is {
        do "the trim is held; sewing starts when the floor does"
      }
      on other is {
        error "Unexpected message for adaptor FromTrimInventory"
      }
    } with {
      briefly "from trim inventory"
      described as {
        |Carries messages from the external TrimInventory.
      }
    }
  } with {
    briefly "TrimInventory integration"
    described as {
      |The model's side of the TrimInventory conversation.
    }
  }
  adaptor ToTrimInventory to context TrimInventory as merge is { 
    inlet ToTrimInventoryIn is type CutOrderEvent    inlet ToTrimInventoryReplies is type TrimInventory.TrimInventoryReply    outlet ToTrimInventoryOut is type TrimInventory.TrimInventoryCommand
    handler ToTrimInventoryHandler is {
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        let claim: type TrimInventory.ReserveTrim = prompt("translate the cutOrderCreated event into a ReserveTrim claiming the trims this cut order commits to")
        send claim to outlet ApparelContext.ToTrimInventory.ToTrimInventoryOut
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        let consumption: type TrimInventory.ConsumeTrim = prompt("translate the trimmingCompleted event into a ConsumeTrim, the trims having now been attached")
        send consumption to outlet ApparelContext.ToTrimInventory.ToTrimInventoryOut
      }
      on bundlesCreatedAsk: event CutOrder.BundlesCreated is {
        let askAnswer: type TrimInventory.TrimAvailabilityResult = ask query TrimInventory.GetTrimAvailability of context TrimInventory
        do "bundles being unsewable without their trims"
      }
      on bundleAssigned: event CutOrder.BundleAssigned is {
        let askAnswer: type TrimInventory.TrimItemInfo = ask query TrimInventory.GetTrimItem of context TrimInventory
        do "and each assignment needing the trim's own specification"
      }
      on other is {
        error "Unexpected message for adaptor ToTrimInventory"
      }
    } with {
      briefly "to trim inventory"
      described as {
        |Carries messages to the external TrimInventory.
      }
    }
  } with {
    briefly "TrimInventory integration"
    described as {
      |The model's side of the TrimInventory conversation.
    }
  }
  include "types.riddl"
  include "CutOrder.riddl"
  // Repository for cut order persistence
  type CutOrderRepositoryCommand is one of {
    ApparelContext.CutOrderRepository.PersistBundleAssigned or ApparelContext.CutOrderRepository.PersistBundlesCreated or ApparelContext.CutOrderRepository.PersistCutOrderCancelled or ApparelContext.CutOrderRepository.PersistCutOrderCreated or ApparelContext.CutOrderRepository.PersistFabricCut or ApparelContext.CutOrderRepository.PersistGarmentsPacked or ApparelContext.CutOrderRepository.PersistMarkerGenerated or ApparelContext.CutOrderRepository.PersistMachineBreakdownRecorded or ApparelContext.CutOrderRepository.PersistQualityCheckRecorded or ApparelContext.CutOrderRepository.PersistSewingCompleted or ApparelContext.CutOrderRepository.PersistTrimmingCompleted
  } with {
    briefly "Anything that writes CutOrderRepository"
    described as {
      |The persistence commands CutOrderRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CutOrderRepository as merge is {
    inlet CutOrderRepositoryFromQualityMetricsProjector is type CutOrderRepositoryCommand with {
      briefly "What QualityMetricsProjector sends CutOrderRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet CutOrderRepositoryFromOperatorPerformanceProjector is type CutOrderRepositoryCommand with {
      briefly "What OperatorPerformanceProjector sends CutOrderRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet CutOrderRepositoryFromBundleThroughputProjector is type CutOrderRepositoryCommand with {
      briefly "What BundleThroughputProjector sends CutOrderRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet CutOrderRepositoryFromSAMEfficiencyProjector is type CutOrderRepositoryCommand    command PersistCutOrderCancelled is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row CutOrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist CutOrderCancelled"
      described as {
        |Instructs this repository to apply CutOrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCutOrderCreated is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row CutOrderCreated applies to.
        }
      }
    } with {
      briefly "Persist CutOrderCreated"
      described as {
        |Instructs this repository to apply CutOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFabricCut is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row FabricCut applies to.
        }
      }
    } with {
      briefly "Persist FabricCut"
      described as {
        |Instructs this repository to apply FabricCut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMarkerGenerated is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MarkerGenerated applies to.
        }
      }
    } with {
      briefly "Persist MarkerGenerated"
      described as {
        |Instructs this repository to apply MarkerGenerated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBundleAssigned is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row BundleAssigned applies to.
        }
      }
    } with {
      briefly "Persist BundleAssigned"
      described as {
        |Instructs this repository to apply BundleAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBundlesCreated is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row BundlesCreated applies to.
        }
      }
    } with {
      briefly "Persist BundlesCreated"
      described as {
        |Instructs this repository to apply BundlesCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGarmentsPacked is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row GarmentsPacked applies to.
        }
      }
    } with {
      briefly "Persist GarmentsPacked"
      described as {
        |Instructs this repository to apply GarmentsPacked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMachineBreakdownRecorded is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MachineBreakdownRecorded applies to.
        }
      }
    } with {
      briefly "Persist MachineBreakdownRecorded"
      described as {
        |Instructs this repository to apply MachineBreakdownRecorded to the
        |stored row. A persistence command, not a domain command: it declares
        |no `yields` because storing a row records no new entity state.
      }
    }
    command PersistQualityCheckRecorded is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row QualityCheckRecorded applies to.
        }
      }
    } with {
      briefly "Persist QualityCheckRecorded"
      described as {
        |Instructs this repository to apply QualityCheckRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSewingCompleted is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SewingCompleted applies to.
        }
      }
    } with {
      briefly "Persist SewingCompleted"
      described as {
        |Instructs this repository to apply SewingCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTrimmingCompleted is {
      cutOrderId: CutOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row TrimmingCompleted applies to.
        }
      }
    } with {
      briefly "Persist TrimmingCompleted"
      described as {
        |Instructs this repository to apply TrimmingCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CutOrderRepositoryResponses is result CutOrder.CutOrderResult
    record StoredCutOrder is {
      cutOrderId: CutOrderId with {
        briefly "cutOrderId"
        described as {
          |The cutOrderId column of the stored cutOrder row.
        }
      }
      styleSpec: GarmentSpec with {
        briefly "styleSpec"
        described as {
          |The styleSpec column of the stored cutOrder row.
        }
      }
    } with {
      briefly "Stored cutOrder row"
      described as {
        |The persistence shape of cutOrder data as this repository stores it.
      }
    }
    schema CutOrderData is relational
      of cutOrders as record StoredCutOrder
        index on field StoredCutOrder.cutOrderId
        index on field StoredCutOrder.styleSpec.styleId
        index on field StoredCutOrder.status
 with {
      briefly "Cut order data schema"
      described as {
        |The relational schema holding cut order data for the CutOrderRepository.
      }
    }
    handler CutOrderPersistence is {
      on persistCutOrderCancelled: command PersistCutOrderCancelled is {
        do "apply CutOrderCancelled to the stored row"
      }
      on persistCutOrderCreated: command PersistCutOrderCreated is {
        do "apply CutOrderCreated to the stored row"
      }
      on persistFabricCut: command PersistFabricCut is {
        do "apply FabricCut to the stored row"
      }
      on persistMarkerGenerated: command PersistMarkerGenerated is {
        do "apply MarkerGenerated to the stored row"
      }
      on persistBundleAssigned: command PersistBundleAssigned is {
        do "apply BundleAssigned to the stored row"
      }
      on persistBundlesCreated: command PersistBundlesCreated is {
        do "apply BundlesCreated to the stored row"
      }
      on persistGarmentsPacked: command PersistGarmentsPacked is {
        do "apply GarmentsPacked to the stored row"
      }
      on persistMachineBreakdownRecorded: command PersistMachineBreakdownRecorded is {
        do "apply MachineBreakdownRecorded to the stored row"
      }
      on persistQualityCheckRecorded: command PersistQualityCheckRecorded is {
        do "apply QualityCheckRecorded to the stored row"
      }
      on persistSewingCompleted: command PersistSewingCompleted is {
        do "apply SewingCompleted to the stored row"
      }
      on persistTrimmingCompleted: command PersistTrimmingCompleted is {
        do "apply TrimmingCompleted to the stored row"
      }
      on query GetSAMEfficiencyStats is {
        let sAMEfficiencyStatsView: type SAMEfficiencyStatsView = prompt("read the sam efficiency stats projection")
        reply sAMEfficiencyStatsView
      }
      on query GetBundleThroughputStats is {
        let bundleThroughputStatsView: type BundleThroughputStatsView = prompt("read the bundle throughput stats projection")
        reply bundleThroughputStatsView
      }
      on query GetOperatorPerformanceStats is {
        let operatorPerformanceStatsView: type OperatorPerformanceStatsView = prompt("read the operator performance stats projection")
        reply operatorPerformanceStatsView
      }
      on query GetQualityMetricsStats is {
        let qualityMetricsStatsView: type QualityMetricsStatsView = prompt("read the quality metrics stats projection")
        reply qualityMetricsStatsView
      }
    } with {
      briefly "Persists cut order events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Cut order data persistence"
    described as {
      | The CutOrderRepository provides persistent storage for
      | cut orders, bundles, and production tracking data.
    }
  }
  // Projector for SAM efficiency tracking
  query GetSAMEfficiencyStats replies result SAMEfficiencyStatsView is {
    sAMEfficiencyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which sam efficiency stats to retrieve.
      }
    }
  } with {
    briefly "Get sam efficiency stats"
    described as {
      |Retrieves the sam efficiency stats projection.
    }
  }
  result SAMEfficiencyStatsView is {
    sAMEfficiencyStats: SAMEfficiencyProjector.SAMEfficiencyStats with {
      briefly "Sam efficiency stats"
      described as {
        |The sam efficiency stats being returned.
      }
    }
  } with {
    briefly "Sam efficiency stats view"
    described as {
      |Read model view carrying the sam efficiency stats projection.
    }
  }
  projector SAMEfficiencyProjector as flow is {
    updates repository ApparelContext.CutOrderRepository
    outlet SAMEfficiencyProjectorToRepository is type CutOrderRepositoryCommand
    inlet SAMEfficiencyProjectorFromCutOrder is type CutOrderEvent    record SAMEfficiencyStats is {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of measurement period.
        }
      }
      totalEarnedMinutes: Decimal(12,2) with {
        briefly "Earned"
        described as {
          |Total earned SAM.
        }
      }
      totalAttendedMinutes: Decimal(12,2) with {
        briefly "Attended"
        described as {
          |Total attended minutes.
        }
      }
      overallEfficiency: Decimal(5,2) with {
        briefly "Efficiency"
        described as {
          |Overall efficiency percent.
        }
      }
      operatorCount: Natural with {
        briefly "Operators"
        described as {
          |Number of operators.
        }
      }
      topPerformers: ProductionEfficiency+ with {
        briefly "Top performers"
        described as {
          |Top performing operators.
        }
      }
    } with {
      briefly "SAM efficiency statistics"
      described as {
        |Standard Allowed Minutes efficiency metrics.
      }
    }
    handler SAMEfficiencyHandler is {
      on machineBreakdownRecorded: event CutOrder.MachineBreakdownRecorded is {
        tell command ApparelContext.CutOrderRepository.PersistMachineBreakdownRecorded(cutOrderId = machineBreakdownRecorded.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply MachineBreakdownRecorded to the SAMEfficiencyProjector projection"
      }
      on bundleAssigned: event CutOrder.BundleAssigned is {
        tell command ApparelContext.CutOrderRepository.PersistBundleAssigned(cutOrderId = bundleAssigned.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply BundleAssigned to the SAMEfficiencyProjector projection"
      }
      on bundlesCreatedEvt: event CutOrder.BundlesCreated is {
        tell command ApparelContext.CutOrderRepository.PersistBundlesCreated(cutOrderId = bundlesCreatedEvt.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply BundlesCreated to the SAMEfficiencyProjector projection"
