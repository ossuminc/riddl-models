// Apparel Manufacturing - Apparel Context
context ApparelContext is {
  include "types.riddl"
  include "CutOrder.riddl"
  // Repository for cut order persistence
  repository CutOrderRepository is {
    schema CutOrderData is relational
      of cutOrders as type CutOrder
        index on field CutOrder.cutOrderId
        index on field CutOrder.styleSpec.styleId
        index on field CutOrder.status

    handler CutOrderPersistence is {
      on command CutOrder.CreateCutOrder is {
        tell event CutOrder.CutOrderCreated to entity ApparelContext.CutOrder
        prompt "Store new cut order"
      }
      on command CutOrder.GenerateMarker is {
        prompt "Update marker data"
      }
      on command CutOrder.CutFabric is {
        prompt "Update cutting completion"
      }
      on command CutOrder.CreateBundles is {
        tell event CutOrder.BundlesCreated to entity ApparelContext.CutOrder
        prompt "Store bundle records"
      }
      on command CutOrder.AssignBundle is {
        tell event CutOrder.BundleAssigned to entity ApparelContext.CutOrder
        prompt "Update bundle assignment"
      }
      on command CutOrder.CompleteSewing is {
        tell event CutOrder.SewingCompleted to entity ApparelContext.CutOrder
        prompt "Update sewing completion"
      }
      on command CutOrder.CompleteTrimming is {
        tell event CutOrder.TrimmingCompleted to entity ApparelContext.CutOrder
        prompt "Update trimming completion"
      }
      on command CutOrder.RecordQualityCheck is {
        tell event CutOrder.QualityCheckRecorded to entity ApparelContext.CutOrder
        prompt "Store quality inspection"
      }
      on command CutOrder.PackGarments is {
        prompt "Store packing record"
      }
      on command CutOrder.CancelCutOrder is {
        tell event CutOrder.CutOrderCancelled to entity ApparelContext.CutOrder
        prompt "Update to cancelled"
      }
    } with {
      briefly "Persists cut order events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Cut order data persistence"
    described as {
      | The CutOrderRepository provides persistent storage for
      | cut orders, bundles, and production tracking data.
    }
  }
  // Projector for SAM efficiency tracking
  projector SAMEfficiencyProjector is {
    updates repository ApparelContext.CutOrderRepository
    record SAMEfficiencyStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of measurement period.
        }
      }
      totalEarnedMinutes: Decimal(12,2) with {
        briefly "Earned"
        described as {
          |Total earned SAM.
        }
      }
      totalAttendedMinutes: Decimal(12,2) with {
        briefly "Attended"
        described as {
          |Total attended minutes.
        }
      }
      overallEfficiency: Decimal(5,2) with {
        briefly "Efficiency"
        described as {
          |Overall efficiency percent.
        }
      }
      operatorCount: Natural with {
        briefly "Operators"
        described as {
          |Number of operators.
        }
      }
      topPerformers: ProductionEfficiency+ with {
        briefly "Top performers"
        described as {
          |Top performing operators.
        }
      }
    } with {
      briefly "SAM efficiency statistics"
      described as {
        |Standard Allowed Minutes efficiency metrics.
      }
    }
    handler SAMEfficiencyHandler is {
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        prompt "Update operator earned minutes and efficiency"
      }
      on event CutOrder.TrimmingCompleted is {
        tell event CutOrder.TrimmingCompleted to repository ApparelContext.CutOrderRepository
        prompt "Update trim operation efficiency"
      }
    } with {
      briefly "Maintains SAM efficiency metrics"
      described as {
        |Projects sewing events into efficiency analytics.
      }
    }
  } with {
    briefly "SAM efficiency projections"
    described as {
      |Maintains operator efficiency based on SAM standards.
    }
  }
  // Projector for bundle throughput tracking
  projector BundleThroughputProjector is {
    updates repository ApparelContext.CutOrderRepository
    record BundleThroughputStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of period.
        }
      }
      bundlesCreated: Natural with {
        briefly "Created"
        described as {
          |Bundles created.
        }
      }
      bundlesAssigned: Natural with {
        briefly "Assigned"
        described as {
          |Bundles assigned.
        }
      }
      bundlesCompleted: Natural with {
        briefly "Completed"
        described as {
          |Bundles completed.
        }
      }
      bundlesPacked: Natural with {
        briefly "Packed"
        described as {
          |Bundles packed.
        }
      }
      averageCycleTime: Decimal(8,2) with {
        briefly "Cycle time"
        described as {
          |Average bundle cycle time (hours).
        }
      }
      wipBundles: Natural with {
        briefly "WIP"
        described as {
          |Work-in-progress bundles.
        }
      }
    } with {
      briefly "Bundle throughput statistics"
      described as {
        |Bundle flow and cycle time metrics.
      }
    }
    handler BundleThroughputHandler is {
      on event CutOrder.BundlesCreated is {
        tell event CutOrder.BundlesCreated to repository ApparelContext.CutOrderRepository
        prompt "Increment bundles created counter"
      }
      on event CutOrder.BundleAssigned is {
        tell event CutOrder.BundleAssigned to repository ApparelContext.CutOrderRepository
        prompt "Increment bundles assigned counter"
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        prompt "Update bundle completion metrics"
      }
      on event CutOrder.GarmentsPacked is {
        tell event CutOrder.GarmentsPacked to repository ApparelContext.CutOrderRepository
        prompt "Update packed bundles and cycle time"
      }
    } with {
      briefly "Maintains bundle throughput metrics"
      described as {
        |Projects bundle events into throughput analytics.
      }
    }
  } with {
    briefly "Bundle throughput projections"
    described as {
      |Maintains bundle flow and WIP tracking data.
    }
  }
  // Projector for operator performance tracking
  projector OperatorPerformanceProjector is {
    updates repository ApparelContext.CutOrderRepository
    record OperatorPerformanceStats is  {
      operatorId: OperatorId with {
        briefly "Operator"
        described as {
          |Operator identifier.
        }
      }
      operatorName: String(1,200) with {
        briefly "Name"
        described as {
          |Operator name.
        }
      }
      bundlesCompleted: Natural with {
        briefly "Bundles"
        described as {
          |Bundles completed.
        }
      }
      piecesProduced: Natural with {
        briefly "Pieces"
        described as {
          |Pieces produced.
        }
      }
      defectsProduced: Natural with {
        briefly "Defects"
        described as {
          |Defects produced.
        }
      }
      qualityRate: Decimal(5,2) with {
        briefly "Quality rate"
        described as {
          |Quality rate percent.
        }
      }
      earnedMinutes: Decimal(10,2) with {
        briefly "Earned"
        described as {
          |Earned SAM.
        }
      }
      attendedMinutes: Decimal(10,2) with {
        briefly "Attended"
        described as {
          |Attended minutes.
        }
      }
      efficiency: Decimal(5,2) with {
        briefly "Efficiency"
        described as {
          |Efficiency percent.
        }
      }
      avgBundleTime: Decimal(8,2) with {
        briefly "Avg bundle time"
        described as {
          |Average minutes per bundle.
        }
      }
    } with {
      briefly "Operator performance statistics"
      described as {
        |Individual operator performance metrics.
      }
    }
    handler OperatorPerformanceHandler is {
      on event CutOrder.BundleAssigned is {
        tell event CutOrder.BundleAssigned to repository ApparelContext.CutOrderRepository
        prompt "Track bundle assignment to operator"
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        prompt "Update operator production metrics"
      }
      on event CutOrder.TrimmingCompleted is {
        tell event CutOrder.TrimmingCompleted to repository ApparelContext.CutOrderRepository
        prompt "Update operator trim metrics"
      }
      on event CutOrder.QualityCheckRecorded is {
        tell event CutOrder.QualityCheckRecorded to repository ApparelContext.CutOrderRepository
        prompt "Update operator quality metrics"
      }
    } with {
      briefly "Maintains operator performance metrics"
      described as {
        |Projects production events into operator analytics.
      }
    }
  } with {
    briefly "Operator performance projections"
    described as {
      |Maintains individual operator performance data.
    }
  }
  // Projector for quality metrics
  projector QualityMetricsProjector is {
    updates repository ApparelContext.CutOrderRepository
    record QualityMetricsStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of period.
        }
      }
      totalInspected: Natural with {
        briefly "Inspected"
        described as {
          |Total garments inspected.
        }
      }
      totalPassed: Natural with {
        briefly "Passed"
        described as {
          |Total garments passed.
        }
      }
      totalFailed: Natural with {
        briefly "Failed"
        described as {
          |Total garments failed.
        }
      }
      firstPassYield: Decimal(5,2) with {
        briefly "FPY"
        described as {
          |First pass yield percent.
        }
      }
      defectsByType: DefectSummary+ with {
        briefly "Defects"
        described as {
          |Defects by type.
        }
      }
      topDefectOperations: String(1,200)+ with {
        briefly "Problem ops"
        described as {
          |Operations with most defects.
        }
      }
    } with {
      briefly "Quality metrics statistics"
      described as {
        |Quality inspection and defect metrics.
      }
    }
    record DefectSummary is  {
      defectType: DefectType with {
        briefly "Type"
        described as {
          |Defect type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Defect count.
        }
      }
      percentage: Decimal(5,2) with {
        briefly "Percentage"
        described as {
          |Percentage of total defects.
        }
      }
    } with {
      briefly "Defect summary"
      described as {
        |Summary of defects by type.
      }
    }
    handler QualityMetricsHandler is {
      on event CutOrder.QualityCheckRecorded is {
        tell event CutOrder.QualityCheckRecorded to repository ApparelContext.CutOrderRepository
        prompt "Update quality metrics and defect tracking"
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
        prompt "Update defect counts from sewing"
      }
    } with {
      briefly "Maintains quality metrics"
      described as {
        |Projects quality events into analytics.
      }
    }
  } with {
    briefly "Quality metrics projections"
    described as {
      |Maintains quality and defect tracking data.
    }
  }
  // ---- Event publication for CutOrder ----
  type CutOrderEvent is one of {
    ApparelContext.CutOrder.CutOrderCreated,
    ApparelContext.CutOrder.MarkerGenerated,
    ApparelContext.CutOrder.FabricCut,
    ApparelContext.CutOrder.BundlesCreated,
    ApparelContext.CutOrder.BundleAssigned,
    ApparelContext.CutOrder.SewingCompleted,
    ApparelContext.CutOrder.TrimmingCompleted,
    ApparelContext.CutOrder.QualityCheckRecorded,
    ApparelContext.CutOrder.GarmentsPacked,
    ApparelContext.CutOrder.CutOrderCancelled
  } with {
    briefly "CutOrder event alternation"
    described as {
      |Union of all CutOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  source CutOrderEventSource is {
    outlet CutOrderEvents is type CutOrderEvent
    handler CutOrderSourceHandler is {
      on event CutOrder.CutOrderCreated is {
        send event CutOrder.CutOrderCreated to outlet CutOrderEvents
      }
      on event CutOrder.MarkerGenerated is {
        send event CutOrder.MarkerGenerated to outlet CutOrderEvents
      }
      on event CutOrder.FabricCut is {
        send event CutOrder.FabricCut to outlet CutOrderEvents
      }
      on event CutOrder.BundlesCreated is {
        send event CutOrder.BundlesCreated to outlet CutOrderEvents
      }
      on event CutOrder.BundleAssigned is {
        send event CutOrder.BundleAssigned to outlet CutOrderEvents
      }
      on event CutOrder.SewingCompleted is {
        send event CutOrder.SewingCompleted to outlet CutOrderEvents
      }
      on event CutOrder.TrimmingCompleted is {
        send event CutOrder.TrimmingCompleted to outlet CutOrderEvents
      }
      on event CutOrder.QualityCheckRecorded is {
        send event CutOrder.QualityCheckRecorded to outlet CutOrderEvents
      }
      on event CutOrder.GarmentsPacked is {
        send event CutOrder.GarmentsPacked to outlet CutOrderEvents
      }
      on event CutOrder.CutOrderCancelled is {
        send event CutOrder.CutOrderCancelled to outlet CutOrderEvents
      }
      on other is {
        error "Unexpected message for source CutOrderEventSource"
      }
    } with {
      briefly "CutOrder source handler"
      described as {
        |Publishes CutOrder events onto the outlet.
      }
    }
  } with {
    briefly "CutOrder event source"
    described as {
      |Publishes CutOrder entity events into the streaming topology.
    }
  }
  sink CutOrderEventSink is {
    inlet CutOrderInlet is type CutOrderEvent
    handler CutOrderSinkHandler is {
      on event CutOrder.CutOrderCreated is {
        tell event CutOrder.CutOrderCreated to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.MarkerGenerated is {
        tell event CutOrder.MarkerGenerated to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.FabricCut is {
        tell event CutOrder.FabricCut to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.BundlesCreated is {
        tell event CutOrder.BundlesCreated to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.BundleAssigned is {
        tell event CutOrder.BundleAssigned to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.SewingCompleted is {
        tell event CutOrder.SewingCompleted to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.TrimmingCompleted is {
        tell event CutOrder.TrimmingCompleted to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.QualityCheckRecorded is {
        tell event CutOrder.QualityCheckRecorded to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.GarmentsPacked is {
        tell event CutOrder.GarmentsPacked to repository ApparelContext.CutOrderRepository
      }
      on event CutOrder.CutOrderCancelled is {
        tell event CutOrder.CutOrderCancelled to repository ApparelContext.CutOrderRepository
      }
      on other is {
        error "Unexpected message for sink CutOrderEventSink"
      }
    } with {
      briefly "CutOrder sink handler"
      described as {
        |Persists CutOrder events via the repository.
      }
    }
  } with {
    briefly "CutOrder event sink"
    described as {
      |Receives CutOrder events for persistence.
    }
  }
  connector CutOrderEventFlow is {
    from outlet ApparelContext.CutOrderEventSource.CutOrderEvents to
      inlet ApparelContext.CutOrderEventSink.CutOrderInlet
  } with {
    briefly "CutOrder event flow"
    described as {
      |Connects the CutOrder source to its sink.
    }
  }
} with {
  briefly "Bounded context for apparel manufacturing"
  described as {
    | The ApparelContext is the bounded context for
    | cut-sew-trim apparel production and tracking.
  }
}
