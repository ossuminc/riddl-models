      on cutOrderCancelled: event CutOrder.CutOrderCancelled is {
        tell command ApparelContext.CutOrderRepository.PersistCutOrderCancelled(cutOrderId = cutOrderCancelled.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply CutOrderCancelled to the SAMEfficiencyProjector projection"
      }
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        tell command ApparelContext.CutOrderRepository.PersistCutOrderCreated(cutOrderId = cutOrderCreated.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply CutOrderCreated to the SAMEfficiencyProjector projection"
      }
      on fabricCut: event CutOrder.FabricCut is {
        tell command ApparelContext.CutOrderRepository.PersistFabricCut(cutOrderId = fabricCut.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply FabricCut to the SAMEfficiencyProjector projection"
      }
      on garmentsPacked: event CutOrder.GarmentsPacked is {
        tell command ApparelContext.CutOrderRepository.PersistGarmentsPacked(cutOrderId = garmentsPacked.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply GarmentsPacked to the SAMEfficiencyProjector projection"
      }
      on markerGenerated: event CutOrder.MarkerGenerated is {
        tell command ApparelContext.CutOrderRepository.PersistMarkerGenerated(cutOrderId = markerGenerated.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply MarkerGenerated to the SAMEfficiencyProjector projection"
      }
      on qualityCheckRecorded: event CutOrder.QualityCheckRecorded is {
        tell command ApparelContext.CutOrderRepository.PersistQualityCheckRecorded(cutOrderId = qualityCheckRecorded.cutOrderId) to repository ApparelContext.CutOrderRepository
        do "apply QualityCheckRecorded to the SAMEfficiencyProjector projection"
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
