// Apparel Manufacturing - Apparel Context
context ApparelContext is {
  adaptor FromFabricInventory from context FabricInventory is { 
    handler FromFabricInventoryHandler is {
      on result FabricInventory.AvailableFabricRolls is {
        do "the model receives available fabric rolls"
      }
      on event FabricInventory.FabricConsumed is {
        do "the model receives fabric consumed"
      }
      on event FabricInventory.FabricReserved is {
        do "the model receives fabric reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromFabricInventory"
      }
    } with {
      briefly "from fabric inventory"
      described as {
        |Carries messages from the external FabricInventory.
      }
    }
  } with {
    briefly "FabricInventory integration"
    described as {
      |The model's side of the FabricInventory conversation.
    }
  }
  adaptor ToFabricInventory to context FabricInventory is { 
    handler ToFabricInventoryHandler is {
      on command FabricInventory.ConsumeFabric is {
        do "the model sends consume fabric"
      }
      on query FabricInventory.GetAvailableFabric is {
        do "the model sends get available fabric"
      }
      on query FabricInventory.GetFabricRoll is {
        do "the model sends get fabric roll"
      }
      on command FabricInventory.ReserveFabric is {
        do "the model sends reserve fabric"
      }
      on other is {
        error "Unexpected message for adaptor ToFabricInventory"
      }
    } with {
      briefly "to fabric inventory"
      described as {
        |Carries messages to the external FabricInventory.
      }
    }
  } with {
    briefly "FabricInventory integration"
    described as {
      |The model's side of the FabricInventory conversation.
    }
  }
  adaptor FromMachineMaintenance from context MachineMaintenance is { 
    handler FromMachineMaintenanceHandler is {
      on event MachineMaintenance.MachineBreakdownReported is {
        do "the model receives machine breakdown reported"
      }
      on result MachineMaintenance.MachineStatusResult is {
        do "the model receives machine status result"
      }
      on other is {
        error "Unexpected message for adaptor FromMachineMaintenance"
      }
    } with {
      briefly "from machine maintenance"
      described as {
        |Carries messages from the external MachineMaintenance.
      }
    }
  } with {
    briefly "MachineMaintenance integration"
    described as {
      |The model's side of the MachineMaintenance conversation.
    }
  }
  adaptor ToMachineMaintenance to context MachineMaintenance is { 
    handler ToMachineMaintenanceHandler is {
      on query MachineMaintenance.GetMachineStatus is {
        do "the model sends get machine status"
      }
      on command MachineMaintenance.ReportMachineBreakdown is {
        do "the model sends report machine breakdown"
      }
      on other is {
        error "Unexpected message for adaptor ToMachineMaintenance"
      }
    } with {
      briefly "to machine maintenance"
      described as {
        |Carries messages to the external MachineMaintenance.
      }
    }
  } with {
    briefly "MachineMaintenance integration"
    described as {
      |The model's side of the MachineMaintenance conversation.
    }
  }
  adaptor FromOrderManagement from context OrderManagement is { 
    handler FromOrderManagementHandler is {
      on event OrderManagement.DeliveryShortageReported is {
        do "the model receives delivery shortage reported"
      }
      on event OrderManagement.ProductionStatusUpdated is {
        do "the model receives production status updated"
      }
      on event OrderManagement.ReadyToShipNotified is {
        do "the model receives ready to ship notified"
      }
      on result OrderManagement.SalesOrderInfo is {
        do "the model receives sales order info"
      }
      on other is {
        error "Unexpected message for adaptor FromOrderManagement"
      }
    } with {
      briefly "from order management"
      described as {
        |Carries messages from the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor ToOrderManagement to context OrderManagement is { 
    handler ToOrderManagementHandler is {
      on query OrderManagement.GetSalesOrder is {
        do "the model sends get sales order"
      }
      on command OrderManagement.NotifyReadyToShip is {
        do "the model sends notify ready to ship"
      }
      on command OrderManagement.ReportDeliveryShortage is {
        do "the model sends report delivery shortage"
      }
      on command OrderManagement.UpdateProductionStatus is {
        do "the model sends update production status"
      }
      on other is {
        error "Unexpected message for adaptor ToOrderManagement"
      }
    } with {
      briefly "to order management"
      described as {
        |Carries messages to the external OrderManagement.
      }
    }
  } with {
    briefly "OrderManagement integration"
    described as {
      |The model's side of the OrderManagement conversation.
    }
  }
  adaptor FromStyleMaster from context StyleMaster is { 
    handler FromStyleMasterHandler is {
      on result StyleMaster.OperationSequenceResult is {
        do "the model receives operation sequence result"
      }
      on result StyleMaster.StyleSpecResult is {
        do "the model receives style spec result"
      }
      on result StyleMaster.TrimRequirementsResult is {
        do "the model receives trim requirements result"
      }
      on other is {
        error "Unexpected message for adaptor FromStyleMaster"
      }
    } with {
      briefly "from style master"
      described as {
        |Carries messages from the external StyleMaster.
      }
    }
  } with {
    briefly "StyleMaster integration"
    described as {
      |The model's side of the StyleMaster conversation.
    }
  }
  adaptor ToStyleMaster to context StyleMaster is { 
    handler ToStyleMasterHandler is {
      on query StyleMaster.GetOperationSequence is {
        do "the model sends get operation sequence"
      }
      on query StyleMaster.GetStyleSpec is {
        do "the model sends get style spec"
      }
      on query StyleMaster.GetTrimRequirements is {
        do "the model sends get trim requirements"
      }
      on other is {
        error "Unexpected message for adaptor ToStyleMaster"
      }
    } with {
      briefly "to style master"
      described as {
        |Carries messages to the external StyleMaster.
      }
    }
  } with {
    briefly "StyleMaster integration"
    described as {
      |The model's side of the StyleMaster conversation.
    }
  }
  adaptor FromTrimInventory from context TrimInventory is { 
    handler FromTrimInventoryHandler is {
      on result TrimInventory.TrimAvailabilityResult is {
        do "the model receives trim availability result"
      }
      on event TrimInventory.TrimConsumed is {
        do "the model receives trim consumed"
      }
      on result TrimInventory.TrimItemInfo is {
        do "the model receives trim item info"
      }
      on event TrimInventory.TrimReserved is {
        do "the model receives trim reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromTrimInventory"
      }
    } with {
      briefly "from trim inventory"
      described as {
        |Carries messages from the external TrimInventory.
      }
    }
  } with {
    briefly "TrimInventory integration"
    described as {
      |The model's side of the TrimInventory conversation.
    }
  }
  adaptor ToTrimInventory to context TrimInventory is { 
    handler ToTrimInventoryHandler is {
      on command TrimInventory.ConsumeTrim is {
        do "the model sends consume trim"
      }
      on query TrimInventory.GetTrimAvailability is {
        do "the model sends get trim availability"
      }
      on query TrimInventory.GetTrimItem is {
        do "the model sends get trim item"
      }
      on command TrimInventory.ReserveTrim is {
        do "the model sends reserve trim"
      }
      on other is {
        error "Unexpected message for adaptor ToTrimInventory"
      }
    } with {
      briefly "to trim inventory"
      described as {
        |Carries messages to the external TrimInventory.
      }
    }
  } with {
    briefly "TrimInventory integration"
    described as {
      |The model's side of the TrimInventory conversation.
    }
  }
  include "types.riddl"
  include "CutOrder.riddl"
  // Repository for cut order persistence
  repository CutOrderRepository as merge is {
    inlet CutOrderRepositoryFromCutOrder is type CutOrderEvent    inlet CutOrderRepositoryFromSAMEfficiencyProjector is type CutOrderEvent    inlet CutOrderRepositoryFromBundleThroughputProjector is type CutOrderEvent    inlet CutOrderRepositoryFromOperatorPerformanceProjector is type CutOrderEvent    inlet CutOrderRepositoryFromQualityMetricsProjector is type CutOrderEvent    outlet CutOrderRepositoryResponses is type CutOrder.CutOrderResult
    record StoredCutOrder is  {
      cutOrderId: CutOrderId with {
        briefly "cutOrderId"
        described as {
          |The cutOrderId column of the stored cutOrder row.
        }
      }
      styleSpec: GarmentSpec with {
        briefly "styleSpec"
        described as {
          |The styleSpec column of the stored cutOrder row.
        }
      }
    } with {
      briefly "Stored cutOrder row"
      described as {
        |The persistence shape of cutOrder data as this repository stores it.
      }
    }
    schema CutOrderData is relational
      of cutOrders as type StoredCutOrder
        index on field StoredCutOrder.cutOrderId
        index on field StoredCutOrder.styleSpec.styleId
        index on field StoredCutOrder.status
 with {
      briefly "Cut order data schema"
      described as {
        |The relational schema holding cut order data for the CutOrderRepository.
      }
    }
    handler CutOrderPersistence is {
      on query GetSAMEfficiencyStats is {
        do "read the sam efficiency stats projection"
        reply result SAMEfficiencyStatsView
      }
      on query GetBundleThroughputStats is {
        do "read the bundle throughput stats projection"
        reply result BundleThroughputStatsView
      }
      on query GetOperatorPerformanceStats is {
        do "read the operator performance stats projection"
        reply result OperatorPerformanceStatsView
      }
      on query GetQualityMetricsStats is {
        do "read the quality metrics stats projection"
        reply result QualityMetricsStatsView
      }
      on command CutOrder.CreateCutOrder is {
        tell event CutOrder.CutOrderCreated to entity ApparelContext.CutOrder
        do "Store new cut order"
      }
      on command CutOrder.GenerateMarker is {
        do "Update marker data"
      }
      on command CutOrder.CutFabric is {
        do "Update cutting completion"
      }
      on command CutOrder.CreateBundles is {
        tell event CutOrder.BundlesCreated to entity ApparelContext.CutOrder
        do "Store bundle records"
      }
      on command CutOrder.AssignBundle is {
        tell event CutOrder.BundleAssigned to entity ApparelContext.CutOrder
        do "Update bundle assignment"
      }
      on command CutOrder.CompleteSewing is {
        tell event CutOrder.SewingCompleted to entity ApparelContext.CutOrder
        do "Update sewing completion"
      }
      on command CutOrder.CompleteTrimming is {
        tell event CutOrder.TrimmingCompleted to entity ApparelContext.CutOrder
        do "Update trimming completion"
      }
      on command CutOrder.RecordQualityCheck is {
        tell event CutOrder.QualityCheckRecorded to entity ApparelContext.CutOrder
        do "Store quality inspection"
      }
      on command CutOrder.PackGarments is {
        do "Store packing record"
      }
      on command CutOrder.CancelCutOrder is {
        tell event CutOrder.CutOrderCancelled to entity ApparelContext.CutOrder
        do "Update to cancelled"
      }
    } with {
      briefly "Persists cut order events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Cut order data persistence"
    described as {
      | The CutOrderRepository provides persistent storage for
      | cut orders, bundles, and production tracking data.
    }
  }
  // Projector for SAM efficiency tracking
  query GetSAMEfficiencyStats is  {
    sAMEfficiencyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which sam efficiency stats to retrieve.
      }
    }
  } with {
    briefly "Get sam efficiency stats"
    described as {
      |Retrieves the sam efficiency stats projection.
    }
  }
  result SAMEfficiencyStatsView is  {
    sAMEfficiencyStats: SAMEfficiencyProjector.SAMEfficiencyStats with {
      briefly "Sam efficiency stats"
      described as {
        |The sam efficiency stats being returned.
      }
    }
  } with {
    briefly "Sam efficiency stats view"
    described as {
      |Read model view carrying the sam efficiency stats projection.
    }
  }
  projector SAMEfficiencyProjector as flow is {
    updates repository ApparelContext.CutOrderRepository
    inlet SAMEfficiencyProjectorFromCutOrder is type CutOrderEvent    outlet SAMEfficiencyProjectorOut is type CutOrderEvent
    record SAMEfficiencyStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of measurement period.
        }
      }
      totalEarnedMinutes: Decimal(12,2) with {
        briefly "Earned"
        described as {
          |Total earned SAM.
        }
      }
      totalAttendedMinutes: Decimal(12,2) with {
        briefly "Attended"
        described as {
          |Total attended minutes.
        }
      }
      overallEfficiency: Decimal(5,2) with {
        briefly "Efficiency"
        described as {
          |Overall efficiency percent.
        }
      }
      operatorCount: Natural with {
        briefly "Operators"
        described as {
          |Number of operators.
        }
      }
      topPerformers: ProductionEfficiency+ with {
        briefly "Top performers"
        described as {
          |Top performing operators.
        }
      }
    } with {
      briefly "SAM efficiency statistics"
      described as {
        |Standard Allowed Minutes efficiency metrics.
      }
    }
    handler SAMEfficiencyHandler is {
      on sewingCompleted: event CutOrder.SewingCompleted is {
        tell sewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update operator earned minutes and efficiency"
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        tell trimmingCompleted to repository ApparelContext.CutOrderRepository
        do "Update trim operation efficiency"
      }
    } with {
      briefly "Maintains SAM efficiency metrics"
      described as {
        |Projects sewing events into efficiency analytics.
      }
    }
  } with {
    briefly "SAM efficiency projections"
    described as {
      |Maintains operator efficiency based on SAM standards.
    }
  }
  // Projector for bundle throughput tracking
  query GetBundleThroughputStats is  {
    bundleThroughputStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which bundle throughput stats to retrieve.
      }
    }
  } with {
    briefly "Get bundle throughput stats"
    described as {
      |Retrieves the bundle throughput stats projection.
    }
  }
  result BundleThroughputStatsView is  {
    bundleThroughputStats: BundleThroughputProjector.BundleThroughputStats with {
      briefly "Bundle throughput stats"
      described as {
        |The bundle throughput stats being returned.
      }
    }
  } with {
    briefly "Bundle throughput stats view"
    described as {
      |Read model view carrying the bundle throughput stats projection.
    }
  }
  projector BundleThroughputProjector as flow is {
    updates repository ApparelContext.CutOrderRepository
    inlet BundleThroughputProjectorFromCutOrder is type CutOrderEvent    outlet BundleThroughputProjectorOut is type CutOrderEvent
    record BundleThroughputStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of period.
        }
      }
      bundlesCreated: Natural with {
        briefly "Created"
        described as {
          |Bundles created.
        }
      }
      bundlesAssigned: Natural with {
        briefly "Assigned"
        described as {
          |Bundles assigned.
        }
      }
      bundlesCompleted: Natural with {
        briefly "Completed"
        described as {
          |Bundles completed.
        }
      }
      bundlesPacked: Natural with {
        briefly "Packed"
        described as {
          |Bundles packed.
        }
      }
      averageCycleTime: Decimal(8,2) with {
        briefly "Cycle time"
        described as {
          |Average bundle cycle time (hours).
        }
      }
      wipBundles: Natural with {
        briefly "WIP"
        described as {
          |Work-in-progress bundles.
        }
      }
    } with {
      briefly "Bundle throughput statistics"
      described as {
        |Bundle flow and cycle time metrics.
      }
    }
    handler BundleThroughputHandler is {
      on bundlesCreatedEvent: event CutOrder.BundlesCreated is {
        tell bundlesCreatedEvent to repository ApparelContext.CutOrderRepository
        do "Increment bundles created counter"
      }
      on bundleAssigned: event CutOrder.BundleAssigned is {
        tell bundleAssigned to repository ApparelContext.CutOrderRepository
        do "Increment bundles assigned counter"
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        tell sewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update bundle completion metrics"
      }
      on garmentsPacked: event CutOrder.GarmentsPacked is {
        tell garmentsPacked to repository ApparelContext.CutOrderRepository
        do "Update packed bundles and cycle time"
      }
    } with {
      briefly "Maintains bundle throughput metrics"
      described as {
        |Projects bundle events into throughput analytics.
      }
    }
  } with {
    briefly "Bundle throughput projections"
    described as {
      |Maintains bundle flow and WIP tracking data.
    }
  }
  // Projector for operator performance tracking
  query GetOperatorPerformanceStats is  {
    operatorPerformanceStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which operator performance stats to retrieve.
      }
    }
  } with {
    briefly "Get operator performance stats"
    described as {
      |Retrieves the operator performance stats projection.
    }
  }
  result OperatorPerformanceStatsView is  {
    operatorPerformanceStats: OperatorPerformanceProjector.OperatorPerformanceStats with {
      briefly "Operator performance stats"
      described as {
        |The operator performance stats being returned.
      }
    }
  } with {
    briefly "Operator performance stats view"
    described as {
      |Read model view carrying the operator performance stats projection.
    }
  }
  projector OperatorPerformanceProjector as flow is {
    updates repository ApparelContext.CutOrderRepository
    inlet OperatorPerformanceProjectorFromCutOrder is type CutOrderEvent    outlet OperatorPerformanceProjectorOut is type CutOrderEvent
    record OperatorPerformanceStats is  {
      operatorId: OperatorId with {
        briefly "Operator"
        described as {
          |Operator identifier.
        }
      }
      operatorName: String(1,200) with {
        briefly "Name"
        described as {
          |Operator name.
        }
      }
      bundlesCompleted: Natural with {
        briefly "Bundles"
        described as {
          |Bundles completed.
        }
      }
      piecesProduced: Natural with {
        briefly "Pieces"
        described as {
          |Pieces produced.
        }
      }
      defectsProduced: Natural with {
        briefly "Defects"
        described as {
          |Defects produced.
        }
      }
      qualityRate: Decimal(5,2) with {
        briefly "Quality rate"
        described as {
          |Quality rate percent.
        }
      }
      earnedMinutes: Decimal(10,2) with {
        briefly "Earned"
        described as {
          |Earned SAM.
        }
      }
      attendedMinutes: Decimal(10,2) with {
        briefly "Attended"
        described as {
          |Attended minutes.
        }
      }
      efficiency: Decimal(5,2) with {
        briefly "Efficiency"
        described as {
          |Efficiency percent.
        }
      }
      avgBundleTime: Decimal(8,2) with {
        briefly "Avg bundle time"
        described as {
          |Average minutes per bundle.
        }
      }
    } with {
      briefly "Operator performance statistics"
      described as {
        |Individual operator performance metrics.
      }
    }
    handler OperatorPerformanceHandler is {
      on bundleAssigned: event CutOrder.BundleAssigned is {
        tell bundleAssigned to repository ApparelContext.CutOrderRepository
        do "Track bundle assignment to operator"
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        tell sewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update operator production metrics"
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        tell trimmingCompleted to repository ApparelContext.CutOrderRepository
        do "Update operator trim metrics"
      }
      on qualityCheckRecorded: event CutOrder.QualityCheckRecorded is {
        tell qualityCheckRecorded to repository ApparelContext.CutOrderRepository
        do "Update operator quality metrics"
      }
    } with {
      briefly "Maintains operator performance metrics"
      described as {
        |Projects production events into operator analytics.
      }
    }
  } with {
    briefly "Operator performance projections"
    described as {
      |Maintains individual operator performance data.
    }
  }
  // Projector for quality metrics
  query GetQualityMetricsStats is  {
    qualityMetricsStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which quality metrics stats to retrieve.
      }
    }
  } with {
    briefly "Get quality metrics stats"
    described as {
      |Retrieves the quality metrics stats projection.
    }
  }
  result QualityMetricsStatsView is  {
    qualityMetricsStats: QualityMetricsProjector.QualityMetricsStats with {
      briefly "Quality metrics stats"
      described as {
        |The quality metrics stats being returned.
      }
    }
  } with {
    briefly "Quality metrics stats view"
    described as {
      |Read model view carrying the quality metrics stats projection.
    }
  }
  projector QualityMetricsProjector as flow is {
    updates repository ApparelContext.CutOrderRepository
    inlet QualityMetricsProjectorFromCutOrder is type CutOrderEvent    outlet QualityMetricsProjectorOut is type CutOrderEvent
    record QualityMetricsStats is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of period.
        }
      }
      totalInspected: Natural with {
        briefly "Inspected"
        described as {
          |Total garments inspected.
        }
      }
      totalPassed: Natural with {
        briefly "Passed"
        described as {
          |Total garments passed.
        }
      }
      totalFailed: Natural with {
        briefly "Failed"
        described as {
          |Total garments failed.
        }
      }
      firstPassYield: Decimal(5,2) with {
        briefly "FPY"
        described as {
          |First pass yield percent.
        }
      }
      defectsByType: DefectSummary+ with {
        briefly "Defects"
        described as {
          |Defects by type.
        }
      }
      topDefectOperations: String(1,200)+ with {
        briefly "Problem ops"
        described as {
          |Operations with most defects.
        }
      }
    } with {
      briefly "Quality metrics statistics"
      described as {
        |Quality inspection and defect metrics.
      }
    }
    record DefectSummary is  {
      defectType: DefectType with {
        briefly "Type"
        described as {
          |Defect type.
        }
      }
      count: Natural with {
        briefly "Count"
        described as {
          |Defect count.
        }
      }
      percentage: Decimal(5,2) with {
        briefly "Percentage"
        described as {
          |Percentage of total defects.
        }
      }
    } with {
      briefly "Defect summary"
      described as {
        |Summary of defects by type.
      }
    }
    handler QualityMetricsHandler is {
      on qualityCheckRecorded: event CutOrder.QualityCheckRecorded is {
        tell qualityCheckRecorded to repository ApparelContext.CutOrderRepository
        do "Update quality metrics and defect tracking"
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        tell sewingCompleted to repository ApparelContext.CutOrderRepository
        do "Update defect counts from sewing"
      }
    } with {
      briefly "Maintains quality metrics"
      described as {
        |Projects quality events into analytics.
      }
    }
  } with {
    briefly "Quality metrics projections"
    described as {
      |Maintains quality and defect tracking data.
    }
  }
  // ---- Event publication for CutOrder ----
  type CutOrderEvent is one of {
    ApparelContext.CutOrder.CutOrderCreated or ApparelContext.CutOrder.MarkerGenerated or ApparelContext.CutOrder.FabricCut or ApparelContext.CutOrder.BundlesCreated or ApparelContext.CutOrder.BundleAssigned or ApparelContext.CutOrder.SewingCompleted or ApparelContext.CutOrder.TrimmingCompleted or ApparelContext.CutOrder.QualityCheckRecorded or ApparelContext.CutOrder.GarmentsPacked or ApparelContext.CutOrder.CutOrderCancelled
  } with {
    briefly "CutOrder event alternation"
    described as {
      |Union of all CutOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CutOrderEventSource as source is {
    outlet CutOrderEvents is type CutOrderEvent
    handler CutOrderSourceHandler is {
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        send cutOrderCreated to outlet CutOrderEvents
      }
      on markerGenerated: event CutOrder.MarkerGenerated is {
        send markerGenerated to outlet CutOrderEvents
      }
      on fabricCut: event CutOrder.FabricCut is {
        send fabricCut to outlet CutOrderEvents
      }
      on bundlesCreatedEvent: event CutOrder.BundlesCreated is {
        send bundlesCreatedEvent to outlet CutOrderEvents
      }
      on bundleAssigned: event CutOrder.BundleAssigned is {
        send bundleAssigned to outlet CutOrderEvents
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        send sewingCompleted to outlet CutOrderEvents
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        send trimmingCompleted to outlet CutOrderEvents
      }
      on qualityCheckRecorded: event CutOrder.QualityCheckRecorded is {
        send qualityCheckRecorded to outlet CutOrderEvents
      }
      on garmentsPacked: event CutOrder.GarmentsPacked is {
        send garmentsPacked to outlet CutOrderEvents
      }
      on cutOrderCancelled: event CutOrder.CutOrderCancelled is {
        send cutOrderCancelled to outlet CutOrderEvents
      }
      on other is {
        error "Unexpected message for source CutOrderEventSource"
      }
    } with {
      briefly "CutOrder source handler"
      described as {
        |Publishes CutOrder events onto the outlet.
      }
    }
  } with {
    briefly "CutOrder event source"
    described as {
      |Publishes CutOrder entity events into the streaming topology.
    }
  }
  processor CutOrderEventSink as sink is {
    inlet CutOrderInlet is type CutOrderEvent    handler CutOrderSinkHandler is {
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        tell cutOrderCreated to repository ApparelContext.CutOrderRepository
      }
      on markerGenerated: event CutOrder.MarkerGenerated is {
        tell markerGenerated to repository ApparelContext.CutOrderRepository
      }
      on fabricCut: event CutOrder.FabricCut is {
        tell fabricCut to repository ApparelContext.CutOrderRepository
      }
      on bundlesCreatedEvent: event CutOrder.BundlesCreated is {
        tell bundlesCreatedEvent to repository ApparelContext.CutOrderRepository
      }
      on bundleAssigned: event CutOrder.BundleAssigned is {
        tell bundleAssigned to repository ApparelContext.CutOrderRepository
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        tell sewingCompleted to repository ApparelContext.CutOrderRepository
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        tell trimmingCompleted to repository ApparelContext.CutOrderRepository
      }
      on qualityCheckRecorded: event CutOrder.QualityCheckRecorded is {
        tell qualityCheckRecorded to repository ApparelContext.CutOrderRepository
      }
      on garmentsPacked: event CutOrder.GarmentsPacked is {
        tell garmentsPacked to repository ApparelContext.CutOrderRepository
      }
      on cutOrderCancelled: event CutOrder.CutOrderCancelled is {
        tell cutOrderCancelled to repository ApparelContext.CutOrderRepository
      }
      on other is {
        error "Unexpected message for sink CutOrderEventSink"
      }
    } with {
      briefly "CutOrder sink handler"
      described as {
        |Persists CutOrder events via the repository.
      }
    }
  } with {
    briefly "CutOrder event sink"
    described as {
      |Receives CutOrder events for persistence.
    }
  }
  connector CutOrderEventFlow is from outlet ApparelContext.CutOrderEventSource.CutOrderEvents to inlet ApparelContext.CutOrderEventSink.CutOrderInlet with {
    briefly "CutOrder event flow"
    described as {
      |Connects the CutOrder source to its sink.
    }
  }
  processor CutOrderEventSplit as split is {
    inlet CutOrderEventSplitIn is type CutOrderEvent    outlet CutOrderEventSplitToCutOrderRepository is type CutOrderEvent
    outlet CutOrderEventSplitToSAMEfficiencyProjector is type CutOrderEvent
    outlet CutOrderEventSplitToBundleThroughputProjector is type CutOrderEvent
    outlet CutOrderEventSplitToOperatorPerformanceProjector is type CutOrderEvent
    outlet CutOrderEventSplitToQualityMetricsProjector is type CutOrderEvent
    handler CutOrderEventSplitHandler is {
      on cutOrderCreated: event CutOrder.CutOrderCreated is {
        send cutOrderCreated to outlet CutOrderEventSplitToCutOrderRepository
        send cutOrderCreated to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send cutOrderCreated to outlet CutOrderEventSplitToBundleThroughputProjector
        send cutOrderCreated to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send cutOrderCreated to outlet CutOrderEventSplitToQualityMetricsProjector
        tell cutOrderCreated to entity ApparelContext.CutOrder
      }
      on markerGenerated: event CutOrder.MarkerGenerated is {
        send markerGenerated to outlet CutOrderEventSplitToCutOrderRepository
        send markerGenerated to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send markerGenerated to outlet CutOrderEventSplitToBundleThroughputProjector
        send markerGenerated to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send markerGenerated to outlet CutOrderEventSplitToQualityMetricsProjector
        tell markerGenerated to entity ApparelContext.CutOrder
      }
      on fabricCut: event CutOrder.FabricCut is {
        send fabricCut to outlet CutOrderEventSplitToCutOrderRepository
        send fabricCut to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send fabricCut to outlet CutOrderEventSplitToBundleThroughputProjector
        send fabricCut to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send fabricCut to outlet CutOrderEventSplitToQualityMetricsProjector
        tell fabricCut to entity ApparelContext.CutOrder
      }
      on bundlesCreatedEvent: event CutOrder.BundlesCreated is {
        send bundlesCreatedEvent to outlet CutOrderEventSplitToCutOrderRepository
        send bundlesCreatedEvent to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send bundlesCreatedEvent to outlet CutOrderEventSplitToBundleThroughputProjector
        send bundlesCreatedEvent to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send bundlesCreatedEvent to outlet CutOrderEventSplitToQualityMetricsProjector
        tell bundlesCreatedEvent to entity ApparelContext.CutOrder
      }
      on bundleAssigned: event CutOrder.BundleAssigned is {
        send bundleAssigned to outlet CutOrderEventSplitToCutOrderRepository
        send bundleAssigned to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send bundleAssigned to outlet CutOrderEventSplitToBundleThroughputProjector
        send bundleAssigned to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send bundleAssigned to outlet CutOrderEventSplitToQualityMetricsProjector
        tell bundleAssigned to entity ApparelContext.CutOrder
      }
      on sewingCompleted: event CutOrder.SewingCompleted is {
        send sewingCompleted to outlet CutOrderEventSplitToCutOrderRepository
        send sewingCompleted to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send sewingCompleted to outlet CutOrderEventSplitToBundleThroughputProjector
        send sewingCompleted to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send sewingCompleted to outlet CutOrderEventSplitToQualityMetricsProjector
        tell sewingCompleted to entity ApparelContext.CutOrder
      }
      on trimmingCompleted: event CutOrder.TrimmingCompleted is {
        send trimmingCompleted to outlet CutOrderEventSplitToCutOrderRepository
        send trimmingCompleted to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send trimmingCompleted to outlet CutOrderEventSplitToBundleThroughputProjector
        send trimmingCompleted to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send trimmingCompleted to outlet CutOrderEventSplitToQualityMetricsProjector
        tell trimmingCompleted to entity ApparelContext.CutOrder
      }
      on qualityCheckRecorded: event CutOrder.QualityCheckRecorded is {
        send qualityCheckRecorded to outlet CutOrderEventSplitToCutOrderRepository
        send qualityCheckRecorded to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send qualityCheckRecorded to outlet CutOrderEventSplitToBundleThroughputProjector
        send qualityCheckRecorded to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send qualityCheckRecorded to outlet CutOrderEventSplitToQualityMetricsProjector
        tell qualityCheckRecorded to entity ApparelContext.CutOrder
      }
      on garmentsPacked: event CutOrder.GarmentsPacked is {
        send garmentsPacked to outlet CutOrderEventSplitToCutOrderRepository
        send garmentsPacked to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send garmentsPacked to outlet CutOrderEventSplitToBundleThroughputProjector
        send garmentsPacked to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send garmentsPacked to outlet CutOrderEventSplitToQualityMetricsProjector
        tell garmentsPacked to entity ApparelContext.CutOrder
      }
      on cutOrderCancelled: event CutOrder.CutOrderCancelled is {
        send cutOrderCancelled to outlet CutOrderEventSplitToCutOrderRepository
        send cutOrderCancelled to outlet CutOrderEventSplitToSAMEfficiencyProjector
        send cutOrderCancelled to outlet CutOrderEventSplitToBundleThroughputProjector
        send cutOrderCancelled to outlet CutOrderEventSplitToOperatorPerformanceProjector
        send cutOrderCancelled to outlet CutOrderEventSplitToQualityMetricsProjector
        tell cutOrderCancelled to entity ApparelContext.CutOrder
      }
      on other is {
        error "Unexpected message for processor CutOrderEventSplit"
      }
    } with {
      briefly "CutOrder event fan-out handler"
      described as {
        |Delivers each CutOrder event to all of its consumers.
      }
    }
  } with {
    briefly "CutOrder event fan-out"
    described as {
      |Fans CutOrder events out to the repository and projectors.
    }
  }
  connector 'CutOrderEvent Stream' is from outlet ApparelContext.CutOrder.CutOrderEvents2 to inlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitIn with {
    briefly "CutOrder events, fanned out to storage and read models"
  }
  connector 'CutOrderEvent Storage' is from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToCutOrderRepository to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromCutOrder with {
    briefly "CutOrder events on their way to storage"
  }
  connector 'SAMEfficiencyProjector Feed' is from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToSAMEfficiencyProjector to inlet ApparelContext.SAMEfficiencyProjector.SAMEfficiencyProjectorFromCutOrder with {
    briefly "CutOrder events feeding the SAMEfficiencyProjector projection"
  }
  connector 'BundleThroughputProjector Feed' is from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToBundleThroughputProjector to inlet ApparelContext.BundleThroughputProjector.BundleThroughputProjectorFromCutOrder with {
    briefly "CutOrder events feeding the BundleThroughputProjector projection"
  }
  connector 'OperatorPerformanceProjector Feed' is from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToOperatorPerformanceProjector to inlet ApparelContext.OperatorPerformanceProjector.OperatorPerformanceProjectorFromCutOrder with {
    briefly "CutOrder events feeding the OperatorPerformanceProjector projection"
  }
  connector 'QualityMetricsProjector Feed' is from outlet ApparelContext.CutOrderEventSplit.CutOrderEventSplitToQualityMetricsProjector to inlet ApparelContext.QualityMetricsProjector.QualityMetricsProjectorFromCutOrder with {
    briefly "CutOrder events feeding the QualityMetricsProjector projection"
  }
  connector 'SAMEfficiencyProjector Storage' is from outlet ApparelContext.SAMEfficiencyProjector.SAMEfficiencyProjectorOut to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromSAMEfficiencyProjector with {
    briefly "The SAMEfficiencyProjector projection on its way to storage"
  }
  connector 'BundleThroughputProjector Storage' is from outlet ApparelContext.BundleThroughputProjector.BundleThroughputProjectorOut to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromBundleThroughputProjector with {
    briefly "The BundleThroughputProjector projection on its way to storage"
  }
  connector 'OperatorPerformanceProjector Storage' is from outlet ApparelContext.OperatorPerformanceProjector.OperatorPerformanceProjectorOut to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromOperatorPerformanceProjector with {
    briefly "The OperatorPerformanceProjector projection on its way to storage"
  }
  connector 'QualityMetricsProjector Storage' is from outlet ApparelContext.QualityMetricsProjector.QualityMetricsProjectorOut to inlet ApparelContext.CutOrderRepository.CutOrderRepositoryFromQualityMetricsProjector with {
    briefly "The QualityMetricsProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for apparel manufacturing"
  described as {
    | The ApparelContext is the bounded context for
    | cut-sew-trim apparel production and tracking.
  }
}
