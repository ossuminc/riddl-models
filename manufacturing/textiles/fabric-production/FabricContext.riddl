// Fabric Production - Fabric Context
context FabricContext is {
  adaptor FromCustomerOrderService from context CustomerOrderService is { 
    handler FromCustomerOrderServiceHandler is {
      on event CustomerOrderService.CustomerNotified is {
        do "the model receives customer notified"
      }
      on result CustomerOrderService.FabricOrder is {
        do "the model receives fabric order"
      }
      on event CustomerOrderService.OrderStatusUpdated is {
        do "the model receives order status updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCustomerOrderService"
      }
    } with {
      briefly "from customer order service"
      described as {
        |Carries messages from the external CustomerOrderService.
      }
    }
  } with {
    briefly "CustomerOrderService integration"
    described as {
      |The model's side of the CustomerOrderService conversation.
    }
  }
  adaptor ToCustomerOrderService to context CustomerOrderService is { 
    handler ToCustomerOrderServiceHandler is {
      on query CustomerOrderService.GetFabricOrder is {
        do "the model sends get fabric order"
      }
      on command CustomerOrderService.NotifyOrderShipped is {
        do "the model sends notify order shipped"
      }
      on command CustomerOrderService.NotifyQualityIssue is {
        do "the model sends notify quality issue"
      }
      on command CustomerOrderService.UpdateOrderStatus is {
        do "the model sends update order status"
      }
      on other is {
        error "Unexpected message for adaptor ToCustomerOrderService"
      }
    } with {
      briefly "to customer order service"
      described as {
        |Carries messages to the external CustomerOrderService.
      }
    }
  } with {
    briefly "CustomerOrderService integration"
    described as {
      |The model's side of the CustomerOrderService conversation.
    }
  }
  adaptor FromDyeChemicalInventory from context DyeChemicalInventory is { 
    handler FromDyeChemicalInventoryHandler is {
      on result DyeChemicalInventory.ChemicalInfo is {
        do "the model receives chemical info"
      }
      on event DyeChemicalInventory.DyeChemicalsIssued is {
        do "the model receives dye chemicals issued"
      }
      on event DyeChemicalInventory.DyeChemicalsReserved is {
        do "the model receives dye chemicals reserved"
      }
      on result DyeChemicalInventory.DyeInfo is {
        do "the model receives dye info"
      }
      on other is {
        error "Unexpected message for adaptor FromDyeChemicalInventory"
      }
    } with {
      briefly "from dye chemical inventory"
      described as {
        |Carries messages from the external DyeChemicalInventory.
      }
    }
  } with {
    briefly "DyeChemicalInventory integration"
    described as {
      |The model's side of the DyeChemicalInventory conversation.
    }
  }
  adaptor ToDyeChemicalInventory to context DyeChemicalInventory is { 
    handler ToDyeChemicalInventoryHandler is {
      on query DyeChemicalInventory.GetChemicalInfo is {
        do "the model sends get chemical info"
      }
      on query DyeChemicalInventory.GetDyeInfo is {
        do "the model sends get dye info"
      }
      on command DyeChemicalInventory.IssueDyeChemicals is {
        do "the model sends issue dye chemicals"
      }
      on command DyeChemicalInventory.ReserveDyeChemicals is {
        do "the model sends reserve dye chemicals"
      }
      on other is {
        error "Unexpected message for adaptor ToDyeChemicalInventory"
      }
    } with {
      briefly "to dye chemical inventory"
      described as {
        |Carries messages to the external DyeChemicalInventory.
      }
    }
  } with {
    briefly "DyeChemicalInventory integration"
    described as {
      |The model's side of the DyeChemicalInventory conversation.
    }
  }
  adaptor FromYarnInventory from context YarnInventory is { 
    handler FromYarnInventoryHandler is {
      on event YarnInventory.YarnIssued is {
        do "the model receives yarn issued"
      }
      on result YarnInventory.YarnLotInfo is {
        do "the model receives yarn lot info"
      }
      on event YarnInventory.YarnReserved is {
        do "the model receives yarn reserved"
      }
      on event YarnInventory.YarnShortage is {
        do "the model receives yarn shortage"
      }
      on other is {
        error "Unexpected message for adaptor FromYarnInventory"
      }
    } with {
      briefly "from yarn inventory"
      described as {
        |Carries messages from the external YarnInventory.
      }
    }
  } with {
    briefly "YarnInventory integration"
    described as {
      |The model's side of the YarnInventory conversation.
    }
  }
  adaptor ToYarnInventory to context YarnInventory is { 
    handler ToYarnInventoryHandler is {
      on query YarnInventory.GetYarnLotInfo is {
        do "the model sends get yarn lot info"
      }
      on command YarnInventory.IssueYarn is {
        do "the model sends issue yarn"
      }
      on command YarnInventory.ReserveYarn is {
        do "the model sends reserve yarn"
      }
      on other is {
        error "Unexpected message for adaptor ToYarnInventory"
      }
    } with {
      briefly "to yarn inventory"
      described as {
        |Carries messages to the external YarnInventory.
      }
    }
  } with {
    briefly "YarnInventory integration"
    described as {
      |The model's side of the YarnInventory conversation.
    }
  }
  include "types.riddl"
  include "FabricLot.riddl"
  // Repository for fabric lot persistence
  repository FabricLotRepository as merge is {
    inlet FabricLotRepositoryFromFabricLot is type FabricLotEvent    inlet FabricLotRepositoryFromLoomEfficiencyAnalytics is type FabricLotEvent    inlet FabricLotRepositoryFromDyeLotConsistencyAnalytics is type FabricLotEvent    inlet FabricLotRepositoryFromGradingYieldAnalytics is type FabricLotEvent    outlet FabricLotRepositoryResponses is type FabricLot.FabricLotResult
    record StoredFabricLot is  {
      fabricLotId: FabricLotId with {
        briefly "fabricLotId"
        described as {
          |The fabricLotId column of the stored fabricLot row.
        }
      }
      styleNumber: String(1,50) with {
        briefly "styleNumber"
        described as {
          |The styleNumber column of the stored fabricLot row.
        }
      }
    } with {
      briefly "Stored fabricLot row"
      described as {
        |The persistence shape of fabricLot data as this repository stores it.
      }
    }
    schema FabricLotData is relational
      of fabricLots as type StoredFabricLot
        index on field StoredFabricLot.fabricLotId
        index on field StoredFabricLot.styleNumber
        index on field StoredFabricLot.status
 with {
      briefly "Fabric lot data schema"
      described as {
        |The relational schema holding fabric lot data for the FabricLotRepository.
      }
    }
    handler FabricLotPersistence is {
      on query GetLoomMetrics is {
        let loomMetricsView: type LoomMetricsView = prompt("read the loom metrics projection")
        reply loomMetricsView
      }
      on query GetDyeLotMetrics is {
        let dyeLotMetricsView: type DyeLotMetricsView = prompt("read the dye lot metrics projection")
        reply dyeLotMetricsView
      }
      on query GetGradingMetrics is {
        let gradingMetricsView: type GradingMetricsView = prompt("read the grading metrics projection")
        reply gradingMetricsView
      }
      on createFabricLot: command FabricLot.CreateFabricLot is {
        tell event FabricLot.FabricLotCreated(fabricLotId = createFabricLot.fabricLotId, styleNumber = createFabricLot.styleNumber, customerOrder = createFabricLot.customerOrder, weavingSpec = createFabricLot.weavingSpec, targetYards = createFabricLot.targetYards) to entity FabricContext.FabricLot
        do "Store new fabric lot"
      }
      on startWarping: command FabricLot.StartWarping is {
        tell event FabricLot.WarpingStarted(fabricLotId = startWarping.fabricLotId, beamId = startWarping.beamId, yarnLots = startWarping.yarnLots, operatorId = startWarping.operatorId) to entity FabricContext.FabricLot
        do "Update with warping info"
      }
      on startWeaving: command FabricLot.StartWeaving is {
        tell event FabricLot.WeavingStarted(fabricLotId = startWeaving.fabricLotId, loomId = startWeaving.loomId, operatorId = startWeaving.operatorId) to entity FabricContext.FabricLot
        do "Update with loom assignment"
      }
      on recordWeavingDefect: command FabricLot.RecordWeavingDefect is {
        tell event FabricLot.WeavingDefectRecorded(fabricLotId = recordWeavingDefect.fabricLotId, defect = recordWeavingDefect.defect) to entity FabricContext.FabricLot
        do "Store weaving defect"
      }
      on completeWeaving: command FabricLot.CompleteWeaving is {
        tell event FabricLot.WeavingCompleted(fabricLotId = completeWeaving.fabricLotId, actualYards = completeWeaving.actualYards, dimensions = completeWeaving.dimensions) to entity FabricContext.FabricLot
        do "Update weaving completion"
      }
      on startDyeing: command FabricLot.StartDyeing is {
        tell event FabricLot.DyeingStarted(fabricLotId = startDyeing.fabricLotId, dyeFormula = startDyeing.dyeFormula, technicianId = startDyeing.technicianId) to entity FabricContext.FabricLot
        do "Update to dyeing status"
      }
      on completeDyeing: command FabricLot.CompleteDyeing is {
        tell event FabricLot.DyeingCompleted(fabricLotId = completeDyeing.fabricLotId, colorMatchPassed = completeDyeing.colorMatchPassed, colorfastnessRating = completeDyeing.colorfastnessRating, technicianId = completeDyeing.technicianId) to entity FabricContext.FabricLot
        do "Update dyeing completion"
      }
      on command FabricLot.ApplyFinishing is {
        do "Update to finishing status"
      }
      on completeFinishing: command FabricLot.CompleteFinishing is {
        tell event FabricLot.FinishingCompleted(fabricLotId = completeFinishing.fabricLotId, finalDimensions = completeFinishing.finalDimensions, shrinkagePercent = completeFinishing.shrinkagePercent, operatorId = completeFinishing.operatorId) to entity FabricContext.FabricLot
        do "Update finishing completion"
      }
      on command FabricLot.GradeFabric is {
        do "Store fabric grade"
      }
      on shipFabric: command FabricLot.ShipFabric is {
        tell event FabricLot.FabricShipped(fabricLotId = shipFabric.fabricLotId, shippingInfo = shipFabric.shippingInfo) to entity FabricContext.FabricLot
        do "Update to shipped status"
      }
    } with {
      briefly "Persists fabric lot events"
      described as {
        |Handles command-driven persistence for fabric lots.
      }
    }
  } with {
    briefly "Fabric lot data persistence"
    described as {
      | The FabricLotRepository provides persistent storage for
      | fabric lots, production data, and quality records.
    }
  }
  // Projector for loom efficiency analytics
  query GetLoomMetrics is  {
    loomMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which loom metrics to retrieve.
      }
    }
  } with {
    briefly "Get loom metrics"
    described as {
      |Retrieves the loom metrics projection.
    }
  }
  result LoomMetricsView is  {
    loomMetrics: LoomEfficiencyAnalytics.LoomMetrics with {
      briefly "Loom metrics"
      described as {
        |The loom metrics being returned.
      }
    }
  } with {
    briefly "Loom metrics view"
    described as {
      |Read model view carrying the loom metrics projection.
    }
  }
  projector LoomEfficiencyAnalytics as flow is {
    updates repository FabricContext.FabricLotRepository
    inlet LoomEfficiencyAnalyticsFromFabricLot is type FabricLotEvent    outlet LoomEfficiencyAnalyticsOut is type FabricLotEvent
    record LoomMetrics is  {
      loomId: LoomId with {
        briefly "Loom"
        described as {
          |Loom identifier.
        }
      }
      totalRunHours: Decimal(10,2) with {
        briefly "Run hours"
        described as {
          |Total run hours.
        }
      }
      totalDowntimeHours: Decimal(10,2) with {
        briefly "Downtime"
        described as {
          |Total downtime hours.
        }
      }
      yardsProduced: Decimal(14,2) with {
        briefly "Yards"
        described as {
          |Total yards produced.
        }
      }
      defectsPerThousandYards: Decimal(8,4) with {
        briefly "DPKY"
        described as {
          |Defects per 1000 yards.
        }
      }
      efficiency: Decimal(5,4) with {
        briefly "Efficiency"
        described as {
          |Loom efficiency ratio.
        }
      }
      avgPicksPerMinute: Natural with {
        briefly "Avg PPM"
        described as {
          |Average picks per minute.
        }
      }
    } with {
      briefly "Loom metrics"
      described as {
        |Loom performance metrics.
      }
    }
    handler LoomEfficiencyHandler is {
      on weavingStarted: event FabricLot.WeavingStarted is {
        tell weavingStarted to repository FabricContext.FabricLotRepository
        do "Record loom start time"
      }
      on weavingCompleted: event FabricLot.WeavingCompleted is {
        tell weavingCompleted to repository FabricContext.FabricLotRepository
        do "Calculate loom efficiency"
      }
      on weavingDefectRecorded: event FabricLot.WeavingDefectRecorded is {
        tell weavingDefectRecorded to repository FabricContext.FabricLotRepository
        do "Update defect rate"
      }
    } with {
      briefly "Calculates loom efficiency"
      described as {
        |Projects events into loom efficiency metrics.
      }
    }
  } with {
    briefly "Loom efficiency projections"
    described as {
      |Maintains loom performance analytics.
    }
  }
  // Projector for dye lot consistency tracking
  query GetDyeLotMetrics is  {
    dyeLotMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which dye lot metrics to retrieve.
      }
    }
  } with {
    briefly "Get dye lot metrics"
    described as {
      |Retrieves the dye lot metrics projection.
    }
  }
  result DyeLotMetricsView is  {
    dyeLotMetrics: DyeLotConsistencyAnalytics.DyeLotMetrics with {
      briefly "Dye lot metrics"
      described as {
        |The dye lot metrics being returned.
      }
    }
  } with {
    briefly "Dye lot metrics view"
    described as {
      |Read model view carrying the dye lot metrics projection.
    }
  }
  projector DyeLotConsistencyAnalytics as flow is {
    updates repository FabricContext.FabricLotRepository
    inlet DyeLotConsistencyAnalyticsFromFabricLot is type FabricLotEvent    outlet DyeLotConsistencyAnalyticsOut is type FabricLotEvent
    record DyeLotMetrics is  {
      dyeLotId: DyeLotId with {
        briefly "Dye lot"
        described as {
          |Dye lot identifier.
        }
      }
      colorCode: String(1,50) with {
        briefly "Color"
        described as {
          |Color code.
        }
      }
      fabricLotsProcessed: Natural with {
        briefly "Lots"
        described as {
          |Fabric lots processed.
        }
      }
      colorMatchPassRate: Decimal(5,4) with {
        briefly "Pass rate"
        described as {
          |Color match pass rate.
        }
      }
      avgColorfastness: Decimal(3,2) with {
        briefly "Avg colorfastness"
        described as {
          |Average colorfastness rating.
        }
      }
      totalYardsDyed: Decimal(14,2) with {
        briefly "Yards"
        described as {
          |Total yards dyed.
        }
      }
      redyeRate: Decimal(5,4) with {
        briefly "Redye rate"
        described as {
          |Redye percentage.
        }
      }
    } with {
      briefly "Dye lot metrics"
      described as {
        |Dye lot consistency metrics.
      }
    }
    handler DyeLotConsistencyHandler is {
      on dyeingStarted: event FabricLot.DyeingStarted is {
        tell dyeingStarted to repository FabricContext.FabricLotRepository
        do "Track dye lot usage"
      }
      on dyeingCompleted: event FabricLot.DyeingCompleted is {
        tell dyeingCompleted to repository FabricContext.FabricLotRepository
        do "Update color match statistics"
      }
    } with {
      briefly "Tracks dye consistency"
      described as {
        |Projects events into dye lot consistency metrics.
      }
    }
  } with {
    briefly "Dye lot consistency projections"
    described as {
      |Maintains dye batch consistency analytics.
    }
  }
  // Projector for grading yield analysis
  query GetGradingMetrics is  {
    gradingMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which grading metrics to retrieve.
      }
    }
  } with {
    briefly "Get grading metrics"
    described as {
      |Retrieves the grading metrics projection.
    }
  }
  result GradingMetricsView is  {
    gradingMetrics: GradingYieldAnalytics.GradingMetrics with {
      briefly "Grading metrics"
      described as {
        |The grading metrics being returned.
      }
    }
  } with {
    briefly "Grading metrics view"
    described as {
      |Read model view carrying the grading metrics projection.
    }
  }
  projector GradingYieldAnalytics as flow is {
    updates repository FabricContext.FabricLotRepository
    inlet GradingYieldAnalyticsFromFabricLot is type FabricLotEvent    outlet GradingYieldAnalyticsOut is type FabricLotEvent
    record GradingMetrics is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
      totalLotsGraded: Natural with {
        briefly "Lots"
        described as {
          |Total lots graded.
        }
      }
      premiumPercent: Decimal(5,4) with {
        briefly "Premium"
        described as {
          |Premium grade percentage.
        }
      }
      firstQualityPercent: Decimal(5,4) with {
        briefly "First"
        described as {
          |First quality percentage.
        }
      }
      secondQualityPercent: Decimal(5,4) with {
        briefly "Second"
        described as {
          |Second quality percentage.
        }
      }
      utilityPercent: Decimal(5,4) with {
        briefly "Utility"
        described as {
          |Utility grade percentage.
        }
      }
      rejectPercent: Decimal(5,4) with {
        briefly "Reject"
        described as {
          |Reject percentage.
        }
      }
      avgPointsPerHundredYards: Decimal(8,2) with {
        briefly "Avg points"
        described as {
          |Average defect points.
        }
      }
      totalUsableYards: Decimal(16,2) with {
        briefly "Usable"
        described as {
          |Total usable yards.
        }
      }
      totalWasteYards: Decimal(14,2) with {
        briefly "Waste"
        described as {
          |Total waste yards.
        }
      }
    } with {
      briefly "Grading metrics"
      described as {
        |Fabric grading yield metrics.
      }
    }
    handler GradingYieldHandler is {
      on fabricGraded: event FabricLot.FabricGraded is {
        tell fabricGraded to repository FabricContext.FabricLotRepository
        do "Update grading statistics"
      }
      on fabricShipped: event FabricLot.FabricShipped is {
        tell fabricShipped to repository FabricContext.FabricLotRepository
        do "Update shipment statistics"
      }
    } with {
      briefly "Calculates grading yields"
      described as {
        |Projects events into grading yield analytics.
      }
    }
  } with {
    briefly "Grading yield projections"
    described as {
      |Maintains fabric grading and yield analytics.
    }
  }
  // ---- Event publication for FabricLot ----
  type FabricLotEvent is one of {
    FabricContext.FabricLot.FabricLotCreated or FabricContext.FabricLot.WarpingStarted or FabricContext.FabricLot.WeavingStarted or FabricContext.FabricLot.WeavingDefectRecorded or FabricContext.FabricLot.WeavingCompleted or FabricContext.FabricLot.DyeingStarted or FabricContext.FabricLot.DyeingCompleted or FabricContext.FabricLot.FinishingApplied or FabricContext.FabricLot.FinishingCompleted or FabricContext.FabricLot.FabricGraded or FabricContext.FabricLot.FabricShipped
  } with {
    briefly "FabricLot event alternation"
    described as {
      |Union of all FabricLot events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FabricLotEventSource as source is {
    outlet FabricLotEvents is type FabricLotEvent
    handler FabricLotSourceHandler is {
      on fabricLotCreated: event FabricLot.FabricLotCreated is {
        send fabricLotCreated to outlet FabricLotEvents
      }
      on warpingStarted: event FabricLot.WarpingStarted is {
        send warpingStarted to outlet FabricLotEvents
      }
      on weavingStarted: event FabricLot.WeavingStarted is {
        send weavingStarted to outlet FabricLotEvents
      }
      on weavingDefectRecorded: event FabricLot.WeavingDefectRecorded is {
        send weavingDefectRecorded to outlet FabricLotEvents
      }
      on weavingCompleted: event FabricLot.WeavingCompleted is {
        send weavingCompleted to outlet FabricLotEvents
      }
      on dyeingStarted: event FabricLot.DyeingStarted is {
        send dyeingStarted to outlet FabricLotEvents
      }
      on dyeingCompleted: event FabricLot.DyeingCompleted is {
        send dyeingCompleted to outlet FabricLotEvents
      }
      on finishingApplied: event FabricLot.FinishingApplied is {
        send finishingApplied to outlet FabricLotEvents
      }
      on finishingCompleted: event FabricLot.FinishingCompleted is {
        send finishingCompleted to outlet FabricLotEvents
      }
      on fabricGraded: event FabricLot.FabricGraded is {
        send fabricGraded to outlet FabricLotEvents
      }
      on fabricShipped: event FabricLot.FabricShipped is {
        send fabricShipped to outlet FabricLotEvents
      }
      on other is {
        error "Unexpected message for source FabricLotEventSource"
      }
    } with {
      briefly "FabricLot source handler"
      described as {
        |Publishes FabricLot events onto the outlet.
      }
    }
  } with {
    briefly "FabricLot event source"
    described as {
      |Publishes FabricLot entity events into the streaming topology.
    }
  }
  processor FabricLotEventSink as sink is {
    inlet FabricLotInlet is type FabricLotEvent    handler FabricLotSinkHandler is {
      on fabricLotCreated: event FabricLot.FabricLotCreated is {
        tell fabricLotCreated to repository FabricContext.FabricLotRepository
      }
      on warpingStarted: event FabricLot.WarpingStarted is {
        tell warpingStarted to repository FabricContext.FabricLotRepository
      }
      on weavingStarted: event FabricLot.WeavingStarted is {
        tell weavingStarted to repository FabricContext.FabricLotRepository
      }
      on weavingDefectRecorded: event FabricLot.WeavingDefectRecorded is {
        tell weavingDefectRecorded to repository FabricContext.FabricLotRepository
      }
      on weavingCompleted: event FabricLot.WeavingCompleted is {
        tell weavingCompleted to repository FabricContext.FabricLotRepository
      }
      on dyeingStarted: event FabricLot.DyeingStarted is {
        tell dyeingStarted to repository FabricContext.FabricLotRepository
      }
      on dyeingCompleted: event FabricLot.DyeingCompleted is {
        tell dyeingCompleted to repository FabricContext.FabricLotRepository
      }
      on finishingApplied: event FabricLot.FinishingApplied is {
        tell finishingApplied to repository FabricContext.FabricLotRepository
      }
      on finishingCompleted: event FabricLot.FinishingCompleted is {
        tell finishingCompleted to repository FabricContext.FabricLotRepository
      }
      on fabricGraded: event FabricLot.FabricGraded is {
        tell fabricGraded to repository FabricContext.FabricLotRepository
      }
      on fabricShipped: event FabricLot.FabricShipped is {
        tell fabricShipped to repository FabricContext.FabricLotRepository
      }
      on other is {
        error "Unexpected message for sink FabricLotEventSink"
      }
    } with {
      briefly "FabricLot sink handler"
      described as {
        |Persists FabricLot events via the repository.
      }
    }
  } with {
    briefly "FabricLot event sink"
    described as {
      |Receives FabricLot events for persistence.
    }
  }
  connector FabricLotEventFlow is from outlet FabricContext.FabricLotEventSource.FabricLotEvents to inlet FabricContext.FabricLotEventSink.FabricLotInlet with {
    briefly "FabricLot event flow"
    described as {
      |Connects the FabricLot source to its sink.
    }
  }
  processor FabricLotEventSplit as split is {
    inlet FabricLotEventSplitIn is type FabricLotEvent    outlet FabricLotEventSplitToFabricLotRepository is type FabricLotEvent
    outlet FabricLotEventSplitToLoomEfficiencyAnalytics is type FabricLotEvent
    outlet FabricLotEventSplitToDyeLotConsistencyAnalytics is type FabricLotEvent
    outlet FabricLotEventSplitToGradingYieldAnalytics is type FabricLotEvent
    handler FabricLotEventSplitHandler is {
      on fabricLotCreated: event FabricLot.FabricLotCreated is {
        send fabricLotCreated to outlet FabricLotEventSplitToFabricLotRepository
        send fabricLotCreated to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send fabricLotCreated to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send fabricLotCreated to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell fabricLotCreated to entity FabricContext.FabricLot
      }
      on warpingStarted: event FabricLot.WarpingStarted is {
        send warpingStarted to outlet FabricLotEventSplitToFabricLotRepository
        send warpingStarted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send warpingStarted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send warpingStarted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell warpingStarted to entity FabricContext.FabricLot
      }
      on weavingStarted: event FabricLot.WeavingStarted is {
        send weavingStarted to outlet FabricLotEventSplitToFabricLotRepository
        send weavingStarted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send weavingStarted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send weavingStarted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell weavingStarted to entity FabricContext.FabricLot
      }
      on weavingDefectRecorded: event FabricLot.WeavingDefectRecorded is {
        send weavingDefectRecorded to outlet FabricLotEventSplitToFabricLotRepository
        send weavingDefectRecorded to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send weavingDefectRecorded to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send weavingDefectRecorded to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell weavingDefectRecorded to entity FabricContext.FabricLot
      }
      on weavingCompleted: event FabricLot.WeavingCompleted is {
        send weavingCompleted to outlet FabricLotEventSplitToFabricLotRepository
        send weavingCompleted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send weavingCompleted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send weavingCompleted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell weavingCompleted to entity FabricContext.FabricLot
      }
      on dyeingStarted: event FabricLot.DyeingStarted is {
        send dyeingStarted to outlet FabricLotEventSplitToFabricLotRepository
        send dyeingStarted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send dyeingStarted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send dyeingStarted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell dyeingStarted to entity FabricContext.FabricLot
      }
      on dyeingCompleted: event FabricLot.DyeingCompleted is {
        send dyeingCompleted to outlet FabricLotEventSplitToFabricLotRepository
        send dyeingCompleted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send dyeingCompleted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send dyeingCompleted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell dyeingCompleted to entity FabricContext.FabricLot
      }
      on finishingApplied: event FabricLot.FinishingApplied is {
        send finishingApplied to outlet FabricLotEventSplitToFabricLotRepository
        send finishingApplied to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send finishingApplied to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send finishingApplied to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell finishingApplied to entity FabricContext.FabricLot
      }
      on finishingCompleted: event FabricLot.FinishingCompleted is {
        send finishingCompleted to outlet FabricLotEventSplitToFabricLotRepository
        send finishingCompleted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send finishingCompleted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send finishingCompleted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell finishingCompleted to entity FabricContext.FabricLot
      }
      on fabricGraded: event FabricLot.FabricGraded is {
        send fabricGraded to outlet FabricLotEventSplitToFabricLotRepository
        send fabricGraded to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send fabricGraded to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send fabricGraded to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell fabricGraded to entity FabricContext.FabricLot
      }
      on fabricShipped: event FabricLot.FabricShipped is {
        send fabricShipped to outlet FabricLotEventSplitToFabricLotRepository
        send fabricShipped to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send fabricShipped to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send fabricShipped to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell fabricShipped to entity FabricContext.FabricLot
      }
      on other is {
        error "Unexpected message for processor FabricLotEventSplit"
      }
    } with {
      briefly "FabricLot event fan-out handler"
      described as {
        |Delivers each FabricLot event to all of its consumers.
      }
    }
  } with {
    briefly "FabricLot event fan-out"
    described as {
      |Fans FabricLot events out to the repository and projectors.
    }
  }
  connector 'FabricLotEvent Stream' is from outlet FabricContext.FabricLot.FabricLotEvents2 to inlet FabricContext.FabricLotEventSplit.FabricLotEventSplitIn with {
    briefly "FabricLot events, fanned out to storage and read models"
  }
  connector 'FabricLotEvent Storage' is from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToFabricLotRepository to inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromFabricLot with {
    briefly "FabricLot events on their way to storage"
  }
  connector 'LoomEfficiencyAnalytics Feed' is from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToLoomEfficiencyAnalytics to inlet FabricContext.LoomEfficiencyAnalytics.LoomEfficiencyAnalyticsFromFabricLot with {
    briefly "FabricLot events feeding the LoomEfficiencyAnalytics projection"
  }
  connector 'DyeLotConsistencyAnalytics Feed' is from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToDyeLotConsistencyAnalytics to inlet FabricContext.DyeLotConsistencyAnalytics.DyeLotConsistencyAnalyticsFromFabricLot with {
    briefly "FabricLot events feeding the DyeLotConsistencyAnalytics projection"
  }
  connector 'GradingYieldAnalytics Feed' is from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToGradingYieldAnalytics to inlet FabricContext.GradingYieldAnalytics.GradingYieldAnalyticsFromFabricLot with {
    briefly "FabricLot events feeding the GradingYieldAnalytics projection"
  }
  connector 'LoomEfficiencyAnalytics Storage' is from outlet FabricContext.LoomEfficiencyAnalytics.LoomEfficiencyAnalyticsOut to inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromLoomEfficiencyAnalytics with {
    briefly "The LoomEfficiencyAnalytics projection on its way to storage"
  }
  connector 'DyeLotConsistencyAnalytics Storage' is from outlet FabricContext.DyeLotConsistencyAnalytics.DyeLotConsistencyAnalyticsOut to inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromDyeLotConsistencyAnalytics with {
    briefly "The DyeLotConsistencyAnalytics projection on its way to storage"
  }
  connector 'GradingYieldAnalytics Storage' is from outlet FabricContext.GradingYieldAnalytics.GradingYieldAnalyticsOut to inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromGradingYieldAnalytics with {
    briefly "The GradingYieldAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for fabric production"
  described as {
    | The FabricContext is the bounded context for textile
    | fabric production including weaving, dyeing, finishing,
    | and quality control operations.
  }
}
