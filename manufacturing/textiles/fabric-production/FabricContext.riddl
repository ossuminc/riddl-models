// Fabric Production - Fabric Context
context FabricContext is {
  include "types.riddl"
  include "FabricLot.riddl"
  // Repository for fabric lot persistence
  repository FabricLotRepository is {
    inlet FabricLotRepositoryFromFabricLot is type FabricLotEvent
    inlet FabricLotRepositoryFromLoomEfficiencyAnalytics is type FabricLotEvent
    inlet FabricLotRepositoryFromDyeLotConsistencyAnalytics is type FabricLotEvent
    inlet FabricLotRepositoryFromGradingYieldAnalytics is type FabricLotEvent
    outlet FabricLotRepositoryResponses is type FabricLot.FabricLotResult
    schema FabricLotData is relational
      of fabricLots as type FabricLot
        index on field FabricLot.fabricLotId
        index on field FabricLot.styleNumber
        index on field FabricLot.status

    handler FabricLotPersistence is {
      on command FabricLot.CreateFabricLot is {
        tell event FabricLot.FabricLotCreated to entity FabricContext.FabricLot
        do "Store new fabric lot"
      }
      on command FabricLot.StartWarping is {
        tell event FabricLot.WarpingStarted to entity FabricContext.FabricLot
        do "Update with warping info"
      }
      on command FabricLot.StartWeaving is {
        tell event FabricLot.WeavingStarted to entity FabricContext.FabricLot
        do "Update with loom assignment"
      }
      on command FabricLot.RecordWeavingDefect is {
        tell event FabricLot.WeavingDefectRecorded to entity FabricContext.FabricLot
        do "Store weaving defect"
      }
      on command FabricLot.CompleteWeaving is {
        tell event FabricLot.WeavingCompleted to entity FabricContext.FabricLot
        do "Update weaving completion"
      }
      on command FabricLot.StartDyeing is {
        tell event FabricLot.DyeingStarted to entity FabricContext.FabricLot
        do "Update to dyeing status"
      }
      on command FabricLot.CompleteDyeing is {
        tell event FabricLot.DyeingCompleted to entity FabricContext.FabricLot
        do "Update dyeing completion"
      }
      on command FabricLot.ApplyFinishing is {
        do "Update to finishing status"
      }
      on command FabricLot.CompleteFinishing is {
        tell event FabricLot.FinishingCompleted to entity FabricContext.FabricLot
        do "Update finishing completion"
      }
      on command FabricLot.GradeFabric is {
        do "Store fabric grade"
      }
      on command FabricLot.ShipFabric is {
        tell event FabricLot.FabricShipped to entity FabricContext.FabricLot
        do "Update to shipped status"
      }
    } with {
      briefly "Persists fabric lot events"
      described as {
        |Handles command-driven persistence for fabric lots.
      }
    }
  } with {
    briefly "Fabric lot data persistence"
    described as {
      | The FabricLotRepository provides persistent storage for
      | fabric lots, production data, and quality records.
    }
  }
  // Projector for loom efficiency analytics
  projector LoomEfficiencyAnalytics is {
    inlet LoomEfficiencyAnalyticsFromFabricLot is type FabricLotEvent
    outlet LoomEfficiencyAnalyticsOut is type FabricLotEvent
    updates repository FabricContext.FabricLotRepository
    record LoomMetrics is  {
      loomId: LoomId with {
        briefly "Loom"
        described as {
          |Loom identifier.
        }
      }
      totalRunHours: Decimal(10,2) with {
        briefly "Run hours"
        described as {
          |Total run hours.
        }
      }
      totalDowntimeHours: Decimal(10,2) with {
        briefly "Downtime"
        described as {
          |Total downtime hours.
        }
      }
      yardsProduced: Decimal(14,2) with {
        briefly "Yards"
        described as {
          |Total yards produced.
        }
      }
      defectsPerThousandYards: Decimal(8,4) with {
        briefly "DPKY"
        described as {
          |Defects per 1000 yards.
        }
      }
      efficiency: Decimal(5,4) with {
        briefly "Efficiency"
        described as {
          |Loom efficiency ratio.
        }
      }
      avgPicksPerMinute: Natural with {
        briefly "Avg PPM"
        described as {
          |Average picks per minute.
        }
      }
    } with {
      briefly "Loom metrics"
      described as {
        |Loom performance metrics.
      }
    }
    handler LoomEfficiencyHandler is {
      on event FabricLot.WeavingStarted is {
        tell event FabricLot.WeavingStarted to repository FabricContext.FabricLotRepository
        do "Record loom start time"
      }
      on event FabricLot.WeavingCompleted is {
        tell event FabricLot.WeavingCompleted to repository FabricContext.FabricLotRepository
        do "Calculate loom efficiency"
      }
      on event FabricLot.WeavingDefectRecorded is {
        tell event FabricLot.WeavingDefectRecorded to repository FabricContext.FabricLotRepository
        do "Update defect rate"
      }
    } with {
      briefly "Calculates loom efficiency"
      described as {
        |Projects events into loom efficiency metrics.
      }
    }
  } with {
    briefly "Loom efficiency projections"
    described as {
      |Maintains loom performance analytics.
    }
  }
  // Projector for dye lot consistency tracking
  projector DyeLotConsistencyAnalytics is {
    inlet DyeLotConsistencyAnalyticsFromFabricLot is type FabricLotEvent
    outlet DyeLotConsistencyAnalyticsOut is type FabricLotEvent
    updates repository FabricContext.FabricLotRepository
    record DyeLotMetrics is  {
      dyeLotId: DyeLotId with {
        briefly "Dye lot"
        described as {
          |Dye lot identifier.
        }
      }
      colorCode: String(1,50) with {
        briefly "Color"
        described as {
          |Color code.
        }
      }
      fabricLotsProcessed: Natural with {
        briefly "Lots"
        described as {
          |Fabric lots processed.
        }
      }
      colorMatchPassRate: Decimal(5,4) with {
        briefly "Pass rate"
        described as {
          |Color match pass rate.
        }
      }
      avgColorfastness: Decimal(3,2) with {
        briefly "Avg colorfastness"
        described as {
          |Average colorfastness rating.
        }
      }
      totalYardsDyed: Decimal(14,2) with {
        briefly "Yards"
        described as {
          |Total yards dyed.
        }
      }
      redyeRate: Decimal(5,4) with {
        briefly "Redye rate"
        described as {
          |Redye percentage.
        }
      }
    } with {
      briefly "Dye lot metrics"
      described as {
        |Dye lot consistency metrics.
      }
    }
    handler DyeLotConsistencyHandler is {
      on event FabricLot.DyeingStarted is {
        tell event FabricLot.DyeingStarted to repository FabricContext.FabricLotRepository
        do "Track dye lot usage"
      }
      on event FabricLot.DyeingCompleted is {
        tell event FabricLot.DyeingCompleted to repository FabricContext.FabricLotRepository
        do "Update color match statistics"
      }
    } with {
      briefly "Tracks dye consistency"
      described as {
        |Projects events into dye lot consistency metrics.
      }
    }
  } with {
    briefly "Dye lot consistency projections"
    described as {
      |Maintains dye batch consistency analytics.
    }
  }
  // Projector for grading yield analysis
  projector GradingYieldAnalytics is {
    inlet GradingYieldAnalyticsFromFabricLot is type FabricLotEvent
    outlet GradingYieldAnalyticsOut is type FabricLotEvent
    updates repository FabricContext.FabricLotRepository
    record GradingMetrics is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
      totalLotsGraded: Natural with {
        briefly "Lots"
        described as {
          |Total lots graded.
        }
      }
      premiumPercent: Decimal(5,4) with {
        briefly "Premium"
        described as {
          |Premium grade percentage.
        }
      }
      firstQualityPercent: Decimal(5,4) with {
        briefly "First"
        described as {
          |First quality percentage.
        }
      }
      secondQualityPercent: Decimal(5,4) with {
        briefly "Second"
        described as {
          |Second quality percentage.
        }
      }
      utilityPercent: Decimal(5,4) with {
        briefly "Utility"
        described as {
          |Utility grade percentage.
        }
      }
      rejectPercent: Decimal(5,4) with {
        briefly "Reject"
        described as {
          |Reject percentage.
        }
      }
      avgPointsPerHundredYards: Decimal(8,2) with {
        briefly "Avg points"
        described as {
          |Average defect points.
        }
      }
      totalUsableYards: Decimal(16,2) with {
        briefly "Usable"
        described as {
          |Total usable yards.
        }
      }
      totalWasteYards: Decimal(14,2) with {
        briefly "Waste"
        described as {
          |Total waste yards.
        }
      }
    } with {
      briefly "Grading metrics"
      described as {
        |Fabric grading yield metrics.
      }
    }
    handler GradingYieldHandler is {
      on event FabricLot.FabricGraded is {
        tell event FabricLot.FabricGraded to repository FabricContext.FabricLotRepository
        do "Update grading statistics"
      }
      on event FabricLot.FabricShipped is {
        tell event FabricLot.FabricShipped to repository FabricContext.FabricLotRepository
        do "Update shipment statistics"
      }
    } with {
      briefly "Calculates grading yields"
      described as {
        |Projects events into grading yield analytics.
      }
    }
  } with {
    briefly "Grading yield projections"
    described as {
      |Maintains fabric grading and yield analytics.
    }
  }
  // ---- Event publication for FabricLot ----
  type FabricLotEvent is one of {
    FabricContext.FabricLot.FabricLotCreated,
    FabricContext.FabricLot.WarpingStarted,
    FabricContext.FabricLot.WeavingStarted,
    FabricContext.FabricLot.WeavingDefectRecorded,
    FabricContext.FabricLot.WeavingCompleted,
    FabricContext.FabricLot.DyeingStarted,
    FabricContext.FabricLot.DyeingCompleted,
    FabricContext.FabricLot.FinishingApplied,
    FabricContext.FabricLot.FinishingCompleted,
    FabricContext.FabricLot.FabricGraded,
    FabricContext.FabricLot.FabricShipped
  } with {
    briefly "FabricLot event alternation"
    described as {
      |Union of all FabricLot events, for streaming and event-sourced
      |persistence.
    }
  }
  processor FabricLotEventSource as source is {
    outlet FabricLotEvents is type FabricLotEvent
    handler FabricLotSourceHandler is {
      on event FabricLot.FabricLotCreated is {
        send event FabricLot.FabricLotCreated to outlet FabricLotEvents
      }
      on event FabricLot.WarpingStarted is {
        send event FabricLot.WarpingStarted to outlet FabricLotEvents
      }
      on event FabricLot.WeavingStarted is {
        send event FabricLot.WeavingStarted to outlet FabricLotEvents
      }
      on event FabricLot.WeavingDefectRecorded is {
        send event FabricLot.WeavingDefectRecorded to outlet FabricLotEvents
      }
      on event FabricLot.WeavingCompleted is {
        send event FabricLot.WeavingCompleted to outlet FabricLotEvents
      }
      on event FabricLot.DyeingStarted is {
        send event FabricLot.DyeingStarted to outlet FabricLotEvents
      }
      on event FabricLot.DyeingCompleted is {
        send event FabricLot.DyeingCompleted to outlet FabricLotEvents
      }
      on event FabricLot.FinishingApplied is {
        send event FabricLot.FinishingApplied to outlet FabricLotEvents
      }
      on event FabricLot.FinishingCompleted is {
        send event FabricLot.FinishingCompleted to outlet FabricLotEvents
      }
      on event FabricLot.FabricGraded is {
        send event FabricLot.FabricGraded to outlet FabricLotEvents
      }
      on event FabricLot.FabricShipped is {
        send event FabricLot.FabricShipped to outlet FabricLotEvents
      }
      on other is {
        error "Unexpected message for source FabricLotEventSource"
      }
    } with {
      briefly "FabricLot source handler"
      described as {
        |Publishes FabricLot events onto the outlet.
      }
    }
  } with {
    briefly "FabricLot event source"
    described as {
      |Publishes FabricLot entity events into the streaming topology.
    }
  }
  processor FabricLotEventSink as sink is {
    inlet FabricLotInlet is type FabricLotEvent
    handler FabricLotSinkHandler is {
      on event FabricLot.FabricLotCreated is {
        tell event FabricLot.FabricLotCreated to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.WarpingStarted is {
        tell event FabricLot.WarpingStarted to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.WeavingStarted is {
        tell event FabricLot.WeavingStarted to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.WeavingDefectRecorded is {
        tell event FabricLot.WeavingDefectRecorded to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.WeavingCompleted is {
        tell event FabricLot.WeavingCompleted to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.DyeingStarted is {
        tell event FabricLot.DyeingStarted to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.DyeingCompleted is {
        tell event FabricLot.DyeingCompleted to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.FinishingApplied is {
        tell event FabricLot.FinishingApplied to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.FinishingCompleted is {
        tell event FabricLot.FinishingCompleted to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.FabricGraded is {
        tell event FabricLot.FabricGraded to repository FabricContext.FabricLotRepository
      }
      on event FabricLot.FabricShipped is {
        tell event FabricLot.FabricShipped to repository FabricContext.FabricLotRepository
      }
      on other is {
        error "Unexpected message for sink FabricLotEventSink"
      }
    } with {
      briefly "FabricLot sink handler"
      described as {
        |Persists FabricLot events via the repository.
      }
    }
  } with {
    briefly "FabricLot event sink"
    described as {
      |Receives FabricLot events for persistence.
    }
  }
  connector FabricLotEventFlow is {
    from outlet FabricContext.FabricLotEventSource.FabricLotEvents to
      inlet FabricContext.FabricLotEventSink.FabricLotInlet
  } with {
    briefly "FabricLot event flow"
    described as {
      |Connects the FabricLot source to its sink.
    }
  }
  processor FabricLotEventSplit is {
    inlet FabricLotEventSplitIn is type FabricLotEvent
    outlet FabricLotEventSplitToFabricLotRepository is type FabricLotEvent
    outlet FabricLotEventSplitToLoomEfficiencyAnalytics is type FabricLotEvent
    outlet FabricLotEventSplitToDyeLotConsistencyAnalytics is type FabricLotEvent
    outlet FabricLotEventSplitToGradingYieldAnalytics is type FabricLotEvent
    handler FabricLotEventSplitHandler is {
      on event FabricLot.FabricLotCreated is {
        send event FabricLot.FabricLotCreated to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.FabricLotCreated to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.FabricLotCreated to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.FabricLotCreated to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.FabricLotCreated to entity FabricContext.FabricLot
      }
      on event FabricLot.WarpingStarted is {
        send event FabricLot.WarpingStarted to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.WarpingStarted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.WarpingStarted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.WarpingStarted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.WarpingStarted to entity FabricContext.FabricLot
      }
      on event FabricLot.WeavingStarted is {
        send event FabricLot.WeavingStarted to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.WeavingStarted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.WeavingStarted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.WeavingStarted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.WeavingStarted to entity FabricContext.FabricLot
      }
      on event FabricLot.WeavingDefectRecorded is {
        send event FabricLot.WeavingDefectRecorded to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.WeavingDefectRecorded to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.WeavingDefectRecorded to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.WeavingDefectRecorded to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.WeavingDefectRecorded to entity FabricContext.FabricLot
      }
      on event FabricLot.WeavingCompleted is {
        send event FabricLot.WeavingCompleted to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.WeavingCompleted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.WeavingCompleted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.WeavingCompleted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.WeavingCompleted to entity FabricContext.FabricLot
      }
      on event FabricLot.DyeingStarted is {
        send event FabricLot.DyeingStarted to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.DyeingStarted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.DyeingStarted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.DyeingStarted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.DyeingStarted to entity FabricContext.FabricLot
      }
      on event FabricLot.DyeingCompleted is {
        send event FabricLot.DyeingCompleted to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.DyeingCompleted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.DyeingCompleted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.DyeingCompleted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.DyeingCompleted to entity FabricContext.FabricLot
      }
      on event FabricLot.FinishingApplied is {
        send event FabricLot.FinishingApplied to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.FinishingApplied to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.FinishingApplied to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.FinishingApplied to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.FinishingApplied to entity FabricContext.FabricLot
      }
      on event FabricLot.FinishingCompleted is {
        send event FabricLot.FinishingCompleted to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.FinishingCompleted to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.FinishingCompleted to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.FinishingCompleted to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.FinishingCompleted to entity FabricContext.FabricLot
      }
      on event FabricLot.FabricGraded is {
        send event FabricLot.FabricGraded to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.FabricGraded to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.FabricGraded to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.FabricGraded to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.FabricGraded to entity FabricContext.FabricLot
      }
      on event FabricLot.FabricShipped is {
        send event FabricLot.FabricShipped to outlet FabricLotEventSplitToFabricLotRepository
        send event FabricLot.FabricShipped to outlet FabricLotEventSplitToLoomEfficiencyAnalytics
        send event FabricLot.FabricShipped to outlet FabricLotEventSplitToDyeLotConsistencyAnalytics
        send event FabricLot.FabricShipped to outlet FabricLotEventSplitToGradingYieldAnalytics
        tell event FabricLot.FabricShipped to entity FabricContext.FabricLot
      }
      on other is {
        error "Unexpected message for processor FabricLotEventSplit"
      }
    } with {
      briefly "FabricLot event fan-out handler"
      described as {
        |Delivers each FabricLot event to all of its consumers.
      }
    }
  } with {
    briefly "FabricLot event fan-out"
    described as {
      |Fans FabricLot events out to the repository and projectors.
    }
  }
  connector LinkFabricLotToFabricLotEventSplit is {
    from outlet FabricContext.FabricLot.FabricLotEvents2 to
      inlet FabricContext.FabricLotEventSplit.FabricLotEventSplitIn
  } with {
    briefly "LinkFabricLotToFabricLotEventSplit"
  }
  connector LinkFabricLotEventSplitToFabricLotRepository is {
    from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToFabricLotRepository to
      inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromFabricLot
  } with {
    briefly "LinkFabricLotEventSplitToFabricLotRepository"
  }
  connector LinkFabricLotEventSplitToLoomEfficiencyAnalytics is {
    from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToLoomEfficiencyAnalytics to
      inlet FabricContext.LoomEfficiencyAnalytics.LoomEfficiencyAnalyticsFromFabricLot
  } with {
    briefly "LinkFabricLotEventSplitToLoomEfficiencyAnalytics"
  }
  connector LinkFabricLotEventSplitToDyeLotConsistencyAnalytics is {
    from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToDyeLotConsistencyAnalytics to
      inlet FabricContext.DyeLotConsistencyAnalytics.DyeLotConsistencyAnalyticsFromFabricLot
  } with {
    briefly "LinkFabricLotEventSplitToDyeLotConsistencyAnalytics"
  }
  connector LinkFabricLotEventSplitToGradingYieldAnalytics is {
    from outlet FabricContext.FabricLotEventSplit.FabricLotEventSplitToGradingYieldAnalytics to
      inlet FabricContext.GradingYieldAnalytics.GradingYieldAnalyticsFromFabricLot
  } with {
    briefly "LinkFabricLotEventSplitToGradingYieldAnalytics"
  }
  connector LinkLoomEfficiencyAnalyticsToFabricLotRepository is {
    from outlet FabricContext.LoomEfficiencyAnalytics.LoomEfficiencyAnalyticsOut to
      inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromLoomEfficiencyAnalytics
  } with {
    briefly "LinkLoomEfficiencyAnalyticsToFabricLotRepository"
  }
  connector LinkDyeLotConsistencyAnalyticsToFabricLotRepository is {
    from outlet FabricContext.DyeLotConsistencyAnalytics.DyeLotConsistencyAnalyticsOut to
      inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromDyeLotConsistencyAnalytics
  } with {
    briefly "LinkDyeLotConsistencyAnalyticsToFabricLotRepository"
  }
  connector LinkGradingYieldAnalyticsToFabricLotRepository is {
    from outlet FabricContext.GradingYieldAnalytics.GradingYieldAnalyticsOut to
      inlet FabricContext.FabricLotRepository.FabricLotRepositoryFromGradingYieldAnalytics
  } with {
    briefly "LinkGradingYieldAnalyticsToFabricLotRepository"
  }
} with {
  briefly "Bounded context for fabric production"
  described as {
    | The FabricContext is the bounded context for textile
    | fabric production including weaving, dyeing, finishing,
    | and quality control operations.
  }
}
