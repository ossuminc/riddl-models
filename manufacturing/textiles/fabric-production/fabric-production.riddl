// Fabric Production Domain Model
// Textile weaving, dyeing, and finishing operations
domain FabricProduction is {
  persistent connector 'YarnInventoryReply Stream' is from outlet YarnInventory.YarnInventoryRepliesOut to inlet FabricContext.ToYarnInventory.ToYarnInventoryReplies with {
    briefly "What YarnInventory answers FabricContext"
  }
  persistent connector 'DyeChemicalInventoryReply Stream' is from outlet DyeChemicalInventory.DyeChemicalInventoryRepliesOut to inlet FabricContext.ToDyeChemicalInventory.ToDyeChemicalInventoryReplies with {
    briefly "What DyeChemicalInventory answers FabricContext"
  }
  persistent connector 'CustomerOrderServiceReply Stream' is from outlet CustomerOrderService.CustomerOrderServiceRepliesOut to inlet FabricContext.ToCustomerOrderService.ToCustomerOrderServiceReplies with {
    briefly "What CustomerOrderService answers FabricContext"
  }
  persistent connector 'CustomerOrderServiceEvent Stream' is from outlet CustomerOrderService.CustomerOrderServiceEventsOut to inlet FabricContext.FromCustomerOrderService.FromCustomerOrderServiceIn with {
    briefly "What CustomerOrderService tells FabricContext, unasked"
  }
  persistent connector 'DyeChemicalInventoryEvent Stream' is from outlet DyeChemicalInventory.DyeChemicalInventoryEventsOut to inlet FabricContext.FromDyeChemicalInventory.FromDyeChemicalInventoryIn with {
    briefly "What DyeChemicalInventory tells FabricContext, unasked"
  }
  persistent connector 'YarnInventoryEvent Stream' is from outlet YarnInventory.YarnInventoryEventsOut to inlet FabricContext.FromYarnInventory.FromYarnInventoryIn with {
    briefly "What YarnInventory tells FabricContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user WeavingOperator is "person operating looms and weaving equipment" with {
    briefly "Weaving Operator"
    described as {
      |Person responsible for loom setup, warping, and weaving operations.
    }
  }
  user DyeingTechnician is "person managing dye processes and formulations" with {
    briefly "Dyeing Technician"
    described as {
      |Person responsible for dye mixing, application, and color consistency.
    }
  }
  user FinishingOperator is "person operating finishing equipment" with {
    briefly "Finishing Operator"
    described as {
      |Person responsible for fabric finishing treatments and processes.
    }
  }
  user QualityController is "person inspecting and grading fabric" with {
    briefly "Quality Controller"
    described as {
      |Person responsible for fabric inspection, defect detection, and grading.
    }
  }
  epic FabricProductionEpic is {
    user WeavingOperator wants to "to manage fabric lot production" so that "quality fabrics are manufactured efficiently"
    case ProduceFabric is {
      user WeavingOperator wants to "to weave fabric from yarn" so that "raw fabric is produced for dyeing"
      step is "Operator prepares" "warp beam with yarn" "for loom setup" with {
        briefly "Prepare warp"
        described as {
          |Set up warp beam.
        }
      }
      step take input FabricProductionApp.FabricProductionScreen.StartWarpingInput from user WeavingOperator with {
        briefly "Start warping"
        described as {
          |Begin warping process.
        }
      }
      step take input FabricProductionApp.FabricProductionScreen.StartWeavingInput from user WeavingOperator with {
        briefly "Start weaving"
        described as {
          |Begin loom weaving.
        }
      }
      step is "Operator monitors" "loom operation" "and fabric quality" with {
        briefly "Monitor weaving"
        described as {
          |Watch for defects.
        }
      }
    } with {
      briefly "Fabric weaving process"
      described as {
        |Weaving raw fabric from prepared yarn warp.
      }
    }
    case DyeFabric is {
      user DyeingTechnician wants to "to dye fabric to specification" so that "fabric achieves the correct color"
      step take input FabricProductionApp.FabricProductionScreen.StartDyeingInput from user DyeingTechnician with {
        briefly "Start dyeing"
        described as {
          |Begin dye process.
        }
      }
      step is "Technician monitors" "dye bath temperature" "and timing" with {
        briefly "Monitor dyeing"
        described as {
          |Control dye process.
        }
      }
      step take input FabricProductionApp.FabricProductionScreen.CompleteDyeingInput from user DyeingTechnician with {
        briefly "Complete dyeing"
        described as {
          |Finish dye process.
        }
      }
    } with {
      briefly "Fabric dyeing process"
      described as {
        |Applying dye to achieve specified color.
      }
    }
    case FinishFabric is {
      user FinishingOperator wants to "to apply finishing treatments" so that "fabric meets final specifications"
      step take input FabricProductionApp.FabricProductionScreen.ApplyFinishingInput from user FinishingOperator with {
        briefly "Apply finishing"
        described as {
          |Apply finishing treatment.
        }
      }
      step is "Operator verifies" "finishing results" "meet specifications" with {
        briefly "Verify finish"
        described as {
          |Check finish quality.
        }
      }
    } with {
      briefly "Fabric finishing process"
      described as {
        |Applying finishing treatments to fabric.
      }
    }
    case GradeAndShipFabric is {
      user QualityController wants to "to grade and ship fabric" so that "only quality fabric reaches customers"
      step take input FabricProductionApp.FabricProductionScreen.GradeFabricInput from user QualityController with {
        briefly "Grade fabric"
        described as {
          |Assign quality grade.
        }
      }
      step take input FabricProductionApp.FabricProductionScreen.ShipFabricInput from user QualityController with {
        briefly "Ship fabric"
        described as {
          |Release for shipping.
        }
      }
    } with {
      briefly "Fabric grading and shipping"
      described as {
        |Final inspection, grading, and shipping release.
      }
    }
  } with {
    briefly "Fabric production workflow"
    described as {
      | Epic covering the complete fabric production lifecycle
      | including weaving, dyeing, finishing, and quality grading.
    }
  }
  include "FabricContext.riddl"
  include "external-contexts.riddl"
  application context FabricProductionApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in FabricProduction are delivered.
      }
    }
    group FabricProductionScreen is {
      input GetGradingMetricsInput acquires query FabricContext.GetGradingMetrics with {
        briefly "Get grading metrics control"
        described as {
          |The control through which a user asks the get grading metrics question.
        }
      }
      input GetDyeLotMetricsInput acquires query FabricContext.GetDyeLotMetrics with {
        briefly "Get dye lot metrics control"
        described as {
          |The control through which a user asks the get dye lot metrics question.
        }
      }
      input GetLoomMetricsInput acquires query FabricContext.GetLoomMetrics with {
        briefly "Get loom metrics control"
        described as {
          |The control through which a user asks the get loom metrics question.
        }
      }
      input GetFabricLotInput acquires query FabricContext.FabricLot.GetFabricLot with {
        briefly "Get fabric lot control"
        described as {
          |The control through which a user asks the get fabric lot question.
        }
      }
      input CreateFabricLotInput acquires command FabricContext.CreateFabricLot with {
        briefly "Create fabric lot control"
        described as {
          |The control through which a user submits the create fabric lot request.
        }
      }
      input CompleteFinishingInput acquires command FabricContext.FabricLot.CompleteFinishing with {
        briefly "Complete finishing control"
        described as {
          |The control through which a user submits the complete finishing request.
        }
      }
      input CompleteWeavingInput acquires command FabricContext.FabricLot.CompleteWeaving with {
        briefly "Complete weaving control"
        described as {
          |The control through which a user submits the complete weaving request.
        }
      }
      input StartWarpingInput acquires command FabricContext.FabricLot.StartWarping with {
        briefly "Start warping control"
        described as {
          |The control through which a user submits the start warping request.
        }
      }
      input StartWeavingInput acquires command FabricContext.FabricLot.StartWeaving with {
        briefly "Start weaving control"
        described as {
          |The control through which a user submits the start weaving request.
        }
      }
      input StartDyeingInput acquires command FabricContext.FabricLot.StartDyeing with {
        briefly "Start dyeing control"
        described as {
          |The control through which a user submits the start dyeing request.
        }
      }
      input CompleteDyeingInput acquires command FabricContext.FabricLot.CompleteDyeing with {
        briefly "Complete dyeing control"
        described as {
          |The control through which a user submits the complete dyeing request.
        }
      }
      input ApplyFinishingInput acquires command FabricContext.FabricLot.ApplyFinishing with {
        briefly "Apply finishing control"
        described as {
          |The control through which a user submits the apply finishing request.
        }
      }
      input GradeFabricInput acquires command FabricContext.FabricLot.GradeFabric with {
        briefly "Grade fabric control"
        described as {
          |The control through which a user submits the grade fabric request.
        }
      }
      input ShipFabricInput acquires command FabricContext.FabricLot.ShipFabric with {
        briefly "Ship fabric control"
        described as {
          |The control through which a user submits the ship fabric request.
        }
      }
    } with {
      briefly "Fabric production screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppFabricLotRepositoryQueries is type FabricContext.FabricLotRepository.FabricLotRepositoryQuery
    inlet AppFabricLotRepositoryReplies is type FabricContext.FabricLotRepository.FabricLotRepositoryReply
    outlet AppFabricLotQueries is query FabricContext.FabricLot.GetFabricLot
    outlet AppFabricLotCommands is type FabricContext.FabricLotRequest
    inlet AppFabricLotRepositoryResponses is result FabricContext.FabricLot.FabricLotResult
    handler FabricProductionAppHandler is {
      on other is {
        error "Unexpected message for application context FabricProductionApp"
      }
    } with {
      briefly "FabricProductionApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "FabricProductionApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CustomerOrderServiceRequest Stream' is from outlet FabricContext.ToCustomerOrderService.ToCustomerOrderServiceOut to inlet CustomerOrderService.CustomerOrderServiceRequests with {
    briefly "What FabricContext asks CustomerOrderService to send"
  }
  persistent connector 'YarnInventoryRequest Stream' is from outlet FabricContext.ToYarnInventory.ToYarnInventoryOut to inlet YarnInventory.YarnInventoryRequests with {
    briefly "What FabricContext asks YarnInventory to send"
  }
  persistent connector 'DyeChemicalInventoryRequest Stream' is from outlet FabricContext.ToDyeChemicalInventory.ToDyeChemicalInventoryOut to inlet DyeChemicalInventory.DyeChemicalInventoryRequests with {
    briefly "What FabricContext asks DyeChemicalInventory to send"
  }
  persistent connector 'FabricLotRepositoryQuery Stream' is from outlet FabricProductionApp.AppFabricLotRepositoryQueries to inlet FabricContext.FabricLotRepositoryQueriesIn with {
    briefly "FabricProductionApp's look-ups of the fabric lot repository"
  }
  persistent connector 'FabricLotRepositoryReply Stream' is from outlet FabricContext.FabricLotRepositoryRepliesOut to inlet FabricProductionApp.AppFabricLotRepositoryReplies with {
    briefly "The fabric lot repository's answers returned to FabricProductionApp"
  }
  persistent connector 'FabricLotQuery Stream' is from outlet FabricProductionApp.AppFabricLotQueries to inlet FabricContext.FabricLotQueriesIn with {
    briefly "FabricProductionApp's look-ups of the fabric lot"
  }
  persistent connector 'FabricLotCommand Stream' is from outlet FabricProductionApp.AppFabricLotCommands to inlet FabricContext.FabricLotCommandStreamIn with {
    briefly "FabricLot commands from the application"
  }
  persistent connector 'FabricLotResult Stream' is from outlet FabricContext.FabricLotResultStreamOut to inlet FabricProductionApp.AppFabricLotRepositoryResponses with {
    briefly "FabricLot query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet FabricProductionApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Fabric production domain"
  described as {
    | The FabricProduction domain handles textile manufacturing
    | operations including weaving, dyeing, finishing, and
    | quality control for fabric production.
  }
}
