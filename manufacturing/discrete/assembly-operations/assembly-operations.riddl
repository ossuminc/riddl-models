// Assembly Operations Domain Model
// Manufacturing assembly line operations and quality control
domain AssemblyOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user AssemblyLineManager is "person managing assembly line operations" with {
    briefly "Assembly Line Manager"
    described as {
      | Person responsible for overseeing assembly line operations,
      | resource allocation, and production targets.
    }
  }
  user AssemblyOperator is "person performing assembly tasks" with {
    briefly "Assembly Operator"
    described as {
      | Person executing assembly steps on the production line,
      | following work instructions and building products.
    }
  }
  user QualityInspector is "person inspecting assembled products" with {
    briefly "Quality Inspector"
    described as {
      | Person responsible for quality checks, defect identification,
      | and ensuring products meet specifications.
    }
  }
  epic AssemblyLineEpic is {
    user AssemblyLineManager wants to "to manage assembly line operations" so that "products are assembled efficiently with high quality"
    case ExecuteAssemblyOrder is {
      user AssemblyOperator wants to "to complete an assembly order" so that "products are built according to specifications"
      step is "Operator receives" "assembly order assignment" "at workstation" with {
        briefly "Receive order"
        described as {
          |Get assigned assembly order.
        }
      }
      step is "Operator reviews" "work instructions and BOM" "for the product" with {
        briefly "Review instructions"
        described as {
          |Check assembly instructions.
        }
      }
      step is "Operator gathers" "required components" "from staging area" with {
        briefly "Gather components"
        described as {
          |Prepare component materials.
        }
      }
      step take input AssemblyOperationsApp.AssemblyOperationsScreen.StartAssemblyInput from user AssemblyOperator with {
        briefly "Start assembly"
        described as {
          |Begin assembly process.
        }
      }
      step is "Operator executes" "assembly steps" "per work instructions" with {
        briefly "Execute steps"
        described as {
          |Perform assembly operations.
        }
      }
      step take input AssemblyOperationsApp.AssemblyOperationsScreen.CompleteStepInput from user AssemblyOperator with {
        briefly "Complete steps"
        described as {
          |Mark steps complete.
        }
      }
    } with {
      briefly "Assembly order execution"
      described as {
        |Executing an assembly order on the production line.
      }
    }
    case QualityInspection is {
      user QualityInspector wants to "to verify assembly quality" so that "defective products are identified before shipment"
      step is "Inspector receives" "assembled unit" "for quality check" with {
        briefly "Receive unit"
        described as {
          |Get unit for inspection.
        }
      }
      step is "Inspector performs" "visual and functional checks" "per inspection plan" with {
        briefly "Perform checks"
        described as {
          |Execute quality checks.
        }
      }
      step take input AssemblyOperationsApp.AssemblyOperationsScreen.RecordDefectInput from user QualityInspector with {
        briefly "Record defects"
        described as {
          |Document any defects found.
        }
      }
      step take input AssemblyOperationsApp.AssemblyOperationsScreen.CompleteAssemblyInput from user QualityInspector with {
        briefly "Complete assembly"
        described as {
          |Finalize assembly order.
        }
      }
    } with {
      briefly "Quality inspection process"
      described as {
        |Inspecting assembled products for quality compliance.
      }
    }
  } with {
    briefly "Assembly line operations"
    described as {
      | Epic covering assembly order creation, execution,
      | quality inspection, and completion workflows.
    }
  }
  include "AssemblyContext.riddl"
  include "external-contexts.riddl"
  application context AssemblyOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AssemblyOperations are delivered.
      }
    }
    group AssemblyOperationsScreen is {
      input StartAssemblyInput acquires command AssemblyContext.AssemblyOrder.StartAssembly with {
        briefly "Start assembly control"
        described as {
          |The control through which a user submits the start assembly request.
        }
      }
      input CompleteStepInput acquires command AssemblyContext.AssemblyOrder.CompleteStep with {
        briefly "Complete step control"
        described as {
          |The control through which a user submits the complete step request.
        }
      }
      input RecordDefectInput acquires command AssemblyContext.AssemblyOrder.RecordDefect with {
        briefly "Record defect control"
        described as {
          |The control through which a user submits the record defect request.
        }
      }
      input CompleteAssemblyInput acquires command AssemblyContext.AssemblyOrder.CompleteAssembly with {
        briefly "Complete assembly control"
        described as {
          |The control through which a user submits the complete assembly request.
        }
      }
    } with {
      briefly "Assembly operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAssemblyOrderCommands is type AssemblyContext.AssemblyOrder.AssemblyOrderCommand
    inlet AppAssemblyOrderRepositoryResponses is type AssemblyContext.AssemblyOrder.AssemblyOrderResult    handler AssemblyOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context AssemblyOperationsApp"
      }
    } with {
      briefly "AssemblyOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AssemblyOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AssemblyOrderCommand Stream' is from outlet AssemblyOperationsApp.AppAssemblyOrderCommands to inlet AssemblyContext.AssemblyOrderCommandStreamIn with {
    briefly "AssemblyOrder commands from the application"
  }
  persistent connector 'Translation To Context QualityService' is from outlet AssemblyContext.TranslationToContextQualOut to inlet QualityService.QualityServiceCommands with {
    briefly "Assembly order events translated into QualityService commands"
  }
  persistent connector 'Translation To Context WorkOrderService' is from outlet AssemblyContext.TranslationToContextWorkOrdeOut to inlet WorkOrderService.WorkOrderServiceCommands with {
    briefly "Assembly order events translated into WorkOrderService commands"
  }
  persistent connector 'AssemblyOrderResult Stream' is from outlet AssemblyContext.AssemblyOrderResultStreamOut to inlet AssemblyOperationsApp.AppAssemblyOrderRepositoryResponses with {
    briefly "AssemblyOrder query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AssemblyOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Assembly operations domain"
  described as {
    | The AssemblyOperations domain handles manufacturing
    | assembly line operations, workstation management,
    | and quality control processes.
  }
}
