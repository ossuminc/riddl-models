// Assembly Operations - Assembly Context
context AssemblyContext as router is {
  outlet TranslationToContextQualOut is type QualityService.QualityCommand
  inlet TranslationToContextQualSrc is type QualityService.QualityCommand  connector 'Translation To Context QualityService Egress' is from outlet AssemblyContext.ToQualityService.TranslatedQualityCommands to inlet AssemblyContext.TranslationToContextQualSrc  inlet AssemblyOrderCommandStreamIn is type AssemblyOrderCommand  outlet AssemblyOrderCommandStreamOut is type AssemblyOrderCommand
  inlet TranslationToContextWorkOrdeIn is command WorkOrderService.ReportAssemblyComplete  outlet TranslationToContextWorkOrdeOut is command WorkOrderService.ReportAssemblyComplete
  inlet AssemblyOrderResultStreamIn is result AssemblyOrder.AssemblyOrderResult  outlet AssemblyOrderResultStreamOut is result AssemblyOrder.AssemblyOrderResult
  handler AssemblyContextBoundary is {
    on createAssemblyOrder: command AssemblyOrder.CreateAssemblyOrder is {
      send createAssemblyOrder to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on startAssembly: command AssemblyOrder.StartAssembly is {
      send startAssembly to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on completeStep: command AssemblyOrder.CompleteStep is {
      send completeStep to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on recordDefect: command AssemblyOrder.RecordDefect is {
      send recordDefect to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on completeAssembly: command AssemblyOrder.CompleteAssembly is {
      send completeAssembly to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on holdAssembly: command AssemblyOrder.HoldAssembly is {
      send holdAssembly to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on releaseHold: command AssemblyOrder.ReleaseHold is {
      send releaseHold to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on failAssembly: command AssemblyOrder.FailAssembly is {
      send failAssembly to outlet AssemblyContext.AssemblyOrderCommandStreamOut
    }
    on reportAssemblyComplete: command WorkOrderService.ReportAssemblyComplete is {
      send reportAssemblyComplete to outlet AssemblyContext.TranslationToContextWorkOrdeOut
    }
    on assemblyOrderResult: result AssemblyOrder.AssemblyOrderResult is {
      send assemblyOrderResult to outlet AssemblyContext.AssemblyOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the AssemblyContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AssemblyOrderCommand Stream Intake' is from outlet AssemblyContext.AssemblyOrderCommandStreamOut to inlet AssemblyContext.AssemblyOrder.AssemblyOrderCommands  connector 'Translation To Context WorkOrderService Egress' is from outlet AssemblyContext.ToWorkOrderService.TranslatedWorkOrderCommands to inlet AssemblyContext.TranslationToContextWorkOrdeIn  connector 'AssemblyOrderResult Stream Egress' is from outlet AssemblyContext.AssemblyOrderRepository.AssemblyOrderRepositoryResponses to inlet AssemblyContext.AssemblyOrderResultStreamIn  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on result InventoryService.ComponentAvailability is {
        do "the model receives component availability"
      }
      on event InventoryService.ComponentShortage is {
        do "the model receives component shortage"
      }
      on event InventoryService.ComponentsIssued is {
        do "the model receives components issued"
      }
      on event InventoryService.ComponentsReserved is {
        do "the model receives components reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on query InventoryService.CheckComponentAvailability is {
        do "the model sends check component availability"
      }
      on command InventoryService.IssueComponents is {
        do "the model sends issue components"
      }
      on command InventoryService.ReserveComponents is {
        do "the model sends reserve components"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromQualityService from context QualityService is { 
    handler FromQualityServiceHandler is {
      on result QualityService.DefectCodeList is {
        do "the model receives defect code list"
      }
      on event QualityService.DefectLogged is {
        do "the model receives defect logged"
      }
      on event QualityService.FailureLogged is {
        do "the model receives failure logged"
      }
      on result QualityService.InspectionPlan is {
        do "the model receives inspection plan"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityService"
      }
    } with {
      briefly "from quality service"
      described as {
        |Carries messages from the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor ToQualityService to context QualityService as flow is { 
    inlet OutgoingQualityCommands is type QualityService.QualityCommand    outlet TranslatedQualityCommands is type QualityService.QualityCommand
    handler ToQualityServiceHandler is {
      on recordDefect: command QualityService.RecordDefect is {
        send recordDefect to outlet TranslatedQualityCommands
      }
      on recordFailure: command QualityService.RecordFailure is {
        send recordFailure to outlet TranslatedQualityCommands
      }
      on query QualityService.GetDefectCodes is {
        do "the model sends get defect codes"
      }
      on query QualityService.GetInspectionPlan is {
        do "the model sends get inspection plan"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityService"
      }
    } with {
      briefly "to quality service"
      described as {
        |Carries messages to the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor FromWorkOrderService from context WorkOrderService is { 
    handler FromWorkOrderServiceHandler is {
      on event WorkOrderService.AssemblyReported is {
        do "the model receives assembly reported"
      }
      on result WorkOrderService.WorkOrderDetails is {
        do "the model receives work order details"
      }
      on other is {
        error "Unexpected message for adaptor FromWorkOrderService"
      }
    } with {
      briefly "from work order service"
      described as {
        |Carries messages from the external WorkOrderService.
      }
    }
  } with {
    briefly "WorkOrderService integration"
    described as {
      |The model's side of the WorkOrderService conversation.
    }
  }
  adaptor ToWorkOrderService to context WorkOrderService as flow is { 
    inlet OutgoingWorkOrderCommands is command WorkOrderService.ReportAssemblyComplete    outlet TranslatedWorkOrderCommands is command WorkOrderService.ReportAssemblyComplete
    handler ToWorkOrderServiceHandler is {
      on reportAssemblyComplete: command WorkOrderService.ReportAssemblyComplete is {
        send reportAssemblyComplete to outlet TranslatedWorkOrderCommands
      }
      on query WorkOrderService.GetWorkOrderDetails is {
        do "the model sends get work order details"
      }
      on command WorkOrderService.ReportAssemblyFailure is {
        do "the model sends report assembly failure"
      }
      on other is {
        error "Unexpected message for adaptor ToWorkOrderService"
      }
    } with {
      briefly "to work order service"
      described as {
        |Carries messages to the external WorkOrderService.
      }
    }
  } with {
    briefly "WorkOrderService integration"
    described as {
      |The model's side of the WorkOrderService conversation.
    }
  }
  include "types.riddl"
  include "AssemblyOrder.riddl"
  // Repository for assembly order persistence
  type AssemblyOrderRepositoryCommand is one of {
    AssemblyContext.AssemblyOrderRepository.PersistAssemblyCompleted or AssemblyContext.AssemblyOrderRepository.PersistAssemblyFailed or AssemblyContext.AssemblyOrderRepository.PersistAssemblyHeld or AssemblyContext.AssemblyOrderRepository.PersistAssemblyOrderCreated or AssemblyContext.AssemblyOrderRepository.PersistAssemblyStarted or AssemblyContext.AssemblyOrderRepository.PersistDefectRecorded or AssemblyContext.AssemblyOrderRepository.PersistHoldReleased or AssemblyContext.AssemblyOrderRepository.PersistStepCompleted
  } with {
    briefly "Anything that writes AssemblyOrderRepository"
    described as {
      |The persistence commands AssemblyOrderRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AssemblyOrderRepository as flow is {
    inlet AssemblyOrderRepositoryFromAssemblyLineAnalytics is type AssemblyOrderRepositoryCommand    command PersistAssemblyHeld is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssemblyHeld applies to.
        }
      }
    } with {
      briefly "Persist AssemblyHeld"
      described as {
        |Instructs this repository to apply AssemblyHeld to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssemblyOrderCreated is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssemblyOrderCreated applies to.
        }
      }
    } with {
      briefly "Persist AssemblyOrderCreated"
      described as {
        |Instructs this repository to apply AssemblyOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHoldReleased is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row HoldReleased applies to.
        }
      }
    } with {
      briefly "Persist HoldReleased"
      described as {
        |Instructs this repository to apply HoldReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssemblyCompleted is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssemblyCompleted applies to.
        }
      }
    } with {
      briefly "Persist AssemblyCompleted"
      described as {
        |Instructs this repository to apply AssemblyCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssemblyFailed is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssemblyFailed applies to.
        }
      }
    } with {
      briefly "Persist AssemblyFailed"
      described as {
        |Instructs this repository to apply AssemblyFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssemblyStarted is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssemblyStarted applies to.
        }
      }
    } with {
      briefly "Persist AssemblyStarted"
      described as {
        |Instructs this repository to apply AssemblyStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDefectRecorded is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row DefectRecorded applies to.
        }
      }
    } with {
      briefly "Persist DefectRecorded"
      described as {
        |Instructs this repository to apply DefectRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStepCompleted is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row StepCompleted applies to.
        }
      }
    } with {
      briefly "Persist StepCompleted"
      described as {
        |Instructs this repository to apply StepCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AssemblyOrderRepositoryResponses is result AssemblyOrder.AssemblyOrderResult
    record StoredAssemblyOrder is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "assemblyOrderId"
        described as {
          |The assemblyOrderId column of the stored assemblyOrder row.
        }
      }
      workOrderId: WorkOrderId with {
        briefly "workOrderId"
        described as {
          |The workOrderId column of the stored assemblyOrder row.
        }
      }
      workStation: WorkStationInfo with {
        briefly "workStation"
        described as {
          |The workStation column of the stored assemblyOrder row.
        }
      }
    } with {
      briefly "Stored assemblyOrder row"
      described as {
        |The persistence shape of assemblyOrder data as this repository stores it.
      }
    }
    schema AssemblyOrderData is relational
      of assemblyOrders as record StoredAssemblyOrder
        index on field StoredAssemblyOrder.assemblyOrderId
        index on field StoredAssemblyOrder.workOrderId
        index on field StoredAssemblyOrder.status
        index on field StoredAssemblyOrder.workStation.workStationId
 with {
      briefly "Assembly order data schema"
      described as {
        |The relational schema holding assembly order data for the AssemblyOrderRepository.
      }
    }
    handler AssemblyPersistence is {
      on persistAssemblyHeld: command PersistAssemblyHeld is {
        do "apply AssemblyHeld to the stored row"
      }
      on persistAssemblyOrderCreated: command PersistAssemblyOrderCreated is {
        do "apply AssemblyOrderCreated to the stored row"
      }
      on persistHoldReleased: command PersistHoldReleased is {
        do "apply HoldReleased to the stored row"
      }
      on persistAssemblyCompleted: command PersistAssemblyCompleted is {
        do "apply AssemblyCompleted to the stored row"
      }
      on persistAssemblyFailed: command PersistAssemblyFailed is {
        do "apply AssemblyFailed to the stored row"
      }
      on persistAssemblyStarted: command PersistAssemblyStarted is {
        do "apply AssemblyStarted to the stored row"
      }
      on persistDefectRecorded: command PersistDefectRecorded is {
        do "apply DefectRecorded to the stored row"
      }
      on persistStepCompleted: command PersistStepCompleted is {
        do "apply StepCompleted to the stored row"
      }
      on query GetThroughputMetrics is {
        let throughputMetricsView: type ThroughputMetricsView = prompt("read the throughput metrics projection")
        reply throughputMetricsView
      }
      on query GetFirstPassYield is {
        let firstPassYieldView: type FirstPassYieldView = prompt("read the first pass yield projection")
        reply firstPassYieldView
      }
      on query GetCycleTimeMetrics is {
        let cycleTimeMetricsView: type CycleTimeMetricsView = prompt("read the cycle time metrics projection")
        reply cycleTimeMetricsView
      }
      on query GetDefectTrend is {
        let defectTrendView: type DefectTrendView = prompt("read the defect trend projection")
        reply defectTrendView
      }
    } with {
      briefly "Persists assembly order events"
      described as {
        |Handles command-driven persistence for assembly orders.
      }
    }
  } with {
    briefly "Assembly order data persistence"
    described as {
      | The AssemblyOrderRepository provides persistent storage for
      | assembly orders, steps, quality checks, and defect records.
    }
  }
  // Projector for assembly line analytics
  query GetThroughputMetrics replies result ThroughputMetricsView is  {
    throughputMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which throughput metrics to retrieve.
      }
    }
  } with {
    briefly "Get throughput metrics"
    described as {
      |Retrieves the throughput metrics projection.
    }
  }
  result ThroughputMetricsView is  {
    throughputMetrics: AssemblyLineAnalytics.ThroughputMetrics with {
      briefly "Throughput metrics"
      described as {
        |The throughput metrics being returned.
      }
    }
  } with {
    briefly "Throughput metrics view"
    described as {
      |Read model view carrying the throughput metrics projection.
    }
  }
  query GetFirstPassYield replies result FirstPassYieldView is  {
    firstPassYieldKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which first pass yield to retrieve.
      }
    }
  } with {
    briefly "Get first pass yield"
    described as {
      |Retrieves the first pass yield projection.
    }
  }
  result FirstPassYieldView is  {
    firstPassYield: AssemblyLineAnalytics.FirstPassYield with {
      briefly "First pass yield"
      described as {
        |The first pass yield being returned.
      }
    }
  } with {
    briefly "First pass yield view"
    described as {
      |Read model view carrying the first pass yield projection.
    }
  }
  query GetCycleTimeMetrics replies result CycleTimeMetricsView is  {
    cycleTimeMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cycle time metrics to retrieve.
      }
    }
  } with {
    briefly "Get cycle time metrics"
    described as {
      |Retrieves the cycle time metrics projection.
    }
  }
  result CycleTimeMetricsView is  {
    cycleTimeMetrics: AssemblyLineAnalytics.CycleTimeMetrics with {
      briefly "Cycle time metrics"
      described as {
        |The cycle time metrics being returned.
      }
    }
  } with {
    briefly "Cycle time metrics view"
    described as {
      |Read model view carrying the cycle time metrics projection.
    }
  }
  query GetDefectTrend replies result DefectTrendView is  {
    defectTrendKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which defect trend to retrieve.
      }
    }
  } with {
    briefly "Get defect trend"
    described as {
      |Retrieves the defect trend projection.
    }
  }
  result DefectTrendView is  {
    defectTrend: AssemblyLineAnalytics.DefectTrend with {
      briefly "Defect trend"
      described as {
        |The defect trend being returned.
      }
    }
  } with {
    briefly "Defect trend view"
    described as {
      |Read model view carrying the defect trend projection.
    }
  }
  projector AssemblyLineAnalytics as flow is {
    updates repository AssemblyContext.AssemblyOrderRepository
    outlet AssemblyLineAnalyticsToRepository is type AssemblyOrderRepositoryCommand
    inlet AssemblyLineAnalyticsFromAssemblyOrder is type AssemblyOrderEvent    record ThroughputMetrics is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      unitsStarted: Natural with {
        briefly "Started"
        described as {
          |Units started.
        }
      }
      unitsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Units completed.
        }
      }
      unitsFailed: Natural with {
        briefly "Failed"
        described as {
          |Units failed.
        }
      }
      unitsPerHour: Decimal(8,2) with {
        briefly "UPH"
        described as {
          |Units per hour.
        }
      }
    } with {
      briefly "Throughput metrics"
      described as {
        |Assembly line throughput statistics.
      }
    }
    record FirstPassYield is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      totalUnits: Natural with {
        briefly "Total"
        described as {
          |Total units inspected.
        }
      }
      passedFirst: Natural with {
        briefly "Passed"
        described as {
          |Passed first inspection.
        }
      }
      yieldRate: Decimal(5,4) with {
        briefly "FPY"
        described as {
          |First pass yield rate.
        }
      }
    } with {
      briefly "First pass yield"
      described as {
        |Quality metrics for first-time pass rate.
      }
    }
    record CycleTimeMetrics is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      productId: ProductId with {
        briefly "Product"
        described as {
          |Product ID.
        }
      }
      averageCycleTime: Natural with {
        briefly "Avg cycle"
        described as {
          |Average cycle time (minutes).
        }
      }
      minCycleTime: Natural with {
        briefly "Min cycle"
        described as {
          |Minimum cycle time (minutes).
        }
      }
      maxCycleTime: Natural with {
        briefly "Max cycle"
        described as {
          |Maximum cycle time (minutes).
        }
      }
      standardDeviation: Decimal(8,2) with {
        briefly "Std dev"
        described as {
          |Standard deviation.
        }
      }
    } with {
      briefly "Cycle time metrics"
      described as {
        |Assembly cycle time statistics.
      }
    }
    record DefectTrend is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      defectCode: String(1,50) with {
        briefly "Code"
        described as {
          |Defect code.
        }
      }
      occurrences: Natural with {
        briefly "Count"
        described as {
          |Number of occurrences.
        }
      }
      percentOfTotal: Decimal(5,4) with {
        briefly "Percent"
        described as {
          |Percent of total defects.
        }
      }
    } with {
      briefly "Defect trend"
      described as {
        |Defect occurrence trends by code.
      }
    }
    handler AnalyticsHandler is {
      on assemblyHeld: event AssemblyOrder.AssemblyHeld is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistAssemblyHeld(assemblyOrderId = assemblyHeld.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
        do "apply AssemblyHeld to the AssemblyLineAnalytics projection"
      }
      on assemblyOrderCreated: event AssemblyOrder.AssemblyOrderCreated is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistAssemblyOrderCreated(assemblyOrderId = assemblyOrderCreated.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
        do "apply AssemblyOrderCreated to the AssemblyLineAnalytics projection"
      }
      on holdReleased: event AssemblyOrder.HoldReleased is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistHoldReleased(assemblyOrderId = holdReleased.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
        do "apply HoldReleased to the AssemblyLineAnalytics projection"
      }
      on assemblyStarted: event AssemblyOrder.AssemblyStarted is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistAssemblyStarted(assemblyOrderId = assemblyStarted.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
      }
      on assemblyCompleted: event AssemblyOrder.AssemblyCompleted is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistAssemblyCompleted(assemblyOrderId = assemblyCompleted.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
      }
      on assemblyFailed: event AssemblyOrder.AssemblyFailed is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistAssemblyFailed(assemblyOrderId = assemblyFailed.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
      }
      on stepCompleted: event AssemblyOrder.StepCompleted is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistStepCompleted(assemblyOrderId = stepCompleted.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
      }
      on defectRecorded: event AssemblyOrder.DefectRecorded is {
        tell command AssemblyContext.AssemblyOrderRepository.PersistDefectRecorded(assemblyOrderId = defectRecorded.assemblyOrderId) to repository AssemblyContext.AssemblyOrderRepository
      }
    } with {
      briefly "Maintains assembly analytics"
      described as {
        |Projects events into analytics views for line performance.
      }
    }
  } with {
    briefly "Assembly line analytics projections"
    described as {
      | Maintains assembly line analytics including throughput,
      | first-pass yield, cycle time, and defect trends.
    }
  }
  type AssemblyOrderEvent is one of {
    AssemblyContext.AssemblyOrder.AssemblyOrderCreated or AssemblyContext.AssemblyOrder.AssemblyCompleted or AssemblyContext.AssemblyOrder.AssemblyFailed or AssemblyContext.AssemblyOrder.AssemblyHeld or AssemblyContext.AssemblyOrder.AssemblyStarted or AssemblyContext.AssemblyOrder.DefectRecorded or AssemblyContext.AssemblyOrder.HoldReleased or AssemblyContext.AssemblyOrder.StepCompleted
  } with {
    briefly "AssemblyOrder event union"
    described as {
      |Union of AssemblyOrder events for streaming.
    }
  }
  processor AssemblyOrderEventSplit as flow is {
    inlet AssemblyOrderEventSplitIn is type AssemblyOrderEvent    outlet AssemblyOrderEventSplitToAssemblyLineAnalytics is type AssemblyOrderEvent
    handler AssemblyOrderEventSplitHandler is {
      on assemblyOrderCreated: event AssemblyOrder.AssemblyOrderCreated is {
        send assemblyOrderCreated to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyOrderCreated to entity AssemblyContext.AssemblyOrder
      }
      on assemblyStarted: event AssemblyOrder.AssemblyStarted is {
        send assemblyStarted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyStarted to entity AssemblyContext.AssemblyOrder
      }
      on stepCompleted: event AssemblyOrder.StepCompleted is {
        send stepCompleted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell stepCompleted to entity AssemblyContext.AssemblyOrder
      }
      on defectRecorded: event AssemblyOrder.DefectRecorded is {
        send defectRecorded to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell defectRecorded to entity AssemblyContext.AssemblyOrder
      }
      on assemblyCompleted: event AssemblyOrder.AssemblyCompleted is {
        send assemblyCompleted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyCompleted to entity AssemblyContext.AssemblyOrder
      }
      on assemblyHeld: event AssemblyOrder.AssemblyHeld is {
        send assemblyHeld to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyHeld to entity AssemblyContext.AssemblyOrder
      }
      on holdReleased: event AssemblyOrder.HoldReleased is {
        send holdReleased to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell holdReleased to entity AssemblyContext.AssemblyOrder
      }
      on assemblyFailed: event AssemblyOrder.AssemblyFailed is {
        send assemblyFailed to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyFailed to entity AssemblyContext.AssemblyOrder
      }
      on other is {
        error "Unexpected message for processor AssemblyOrderEventSplit"
      }
    } with {
      briefly "AssemblyOrder event fan-out handler"
      described as {
        |Delivers each AssemblyOrder event to all of its consumers.
      }
    }
  } with {
    briefly "AssemblyOrder event fan-out"
    described as {
      |Fans AssemblyOrder events out to the repository and projectors.
    }
  }
  connector 'AssemblyOrderEvent Stream' is from outlet AssemblyContext.AssemblyOrder.AssemblyOrderEvents2 to inlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitIn with {
    briefly "AssemblyOrder events, fanned out to storage and read models"
  }
  connector 'AssemblyLineAnalytics Feed' is from outlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitToAssemblyLineAnalytics to inlet AssemblyContext.AssemblyLineAnalytics.AssemblyLineAnalyticsFromAssemblyOrder with {
    briefly "AssemblyOrder events feeding the AssemblyLineAnalytics projection"
  }
  connector 'QualityCommand Stream' is from outlet AssemblyContext.AssemblyOrder.AssemblyOrderToQuality to inlet AssemblyContext.ToQualityService.OutgoingQualityCommands with {
    briefly "Quality commands from the assembly order to its adaptor"
  }
  connector 'ReportAssemblyComplete Stream' is from outlet AssemblyContext.AssemblyOrder.AssemblyOrderToWorkOrder to inlet AssemblyContext.ToWorkOrderService.OutgoingWorkOrderCommands with {
    briefly "Assembly completion reports from the assembly order to its adaptor"
  }
  connector 'AssemblyLineAnalytics Storage' is from outlet AssemblyContext.AssemblyLineAnalytics.AssemblyLineAnalyticsToRepository to inlet AssemblyContext.AssemblyOrderRepository.AssemblyOrderRepositoryFromAssemblyLineAnalytics with {
    briefly "AssemblyLineAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for assembly operations"
  described as {
    | The AssemblyContext is the bounded context for
    | manufacturing assembly line operations, tracking
    | assembly orders, steps, quality, and performance.
  }
}
