// Assembly Operations - Assembly Context
context AssemblyContext is {
  include "types.riddl"
  include "AssemblyOrder.riddl"
  // Repository for assembly order persistence
  repository AssemblyOrderRepository is {
    inlet AssemblyOrderRepositoryFromAssemblyOrder is type AssemblyOrderEvent
    inlet AssemblyOrderRepositoryFromAssemblyLineAnalytics is type AssemblyOrderEvent
    outlet AssemblyOrderRepositoryResponses is type AssemblyOrder.AssemblyOrderResult
    schema AssemblyOrderData is relational
      of assemblyOrders as type AssemblyOrder
        index on field AssemblyOrder.assemblyOrderId
        index on field AssemblyOrder.workOrderId
        index on field AssemblyOrder.status
        index on field AssemblyOrder.workStation.workStationId
      with {
      briefly "Assembly order data schema"
      described as {
        |The relational schema holding assembly order data for the AssemblyOrderRepository.
      }
    }

    handler AssemblyPersistence is {
      on command AssemblyOrder.CreateAssemblyOrder is {
        tell event AssemblyOrder.AssemblyOrderCreated to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.StartAssembly is {
        tell event AssemblyOrder.AssemblyStarted to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.CompleteStep is {
        tell event AssemblyOrder.StepCompleted to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.RecordDefect is {
        tell event AssemblyOrder.DefectRecorded to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.CompleteAssembly is {
        tell event AssemblyOrder.AssemblyCompleted to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.HoldAssembly is {
        tell event AssemblyOrder.AssemblyHeld to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.ReleaseHold is {
        tell event AssemblyOrder.HoldReleased to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.FailAssembly is {
        tell event AssemblyOrder.AssemblyFailed to entity AssemblyContext.AssemblyOrder
      }
    } with {
      briefly "Persists assembly order events"
      described as {
        |Handles command-driven persistence for assembly orders.
      }
    }
  } with {
    briefly "Assembly order data persistence"
    described as {
      | The AssemblyOrderRepository provides persistent storage for
      | assembly orders, steps, quality checks, and defect records.
    }
  }
  // Projector for assembly line analytics
  projector AssemblyLineAnalytics is {
    inlet AssemblyLineAnalyticsFromAssemblyOrder is type AssemblyOrderEvent
    outlet AssemblyLineAnalyticsOut is type AssemblyOrderEvent
    updates repository AssemblyContext.AssemblyOrderRepository
    record ThroughputMetrics is  {
      date: Date with { briefly "Date" described as { |Metrics date.
        }
      }
      workStationId: WorkStationId with { briefly "Station" described as { |Work station.
        }
      }
      unitsStarted: Natural with { briefly "Started" described as { |Units started.
        }
      }
      unitsCompleted: Natural with { briefly "Completed" described as { |Units completed.
        }
      }
      unitsFailed: Natural with { briefly "Failed" described as { |Units failed.
        }
      }
      unitsPerHour: Decimal(8,2) with { briefly "UPH" described as { |Units per hour.
        }
      }
    } with {
      briefly "Throughput metrics"
      described as {
        |Assembly line throughput statistics.
      }
    }
    record FirstPassYield is  {
      date: Date with { briefly "Date" described as { |Metrics date.
        }
      }
      workStationId: WorkStationId with { briefly "Station" described as { |Work station.
        }
      }
      totalUnits: Natural with { briefly "Total" described as { |Total units inspected.
        }
      }
      passedFirst: Natural with { briefly "Passed" described as { |Passed first inspection.
        }
      }
      yieldRate: Decimal(5,4) with { briefly "FPY" described as { |First pass yield rate.
        }
      }
    } with {
      briefly "First pass yield"
      described as {
        |Quality metrics for first-time pass rate.
      }
    }
    record CycleTimeMetrics is  {
      date: Date with { briefly "Date" described as { |Metrics date.
        }
      }
      workStationId: WorkStationId with { briefly "Station" described as { |Work station.
        }
      }
      productId: ProductId with { briefly "Product" described as { |Product ID.
        }
      }
      averageCycleTime: Natural with { briefly "Avg cycle" described as { |Average cycle time (minutes).
        }
      }
      minCycleTime: Natural with { briefly "Min cycle" described as { |Minimum cycle time (minutes).
        }
      }
      maxCycleTime: Natural with { briefly "Max cycle" described as { |Maximum cycle time (minutes).
        }
      }
      standardDeviation: Decimal(8,2) with { briefly "Std dev" described as { |Standard deviation.
        }
      }
    } with {
      briefly "Cycle time metrics"
      described as {
        |Assembly cycle time statistics.
      }
    }
    record DefectTrend is  {
      date: Date with { briefly "Date" described as { |Metrics date.
        }
      }
      workStationId: WorkStationId with { briefly "Station" described as { |Work station.
        }
      }
      defectCode: String(1,50) with { briefly "Code" described as { |Defect code.
        }
      }
      occurrences: Natural with { briefly "Count" described as { |Number of occurrences.
        }
      }
      percentOfTotal: Decimal(5,4) with { briefly "Percent" described as { |Percent of total defects.
        }
      }
    } with {
      briefly "Defect trend"
      described as {
        |Defect occurrence trends by code.
      }
    }
    handler AnalyticsHandler is {
      on event AssemblyOrder.AssemblyStarted is {
        tell event AssemblyOrder.AssemblyStarted to repository AssemblyContext.AssemblyOrderRepository
      }
      on event AssemblyOrder.AssemblyCompleted is {
        tell event AssemblyOrder.AssemblyCompleted to repository AssemblyContext.AssemblyOrderRepository
      }
      on event AssemblyOrder.AssemblyFailed is {
        tell event AssemblyOrder.AssemblyFailed to repository AssemblyContext.AssemblyOrderRepository
      }
      on event AssemblyOrder.StepCompleted is {
        tell event AssemblyOrder.StepCompleted to repository AssemblyContext.AssemblyOrderRepository
      }
      on event AssemblyOrder.DefectRecorded is {
        tell event AssemblyOrder.DefectRecorded to repository AssemblyContext.AssemblyOrderRepository
      }
    } with {
      briefly "Maintains assembly analytics"
      described as {
        |Projects events into analytics views for line performance.
      }
    }
  } with {
    briefly "Assembly line analytics projections"
    described as {
      | Maintains assembly line analytics including throughput,
      | first-pass yield, cycle time, and defect trends.
    }
  }
  type AssemblyOrderEvent is one of {
    AssemblyContext.AssemblyOrder.AssemblyOrderCreated,
    AssemblyContext.AssemblyOrder.AssemblyCompleted,
    AssemblyContext.AssemblyOrder.AssemblyFailed
  } with {
    briefly "AssemblyOrder event union"
    described as {
      |Union of AssemblyOrder events for streaming.
    }
  }
  processor AssemblyOrderEventSource as source is {
    outlet AssemblyOrderEvents is type AssemblyOrderEvent
    handler AssemblyOrderEventEmitter is {
      on init is { tell command AssemblyOrder.InitializeAssemblyOrder to entity AssemblyContext.AssemblyOrder }
      on other is {
        error "Unexpected message for source AssemblyOrderEventSource"
      }
      on event AssemblyOrder.AssemblyOrderCreated is {
        send event AssemblyOrder.AssemblyOrderCreated to outlet AssemblyOrderEvents
      }
      on event AssemblyOrder.AssemblyCompleted is {
        send event AssemblyOrder.AssemblyCompleted to outlet AssemblyOrderEvents
      }
      on event AssemblyOrder.AssemblyFailed is {
        send event AssemblyOrder.AssemblyFailed to outlet AssemblyOrderEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits AssemblyOrder events to the stream.
      }
    }
  } with {
    briefly "AssemblyOrder event source"
    described as {
      |Publishes AssemblyOrder events to the event stream.
    }
  }
  processor AssemblyOrderEventSink as sink is {
    inlet IncomingAssemblyOrderEvents is type AssemblyOrderEvent
    handler AssemblyOrderEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink AssemblyOrderEventSink"
      }
      on event AssemblyOrder.AssemblyOrderCreated is {
        tell event AssemblyOrder.AssemblyOrderCreated to repository AssemblyContext.AssemblyOrderRepository
      }
      on event AssemblyOrder.AssemblyCompleted is {
        tell event AssemblyOrder.AssemblyCompleted to repository AssemblyContext.AssemblyOrderRepository
      }
      on event AssemblyOrder.AssemblyFailed is {
        tell event AssemblyOrder.AssemblyFailed to repository AssemblyContext.AssemblyOrderRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives AssemblyOrder events for persistence.
      }
    }
  } with {
    briefly "AssemblyOrder event sink"
    described as {
      |Receives AssemblyOrder events from streaming.
    }
  }
  connector AssemblyOrderEventPipeline is {
    from outlet AssemblyContext.AssemblyOrderEventSource.AssemblyOrderEvents to inlet AssemblyContext.AssemblyOrderEventSink.IncomingAssemblyOrderEvents
  } with {
    briefly "AssemblyOrder event pipeline"
    described as {
      |Wires AssemblyOrder event source to sink.
    }
  }
  processor AssemblyOrderEventSplit is {
    inlet AssemblyOrderEventSplitIn is type AssemblyOrderEvent
    outlet AssemblyOrderEventSplitToAssemblyOrderRepository is type AssemblyOrderEvent
    outlet AssemblyOrderEventSplitToAssemblyLineAnalytics is type AssemblyOrderEvent
    handler AssemblyOrderEventSplitHandler is {
      on event AssemblyOrder.AssemblyOrderCreated is {
        send event AssemblyOrder.AssemblyOrderCreated to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.AssemblyOrderCreated to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.AssemblyOrderCreated to entity AssemblyContext.AssemblyOrder
      }
      on event AssemblyOrder.AssemblyStarted is {
        send event AssemblyOrder.AssemblyStarted to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.AssemblyStarted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.AssemblyStarted to entity AssemblyContext.AssemblyOrder
      }
      on event AssemblyOrder.StepCompleted is {
        send event AssemblyOrder.StepCompleted to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.StepCompleted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.StepCompleted to entity AssemblyContext.AssemblyOrder
      }
      on event AssemblyOrder.DefectRecorded is {
        send event AssemblyOrder.DefectRecorded to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.DefectRecorded to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.DefectRecorded to entity AssemblyContext.AssemblyOrder
      }
      on event AssemblyOrder.AssemblyCompleted is {
        send event AssemblyOrder.AssemblyCompleted to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.AssemblyCompleted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.AssemblyCompleted to entity AssemblyContext.AssemblyOrder
      }
      on event AssemblyOrder.AssemblyHeld is {
        send event AssemblyOrder.AssemblyHeld to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.AssemblyHeld to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.AssemblyHeld to entity AssemblyContext.AssemblyOrder
      }
      on event AssemblyOrder.HoldReleased is {
        send event AssemblyOrder.HoldReleased to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.HoldReleased to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.HoldReleased to entity AssemblyContext.AssemblyOrder
      }
      on event AssemblyOrder.AssemblyFailed is {
        send event AssemblyOrder.AssemblyFailed to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send event AssemblyOrder.AssemblyFailed to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell event AssemblyOrder.AssemblyFailed to entity AssemblyContext.AssemblyOrder
      }
      on other is {
        error "Unexpected message for processor AssemblyOrderEventSplit"
      }
    } with {
      briefly "AssemblyOrder event fan-out handler"
      described as {
        |Delivers each AssemblyOrder event to all of its consumers.
      }
    }
  } with {
    briefly "AssemblyOrder event fan-out"
    described as {
      |Fans AssemblyOrder events out to the repository and projectors.
    }
  }
  connector LinkAssemblyOrderToAssemblyOrderEventSplit is {
    from outlet AssemblyContext.AssemblyOrder.AssemblyOrderEvents2 to
      inlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitIn
  } with {
    briefly "LinkAssemblyOrderToAssemblyOrderEventSplit"
  }
  connector LinkAssemblyOrderEventSplitToAssemblyOrderRepository is {
    from outlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitToAssemblyOrderRepository to
      inlet AssemblyContext.AssemblyOrderRepository.AssemblyOrderRepositoryFromAssemblyOrder
  } with {
    briefly "LinkAssemblyOrderEventSplitToAssemblyOrderRepository"
  }
  connector LinkAssemblyOrderEventSplitToAssemblyLineAnalytics is {
    from outlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitToAssemblyLineAnalytics to
      inlet AssemblyContext.AssemblyLineAnalytics.AssemblyLineAnalyticsFromAssemblyOrder
  } with {
    briefly "LinkAssemblyOrderEventSplitToAssemblyLineAnalytics"
  }
  connector LinkAssemblyLineAnalyticsToAssemblyOrderRepository is {
    from outlet AssemblyContext.AssemblyLineAnalytics.AssemblyLineAnalyticsOut to
      inlet AssemblyContext.AssemblyOrderRepository.AssemblyOrderRepositoryFromAssemblyLineAnalytics
  } with {
    briefly "LinkAssemblyLineAnalyticsToAssemblyOrderRepository"
  }
} with {
  briefly "Bounded context for assembly operations"
  described as {
    | The AssemblyContext is the bounded context for
    | manufacturing assembly line operations, tracking
    | assembly orders, steps, quality, and performance.
  }
}
