// Assembly Operations - Assembly Context
context AssemblyContext is {
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on result InventoryService.ComponentAvailability is {
        do "the model receives component availability"
      }
      on event InventoryService.ComponentShortage is {
        do "the model receives component shortage"
      }
      on event InventoryService.ComponentsIssued is {
        do "the model receives components issued"
      }
      on event InventoryService.ComponentsReserved is {
        do "the model receives components reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on query InventoryService.CheckComponentAvailability is {
        do "the model sends check component availability"
      }
      on command InventoryService.IssueComponents is {
        do "the model sends issue components"
      }
      on command InventoryService.ReserveComponents is {
        do "the model sends reserve components"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromQualityService from context QualityService is { 
    handler FromQualityServiceHandler is {
      on result QualityService.DefectCodeList is {
        do "the model receives defect code list"
      }
      on event QualityService.DefectLogged is {
        do "the model receives defect logged"
      }
      on event QualityService.FailureLogged is {
        do "the model receives failure logged"
      }
      on result QualityService.InspectionPlan is {
        do "the model receives inspection plan"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityService"
      }
    } with {
      briefly "from quality service"
      described as {
        |Carries messages from the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor ToQualityService to context QualityService as flow is { 
    inlet OutgoingQualityCommands is type QualityService.QualityCommand    outlet TranslatedQualityCommands is type QualityService.QualityCommand
    handler ToQualityServiceHandler is {
      on recordDefect: command QualityService.RecordDefect is {
        send recordDefect to outlet TranslatedQualityCommands
      }
      on recordFailure: command QualityService.RecordFailure is {
        send recordFailure to outlet TranslatedQualityCommands
      }
      on query QualityService.GetDefectCodes is {
        do "the model sends get defect codes"
      }
      on query QualityService.GetInspectionPlan is {
        do "the model sends get inspection plan"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityService"
      }
    } with {
      briefly "to quality service"
      described as {
        |Carries messages to the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor FromWorkOrderService from context WorkOrderService is { 
    handler FromWorkOrderServiceHandler is {
      on event WorkOrderService.AssemblyReported is {
        do "the model receives assembly reported"
      }
      on result WorkOrderService.WorkOrderDetails is {
        do "the model receives work order details"
      }
      on other is {
        error "Unexpected message for adaptor FromWorkOrderService"
      }
    } with {
      briefly "from work order service"
      described as {
        |Carries messages from the external WorkOrderService.
      }
    }
  } with {
    briefly "WorkOrderService integration"
    described as {
      |The model's side of the WorkOrderService conversation.
    }
  }
  adaptor ToWorkOrderService to context WorkOrderService as flow is { 
    inlet OutgoingWorkOrderCommands is type WorkOrderService.ReportAssemblyComplete    outlet TranslatedWorkOrderCommands is type WorkOrderService.ReportAssemblyComplete
    handler ToWorkOrderServiceHandler is {
      on reportAssemblyComplete: command WorkOrderService.ReportAssemblyComplete is {
        send reportAssemblyComplete to outlet TranslatedWorkOrderCommands
      }
      on query WorkOrderService.GetWorkOrderDetails is {
        do "the model sends get work order details"
      }
      on command WorkOrderService.ReportAssemblyFailure is {
        do "the model sends report assembly failure"
      }
      on other is {
        error "Unexpected message for adaptor ToWorkOrderService"
      }
    } with {
      briefly "to work order service"
      described as {
        |Carries messages to the external WorkOrderService.
      }
    }
  } with {
    briefly "WorkOrderService integration"
    described as {
      |The model's side of the WorkOrderService conversation.
    }
  }
  include "types.riddl"
  include "AssemblyOrder.riddl"
  // Repository for assembly order persistence
  repository AssemblyOrderRepository as merge is {
    inlet AssemblyOrderRepositoryFromAssemblyOrder is type AssemblyOrderEvent    inlet AssemblyOrderRepositoryFromAssemblyLineAnalytics is type AssemblyOrderEvent    outlet AssemblyOrderRepositoryResponses is type AssemblyOrder.AssemblyOrderResult
    record StoredAssemblyOrder is  {
      assemblyOrderId: AssemblyOrderId with {
        briefly "assemblyOrderId"
        described as {
          |The assemblyOrderId column of the stored assemblyOrder row.
        }
      }
      workOrderId: WorkOrderId with {
        briefly "workOrderId"
        described as {
          |The workOrderId column of the stored assemblyOrder row.
        }
      }
      workStation: WorkStationInfo with {
        briefly "workStation"
        described as {
          |The workStation column of the stored assemblyOrder row.
        }
      }
    } with {
      briefly "Stored assemblyOrder row"
      described as {
        |The persistence shape of assemblyOrder data as this repository stores it.
      }
    }
    schema AssemblyOrderData is relational
      of assemblyOrders as type StoredAssemblyOrder
        index on field StoredAssemblyOrder.assemblyOrderId
        index on field StoredAssemblyOrder.workOrderId
        index on field StoredAssemblyOrder.status
        index on field StoredAssemblyOrder.workStation.workStationId
 with {
      briefly "Assembly order data schema"
      described as {
        |The relational schema holding assembly order data for the AssemblyOrderRepository.
      }
    }
    handler AssemblyPersistence is {
      on query GetThroughputMetrics is {
        do "read the throughput metrics projection"
        reply result ThroughputMetricsView
      }
      on query GetFirstPassYield is {
        do "read the first pass yield projection"
        reply result FirstPassYieldView
      }
      on query GetCycleTimeMetrics is {
        do "read the cycle time metrics projection"
        reply result CycleTimeMetricsView
      }
      on query GetDefectTrend is {
        do "read the defect trend projection"
        reply result DefectTrendView
      }
      on command AssemblyOrder.CreateAssemblyOrder is {
        tell event AssemblyOrder.AssemblyOrderCreated to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.StartAssembly is {
        tell event AssemblyOrder.AssemblyStarted to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.CompleteStep is {
        tell event AssemblyOrder.StepCompleted to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.RecordDefect is {
        tell event AssemblyOrder.DefectRecorded to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.CompleteAssembly is {
        tell event AssemblyOrder.AssemblyCompleted to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.HoldAssembly is {
        tell event AssemblyOrder.AssemblyHeld to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.ReleaseHold is {
        tell event AssemblyOrder.HoldReleased to entity AssemblyContext.AssemblyOrder
      }
      on command AssemblyOrder.FailAssembly is {
        tell event AssemblyOrder.AssemblyFailed to entity AssemblyContext.AssemblyOrder
      }
    } with {
      briefly "Persists assembly order events"
      described as {
        |Handles command-driven persistence for assembly orders.
      }
    }
  } with {
    briefly "Assembly order data persistence"
    described as {
      | The AssemblyOrderRepository provides persistent storage for
      | assembly orders, steps, quality checks, and defect records.
    }
  }
  // Projector for assembly line analytics
  query GetThroughputMetrics is  {
    throughputMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which throughput metrics to retrieve.
      }
    }
  } with {
    briefly "Get throughput metrics"
    described as {
      |Retrieves the throughput metrics projection.
    }
  }
  result ThroughputMetricsView is  {
    throughputMetrics: AssemblyLineAnalytics.ThroughputMetrics with {
      briefly "Throughput metrics"
      described as {
        |The throughput metrics being returned.
      }
    }
  } with {
    briefly "Throughput metrics view"
    described as {
      |Read model view carrying the throughput metrics projection.
    }
  }
  query GetFirstPassYield is  {
    firstPassYieldKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which first pass yield to retrieve.
      }
    }
  } with {
    briefly "Get first pass yield"
    described as {
      |Retrieves the first pass yield projection.
    }
  }
  result FirstPassYieldView is  {
    firstPassYield: AssemblyLineAnalytics.FirstPassYield with {
      briefly "First pass yield"
      described as {
        |The first pass yield being returned.
      }
    }
  } with {
    briefly "First pass yield view"
    described as {
      |Read model view carrying the first pass yield projection.
    }
  }
  query GetCycleTimeMetrics is  {
    cycleTimeMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cycle time metrics to retrieve.
      }
    }
  } with {
    briefly "Get cycle time metrics"
    described as {
      |Retrieves the cycle time metrics projection.
    }
  }
  result CycleTimeMetricsView is  {
    cycleTimeMetrics: AssemblyLineAnalytics.CycleTimeMetrics with {
      briefly "Cycle time metrics"
      described as {
        |The cycle time metrics being returned.
      }
    }
  } with {
    briefly "Cycle time metrics view"
    described as {
      |Read model view carrying the cycle time metrics projection.
    }
  }
  query GetDefectTrend is  {
    defectTrendKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which defect trend to retrieve.
      }
    }
  } with {
    briefly "Get defect trend"
    described as {
      |Retrieves the defect trend projection.
    }
  }
  result DefectTrendView is  {
    defectTrend: AssemblyLineAnalytics.DefectTrend with {
      briefly "Defect trend"
      described as {
        |The defect trend being returned.
      }
    }
  } with {
    briefly "Defect trend view"
    described as {
      |Read model view carrying the defect trend projection.
    }
  }
  projector AssemblyLineAnalytics as flow is {
    updates repository AssemblyContext.AssemblyOrderRepository
    inlet AssemblyLineAnalyticsFromAssemblyOrder is type AssemblyOrderEvent    outlet AssemblyLineAnalyticsOut is type AssemblyOrderEvent
    record ThroughputMetrics is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      unitsStarted: Natural with {
        briefly "Started"
        described as {
          |Units started.
        }
      }
      unitsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Units completed.
        }
      }
      unitsFailed: Natural with {
        briefly "Failed"
        described as {
          |Units failed.
        }
      }
      unitsPerHour: Decimal(8,2) with {
        briefly "UPH"
        described as {
          |Units per hour.
        }
      }
    } with {
      briefly "Throughput metrics"
      described as {
        |Assembly line throughput statistics.
      }
    }
    record FirstPassYield is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      totalUnits: Natural with {
        briefly "Total"
        described as {
          |Total units inspected.
        }
      }
      passedFirst: Natural with {
        briefly "Passed"
        described as {
          |Passed first inspection.
        }
      }
      yieldRate: Decimal(5,4) with {
        briefly "FPY"
        described as {
          |First pass yield rate.
        }
      }
    } with {
      briefly "First pass yield"
      described as {
        |Quality metrics for first-time pass rate.
      }
    }
    record CycleTimeMetrics is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      productId: ProductId with {
        briefly "Product"
        described as {
          |Product ID.
        }
      }
      averageCycleTime: Natural with {
        briefly "Avg cycle"
        described as {
          |Average cycle time (minutes).
        }
      }
      minCycleTime: Natural with {
        briefly "Min cycle"
        described as {
          |Minimum cycle time (minutes).
        }
      }
      maxCycleTime: Natural with {
        briefly "Max cycle"
        described as {
          |Maximum cycle time (minutes).
        }
      }
      standardDeviation: Decimal(8,2) with {
        briefly "Std dev"
        described as {
          |Standard deviation.
        }
      }
    } with {
      briefly "Cycle time metrics"
      described as {
        |Assembly cycle time statistics.
      }
    }
    record DefectTrend is  {
      date: Date with {
        briefly "Date"
        described as {
          |Metrics date.
        }
      }
      workStationId: WorkStationId with {
        briefly "Station"
        described as {
          |Work station.
        }
      }
      defectCode: String(1,50) with {
        briefly "Code"
        described as {
          |Defect code.
        }
      }
      occurrences: Natural with {
        briefly "Count"
        described as {
          |Number of occurrences.
        }
      }
      percentOfTotal: Decimal(5,4) with {
        briefly "Percent"
        described as {
          |Percent of total defects.
        }
      }
    } with {
      briefly "Defect trend"
      described as {
        |Defect occurrence trends by code.
      }
    }
    handler AnalyticsHandler is {
      on assemblyStarted: event AssemblyOrder.AssemblyStarted is {
        tell assemblyStarted to repository AssemblyContext.AssemblyOrderRepository
      }
      on assemblyCompleted: event AssemblyOrder.AssemblyCompleted is {
        tell assemblyCompleted to repository AssemblyContext.AssemblyOrderRepository
      }
      on assemblyFailed: event AssemblyOrder.AssemblyFailed is {
        tell assemblyFailed to repository AssemblyContext.AssemblyOrderRepository
      }
      on stepCompleted: event AssemblyOrder.StepCompleted is {
        tell stepCompleted to repository AssemblyContext.AssemblyOrderRepository
      }
      on defectRecorded: event AssemblyOrder.DefectRecorded is {
        tell defectRecorded to repository AssemblyContext.AssemblyOrderRepository
      }
    } with {
      briefly "Maintains assembly analytics"
      described as {
        |Projects events into analytics views for line performance.
      }
    }
  } with {
    briefly "Assembly line analytics projections"
    described as {
      | Maintains assembly line analytics including throughput,
      | first-pass yield, cycle time, and defect trends.
    }
  }
  type AssemblyOrderEvent is one of {
    AssemblyContext.AssemblyOrder.AssemblyOrderCreated or AssemblyContext.AssemblyOrder.AssemblyCompleted or AssemblyContext.AssemblyOrder.AssemblyFailed
  } with {
    briefly "AssemblyOrder event union"
    described as {
      |Union of AssemblyOrder events for streaming.
    }
  }
  processor AssemblyOrderEventSource as source is {
    outlet AssemblyOrderEvents is type AssemblyOrderEvent
    handler AssemblyOrderEventEmitter is {
      on init is {
        tell command AssemblyOrder.InitializeAssemblyOrder to entity AssemblyContext.AssemblyOrder
      }
      on other is {
        error "Unexpected message for source AssemblyOrderEventSource"
      }
      on assemblyOrderCreated: event AssemblyOrder.AssemblyOrderCreated is {
        send assemblyOrderCreated to outlet AssemblyOrderEvents
      }
      on assemblyCompleted: event AssemblyOrder.AssemblyCompleted is {
        send assemblyCompleted to outlet AssemblyOrderEvents
      }
      on assemblyFailed: event AssemblyOrder.AssemblyFailed is {
        send assemblyFailed to outlet AssemblyOrderEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits AssemblyOrder events to the stream.
      }
    }
  } with {
    briefly "AssemblyOrder event source"
    described as {
      |Publishes AssemblyOrder events to the event stream.
    }
  }
  processor AssemblyOrderEventSink as sink is {
    inlet IncomingAssemblyOrderEvents is type AssemblyOrderEvent    handler AssemblyOrderEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink AssemblyOrderEventSink"
      }
      on assemblyOrderCreated: event AssemblyOrder.AssemblyOrderCreated is {
        tell assemblyOrderCreated to repository AssemblyContext.AssemblyOrderRepository
      }
      on assemblyCompleted: event AssemblyOrder.AssemblyCompleted is {
        tell assemblyCompleted to repository AssemblyContext.AssemblyOrderRepository
      }
      on assemblyFailed: event AssemblyOrder.AssemblyFailed is {
        tell assemblyFailed to repository AssemblyContext.AssemblyOrderRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives AssemblyOrder events for persistence.
      }
    }
  } with {
    briefly "AssemblyOrder event sink"
    described as {
      |Receives AssemblyOrder events from streaming.
    }
  }
  connector AssemblyOrderEventPipeline is from outlet AssemblyContext.AssemblyOrderEventSource.AssemblyOrderEvents to inlet AssemblyContext.AssemblyOrderEventSink.IncomingAssemblyOrderEvents with {
    briefly "AssemblyOrder event pipeline"
    described as {
      |Wires AssemblyOrder event source to sink.
    }
  }
  processor AssemblyOrderEventSplit as split is {
    inlet AssemblyOrderEventSplitIn is type AssemblyOrderEvent    outlet AssemblyOrderEventSplitToAssemblyOrderRepository is type AssemblyOrderEvent
    outlet AssemblyOrderEventSplitToAssemblyLineAnalytics is type AssemblyOrderEvent
    handler AssemblyOrderEventSplitHandler is {
      on assemblyOrderCreated: event AssemblyOrder.AssemblyOrderCreated is {
        send assemblyOrderCreated to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send assemblyOrderCreated to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyOrderCreated to entity AssemblyContext.AssemblyOrder
      }
      on assemblyStarted: event AssemblyOrder.AssemblyStarted is {
        send assemblyStarted to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send assemblyStarted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyStarted to entity AssemblyContext.AssemblyOrder
      }
      on stepCompleted: event AssemblyOrder.StepCompleted is {
        send stepCompleted to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send stepCompleted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell stepCompleted to entity AssemblyContext.AssemblyOrder
      }
      on defectRecorded: event AssemblyOrder.DefectRecorded is {
        send defectRecorded to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send defectRecorded to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell defectRecorded to entity AssemblyContext.AssemblyOrder
      }
      on assemblyCompleted: event AssemblyOrder.AssemblyCompleted is {
        send assemblyCompleted to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send assemblyCompleted to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyCompleted to entity AssemblyContext.AssemblyOrder
      }
      on assemblyHeld: event AssemblyOrder.AssemblyHeld is {
        send assemblyHeld to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send assemblyHeld to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyHeld to entity AssemblyContext.AssemblyOrder
      }
      on holdReleased: event AssemblyOrder.HoldReleased is {
        send holdReleased to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send holdReleased to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell holdReleased to entity AssemblyContext.AssemblyOrder
      }
      on assemblyFailed: event AssemblyOrder.AssemblyFailed is {
        send assemblyFailed to outlet AssemblyOrderEventSplitToAssemblyOrderRepository
        send assemblyFailed to outlet AssemblyOrderEventSplitToAssemblyLineAnalytics
        tell assemblyFailed to entity AssemblyContext.AssemblyOrder
      }
      on other is {
        error "Unexpected message for processor AssemblyOrderEventSplit"
      }
    } with {
      briefly "AssemblyOrder event fan-out handler"
      described as {
        |Delivers each AssemblyOrder event to all of its consumers.
      }
    }
  } with {
    briefly "AssemblyOrder event fan-out"
    described as {
      |Fans AssemblyOrder events out to the repository and projectors.
    }
  }
  connector 'AssemblyOrderEvent Stream' is from outlet AssemblyContext.AssemblyOrder.AssemblyOrderEvents2 to inlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitIn with {
    briefly "AssemblyOrder events, fanned out to storage and read models"
  }
  connector 'AssemblyOrderEvent Storage' is from outlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitToAssemblyOrderRepository to inlet AssemblyContext.AssemblyOrderRepository.AssemblyOrderRepositoryFromAssemblyOrder with {
    briefly "AssemblyOrder events on their way to storage"
  }
  connector 'AssemblyLineAnalytics Feed' is from outlet AssemblyContext.AssemblyOrderEventSplit.AssemblyOrderEventSplitToAssemblyLineAnalytics to inlet AssemblyContext.AssemblyLineAnalytics.AssemblyLineAnalyticsFromAssemblyOrder with {
    briefly "AssemblyOrder events feeding the AssemblyLineAnalytics projection"
  }
  connector 'AssemblyLineAnalytics Storage' is from outlet AssemblyContext.AssemblyLineAnalytics.AssemblyLineAnalyticsOut to inlet AssemblyContext.AssemblyOrderRepository.AssemblyOrderRepositoryFromAssemblyLineAnalytics with {
    briefly "The AssemblyLineAnalytics projection on its way to storage"
  }
  connector 'QualityCommand Stream' is from outlet AssemblyContext.AssemblyOrder.AssemblyOrderToQuality to inlet AssemblyContext.ToQualityService.OutgoingQualityCommands with {
    briefly "Quality commands from the assembly order to its adaptor"
  }
  connector 'ReportAssemblyComplete Stream' is from outlet AssemblyContext.AssemblyOrder.AssemblyOrderToWorkOrder to inlet AssemblyContext.ToWorkOrderService.OutgoingWorkOrderCommands with {
    briefly "Assembly completion reports from the assembly order to its adaptor"
  }
} with {
  briefly "Bounded context for assembly operations"
  described as {
    | The AssemblyContext is the bounded context for
    | manufacturing assembly line operations, tracking
    | assembly orders, steps, quality, and performance.
  }
}
