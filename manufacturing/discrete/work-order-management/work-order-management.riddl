// Work Order Management Domain Model
// Manufacturing work orders and production control
domain WorkOrderManagement is {
  persistent connector 'SchedulingServiceReply Stream' is from outlet SchedulingService.SchedulingServiceRepliesOut to inlet WorkOrderContext.ToSchedulingService.ToSchedulingServiceReplies with {
    briefly "What SchedulingService answers WorkOrderContext"
  }
  persistent connector 'RoutingServiceReply Stream' is from outlet RoutingService.RoutingServiceRepliesOut to inlet WorkOrderContext.ToRoutingService.ToRoutingServiceReplies with {
    briefly "What RoutingService answers WorkOrderContext"
  }
  persistent connector 'QualityManagementServiceReply Stream' is from outlet QualityManagementService.QualityManagementServiceRepliesOut to inlet WorkOrderContext.ToQualityManagementService.ToQualityManagementServiceReplies with {
    briefly "What QualityManagementService answers WorkOrderContext"
  }
  persistent connector 'EquipmentServiceReply Stream' is from outlet EquipmentService.EquipmentServiceRepliesOut to inlet WorkOrderContext.ToEquipmentService.ToEquipmentServiceReplies with {
    briefly "What EquipmentService answers WorkOrderContext"
  }
  persistent connector 'BillOfMaterialsServiceReply Stream' is from outlet BillOfMaterialsService.BillOfMaterialsServiceRepliesOut to inlet WorkOrderContext.ToBillOfMaterialsService.ToBillOfMaterialsServiceReplies with {
    briefly "What BillOfMaterialsService answers WorkOrderContext"
  }
  persistent connector 'SchedulingServiceEvent Stream' is from outlet SchedulingService.SchedulingServiceEventsOut to inlet WorkOrderContext.FromSchedulingService.FromSchedulingServiceIn with {
    briefly "What SchedulingService tells WorkOrderContext, unasked"
  }
  persistent connector 'EquipmentServiceEvent Stream' is from outlet EquipmentService.EquipmentServiceEventsOut to inlet WorkOrderContext.FromEquipmentService.FromEquipmentServiceIn with {
    briefly "What EquipmentService tells WorkOrderContext, unasked"
  }
  persistent connector 'InventoryServiceEvent Stream' is from outlet InventoryService.InventoryServiceEventsOut to inlet WorkOrderContext.FromInventoryService.FromInventoryServiceIn with {
    briefly "What InventoryService tells WorkOrderContext, unasked"
  }
  persistent connector 'QualityManagementServiceEvent Stream' is from outlet QualityManagementService.QualityManagementServiceEventsOut to inlet WorkOrderContext.FromQualityManagementService.FromQualityManagementServiceIn with {
    briefly "What QualityManagementService tells WorkOrderContext, unasked"
  }
  persistent connector 'RoutingServiceRequest Stream' is from outlet WorkOrderContext.ToRoutingService.ToRoutingServiceOut to inlet RoutingService.RoutingServiceRequests with {
    briefly "What WorkOrderContext asks RoutingService to send"
  }
  persistent connector 'BillOfMaterialsServiceRequest Stream' is from outlet WorkOrderContext.ToBillOfMaterialsService.ToBillOfMaterialsServiceOut to inlet BillOfMaterialsService.BillOfMaterialsServiceRequests with {
    briefly "What WorkOrderContext asks BillOfMaterialsService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProductionManager is "person managing manufacturing operations" with {
    briefly "Production Manager"
    described as {
      |Person overseeing production.
    }
  }
  user ShopFloorOperator is "person executing production tasks" with {
    briefly "Shop Floor Operator"
    described as {
      |Person operating equipment.
    }
  }
  user Planner is "person scheduling production" with {
    briefly "Planner"
    described as {
      |Person planning production schedule.
    }
  }
  epic WorkOrderEpic is {
    user ProductionManager wants to "to manage production work orders" so that "manufacturing runs efficiently"
    case ExecuteWorkOrder is {
      user ShopFloorOperator wants to "to complete a work order" so that "products are manufactured"
      step is "Operator reviews" "work order details" "and instructions" with {
        briefly "Review order"
        described as {
          |Check work order.
        }
      }
      step is "Operator gathers" "materials and tools" "for production" with {
        briefly "Gather materials"
        described as {
          |Prepare materials.
        }
      }
      step take input WorkOrderManagementApp.WorkOrderManagementScreen.StartWorkOrderInput from user ShopFloorOperator with {
        briefly "Start order"
        described as {
          |Begin production.
        }
      }
      step is "System tracks" "production progress" "and quality" with {
        briefly "Track progress"
        described as {
          |Monitor production.
        }
      }
    } with {
      briefly "Work order execution"
      described as {
        |Executing manufacturing work order.
      }
    }
  } with {
    briefly "Work order management"
    described as {
      | Epic covering work order creation,
      | scheduling, execution, and completion.
    }
  }
  include "WorkOrderContext.riddl"
  include "external-contexts.riddl"
  application context WorkOrderManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in WorkOrderManagement are delivered.
      }
    }
    group WorkOrderManagementScreen is {
      input StartWorkOrderInput acquires command WorkOrderContext.WorkOrder.StartWorkOrder with {
        briefly "Start work order control"
        described as {
          |The control through which a user submits the start work order request.
        }
      }
    } with {
      briefly "Work order management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppWorkOrderCommands is type WorkOrderContext.WorkOrder.WorkOrderCommand
    inlet AppWorkOrderRepositoryResponses is result WorkOrderContext.WorkOrder.WorkOrderResult    handler WorkOrderManagementAppHandler is {
      on other is {
        error "Unexpected message for application context WorkOrderManagementApp"
      }
    } with {
      briefly "WorkOrderManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "WorkOrderManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'EquipmentServiceRequest Stream' is from outlet WorkOrderContext.ToEquipmentService.ToEquipmentServiceOut to inlet EquipmentService.EquipmentServiceRequests with {
    briefly "What WorkOrderContext asks EquipmentService to send"
  }
  persistent connector 'QualityManagementServiceRequest Stream' is from outlet WorkOrderContext.ToQualityManagementService.ToQualityManagementServiceOut to inlet QualityManagementService.QualityManagementServiceRequests with {
    briefly "What WorkOrderContext asks QualityManagementService to send"
  }
  persistent connector 'SchedulingServiceRequest Stream' is from outlet WorkOrderContext.ToSchedulingService.ToSchedulingServiceOut to inlet SchedulingService.SchedulingServiceRequests with {
    briefly "What WorkOrderContext asks SchedulingService to send"
  }
  persistent connector 'InventoryServiceRequest Stream' is from outlet WorkOrderContext.ToInventoryService.ToInventoryServiceOut to inlet InventoryService.InventoryServiceRequests with {
    briefly "What WorkOrderContext asks InventoryService to send"
  }
  persistent connector 'WorkOrderCommand Stream' is from outlet WorkOrderManagementApp.AppWorkOrderCommands to inlet WorkOrderContext.WorkOrderCommandStreamIn with {
    briefly "WorkOrder commands from the application"
  }
  persistent connector 'WorkOrderResult Stream' is from outlet WorkOrderContext.WorkOrderResultStreamOut to inlet WorkOrderManagementApp.AppWorkOrderRepositoryResponses with {
    briefly "WorkOrder query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet WorkOrderManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Work order management domain"
  described as {
    | The WorkOrderManagement domain handles manufacturing
    | work orders and shop floor operations.
  }
}
