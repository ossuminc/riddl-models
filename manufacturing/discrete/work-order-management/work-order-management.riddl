// Work Order Management Domain Model
// Manufacturing work orders and production control
domain WorkOrderManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProductionManager is "person managing manufacturing operations" with {
    briefly "Production Manager"
    described as {
      |Person overseeing production.
    }
  }
  user ShopFloorOperator is "person executing production tasks" with {
    briefly "Shop Floor Operator"
    described as {
      |Person operating equipment.
    }
  }
  user Planner is "person scheduling production" with {
    briefly "Planner"
    described as {
      |Person planning production schedule.
    }
  }
  epic WorkOrderEpic is {
    user ProductionManager wants to "to manage production work orders" so that "manufacturing runs efficiently"
    case ExecuteWorkOrder is {
      user ShopFloorOperator wants to "to complete a work order" so that "products are manufactured"
      step is "Operator reviews" "work order details" "and instructions" with {
        briefly "Review order"
        described as {
          |Check work order.
        }
      }
      step is "Operator gathers" "materials and tools" "for production" with {
        briefly "Gather materials"
        described as {
          |Prepare materials.
        }
      }
      step take input WorkOrderManagementApp.WorkOrderManagementScreen.StartWorkOrderInput from user ShopFloorOperator with {
        briefly "Start order"
        described as {
          |Begin production.
        }
      }
      step is "System tracks" "production progress" "and quality" with {
        briefly "Track progress"
        described as {
          |Monitor production.
        }
      }
    } with {
      briefly "Work order execution"
      described as {
        |Executing manufacturing work order.
      }
    }
  } with {
    briefly "Work order management"
    described as {
      | Epic covering work order creation,
      | scheduling, execution, and completion.
    }
  }
  include "WorkOrderContext.riddl"
  include "external-contexts.riddl"
  application context WorkOrderManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in WorkOrderManagement are delivered.
      }
    }
    group WorkOrderManagementScreen is {
      input StartWorkOrderInput acquires command WorkOrderContext.WorkOrder.StartWorkOrder with {
        briefly "Start work order control"
        described as {
          |The control through which a user submits the start work order request.
        }
      }
    } with {
      briefly "Work order management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppWorkOrderCommands is type WorkOrderContext.WorkOrder.WorkOrderCommand
    inlet AppWorkOrderRepositoryResponses is type WorkOrderContext.WorkOrder.WorkOrderResult    handler WorkOrderManagementAppHandler is {
      on other is {
        error "Unexpected message for application context WorkOrderManagementApp"
      }
    } with {
      briefly "WorkOrderManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "WorkOrderManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'WorkOrderCommand Stream' is from outlet WorkOrderManagementApp.AppWorkOrderCommands to inlet WorkOrderContext.WorkOrderCommandStreamIn with {
    briefly "WorkOrder commands from the application"
  }
  persistent connector 'WorkOrderResult Stream' is from outlet WorkOrderContext.WorkOrderResultStreamOut to inlet WorkOrderManagementApp.AppWorkOrderRepositoryResponses with {
    briefly "WorkOrder query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet WorkOrderManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Work order management domain"
  described as {
    | The WorkOrderManagement domain handles manufacturing
    | work orders and shop floor operations.
  }
}
