// Work Order Management - WorkOrder Context
context WorkOrderContext is {
  adaptor FromBillOfMaterialsService from context BillOfMaterialsService is {
    handler FromBillOfMaterialsServiceHandler is {
      on result BillOfMaterialsService.BillOfMaterials is {
        do "the model receives bill of materials"
      }
      on other is {
        error "Unexpected message for adaptor FromBillOfMaterialsService"
      }
    } with {
      briefly "from bill of materials service"
      described as {
        |Carries messages from the external BillOfMaterialsService.
      }
    }
  } with {
      briefly "BillOfMaterialsService integration"
    described as {
      |The model's side of the BillOfMaterialsService conversation.
    }
  }
  adaptor ToBillOfMaterialsService to context BillOfMaterialsService is {
    handler ToBillOfMaterialsServiceHandler is {
      on query BillOfMaterialsService.GetBOM is {
        do "the model sends get bom"
      }
      on other is {
        error "Unexpected message for adaptor ToBillOfMaterialsService"
      }
    } with {
      briefly "to bill of materials service"
      described as {
        |Carries messages to the external BillOfMaterialsService.
      }
    }
  } with {
      briefly "BillOfMaterialsService integration"
    described as {
      |The model's side of the BillOfMaterialsService conversation.
    }
  }
  adaptor FromEquipmentService from context EquipmentService is {
    handler FromEquipmentServiceHandler is {
      on event EquipmentService.DowntimeReported is {
        do "the model receives downtime reported"
      }
      on result EquipmentService.EquipmentStatus is {
        do "the model receives equipment status"
      }
      on other is {
        error "Unexpected message for adaptor FromEquipmentService"
      }
    } with {
      briefly "from equipment service"
      described as {
        |Carries messages from the external EquipmentService.
      }
    }
  } with {
      briefly "EquipmentService integration"
    described as {
      |The model's side of the EquipmentService conversation.
    }
  }
  adaptor ToEquipmentService to context EquipmentService is {
    handler ToEquipmentServiceHandler is {
      on query EquipmentService.GetEquipmentStatus is {
        do "the model sends get equipment status"
      }
      on command EquipmentService.ReportEquipmentDowntime is {
        do "the model sends report equipment downtime"
      }
      on other is {
        error "Unexpected message for adaptor ToEquipmentService"
      }
    } with {
      briefly "to equipment service"
      described as {
        |Carries messages to the external EquipmentService.
      }
    }
  } with {
      briefly "EquipmentService integration"
    described as {
      |The model's side of the EquipmentService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is {
    handler FromInventoryServiceHandler is {
      on event InventoryService.FinishedGoodsReceived is {
        do "the model receives finished goods received"
      }
      on event InventoryService.MaterialShortage is {
        do "the model receives material shortage"
      }
      on event InventoryService.MaterialsIssuedFromInventory is {
        do "the model receives materials issued from inventory"
      }
      on event InventoryService.MaterialsReserved is {
        do "the model receives materials reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
      briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is {
    handler ToInventoryServiceHandler is {
      on command InventoryService.IssueMaterialsToWorkOrder is {
        do "the model sends issue materials to work order"
      }
      on command InventoryService.ReceiveFinishedGoods is {
        do "the model sends receive finished goods"
      }
      on command InventoryService.ReserveMaterials is {
        do "the model sends reserve materials"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
      briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromQualityManagementService from context QualityManagementService is {
    handler FromQualityManagementServiceHandler is {
      on result QualityManagementService.InspectionPlan is {
        do "the model receives inspection plan"
      }
      on event QualityManagementService.NonConformanceRecorded is {
        do "the model receives non conformance recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityManagementService"
      }
    } with {
      briefly "from quality management service"
      described as {
        |Carries messages from the external QualityManagementService.
      }
    }
  } with {
      briefly "QualityManagementService integration"
    described as {
      |The model's side of the QualityManagementService conversation.
    }
  }
  adaptor ToQualityManagementService to context QualityManagementService is {
    handler ToQualityManagementServiceHandler is {
      on query QualityManagementService.GetInspectionPlan is {
        do "the model sends get inspection plan"
      }
      on command QualityManagementService.RecordNonConformance is {
        do "the model sends record non conformance"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityManagementService"
      }
    } with {
      briefly "to quality management service"
      described as {
        |Carries messages to the external QualityManagementService.
      }
    }
  } with {
      briefly "QualityManagementService integration"
    described as {
      |The model's side of the QualityManagementService conversation.
    }
  }
  adaptor FromRoutingService from context RoutingService is {
    handler FromRoutingServiceHandler is {
      on result RoutingService.ManufacturingRouting is {
        do "the model receives manufacturing routing"
      }
      on other is {
        error "Unexpected message for adaptor FromRoutingService"
      }
    } with {
      briefly "from routing service"
      described as {
        |Carries messages from the external RoutingService.
      }
    }
  } with {
      briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor ToRoutingService to context RoutingService is {
    handler ToRoutingServiceHandler is {
      on query RoutingService.GetRouting is {
        do "the model sends get routing"
      }
      on other is {
        error "Unexpected message for adaptor ToRoutingService"
      }
    } with {
      briefly "to routing service"
      described as {
        |Carries messages to the external RoutingService.
      }
    }
  } with {
      briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor FromSchedulingService from context SchedulingService is {
    handler FromSchedulingServiceHandler is {
      on result SchedulingService.WorkCenterLoad is {
        do "the model receives work center load"
      }
      on result SchedulingService.WorkOrderSchedule is {
        do "the model receives work order schedule"
      }
      on other is {
        error "Unexpected message for adaptor FromSchedulingService"
      }
    } with {
      briefly "from scheduling service"
      described as {
        |Carries messages from the external SchedulingService.
      }
    }
  } with {
      briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  adaptor ToSchedulingService to context SchedulingService is {
    handler ToSchedulingServiceHandler is {
      on query SchedulingService.GetWorkCenterLoad is {
        do "the model sends get work center load"
      }
      on command SchedulingService.ScheduleWorkOrder is {
        do "the model sends schedule work order"
      }
      on other is {
        error "Unexpected message for adaptor ToSchedulingService"
      }
    } with {
      briefly "to scheduling service"
      described as {
        |Carries messages to the external SchedulingService.
      }
    }
  } with {
      briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  include "types.riddl"
  include "WorkOrder.riddl"
  repository WorkOrderRepository is {
    inlet WorkOrderRepositoryFromWorkOrder is type WorkOrderEvent
    inlet WorkOrderRepositoryFromProductionAnalytics is type WorkOrderEvent
    outlet WorkOrderRepositoryResponses is type WorkOrder.WorkOrderResult
    record StoredWorkOrder is {
      workOrderId: WorkOrderId with {
        briefly "workOrderId"
        described as {
          |The workOrderId column of the stored workOrder row.
        }
      }
      product: ProductInfo with {
        briefly "product"
        described as {
          |The product column of the stored workOrder row.
        }
      }
    } with {
      briefly "Stored workOrder row"
      described as {
        |The persistence shape of workOrder data as this repository stores it.
      }
    }
    schema WorkOrderData is relational
      of workOrders as type StoredWorkOrder
        index on field StoredWorkOrder.workOrderId
        index on field StoredWorkOrder.product.productId
        index on field StoredWorkOrder.status
      with {
      briefly "Work order data schema"
      described as {
        |The relational schema holding work order data for the WorkOrderRepository.
      }
    }

    handler WorkOrderPersistence is {
      on query GetProductionStats is {
        do "read the production stats projection"
        yield result ProductionStatsView
      }
      on command WorkOrder.CreateWorkOrder is {
        tell event WorkOrder.WorkOrderCreated to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.ReleaseWorkOrder is {
        tell event WorkOrder.WorkOrderReleased to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.IssueMaterials is {
        tell event WorkOrder.MaterialsIssued to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.StartWorkOrder is {
        tell event WorkOrder.WorkOrderStarted to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.StartOperation is {
        tell event WorkOrder.OperationStarted to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.CompleteOperation is {
        tell event WorkOrder.OperationCompleted to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.RecordLabor is {
        tell event WorkOrder.LaborRecorded to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.RecordQuality is {
        tell event WorkOrder.QualityRecorded to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.PlaceOnHold is {
        tell event WorkOrder.WorkOrderOnHold to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.ReleaseHold is {
        tell event WorkOrder.HoldReleased to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.CompleteWorkOrder is {
        tell event WorkOrder.WorkOrderCompleted to entity WorkOrderContext.WorkOrder
      }
      on command WorkOrder.CancelWorkOrder is {
        tell event WorkOrder.WorkOrderCancelled to entity WorkOrderContext.WorkOrder
      }
    } with {
      briefly "Persists work order events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Work order data persistence"
    described as {
      | The WorkOrderRepository provides persistent storage for
      | work orders, operations, and production data.
    }
  }
  query GetProductionStats is {
    productionStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which production stats to retrieve.
      }
    }
  } with {
    briefly "Get production stats"
    described as {
      |Retrieves the production stats projection.
    }
  }
  result ProductionStatsView is {
    productionStats: ProductionAnalytics.ProductionStats with {
      briefly "Production stats"
      described as {
        |The production stats being returned.
      }
    }
  } with {
    briefly "Production stats view"
    described as {
      |Read model view carrying the production stats projection.
    }
  }
  projector ProductionAnalytics is {
    inlet ProductionAnalyticsFromWorkOrder is type WorkOrderEvent
    outlet ProductionAnalyticsOut is type WorkOrderEvent
    updates repository WorkOrderContext.WorkOrderRepository
    record ProductionStats is  {
      activeWorkOrders: Natural with { briefly "Active" described as { |Active work orders.
        }
      }
      completedToday: Natural with { briefly "Completed" described as { |Completed today.
        }
      }
      onTimeDelivery: Decimal(5,4) with { briefly "OTD" described as { |On-time delivery rate.
        }
      }
      firstPassYield: Decimal(5,4) with { briefly "FPY" described as { |First pass yield.
        }
      }
      oee: Decimal(5,4) with { briefly "OEE" described as { |Overall equipment effectiveness.
        }
      }
      averageCycleTime: Natural with { briefly "Cycle time" described as { |Average cycle time (min).
        }
      }
    } with {
      briefly "Production statistics"
      described as {
        |Manufacturing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event WorkOrder.WorkOrderStarted is {
        tell event WorkOrder.WorkOrderStarted to repository WorkOrderContext.WorkOrderRepository
      }
      on event WorkOrder.WorkOrderCompleted is {
        tell event WorkOrder.WorkOrderCompleted to repository WorkOrderContext.WorkOrderRepository
      }
      on event WorkOrder.QualityRecorded is {
        tell event WorkOrder.QualityRecorded to repository WorkOrderContext.WorkOrderRepository
      }
      on event WorkOrder.OperationCompleted is {
        tell event WorkOrder.OperationCompleted to repository WorkOrderContext.WorkOrderRepository
      }
    } with {
      briefly "Maintains production analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Production analytics projections"
    described as {
      |Maintains manufacturing analytics data.
    }
  }
  type WorkOrderEvent is one of {
    WorkOrderContext.WorkOrder.WorkOrderCreated,
    WorkOrderContext.WorkOrder.WorkOrderCompleted,
    WorkOrderContext.WorkOrder.WorkOrderCancelled
  } with {
    briefly "WorkOrder event union"
    described as {
      |Union of WorkOrder events for streaming.
    }
  }
  processor WorkOrderEventSource as source is {
    outlet WorkOrderEvents is type WorkOrderEvent
    handler WorkOrderEventEmitter is {
      on init is { tell command WorkOrder.InitializeWorkOrder to entity WorkOrderContext.WorkOrder }
      on other is {
        error "Unexpected message for source WorkOrderEventSource"
      }
      on event WorkOrder.WorkOrderCreated is {
        send event WorkOrder.WorkOrderCreated to outlet WorkOrderEvents
      }
      on event WorkOrder.WorkOrderCompleted is {
        send event WorkOrder.WorkOrderCompleted to outlet WorkOrderEvents
      }
      on event WorkOrder.WorkOrderCancelled is {
        send event WorkOrder.WorkOrderCancelled to outlet WorkOrderEvents
      }
    } with {
      briefly "Event emitter"
      described as {
        |Emits WorkOrder events to the stream.
      }
    }
  } with {
    briefly "WorkOrder event source"
    described as {
      |Publishes WorkOrder events to the event stream.
    }
  }
  processor WorkOrderEventSink as sink is {
    inlet IncomingWorkOrderEvents is type WorkOrderEvent
    handler WorkOrderEventReceiver is {
      on init is { ??? }
      on other is {
        error "Unexpected message for sink WorkOrderEventSink"
      }
      on event WorkOrder.WorkOrderCreated is {
        tell event WorkOrder.WorkOrderCreated to repository WorkOrderContext.WorkOrderRepository
      }
      on event WorkOrder.WorkOrderCompleted is {
        tell event WorkOrder.WorkOrderCompleted to repository WorkOrderContext.WorkOrderRepository
      }
      on event WorkOrder.WorkOrderCancelled is {
        tell event WorkOrder.WorkOrderCancelled to repository WorkOrderContext.WorkOrderRepository
      }
    } with {
      briefly "Event receiver"
      described as {
        |Receives WorkOrder events for persistence.
      }
    }
  } with {
    briefly "WorkOrder event sink"
    described as {
      |Receives WorkOrder events from streaming.
    }
  }
  connector WorkOrderEventPipeline is {
    from outlet WorkOrderContext.WorkOrderEventSource.WorkOrderEvents to inlet WorkOrderContext.WorkOrderEventSink.IncomingWorkOrderEvents
  } with {
    briefly "WorkOrder event pipeline"
    described as {
      |Wires WorkOrder event source to sink.
    }
  }
  processor WorkOrderEventSplit is {
    inlet WorkOrderEventSplitIn is type WorkOrderEvent
    outlet WorkOrderEventSplitToWorkOrderRepository is type WorkOrderEvent
    outlet WorkOrderEventSplitToProductionAnalytics is type WorkOrderEvent
    handler WorkOrderEventSplitHandler is {
      on event WorkOrder.WorkOrderCreated is {
        send event WorkOrder.WorkOrderCreated to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.WorkOrderCreated to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.WorkOrderCreated to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.WorkOrderReleased is {
        send event WorkOrder.WorkOrderReleased to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.WorkOrderReleased to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.WorkOrderReleased to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.MaterialsIssued is {
        send event WorkOrder.MaterialsIssued to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.MaterialsIssued to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.MaterialsIssued to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.WorkOrderStarted is {
        send event WorkOrder.WorkOrderStarted to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.WorkOrderStarted to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.WorkOrderStarted to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.OperationStarted is {
        send event WorkOrder.OperationStarted to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.OperationStarted to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.OperationStarted to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.OperationCompleted is {
        send event WorkOrder.OperationCompleted to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.OperationCompleted to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.OperationCompleted to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.LaborRecorded is {
        send event WorkOrder.LaborRecorded to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.LaborRecorded to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.LaborRecorded to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.QualityRecorded is {
        send event WorkOrder.QualityRecorded to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.QualityRecorded to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.QualityRecorded to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.WorkOrderOnHold is {
        send event WorkOrder.WorkOrderOnHold to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.WorkOrderOnHold to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.WorkOrderOnHold to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.HoldReleased is {
        send event WorkOrder.HoldReleased to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.HoldReleased to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.HoldReleased to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.WorkOrderCompleted is {
        send event WorkOrder.WorkOrderCompleted to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.WorkOrderCompleted to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.WorkOrderCompleted to entity WorkOrderContext.WorkOrder
      }
      on event WorkOrder.WorkOrderCancelled is {
        send event WorkOrder.WorkOrderCancelled to outlet WorkOrderEventSplitToWorkOrderRepository
        send event WorkOrder.WorkOrderCancelled to outlet WorkOrderEventSplitToProductionAnalytics
        tell event WorkOrder.WorkOrderCancelled to entity WorkOrderContext.WorkOrder
      }
      on other is {
        error "Unexpected message for processor WorkOrderEventSplit"
      }
    } with {
      briefly "WorkOrder event fan-out handler"
      described as {
        |Delivers each WorkOrder event to all of its consumers.
      }
    }
  } with {
    briefly "WorkOrder event fan-out"
    described as {
      |Fans WorkOrder events out to the repository and projectors.
    }
  }
  connector LinkWorkOrderToWorkOrderEventSplit is {
    from outlet WorkOrderContext.WorkOrder.WorkOrderEvents2 to
      inlet WorkOrderContext.WorkOrderEventSplit.WorkOrderEventSplitIn
  } with {
    briefly "LinkWorkOrderToWorkOrderEventSplit"
  }
  connector LinkWorkOrderEventSplitToWorkOrderRepository is {
    from outlet WorkOrderContext.WorkOrderEventSplit.WorkOrderEventSplitToWorkOrderRepository to
      inlet WorkOrderContext.WorkOrderRepository.WorkOrderRepositoryFromWorkOrder
  } with {
    briefly "LinkWorkOrderEventSplitToWorkOrderRepository"
  }
  connector LinkWorkOrderEventSplitToProductionAnalytics is {
    from outlet WorkOrderContext.WorkOrderEventSplit.WorkOrderEventSplitToProductionAnalytics to
      inlet WorkOrderContext.ProductionAnalytics.ProductionAnalyticsFromWorkOrder
  } with {
    briefly "LinkWorkOrderEventSplitToProductionAnalytics"
  }
  connector LinkProductionAnalyticsToWorkOrderRepository is {
    from outlet WorkOrderContext.ProductionAnalytics.ProductionAnalyticsOut to
      inlet WorkOrderContext.WorkOrderRepository.WorkOrderRepositoryFromProductionAnalytics
  } with {
    briefly "LinkProductionAnalyticsToWorkOrderRepository"
  }
} with {
  briefly "Bounded context for work order management"
  described as {
    | The WorkOrderContext is the bounded context for
    | manufacturing work orders and production control.
  }
}
