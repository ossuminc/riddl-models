// Work Order Management - WorkOrder Context
context WorkOrderContext as router is {
  inlet WorkOrderCommandStreamIn is type WorkOrderCommand  outlet WorkOrderCommandStreamOut is type WorkOrderCommand
  inlet WorkOrderResultStreamIn is type WorkOrder.WorkOrderResult  outlet WorkOrderResultStreamOut is type WorkOrder.WorkOrderResult
  handler WorkOrderContextBoundary is {
    on createWorkOrder: command WorkOrder.CreateWorkOrder is {
      send createWorkOrder to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on releaseWorkOrder: command WorkOrder.ReleaseWorkOrder is {
      send releaseWorkOrder to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on issueMaterials: command WorkOrder.IssueMaterials is {
      send issueMaterials to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on startWorkOrder: command WorkOrder.StartWorkOrder is {
      send startWorkOrder to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on startOperation: command WorkOrder.StartOperation is {
      send startOperation to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on completeOperation: command WorkOrder.CompleteOperation is {
      send completeOperation to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on recordLabor: command WorkOrder.RecordLabor is {
      send recordLabor to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on recordQuality: command WorkOrder.RecordQuality is {
      send recordQuality to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on placeOnHold: command WorkOrder.PlaceOnHold is {
      send placeOnHold to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on releaseHold: command WorkOrder.ReleaseHold is {
      send releaseHold to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on completeWorkOrder: command WorkOrder.CompleteWorkOrder is {
      send completeWorkOrder to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on cancelWorkOrder: command WorkOrder.CancelWorkOrder is {
      send cancelWorkOrder to outlet WorkOrderContext.WorkOrderCommandStreamOut
    }
    on workOrderResult: result WorkOrder.WorkOrderResult is {
      send workOrderResult to outlet WorkOrderContext.WorkOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the WorkOrderContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WorkOrderCommand Stream Intake' is from outlet WorkOrderContext.WorkOrderCommandStreamOut to inlet WorkOrderContext.WorkOrder.WorkOrderCommands  connector 'WorkOrderResult Stream Egress' is from outlet WorkOrderContext.WorkOrderRepository.WorkOrderRepositoryResponses to inlet WorkOrderContext.WorkOrderResultStreamIn  adaptor FromBillOfMaterialsService from context BillOfMaterialsService is { 
    handler FromBillOfMaterialsServiceHandler is {
      on result BillOfMaterialsService.BillOfMaterials is {
        do "the model receives bill of materials"
      }
      on other is {
        error "Unexpected message for adaptor FromBillOfMaterialsService"
      }
    } with {
      briefly "from bill of materials service"
      described as {
        |Carries messages from the external BillOfMaterialsService.
      }
    }
  } with {
    briefly "BillOfMaterialsService integration"
    described as {
      |The model's side of the BillOfMaterialsService conversation.
    }
  }
  adaptor ToBillOfMaterialsService to context BillOfMaterialsService is { 
    handler ToBillOfMaterialsServiceHandler is {
      on query BillOfMaterialsService.GetBOM is {
        do "the model sends get bom"
      }
      on other is {
        error "Unexpected message for adaptor ToBillOfMaterialsService"
      }
    } with {
      briefly "to bill of materials service"
      described as {
        |Carries messages to the external BillOfMaterialsService.
      }
    }
  } with {
    briefly "BillOfMaterialsService integration"
    described as {
      |The model's side of the BillOfMaterialsService conversation.
    }
  }
  adaptor FromEquipmentService from context EquipmentService is { 
    handler FromEquipmentServiceHandler is {
      on event EquipmentService.DowntimeReported is {
        do "the model receives downtime reported"
      }
      on result EquipmentService.EquipmentStatus is {
        do "the model receives equipment status"
      }
      on other is {
        error "Unexpected message for adaptor FromEquipmentService"
      }
    } with {
      briefly "from equipment service"
      described as {
        |Carries messages from the external EquipmentService.
      }
    }
  } with {
    briefly "EquipmentService integration"
    described as {
      |The model's side of the EquipmentService conversation.
    }
  }
  adaptor ToEquipmentService to context EquipmentService is { 
    handler ToEquipmentServiceHandler is {
      on query EquipmentService.GetEquipmentStatus is {
        do "the model sends get equipment status"
      }
      on command EquipmentService.ReportEquipmentDowntime is {
        do "the model sends report equipment downtime"
      }
      on other is {
        error "Unexpected message for adaptor ToEquipmentService"
      }
    } with {
      briefly "to equipment service"
      described as {
        |Carries messages to the external EquipmentService.
      }
    }
  } with {
    briefly "EquipmentService integration"
    described as {
      |The model's side of the EquipmentService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.FinishedGoodsReceived is {
        do "the model receives finished goods received"
      }
      on event InventoryService.MaterialShortage is {
        do "the model receives material shortage"
      }
      on event InventoryService.MaterialsIssuedFromInventory is {
        do "the model receives materials issued from inventory"
      }
      on event InventoryService.MaterialsReserved is {
        do "the model receives materials reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on command InventoryService.IssueMaterialsToWorkOrder is {
        do "the model sends issue materials to work order"
      }
      on command InventoryService.ReceiveFinishedGoods is {
        do "the model sends receive finished goods"
      }
      on command InventoryService.ReserveMaterials is {
        do "the model sends reserve materials"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromQualityManagementService from context QualityManagementService is { 
    handler FromQualityManagementServiceHandler is {
      on result QualityManagementService.InspectionPlan is {
        do "the model receives inspection plan"
      }
      on event QualityManagementService.NonConformanceRecorded is {
        do "the model receives non conformance recorded"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityManagementService"
      }
    } with {
      briefly "from quality management service"
      described as {
        |Carries messages from the external QualityManagementService.
      }
    }
  } with {
    briefly "QualityManagementService integration"
    described as {
      |The model's side of the QualityManagementService conversation.
    }
  }
  adaptor ToQualityManagementService to context QualityManagementService is { 
    handler ToQualityManagementServiceHandler is {
      on query QualityManagementService.GetInspectionPlan is {
        do "the model sends get inspection plan"
      }
      on command QualityManagementService.RecordNonConformance is {
        do "the model sends record non conformance"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityManagementService"
      }
    } with {
      briefly "to quality management service"
      described as {
        |Carries messages to the external QualityManagementService.
      }
    }
  } with {
    briefly "QualityManagementService integration"
    described as {
      |The model's side of the QualityManagementService conversation.
    }
  }
  adaptor FromRoutingService from context RoutingService is { 
    handler FromRoutingServiceHandler is {
      on result RoutingService.ManufacturingRouting is {
        do "the model receives manufacturing routing"
      }
      on other is {
        error "Unexpected message for adaptor FromRoutingService"
      }
    } with {
      briefly "from routing service"
      described as {
        |Carries messages from the external RoutingService.
      }
    }
  } with {
    briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor ToRoutingService to context RoutingService is { 
    handler ToRoutingServiceHandler is {
      on query RoutingService.GetRouting is {
        do "the model sends get routing"
      }
      on other is {
        error "Unexpected message for adaptor ToRoutingService"
      }
    } with {
      briefly "to routing service"
      described as {
        |Carries messages to the external RoutingService.
      }
    }
  } with {
    briefly "RoutingService integration"
    described as {
      |The model's side of the RoutingService conversation.
    }
  }
  adaptor FromSchedulingService from context SchedulingService is { 
    handler FromSchedulingServiceHandler is {
      on result SchedulingService.WorkCenterLoad is {
        do "the model receives work center load"
      }
      on result SchedulingService.WorkOrderSchedule is {
        do "the model receives work order schedule"
      }
      on other is {
        error "Unexpected message for adaptor FromSchedulingService"
      }
    } with {
      briefly "from scheduling service"
      described as {
        |Carries messages from the external SchedulingService.
      }
    }
  } with {
    briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  adaptor ToSchedulingService to context SchedulingService is { 
    handler ToSchedulingServiceHandler is {
      on query SchedulingService.GetWorkCenterLoad is {
        do "the model sends get work center load"
      }
      on command SchedulingService.ScheduleWorkOrder is {
        do "the model sends schedule work order"
      }
      on other is {
        error "Unexpected message for adaptor ToSchedulingService"
      }
    } with {
      briefly "to scheduling service"
      described as {
        |Carries messages to the external SchedulingService.
      }
    }
  } with {
    briefly "SchedulingService integration"
    described as {
      |The model's side of the SchedulingService conversation.
    }
  }
  include "types.riddl"
  include "WorkOrder.riddl"
  type WorkOrderRepositoryCommand is one of {
    WorkOrderContext.WorkOrderRepository.PersistHoldReleased or WorkOrderContext.WorkOrderRepository.PersistLaborRecorded or WorkOrderContext.WorkOrderRepository.PersistMaterialsIssued or WorkOrderContext.WorkOrderRepository.PersistOperationCompleted or WorkOrderContext.WorkOrderRepository.PersistOperationStarted or WorkOrderContext.WorkOrderRepository.PersistQualityRecorded or WorkOrderContext.WorkOrderRepository.PersistWorkOrderCancelled or WorkOrderContext.WorkOrderRepository.PersistWorkOrderCompleted or WorkOrderContext.WorkOrderRepository.PersistWorkOrderCreated or WorkOrderContext.WorkOrderRepository.PersistWorkOrderOnHold or WorkOrderContext.WorkOrderRepository.PersistWorkOrderReleased or WorkOrderContext.WorkOrderRepository.PersistWorkOrderStarted
  } with {
    briefly "Anything that writes WorkOrderRepository"
    described as {
      |The persistence commands WorkOrderRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository WorkOrderRepository as flow is {
    inlet WorkOrderRepositoryFromProductionAnalytics is type WorkOrderRepositoryCommand
    command PersistHoldReleased is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row HoldReleased applies to.
        }
      }
    } with {
      briefly "Persist HoldReleased"
      described as {
        |Instructs this repository to apply HoldReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLaborRecorded is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row LaborRecorded applies to.
        }
      }
    } with {
      briefly "Persist LaborRecorded"
      described as {
        |Instructs this repository to apply LaborRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaterialsIssued is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaterialsIssued applies to.
        }
      }
    } with {
      briefly "Persist MaterialsIssued"
      described as {
        |Instructs this repository to apply MaterialsIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOperationStarted is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OperationStarted applies to.
        }
      }
    } with {
      briefly "Persist OperationStarted"
      described as {
        |Instructs this repository to apply OperationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkOrderCancelled is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderCancelled"
      described as {
        |Instructs this repository to apply WorkOrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkOrderCreated is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderCreated applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderCreated"
      described as {
        |Instructs this repository to apply WorkOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkOrderOnHold is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderOnHold applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderOnHold"
      described as {
        |Instructs this repository to apply WorkOrderOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkOrderReleased is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderReleased applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderReleased"
      described as {
        |Instructs this repository to apply WorkOrderReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOperationCompleted is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OperationCompleted applies to.
        }
      }
    } with {
      briefly "Persist OperationCompleted"
      described as {
        |Instructs this repository to apply OperationCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQualityRecorded is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row QualityRecorded applies to.
        }
      }
    } with {
      briefly "Persist QualityRecorded"
      described as {
        |Instructs this repository to apply QualityRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkOrderCompleted is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderCompleted applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderCompleted"
      described as {
        |Instructs this repository to apply WorkOrderCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkOrderStarted is  {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderStarted applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderStarted"
      described as {
        |Instructs this repository to apply WorkOrderStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet WorkOrderRepositoryResponses is type WorkOrder.WorkOrderResult
    record StoredWorkOrder is  {
      workOrderId: WorkOrderId with {
        briefly "workOrderId"
        described as {
          |The workOrderId column of the stored workOrder row.
        }
      }
      product: ProductInfo with {
        briefly "product"
        described as {
          |The product column of the stored workOrder row.
        }
      }
    } with {
      briefly "Stored workOrder row"
      described as {
        |The persistence shape of workOrder data as this repository stores it.
      }
    }
    schema WorkOrderData is relational
      of workOrders as type StoredWorkOrder
        index on field StoredWorkOrder.workOrderId
        index on field StoredWorkOrder.product.productId
        index on field StoredWorkOrder.status
 with {
      briefly "Work order data schema"
      described as {
        |The relational schema holding work order data for the WorkOrderRepository.
      }
    }
    handler WorkOrderPersistence is {
      on persistHoldReleased: command PersistHoldReleased is {
        do "apply HoldReleased to the stored row"
      }
      on persistLaborRecorded: command PersistLaborRecorded is {
        do "apply LaborRecorded to the stored row"
      }
      on persistMaterialsIssued: command PersistMaterialsIssued is {
        do "apply MaterialsIssued to the stored row"
      }
      on persistOperationStarted: command PersistOperationStarted is {
        do "apply OperationStarted to the stored row"
      }
      on persistWorkOrderCancelled: command PersistWorkOrderCancelled is {
        do "apply WorkOrderCancelled to the stored row"
      }
      on persistWorkOrderCreated: command PersistWorkOrderCreated is {
        do "apply WorkOrderCreated to the stored row"
      }
      on persistWorkOrderOnHold: command PersistWorkOrderOnHold is {
        do "apply WorkOrderOnHold to the stored row"
      }
      on persistWorkOrderReleased: command PersistWorkOrderReleased is {
        do "apply WorkOrderReleased to the stored row"
      }
      on persistOperationCompleted: command PersistOperationCompleted is {
        do "apply OperationCompleted to the stored row"
      }
      on persistQualityRecorded: command PersistQualityRecorded is {
        do "apply QualityRecorded to the stored row"
      }
      on persistWorkOrderCompleted: command PersistWorkOrderCompleted is {
        do "apply WorkOrderCompleted to the stored row"
      }
      on persistWorkOrderStarted: command PersistWorkOrderStarted is {
        do "apply WorkOrderStarted to the stored row"
      }
      on query GetProductionStats is {
        let productionStatsView: type ProductionStatsView = prompt("read the production stats projection")
        reply productionStatsView
      }
    } with {
      briefly "Persists work order events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Work order data persistence"
    described as {
      | The WorkOrderRepository provides persistent storage for
      | work orders, operations, and production data.
    }
  }
  query GetProductionStats replies result ProductionStatsView is  {
    productionStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which production stats to retrieve.
      }
    }
  } with {
    briefly "Get production stats"
    described as {
      |Retrieves the production stats projection.
    }
  }
  result ProductionStatsView is  {
    productionStats: ProductionAnalytics.ProductionStats with {
      briefly "Production stats"
      described as {
        |The production stats being returned.
      }
    }
  } with {
    briefly "Production stats view"
    described as {
      |Read model view carrying the production stats projection.
    }
  }
  projector ProductionAnalytics as flow is {
    outlet ProductionAnalyticsToRepository is type WorkOrderRepositoryCommand
    updates repository WorkOrderContext.WorkOrderRepository
    inlet ProductionAnalyticsFromWorkOrder is type WorkOrderEvent
    record ProductionStats is  {
      activeWorkOrders: Natural with {
        briefly "Active"
        described as {
          |Active work orders.
        }
      }
      completedToday: Natural with {
        briefly "Completed"
        described as {
          |Completed today.
        }
      }
      onTimeDelivery: Decimal(5,4) with {
        briefly "OTD"
        described as {
          |On-time delivery rate.
        }
      }
      firstPassYield: Decimal(5,4) with {
        briefly "FPY"
        described as {
          |First pass yield.
        }
      }
      oee: Decimal(5,4) with {
        briefly "OEE"
        described as {
          |Overall equipment effectiveness.
        }
      }
      averageCycleTime: Natural with {
        briefly "Cycle time"
        described as {
          |Average cycle time (min).
        }
      }
    } with {
      briefly "Production statistics"
      described as {
        |Manufacturing metrics.
      }
    }
    handler AnalyticsHandler is {
      on holdReleased: event WorkOrder.HoldReleased is {
        tell command WorkOrderContext.WorkOrderRepository.PersistHoldReleased(workOrderId = holdReleased.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply HoldReleased to the ProductionAnalytics projection"
      }
      on laborRecorded: event WorkOrder.LaborRecorded is {
        tell command WorkOrderContext.WorkOrderRepository.PersistLaborRecorded(workOrderId = laborRecorded.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply LaborRecorded to the ProductionAnalytics projection"
      }
      on materialsIssued: event WorkOrder.MaterialsIssued is {
        tell command WorkOrderContext.WorkOrderRepository.PersistMaterialsIssued(workOrderId = materialsIssued.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply MaterialsIssued to the ProductionAnalytics projection"
      }
      on operationStarted: event WorkOrder.OperationStarted is {
        tell command WorkOrderContext.WorkOrderRepository.PersistOperationStarted(workOrderId = operationStarted.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply OperationStarted to the ProductionAnalytics projection"
      }
      on workOrderCancelled: event WorkOrder.WorkOrderCancelled is {
        tell command WorkOrderContext.WorkOrderRepository.PersistWorkOrderCancelled(workOrderId = workOrderCancelled.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply WorkOrderCancelled to the ProductionAnalytics projection"
      }
      on workOrderCreated: event WorkOrder.WorkOrderCreated is {
        tell command WorkOrderContext.WorkOrderRepository.PersistWorkOrderCreated(workOrderId = workOrderCreated.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply WorkOrderCreated to the ProductionAnalytics projection"
      }
      on workOrderOnHold: event WorkOrder.WorkOrderOnHold is {
        tell command WorkOrderContext.WorkOrderRepository.PersistWorkOrderOnHold(workOrderId = workOrderOnHold.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply WorkOrderOnHold to the ProductionAnalytics projection"
      }
      on workOrderReleased: event WorkOrder.WorkOrderReleased is {
        tell command WorkOrderContext.WorkOrderRepository.PersistWorkOrderReleased(workOrderId = workOrderReleased.workOrderId) to repository WorkOrderContext.WorkOrderRepository
        do "apply WorkOrderReleased to the ProductionAnalytics projection"
      }
      on workOrderStarted: event WorkOrder.WorkOrderStarted is {
        tell command WorkOrderContext.WorkOrderRepository.PersistWorkOrderStarted(workOrderId = workOrderStarted.workOrderId) to repository WorkOrderContext.WorkOrderRepository
      }
      on workOrderCompleted: event WorkOrder.WorkOrderCompleted is {
        tell command WorkOrderContext.WorkOrderRepository.PersistWorkOrderCompleted(workOrderId = workOrderCompleted.workOrderId) to repository WorkOrderContext.WorkOrderRepository
      }
      on qualityRecorded: event WorkOrder.QualityRecorded is {
        tell command WorkOrderContext.WorkOrderRepository.PersistQualityRecorded(workOrderId = qualityRecorded.workOrderId) to repository WorkOrderContext.WorkOrderRepository
      }
      on operationCompleted: event WorkOrder.OperationCompleted is {
        tell command WorkOrderContext.WorkOrderRepository.PersistOperationCompleted(workOrderId = operationCompleted.workOrderId) to repository WorkOrderContext.WorkOrderRepository
      }
    } with {
      briefly "Maintains production analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Production analytics projections"
    described as {
      |Maintains manufacturing analytics data.
    }
  }
  type WorkOrderEvent is one of {
    WorkOrderContext.WorkOrder.WorkOrderCreated or WorkOrderContext.WorkOrder.WorkOrderCompleted or WorkOrderContext.WorkOrder.WorkOrderCancelled or WorkOrderContext.WorkOrder.HoldReleased or WorkOrderContext.WorkOrder.LaborRecorded or WorkOrderContext.WorkOrder.MaterialsIssued or WorkOrderContext.WorkOrder.OperationCompleted or WorkOrderContext.WorkOrder.OperationStarted or WorkOrderContext.WorkOrder.QualityRecorded or WorkOrderContext.WorkOrder.WorkOrderOnHold or WorkOrderContext.WorkOrder.WorkOrderReleased or WorkOrderContext.WorkOrder.WorkOrderStarted
  } with {
    briefly "WorkOrder event union"
    described as {
      |Union of WorkOrder events for streaming.
    }
  }
  processor WorkOrderEventSplit as flow is {
    inlet WorkOrderEventSplitIn is type WorkOrderEvent
    outlet WorkOrderEventSplitToProductionAnalytics is type WorkOrderEvent
    handler WorkOrderEventSplitHandler is {
      on workOrderCreated: event WorkOrder.WorkOrderCreated is {
        send workOrderCreated to outlet WorkOrderEventSplitToProductionAnalytics
        tell workOrderCreated to entity WorkOrderContext.WorkOrder
      }
      on workOrderReleased: event WorkOrder.WorkOrderReleased is {
        send workOrderReleased to outlet WorkOrderEventSplitToProductionAnalytics
        tell workOrderReleased to entity WorkOrderContext.WorkOrder
      }
      on materialsIssued: event WorkOrder.MaterialsIssued is {
        send materialsIssued to outlet WorkOrderEventSplitToProductionAnalytics
        tell materialsIssued to entity WorkOrderContext.WorkOrder
      }
      on workOrderStarted: event WorkOrder.WorkOrderStarted is {
        send workOrderStarted to outlet WorkOrderEventSplitToProductionAnalytics
        tell workOrderStarted to entity WorkOrderContext.WorkOrder
      }
      on operationStarted: event WorkOrder.OperationStarted is {
        send operationStarted to outlet WorkOrderEventSplitToProductionAnalytics
        tell operationStarted to entity WorkOrderContext.WorkOrder
      }
      on operationCompleted: event WorkOrder.OperationCompleted is {
        send operationCompleted to outlet WorkOrderEventSplitToProductionAnalytics
        tell operationCompleted to entity WorkOrderContext.WorkOrder
      }
      on laborRecorded: event WorkOrder.LaborRecorded is {
        send laborRecorded to outlet WorkOrderEventSplitToProductionAnalytics
        tell laborRecorded to entity WorkOrderContext.WorkOrder
      }
      on qualityRecorded: event WorkOrder.QualityRecorded is {
        send qualityRecorded to outlet WorkOrderEventSplitToProductionAnalytics
        tell qualityRecorded to entity WorkOrderContext.WorkOrder
      }
      on workOrderOnHold: event WorkOrder.WorkOrderOnHold is {
        send workOrderOnHold to outlet WorkOrderEventSplitToProductionAnalytics
        tell workOrderOnHold to entity WorkOrderContext.WorkOrder
      }
      on holdReleased: event WorkOrder.HoldReleased is {
        send holdReleased to outlet WorkOrderEventSplitToProductionAnalytics
        tell holdReleased to entity WorkOrderContext.WorkOrder
      }
      on workOrderCompleted: event WorkOrder.WorkOrderCompleted is {
        send workOrderCompleted to outlet WorkOrderEventSplitToProductionAnalytics
        tell workOrderCompleted to entity WorkOrderContext.WorkOrder
      }
      on workOrderCancelled: event WorkOrder.WorkOrderCancelled is {
        send workOrderCancelled to outlet WorkOrderEventSplitToProductionAnalytics
        tell workOrderCancelled to entity WorkOrderContext.WorkOrder
      }
      on other is {
        error "Unexpected message for processor WorkOrderEventSplit"
      }
    } with {
      briefly "WorkOrder event fan-out handler"
      described as {
        |Delivers each WorkOrder event to all of its consumers.
      }
    }
  } with {
    briefly "WorkOrder event fan-out"
    described as {
      |Fans WorkOrder events out to the repository and projectors.
    }
  }
  connector 'WorkOrderEvent Stream' is from outlet WorkOrderContext.WorkOrder.WorkOrderEvents2 to inlet WorkOrderContext.WorkOrderEventSplit.WorkOrderEventSplitIn with {
    briefly "WorkOrder events, fanned out to storage and read models"
  }
  connector 'ProductionAnalytics Feed' is from outlet WorkOrderContext.WorkOrderEventSplit.WorkOrderEventSplitToProductionAnalytics to inlet WorkOrderContext.ProductionAnalytics.ProductionAnalyticsFromWorkOrder with {
    briefly "WorkOrder events feeding the ProductionAnalytics projection"
  }
  connector 'ProductionAnalytics Storage' is from outlet WorkOrderContext.ProductionAnalytics.ProductionAnalyticsToRepository to inlet WorkOrderContext.WorkOrderRepository.WorkOrderRepositoryFromProductionAnalytics with {
    briefly "ProductionAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for work order management"
  described as {
    | The WorkOrderContext is the bounded context for
    | manufacturing work orders and production control.
  }
}
