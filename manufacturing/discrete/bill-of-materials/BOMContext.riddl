// Bill of Materials Management - BOM Context
context BOMContext as router is {
  inlet BillOfMaterialsCommandStreamIn is type BillOfMaterialsCommand  outlet BillOfMaterialsCommandStreamOut is type BillOfMaterialsCommand
  inlet BillOfMaterialsResultStreamIn is result BillOfMaterials.BillOfMaterialsResult  outlet BillOfMaterialsResultStreamOut is result BillOfMaterials.BillOfMaterialsResult
  handler BOMContextBoundary is {
    on createBOM: command BillOfMaterials.CreateBOM is {
      send createBOM to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on addItem: command BillOfMaterials.AddItem is {
      send addItem to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on removeItem: command BillOfMaterials.RemoveItem is {
      send removeItem to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on updateQuantity: command BillOfMaterials.UpdateQuantity is {
      send updateQuantity to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on updateItem: command BillOfMaterials.UpdateItem is {
      send updateItem to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on releaseBOM: command BillOfMaterials.ReleaseBOM is {
      send releaseBOM to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on reviseBOM: command BillOfMaterials.ReviseBOM is {
      send reviseBOM to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on obsoleteBOM: command BillOfMaterials.ObsoleteBOM is {
      send obsoleteBOM to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on calculateCost: command BillOfMaterials.CalculateCost is {
      send calculateCost to outlet BOMContext.BillOfMaterialsCommandStreamOut
    }
    on billOfMaterialsResult: result BillOfMaterials.BillOfMaterialsResult is {
      send billOfMaterialsResult to outlet BOMContext.BillOfMaterialsResultStreamOut
    }
    on other is {
      error "Unexpected message at the BOMContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BillOfMaterialsCommand Stream Intake' is from outlet BOMContext.BillOfMaterialsCommandStreamOut to inlet BOMContext.BillOfMaterials.BillOfMaterialsCommands  connector 'BillOfMaterialsResult Stream Egress' is from outlet BOMContext.BOMRepository.BOMRepositoryResponses to inlet BOMContext.BillOfMaterialsResultStreamIn  adaptor FromCostingService from context CostingService is { 
    handler FromCostingServiceHandler is {
      on event CostingService.StandardCostUpdated is {
        do "the model receives standard cost updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCostingService"
      }
    } with {
      briefly "from costing service"
      described as {
        |Carries messages from the external CostingService.
      }
    }
  } with {
    briefly "CostingService integration"
    described as {
      |The model's side of the CostingService conversation.
    }
  }
  adaptor ToCostingService to context CostingService is { 
    handler ToCostingServiceHandler is {
      on query CostingService.GetBOMRollupCost is {
        do "the model sends get bom rollup cost"
      }
      on query CostingService.GetStandardCost is {
        do "the model sends get standard cost"
      }
      on command CostingService.UpdateStandardCost is {
        do "the model sends update standard cost"
      }
      on other is {
        error "Unexpected message for adaptor ToCostingService"
      }
    } with {
      briefly "to costing service"
      described as {
        |Carries messages to the external CostingService.
      }
    }
  } with {
    briefly "CostingService integration"
    described as {
      |The model's side of the CostingService conversation.
    }
  }
  adaptor FromEngineeringChangeService from context EngineeringChangeService is { 
    handler FromEngineeringChangeServiceHandler is {
      on event EngineeringChangeService.ChangeApproved is {
        do "the model receives change approved"
      }
      on event EngineeringChangeService.ChangeImplemented is {
        do "the model receives change implemented"
      }
      on event EngineeringChangeService.ChangeRequestCreated is {
        do "the model receives change request created"
      }
      on result EngineeringChangeService.EngineeringChange is {
        do "the model receives engineering change"
      }
      on other is {
        error "Unexpected message for adaptor FromEngineeringChangeService"
      }
    } with {
      briefly "from engineering change service"
      described as {
        |Carries messages from the external EngineeringChangeService.
      }
    }
  } with {
    briefly "EngineeringChangeService integration"
    described as {
      |The model's side of the EngineeringChangeService conversation.
    }
  }
  adaptor ToEngineeringChangeService to context EngineeringChangeService is { 
    handler ToEngineeringChangeServiceHandler is {
      on query EngineeringChangeService.GetEngineeringChange is {
        do "the model sends get engineering change"
      }
      on command EngineeringChangeService.RequestBOMChange is {
        do "the model sends request bom change"
      }
      on other is {
        error "Unexpected message for adaptor ToEngineeringChangeService"
      }
    } with {
      briefly "to engineering change service"
      described as {
        |Carries messages to the external EngineeringChangeService.
      }
    }
  } with {
    briefly "EngineeringChangeService integration"
    described as {
      |The model's side of the EngineeringChangeService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on result InventoryService.BOMAvailabilityCheck is {
        do "the model receives bom availability check"
      }
      on result InventoryService.ComponentAvailability is {
        do "the model receives component availability"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on query InventoryService.GetComponentAvailability is {
        do "the model sends get component availability"
      }
      on query InventoryService.GetMultipleComponentAvailability is {
        do "the model sends get multiple component availability"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromProductDataService from context ProductDataService is { 
    handler FromProductDataServiceHandler is {
      on result ProductDataService.ComponentInfo is {
        do "the model receives component info"
      }
      on result ProductDataService.ProductInfo is {
        do "the model receives product info"
      }
      on other is {
        error "Unexpected message for adaptor FromProductDataService"
      }
    } with {
      briefly "from product data service"
      described as {
        |Carries messages from the external ProductDataService.
      }
    }
  } with {
    briefly "ProductDataService integration"
    described as {
      |The model's side of the ProductDataService conversation.
    }
  }
  adaptor ToProductDataService to context ProductDataService is { 
    handler ToProductDataServiceHandler is {
      on query ProductDataService.GetComponentInfo is {
        do "the model sends get component info"
      }
      on query ProductDataService.GetProductInfo is {
        do "the model sends get product info"
      }
      on other is {
        error "Unexpected message for adaptor ToProductDataService"
      }
    } with {
      briefly "to product data service"
      described as {
        |Carries messages to the external ProductDataService.
      }
    }
  } with {
    briefly "ProductDataService integration"
    described as {
      |The model's side of the ProductDataService conversation.
    }
  }
  include "types.riddl"
  include "BillOfMaterials.riddl"
  type BOMRepositoryCommand is one of {
    BOMContext.BOMRepository.PersistBOMCreated or BOMContext.BOMRepository.PersistBOMObsoleted or BOMContext.BOMRepository.PersistBOMReleased or BOMContext.BOMRepository.PersistBOMRevised or BOMContext.BOMRepository.PersistCostCalculated or BOMContext.BOMRepository.PersistItemAdded or BOMContext.BOMRepository.PersistItemRemoved or BOMContext.BOMRepository.PersistItemUpdated or BOMContext.BOMRepository.PersistQuantityUpdated
  } with {
    briefly "Anything that writes BOMRepository"
    described as {
      |The persistence commands BOMRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BOMRepository as flow is {
    inlet BOMRepositoryFromBOMAnalytics is type BOMRepositoryCommand
    command PersistBOMReleased is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row BOMReleased applies to.
        }
      }
    } with {
      briefly "Persist BOMReleased"
      described as {
        |Instructs this repository to apply BOMReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemUpdated is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemUpdated applies to.
        }
      }
    } with {
      briefly "Persist ItemUpdated"
      described as {
        |Instructs this repository to apply ItemUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistQuantityUpdated is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row QuantityUpdated applies to.
        }
      }
    } with {
      briefly "Persist QuantityUpdated"
      described as {
        |Instructs this repository to apply QuantityUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBOMCreated is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row BOMCreated applies to.
        }
      }
    } with {
      briefly "Persist BOMCreated"
      described as {
        |Instructs this repository to apply BOMCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBOMObsoleted is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row BOMObsoleted applies to.
        }
      }
    } with {
      briefly "Persist BOMObsoleted"
      described as {
        |Instructs this repository to apply BOMObsoleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBOMRevised is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row BOMRevised applies to.
        }
      }
    } with {
      briefly "Persist BOMRevised"
      described as {
        |Instructs this repository to apply BOMRevised to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCostCalculated is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row CostCalculated applies to.
        }
      }
    } with {
      briefly "Persist CostCalculated"
      described as {
        |Instructs this repository to apply CostCalculated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAdded is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemAdded applies to.
        }
      }
    } with {
      briefly "Persist ItemAdded"
      described as {
        |Instructs this repository to apply ItemAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRemoved is  {
      bomId: BOMId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemRemoved applies to.
        }
      }
    } with {
      briefly "Persist ItemRemoved"
      described as {
        |Instructs this repository to apply ItemRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BOMRepositoryResponses is result BillOfMaterials.BillOfMaterialsResult
    record StoredBillOfMaterials is  {
      billOfMaterialsId: UUID with {
        briefly "billOfMaterialsId"
        described as {
          |The billOfMaterialsId column of the stored billOfMaterials row.
        }
      }
      bomId: BOMId with {
        briefly "bomId"
        described as {
          |The bomId column of the stored billOfMaterials row.
        }
      }
      header: BOMHeader with {
        briefly "header"
        described as {
          |The header column of the stored billOfMaterials row.
        }
      }
    } with {
      briefly "Stored billOfMaterials row"
      described as {
        |The persistence shape of billOfMaterials data as this repository stores it.
      }
    }
    schema BOMData is relational
      of boms as record StoredBillOfMaterials
        index on field StoredBillOfMaterials.bomId
        index on field StoredBillOfMaterials.header.productId
        index on field StoredBillOfMaterials.header.revision
        index on field StoredBillOfMaterials.header.status
 with {
      briefly "Bom data schema"
      described as {
        |The relational schema holding bom data for the BOMRepository.
      }
    }
    handler BOMPersistence is {
      on persistBOMReleased: command PersistBOMReleased is {
        do "apply BOMReleased to the stored row"
      }
      on persistItemUpdated: command PersistItemUpdated is {
        do "apply ItemUpdated to the stored row"
      }
      on persistQuantityUpdated: command PersistQuantityUpdated is {
        do "apply QuantityUpdated to the stored row"
      }
      on persistBOMCreated: command PersistBOMCreated is {
        do "apply BOMCreated to the stored row"
      }
      on persistBOMObsoleted: command PersistBOMObsoleted is {
        do "apply BOMObsoleted to the stored row"
      }
      on persistBOMRevised: command PersistBOMRevised is {
        do "apply BOMRevised to the stored row"
      }
      on persistCostCalculated: command PersistCostCalculated is {
        do "apply CostCalculated to the stored row"
      }
      on persistItemAdded: command PersistItemAdded is {
        do "apply ItemAdded to the stored row"
      }
      on persistItemRemoved: command PersistItemRemoved is {
        do "apply ItemRemoved to the stored row"
      }
      on query GetComponentUsageStats is {
        let componentUsageStatsView: type ComponentUsageStatsView = prompt("read the component usage stats projection")
        reply componentUsageStatsView
      }
      on query GetCostAnalytics is {
        let costAnalyticsView: type CostAnalyticsView = prompt("read the cost analytics projection")
        reply costAnalyticsView
      }
      on query GetRevisionMetrics is {
        let revisionMetricsView: type RevisionMetricsView = prompt("read the revision metrics projection")
        reply revisionMetricsView
      }
      on query GetWhereUsedIndex is {
        let whereUsedIndexView: type WhereUsedIndexView = prompt("read the where used index projection")
        reply whereUsedIndexView
      }
    } with {
      briefly "Persists BOM commands"
      described as {
        |Handles command-driven persistence for BOMs.
      }
    }
  } with {
    briefly "BOM data persistence"
    described as {
      | The BOMRepository provides persistent storage for
      | bills of materials, items, revisions, and costs.
    }
  }
  query GetComponentUsageStats replies result ComponentUsageStatsView is  {
    componentUsageStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which component usage stats to retrieve.
      }
    }
  } with {
    briefly "Get component usage stats"
    described as {
      |Retrieves the component usage stats projection.
    }
  }
  result ComponentUsageStatsView is  {
    componentUsageStats: BOMAnalytics.ComponentUsageStats with {
      briefly "Component usage stats"
      described as {
        |The component usage stats being returned.
      }
    }
  } with {
    briefly "Component usage stats view"
    described as {
      |Read model view carrying the component usage stats projection.
    }
  }
  query GetCostAnalytics replies result CostAnalyticsView is  {
    costAnalyticsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cost analytics to retrieve.
      }
    }
  } with {
    briefly "Get cost analytics"
    described as {
      |Retrieves the cost analytics projection.
    }
  }
  result CostAnalyticsView is  {
    costAnalytics: BOMAnalytics.CostAnalytics with {
      briefly "Cost analytics"
      described as {
        |The cost analytics being returned.
      }
    }
  } with {
    briefly "Cost analytics view"
    described as {
      |Read model view carrying the cost analytics projection.
    }
  }
  query GetRevisionMetrics replies result RevisionMetricsView is  {
    revisionMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which revision metrics to retrieve.
      }
    }
  } with {
    briefly "Get revision metrics"
    described as {
      |Retrieves the revision metrics projection.
    }
  }
  result RevisionMetricsView is  {
    revisionMetrics: BOMAnalytics.RevisionMetrics with {
      briefly "Revision metrics"
      described as {
        |The revision metrics being returned.
      }
    }
  } with {
    briefly "Revision metrics view"
    described as {
      |Read model view carrying the revision metrics projection.
    }
  }
  projector BOMAnalytics as flow is {
    outlet BOMAnalyticsToRepository is type BOMRepositoryCommand
    updates repository BOMContext.BOMRepository
    inlet BOMAnalyticsFromBillOfMaterials is type BillOfMaterialsEvent
    record ComponentUsageStats is  {
      totalComponents: Natural with {
        briefly "Total components"
        described as {
          |Total unique components across all BOMs.
        }
      }
      averageItemsPerBOM: Decimal(10,2) with {
        briefly "Avg items"
        described as {
          |Average line items per BOM.
        }
      }
      mostUsedComponents: ComponentId+ with {
        briefly "Most used"
        described as {
          |Top 10 most frequently used components.
        }
      }
      singleSourceComponents: ComponentId+ with {
        briefly "Single source"
        described as {
          |Components with only one supplier.
        }
      }
    } with {
      briefly "Component usage statistics"
      described as {
        |Analytics on component usage patterns.
      }
    }
    record CostAnalytics is  {
      averageMaterialCost: Decimal(15,4) with {
        briefly "Avg material"
        described as {
          |Average material cost across BOMs.
        }
      }
      averageLaborCost: Decimal(15,4) with {
        briefly "Avg labor"
        described as {
          |Average labor cost across BOMs.
        }
      }
      costVariancePercent: Decimal(5,2) with {
        briefly "Variance"
        described as {
          |Cost variance from standard.
        }
      }
      highCostItems: ItemId+ with {
        briefly "High cost items"
        described as {
          |Items exceeding cost threshold.
        }
      }
    } with {
      briefly "Cost analytics"
      described as {
        |Cost analysis metrics.
      }
    }
    record RevisionMetrics is  {
      averageRevisionsPerBOM: Decimal(5,2) with {
        briefly "Avg revisions"
        described as {
          |Average revisions per BOM.
        }
      }
      revisionsThisMonth: Natural with {
        briefly "Monthly revisions"
        described as {
          |Number of revisions this month.
        }
      }
      topChangedBOMs: BOMId+ with {
        briefly "Most changed"
        described as {
          |BOMs with most revisions.
        }
      }
    } with {
      briefly "Revision metrics"
      described as {
        |BOM revision analytics.
      }
    }
    handler AnalyticsHandler is {
      on bOMReleased: event BillOfMaterials.BOMReleased is {
        tell command BOMContext.BOMRepository.PersistBOMReleased(bomId = bOMReleased.bomId) to repository BOMContext.BOMRepository
        do "apply BOMReleased to the BOMAnalytics projection"
      }
      on itemUpdated: event BillOfMaterials.ItemUpdated is {
        tell command BOMContext.BOMRepository.PersistItemUpdated(bomId = itemUpdated.bomId) to repository BOMContext.BOMRepository
        do "apply ItemUpdated to the BOMAnalytics projection"
      }
      on quantityUpdated: event BillOfMaterials.QuantityUpdated is {
        tell command BOMContext.BOMRepository.PersistQuantityUpdated(bomId = quantityUpdated.bomId) to repository BOMContext.BOMRepository
        do "apply QuantityUpdated to the BOMAnalytics projection"
      }
      on bOMCreated: event BillOfMaterials.BOMCreated is {
        tell command BOMContext.BOMRepository.PersistBOMCreated(bomId = bOMCreated.bomId) to repository BOMContext.BOMRepository
      }
      on itemAdded: event BillOfMaterials.ItemAdded is {
        tell command BOMContext.BOMRepository.PersistItemAdded(bomId = itemAdded.bomId) to repository BOMContext.BOMRepository
      }
      on itemRemoved: event BillOfMaterials.ItemRemoved is {
        tell command BOMContext.BOMRepository.PersistItemRemoved(bomId = itemRemoved.bomId) to repository BOMContext.BOMRepository
      }
      on costCalculated: event BillOfMaterials.CostCalculated is {
        tell command BOMContext.BOMRepository.PersistCostCalculated(bomId = costCalculated.bomId) to repository BOMContext.BOMRepository
      }
      on bOMRevised: event BillOfMaterials.BOMRevised is {
        tell command BOMContext.BOMRepository.PersistBOMRevised(bomId = bOMRevised.bomId) to repository BOMContext.BOMRepository
      }
      on bOMObsoleted: event BillOfMaterials.BOMObsoleted is {
        tell command BOMContext.BOMRepository.PersistBOMObsoleted(bomId = bOMObsoleted.bomId) to repository BOMContext.BOMRepository
      }
    } with {
      briefly "Maintains BOM analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "BOM analytics projections"
    described as {
      |Maintains component usage, cost, and revision analytics.
    }
  }
  query GetWhereUsedIndex replies result WhereUsedIndexView is  {
    whereUsedIndexKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which where used index to retrieve.
      }
    }
  } with {
    briefly "Get where used index"
    described as {
      |Retrieves the where used index projection.
    }
  }
  result WhereUsedIndexView is  {
    whereUsedIndex: WhereUsedProjector.WhereUsedIndex with {
      briefly "Where used index"
      described as {
        |The where used index being returned.
      }
    }
  } with {
    briefly "Where used index view"
    described as {
      |Read model view carrying the where used index projection.
    }
  }
  projector WhereUsedProjector as sink is {
    updates repository BOMContext.BOMRepository
    inlet WhereUsedProjectorFromBillOfMaterials is type BillOfMaterialsEvent
    record WhereUsedIndex is  {
      componentId: ComponentId with {
        briefly "Component"
        described as {
          |Component identifier.
        }
      }
      parentBOMs: BOMId+ with {
        briefly "Parent BOMs"
        described as {
          |BOMs that use this component.
        }
      }
      totalUsageCount: Natural with {
        briefly "Usage count"
        described as {
          |Total number of usages across all BOMs.
        }
      }
      lastUpdated: TimeStamp with {
        briefly "Last updated"
        described as {
          |When the index was last updated.
        }
      }
    } with {
      briefly "Where-used index entry"
      described as {
        |Index entry tracking component to parent relationships.
      }
    }
    handler WhereUsedHandler is {
      on bOMCreated: event BillOfMaterials.BOMCreated is {
        tell command BOMContext.BOMRepository.PersistBOMCreated(bomId = bOMCreated.bomId) to repository BOMContext.BOMRepository
        do "apply BOMCreated to the WhereUsedProjector projection"
      }
      on bOMReleased: event BillOfMaterials.BOMReleased is {
        tell command BOMContext.BOMRepository.PersistBOMReleased(bomId = bOMReleased.bomId) to repository BOMContext.BOMRepository
        do "apply BOMReleased to the WhereUsedProjector projection"
      }
      on bOMRevised: event BillOfMaterials.BOMRevised is {
        tell command BOMContext.BOMRepository.PersistBOMRevised(bomId = bOMRevised.bomId) to repository BOMContext.BOMRepository
        do "apply BOMRevised to the WhereUsedProjector projection"
      }
      on costCalculated: event BillOfMaterials.CostCalculated is {
        tell command BOMContext.BOMRepository.PersistCostCalculated(bomId = costCalculated.bomId) to repository BOMContext.BOMRepository
        do "apply CostCalculated to the WhereUsedProjector projection"
      }
      on itemUpdated: event BillOfMaterials.ItemUpdated is {
        tell command BOMContext.BOMRepository.PersistItemUpdated(bomId = itemUpdated.bomId) to repository BOMContext.BOMRepository
        do "apply ItemUpdated to the WhereUsedProjector projection"
      }
      on quantityUpdated: event BillOfMaterials.QuantityUpdated is {
        tell command BOMContext.BOMRepository.PersistQuantityUpdated(bomId = quantityUpdated.bomId) to repository BOMContext.BOMRepository
        do "apply QuantityUpdated to the WhereUsedProjector projection"
      }
      on itemAdded: event BillOfMaterials.ItemAdded is {
        tell command BOMContext.BOMRepository.PersistItemAdded(bomId = itemAdded.bomId) to repository BOMContext.BOMRepository
      }
      on itemRemoved: event BillOfMaterials.ItemRemoved is {
        tell command BOMContext.BOMRepository.PersistItemRemoved(bomId = itemRemoved.bomId) to repository BOMContext.BOMRepository
      }
      on bOMObsoleted: event BillOfMaterials.BOMObsoleted is {
        tell command BOMContext.BOMRepository.PersistBOMObsoleted(bomId = bOMObsoleted.bomId) to repository BOMContext.BOMRepository
      }
    } with {
      briefly "Maintains where-used index"
      described as {
        |Tracks which BOMs use each component.
      }
    }
  } with {
    briefly "Where-used projections"
    described as {
      |Maintains reverse index for component to parent lookup.
    }
  }
  type BillOfMaterialsEvent is one of {
    BOMContext.BillOfMaterials.BOMCreated or BOMContext.BillOfMaterials.BOMReleased or BOMContext.BillOfMaterials.BOMObsoleted or BOMContext.BillOfMaterials.BOMRevised or BOMContext.BillOfMaterials.CostCalculated or BOMContext.BillOfMaterials.ItemAdded or BOMContext.BillOfMaterials.ItemRemoved or BOMContext.BillOfMaterials.ItemUpdated or BOMContext.BillOfMaterials.QuantityUpdated
  } with {
    briefly "BillOfMaterials event union"
    described as {
      |Union of BillOfMaterials events for streaming.
    }
  }
  processor BillOfMaterialsEventSplit as split is {
    inlet BillOfMaterialsEventSplitIn is type BillOfMaterialsEvent
    outlet BillOfMaterialsEventSplitToBOMAnalytics is type BillOfMaterialsEvent
    outlet BillOfMaterialsEventSplitToWhereUsedProjector is type BillOfMaterialsEvent
    handler BillOfMaterialsEventSplitHandler is {
      on bOMCreated: event BillOfMaterials.BOMCreated is {
        send bOMCreated to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send bOMCreated to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell bOMCreated to entity BOMContext.BillOfMaterials
      }
      on itemAdded: event BillOfMaterials.ItemAdded is {
        send itemAdded to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send itemAdded to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell itemAdded to entity BOMContext.BillOfMaterials
      }
      on itemRemoved: event BillOfMaterials.ItemRemoved is {
        send itemRemoved to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send itemRemoved to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell itemRemoved to entity BOMContext.BillOfMaterials
      }
      on quantityUpdated: event BillOfMaterials.QuantityUpdated is {
        send quantityUpdated to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send quantityUpdated to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell quantityUpdated to entity BOMContext.BillOfMaterials
      }
      on itemUpdated: event BillOfMaterials.ItemUpdated is {
        send itemUpdated to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send itemUpdated to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell itemUpdated to entity BOMContext.BillOfMaterials
      }
      on bOMReleased: event BillOfMaterials.BOMReleased is {
        send bOMReleased to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send bOMReleased to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell bOMReleased to entity BOMContext.BillOfMaterials
      }
      on bOMRevised: event BillOfMaterials.BOMRevised is {
        send bOMRevised to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send bOMRevised to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell bOMRevised to entity BOMContext.BillOfMaterials
      }
      on bOMObsoleted: event BillOfMaterials.BOMObsoleted is {
        send bOMObsoleted to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send bOMObsoleted to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell bOMObsoleted to entity BOMContext.BillOfMaterials
      }
      on costCalculated: event BillOfMaterials.CostCalculated is {
        send costCalculated to outlet BillOfMaterialsEventSplitToBOMAnalytics
        send costCalculated to outlet BillOfMaterialsEventSplitToWhereUsedProjector
        tell costCalculated to entity BOMContext.BillOfMaterials
      }
      on other is {
        error "Unexpected message for processor BillOfMaterialsEventSplit"
      }
    } with {
      briefly "BillOfMaterials event fan-out handler"
      described as {
        |Delivers each BillOfMaterials event to all of its consumers.
      }
    }
  } with {
    briefly "BillOfMaterials event fan-out"
    described as {
      |Fans BillOfMaterials events out to the repository and projectors.
    }
  }
  connector 'BillOfMaterialsEvent Stream' is from outlet BOMContext.BillOfMaterials.BillOfMaterialsEvents2 to inlet BOMContext.BillOfMaterialsEventSplit.BillOfMaterialsEventSplitIn with {
    briefly "BillOfMaterials events, fanned out to storage and read models"
  }
  connector 'BOMAnalytics Feed' is from outlet BOMContext.BillOfMaterialsEventSplit.BillOfMaterialsEventSplitToBOMAnalytics to inlet BOMContext.BOMAnalytics.BOMAnalyticsFromBillOfMaterials with {
    briefly "BillOfMaterials events feeding the BOMAnalytics projection"
  }
  connector 'WhereUsedProjector Feed' is from outlet BOMContext.BillOfMaterialsEventSplit.BillOfMaterialsEventSplitToWhereUsedProjector to inlet BOMContext.WhereUsedProjector.WhereUsedProjectorFromBillOfMaterials with {
    briefly "BillOfMaterials events feeding the WhereUsedProjector projection"
  }
  connector 'BOMAnalytics Storage' is from outlet BOMContext.BOMAnalytics.BOMAnalyticsToRepository to inlet BOMContext.BOMRepository.BOMRepositoryFromBOMAnalytics with {
    briefly "BOMAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for bill of materials management"
  described as {
    | The BOMContext is the bounded context for
    | product structure, components, and cost analysis.
  }
}
