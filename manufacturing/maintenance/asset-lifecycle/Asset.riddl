// Asset Lifecycle Management - Asset Entity
entity Asset as flow is {
  type AssetCommand is one of {
    Asset.RegisterAsset or Asset.InstallAsset or Asset.TransferAsset or Asset.UpdateValuation or Asset.ScheduleDepreciation or Asset.RecordMaintenance or Asset.DecommissionAsset or Asset.DisposeAsset
  } with {
    briefly "Asset command alternation"
    described as {
      |Commands accepted by the Asset entity.
    }
  }
  inlet AssetCommands is type AssetCommand  outlet AssetEvents2 is type AssetEvent
  // Commands
  command RegisterAsset is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |New asset identifier.
      }
    }
    assetInfo: AssetInfo with {
      briefly "Asset info"
      described as {
        |Core asset information.
      }
    }
    financialInfo: FinancialInfo with {
      briefly "Financial info"
      described as {
        |Financial details.
      }
    }
    vendorId: VendorId with {
      briefly "Vendor"
      described as {
        |Supplier vendor identifier.
      }
    }
    registeredBy: String(1,200) with {
      briefly "Registered by"
      described as {
        |Person registering the asset.
      }
    }
  } with {
    briefly "Register asset"
    described as {
      |Registers a new asset in the system.
    }
  }
  command InstallAsset is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |Asset identifier.
      }
    }
    installation: InstallationInfo with {
      briefly "Installation"
      described as {
        |Installation details.
      }
    }
  } with {
    briefly "Install asset"
    described as {
      |Records asset installation at a location.
    }
  }
  command TransferAsset is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |Asset identifier.
      }
    }
    transfer: LocationTransfer with {
      briefly "Transfer"
      described as {
        |Transfer details.
      }
    }
  } with {
    briefly "Transfer asset"
    described as {
      |Transfers asset to a new location.
    }
  }
  command UpdateValuation is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |Asset identifier.
      }
    }
    valuation: ValuationInfo with {
      briefly "Valuation"
      described as {
        |New valuation information.
      }
    }
  } with {
    briefly "Update valuation"
    described as {
      |Updates asset book value.
    }
  }
  command ScheduleDepreciation is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |Asset identifier.
      }
    }
    schedule: DepreciationSchedule with {
      briefly "Schedule"
      described as {
        |Depreciation schedule parameters.
      }
    }
  } with {
    briefly "Schedule depreciation"
    described as {
      |Sets up depreciation schedule for asset.
    }
  }
  command RecordMaintenance is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |Asset identifier.
      }
    }
    maintenance: MaintenanceEntry with {
      briefly "Maintenance"
      described as {
        |Maintenance entry details.
      }
    }
  } with {
    briefly "Record maintenance"
    described as {
      |Records maintenance performed on asset.
    }
  }
  command DecommissionAsset is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |Asset identifier.
      }
    }
    decommission: DecommissionInfo with {
      briefly "Decommission"
      described as {
        |Decommission details.
      }
    }
  } with {
    briefly "Decommission asset"
    described as {
      |Removes asset from active service.
    }
  }
  command DisposeAsset is {
    assetId: AssetId with {
      briefly "Asset ID"
      described as {
        |Asset identifier.
      }
    }
    disposal: DisposalInfo with {
      briefly "Disposal"
      described as {
        |Disposal details.
      }
    }
  } with {
    briefly "Dispose asset"
    described as {
      |Permanently disposes of the asset.
    }
  }
  // Events
  event AssetRegistered is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    assetInfo: AssetInfo with {
      briefly "Info"
      described as {
        |Asset information.
      }
    }
    financialInfo: FinancialInfo with {
      briefly "Financial"
      described as {
        |Financial info.
      }
    }
    vendorId: VendorId with {
      briefly "Vendor"
      described as {
        |Vendor ID.
      }
    }
    registeredBy: String(1,200) with {
      briefly "Registered by"
      described as {
        |Person registering.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Asset registered"
    described as {
      |Emitted when a new asset is registered.
    }
  }
  event AssetInstalled is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    installation: InstallationInfo with {
      briefly "Installation"
      described as {
        |Installation details.
      }
    }
    installedAt: TimeStamp with {
      briefly "Installed"
      described as {
        |Installation time.
      }
    }
  } with {
    briefly "Asset installed"
    described as {
      |Emitted when asset is installed at a location.
    }
  }
  event AssetTransferred is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    transfer: LocationTransfer with {
      briefly "Transfer"
      described as {
        |Transfer details.
      }
    }
    transferredAt: TimeStamp with {
      briefly "Transferred"
      described as {
        |Transfer time.
      }
    }
  } with {
    briefly "Asset transferred"
    described as {
      |Emitted when asset is transferred to new location.
    }
  }
  event ValuationUpdated is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    valuation: ValuationInfo with {
      briefly "Valuation"
      described as {
        |Valuation details.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Valuation updated"
    described as {
      |Emitted when asset valuation is updated.
    }
  }
  event DepreciationScheduled is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    schedule: DepreciationSchedule with {
      briefly "Schedule"
      described as {
        |Depreciation schedule.
      }
    }
    scheduledAt: TimeStamp with {
      briefly "Scheduled"
      described as {
        |Schedule time.
      }
    }
  } with {
    briefly "Depreciation scheduled"
    described as {
      |Emitted when depreciation schedule is set.
    }
  }
  event MaintenanceRecorded is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    maintenance: MaintenanceEntry with {
      briefly "Maintenance"
      described as {
        |Maintenance entry.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Maintenance recorded"
    described as {
      |Emitted when maintenance is recorded.
    }
  }
  event AssetDecommissioned is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    decommission: DecommissionInfo with {
      briefly "Decommission"
      described as {
        |Decommission details.
      }
    }
    decommissionedAt: TimeStamp with {
      briefly "Decommissioned"
      described as {
        |Decommission time.
      }
    }
  } with {
    briefly "Asset decommissioned"
    described as {
      |Emitted when asset is decommissioned.
    }
  }
  event AssetDisposed is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    disposal: DisposalInfo with {
      briefly "Disposal"
      described as {
        |Disposal details.
      }
    }
    disposedAt: TimeStamp with {
      briefly "Disposed"
      described as {
        |Disposal time.
      }
    }
  } with {
    briefly "Asset disposed"
    described as {
      |Emitted when asset is disposed.
    }
  }
  // State Records
  record OrderedStateData is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    assetInfo: AssetInfo with {
      briefly "Info"
      described as {
        |Asset information.
      }
    }
    financialInfo: FinancialInfo with {
      briefly "Financial"
      described as {
        |Financial info.
      }
    }
    vendorId: VendorId with {
      briefly "Vendor"
      described as {
        |Vendor ID.
      }
    }
    status: AssetStatus with {
      briefly "Status"
      described as {
        |Asset status.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "Ordered state data"
    described as {
      |State for newly registered asset awaiting installation.
    }
  }
  record InstalledStateData is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    assetInfo: AssetInfo with {
      briefly "Info"
      described as {
        |Asset information.
      }
    }
    financialInfo: FinancialInfo with {
      briefly "Financial"
      described as {
        |Financial info.
      }
    }
    installation: InstallationInfo with {
      briefly "Installation"
      described as {
        |Installation details.
      }
    }
    initialDepreciation: DepreciationSchedule? with {
      briefly "Depreciation"
      described as {
        |Depreciation schedule.
      }
    }
    status: AssetStatus with {
      briefly "Status"
      described as {
        |Asset status.
      }
    }
    condition: AssetCondition with {
      briefly "Condition"
      described as {
        |Asset condition.
      }
    }
  } with {
    briefly "Installed state data"
    described as {
      |State for installed asset.
    }
  }
  record OperatingStateData is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    assetInfo: AssetInfo with {
      briefly "Info"
      described as {
        |Asset information.
      }
    }
    financialInfo: FinancialInfo with {
      briefly "Financial"
      described as {
        |Financial info.
      }
    }
    location: LocationInfo with {
      briefly "Location"
      described as {
        |Current location.
      }
    }
    depreciation: DepreciationSchedule with {
      briefly "Depreciation"
      described as {
        |Depreciation schedule.
      }
    }
    maintenanceHistory: MaintenanceHistory with {
      briefly "Maintenance"
      described as {
        |Maintenance history.
      }
    }
    transferHistory: LocationTransfer* with {
      briefly "Transfers"
      described as {
        |Transfer history.
      }
    }
    status: AssetStatus with {
      briefly "Status"
      described as {
        |Asset status.
      }
    }
    condition: AssetCondition with {
      briefly "Condition"
      described as {
        |Asset condition.
      }
    }
  } with {
    briefly "Operating state data"
    described as {
      |State for actively operating asset.
    }
  }
  record DecommissionedStateData is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    assetInfo: AssetInfo with {
      briefly "Info"
      described as {
        |Asset information.
      }
    }
    financialInfo: FinancialInfo with {
      briefly "Financial"
      described as {
        |Final financial info.
      }
    }
    decommission: DecommissionInfo with {
      briefly "Decommission"
      described as {
        |Decommission details.
      }
    }
    maintenanceHistory: MaintenanceHistory with {
      briefly "Maintenance"
      described as {
        |Maintenance history.
      }
    }
    status: AssetStatus with {
      briefly "Status"
      described as {
        |Asset status.
      }
    }
  } with {
    briefly "Decommissioned state data"
    described as {
      |State for decommissioned asset awaiting disposal.
    }
  }
  record DisposedStateData is {
    assetId: AssetId with {
      briefly "Asset"
      described as {
        |Asset ID.
      }
    }
    assetInfo: AssetInfo with {
      briefly "Info"
      described as {
        |Asset information.
      }
    }
    disposal: DisposalInfo with {
      briefly "Disposal"
      described as {
        |Disposal details.
      }
    }
    status: AssetStatus with {
      briefly "Status"
      described as {
        |Asset status.
      }
    }
    archivedAt: TimeStamp with {
      briefly "Archived"
      described as {
        |Archive time.
      }
    }
  } with {
    briefly "Disposed state data"
    described as {
      |Final state for disposed asset.
    }
  }
  // States
  initial state OrderedState of record Asset.OrderedStateData is {
    initial handler OrderedStateInitHandler is {
      on init is {
        set state OrderedState to "initialize from prior event"
      }
    } with {
      briefly "Initializes Ordered state"
      described as {
        |Handles initialization of the Ordered state.
      }
    }
  } with {
    briefly "Ordered state"
    described as {
      |The entity in Ordered state.
    }
  }
  state InstalledState of record Asset.InstalledStateData is {
    initial handler InstalledStateInitHandler is {
      on init is {
        set state InstalledState to "initialize from prior event"
      }
    } with {
      briefly "Initializes Installed state"
      described as {
        |Handles initialization of the Installed state.
      }
    }
  } with {
    briefly "Installed state"
    described as {
      |The entity in Installed state.
    }
  }
  state OperatingState of record Asset.OperatingStateData is {
    initial handler OperatingStateInitHandler is {
      on init is {
        set state OperatingState to "initialize from prior event"
      }
    } with {
      briefly "Initializes Operating state"
      described as {
        |Handles initialization of the Operating state.
      }
    }
  } with {
    briefly "Operating state"
    described as {
      |The entity in Operating state.
    }
  }
  state DecommissionedState of record Asset.DecommissionedStateData is {
    initial handler DecommissionedStateInitHandler is {
      on init is {
        set state DecommissionedState to "initialize from prior event"
      }
    } with {
      briefly "Initializes Decommissioned state"
      described as {
        |Handles initialization of the Decommissioned state.
      }
    }
  } with {
    briefly "Decommissioned state"
    described as {
      |The entity in Decommissioned state.
    }
  }
  state DisposedState of record Asset.DisposedStateData is {
    initial handler DisposedStateInitHandler is {
      on init is {
        set state DisposedState to "initialize from prior event"
      }
    } with {
      briefly "Initializes Disposed state"
      described as {
        |Handles initialization of the Disposed state.
      }
    }
  } with {
    briefly "Disposed state"
    described as {
      |The entity in Disposed state.
    }
  }
  query GetAsset replies result AssetResult is {
    assetId: AssetId with {
      briefly "ID"
      described as {
        |Asset to retrieve.
      }
    }
  } with {
    briefly "Get asset"
    described as {
      |Retrieves asset data.
    }
  }
  result AssetResult is {
    assetId: AssetId with {
      briefly "ID"
      described as {
        |Asset identifier.
      }
    }
  } with {
    briefly "Asset result"
    described as {
      |Asset data result.
    }
  }
  // Handler
  handler AssetHandler is {
    on getAsset: query GetAsset is {
      reply result AssetResult(assetId = getAsset.assetId)
    }
    on registerAsset: command RegisterAsset is {
      morph entity AssetContext.Asset to state AssetContext.Asset.OrderedState with record Asset.OrderedStateData(assetId = registerAsset.assetId, assetInfo = registerAsset.assetInfo, financialInfo = registerAsset.financialInfo, vendorId = registerAsset.vendorId, status = prompt("the status of this ordered state data"), registeredAt = prompt("the registered at of this ordered state data"))
      tell event AssetRegistered(assetId = registerAsset.assetId, assetInfo = registerAsset.assetInfo, financialInfo = registerAsset.financialInfo, vendorId = registerAsset.vendorId, registeredBy = registerAsset.registeredBy, registeredAt = prompt("the registered at of this asset registered")) to entity AssetContext.Asset
    }
    on installAsset: command InstallAsset is {
      morph entity AssetContext.Asset to state AssetContext.Asset.InstalledState with record Asset.InstalledStateData(assetId = installAsset.assetId, installation = installAsset.installation, assetInfo = prompt("the asset info of this installed state data"), financialInfo = prompt("the financial info of this installed state data"), initialDepreciation = empty, status = prompt("the status of this installed state data"), condition = prompt("the condition of this installed state data"))
      tell event AssetInstalled(assetId = installAsset.assetId, installation = installAsset.installation, installedAt = prompt("the installed at of this asset installed")) to entity AssetContext.Asset
    }
    on transferAsset: command TransferAsset is {
      morph entity AssetContext.Asset to state AssetContext.Asset.OperatingState with record Asset.OperatingStateData(assetId = transferAsset.assetId, assetInfo = prompt("the asset info of this operating state data"), financialInfo = prompt("the financial info of this operating state data"), location = prompt("the location of this operating state data"), depreciation = prompt("the depreciation of this operating state data"), maintenanceHistory = prompt("the maintenance history of this operating state data"), transferHistory = empty, status = prompt("the status of this operating state data"), condition = prompt("the condition of this operating state data"))
      tell event AssetTransferred(assetId = transferAsset.assetId, transfer = transferAsset.transfer, transferredAt = prompt("the transferred at of this asset transferred")) to entity AssetContext.Asset
    }
    on updateValuation: command UpdateValuation is {
      tell event ValuationUpdated(assetId = updateValuation.assetId, valuation = updateValuation.valuation, updatedAt = prompt("the updated at of this valuation updated")) to entity AssetContext.Asset
    }
    on scheduleDepreciation: command ScheduleDepreciation is {
      morph entity AssetContext.Asset to state AssetContext.Asset.OperatingState with record Asset.OperatingStateData(assetId = scheduleDepreciation.assetId, assetInfo = prompt("the asset info of this operating state data"), financialInfo = prompt("the financial info of this operating state data"), location = prompt("the location of this operating state data"), depreciation = prompt("the depreciation of this operating state data"), maintenanceHistory = prompt("the maintenance history of this operating state data"), transferHistory = empty, status = prompt("the status of this operating state data"), condition = prompt("the condition of this operating state data"))
      tell event DepreciationScheduled(assetId = scheduleDepreciation.assetId, schedule = scheduleDepreciation.schedule, scheduledAt = prompt("the scheduled at of this depreciation scheduled")) to entity AssetContext.Asset
    }
    on recordMaintenance: command RecordMaintenance is {
      tell event MaintenanceRecorded(assetId = recordMaintenance.assetId, maintenance = recordMaintenance.maintenance, recordedAt = prompt("the recorded at of this maintenance recorded")) to entity AssetContext.Asset
    }
    on decommissionAsset: command DecommissionAsset is {
      morph entity AssetContext.Asset to state AssetContext.Asset.DecommissionedState with record Asset.DecommissionedStateData(assetId = decommissionAsset.assetId, decommission = decommissionAsset.decommission, assetInfo = prompt("the asset info of this decommissioned state data"), financialInfo = prompt("the financial info of this decommissioned state data"), maintenanceHistory = prompt("the maintenance history of this decommissioned state data"), status = prompt("the status of this decommissioned state data"))
      tell event AssetDecommissioned(assetId = decommissionAsset.assetId, decommission = decommissionAsset.decommission, decommissionedAt = prompt("the decommissioned at of this asset decommissioned")) to entity AssetContext.Asset
    }
    on disposeAsset: command DisposeAsset is {
      morph entity AssetContext.Asset to state AssetContext.Asset.DisposedState with record Asset.DisposedStateData(assetId = disposeAsset.assetId, disposal = disposeAsset.disposal, assetInfo = prompt("the asset info of this disposed state data"), status = prompt("the status of this disposed state data"), archivedAt = prompt("the archived at of this disposed state data"))
      tell event AssetDisposed(assetId = disposeAsset.assetId, disposal = disposeAsset.disposal, disposedAt = prompt("the disposed at of this asset disposed")) to entity AssetContext.Asset
    }
    on assetDecommissioned: event AssetDecommissioned is {
      do "apply AssetDecommissioned to the asset so it can be persisted and replayed"
    }
    on assetDisposed: event AssetDisposed is {
      do "apply AssetDisposed to the asset so it can be persisted and replayed"
    }
    on assetInstalled: event AssetInstalled is {
      do "apply AssetInstalled to the asset so it can be persisted and replayed"
    }
    on assetRegistered: event AssetRegistered is {
      do "apply AssetRegistered to the asset so it can be persisted and replayed"
    }
    on assetTransferred: event AssetTransferred is {
      do "apply AssetTransferred to the asset so it can be persisted and replayed"
    }
    on depreciationScheduled: event DepreciationScheduled is {
      do "apply DepreciationScheduled to the asset so it can be persisted and replayed"
    }
    on maintenanceRecorded: event MaintenanceRecorded is {
      do "apply MaintenanceRecorded to the asset so it can be persisted and replayed"
    }
    on valuationUpdated: event ValuationUpdated is {
      do "apply ValuationUpdated to the asset so it can be persisted and replayed"
    }
  } with {
    briefly "Processes asset lifecycle commands"
    described as {
      | Handles asset lifecycle from registration through
      | installation, operation, maintenance, and disposal.
    }
  }
} with {
  briefly "Asset aggregate"
  described as {
    | The Asset entity manages the complete lifecycle of
    | physical assets from acquisition to disposal.
  }
}
