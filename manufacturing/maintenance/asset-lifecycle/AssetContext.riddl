// Asset Lifecycle Management - Asset Context
context AssetContext is {
  adaptor FromFinancialSystem from context FinancialSystem is { 
    handler FromFinancialSystemHandler is {
      on result FinancialSystem.AssetFinancials is {
        do "the model receives asset financials"
      }
      on event FinancialSystem.DepreciationRecorded is {
        do "the model receives depreciation recorded"
      }
      on event FinancialSystem.DisposalEntryRecorded is {
        do "the model receives disposal entry recorded"
      }
      on event FinancialSystem.FixedAssetRecordCreated is {
        do "the model receives fixed asset record created"
      }
      on other is {
        error "Unexpected message for adaptor FromFinancialSystem"
      }
    } with {
      briefly "from financial system"
      described as {
        |Carries messages from the external FinancialSystem.
      }
    }
  } with {
    briefly "FinancialSystem integration"
    described as {
      |The model's side of the FinancialSystem conversation.
    }
  }
  adaptor ToFinancialSystem to context FinancialSystem is { 
    handler ToFinancialSystemHandler is {
      on command FinancialSystem.CreateFixedAssetRecord is {
        do "the model sends create fixed asset record"
      }
      on query FinancialSystem.GetAssetFinancials is {
        do "the model sends get asset financials"
      }
      on command FinancialSystem.RecordDepreciation is {
        do "the model sends record depreciation"
      }
      on command FinancialSystem.RecordDisposalEntry is {
        do "the model sends record disposal entry"
      }
      on other is {
        error "Unexpected message for adaptor ToFinancialSystem"
      }
    } with {
      briefly "to financial system"
      described as {
        |Carries messages to the external FinancialSystem.
      }
    }
  } with {
    briefly "FinancialSystem integration"
    described as {
      |The model's side of the FinancialSystem conversation.
    }
  }
  adaptor FromMaintenanceSystem from context MaintenanceSystem is { 
    handler FromMaintenanceSystemHandler is {
      on event MaintenanceSystem.MaintenanceCompleted is {
        do "the model receives maintenance completed"
      }
      on result MaintenanceSystem.MaintenanceHistoryResult is {
        do "the model receives maintenance history result"
      }
      on event MaintenanceSystem.MaintenanceScheduled is {
        do "the model receives maintenance scheduled"
      }
      on result MaintenanceSystem.UpcomingMaintenanceResult is {
        do "the model receives upcoming maintenance result"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceSystem"
      }
    } with {
      briefly "from maintenance system"
      described as {
        |Carries messages from the external MaintenanceSystem.
      }
    }
  } with {
    briefly "MaintenanceSystem integration"
    described as {
      |The model's side of the MaintenanceSystem conversation.
    }
  }
  adaptor ToMaintenanceSystem to context MaintenanceSystem is { 
    handler ToMaintenanceSystemHandler is {
      on query MaintenanceSystem.GetMaintenanceHistory is {
        do "the model sends get maintenance history"
      }
      on query MaintenanceSystem.GetUpcomingMaintenance is {
        do "the model sends get upcoming maintenance"
      }
      on command MaintenanceSystem.ReportMaintenanceComplete is {
        do "the model sends report maintenance complete"
      }
      on command MaintenanceSystem.SchedulePreventiveMaintenance is {
        do "the model sends schedule preventive maintenance"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceSystem"
      }
    } with {
      briefly "to maintenance system"
      described as {
        |Carries messages to the external MaintenanceSystem.
      }
    }
  } with {
    briefly "MaintenanceSystem integration"
    described as {
      |The model's side of the MaintenanceSystem conversation.
    }
  }
  adaptor FromProcurementService from context ProcurementService is { 
    handler FromProcurementServiceHandler is {
      on result ProcurementService.PurchaseOrderDetails is {
        do "the model receives purchase order details"
      }
      on event ProcurementService.QuoteRequestSubmitted is {
        do "the model receives quote request submitted"
      }
      on result ProcurementService.VendorInfo is {
        do "the model receives vendor info"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementService"
      }
    } with {
      briefly "from procurement service"
      described as {
        |Carries messages from the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor ToProcurementService to context ProcurementService is { 
    handler ToProcurementServiceHandler is {
      on query ProcurementService.GetPurchaseOrder is {
        do "the model sends get purchase order"
      }
      on query ProcurementService.GetVendorInfo is {
        do "the model sends get vendor info"
      }
      on command ProcurementService.RequestQuote is {
        do "the model sends request quote"
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementService"
      }
    } with {
      briefly "to procurement service"
      described as {
        |Carries messages to the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  include "types.riddl"
  include "Asset.riddl"
  // Repository for asset persistence
  repository AssetRepository is {
    inlet AssetRepositoryFromAsset is type AssetEvent    inlet AssetRepositoryFromAssetValuationProjector is type AssetEvent    inlet AssetRepositoryFromDepreciationReportProjector is type AssetEvent    inlet AssetRepositoryFromUtilizationProjector is type AssetEvent    outlet AssetRepositoryResponses is type Asset.AssetResult
    record StoredAsset is  {
      assetId: AssetId with {
        briefly "assetId"
        described as {
          |The assetId column of the stored asset row.
        }
      }
      assetInfo: AssetInfo with {
        briefly "assetInfo"
        described as {
          |The assetInfo column of the stored asset row.
        }
      }
      location: LocationInfo with {
        briefly "location"
        described as {
          |The location column of the stored asset row.
        }
      }
      status: AssetStatus with {
        briefly "status"
        described as {
          |The status column of the stored asset row.
        }
      }
    } with {
      briefly "Stored asset row"
      described as {
        |The persistence shape of asset data as this repository stores it.
      }
    }
    schema AssetData is relational
      of assets as type StoredAsset
        index on field StoredAsset.assetId
        index on field StoredAsset.assetInfo.assetTag
        index on field StoredAsset.status
        index on field StoredAsset.location.locationId
 with {
      briefly "Asset data schema"
      described as {
        |The relational schema holding asset data for the AssetRepository.
      }
    }
    handler AssetPersistence is {
      on query GetValuationSummary is {
        do "read the valuation summary projection"
        yield result ValuationSummaryView
      }
      on query GetDepreciationReport is {
        do "read the depreciation report projection"
        yield result DepreciationReportView
      }
      on query GetUtilizationMetrics is {
        do "read the utilization metrics projection"
        yield result UtilizationMetricsView
      }
      on command Asset.RegisterAsset is {
        do "Store new asset record"
      }
      on command Asset.InstallAsset is {
        do "Update asset with installation details"
      }
      on command Asset.TransferAsset is {
        tell event Asset.AssetTransferred to entity AssetContext.Asset
        do "Update asset location and transfer history"
      }
      on command Asset.UpdateValuation is {
        tell event Asset.ValuationUpdated to entity AssetContext.Asset
        do "Update asset financial values"
      }
      on command Asset.ScheduleDepreciation is {
        tell event Asset.DepreciationScheduled to entity AssetContext.Asset
        do "Store depreciation schedule"
      }
      on command Asset.RecordMaintenance is {
        tell event Asset.MaintenanceRecorded to entity AssetContext.Asset
        do "Add maintenance entry to history"
      }
      on command Asset.DecommissionAsset is {
        do "Update asset to decommissioned status"
      }
      on command Asset.DisposeAsset is {
        do "Update asset to disposed and archive"
      }
    } with {
      briefly "Persists asset commands"
      described as {
        |Handles command-driven persistence for assets.
      }
    }
  } with {
    briefly "Asset data persistence"
    described as {
      | The AssetRepository provides persistent storage for
      | assets, their financial data, and lifecycle history.
    }
  }
  // Projector for asset valuation reporting
  query GetValuationSummary is  {
    valuationSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which valuation summary to retrieve.
      }
    }
  } with {
    briefly "Get valuation summary"
    described as {
      |Retrieves the valuation summary projection.
    }
  }
  result ValuationSummaryView is  {
    valuationSummary: AssetValuationProjector.ValuationSummary with {
      briefly "Valuation summary"
      described as {
        |The valuation summary being returned.
      }
    }
  } with {
    briefly "Valuation summary view"
    described as {
      |Read model view carrying the valuation summary projection.
    }
  }
  projector AssetValuationProjector is {
    updates repository AssetContext.AssetRepository
    inlet AssetValuationProjectorFromAsset is type AssetEvent    outlet AssetValuationProjectorOut is type AssetEvent
    record ValuationSummary is  {
      totalAssets: Natural with {
        briefly "Total"
        described as {
          |Total number of assets.
        }
      }
      totalCapitalizedCost: Decimal(15,2) with {
        briefly "Capitalized"
        described as {
          |Total capitalized cost.
        }
      }
      totalCurrentValue: Decimal(15,2) with {
        briefly "Current value"
        described as {
          |Total current book value.
        }
      }
      totalAccumulatedDepreciation: Decimal(15,2) with {
        briefly "Depreciation"
        described as {
          |Total accumulated depreciation.
        }
      }
      averageAssetAge: Decimal(5,2) with {
        briefly "Average age"
        described as {
          |Average asset age in years.
        }
      }
    } with {
      briefly "Valuation summary"
      described as {
        |Summary of asset valuations.
      }
    }
    handler ValuationHandler is {
      on event Asset.AssetRegistered is {
        tell event Asset.AssetRegistered to repository AssetContext.AssetRepository
        do "Add new asset to valuation totals"
      }
      on event Asset.ValuationUpdated is {
        tell event Asset.ValuationUpdated to repository AssetContext.AssetRepository
        do "Update valuation totals with new values"
      }
      on event Asset.DepreciationScheduled is {
        tell event Asset.DepreciationScheduled to repository AssetContext.AssetRepository
        do "Update depreciation calculations"
      }
      on event Asset.AssetDisposed is {
        tell event Asset.AssetDisposed to repository AssetContext.AssetRepository
        do "Remove asset from active valuation totals"
      }
    } with {
      briefly "Maintains valuation projections"
      described as {
        |Projects events into valuation views.
      }
    }
  } with {
    briefly "Asset valuation projections"
    described as {
      |Maintains asset valuation and financial reporting data.
    }
  }
  // Projector for depreciation reports
  query GetDepreciationReport is  {
    depreciationReportKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which depreciation report to retrieve.
      }
    }
  } with {
    briefly "Get depreciation report"
    described as {
      |Retrieves the depreciation report projection.
    }
  }
  result DepreciationReportView is  {
    depreciationReport: DepreciationReportProjector.DepreciationReport with {
      briefly "Depreciation report"
      described as {
        |The depreciation report being returned.
      }
    }
  } with {
    briefly "Depreciation report view"
    described as {
      |Read model view carrying the depreciation report projection.
    }
  }
  projector DepreciationReportProjector is {
    updates repository AssetContext.AssetRepository
    inlet DepreciationReportProjectorFromAsset is type AssetEvent    outlet DepreciationReportProjectorOut is type AssetEvent
    record DepreciationReport is  {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Report period start date.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Report period end date.
        }
      }
      totalDepreciation: Decimal(15,2) with {
        briefly "Total"
        described as {
          |Total depreciation for period.
        }
      }
      assetCount: Natural with {
        briefly "Asset count"
        described as {
          |Number of assets depreciated.
        }
      }
      byCategory: String(1,500)+ with {
        briefly "By category"
        described as {
          |Depreciation by category.
        }
      }
    } with {
      briefly "Depreciation report"
      described as {
        |Period depreciation report.
      }
    }
    handler DepreciationHandler is {
      on event Asset.DepreciationScheduled is {
        tell event Asset.DepreciationScheduled to repository AssetContext.AssetRepository
        do "Add asset to depreciation tracking"
      }
      on event Asset.ValuationUpdated is {
        tell event Asset.ValuationUpdated to repository AssetContext.AssetRepository
        do "Update depreciation calculations"
      }
      on event Asset.AssetDecommissioned is {
        tell event Asset.AssetDecommissioned to repository AssetContext.AssetRepository
        do "Stop depreciation for asset"
      }
    } with {
      briefly "Maintains depreciation reports"
      described as {
        |Projects events into depreciation reports.
      }
    }
  } with {
    briefly "Depreciation report projections"
    described as {
      |Maintains depreciation reporting data.
    }
  }
  // Projector for utilization tracking
  query GetUtilizationMetrics is  {
    utilizationMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization metrics to retrieve.
      }
    }
  } with {
    briefly "Get utilization metrics"
    described as {
      |Retrieves the utilization metrics projection.
    }
  }
  result UtilizationMetricsView is  {
    utilizationMetrics: UtilizationProjector.UtilizationMetrics with {
      briefly "Utilization metrics"
      described as {
        |The utilization metrics being returned.
      }
    }
  } with {
    briefly "Utilization metrics view"
    described as {
      |Read model view carrying the utilization metrics projection.
    }
  }
  projector UtilizationProjector is {
    updates repository AssetContext.AssetRepository
    inlet UtilizationProjectorFromAsset is type AssetEvent    outlet UtilizationProjectorOut is type AssetEvent
    record UtilizationMetrics is  {
      activeAssets: Natural with {
        briefly "Active"
        described as {
          |Number of active assets.
        }
      }
      utilizationRate: Decimal(5,4) with {
        briefly "Utilization"
        described as {
          |Overall utilization rate.
        }
      }
      underMaintenanceCount: Natural with {
        briefly "Under maintenance"
        described as {
          |Assets under maintenance.
        }
      }
      decommissionedCount: Natural with {
        briefly "Decommissioned"
        described as {
          |Decommissioned assets.
        }
      }
      averageLifespan: Decimal(6,2) with {
        briefly "Avg lifespan"
        described as {
          |Average asset lifespan in months.
        }
      }
    } with {
      briefly "Utilization metrics"
      described as {
        |Asset utilization statistics.
      }
    }
    handler UtilizationHandler is {
      on event Asset.AssetInstalled is {
        tell event Asset.AssetInstalled to repository AssetContext.AssetRepository
        do "Increment active asset count"
      }
      on event Asset.AssetTransferred is {
        tell event Asset.AssetTransferred to repository AssetContext.AssetRepository
        do "Update utilization by location"
      }
      on event Asset.MaintenanceRecorded is {
        tell event Asset.MaintenanceRecorded to repository AssetContext.AssetRepository
        do "Update maintenance metrics"
      }
      on event Asset.AssetDecommissioned is {
        tell event Asset.AssetDecommissioned to repository AssetContext.AssetRepository
        do "Update decommissioned count"
      }
      on event Asset.AssetDisposed is {
        tell event Asset.AssetDisposed to repository AssetContext.AssetRepository
        do "Calculate final lifespan metrics"
      }
    } with {
      briefly "Maintains utilization metrics"
      described as {
        |Projects events into utilization views.
      }
    }
  } with {
    briefly "Utilization tracking projections"
    described as {
      |Maintains asset utilization and performance data.
    }
  }
  // ---- Event publication for Asset ----
  type AssetEvent is one of {
    AssetContext.Asset.AssetRegistered or AssetContext.Asset.AssetInstalled or AssetContext.Asset.AssetTransferred or AssetContext.Asset.ValuationUpdated or AssetContext.Asset.DepreciationScheduled or AssetContext.Asset.MaintenanceRecorded or AssetContext.Asset.AssetDecommissioned or AssetContext.Asset.AssetDisposed
  } with {
    briefly "Asset event alternation"
    described as {
      |Union of all Asset events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AssetEventSource as source is {
    outlet AssetEvents is type AssetEvent
    handler AssetSourceHandler is {
      on event Asset.AssetRegistered is {
        send event Asset.AssetRegistered to outlet AssetEvents
      }
      on event Asset.AssetInstalled is {
        send event Asset.AssetInstalled to outlet AssetEvents
      }
      on event Asset.AssetTransferred is {
        send event Asset.AssetTransferred to outlet AssetEvents
      }
      on event Asset.ValuationUpdated is {
        send event Asset.ValuationUpdated to outlet AssetEvents
      }
      on event Asset.DepreciationScheduled is {
        send event Asset.DepreciationScheduled to outlet AssetEvents
      }
      on event Asset.MaintenanceRecorded is {
        send event Asset.MaintenanceRecorded to outlet AssetEvents
      }
      on event Asset.AssetDecommissioned is {
        send event Asset.AssetDecommissioned to outlet AssetEvents
      }
      on event Asset.AssetDisposed is {
        send event Asset.AssetDisposed to outlet AssetEvents
      }
      on other is {
        error "Unexpected message for source AssetEventSource"
      }
    } with {
      briefly "Asset source handler"
      described as {
        |Publishes Asset events onto the outlet.
      }
    }
  } with {
    briefly "Asset event source"
    described as {
      |Publishes Asset entity events into the streaming topology.
    }
  }
  processor AssetEventSink as sink is {
    inlet AssetInlet is type AssetEvent    handler AssetSinkHandler is {
      on event Asset.AssetRegistered is {
        tell event Asset.AssetRegistered to repository AssetContext.AssetRepository
      }
      on event Asset.AssetInstalled is {
        tell event Asset.AssetInstalled to repository AssetContext.AssetRepository
      }
      on event Asset.AssetTransferred is {
        tell event Asset.AssetTransferred to repository AssetContext.AssetRepository
      }
      on event Asset.ValuationUpdated is {
        tell event Asset.ValuationUpdated to repository AssetContext.AssetRepository
      }
      on event Asset.DepreciationScheduled is {
        tell event Asset.DepreciationScheduled to repository AssetContext.AssetRepository
      }
      on event Asset.MaintenanceRecorded is {
        tell event Asset.MaintenanceRecorded to repository AssetContext.AssetRepository
      }
      on event Asset.AssetDecommissioned is {
        tell event Asset.AssetDecommissioned to repository AssetContext.AssetRepository
      }
      on event Asset.AssetDisposed is {
        tell event Asset.AssetDisposed to repository AssetContext.AssetRepository
      }
      on other is {
        error "Unexpected message for sink AssetEventSink"
      }
    } with {
      briefly "Asset sink handler"
      described as {
        |Persists Asset events via the repository.
      }
    }
  } with {
    briefly "Asset event sink"
    described as {
      |Receives Asset events for persistence.
    }
  }
  connector AssetEventFlow is from outlet AssetContext.AssetEventSource.AssetEvents to inlet AssetContext.AssetEventSink.AssetInlet with {
    briefly "Asset event flow"
    described as {
      |Connects the Asset source to its sink.
    }
  }
  processor AssetEventSplit is {
    inlet AssetEventSplitIn is type AssetEvent    outlet AssetEventSplitToAssetRepository is type AssetEvent
    outlet AssetEventSplitToAssetValuationProjector is type AssetEvent
    outlet AssetEventSplitToDepreciationReportProjector is type AssetEvent
    outlet AssetEventSplitToUtilizationProjector is type AssetEvent
    handler AssetEventSplitHandler is {
      on event Asset.AssetRegistered is {
        send event Asset.AssetRegistered to outlet AssetEventSplitToAssetRepository
        send event Asset.AssetRegistered to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.AssetRegistered to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.AssetRegistered to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.AssetRegistered to entity AssetContext.Asset
      }
      on event Asset.AssetInstalled is {
        send event Asset.AssetInstalled to outlet AssetEventSplitToAssetRepository
        send event Asset.AssetInstalled to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.AssetInstalled to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.AssetInstalled to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.AssetInstalled to entity AssetContext.Asset
      }
      on event Asset.AssetTransferred is {
        send event Asset.AssetTransferred to outlet AssetEventSplitToAssetRepository
        send event Asset.AssetTransferred to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.AssetTransferred to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.AssetTransferred to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.AssetTransferred to entity AssetContext.Asset
      }
      on event Asset.ValuationUpdated is {
        send event Asset.ValuationUpdated to outlet AssetEventSplitToAssetRepository
        send event Asset.ValuationUpdated to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.ValuationUpdated to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.ValuationUpdated to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.ValuationUpdated to entity AssetContext.Asset
      }
      on event Asset.DepreciationScheduled is {
        send event Asset.DepreciationScheduled to outlet AssetEventSplitToAssetRepository
        send event Asset.DepreciationScheduled to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.DepreciationScheduled to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.DepreciationScheduled to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.DepreciationScheduled to entity AssetContext.Asset
      }
      on event Asset.MaintenanceRecorded is {
        send event Asset.MaintenanceRecorded to outlet AssetEventSplitToAssetRepository
        send event Asset.MaintenanceRecorded to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.MaintenanceRecorded to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.MaintenanceRecorded to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.MaintenanceRecorded to entity AssetContext.Asset
      }
      on event Asset.AssetDecommissioned is {
        send event Asset.AssetDecommissioned to outlet AssetEventSplitToAssetRepository
        send event Asset.AssetDecommissioned to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.AssetDecommissioned to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.AssetDecommissioned to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.AssetDecommissioned to entity AssetContext.Asset
      }
      on event Asset.AssetDisposed is {
        send event Asset.AssetDisposed to outlet AssetEventSplitToAssetRepository
        send event Asset.AssetDisposed to outlet AssetEventSplitToAssetValuationProjector
        send event Asset.AssetDisposed to outlet AssetEventSplitToDepreciationReportProjector
        send event Asset.AssetDisposed to outlet AssetEventSplitToUtilizationProjector
        tell event Asset.AssetDisposed to entity AssetContext.Asset
      }
      on other is {
        error "Unexpected message for processor AssetEventSplit"
      }
    } with {
      briefly "Asset event fan-out handler"
      described as {
        |Delivers each Asset event to all of its consumers.
      }
    }
  } with {
    briefly "Asset event fan-out"
    described as {
      |Fans Asset events out to the repository and projectors.
    }
  }
  connector LinkAssetToAssetEventSplit is from outlet AssetContext.Asset.AssetEvents2 to inlet AssetContext.AssetEventSplit.AssetEventSplitIn with {
    briefly "LinkAssetToAssetEventSplit"
  }
  connector LinkAssetEventSplitToAssetRepository is from outlet AssetContext.AssetEventSplit.AssetEventSplitToAssetRepository to inlet AssetContext.AssetRepository.AssetRepositoryFromAsset with {
    briefly "LinkAssetEventSplitToAssetRepository"
  }
  connector LinkAssetEventSplitToAssetValuationProjector is from outlet AssetContext.AssetEventSplit.AssetEventSplitToAssetValuationProjector to inlet AssetContext.AssetValuationProjector.AssetValuationProjectorFromAsset with {
    briefly "LinkAssetEventSplitToAssetValuationProjector"
  }
  connector LinkAssetEventSplitToDepreciationReportProjector is from outlet AssetContext.AssetEventSplit.AssetEventSplitToDepreciationReportProjector to inlet AssetContext.DepreciationReportProjector.DepreciationReportProjectorFromAsset with {
    briefly "LinkAssetEventSplitToDepreciationReportProjector"
  }
  connector LinkAssetEventSplitToUtilizationProjector is from outlet AssetContext.AssetEventSplit.AssetEventSplitToUtilizationProjector to inlet AssetContext.UtilizationProjector.UtilizationProjectorFromAsset with {
    briefly "LinkAssetEventSplitToUtilizationProjector"
  }
  connector LinkAssetValuationProjectorToAssetRepository is from outlet AssetContext.AssetValuationProjector.AssetValuationProjectorOut to inlet AssetContext.AssetRepository.AssetRepositoryFromAssetValuationProjector with {
    briefly "LinkAssetValuationProjectorToAssetRepository"
  }
  connector LinkDepreciationReportProjectorToAssetRepository is from outlet AssetContext.DepreciationReportProjector.DepreciationReportProjectorOut to inlet AssetContext.AssetRepository.AssetRepositoryFromDepreciationReportProjector with {
    briefly "LinkDepreciationReportProjectorToAssetRepository"
  }
  connector LinkUtilizationProjectorToAssetRepository is from outlet AssetContext.UtilizationProjector.UtilizationProjectorOut to inlet AssetContext.AssetRepository.AssetRepositoryFromUtilizationProjector with {
    briefly "LinkUtilizationProjectorToAssetRepository"
  }
} with {
  briefly "Bounded context for asset lifecycle management"
  described as {
    | The AssetContext is the bounded context for managing
    | physical assets throughout their complete lifecycle.
  }
}
