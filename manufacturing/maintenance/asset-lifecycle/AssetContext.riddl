// Asset Lifecycle Management - Asset Context
context AssetContext as router is {
  inlet AssetCommandStreamIn is type AssetCommand  outlet AssetCommandStreamOut is type AssetCommand
  inlet AssetResultStreamIn is result Asset.AssetResult  outlet AssetResultStreamOut is result Asset.AssetResult
  handler AssetContextBoundary is {
    on registerAsset: command Asset.RegisterAsset is {
      send registerAsset to outlet AssetContext.AssetCommandStreamOut
    }
    on installAsset: command Asset.InstallAsset is {
      send installAsset to outlet AssetContext.AssetCommandStreamOut
    }
    on transferAsset: command Asset.TransferAsset is {
      send transferAsset to outlet AssetContext.AssetCommandStreamOut
    }
    on updateValuation: command Asset.UpdateValuation is {
      send updateValuation to outlet AssetContext.AssetCommandStreamOut
    }
    on scheduleDepreciation: command Asset.ScheduleDepreciation is {
      send scheduleDepreciation to outlet AssetContext.AssetCommandStreamOut
    }
    on recordMaintenance: command Asset.RecordMaintenance is {
      send recordMaintenance to outlet AssetContext.AssetCommandStreamOut
    }
    on decommissionAsset: command Asset.DecommissionAsset is {
      send decommissionAsset to outlet AssetContext.AssetCommandStreamOut
    }
    on disposeAsset: command Asset.DisposeAsset is {
      send disposeAsset to outlet AssetContext.AssetCommandStreamOut
    }
    on assetResult: result Asset.AssetResult is {
      send assetResult to outlet AssetContext.AssetResultStreamOut
    }
    on other is {
      error "Unexpected message at the AssetContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AssetCommand Stream Intake' is from outlet AssetContext.AssetCommandStreamOut to inlet AssetContext.Asset.AssetCommands  connector 'AssetResult Stream Egress' is from outlet AssetContext.AssetRepository.AssetRepositoryResponses to inlet AssetContext.AssetResultStreamIn  adaptor FromFinancialSystem from context FinancialSystem is { 
    handler FromFinancialSystemHandler is {
      on result FinancialSystem.AssetFinancials is {
        do "the model receives asset financials"
      }
      on event FinancialSystem.DepreciationRecorded is {
        do "the model receives depreciation recorded"
      }
      on event FinancialSystem.DisposalEntryRecorded is {
        do "the model receives disposal entry recorded"
      }
      on event FinancialSystem.FixedAssetRecordCreated is {
        do "the model receives fixed asset record created"
      }
      on other is {
        error "Unexpected message for adaptor FromFinancialSystem"
      }
    } with {
      briefly "from financial system"
      described as {
        |Carries messages from the external FinancialSystem.
      }
    }
  } with {
    briefly "FinancialSystem integration"
    described as {
      |The model's side of the FinancialSystem conversation.
    }
  }
  adaptor ToFinancialSystem to context FinancialSystem is { 
    handler ToFinancialSystemHandler is {
      on command FinancialSystem.CreateFixedAssetRecord is {
        do "the model sends create fixed asset record"
      }
      on query FinancialSystem.GetAssetFinancials is {
        do "the model sends get asset financials"
      }
      on command FinancialSystem.RecordDepreciation is {
        do "the model sends record depreciation"
      }
      on command FinancialSystem.RecordDisposalEntry is {
        do "the model sends record disposal entry"
      }
      on other is {
        error "Unexpected message for adaptor ToFinancialSystem"
      }
    } with {
      briefly "to financial system"
      described as {
        |Carries messages to the external FinancialSystem.
      }
    }
  } with {
    briefly "FinancialSystem integration"
    described as {
      |The model's side of the FinancialSystem conversation.
    }
  }
  adaptor FromMaintenanceSystem from context MaintenanceSystem is { 
    handler FromMaintenanceSystemHandler is {
      on event MaintenanceSystem.MaintenanceCompleted is {
        do "the model receives maintenance completed"
      }
      on result MaintenanceSystem.MaintenanceHistoryResult is {
        do "the model receives maintenance history result"
      }
      on event MaintenanceSystem.MaintenanceScheduled is {
        do "the model receives maintenance scheduled"
      }
      on result MaintenanceSystem.UpcomingMaintenanceResult is {
        do "the model receives upcoming maintenance result"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceSystem"
      }
    } with {
      briefly "from maintenance system"
      described as {
        |Carries messages from the external MaintenanceSystem.
      }
    }
  } with {
    briefly "MaintenanceSystem integration"
    described as {
      |The model's side of the MaintenanceSystem conversation.
    }
  }
  adaptor ToMaintenanceSystem to context MaintenanceSystem is { 
    handler ToMaintenanceSystemHandler is {
      on query MaintenanceSystem.GetMaintenanceHistory is {
        do "the model sends get maintenance history"
      }
      on query MaintenanceSystem.GetUpcomingMaintenance is {
        do "the model sends get upcoming maintenance"
      }
      on command MaintenanceSystem.ReportMaintenanceComplete is {
        do "the model sends report maintenance complete"
      }
      on command MaintenanceSystem.SchedulePreventiveMaintenance is {
        do "the model sends schedule preventive maintenance"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceSystem"
      }
    } with {
      briefly "to maintenance system"
      described as {
        |Carries messages to the external MaintenanceSystem.
      }
    }
  } with {
    briefly "MaintenanceSystem integration"
    described as {
      |The model's side of the MaintenanceSystem conversation.
    }
  }
  adaptor FromProcurementService from context ProcurementService is { 
    handler FromProcurementServiceHandler is {
      on result ProcurementService.PurchaseOrderDetails is {
        do "the model receives purchase order details"
      }
      on event ProcurementService.QuoteRequestSubmitted is {
        do "the model receives quote request submitted"
      }
      on result ProcurementService.VendorInfo is {
        do "the model receives vendor info"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementService"
      }
    } with {
      briefly "from procurement service"
      described as {
        |Carries messages from the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor ToProcurementService to context ProcurementService is { 
    handler ToProcurementServiceHandler is {
      on query ProcurementService.GetPurchaseOrder is {
        do "the model sends get purchase order"
      }
      on query ProcurementService.GetVendorInfo is {
        do "the model sends get vendor info"
      }
      on command ProcurementService.RequestQuote is {
        do "the model sends request quote"
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementService"
      }
    } with {
      briefly "to procurement service"
      described as {
        |Carries messages to the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  include "types.riddl"
  include "Asset.riddl"
  // Repository for asset persistence
  type AssetRepositoryCommand is one of {
    AssetContext.AssetRepository.PersistAssetDecommissioned or AssetContext.AssetRepository.PersistAssetDisposed or AssetContext.AssetRepository.PersistAssetInstalled or AssetContext.AssetRepository.PersistAssetRegistered or AssetContext.AssetRepository.PersistAssetTransferred or AssetContext.AssetRepository.PersistDepreciationScheduled or AssetContext.AssetRepository.PersistMaintenanceRecorded or AssetContext.AssetRepository.PersistValuationUpdated
  } with {
    briefly "Anything that writes AssetRepository"
    described as {
      |The persistence commands AssetRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AssetRepository as flow is {
    inlet AssetRepositoryFromAssetValuationProjector is type AssetRepositoryCommand    command PersistAssetDecommissioned is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssetDecommissioned applies to.
        }
      }
    } with {
      briefly "Persist AssetDecommissioned"
      described as {
        |Instructs this repository to apply AssetDecommissioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssetDisposed is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssetDisposed applies to.
        }
      }
    } with {
      briefly "Persist AssetDisposed"
      described as {
        |Instructs this repository to apply AssetDisposed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssetInstalled is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssetInstalled applies to.
        }
      }
    } with {
      briefly "Persist AssetInstalled"
      described as {
        |Instructs this repository to apply AssetInstalled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssetRegistered is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssetRegistered applies to.
        }
      }
    } with {
      briefly "Persist AssetRegistered"
      described as {
        |Instructs this repository to apply AssetRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAssetTransferred is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row AssetTransferred applies to.
        }
      }
    } with {
      briefly "Persist AssetTransferred"
      described as {
        |Instructs this repository to apply AssetTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDepreciationScheduled is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row DepreciationScheduled applies to.
        }
      }
    } with {
      briefly "Persist DepreciationScheduled"
      described as {
        |Instructs this repository to apply DepreciationScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceRecorded is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceRecorded applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceRecorded"
      described as {
        |Instructs this repository to apply MaintenanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistValuationUpdated is {
      assetId: AssetId with {
        briefly "Row addressed"
        described as {
          |Which stored row ValuationUpdated applies to.
        }
      }
    } with {
      briefly "Persist ValuationUpdated"
      described as {
        |Instructs this repository to apply ValuationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AssetRepositoryResponses is result Asset.AssetResult
    record StoredAsset is {
      assetId: AssetId with {
        briefly "assetId"
        described as {
          |The assetId column of the stored asset row.
        }
      }
      assetInfo: AssetInfo with {
        briefly "assetInfo"
        described as {
          |The assetInfo column of the stored asset row.
        }
      }
      location: LocationInfo with {
        briefly "location"
        described as {
          |The location column of the stored asset row.
        }
      }
      status: AssetStatus with {
        briefly "status"
        described as {
          |The status column of the stored asset row.
        }
      }
    } with {
      briefly "Stored asset row"
      described as {
        |The persistence shape of asset data as this repository stores it.
      }
    }
    schema AssetData is relational
      of assets as record StoredAsset
        index on field StoredAsset.assetId
        index on field StoredAsset.assetInfo.assetTag
        index on field StoredAsset.status
        index on field StoredAsset.location.locationId
 with {
      briefly "Asset data schema"
      described as {
        |The relational schema holding asset data for the AssetRepository.
      }
    }
    handler AssetPersistence is {
      on persistAssetDecommissioned: command PersistAssetDecommissioned is {
        do "apply AssetDecommissioned to the stored row"
      }
      on persistAssetDisposed: command PersistAssetDisposed is {
        do "apply AssetDisposed to the stored row"
      }
      on persistAssetInstalled: command PersistAssetInstalled is {
        do "apply AssetInstalled to the stored row"
      }
      on persistAssetRegistered: command PersistAssetRegistered is {
        do "apply AssetRegistered to the stored row"
      }
      on persistAssetTransferred: command PersistAssetTransferred is {
        do "apply AssetTransferred to the stored row"
      }
      on persistDepreciationScheduled: command PersistDepreciationScheduled is {
        do "apply DepreciationScheduled to the stored row"
      }
      on persistMaintenanceRecorded: command PersistMaintenanceRecorded is {
        do "apply MaintenanceRecorded to the stored row"
      }
      on persistValuationUpdated: command PersistValuationUpdated is {
        do "apply ValuationUpdated to the stored row"
      }
      on query GetValuationSummary is {
        let valuationSummaryView: type ValuationSummaryView = prompt("read the valuation summary projection")
        reply valuationSummaryView
      }
      on query GetDepreciationReport is {
        let depreciationReportView: type DepreciationReportView = prompt("read the depreciation report projection")
        reply depreciationReportView
      }
      on query GetUtilizationMetrics is {
        let utilizationMetricsView: type UtilizationMetricsView = prompt("read the utilization metrics projection")
        reply utilizationMetricsView
      }
    } with {
      briefly "Persists asset commands"
      described as {
        |Handles command-driven persistence for assets.
      }
    }
  } with {
    briefly "Asset data persistence"
    described as {
      | The AssetRepository provides persistent storage for
      | assets, their financial data, and lifecycle history.
    }
  }
  // Projector for asset valuation reporting
  query GetValuationSummary replies result ValuationSummaryView is {
    valuationSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which valuation summary to retrieve.
      }
    }
  } with {
    briefly "Get valuation summary"
    described as {
      |Retrieves the valuation summary projection.
    }
  }
  result ValuationSummaryView is {
    valuationSummary: AssetValuationProjector.ValuationSummary with {
      briefly "Valuation summary"
      described as {
        |The valuation summary being returned.
      }
    }
  } with {
    briefly "Valuation summary view"
    described as {
      |Read model view carrying the valuation summary projection.
    }
  }
  projector AssetValuationProjector as flow is {
    updates repository AssetContext.AssetRepository
    outlet AssetValuationProjectorToRepository is type AssetRepositoryCommand
    inlet AssetValuationProjectorFromAsset is type AssetEvent    record ValuationSummary is {
      totalAssets: Natural with {
        briefly "Total"
        described as {
          |Total number of assets.
        }
      }
      totalCapitalizedCost: Decimal(15,2) with {
        briefly "Capitalized"
        described as {
          |Total capitalized cost.
        }
      }
      totalCurrentValue: Decimal(15,2) with {
        briefly "Current value"
        described as {
          |Total current book value.
        }
      }
      totalAccumulatedDepreciation: Decimal(15,2) with {
        briefly "Depreciation"
        described as {
          |Total accumulated depreciation.
        }
      }
      averageAssetAge: Decimal(5,2) with {
        briefly "Average age"
        described as {
          |Average asset age in years.
        }
      }
    } with {
      briefly "Valuation summary"
      described as {
        |Summary of asset valuations.
      }
    }
    handler ValuationHandler is {
      on assetDecommissioned: event Asset.AssetDecommissioned is {
        tell command AssetContext.AssetRepository.PersistAssetDecommissioned(assetId = assetDecommissioned.assetId) to repository AssetContext.AssetRepository
        do "apply AssetDecommissioned to the AssetValuationProjector projection"
      }
      on assetInstalled: event Asset.AssetInstalled is {
        tell command AssetContext.AssetRepository.PersistAssetInstalled(assetId = assetInstalled.assetId) to repository AssetContext.AssetRepository
        do "apply AssetInstalled to the AssetValuationProjector projection"
      }
      on assetTransferred: event Asset.AssetTransferred is {
        tell command AssetContext.AssetRepository.PersistAssetTransferred(assetId = assetTransferred.assetId) to repository AssetContext.AssetRepository
        do "apply AssetTransferred to the AssetValuationProjector projection"
      }
      on maintenanceRecorded: event Asset.MaintenanceRecorded is {
        tell command AssetContext.AssetRepository.PersistMaintenanceRecorded(assetId = maintenanceRecorded.assetId) to repository AssetContext.AssetRepository
        do "apply MaintenanceRecorded to the AssetValuationProjector projection"
      }
      on assetRegistered: event Asset.AssetRegistered is {
        tell command AssetContext.AssetRepository.PersistAssetRegistered(assetId = assetRegistered.assetId) to repository AssetContext.AssetRepository
        do "Add new asset to valuation totals"
      }
      on valuationUpdated: event Asset.ValuationUpdated is {
        tell command AssetContext.AssetRepository.PersistValuationUpdated(assetId = valuationUpdated.assetId) to repository AssetContext.AssetRepository
        do "Update valuation totals with new values"
      }
      on depreciationScheduled: event Asset.DepreciationScheduled is {
        tell command AssetContext.AssetRepository.PersistDepreciationScheduled(assetId = depreciationScheduled.assetId) to repository AssetContext.AssetRepository
        do "Update depreciation calculations"
      }
      on assetDisposed: event Asset.AssetDisposed is {
        tell command AssetContext.AssetRepository.PersistAssetDisposed(assetId = assetDisposed.assetId) to repository AssetContext.AssetRepository
        do "Remove asset from active valuation totals"
      }
    } with {
      briefly "Maintains valuation projections"
      described as {
        |Projects events into valuation views.
      }
    }
  } with {
    briefly "Asset valuation projections"
    described as {
      |Maintains asset valuation and financial reporting data.
    }
  }
  // Projector for depreciation reports
  query GetDepreciationReport replies result DepreciationReportView is {
    depreciationReportKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which depreciation report to retrieve.
      }
    }
  } with {
    briefly "Get depreciation report"
    described as {
      |Retrieves the depreciation report projection.
    }
  }
  result DepreciationReportView is {
    depreciationReport: DepreciationReportProjector.DepreciationReport with {
      briefly "Depreciation report"
      described as {
        |The depreciation report being returned.
      }
    }
  } with {
    briefly "Depreciation report view"
    described as {
      |Read model view carrying the depreciation report projection.
    }
  }
  projector DepreciationReportProjector as sink is {
    updates repository AssetContext.AssetRepository
    inlet DepreciationReportProjectorFromAsset is type AssetEvent    record DepreciationReport is {
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Report period start date.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Report period end date.
        }
      }
      totalDepreciation: Decimal(15,2) with {
        briefly "Total"
        described as {
          |Total depreciation for period.
        }
      }
      assetCount: Natural with {
        briefly "Asset count"
        described as {
          |Number of assets depreciated.
        }
      }
      byCategory: String(1,500)+ with {
        briefly "By category"
        described as {
          |Depreciation by category.
        }
      }
    } with {
      briefly "Depreciation report"
      described as {
        |Period depreciation report.
      }
    }
    handler DepreciationHandler is {
      on assetDisposed: event Asset.AssetDisposed is {
        tell command AssetContext.AssetRepository.PersistAssetDisposed(assetId = assetDisposed.assetId) to repository AssetContext.AssetRepository
        do "apply AssetDisposed to the DepreciationReportProjector projection"
      }
      on assetInstalled: event Asset.AssetInstalled is {
        tell command AssetContext.AssetRepository.PersistAssetInstalled(assetId = assetInstalled.assetId) to repository AssetContext.AssetRepository
        do "apply AssetInstalled to the DepreciationReportProjector projection"
      }
      on assetRegistered: event Asset.AssetRegistered is {
        tell command AssetContext.AssetRepository.PersistAssetRegistered(assetId = assetRegistered.assetId) to repository AssetContext.AssetRepository
        do "apply AssetRegistered to the DepreciationReportProjector projection"
      }
      on assetTransferred: event Asset.AssetTransferred is {
        tell command AssetContext.AssetRepository.PersistAssetTransferred(assetId = assetTransferred.assetId) to repository AssetContext.AssetRepository
        do "apply AssetTransferred to the DepreciationReportProjector projection"
      }
      on maintenanceRecorded: event Asset.MaintenanceRecorded is {
        tell command AssetContext.AssetRepository.PersistMaintenanceRecorded(assetId = maintenanceRecorded.assetId) to repository AssetContext.AssetRepository
        do "apply MaintenanceRecorded to the DepreciationReportProjector projection"
      }
      on depreciationScheduled: event Asset.DepreciationScheduled is {
        tell command AssetContext.AssetRepository.PersistDepreciationScheduled(assetId = depreciationScheduled.assetId) to repository AssetContext.AssetRepository
        do "Add asset to depreciation tracking"
      }
      on valuationUpdated: event Asset.ValuationUpdated is {
        tell command AssetContext.AssetRepository.PersistValuationUpdated(assetId = valuationUpdated.assetId) to repository AssetContext.AssetRepository
        do "Update depreciation calculations"
      }
      on assetDecommissioned: event Asset.AssetDecommissioned is {
        tell command AssetContext.AssetRepository.PersistAssetDecommissioned(assetId = assetDecommissioned.assetId) to repository AssetContext.AssetRepository
        do "Stop depreciation for asset"
      }
    } with {
      briefly "Maintains depreciation reports"
      described as {
        |Projects events into depreciation reports.
      }
    }
  } with {
    briefly "Depreciation report projections"
    described as {
      |Maintains depreciation reporting data.
    }
  }
  // Projector for utilization tracking
  query GetUtilizationMetrics replies result UtilizationMetricsView is {
    utilizationMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization metrics to retrieve.
      }
    }
  } with {
    briefly "Get utilization metrics"
    described as {
      |Retrieves the utilization metrics projection.
    }
  }
  result UtilizationMetricsView is {
    utilizationMetrics: UtilizationProjector.UtilizationMetrics with {
      briefly "Utilization metrics"
      described as {
        |The utilization metrics being returned.
      }
    }
  } with {
    briefly "Utilization metrics view"
    described as {
      |Read model view carrying the utilization metrics projection.
    }
  }
  projector UtilizationProjector as sink is {
    updates repository AssetContext.AssetRepository
    inlet UtilizationProjectorFromAsset is type AssetEvent    record UtilizationMetrics is {
      activeAssets: Natural with {
        briefly "Active"
        described as {
          |Number of active assets.
        }
      }
      utilizationRate: Decimal(5,4) with {
        briefly "Utilization"
        described as {
          |Overall utilization rate.
        }
      }
      underMaintenanceCount: Natural with {
        briefly "Under maintenance"
        described as {
          |Assets under maintenance.
        }
      }
      decommissionedCount: Natural with {
        briefly "Decommissioned"
        described as {
          |Decommissioned assets.
        }
      }
      averageLifespan: Decimal(6,2) with {
        briefly "Avg lifespan"
        described as {
          |Average asset lifespan in months.
        }
      }
    } with {
      briefly "Utilization metrics"
      described as {
        |Asset utilization statistics.
      }
    }
    handler UtilizationHandler is {
      on assetRegistered: event Asset.AssetRegistered is {
        tell command AssetContext.AssetRepository.PersistAssetRegistered(assetId = assetRegistered.assetId) to repository AssetContext.AssetRepository
        do "apply AssetRegistered to the UtilizationProjector projection"
      }
      on depreciationScheduled: event Asset.DepreciationScheduled is {
        tell command AssetContext.AssetRepository.PersistDepreciationScheduled(assetId = depreciationScheduled.assetId) to repository AssetContext.AssetRepository
        do "apply DepreciationScheduled to the UtilizationProjector projection"
      }
      on valuationUpdated: event Asset.ValuationUpdated is {
        tell command AssetContext.AssetRepository.PersistValuationUpdated(assetId = valuationUpdated.assetId) to repository AssetContext.AssetRepository
        do "apply ValuationUpdated to the UtilizationProjector projection"
      }
      on assetInstalled: event Asset.AssetInstalled is {
        tell command AssetContext.AssetRepository.PersistAssetInstalled(assetId = assetInstalled.assetId) to repository AssetContext.AssetRepository
        do "Increment active asset count"
      }
      on assetTransferred: event Asset.AssetTransferred is {
        tell command AssetContext.AssetRepository.PersistAssetTransferred(assetId = assetTransferred.assetId) to repository AssetContext.AssetRepository
        do "Update utilization by location"
      }
      on maintenanceRecorded: event Asset.MaintenanceRecorded is {
        tell command AssetContext.AssetRepository.PersistMaintenanceRecorded(assetId = maintenanceRecorded.assetId) to repository AssetContext.AssetRepository
        do "Update maintenance metrics"
      }
      on assetDecommissioned: event Asset.AssetDecommissioned is {
        tell command AssetContext.AssetRepository.PersistAssetDecommissioned(assetId = assetDecommissioned.assetId) to repository AssetContext.AssetRepository
        do "Update decommissioned count"
      }
      on assetDisposed: event Asset.AssetDisposed is {
        tell command AssetContext.AssetRepository.PersistAssetDisposed(assetId = assetDisposed.assetId) to repository AssetContext.AssetRepository
        do "Calculate final lifespan metrics"
      }
    } with {
      briefly "Maintains utilization metrics"
      described as {
        |Projects events into utilization views.
      }
    }
  } with {
    briefly "Utilization tracking projections"
    described as {
      |Maintains asset utilization and performance data.
    }
  }
  // ---- Event publication for Asset ----
  type AssetEvent is one of {
    AssetContext.Asset.AssetRegistered or AssetContext.Asset.AssetInstalled or AssetContext.Asset.AssetTransferred or AssetContext.Asset.ValuationUpdated or AssetContext.Asset.DepreciationScheduled or AssetContext.Asset.MaintenanceRecorded or AssetContext.Asset.AssetDecommissioned or AssetContext.Asset.AssetDisposed
  } with {
    briefly "Asset event alternation"
    described as {
      |Union of all Asset events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet AssetEventSplit as split is {
    inlet AssetEventSplitIn is type AssetEvent    outlet AssetEventSplitToAssetValuationProjector is type AssetEvent
    outlet AssetEventSplitToDepreciationReportProjector is type AssetEvent
    outlet AssetEventSplitToUtilizationProjector is type AssetEvent
    handler AssetEventSplitHandler is {
      on assetRegistered: event Asset.AssetRegistered is {
        send assetRegistered to outlet AssetEventSplitToAssetValuationProjector
        send assetRegistered to outlet AssetEventSplitToDepreciationReportProjector
        send assetRegistered to outlet AssetEventSplitToUtilizationProjector
        tell assetRegistered to entity AssetContext.Asset
      }
      on assetInstalled: event Asset.AssetInstalled is {
        send assetInstalled to outlet AssetEventSplitToAssetValuationProjector
        send assetInstalled to outlet AssetEventSplitToDepreciationReportProjector
        send assetInstalled to outlet AssetEventSplitToUtilizationProjector
        tell assetInstalled to entity AssetContext.Asset
      }
      on assetTransferred: event Asset.AssetTransferred is {
        send assetTransferred to outlet AssetEventSplitToAssetValuationProjector
        send assetTransferred to outlet AssetEventSplitToDepreciationReportProjector
        send assetTransferred to outlet AssetEventSplitToUtilizationProjector
        tell assetTransferred to entity AssetContext.Asset
      }
      on valuationUpdated: event Asset.ValuationUpdated is {
        send valuationUpdated to outlet AssetEventSplitToAssetValuationProjector
        send valuationUpdated to outlet AssetEventSplitToDepreciationReportProjector
        send valuationUpdated to outlet AssetEventSplitToUtilizationProjector
        tell valuationUpdated to entity AssetContext.Asset
      }
      on depreciationScheduled: event Asset.DepreciationScheduled is {
        send depreciationScheduled to outlet AssetEventSplitToAssetValuationProjector
        send depreciationScheduled to outlet AssetEventSplitToDepreciationReportProjector
        send depreciationScheduled to outlet AssetEventSplitToUtilizationProjector
        tell depreciationScheduled to entity AssetContext.Asset
      }
      on maintenanceRecorded: event Asset.MaintenanceRecorded is {
        send maintenanceRecorded to outlet AssetEventSplitToAssetValuationProjector
        send maintenanceRecorded to outlet AssetEventSplitToDepreciationReportProjector
        send maintenanceRecorded to outlet AssetEventSplitToUtilizationProjector
        tell maintenanceRecorded to entity AssetContext.Asset
      }
      on assetDecommissioned: event Asset.AssetDecommissioned is {
        send assetDecommissioned to outlet AssetEventSplitToAssetValuationProjector
        send assetDecommissioned to outlet AssetEventSplitToDepreciationReportProjector
        send assetDecommissioned to outlet AssetEventSplitToUtilizationProjector
        tell assetDecommissioned to entity AssetContext.Asset
      }
      on assetDisposed: event Asset.AssetDisposed is {
        send assetDisposed to outlet AssetEventSplitToAssetValuationProjector
        send assetDisposed to outlet AssetEventSplitToDepreciationReportProjector
        send assetDisposed to outlet AssetEventSplitToUtilizationProjector
        tell assetDisposed to entity AssetContext.Asset
      }
      on other is {
        error "Unexpected message for processor AssetEventSplit"
      }
    } with {
      briefly "Asset event fan-out handler"
      described as {
        |Delivers each Asset event to all of its consumers.
      }
    }
  } with {
    briefly "Asset event fan-out"
    described as {
      |Fans Asset events out to the repository and projectors.
    }
  }
  connector 'AssetEvent Stream' is from outlet AssetContext.Asset.AssetEvents2 to inlet AssetContext.AssetEventSplit.AssetEventSplitIn with {
    briefly "Asset events, fanned out to storage and read models"
  }
  connector 'AssetValuationProjector Feed' is from outlet AssetContext.AssetEventSplit.AssetEventSplitToAssetValuationProjector to inlet AssetContext.AssetValuationProjector.AssetValuationProjectorFromAsset with {
    briefly "Asset events feeding the AssetValuationProjector projection"
  }
  connector 'DepreciationReportProjector Feed' is from outlet AssetContext.AssetEventSplit.AssetEventSplitToDepreciationReportProjector to inlet AssetContext.DepreciationReportProjector.DepreciationReportProjectorFromAsset with {
    briefly "Asset events feeding the DepreciationReportProjector projection"
  }
  connector 'UtilizationProjector Feed' is from outlet AssetContext.AssetEventSplit.AssetEventSplitToUtilizationProjector to inlet AssetContext.UtilizationProjector.UtilizationProjectorFromAsset with {
    briefly "Asset events feeding the UtilizationProjector projection"
  }
  connector 'AssetValuationProjector Storage' is from outlet AssetContext.AssetValuationProjector.AssetValuationProjectorToRepository to inlet AssetContext.AssetRepository.AssetRepositoryFromAssetValuationProjector with {
    briefly "AssetValuationProjector updates on their way to storage"
  }
} with {
  briefly "Bounded context for asset lifecycle management"
  described as {
    | The AssetContext is the bounded context for managing
    | physical assets throughout their complete lifecycle.
  }
}
