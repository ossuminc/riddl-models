// Asset Lifecycle Management Domain Model
// Manufacturing asset lifecycle from acquisition to disposal
domain AssetLifecycleManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user AssetManager is "person managing physical assets" with {
    briefly "Asset Manager"
    described as {
      |Person responsible for asset acquisition, tracking, and disposal.
    }
  }
  user FinanceController is "person overseeing financial accounting" with {
    briefly "Finance Controller"
    described as {
      |Person managing asset valuation and depreciation schedules.
    }
  }
  user OperationsManager is "person managing facility operations" with {
    briefly "Operations Manager"
    described as {
      |Person coordinating asset utilization and transfers.
    }
  }
  epic AssetLifecycleEpic is {
    user AssetManager wants to "to manage the complete lifecycle of physical assets" so that "asset value is maximized and compliance is maintained"
    case AcquireAsset is {
      user AssetManager wants to "to register a newly acquired asset" so that "it enters the asset registry and is properly tracked"
      step is "Manager reviews" "purchase order and receiving documents" "for asset details" with {
        briefly "Review documents"
        described as {
          |Check purchase records.
        }
      }
      step is "Manager captures" "asset specifications and costs" "for registration" with {
        briefly "Capture details"
        described as {
          |Record asset information.
        }
      }
      step take input AssetLifecycleManagementApp.AssetLifecycleManagementScreen.RegisterAssetInput from user AssetManager with {
        briefly "Register asset"
        described as {
          |Create asset record.
        }
      }
      step is "System assigns" "asset tag and location" "for tracking" with {
        briefly "Assign tracking"
        described as {
          |Enable asset tracking.
        }
      }
    } with {
      briefly "Asset acquisition"
      described as {
        |Registering newly acquired assets.
      }
    }
    case ManageAssetLifecycle is {
      user OperationsManager wants to "to track asset through operational lifecycle" so that "utilization and maintenance are optimized"
      step take input AssetLifecycleManagementApp.AssetLifecycleManagementScreen.InstallAssetInput from user OperationsManager with {
        briefly "Install asset"
        described as {
          |Put asset into service.
        }
      }
      step is "System monitors" "asset performance and maintenance needs" "continuously" with {
        briefly "Monitor asset"
        described as {
          |Track asset health.
        }
      }
      step take input AssetLifecycleManagementApp.AssetLifecycleManagementScreen.TransferAssetInput from user OperationsManager with {
        briefly "Transfer asset"
        described as {
          |Move to new location.
        }
      }
    } with {
      briefly "Lifecycle management"
      described as {
        |Managing asset through operational life.
      }
    }
    case RetireAsset is {
      user AssetManager wants to "to properly decommission and dispose of assets" so that "regulatory compliance is maintained and residual value is captured"
      step take input AssetLifecycleManagementApp.AssetLifecycleManagementScreen.DecommissionAssetInput from user AssetManager with {
        briefly "Decommission asset"
        described as {
          |Remove from service.
        }
      }
      step is "Finance reviews" "residual value and disposition options" "for approval" with {
        briefly "Review disposition"
        described as {
          |Evaluate disposal options.
        }
      }
      step take input AssetLifecycleManagementApp.AssetLifecycleManagementScreen.DisposeAssetInput from user AssetManager with {
        briefly "Dispose asset"
        described as {
          |Complete asset disposal.
        }
      }
    } with {
      briefly "Asset retirement"
      described as {
        |Decommissioning and disposing of assets.
      }
    }
  } with {
    briefly "Asset lifecycle management"
    described as {
      | Epic covering the complete asset lifecycle from
      | acquisition through installation, operation,
      | transfer, depreciation, and disposal.
    }
  }
  include "AssetContext.riddl"
  include "external-contexts.riddl"
  application context AssetLifecycleManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AssetLifecycleManagement are delivered.
      }
    }
    group AssetLifecycleManagementScreen is {
      input RegisterAssetInput acquires command AssetContext.Asset.RegisterAsset with {
        briefly "Register asset control"
        described as {
          |The control through which a user submits the register asset request.
        }
      }
      input InstallAssetInput acquires command AssetContext.Asset.InstallAsset with {
        briefly "Install asset control"
        described as {
          |The control through which a user submits the install asset request.
        }
      }
      input TransferAssetInput acquires command AssetContext.Asset.TransferAsset with {
        briefly "Transfer asset control"
        described as {
          |The control through which a user submits the transfer asset request.
        }
      }
      input DecommissionAssetInput acquires command AssetContext.Asset.DecommissionAsset with {
        briefly "Decommission asset control"
        described as {
          |The control through which a user submits the decommission asset request.
        }
      }
      input DisposeAssetInput acquires command AssetContext.Asset.DisposeAsset with {
        briefly "Dispose asset control"
        described as {
          |The control through which a user submits the dispose asset request.
        }
      }
    } with {
      briefly "Asset lifecycle management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAssetCommands is type AssetContext.Asset.AssetCommand
    inlet AppAssetRepositoryResponses is type AssetContext.Asset.AssetResult    handler AssetLifecycleManagementAppHandler is {
      on other is {
        error "Unexpected message for application context AssetLifecycleManagementApp"
      }
    } with {
      briefly "AssetLifecycleManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AssetLifecycleManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'AssetCommand Stream' is from outlet AssetLifecycleManagementApp.AppAssetCommands to inlet AssetContext.Asset.AssetCommands with {
    option persistent()
    briefly "Asset commands from the application"
  }
  connector 'AssetResult Stream' is from outlet AssetContext.AssetRepository.AssetRepositoryResponses to inlet AssetLifecycleManagementApp.AppAssetRepositoryResponses with {
    option persistent()
    briefly "Asset query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AssetLifecycleManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Asset lifecycle management domain"
  described as {
    | The AssetLifecycleManagement domain handles physical
    | asset tracking, valuation, depreciation, and disposal
    | throughout the complete asset lifecycle.
  }
}
