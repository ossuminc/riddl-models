// Equipment Maintenance - Maintenance Context
// The primary bounded context for equipment maintenance management
context MaintenanceContext is {
  include "types.riddl"
  include "MaintenanceOrder.riddl"
  // Adaptors for external system integration
  adaptor EquipmentAdapter from context EquipmentRegistry is { 
    handler InboundEquipment is {
      on event EquipmentRegistry.EquipmentStatusChanged is {
        do "Update maintenance schedule based on equipment status change"
      }
      on event EquipmentRegistry.MaintenanceScheduleUpdated is {
        do "Create preventive maintenance orders from updated schedule"
      }
      on other is {
        error "Unexpected message for adaptor EquipmentAdapter"
      }
    } with {
      briefly "Handles equipment registry events"
      described as {
        |Processes equipment status changes and schedule updates.
      }
    }
  } with {
    briefly "Translates equipment registry events"
    described as {
      | Receives equipment master data events from the external EquipmentRegistry
      | and creates or updates maintenance orders accordingly.
    }
  }
  adaptor InventoryAdapter from context SparePartsInventory is { 
    handler InboundInventory is {
      on event SparePartsInventory.PartsReserved is {
        do "Update order with parts reservation confirmation"
      }
      on event SparePartsInventory.PartsReservationFailed is {
        do "Notify planner of parts shortage and suggest alternatives"
      }
      on event SparePartsInventory.PartsConsumed is {
        tell command RecordSpareUsage to entity MaintenanceOrder
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles spare parts inventory events"
      described as {
        |Processes parts availability and consumption events.
      }
    }
  } with {
    briefly "Translates spare parts inventory events"
    described as {
      | Receives parts reservation and consumption events from the
      | SparePartsInventory and updates maintenance orders accordingly.
    }
  }
  adaptor ProductionAdapter from context ProductionSchedule is { 
    handler InboundProduction is {
      on event ProductionSchedule.MaintenanceWindowApproved is {
        do "Update maintenance order with approved schedule window"
      }
      on event ProductionSchedule.MaintenanceWindowRejected is {
        do "Reschedule maintenance order for alternative window"
      }
      on event ProductionSchedule.EquipmentNeededUrgently is {
        do "Expedite in-progress maintenance or defer non-critical work"
      }
      on other is {
        error "Unexpected message for adaptor ProductionAdapter"
      }
    } with {
      briefly "Handles production schedule events"
      described as {
        |Processes maintenance window approvals and production priorities.
      }
    }
  } with {
    briefly "Translates production schedule events"
    described as {
      | Receives maintenance window coordination events from Production
      | Schedule to align maintenance activities with production needs.
    }
  }
  // Repository for maintenance persistence
  repository MaintenanceRepository is {
    inlet MaintenanceRepositoryFromMaintenanceOrder is type MaintenanceOrderEvent    inlet MaintenanceRepositoryFromMaintenanceMetrics is type MaintenanceOrderEvent    outlet MaintenanceRepositoryResponses is type MaintenanceOrder.MaintenanceOrderResult
    record StoredMaintenanceOrder is  {
      maintenanceOrderId: MaintenanceOrderId with {
        briefly "maintenanceOrderId"
        described as {
          |The maintenanceOrderId column of the stored maintenanceOrder row.
        }
      }
      equipmentId: EquipmentId with {
        briefly "equipmentId"
        described as {
          |The equipmentId column of the stored maintenanceOrder row.
        }
      }
      maintenanceType: MaintenanceType with {
        briefly "maintenanceType"
        described as {
          |The maintenanceType column of the stored maintenanceOrder row.
        }
      }
      scheduledDate: Date with {
        briefly "scheduledDate"
        described as {
          |The scheduledDate column of the stored maintenanceOrder row.
        }
      }
    } with {
      briefly "Stored maintenanceOrder row"
      described as {
        |The persistence shape of maintenanceOrder data as this repository stores it.
      }
    }
    schema MaintenanceData is relational
      of maintenanceOrders as type StoredMaintenanceOrder
        index on field StoredMaintenanceOrder.equipmentId
        index on field StoredMaintenanceOrder.scheduledDate
        index on field StoredMaintenanceOrder.maintenanceType
 with {
      briefly "Maintenance data schema"
      described as {
        |The relational schema holding maintenance data for the MaintenanceRepository.
      }
    }
    handler MaintenancePersistence is {
      on query GetEquipmentReliabilityMetrics is {
        do "read the equipment reliability metrics projection"
        yield result EquipmentReliabilityMetricsView
      }
      on query GetMaintenanceWorkMetrics is {
        do "read the maintenance work metrics projection"
        yield result MaintenanceWorkMetricsView
      }
      on command MaintenanceOrder.CreateMaintenanceOrder is {
        tell event MaintenanceOrder.MaintenanceOrderCreated to entity MaintenanceContext.MaintenanceOrder
        do "Persist new maintenance order to database"
      }
      on command MaintenanceOrder.AssignTechnician is {
        tell event MaintenanceOrder.TechnicianAssigned to entity MaintenanceContext.MaintenanceOrder
        do "Update order with technician assignment"
      }
      on command MaintenanceOrder.StartMaintenance is {
        tell event MaintenanceOrder.MaintenanceStarted to entity MaintenanceContext.MaintenanceOrder
        do "Update order status and start labor tracking"
      }
      on command MaintenanceOrder.RecordSpareUsage is {
        tell event MaintenanceOrder.SpareUsageRecorded to entity MaintenanceContext.MaintenanceOrder
        do "Record spare parts usage on order"
      }
      on command MaintenanceOrder.CompleteMaintenance is {
        tell event MaintenanceOrder.MaintenanceCompleted to entity MaintenanceContext.MaintenanceOrder
        do "Update order to completed with final metrics"
      }
      on command MaintenanceOrder.CancelOrder is {
        tell event MaintenanceOrder.OrderCancelled to entity MaintenanceContext.MaintenanceOrder
        do "Update order to cancelled status"
      }
    } with {
      briefly "Persists maintenance events to storage"
      described as {
        |Handles all event-driven persistence operations for maintenance orders.
      }
    }
  } with {
    briefly "Persistent storage for maintenance data"
    described as {
      | The MaintenanceRepository provides persistent storage for maintenance
      | orders with appropriate indexes for common query patterns including
      | by equipment, date, and maintenance type.
    }
  }
  // Projector for maintenance metrics
  query GetEquipmentReliabilityMetrics is  {
    equipmentReliabilityMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which equipment reliability metrics to retrieve.
      }
    }
  } with {
    briefly "Get equipment reliability metrics"
    described as {
      |Retrieves the equipment reliability metrics projection.
    }
  }
  result EquipmentReliabilityMetricsView is  {
    equipmentReliabilityMetrics: MaintenanceMetrics.EquipmentReliabilityMetrics with {
      briefly "Equipment reliability metrics"
      described as {
        |The equipment reliability metrics being returned.
      }
    }
  } with {
    briefly "Equipment reliability metrics view"
    described as {
      |Read model view carrying the equipment reliability metrics projection.
    }
  }
  query GetMaintenanceWorkMetrics is  {
    maintenanceWorkMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which maintenance work metrics to retrieve.
      }
    }
  } with {
    briefly "Get maintenance work metrics"
    described as {
      |Retrieves the maintenance work metrics projection.
    }
  }
  result MaintenanceWorkMetricsView is  {
    maintenanceWorkMetrics: MaintenanceMetrics.MaintenanceWorkMetrics with {
      briefly "Maintenance work metrics"
      described as {
        |The maintenance work metrics being returned.
      }
    }
  } with {
    briefly "Maintenance work metrics view"
    described as {
      |Read model view carrying the maintenance work metrics projection.
    }
  }
  projector MaintenanceMetrics is {
    updates repository MaintenanceContext.MaintenanceRepository
    inlet MaintenanceMetricsFromMaintenanceOrder is type MaintenanceOrderEvent    outlet MaintenanceMetricsOut is type MaintenanceOrderEvent
    record EquipmentReliabilityMetrics is  {
      equipmentId: EquipmentId with {
        briefly "Equipment ID"
        described as {
          |Equipment being tracked.
        }
      }
      equipmentName: String(1,200) with {
        briefly "Equipment name"
        described as {
          |Equipment name for display.
        }
      }
      mtbf: Decimal(10,2) with {
        briefly "MTBF (hours)"
        described as {
          |Mean Time Between Failures in hours.
        }
      }
      mttr: Decimal(10,2) with {
        briefly "MTTR (hours)"
        described as {
          |Mean Time To Repair in hours.
        }
      }
      equipmentAvailability: Decimal(5,2) with {
        briefly "Availability (%)"
        described as {
          |Equipment availability percentage.
        }
      }
      failureCount: Natural with {
        briefly "Failure count"
        described as {
          |Total number of failures in period.
        }
      }
      plannedDowntimeHours: Decimal(10,2) with {
        briefly "Planned downtime"
        described as {
          |Hours of planned downtime.
        }
      }
      unplannedDowntimeHours: Decimal(10,2) with {
        briefly "Unplanned downtime"
        described as {
          |Hours of unplanned downtime.
        }
      }
      totalMaintenanceCost: Decimal(12,2) with {
        briefly "Total cost"
        described as {
          |Total maintenance cost for period.
        }
      }
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of measurement period.
        }
      }
    } with {
      briefly "Equipment reliability metrics"
      described as {
        |Aggregated reliability statistics for a single piece of equipment.
      }
    }
    record MaintenanceWorkMetrics is  {
      period: Date with {
        briefly "Period"
        described as {
          |Date for these metrics.
        }
      }
      totalOrders: Natural with {
        briefly "Total orders"
        described as {
          |Total maintenance orders.
        }
      }
      preventiveCount: Natural with {
        briefly "Preventive"
        described as {
          |Preventive maintenance orders.
        }
      }
      correctiveCount: Natural with {
        briefly "Corrective"
        described as {
          |Corrective maintenance orders.
        }
      }
      predictiveCount: Natural with {
        briefly "Predictive"
        described as {
          |Predictive maintenance orders.
        }
      }
      emergencyCount: Natural with {
        briefly "Emergency"
        described as {
          |Emergency maintenance orders.
        }
      }
      completedOnTime: Natural with {
        briefly "On time"
        described as {
          |Orders completed on schedule.
        }
      }
      averageCompletionTime: Decimal(10,2) with {
        briefly "Avg completion"
        described as {
          |Average completion time in hours.
        }
      }
      totalLaborHours: Decimal(10,2) with {
        briefly "Labor hours"
        described as {
          |Total labor hours expended.
        }
      }
      periodPartsCost: Decimal(12,2) with {
        briefly "Parts cost"
        described as {
          |Total spare parts cost.
        }
      }
      totalLaborCost: Decimal(12,2) with {
        briefly "Labor cost"
        described as {
          |Total labor cost.
        }
      }
    } with {
      briefly "Daily maintenance work metrics"
      described as {
        |Aggregated maintenance work statistics for a day.
      }
    }
    handler MetricsHandler is {
      on event MaintenanceOrder.MaintenanceOrderCreated is {
        tell event MaintenanceOrder.MaintenanceOrderCreated to repository MaintenanceContext.MaintenanceRepository
        do "Update order counts by type"
      }
      on event MaintenanceOrder.MaintenanceCompleted is {
        tell event MaintenanceOrder.MaintenanceCompleted to repository MaintenanceContext.MaintenanceRepository
        do "Calculate completion metrics and update MTBF/MTTR"
      }
      on event MaintenanceOrder.SpareUsageRecorded is {
        tell event MaintenanceOrder.SpareUsageRecorded to repository MaintenanceContext.MaintenanceRepository
        do "Update parts cost metrics"
      }
    } with {
      briefly "Projects maintenance events for metrics"
      described as {
        |Processes maintenance events to maintain aggregate metrics.
      }
    }
  } with {
    briefly "Projects maintenance events for reporting"
    described as {
      | Maintains aggregated views of maintenance data for dashboards
      | and reliability analysis including MTBF, MTTR, and availability
      | calculations for each piece of equipment.
    }
  }
  // ---- Event publication for MaintenanceOrder ----
  type MaintenanceOrderEvent is one of {
    MaintenanceContext.MaintenanceOrder.MaintenanceOrderCreated or MaintenanceContext.MaintenanceOrder.TechnicianAssigned or MaintenanceContext.MaintenanceOrder.MaintenanceStarted or MaintenanceContext.MaintenanceOrder.SpareUsageRecorded or MaintenanceContext.MaintenanceOrder.MaintenanceCompleted or MaintenanceContext.MaintenanceOrder.OrderCancelled
  } with {
    briefly "MaintenanceOrder event alternation"
    described as {
      |Union of all MaintenanceOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MaintenanceOrderEventSource as source is {
    outlet MaintenanceOrderEvents is type MaintenanceOrderEvent
    handler MaintenanceOrderSourceHandler is {
      on event MaintenanceOrder.MaintenanceOrderCreated is {
        send event MaintenanceOrder.MaintenanceOrderCreated to outlet MaintenanceOrderEvents
      }
      on event MaintenanceOrder.TechnicianAssigned is {
        send event MaintenanceOrder.TechnicianAssigned to outlet MaintenanceOrderEvents
      }
      on event MaintenanceOrder.MaintenanceStarted is {
        send event MaintenanceOrder.MaintenanceStarted to outlet MaintenanceOrderEvents
      }
      on event MaintenanceOrder.SpareUsageRecorded is {
        send event MaintenanceOrder.SpareUsageRecorded to outlet MaintenanceOrderEvents
      }
      on event MaintenanceOrder.MaintenanceCompleted is {
        send event MaintenanceOrder.MaintenanceCompleted to outlet MaintenanceOrderEvents
      }
      on event MaintenanceOrder.OrderCancelled is {
        send event MaintenanceOrder.OrderCancelled to outlet MaintenanceOrderEvents
      }
      on other is {
        error "Unexpected message for source MaintenanceOrderEventSource"
      }
    } with {
      briefly "MaintenanceOrder source handler"
      described as {
        |Publishes MaintenanceOrder events onto the outlet.
      }
    }
  } with {
    briefly "MaintenanceOrder event source"
    described as {
      |Publishes MaintenanceOrder entity events into the streaming topology.
    }
  }
  processor MaintenanceOrderEventSink as sink is {
    inlet MaintenanceOrderInlet is type MaintenanceOrderEvent    handler MaintenanceOrderSinkHandler is {
      on event MaintenanceOrder.MaintenanceOrderCreated is {
        tell event MaintenanceOrder.MaintenanceOrderCreated to repository MaintenanceContext.MaintenanceRepository
      }
      on event MaintenanceOrder.TechnicianAssigned is {
        tell event MaintenanceOrder.TechnicianAssigned to repository MaintenanceContext.MaintenanceRepository
      }
      on event MaintenanceOrder.MaintenanceStarted is {
        tell event MaintenanceOrder.MaintenanceStarted to repository MaintenanceContext.MaintenanceRepository
      }
      on event MaintenanceOrder.SpareUsageRecorded is {
        tell event MaintenanceOrder.SpareUsageRecorded to repository MaintenanceContext.MaintenanceRepository
      }
      on event MaintenanceOrder.MaintenanceCompleted is {
        tell event MaintenanceOrder.MaintenanceCompleted to repository MaintenanceContext.MaintenanceRepository
      }
      on event MaintenanceOrder.OrderCancelled is {
        tell event MaintenanceOrder.OrderCancelled to repository MaintenanceContext.MaintenanceRepository
      }
      on other is {
        error "Unexpected message for sink MaintenanceOrderEventSink"
      }
    } with {
      briefly "MaintenanceOrder sink handler"
      described as {
        |Persists MaintenanceOrder events via the repository.
      }
    }
  } with {
    briefly "MaintenanceOrder event sink"
    described as {
      |Receives MaintenanceOrder events for persistence.
    }
  }
  connector MaintenanceOrderEventFlow is from outlet MaintenanceContext.MaintenanceOrderEventSource.MaintenanceOrderEvents to inlet MaintenanceContext.MaintenanceOrderEventSink.MaintenanceOrderInlet with {
    briefly "MaintenanceOrder event flow"
    described as {
      |Connects the MaintenanceOrder source to its sink.
    }
  }
  processor MaintenanceOrderEventSplit is {
    inlet MaintenanceOrderEventSplitIn is type MaintenanceOrderEvent    outlet MaintenanceOrderEventSplitToMaintenanceRepository is type MaintenanceOrderEvent
    outlet MaintenanceOrderEventSplitToMaintenanceMetrics is type MaintenanceOrderEvent
    handler MaintenanceOrderEventSplitHandler is {
      on event MaintenanceOrder.MaintenanceOrderCreated is {
        send event MaintenanceOrder.MaintenanceOrderCreated to outlet MaintenanceOrderEventSplitToMaintenanceRepository
        send event MaintenanceOrder.MaintenanceOrderCreated to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell event MaintenanceOrder.MaintenanceOrderCreated to entity MaintenanceContext.MaintenanceOrder
      }
      on event MaintenanceOrder.TechnicianAssigned is {
        send event MaintenanceOrder.TechnicianAssigned to outlet MaintenanceOrderEventSplitToMaintenanceRepository
        send event MaintenanceOrder.TechnicianAssigned to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell event MaintenanceOrder.TechnicianAssigned to entity MaintenanceContext.MaintenanceOrder
      }
      on event MaintenanceOrder.MaintenanceStarted is {
        send event MaintenanceOrder.MaintenanceStarted to outlet MaintenanceOrderEventSplitToMaintenanceRepository
        send event MaintenanceOrder.MaintenanceStarted to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell event MaintenanceOrder.MaintenanceStarted to entity MaintenanceContext.MaintenanceOrder
      }
      on event MaintenanceOrder.SpareUsageRecorded is {
        send event MaintenanceOrder.SpareUsageRecorded to outlet MaintenanceOrderEventSplitToMaintenanceRepository
        send event MaintenanceOrder.SpareUsageRecorded to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell event MaintenanceOrder.SpareUsageRecorded to entity MaintenanceContext.MaintenanceOrder
      }
      on event MaintenanceOrder.MaintenanceCompleted is {
        send event MaintenanceOrder.MaintenanceCompleted to outlet MaintenanceOrderEventSplitToMaintenanceRepository
        send event MaintenanceOrder.MaintenanceCompleted to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell event MaintenanceOrder.MaintenanceCompleted to entity MaintenanceContext.MaintenanceOrder
      }
      on event MaintenanceOrder.OrderCancelled is {
        send event MaintenanceOrder.OrderCancelled to outlet MaintenanceOrderEventSplitToMaintenanceRepository
        send event MaintenanceOrder.OrderCancelled to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell event MaintenanceOrder.OrderCancelled to entity MaintenanceContext.MaintenanceOrder
      }
      on other is {
        error "Unexpected message for processor MaintenanceOrderEventSplit"
      }
    } with {
      briefly "MaintenanceOrder event fan-out handler"
      described as {
        |Delivers each MaintenanceOrder event to all of its consumers.
      }
    }
  } with {
    briefly "MaintenanceOrder event fan-out"
    described as {
      |Fans MaintenanceOrder events out to the repository and projectors.
    }
  }
  connector LinkMaintenanceOrderToMaintenanceOrderEventSplit is from outlet MaintenanceContext.MaintenanceOrder.MaintenanceOrderEvents2 to inlet MaintenanceContext.MaintenanceOrderEventSplit.MaintenanceOrderEventSplitIn with {
    briefly "LinkMaintenanceOrderToMaintenanceOrderEventSplit"
  }
  connector LinkMaintenanceOrderEventSplitToMaintenanceRepository is from outlet MaintenanceContext.MaintenanceOrderEventSplit.MaintenanceOrderEventSplitToMaintenanceRepository to inlet MaintenanceContext.MaintenanceRepository.MaintenanceRepositoryFromMaintenanceOrder with {
    briefly "LinkMaintenanceOrderEventSplitToMaintenanceRepository"
  }
  connector LinkMaintenanceOrderEventSplitToMaintenanceMetrics is from outlet MaintenanceContext.MaintenanceOrderEventSplit.MaintenanceOrderEventSplitToMaintenanceMetrics to inlet MaintenanceContext.MaintenanceMetrics.MaintenanceMetricsFromMaintenanceOrder with {
    briefly "LinkMaintenanceOrderEventSplitToMaintenanceMetrics"
  }
  connector LinkMaintenanceMetricsToMaintenanceRepository is from outlet MaintenanceContext.MaintenanceMetrics.MaintenanceMetricsOut to inlet MaintenanceContext.MaintenanceRepository.MaintenanceRepositoryFromMaintenanceMetrics with {
    briefly "LinkMaintenanceMetricsToMaintenanceRepository"
  }
} with {
  briefly "Bounded context for equipment maintenance"
  described as {
    | The MaintenanceContext is the primary bounded context for the Equipment
    | Maintenance domain. It contains all entities, repositories, and
    | integrations needed to manage the complete maintenance lifecycle
    | from order creation through completion and metrics analysis.
  }
}
