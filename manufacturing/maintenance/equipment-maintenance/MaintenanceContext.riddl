// Equipment Maintenance - Maintenance Context
// The primary bounded context for equipment maintenance management
context MaintenanceContext as router is {
  inlet MaintenanceOrderCommandStreaIn is type MaintenanceOrderCommand  outlet MaintenanceOrderCommandStreaOut is type MaintenanceOrderCommand
  inlet MaintenanceOrderResultStreamIn is result MaintenanceOrder.MaintenanceOrderResult  outlet MaintenanceOrderResultStreamOut is result MaintenanceOrder.MaintenanceOrderResult
  handler MaintenanceContextBoundary is {
    on createMaintenanceOrder: command MaintenanceOrder.CreateMaintenanceOrder is {
      forward createMaintenanceOrder to outlet MaintenanceContext.MaintenanceOrderCommandStreaOut
    }
    on assignTechnician: command MaintenanceOrder.AssignTechnician is {
      forward assignTechnician to outlet MaintenanceContext.MaintenanceOrderCommandStreaOut
    }
    on startMaintenance: command MaintenanceOrder.StartMaintenance is {
      forward startMaintenance to outlet MaintenanceContext.MaintenanceOrderCommandStreaOut
    }
    on recordSpareUsage: command MaintenanceOrder.RecordSpareUsage is {
      forward recordSpareUsage to outlet MaintenanceContext.MaintenanceOrderCommandStreaOut
    }
    on completeMaintenance: command MaintenanceOrder.CompleteMaintenance is {
      forward completeMaintenance to outlet MaintenanceContext.MaintenanceOrderCommandStreaOut
    }
    on cancelOrder: command MaintenanceOrder.CancelOrder is {
      forward cancelOrder to outlet MaintenanceContext.MaintenanceOrderCommandStreaOut
    }
    on maintenanceOrderResult: result MaintenanceOrder.MaintenanceOrderResult is {
      send maintenanceOrderResult to outlet MaintenanceContext.MaintenanceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the MaintenanceContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MaintenanceOrderCommand Stream Intake' is from outlet MaintenanceContext.MaintenanceOrderCommandStreaOut to inlet MaintenanceContext.MaintenanceOrder.MaintenanceOrderCommands  connector 'MaintenanceOrderResult Stream Egress' is from outlet MaintenanceContext.MaintenanceRepository.MaintenanceRepositoryResponses to inlet MaintenanceContext.MaintenanceOrderResultStreamIn  include "types.riddl"
  include "MaintenanceOrder.riddl"
  // Adaptors for external system integration
  adaptor EquipmentAdapter from context EquipmentRegistry is { 
    handler InboundEquipment is {
      on event EquipmentRegistry.EquipmentStatusChanged is {
        do "Update maintenance schedule based on equipment status change"
      }
      on event EquipmentRegistry.MaintenanceScheduleUpdated is {
        do "Create preventive maintenance orders from updated schedule"
      }
      on other is {
        error "Unexpected message for adaptor EquipmentAdapter"
      }
    } with {
      briefly "Handles equipment registry events"
      described as {
        |Processes equipment status changes and schedule updates.
      }
    }
  } with {
    briefly "Translates equipment registry events"
    described as {
      | Receives equipment master data events from the external EquipmentRegistry
      | and creates or updates maintenance orders accordingly.
    }
  }
  adaptor InventoryAdapter from context SparePartsInventory is { 
    handler InboundInventory is {
      on event SparePartsInventory.PartsReserved is {
        do "Update order with parts reservation confirmation"
      }
      on event SparePartsInventory.PartsReservationFailed is {
        do "Notify planner of parts shortage and suggest alternatives"
      }
      on partsConsumed: event SparePartsInventory.PartsConsumed is {
        tell command RecordSpareUsage(orderId = partsConsumed.orderId, sparePartId = prompt("the spare part id of this record spare usage"), partNumber = prompt("the part number of this record spare usage"), partName = prompt("the part name of this record spare usage"), quantity = prompt("the quantity of this record spare usage"), unitCost = prompt("the unit cost of this record spare usage")) to entity MaintenanceOrder
      }
      on other is {
        error "Unexpected message for adaptor InventoryAdapter"
      }
    } with {
      briefly "Handles spare parts inventory events"
      described as {
        |Processes parts availability and consumption events.
      }
    }
  } with {
    briefly "Translates spare parts inventory events"
    described as {
      | Receives parts reservation and consumption events from the
      | SparePartsInventory and updates maintenance orders accordingly.
    }
  }
  adaptor ProductionAdapter from context ProductionSchedule is { 
    handler InboundProduction is {
      on event ProductionSchedule.MaintenanceWindowApproved is {
        do "Update maintenance order with approved schedule window"
      }
      on event ProductionSchedule.MaintenanceWindowRejected is {
        do "Reschedule maintenance order for alternative window"
      }
      on event ProductionSchedule.EquipmentNeededUrgently is {
        do "Expedite in-progress maintenance or defer non-critical work"
      }
      on other is {
        error "Unexpected message for adaptor ProductionAdapter"
      }
    } with {
      briefly "Handles production schedule events"
      described as {
        |Processes maintenance window approvals and production priorities.
      }
    }
  } with {
    briefly "Translates production schedule events"
    described as {
      | Receives maintenance window coordination events from Production
      | Schedule to align maintenance activities with production needs.
    }
  }
  // Repository for maintenance persistence
  type MaintenanceRepositoryCommand is one of {
    MaintenanceContext.MaintenanceRepository.PersistMaintenanceCompleted or MaintenanceContext.MaintenanceRepository.PersistMaintenanceOrderCreated or MaintenanceContext.MaintenanceRepository.PersistMaintenanceStarted or MaintenanceContext.MaintenanceRepository.PersistOrderCancelled or MaintenanceContext.MaintenanceRepository.PersistSpareUsageRecorded or MaintenanceContext.MaintenanceRepository.PersistTechnicianAssigned
  } with {
    briefly "Anything that writes MaintenanceRepository"
    described as {
      |The persistence commands MaintenanceRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MaintenanceRepository as flow is {
    inlet MaintenanceRepositoryFromMaintenanceMetrics is type MaintenanceRepositoryCommand    command PersistMaintenanceStarted is {
      orderId: MaintenanceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceStarted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceStarted"
      described as {
        |Instructs this repository to apply MaintenanceStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCancelled is {
      orderId: MaintenanceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist OrderCancelled"
      described as {
        |Instructs this repository to apply OrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTechnicianAssigned is {
      orderId: MaintenanceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row TechnicianAssigned applies to.
        }
      }
    } with {
      briefly "Persist TechnicianAssigned"
      described as {
        |Instructs this repository to apply TechnicianAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceCompleted is {
      orderId: MaintenanceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceCompleted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceCompleted"
      described as {
        |Instructs this repository to apply MaintenanceCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceOrderCreated is {
      orderId: MaintenanceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceOrderCreated applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceOrderCreated"
      described as {
        |Instructs this repository to apply MaintenanceOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSpareUsageRecorded is {
      orderId: MaintenanceOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SpareUsageRecorded applies to.
        }
      }
    } with {
      briefly "Persist SpareUsageRecorded"
      described as {
        |Instructs this repository to apply SpareUsageRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MaintenanceRepositoryResponses is result MaintenanceOrder.MaintenanceOrderResult
    record StoredMaintenanceOrder is {
      maintenanceOrderId: MaintenanceOrderId with {
        briefly "maintenanceOrderId"
        described as {
          |The maintenanceOrderId column of the stored maintenanceOrder row.
        }
      }
      equipmentId: EquipmentId with {
        briefly "equipmentId"
        described as {
          |The equipmentId column of the stored maintenanceOrder row.
        }
      }
      maintenanceType: MaintenanceType with {
        briefly "maintenanceType"
        described as {
          |The maintenanceType column of the stored maintenanceOrder row.
        }
      }
      scheduledDate: Date with {
        briefly "scheduledDate"
        described as {
          |The scheduledDate column of the stored maintenanceOrder row.
        }
      }
    } with {
      briefly "Stored maintenanceOrder row"
      described as {
        |The persistence shape of maintenanceOrder data as this repository stores it.
      }
    }
    schema MaintenanceData is relational
      of maintenanceOrders as record StoredMaintenanceOrder
        index on field StoredMaintenanceOrder.equipmentId
        index on field StoredMaintenanceOrder.scheduledDate
        index on field StoredMaintenanceOrder.maintenanceType
 with {
      briefly "Maintenance data schema"
      described as {
        |The relational schema holding maintenance data for the MaintenanceRepository.
      }
    }
    handler MaintenancePersistence is {
      on persistMaintenanceStarted: command PersistMaintenanceStarted is {
        do "apply MaintenanceStarted to the stored row"
      }
      on persistOrderCancelled: command PersistOrderCancelled is {
        do "apply OrderCancelled to the stored row"
      }
      on persistTechnicianAssigned: command PersistTechnicianAssigned is {
        do "apply TechnicianAssigned to the stored row"
      }
      on persistMaintenanceCompleted: command PersistMaintenanceCompleted is {
        do "apply MaintenanceCompleted to the stored row"
      }
      on persistMaintenanceOrderCreated: command PersistMaintenanceOrderCreated is {
        do "apply MaintenanceOrderCreated to the stored row"
      }
      on persistSpareUsageRecorded: command PersistSpareUsageRecorded is {
        do "apply SpareUsageRecorded to the stored row"
      }
      on query GetEquipmentReliabilityMetrics is {
        let equipmentReliabilityMetricsView: type EquipmentReliabilityMetricsView = prompt("read the equipment reliability metrics projection")
        reply equipmentReliabilityMetricsView
      }
      on query GetMaintenanceWorkMetrics is {
        let maintenanceWorkMetricsView: type MaintenanceWorkMetricsView = prompt("read the maintenance work metrics projection")
        reply maintenanceWorkMetricsView
      }
    } with {
      briefly "Persists maintenance events to storage"
      described as {
        |Handles all event-driven persistence operations for maintenance orders.
      }
    }
  } with {
    briefly "Persistent storage for maintenance data"
    described as {
      | The MaintenanceRepository provides persistent storage for maintenance
      | orders with appropriate indexes for common query patterns including
      | by equipment, date, and maintenance type.
    }
  }
  // Projector for maintenance metrics
  query GetEquipmentReliabilityMetrics replies result EquipmentReliabilityMetricsView is {
    equipmentReliabilityMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which equipment reliability metrics to retrieve.
      }
    }
  } with {
    briefly "Get equipment reliability metrics"
    described as {
      |Retrieves the equipment reliability metrics projection.
    }
  }
  result EquipmentReliabilityMetricsView is {
    equipmentReliabilityMetrics: MaintenanceMetrics.EquipmentReliabilityMetrics with {
      briefly "Equipment reliability metrics"
      described as {
        |The equipment reliability metrics being returned.
      }
    }
  } with {
    briefly "Equipment reliability metrics view"
    described as {
      |Read model view carrying the equipment reliability metrics projection.
    }
  }
  query GetMaintenanceWorkMetrics replies result MaintenanceWorkMetricsView is {
    maintenanceWorkMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which maintenance work metrics to retrieve.
      }
    }
  } with {
    briefly "Get maintenance work metrics"
    described as {
      |Retrieves the maintenance work metrics projection.
    }
  }
  result MaintenanceWorkMetricsView is {
    maintenanceWorkMetrics: MaintenanceMetrics.MaintenanceWorkMetrics with {
      briefly "Maintenance work metrics"
      described as {
        |The maintenance work metrics being returned.
      }
    }
  } with {
    briefly "Maintenance work metrics view"
    described as {
      |Read model view carrying the maintenance work metrics projection.
    }
  }
  projector MaintenanceMetrics as flow is {
    updates repository MaintenanceContext.MaintenanceRepository
    outlet MaintenanceMetricsToRepository is type MaintenanceRepositoryCommand
    inlet MaintenanceMetricsFromMaintenanceOrder is type MaintenanceOrderEvent    record EquipmentReliabilityMetrics is {
      equipmentId: EquipmentId with {
        briefly "Equipment ID"
        described as {
          |Equipment being tracked.
        }
      }
      equipmentName: String(1,200) with {
        briefly "Equipment name"
        described as {
          |Equipment name for display.
        }
      }
      mtbf: Decimal(10,2) with {
        briefly "MTBF (hours)"
        described as {
          |Mean Time Between Failures in hours.
        }
      }
      mttr: Decimal(10,2) with {
        briefly "MTTR (hours)"
        described as {
          |Mean Time To Repair in hours.
        }
      }
      equipmentAvailability: Decimal(5,2) with {
        briefly "Availability (%)"
        described as {
          |Equipment availability percentage.
        }
      }
      failureCount: Natural with {
        briefly "Failure count"
        described as {
          |Total number of failures in period.
        }
      }
      plannedDowntimeHours: Decimal(10,2) with {
        briefly "Planned downtime"
        described as {
          |Hours of planned downtime.
        }
      }
      unplannedDowntimeHours: Decimal(10,2) with {
        briefly "Unplanned downtime"
        described as {
          |Hours of unplanned downtime.
        }
      }
      totalMaintenanceCost: Decimal(12,2) with {
        briefly "Total cost"
        described as {
          |Total maintenance cost for period.
        }
      }
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Start of measurement period.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |End of measurement period.
        }
      }
    } with {
      briefly "Equipment reliability metrics"
      described as {
        |Aggregated reliability statistics for a single piece of equipment.
      }
    }
    record MaintenanceWorkMetrics is {
      period: Date with {
        briefly "Period"
        described as {
          |Date for these metrics.
        }
      }
      totalOrders: Natural with {
        briefly "Total orders"
        described as {
          |Total maintenance orders.
        }
      }
      preventiveCount: Natural with {
        briefly "Preventive"
        described as {
          |Preventive maintenance orders.
        }
      }
      correctiveCount: Natural with {
        briefly "Corrective"
        described as {
          |Corrective maintenance orders.
        }
      }
      predictiveCount: Natural with {
        briefly "Predictive"
        described as {
          |Predictive maintenance orders.
        }
      }
      emergencyCount: Natural with {
        briefly "Emergency"
        described as {
          |Emergency maintenance orders.
        }
      }
      completedOnTime: Natural with {
        briefly "On time"
        described as {
          |Orders completed on schedule.
        }
      }
      averageCompletionTime: Decimal(10,2) with {
        briefly "Avg completion"
        described as {
          |Average completion time in hours.
        }
      }
      totalLaborHours: Decimal(10,2) with {
        briefly "Labor hours"
        described as {
          |Total labor hours expended.
        }
      }
      periodPartsCost: Decimal(12,2) with {
        briefly "Parts cost"
        described as {
          |Total spare parts cost.
        }
      }
      totalLaborCost: Decimal(12,2) with {
        briefly "Labor cost"
        described as {
          |Total labor cost.
        }
      }
    } with {
      briefly "Daily maintenance work metrics"
      described as {
        |Aggregated maintenance work statistics for a day.
      }
    }
    handler MetricsHandler is {
      on maintenanceStarted: event MaintenanceOrder.MaintenanceStarted is {
        tell command MaintenanceContext.MaintenanceRepository.PersistMaintenanceStarted(orderId = maintenanceStarted.orderId) to repository MaintenanceContext.MaintenanceRepository
        do "apply MaintenanceStarted to the MaintenanceMetrics projection"
      }
      on orderCancelled: event MaintenanceOrder.OrderCancelled is {
        tell command MaintenanceContext.MaintenanceRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository MaintenanceContext.MaintenanceRepository
        do "apply OrderCancelled to the MaintenanceMetrics projection"
      }
      on technicianAssigned: event MaintenanceOrder.TechnicianAssigned is {
        tell command MaintenanceContext.MaintenanceRepository.PersistTechnicianAssigned(orderId = technicianAssigned.orderId) to repository MaintenanceContext.MaintenanceRepository
        do "apply TechnicianAssigned to the MaintenanceMetrics projection"
      }
      on maintenanceOrderCreated: event MaintenanceOrder.MaintenanceOrderCreated is {
        tell command MaintenanceContext.MaintenanceRepository.PersistMaintenanceOrderCreated(orderId = maintenanceOrderCreated.orderId) to repository MaintenanceContext.MaintenanceRepository
        do "Update order counts by type"
      }
      on maintenanceCompleted: event MaintenanceOrder.MaintenanceCompleted is {
        tell command MaintenanceContext.MaintenanceRepository.PersistMaintenanceCompleted(orderId = maintenanceCompleted.orderId) to repository MaintenanceContext.MaintenanceRepository
        do "Calculate completion metrics and update MTBF/MTTR"
      }
      on spareUsageRecorded: event MaintenanceOrder.SpareUsageRecorded is {
        tell command MaintenanceContext.MaintenanceRepository.PersistSpareUsageRecorded(orderId = spareUsageRecorded.orderId) to repository MaintenanceContext.MaintenanceRepository
        do "Update parts cost metrics"
      }
    } with {
      briefly "Projects maintenance events for metrics"
      described as {
        |Processes maintenance events to maintain aggregate metrics.
      }
    }
  } with {
    briefly "Projects maintenance events for reporting"
    described as {
      | Maintains aggregated views of maintenance data for dashboards
      | and reliability analysis including MTBF, MTTR, and availability
      | calculations for each piece of equipment.
    }
  }
  // ---- Event publication for MaintenanceOrder ----
  type MaintenanceOrderEvent is one of {
    MaintenanceContext.MaintenanceOrder.MaintenanceOrderCreated or MaintenanceContext.MaintenanceOrder.TechnicianAssigned or MaintenanceContext.MaintenanceOrder.MaintenanceStarted or MaintenanceContext.MaintenanceOrder.SpareUsageRecorded or MaintenanceContext.MaintenanceOrder.MaintenanceCompleted or MaintenanceContext.MaintenanceOrder.OrderCancelled
  } with {
    briefly "MaintenanceOrder event alternation"
    described as {
      |Union of all MaintenanceOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet MaintenanceOrderEventSplit as flow is {
    inlet MaintenanceOrderEventSplitIn is type MaintenanceOrderEvent    outlet MaintenanceOrderEventSplitToMaintenanceMetrics is type MaintenanceOrderEvent
    handler MaintenanceOrderEventSplitHandler is {
      on maintenanceOrderCreated: event MaintenanceOrder.MaintenanceOrderCreated is {
        send maintenanceOrderCreated to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell maintenanceOrderCreated to entity MaintenanceContext.MaintenanceOrder
      }
      on technicianAssigned: event MaintenanceOrder.TechnicianAssigned is {
        send technicianAssigned to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell technicianAssigned to entity MaintenanceContext.MaintenanceOrder
      }
      on maintenanceStarted: event MaintenanceOrder.MaintenanceStarted is {
        send maintenanceStarted to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell maintenanceStarted to entity MaintenanceContext.MaintenanceOrder
      }
      on spareUsageRecorded: event MaintenanceOrder.SpareUsageRecorded is {
        send spareUsageRecorded to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell spareUsageRecorded to entity MaintenanceContext.MaintenanceOrder
      }
      on maintenanceCompleted: event MaintenanceOrder.MaintenanceCompleted is {
        send maintenanceCompleted to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell maintenanceCompleted to entity MaintenanceContext.MaintenanceOrder
      }
      on orderCancelled: event MaintenanceOrder.OrderCancelled is {
        send orderCancelled to outlet MaintenanceOrderEventSplitToMaintenanceMetrics
        tell orderCancelled to entity MaintenanceContext.MaintenanceOrder
      }
      on other is {
        error "Unexpected message for processor MaintenanceOrderEventSplit"
      }
    } with {
      briefly "MaintenanceOrder event fan-out handler"
      described as {
        |Delivers each MaintenanceOrder event to all of its consumers.
      }
    }
  } with {
    briefly "MaintenanceOrder event fan-out"
    described as {
      |Fans MaintenanceOrder events out to the repository and projectors.
    }
  }
  connector 'MaintenanceOrderEvent Stream' is from outlet MaintenanceContext.MaintenanceOrder.MaintenanceOrderEvents2 to inlet MaintenanceContext.MaintenanceOrderEventSplit.MaintenanceOrderEventSplitIn with {
    briefly "MaintenanceOrder events, fanned out to storage and read models"
  }
  connector 'MaintenanceMetrics Feed' is from outlet MaintenanceContext.MaintenanceOrderEventSplit.MaintenanceOrderEventSplitToMaintenanceMetrics to inlet MaintenanceContext.MaintenanceMetrics.MaintenanceMetricsFromMaintenanceOrder with {
    briefly "MaintenanceOrder events feeding the MaintenanceMetrics projection"
  }
  connector 'MaintenanceMetrics Storage' is from outlet MaintenanceContext.MaintenanceMetrics.MaintenanceMetricsToRepository to inlet MaintenanceContext.MaintenanceRepository.MaintenanceRepositoryFromMaintenanceMetrics with {
    briefly "MaintenanceMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for equipment maintenance"
  described as {
    | The MaintenanceContext is the primary bounded context for the Equipment
    | Maintenance domain. It contains all entities, repositories, and
    | integrations needed to manage the complete maintenance lifecycle
    | from order creation through completion and metrics analysis.
  }
}
