// CNC Operations - CNC Context
context CNCContext as router is {
  connector 'AlarmAnalytics Storage' is from outlet CNCContext.AlarmAnalytics.AlarmAnalyticsToRepository to inlet CNCContext.CNCRepository.CNCRepositoryFromAlarmAnalytics with {
    briefly "AlarmAnalytics messages on their way to CNCRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'OEEAnalytics Storage' is from outlet CNCContext.OEEAnalytics.OEEAnalyticsToRepository to inlet CNCContext.CNCRepository.CNCRepositoryFromOEEAnalytics with {
    briefly "OEEAnalytics messages on their way to CNCRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'CycleTimeAnalytics Storage' is from outlet CNCContext.CycleTimeAnalytics.CycleTimeAnalyticsToRepository to inlet CNCContext.CNCRepository.CNCRepositoryFromCycleTimeAnalytics with {
    briefly "CycleTimeAnalytics messages on their way to CNCRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet CNCMachineCommandStreamIn is type CNCMachineCommand  outlet CNCMachineCommandStreamOut is type CNCMachineCommand
  inlet CNCMachineResultStreamIn is result CNCMachine.CNCMachineResult  outlet CNCMachineResultStreamOut is result CNCMachine.CNCMachineResult
  handler CNCContextBoundary is {
    on loadProgram: command CNCMachine.LoadProgram is {
      send loadProgram to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on setupMachine: command CNCMachine.SetupMachine is {
      send setupMachine to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on startCycle: command CNCMachine.StartCycle is {
      send startCycle to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on pauseCycle: command CNCMachine.PauseCycle is {
      send pauseCycle to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on completeCycle: command CNCMachine.CompleteCycle is {
      send completeCycle to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on reportAlarm: command CNCMachine.ReportAlarm is {
      send reportAlarm to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on clearAlarm: command CNCMachine.ClearAlarm is {
      send clearAlarm to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on updateMetrics: command CNCMachine.UpdateMetrics is {
      send updateMetrics to outlet CNCContext.CNCMachineCommandStreamOut
    }
    on cNCMachineResult: result CNCMachine.CNCMachineResult is {
      send cNCMachineResult to outlet CNCContext.CNCMachineResultStreamOut
    }
    on other is {
      error "Unexpected message at the CNCContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CNCMachineCommand Stream Intake' is from outlet CNCContext.CNCMachineCommandStreamOut to inlet CNCContext.CNCMachine.CNCMachineCommands  connector 'CNCMachineResult Stream Egress' is from outlet CNCContext.CNCRepository.CNCRepositoryResponses to inlet CNCContext.CNCMachineResultStreamIn  adaptor FromMaintenanceService from context MaintenanceService is { 
    handler FromMaintenanceServiceHandler is {
      on event MaintenanceService.MaintenanceRequested is {
        do "the model receives maintenance requested"
      }
      on event MaintenanceService.PMDueReminder is {
        do "the model receives pm due reminder"
      }
      on result MaintenanceService.PMSchedule is {
        do "the model receives pm schedule"
      }
      on event MaintenanceService.PMScheduled is {
        do "the model receives pm scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceService"
      }
    } with {
      briefly "from maintenance service"
      described as {
        |Carries messages from the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor ToMaintenanceService to context MaintenanceService is { 
    handler ToMaintenanceServiceHandler is {
      on query MaintenanceService.GetPMSchedule is {
        do "the model sends get pm schedule"
      }
      on command MaintenanceService.ReportMachineIssue is {
        do "the model sends report machine issue"
      }
      on command MaintenanceService.SchedulePM is {
        do "the model sends schedule pm"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceService"
      }
    } with {
      briefly "to maintenance service"
      described as {
        |Carries messages to the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor FromQualityService from context QualityService is { 
    handler FromQualityServiceHandler is {
      on event QualityService.FirstArticleApproved is {
        do "the model receives first article approved"
      }
      on event QualityService.FirstArticleRejected is {
        do "the model receives first article rejected"
      }
      on event QualityService.FirstArticleRequested is {
        do "the model receives first article requested"
      }
      on event QualityService.MeasurementRecorded is {
        do "the model receives measurement recorded"
      }
      on result QualityService.SPCLimits is {
        do "the model receives spc limits"
      }
      on event QualityService.SPCViolation is {
        do "the model receives spc violation"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityService"
      }
    } with {
      briefly "from quality service"
      described as {
        |Carries messages from the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor ToQualityService to context QualityService is { 
    handler ToQualityServiceHandler is {
      on query QualityService.GetSPCLimits is {
        do "the model sends get spc limits"
      }
      on command QualityService.RecordMeasurement is {
        do "the model sends record measurement"
      }
      on command QualityService.RequestFirstArticle is {
        do "the model sends request first article"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityService"
      }
    } with {
      briefly "to quality service"
      described as {
        |Carries messages to the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor FromToolManagementService from context ToolManagementService is { 
    handler FromToolManagementServiceHandler is {
      on event ToolManagementService.ToolExhausted is {
        do "the model receives tool exhausted"
      }
      on result ToolManagementService.ToolLifeStatus is {
        do "the model receives tool life status"
      }
      on event ToolManagementService.ToolLifeUpdated is {
        do "the model receives tool life updated"
      }
      on event ToolManagementService.ToolLifeWarning is {
        do "the model receives tool life warning"
      }
      on result ToolManagementService.ToolOffsets is {
        do "the model receives tool offsets"
      }
      on other is {
        error "Unexpected message for adaptor FromToolManagementService"
      }
    } with {
      briefly "from tool management service"
      described as {
        |Carries messages from the external ToolManagementService.
      }
    }
  } with {
    briefly "ToolManagementService integration"
    described as {
      |The model's side of the ToolManagementService conversation.
    }
  }
  adaptor ToToolManagementService to context ToolManagementService is { 
    handler ToToolManagementServiceHandler is {
      on query ToolManagementService.GetToolLife is {
        do "the model sends get tool life"
      }
      on query ToolManagementService.GetToolOffsets is {
        do "the model sends get tool offsets"
      }
      on command ToolManagementService.UpdateToolLife is {
        do "the model sends update tool life"
      }
      on other is {
        error "Unexpected message for adaptor ToToolManagementService"
      }
    } with {
      briefly "to tool management service"
      described as {
        |Carries messages to the external ToolManagementService.
      }
    }
  } with {
    briefly "ToolManagementService integration"
    described as {
      |The model's side of the ToolManagementService conversation.
    }
  }
  include "types.riddl"
  include "CNCMachine.riddl"
  // Repository for CNC data persistence
  type CNCRepositoryCommand is one of {
    CNCContext.CNCRepository.PersistAlarmCleared or CNCContext.CNCRepository.PersistAlarmRaised or CNCContext.CNCRepository.PersistCycleCompleted or CNCContext.CNCRepository.PersistCyclePaused or CNCContext.CNCRepository.PersistCycleStarted or CNCContext.CNCRepository.PersistMachineSetup or CNCContext.CNCRepository.PersistMetricsUpdated or CNCContext.CNCRepository.PersistProgramLoaded
  } with {
    briefly "Anything that writes CNCRepository"
    described as {
      |The persistence commands CNCRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository CNCRepository as merge is {
    inlet CNCRepositoryFromAlarmAnalytics is type CNCRepositoryCommand with {
      briefly "What AlarmAnalytics sends CNCRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet CNCRepositoryFromOEEAnalytics is type CNCRepositoryCommand with {
      briefly "What OEEAnalytics sends CNCRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet CNCRepositoryFromCycleTimeAnalytics is type CNCRepositoryCommand with {
      briefly "What CycleTimeAnalytics sends CNCRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet CNCRepositoryFromMachineUtilization is type CNCRepositoryCommand    command PersistMetricsUpdated is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row MetricsUpdated applies to.
        }
      }
    } with {
      briefly "Persist MetricsUpdated"
      described as {
        |Instructs this repository to apply MetricsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlarmCleared is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlarmCleared applies to.
        }
      }
    } with {
      briefly "Persist AlarmCleared"
      described as {
        |Instructs this repository to apply AlarmCleared to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAlarmRaised is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row AlarmRaised applies to.
        }
      }
    } with {
      briefly "Persist AlarmRaised"
      described as {
        |Instructs this repository to apply AlarmRaised to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCycleCompleted is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row CycleCompleted applies to.
        }
      }
    } with {
      briefly "Persist CycleCompleted"
      described as {
        |Instructs this repository to apply CycleCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCyclePaused is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row CyclePaused applies to.
        }
      }
    } with {
      briefly "Persist CyclePaused"
      described as {
        |Instructs this repository to apply CyclePaused to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCycleStarted is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row CycleStarted applies to.
        }
      }
    } with {
      briefly "Persist CycleStarted"
      described as {
        |Instructs this repository to apply CycleStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMachineSetup is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row MachineSetup applies to.
        }
      }
    } with {
      briefly "Persist MachineSetup"
      described as {
        |Instructs this repository to apply MachineSetup to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProgramLoaded is {
      machineId: MachineId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProgramLoaded applies to.
        }
      }
    } with {
      briefly "Persist ProgramLoaded"
      described as {
        |Instructs this repository to apply ProgramLoaded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet CNCRepositoryResponses is result CNCMachine.CNCMachineResult
    record StoredCNCMachine is {
      cNCMachineId: UUID with {
        briefly "cNCMachineId"
        described as {
          |The cNCMachineId column of the stored cNCMachine row.
        }
      }
      machineId: MachineId with {
        briefly "machineId"
        described as {
          |The machineId column of the stored cNCMachine row.
        }
      }
      status: MachineStatus with {
        briefly "status"
        described as {
          |The status column of the stored cNCMachine row.
        }
      }
    } with {
      briefly "Stored cNCMachine row"
      described as {
        |The persistence shape of cNCMachine data as this repository stores it.
      }
    }
    schema CNCData is relational
      of machines as record StoredCNCMachine
        index on field StoredCNCMachine.machineId
        index on field StoredCNCMachine.status
 with {
      briefly "Cnc data schema"
      described as {
        |The relational schema holding cnc data for the CNCRepository.
      }
    }
    handler CNCPersistence is {
      on persistMetricsUpdated: command PersistMetricsUpdated is {
        do "apply MetricsUpdated to the stored row"
      }
      on persistAlarmCleared: command PersistAlarmCleared is {
        do "apply AlarmCleared to the stored row"
      }
      on persistAlarmRaised: command PersistAlarmRaised is {
        do "apply AlarmRaised to the stored row"
      }
      on persistCycleCompleted: command PersistCycleCompleted is {
        do "apply CycleCompleted to the stored row"
      }
      on persistCyclePaused: command PersistCyclePaused is {
        do "apply CyclePaused to the stored row"
      }
      on persistCycleStarted: command PersistCycleStarted is {
        do "apply CycleStarted to the stored row"
      }
      on persistMachineSetup: command PersistMachineSetup is {
        do "apply MachineSetup to the stored row"
      }
      on persistProgramLoaded: command PersistProgramLoaded is {
        do "apply ProgramLoaded to the stored row"
      }
      on query GetUtilizationStats is {
        let utilizationStatsView: type UtilizationStatsView = prompt("read the utilization stats projection")
        reply utilizationStatsView
      }
      on query GetCycleTimeStats is {
        let cycleTimeStatsView: type CycleTimeStatsView = prompt("read the cycle time stats projection")
        reply cycleTimeStatsView
      }
      on query GetOEEStats is {
        let oEEStatsView: type OEEStatsView = prompt("read the oee stats projection")
        reply oEEStatsView
      }
      on query GetAlarmStats is {
        let alarmStatsView: type AlarmStatsView = prompt("read the alarm stats projection")
        reply alarmStatsView
      }
    } with {
      briefly "Persists CNC machine events"
      described as {
        |Handles command-driven persistence of machine data.
      }
    }
  } with {
    briefly "CNC data persistence"
    described as {
      | The CNCRepository provides persistent storage for
      | machine state, cycles, alarms, and metrics history.
    }
  }
  // Projector for machine utilization analytics
  query GetUtilizationStats replies result UtilizationStatsView is {
    utilizationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization stats to retrieve.
      }
    }
  } with {
    briefly "Get utilization stats"
    described as {
      |Retrieves the utilization stats projection.
    }
  }
  result UtilizationStatsView is {
    utilizationStats: MachineUtilization.UtilizationStats with {
      briefly "Utilization stats"
      described as {
        |The utilization stats being returned.
      }
    }
  } with {
    briefly "Utilization stats view"
    described as {
      |Read model view carrying the utilization stats projection.
    }
  }
  projector MachineUtilization as flow is {
    updates repository CNCContext.CNCRepository
    outlet MachineUtilizationToRepository is type CNCRepositoryCommand
    inlet MachineUtilizationFromCNCMachine is type CNCMachineEvent    record UtilizationStats is {
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      plannedRunTime: Natural with {
        briefly "Planned"
        described as {
          |Planned run time (min).
        }
      }
      actualRunTime: Natural with {
        briefly "Actual"
        described as {
          |Actual run time (min).
        }
      }
      idleTime: Natural with {
        briefly "Idle"
        described as {
          |Idle time (min).
        }
      }
      setupTime: Natural with {
        briefly "Setup"
        described as {
          |Setup time (min).
        }
      }
      downtime: Natural with {
        briefly "Downtime"
        described as {
          |Unplanned downtime (min).
        }
      }
      utilizationPercent: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Utilization percentage.
        }
      }
      periodStart: TimeStamp with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: TimeStamp with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
    } with {
      briefly "Utilization statistics"
      described as {
        |Machine utilization metrics.
      }
    }
    handler UtilizationHandler is {
      on metricsUpdated: event CNCMachine.MetricsUpdated is {
        tell command CNCContext.CNCRepository.PersistMetricsUpdated(machineId = metricsUpdated.machineId) to repository CNCContext.CNCRepository
        do "apply MetricsUpdated to the MachineUtilization projection"
      }
      on programLoaded: event CNCMachine.ProgramLoaded is {
        tell command CNCContext.CNCRepository.PersistProgramLoaded(machineId = programLoaded.machineId) to repository CNCContext.CNCRepository
        do "apply ProgramLoaded to the MachineUtilization projection"
      }
      on cycleStarted: event CNCMachine.CycleStarted is {
        tell command CNCContext.CNCRepository.PersistCycleStarted(machineId = cycleStarted.machineId) to repository CNCContext.CNCRepository
        do "Update run time tracking"
      }
      on cycleCompleted: event CNCMachine.CycleCompleted is {
        tell command CNCContext.CNCRepository.PersistCycleCompleted(machineId = cycleCompleted.machineId) to repository CNCContext.CNCRepository
        do "Calculate cycle utilization"
      }
      on cyclePaused: event CNCMachine.CyclePaused is {
        tell command CNCContext.CNCRepository.PersistCyclePaused(machineId = cyclePaused.machineId) to repository CNCContext.CNCRepository
        do "Track idle time"
      }
      on alarmRaised: event CNCMachine.AlarmRaised is {
        tell command CNCContext.CNCRepository.PersistAlarmRaised(machineId = alarmRaised.machineId) to repository CNCContext.CNCRepository
        do "Start downtime tracking"
      }
      on alarmCleared: event CNCMachine.AlarmCleared is {
        tell command CNCContext.CNCRepository.PersistAlarmCleared(machineId = alarmCleared.machineId) to repository CNCContext.CNCRepository
        do "End downtime tracking"
      }
      on machineSetup: event CNCMachine.MachineSetup is {
        tell command CNCContext.CNCRepository.PersistMachineSetup(machineId = machineSetup.machineId) to repository CNCContext.CNCRepository
        do "Track setup time"
      }
    } with {
      briefly "Tracks machine utilization"
      described as {
        |Projects events into utilization metrics.
      }
    }
  } with {
    briefly "Machine utilization projector"
    described as {
      |Maintains machine utilization analytics and reporting.
    }
  }
  // Projector for cycle time analytics
  query GetCycleTimeStats replies result CycleTimeStatsView is {
    cycleTimeStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cycle time stats to retrieve.
      }
    }
  } with {
    briefly "Get cycle time stats"
    described as {
      |Retrieves the cycle time stats projection.
    }
  }
  result CycleTimeStatsView is {
    cycleTimeStats: CycleTimeAnalytics.CycleTimeStats with {
      briefly "Cycle time stats"
      described as {
        |The cycle time stats being returned.
      }
    }
  } with {
    briefly "Cycle time stats view"
    described as {
      |Read model view carrying the cycle time stats projection.
    }
  }
  projector CycleTimeAnalytics as flow is {
    updates repository CNCContext.CNCRepository
    outlet CycleTimeAnalyticsToRepository is type CNCRepositoryCommand
 with {
      briefly "What CycleTimeAnalytics publishes to CNCRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to CNCRepository needs this port to travel on.
      }
    }
    inlet CycleTimeAnalyticsFromCNCMachine is type CNCMachineEvent    record CycleTimeStats is {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Program identifier.
        }
      }
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      estimatedCycleTime: Natural with {
        briefly "Estimated"
        described as {
          |Estimated cycle time (sec).
        }
      }
      averageActualTime: Natural with {
        briefly "Average"
        described as {
          |Average actual time (sec).
        }
      }
      minCycleTime: Natural with {
        briefly "Min"
        described as {
          |Minimum cycle time (sec).
        }
      }
      maxCycleTime: Natural with {
        briefly "Max"
        described as {
          |Maximum cycle time (sec).
        }
      }
      standardDeviation: Decimal(10,2) with {
        briefly "Std Dev"
        described as {
          |Standard deviation (sec).
        }
      }
      cycleCount: Natural with {
        briefly "Count"
        described as {
          |Number of cycles analyzed.
        }
      }
      performanceIndex: Decimal(5,4) with {
        briefly "Performance"
        described as {
          |Performance vs estimated.
        }
      }
    } with {
      briefly "Cycle time statistics"
      described as {
        |Cycle time performance metrics.
      }
    }
    handler CycleTimeHandler is {
      on alarmCleared: event CNCMachine.AlarmCleared is {
        tell command CNCContext.CNCRepository.PersistAlarmCleared(machineId = alarmCleared.machineId) to repository CNCContext.CNCRepository
        do "apply AlarmCleared to the CycleTimeAnalytics projection"
      }
      on alarmRaised: event CNCMachine.AlarmRaised is {
        tell command CNCContext.CNCRepository.PersistAlarmRaised(machineId = alarmRaised.machineId) to repository CNCContext.CNCRepository
        do "apply AlarmRaised to the CycleTimeAnalytics projection"
      }
      on cyclePaused: event CNCMachine.CyclePaused is {
        tell command CNCContext.CNCRepository.PersistCyclePaused(machineId = cyclePaused.machineId) to repository CNCContext.CNCRepository
        do "apply CyclePaused to the CycleTimeAnalytics projection"
      }
      on cycleStarted: event CNCMachine.CycleStarted is {
        tell command CNCContext.CNCRepository.PersistCycleStarted(machineId = cycleStarted.machineId) to repository CNCContext.CNCRepository
        do "apply CycleStarted to the CycleTimeAnalytics projection"
      }
      on machineSetup: event CNCMachine.MachineSetup is {
        tell command CNCContext.CNCRepository.PersistMachineSetup(machineId = machineSetup.machineId) to repository CNCContext.CNCRepository
        do "apply MachineSetup to the CycleTimeAnalytics projection"
      }
      on metricsUpdated: event CNCMachine.MetricsUpdated is {
        tell command CNCContext.CNCRepository.PersistMetricsUpdated(machineId = metricsUpdated.machineId) to repository CNCContext.CNCRepository
        do "apply MetricsUpdated to the CycleTimeAnalytics projection"
      }
      on cycleCompleted: event CNCMachine.CycleCompleted is {
        tell command CNCContext.CNCRepository.PersistCycleCompleted(machineId = cycleCompleted.machineId) to repository CNCContext.CNCRepository
        do "Update cycle time statistics"
      }
      on programLoaded: event CNCMachine.ProgramLoaded is {
        tell command CNCContext.CNCRepository.PersistProgramLoaded(machineId = programLoaded.machineId) to repository CNCContext.CNCRepository
        do "Initialize program cycle tracking"
      }
    } with {
      briefly "Tracks cycle times"
      described as {
        |Projects events into cycle time analytics.
      }
    }
  } with {
    briefly "Cycle time analytics projector"
    described as {
      |Maintains cycle time performance analysis.
    }
  }
  // Projector for OEE metrics
  query GetOEEStats replies result OEEStatsView is {
    oEEStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which oee stats to retrieve.
      }
    }
  } with {
    briefly "Get oee stats"
    described as {
      |Retrieves the oee stats projection.
    }
  }
  result OEEStatsView is {
    oEEStats: OEEAnalytics.OEEStats with {
      briefly "Oee stats"
      described as {
        |The oee stats being returned.
      }
    }
  } with {
    briefly "Oee stats view"
    described as {
      |Read model view carrying the oee stats projection.
    }
  }
  projector OEEAnalytics as flow is {
    updates repository CNCContext.CNCRepository
    outlet OEEAnalyticsToRepository is type CNCRepositoryCommand
 with {
      briefly "What OEEAnalytics publishes to CNCRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to CNCRepository needs this port to travel on.
      }
    }
    inlet OEEAnalyticsFromCNCMachine is type CNCMachineEvent    record OEEStats is {
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      shift: Natural with {
        briefly "Shift"
        described as {
          |Shift number.
        }
      }
      availability: Decimal(5,4) with {
        briefly "Availability"
        described as {
          |Availability (0-1).
        }
      }
      performance: Decimal(5,4) with {
        briefly "Performance"
        described as {
          |Performance (0-1).
        }
      }
      quality: Decimal(5,4) with {
        briefly "Quality"
        described as {
          |Quality (0-1).
        }
      }
      oee: Decimal(5,4) with {
        briefly "OEE"
        described as {
          |Overall equipment effectiveness.
        }
      }
      plannedProductionTime: Natural with {
        briefly "Planned time"
        described as {
          |Planned time (min).
        }
      }
      actualProductionTime: Natural with {
        briefly "Actual time"
        described as {
          |Actual time (min).
        }
      }
      totalParts: Natural with {
        briefly "Total parts"
        described as {
          |Total parts produced.
        }
      }
      goodParts: Natural with {
        briefly "Good parts"
        described as {
          |Good parts produced.
        }
      }
      scrapParts: Natural with {
        briefly "Scrap"
        described as {
          |Scrapped parts.
        }
      }
    } with {
      briefly "OEE statistics"
      described as {
        |Overall equipment effectiveness metrics.
      }
    }
    handler OEEHandler is {
      on cyclePaused: event CNCMachine.CyclePaused is {
        tell command CNCContext.CNCRepository.PersistCyclePaused(machineId = cyclePaused.machineId) to repository CNCContext.CNCRepository
        do "apply CyclePaused to the OEEAnalytics projection"
      }
      on metricsUpdated: event CNCMachine.MetricsUpdated is {
        tell command CNCContext.CNCRepository.PersistMetricsUpdated(machineId = metricsUpdated.machineId) to repository CNCContext.CNCRepository
        do "apply MetricsUpdated to the OEEAnalytics projection"
      }
      on programLoaded: event CNCMachine.ProgramLoaded is {
        tell command CNCContext.CNCRepository.PersistProgramLoaded(machineId = programLoaded.machineId) to repository CNCContext.CNCRepository
        do "apply ProgramLoaded to the OEEAnalytics projection"
      }
      on cycleStarted: event CNCMachine.CycleStarted is {
        tell command CNCContext.CNCRepository.PersistCycleStarted(machineId = cycleStarted.machineId) to repository CNCContext.CNCRepository
        do "Track availability - production started"
      }
      on cycleCompleted: event CNCMachine.CycleCompleted is {
        tell command CNCContext.CNCRepository.PersistCycleCompleted(machineId = cycleCompleted.machineId) to repository CNCContext.CNCRepository
        do "Update performance and quality metrics"
      }
      on alarmRaised: event CNCMachine.AlarmRaised is {
        tell command CNCContext.CNCRepository.PersistAlarmRaised(machineId = alarmRaised.machineId) to repository CNCContext.CNCRepository
        do "Track unplanned downtime for availability"
      }
      on alarmCleared: event CNCMachine.AlarmCleared is {
        tell command CNCContext.CNCRepository.PersistAlarmCleared(machineId = alarmCleared.machineId) to repository CNCContext.CNCRepository
        do "End downtime period"
      }
      on machineSetup: event CNCMachine.MachineSetup is {
        tell command CNCContext.CNCRepository.PersistMachineSetup(machineId = machineSetup.machineId) to repository CNCContext.CNCRepository
        do "Track setup as planned downtime"
      }
    } with {
      briefly "Calculates OEE metrics"
      described as {
        |Projects events into OEE analytics.
      }
    }
  } with {
    briefly "OEE analytics projector"
    described as {
      | Maintains overall equipment effectiveness metrics including
      | availability, performance, and quality calculations.
    }
  }
  // Projector for alarm history and analysis
  query GetAlarmStats replies result AlarmStatsView is {
    alarmStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which alarm stats to retrieve.
      }
    }
  } with {
    briefly "Get alarm stats"
    described as {
      |Retrieves the alarm stats projection.
    }
  }
  result AlarmStatsView is {
    alarmStats: AlarmAnalytics.AlarmStats with {
      briefly "Alarm stats"
      described as {
        |The alarm stats being returned.
      }
    }
  } with {
    briefly "Alarm stats view"
    described as {
      |Read model view carrying the alarm stats projection.
    }
  }
  projector AlarmAnalytics as flow is {
    updates repository CNCContext.CNCRepository
    outlet AlarmAnalyticsToRepository is type CNCRepositoryCommand
 with {
      briefly "What AlarmAnalytics publishes to CNCRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to CNCRepository needs this port to travel on.
      }
    }
    inlet AlarmAnalyticsFromCNCMachine is type CNCMachineEvent    record AlarmStats is {
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      alarmCode: String(1,20) with {
        briefly "Code"
        described as {
          |Alarm code.
        }
      }
      occurrenceCount: Natural with {
        briefly "Count"
        described as {
          |Number of occurrences.
        }
      }
      totalDowntime: Natural with {
        briefly "Downtime"
        described as {
          |Total downtime (min).
        }
      }
      averageResolutionTime: Natural with {
        briefly "Avg resolution"
        described as {
          |Avg resolution time (min).
        }
      }
      lastOccurrence: TimeStamp with {
        briefly "Last"
        described as {
          |Last occurrence time.
        }
      }
      mostCommonResolution: String(1,500)? with {
        briefly "Resolution"
        described as {
          |Most common fix.
        }
      }
    } with {
      briefly "Alarm statistics"
      described as {
        |Alarm occurrence and resolution analytics.
      }
    }
    handler AlarmStatsHandler is {
      on cycleCompleted: event CNCMachine.CycleCompleted is {
        tell command CNCContext.CNCRepository.PersistCycleCompleted(machineId = cycleCompleted.machineId) to repository CNCContext.CNCRepository
        do "apply CycleCompleted to the AlarmAnalytics projection"
      }
      on cyclePaused: event CNCMachine.CyclePaused is {
        tell command CNCContext.CNCRepository.PersistCyclePaused(machineId = cyclePaused.machineId) to repository CNCContext.CNCRepository
        do "apply CyclePaused to the AlarmAnalytics projection"
      }
      on cycleStarted: event CNCMachine.CycleStarted is {
        tell command CNCContext.CNCRepository.PersistCycleStarted(machineId = cycleStarted.machineId) to repository CNCContext.CNCRepository
        do "apply CycleStarted to the AlarmAnalytics projection"
      }
      on machineSetup: event CNCMachine.MachineSetup is {
        tell command CNCContext.CNCRepository.PersistMachineSetup(machineId = machineSetup.machineId) to repository CNCContext.CNCRepository
        do "apply MachineSetup to the AlarmAnalytics projection"
      }
      on metricsUpdated: event CNCMachine.MetricsUpdated is {
        tell command CNCContext.CNCRepository.PersistMetricsUpdated(machineId = metricsUpdated.machineId) to repository CNCContext.CNCRepository
        do "apply MetricsUpdated to the AlarmAnalytics projection"
      }
      on programLoaded: event CNCMachine.ProgramLoaded is {
        tell command CNCContext.CNCRepository.PersistProgramLoaded(machineId = programLoaded.machineId) to repository CNCContext.CNCRepository
        do "apply ProgramLoaded to the AlarmAnalytics projection"
      }
      on alarmRaised: event CNCMachine.AlarmRaised is {
        tell command CNCContext.CNCRepository.PersistAlarmRaised(machineId = alarmRaised.machineId) to repository CNCContext.CNCRepository
        do "Increment alarm occurrence count"
      }
      on alarmCleared: event CNCMachine.AlarmCleared is {
        tell command CNCContext.CNCRepository.PersistAlarmCleared(machineId = alarmCleared.machineId) to repository CNCContext.CNCRepository
        do "Update resolution time and patterns"
      }
    } with {
      briefly "Tracks alarm patterns"
      described as {
        |Projects events into alarm analytics.
      }
    }
  } with {
    briefly "Alarm analytics projector"
    described as {
      |Maintains alarm history and pattern analysis.
    }
  }
  // ---- Event publication for CNCMachine ----
  type CNCMachineEvent is one of {
    CNCContext.CNCMachine.ProgramLoaded or CNCContext.CNCMachine.MachineSetup or CNCContext.CNCMachine.CycleStarted or CNCContext.CNCMachine.CyclePaused or CNCContext.CNCMachine.CycleCompleted or CNCContext.CNCMachine.AlarmRaised or CNCContext.CNCMachine.AlarmCleared or CNCContext.CNCMachine.MetricsUpdated
  } with {
    briefly "CNCMachine event alternation"
    described as {
      |Union of all CNCMachine events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet CNCMachineEventSplit as split is {
    inlet CNCMachineEventSplitIn is type CNCMachineEvent    outlet CNCMachineEventSplitToMachineUtilization is type CNCMachineEvent
    outlet CNCMachineEventSplitToCycleTimeAnalytics is type CNCMachineEvent
    outlet CNCMachineEventSplitToOEEAnalytics is type CNCMachineEvent
    outlet CNCMachineEventSplitToAlarmAnalytics is type CNCMachineEvent
    handler CNCMachineEventSplitHandler is {
      on programLoaded: event CNCMachine.ProgramLoaded is {
        send programLoaded to outlet CNCMachineEventSplitToMachineUtilization
        send programLoaded to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send programLoaded to outlet CNCMachineEventSplitToOEEAnalytics
        send programLoaded to outlet CNCMachineEventSplitToAlarmAnalytics
        tell programLoaded to entity CNCContext.CNCMachine
      }
      on machineSetup: event CNCMachine.MachineSetup is {
        send machineSetup to outlet CNCMachineEventSplitToMachineUtilization
        send machineSetup to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send machineSetup to outlet CNCMachineEventSplitToOEEAnalytics
        send machineSetup to outlet CNCMachineEventSplitToAlarmAnalytics
        tell machineSetup to entity CNCContext.CNCMachine
      }
      on cycleStarted: event CNCMachine.CycleStarted is {
        send cycleStarted to outlet CNCMachineEventSplitToMachineUtilization
        send cycleStarted to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send cycleStarted to outlet CNCMachineEventSplitToOEEAnalytics
        send cycleStarted to outlet CNCMachineEventSplitToAlarmAnalytics
        tell cycleStarted to entity CNCContext.CNCMachine
      }
      on cyclePaused: event CNCMachine.CyclePaused is {
        send cyclePaused to outlet CNCMachineEventSplitToMachineUtilization
        send cyclePaused to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send cyclePaused to outlet CNCMachineEventSplitToOEEAnalytics
        send cyclePaused to outlet CNCMachineEventSplitToAlarmAnalytics
        tell cyclePaused to entity CNCContext.CNCMachine
      }
      on cycleCompleted: event CNCMachine.CycleCompleted is {
        send cycleCompleted to outlet CNCMachineEventSplitToMachineUtilization
        send cycleCompleted to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send cycleCompleted to outlet CNCMachineEventSplitToOEEAnalytics
        send cycleCompleted to outlet CNCMachineEventSplitToAlarmAnalytics
        tell cycleCompleted to entity CNCContext.CNCMachine
      }
      on alarmRaised: event CNCMachine.AlarmRaised is {
        send alarmRaised to outlet CNCMachineEventSplitToMachineUtilization
        send alarmRaised to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send alarmRaised to outlet CNCMachineEventSplitToOEEAnalytics
        send alarmRaised to outlet CNCMachineEventSplitToAlarmAnalytics
        tell alarmRaised to entity CNCContext.CNCMachine
      }
      on alarmCleared: event CNCMachine.AlarmCleared is {
        send alarmCleared to outlet CNCMachineEventSplitToMachineUtilization
        send alarmCleared to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send alarmCleared to outlet CNCMachineEventSplitToOEEAnalytics
        send alarmCleared to outlet CNCMachineEventSplitToAlarmAnalytics
        tell alarmCleared to entity CNCContext.CNCMachine
      }
      on metricsUpdated: event CNCMachine.MetricsUpdated is {
        send metricsUpdated to outlet CNCMachineEventSplitToMachineUtilization
        send metricsUpdated to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send metricsUpdated to outlet CNCMachineEventSplitToOEEAnalytics
        send metricsUpdated to outlet CNCMachineEventSplitToAlarmAnalytics
        tell metricsUpdated to entity CNCContext.CNCMachine
      }
      on other is {
        error "Unexpected message for processor CNCMachineEventSplit"
      }
    } with {
      briefly "CNCMachine event fan-out handler"
      described as {
        |Delivers each CNCMachine event to all of its consumers.
      }
    }
  } with {
    briefly "CNCMachine event fan-out"
    described as {
      |Fans CNCMachine events out to the repository and projectors.
    }
  }
  connector 'CNCMachineEvent Stream' is from outlet CNCContext.CNCMachine.CNCMachineEvents2 to inlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitIn with {
    briefly "CNCMachine events, fanned out to storage and read models"
  }
  connector 'MachineUtilization Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToMachineUtilization to inlet CNCContext.MachineUtilization.MachineUtilizationFromCNCMachine with {
    briefly "CNCMachine events feeding the MachineUtilization projection"
  }
  connector 'CycleTimeAnalytics Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToCycleTimeAnalytics to inlet CNCContext.CycleTimeAnalytics.CycleTimeAnalyticsFromCNCMachine with {
    briefly "CNCMachine events feeding the CycleTimeAnalytics projection"
  }
  connector 'OEEAnalytics Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToOEEAnalytics to inlet CNCContext.OEEAnalytics.OEEAnalyticsFromCNCMachine with {
    briefly "CNCMachine events feeding the OEEAnalytics projection"
  }
  connector 'AlarmAnalytics Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToAlarmAnalytics to inlet CNCContext.AlarmAnalytics.AlarmAnalyticsFromCNCMachine with {
    briefly "CNCMachine events feeding the AlarmAnalytics projection"
  }
  connector 'MachineUtilization Storage' is from outlet CNCContext.MachineUtilization.MachineUtilizationToRepository to inlet CNCContext.CNCRepository.CNCRepositoryFromMachineUtilization with {
    briefly "MachineUtilization updates on their way to storage"
  }
} with {
  briefly "Bounded context for CNC operations"
  described as {
    | The CNCContext is the bounded context for
    | CNC machine operations, monitoring, and analytics.
  }
}
