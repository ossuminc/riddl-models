// CNC Operations - CNC Context
context CNCContext is {
  adaptor FromMaintenanceService from context MaintenanceService is { 
    handler FromMaintenanceServiceHandler is {
      on event MaintenanceService.MaintenanceRequested is {
        do "the model receives maintenance requested"
      }
      on event MaintenanceService.PMDueReminder is {
        do "the model receives pm due reminder"
      }
      on result MaintenanceService.PMSchedule is {
        do "the model receives pm schedule"
      }
      on event MaintenanceService.PMScheduled is {
        do "the model receives pm scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceService"
      }
    } with {
      briefly "from maintenance service"
      described as {
        |Carries messages from the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor ToMaintenanceService to context MaintenanceService is { 
    handler ToMaintenanceServiceHandler is {
      on query MaintenanceService.GetPMSchedule is {
        do "the model sends get pm schedule"
      }
      on command MaintenanceService.ReportMachineIssue is {
        do "the model sends report machine issue"
      }
      on command MaintenanceService.SchedulePM is {
        do "the model sends schedule pm"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceService"
      }
    } with {
      briefly "to maintenance service"
      described as {
        |Carries messages to the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor FromQualityService from context QualityService is { 
    handler FromQualityServiceHandler is {
      on event QualityService.FirstArticleApproved is {
        do "the model receives first article approved"
      }
      on event QualityService.FirstArticleRejected is {
        do "the model receives first article rejected"
      }
      on event QualityService.FirstArticleRequested is {
        do "the model receives first article requested"
      }
      on event QualityService.MeasurementRecorded is {
        do "the model receives measurement recorded"
      }
      on result QualityService.SPCLimits is {
        do "the model receives spc limits"
      }
      on event QualityService.SPCViolation is {
        do "the model receives spc violation"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityService"
      }
    } with {
      briefly "from quality service"
      described as {
        |Carries messages from the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor ToQualityService to context QualityService is { 
    handler ToQualityServiceHandler is {
      on query QualityService.GetSPCLimits is {
        do "the model sends get spc limits"
      }
      on command QualityService.RecordMeasurement is {
        do "the model sends record measurement"
      }
      on command QualityService.RequestFirstArticle is {
        do "the model sends request first article"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityService"
      }
    } with {
      briefly "to quality service"
      described as {
        |Carries messages to the external QualityService.
      }
    }
  } with {
    briefly "QualityService integration"
    described as {
      |The model's side of the QualityService conversation.
    }
  }
  adaptor FromToolManagementService from context ToolManagementService is { 
    handler FromToolManagementServiceHandler is {
      on event ToolManagementService.ToolExhausted is {
        do "the model receives tool exhausted"
      }
      on result ToolManagementService.ToolLifeStatus is {
        do "the model receives tool life status"
      }
      on event ToolManagementService.ToolLifeUpdated is {
        do "the model receives tool life updated"
      }
      on event ToolManagementService.ToolLifeWarning is {
        do "the model receives tool life warning"
      }
      on result ToolManagementService.ToolOffsets is {
        do "the model receives tool offsets"
      }
      on other is {
        error "Unexpected message for adaptor FromToolManagementService"
      }
    } with {
      briefly "from tool management service"
      described as {
        |Carries messages from the external ToolManagementService.
      }
    }
  } with {
    briefly "ToolManagementService integration"
    described as {
      |The model's side of the ToolManagementService conversation.
    }
  }
  adaptor ToToolManagementService to context ToolManagementService is { 
    handler ToToolManagementServiceHandler is {
      on query ToolManagementService.GetToolLife is {
        do "the model sends get tool life"
      }
      on query ToolManagementService.GetToolOffsets is {
        do "the model sends get tool offsets"
      }
      on command ToolManagementService.UpdateToolLife is {
        do "the model sends update tool life"
      }
      on other is {
        error "Unexpected message for adaptor ToToolManagementService"
      }
    } with {
      briefly "to tool management service"
      described as {
        |Carries messages to the external ToolManagementService.
      }
    }
  } with {
    briefly "ToolManagementService integration"
    described as {
      |The model's side of the ToolManagementService conversation.
    }
  }
  include "types.riddl"
  include "CNCMachine.riddl"
  // Repository for CNC data persistence
  repository CNCRepository is {
    inlet CNCRepositoryFromCNCMachine is type CNCMachineEvent    inlet CNCRepositoryFromMachineUtilization is type CNCMachineEvent    inlet CNCRepositoryFromCycleTimeAnalytics is type CNCMachineEvent    inlet CNCRepositoryFromOEEAnalytics is type CNCMachineEvent    inlet CNCRepositoryFromAlarmAnalytics is type CNCMachineEvent    outlet CNCRepositoryResponses is type CNCMachine.CNCMachineResult
    record StoredCNCMachine is  {
      cNCMachineId: UUID with {
        briefly "cNCMachineId"
        described as {
          |The cNCMachineId column of the stored cNCMachine row.
        }
      }
      machineId: MachineId with {
        briefly "machineId"
        described as {
          |The machineId column of the stored cNCMachine row.
        }
      }
      status: MachineStatus with {
        briefly "status"
        described as {
          |The status column of the stored cNCMachine row.
        }
      }
    } with {
      briefly "Stored cNCMachine row"
      described as {
        |The persistence shape of cNCMachine data as this repository stores it.
      }
    }
    schema CNCData is relational
      of machines as type StoredCNCMachine
        index on field StoredCNCMachine.machineId
        index on field StoredCNCMachine.status
 with {
      briefly "Cnc data schema"
      described as {
        |The relational schema holding cnc data for the CNCRepository.
      }
    }
    handler CNCPersistence is {
      on query GetUtilizationStats is {
        do "read the utilization stats projection"
        yield result UtilizationStatsView
      }
      on query GetCycleTimeStats is {
        do "read the cycle time stats projection"
        yield result CycleTimeStatsView
      }
      on query GetOEEStats is {
        do "read the oee stats projection"
        yield result OEEStatsView
      }
      on query GetAlarmStats is {
        do "read the alarm stats projection"
        yield result AlarmStatsView
      }
      on command CNCMachine.LoadProgram is {
        tell event CNCMachine.ProgramLoaded to entity CNCContext.CNCMachine
      }
      on command CNCMachine.SetupMachine is {
        do "Store machine setup"
      }
      on command CNCMachine.StartCycle is {
        tell event CNCMachine.CycleStarted to entity CNCContext.CNCMachine
        do "Store cycle start"
      }
      on command CNCMachine.PauseCycle is {
        do "Store cycle pause"
      }
      on command CNCMachine.CompleteCycle is {
        tell event CNCMachine.CycleCompleted to entity CNCContext.CNCMachine
        do "Store cycle completion"
      }
      on command CNCMachine.ReportAlarm is {
        do "Store alarm event"
      }
      on command CNCMachine.ClearAlarm is {
        do "Store alarm resolution"
      }
      on command CNCMachine.UpdateMetrics is {
        tell event CNCMachine.MetricsUpdated to entity CNCContext.CNCMachine
        do "Store metrics snapshot"
      }
    } with {
      briefly "Persists CNC machine events"
      described as {
        |Handles command-driven persistence of machine data.
      }
    }
  } with {
    briefly "CNC data persistence"
    described as {
      | The CNCRepository provides persistent storage for
      | machine state, cycles, alarms, and metrics history.
    }
  }
  // Projector for machine utilization analytics
  query GetUtilizationStats is  {
    utilizationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization stats to retrieve.
      }
    }
  } with {
    briefly "Get utilization stats"
    described as {
      |Retrieves the utilization stats projection.
    }
  }
  result UtilizationStatsView is  {
    utilizationStats: MachineUtilization.UtilizationStats with {
      briefly "Utilization stats"
      described as {
        |The utilization stats being returned.
      }
    }
  } with {
    briefly "Utilization stats view"
    described as {
      |Read model view carrying the utilization stats projection.
    }
  }
  projector MachineUtilization is {
    updates repository CNCContext.CNCRepository
    inlet MachineUtilizationFromCNCMachine is type CNCMachineEvent    outlet MachineUtilizationOut is type CNCMachineEvent
    record UtilizationStats is  {
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      plannedRunTime: Natural with {
        briefly "Planned"
        described as {
          |Planned run time (min).
        }
      }
      actualRunTime: Natural with {
        briefly "Actual"
        described as {
          |Actual run time (min).
        }
      }
      idleTime: Natural with {
        briefly "Idle"
        described as {
          |Idle time (min).
        }
      }
      setupTime: Natural with {
        briefly "Setup"
        described as {
          |Setup time (min).
        }
      }
      downtime: Natural with {
        briefly "Downtime"
        described as {
          |Unplanned downtime (min).
        }
      }
      utilizationPercent: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Utilization percentage.
        }
      }
      periodStart: TimeStamp with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: TimeStamp with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
    } with {
      briefly "Utilization statistics"
      described as {
        |Machine utilization metrics.
      }
    }
    handler UtilizationHandler is {
      on event CNCMachine.CycleStarted is {
        tell event CNCMachine.CycleStarted to repository CNCContext.CNCRepository
        do "Update run time tracking"
      }
      on event CNCMachine.CycleCompleted is {
        tell event CNCMachine.CycleCompleted to repository CNCContext.CNCRepository
        do "Calculate cycle utilization"
      }
      on event CNCMachine.CyclePaused is {
        tell event CNCMachine.CyclePaused to repository CNCContext.CNCRepository
        do "Track idle time"
      }
      on event CNCMachine.AlarmRaised is {
        tell event CNCMachine.AlarmRaised to repository CNCContext.CNCRepository
        do "Start downtime tracking"
      }
      on event CNCMachine.AlarmCleared is {
        tell event CNCMachine.AlarmCleared to repository CNCContext.CNCRepository
        do "End downtime tracking"
      }
      on event CNCMachine.MachineSetup is {
        tell event CNCMachine.MachineSetup to repository CNCContext.CNCRepository
        do "Track setup time"
      }
    } with {
      briefly "Tracks machine utilization"
      described as {
        |Projects events into utilization metrics.
      }
    }
  } with {
    briefly "Machine utilization projector"
    described as {
      |Maintains machine utilization analytics and reporting.
    }
  }
  // Projector for cycle time analytics
  query GetCycleTimeStats is  {
    cycleTimeStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cycle time stats to retrieve.
      }
    }
  } with {
    briefly "Get cycle time stats"
    described as {
      |Retrieves the cycle time stats projection.
    }
  }
  result CycleTimeStatsView is  {
    cycleTimeStats: CycleTimeAnalytics.CycleTimeStats with {
      briefly "Cycle time stats"
      described as {
        |The cycle time stats being returned.
      }
    }
  } with {
    briefly "Cycle time stats view"
    described as {
      |Read model view carrying the cycle time stats projection.
    }
  }
  projector CycleTimeAnalytics is {
    updates repository CNCContext.CNCRepository
    inlet CycleTimeAnalyticsFromCNCMachine is type CNCMachineEvent    outlet CycleTimeAnalyticsOut is type CNCMachineEvent
    record CycleTimeStats is  {
      programId: ProgramId with {
        briefly "Program"
        described as {
          |Program identifier.
        }
      }
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      estimatedCycleTime: Natural with {
        briefly "Estimated"
        described as {
          |Estimated cycle time (sec).
        }
      }
      averageActualTime: Natural with {
        briefly "Average"
        described as {
          |Average actual time (sec).
        }
      }
      minCycleTime: Natural with {
        briefly "Min"
        described as {
          |Minimum cycle time (sec).
        }
      }
      maxCycleTime: Natural with {
        briefly "Max"
        described as {
          |Maximum cycle time (sec).
        }
      }
      standardDeviation: Decimal(10,2) with {
        briefly "Std Dev"
        described as {
          |Standard deviation (sec).
        }
      }
      cycleCount: Natural with {
        briefly "Count"
        described as {
          |Number of cycles analyzed.
        }
      }
      performanceIndex: Decimal(5,4) with {
        briefly "Performance"
        described as {
          |Performance vs estimated.
        }
      }
    } with {
      briefly "Cycle time statistics"
      described as {
        |Cycle time performance metrics.
      }
    }
    handler CycleTimeHandler is {
      on event CNCMachine.CycleCompleted is {
        tell event CNCMachine.CycleCompleted to repository CNCContext.CNCRepository
        do "Update cycle time statistics"
      }
      on event CNCMachine.ProgramLoaded is {
        tell event CNCMachine.ProgramLoaded to repository CNCContext.CNCRepository
        do "Initialize program cycle tracking"
      }
    } with {
      briefly "Tracks cycle times"
      described as {
        |Projects events into cycle time analytics.
      }
    }
  } with {
    briefly "Cycle time analytics projector"
    described as {
      |Maintains cycle time performance analysis.
    }
  }
  // Projector for OEE metrics
  query GetOEEStats is  {
    oEEStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which oee stats to retrieve.
      }
    }
  } with {
    briefly "Get oee stats"
    described as {
      |Retrieves the oee stats projection.
    }
  }
  result OEEStatsView is  {
    oEEStats: OEEAnalytics.OEEStats with {
      briefly "Oee stats"
      described as {
        |The oee stats being returned.
      }
    }
  } with {
    briefly "Oee stats view"
    described as {
      |Read model view carrying the oee stats projection.
    }
  }
  projector OEEAnalytics is {
    updates repository CNCContext.CNCRepository
    inlet OEEAnalyticsFromCNCMachine is type CNCMachineEvent    outlet OEEAnalyticsOut is type CNCMachineEvent
    record OEEStats is  {
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      shiftDate: Date with {
        briefly "Date"
        described as {
          |Shift date.
        }
      }
      shift: Natural with {
        briefly "Shift"
        described as {
          |Shift number.
        }
      }
      availability: Decimal(5,4) with {
        briefly "Availability"
        described as {
          |Availability (0-1).
        }
      }
      performance: Decimal(5,4) with {
        briefly "Performance"
        described as {
          |Performance (0-1).
        }
      }
      quality: Decimal(5,4) with {
        briefly "Quality"
        described as {
          |Quality (0-1).
        }
      }
      oee: Decimal(5,4) with {
        briefly "OEE"
        described as {
          |Overall equipment effectiveness.
        }
      }
      plannedProductionTime: Natural with {
        briefly "Planned time"
        described as {
          |Planned time (min).
        }
      }
      actualProductionTime: Natural with {
        briefly "Actual time"
        described as {
          |Actual time (min).
        }
      }
      totalParts: Natural with {
        briefly "Total parts"
        described as {
          |Total parts produced.
        }
      }
      goodParts: Natural with {
        briefly "Good parts"
        described as {
          |Good parts produced.
        }
      }
      scrapParts: Natural with {
        briefly "Scrap"
        described as {
          |Scrapped parts.
        }
      }
    } with {
      briefly "OEE statistics"
      described as {
        |Overall equipment effectiveness metrics.
      }
    }
    handler OEEHandler is {
      on event CNCMachine.CycleStarted is {
        tell event CNCMachine.CycleStarted to repository CNCContext.CNCRepository
        do "Track availability - production started"
      }
      on event CNCMachine.CycleCompleted is {
        tell event CNCMachine.CycleCompleted to repository CNCContext.CNCRepository
        do "Update performance and quality metrics"
      }
      on event CNCMachine.AlarmRaised is {
        tell event CNCMachine.AlarmRaised to repository CNCContext.CNCRepository
        do "Track unplanned downtime for availability"
      }
      on event CNCMachine.AlarmCleared is {
        tell event CNCMachine.AlarmCleared to repository CNCContext.CNCRepository
        do "End downtime period"
      }
      on event CNCMachine.MachineSetup is {
        tell event CNCMachine.MachineSetup to repository CNCContext.CNCRepository
        do "Track setup as planned downtime"
      }
    } with {
      briefly "Calculates OEE metrics"
      described as {
        |Projects events into OEE analytics.
      }
    }
  } with {
    briefly "OEE analytics projector"
    described as {
      | Maintains overall equipment effectiveness metrics including
      | availability, performance, and quality calculations.
    }
  }
  // Projector for alarm history and analysis
  query GetAlarmStats is  {
    alarmStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which alarm stats to retrieve.
      }
    }
  } with {
    briefly "Get alarm stats"
    described as {
      |Retrieves the alarm stats projection.
    }
  }
  result AlarmStatsView is  {
    alarmStats: AlarmAnalytics.AlarmStats with {
      briefly "Alarm stats"
      described as {
        |The alarm stats being returned.
      }
    }
  } with {
    briefly "Alarm stats view"
    described as {
      |Read model view carrying the alarm stats projection.
    }
  }
  projector AlarmAnalytics is {
    updates repository CNCContext.CNCRepository
    inlet AlarmAnalyticsFromCNCMachine is type CNCMachineEvent    outlet AlarmAnalyticsOut is type CNCMachineEvent
    record AlarmStats is  {
      machineId: MachineId with {
        briefly "Machine"
        described as {
          |Machine identifier.
        }
      }
      alarmCode: String(1,20) with {
        briefly "Code"
        described as {
          |Alarm code.
        }
      }
      occurrenceCount: Natural with {
        briefly "Count"
        described as {
          |Number of occurrences.
        }
      }
      totalDowntime: Natural with {
        briefly "Downtime"
        described as {
          |Total downtime (min).
        }
      }
      averageResolutionTime: Natural with {
        briefly "Avg resolution"
        described as {
          |Avg resolution time (min).
        }
      }
      lastOccurrence: TimeStamp with {
        briefly "Last"
        described as {
          |Last occurrence time.
        }
      }
      mostCommonResolution: String(1,500)? with {
        briefly "Resolution"
        described as {
          |Most common fix.
        }
      }
    } with {
      briefly "Alarm statistics"
      described as {
        |Alarm occurrence and resolution analytics.
      }
    }
    handler AlarmStatsHandler is {
      on event CNCMachine.AlarmRaised is {
        tell event CNCMachine.AlarmRaised to repository CNCContext.CNCRepository
        do "Increment alarm occurrence count"
      }
      on event CNCMachine.AlarmCleared is {
        tell event CNCMachine.AlarmCleared to repository CNCContext.CNCRepository
        do "Update resolution time and patterns"
      }
    } with {
      briefly "Tracks alarm patterns"
      described as {
        |Projects events into alarm analytics.
      }
    }
  } with {
    briefly "Alarm analytics projector"
    described as {
      |Maintains alarm history and pattern analysis.
    }
  }
  // ---- Event publication for CNCMachine ----
  type CNCMachineEvent is one of {
    CNCContext.CNCMachine.ProgramLoaded or CNCContext.CNCMachine.MachineSetup or CNCContext.CNCMachine.CycleStarted or CNCContext.CNCMachine.CyclePaused or CNCContext.CNCMachine.CycleCompleted or CNCContext.CNCMachine.AlarmRaised or CNCContext.CNCMachine.AlarmCleared or CNCContext.CNCMachine.MetricsUpdated
  } with {
    briefly "CNCMachine event alternation"
    described as {
      |Union of all CNCMachine events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CNCMachineEventSource as source is {
    outlet CNCMachineEvents is type CNCMachineEvent
    handler CNCMachineSourceHandler is {
      on event CNCMachine.ProgramLoaded is {
        send event CNCMachine.ProgramLoaded to outlet CNCMachineEvents
      }
      on event CNCMachine.MachineSetup is {
        send event CNCMachine.MachineSetup to outlet CNCMachineEvents
      }
      on event CNCMachine.CycleStarted is {
        send event CNCMachine.CycleStarted to outlet CNCMachineEvents
      }
      on event CNCMachine.CyclePaused is {
        send event CNCMachine.CyclePaused to outlet CNCMachineEvents
      }
      on event CNCMachine.CycleCompleted is {
        send event CNCMachine.CycleCompleted to outlet CNCMachineEvents
      }
      on event CNCMachine.AlarmRaised is {
        send event CNCMachine.AlarmRaised to outlet CNCMachineEvents
      }
      on event CNCMachine.AlarmCleared is {
        send event CNCMachine.AlarmCleared to outlet CNCMachineEvents
      }
      on event CNCMachine.MetricsUpdated is {
        send event CNCMachine.MetricsUpdated to outlet CNCMachineEvents
      }
      on other is {
        error "Unexpected message for source CNCMachineEventSource"
      }
    } with {
      briefly "CNCMachine source handler"
      described as {
        |Publishes CNCMachine events onto the outlet.
      }
    }
  } with {
    briefly "CNCMachine event source"
    described as {
      |Publishes CNCMachine entity events into the streaming topology.
    }
  }
  processor CNCMachineEventSink as sink is {
    inlet CNCMachineInlet is type CNCMachineEvent    handler CNCMachineSinkHandler is {
      on event CNCMachine.ProgramLoaded is {
        tell event CNCMachine.ProgramLoaded to repository CNCContext.CNCRepository
      }
      on event CNCMachine.MachineSetup is {
        tell event CNCMachine.MachineSetup to repository CNCContext.CNCRepository
      }
      on event CNCMachine.CycleStarted is {
        tell event CNCMachine.CycleStarted to repository CNCContext.CNCRepository
      }
      on event CNCMachine.CyclePaused is {
        tell event CNCMachine.CyclePaused to repository CNCContext.CNCRepository
      }
      on event CNCMachine.CycleCompleted is {
        tell event CNCMachine.CycleCompleted to repository CNCContext.CNCRepository
      }
      on event CNCMachine.AlarmRaised is {
        tell event CNCMachine.AlarmRaised to repository CNCContext.CNCRepository
      }
      on event CNCMachine.AlarmCleared is {
        tell event CNCMachine.AlarmCleared to repository CNCContext.CNCRepository
      }
      on event CNCMachine.MetricsUpdated is {
        tell event CNCMachine.MetricsUpdated to repository CNCContext.CNCRepository
      }
      on other is {
        error "Unexpected message for sink CNCMachineEventSink"
      }
    } with {
      briefly "CNCMachine sink handler"
      described as {
        |Persists CNCMachine events via the repository.
      }
    }
  } with {
    briefly "CNCMachine event sink"
    described as {
      |Receives CNCMachine events for persistence.
    }
  }
  connector CNCMachineEventFlow is from outlet CNCContext.CNCMachineEventSource.CNCMachineEvents to inlet CNCContext.CNCMachineEventSink.CNCMachineInlet with {
    briefly "CNCMachine event flow"
    described as {
      |Connects the CNCMachine source to its sink.
    }
  }
  processor CNCMachineEventSplit is {
    inlet CNCMachineEventSplitIn is type CNCMachineEvent    outlet CNCMachineEventSplitToCNCRepository is type CNCMachineEvent
    outlet CNCMachineEventSplitToMachineUtilization is type CNCMachineEvent
    outlet CNCMachineEventSplitToCycleTimeAnalytics is type CNCMachineEvent
    outlet CNCMachineEventSplitToOEEAnalytics is type CNCMachineEvent
    outlet CNCMachineEventSplitToAlarmAnalytics is type CNCMachineEvent
    handler CNCMachineEventSplitHandler is {
      on event CNCMachine.ProgramLoaded is {
        send event CNCMachine.ProgramLoaded to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.ProgramLoaded to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.ProgramLoaded to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.ProgramLoaded to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.ProgramLoaded to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.ProgramLoaded to entity CNCContext.CNCMachine
      }
      on event CNCMachine.MachineSetup is {
        send event CNCMachine.MachineSetup to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.MachineSetup to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.MachineSetup to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.MachineSetup to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.MachineSetup to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.MachineSetup to entity CNCContext.CNCMachine
      }
      on event CNCMachine.CycleStarted is {
        send event CNCMachine.CycleStarted to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.CycleStarted to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.CycleStarted to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.CycleStarted to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.CycleStarted to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.CycleStarted to entity CNCContext.CNCMachine
      }
      on event CNCMachine.CyclePaused is {
        send event CNCMachine.CyclePaused to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.CyclePaused to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.CyclePaused to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.CyclePaused to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.CyclePaused to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.CyclePaused to entity CNCContext.CNCMachine
      }
      on event CNCMachine.CycleCompleted is {
        send event CNCMachine.CycleCompleted to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.CycleCompleted to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.CycleCompleted to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.CycleCompleted to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.CycleCompleted to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.CycleCompleted to entity CNCContext.CNCMachine
      }
      on event CNCMachine.AlarmRaised is {
        send event CNCMachine.AlarmRaised to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.AlarmRaised to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.AlarmRaised to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.AlarmRaised to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.AlarmRaised to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.AlarmRaised to entity CNCContext.CNCMachine
      }
      on event CNCMachine.AlarmCleared is {
        send event CNCMachine.AlarmCleared to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.AlarmCleared to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.AlarmCleared to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.AlarmCleared to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.AlarmCleared to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.AlarmCleared to entity CNCContext.CNCMachine
      }
      on event CNCMachine.MetricsUpdated is {
        send event CNCMachine.MetricsUpdated to outlet CNCMachineEventSplitToCNCRepository
        send event CNCMachine.MetricsUpdated to outlet CNCMachineEventSplitToMachineUtilization
        send event CNCMachine.MetricsUpdated to outlet CNCMachineEventSplitToCycleTimeAnalytics
        send event CNCMachine.MetricsUpdated to outlet CNCMachineEventSplitToOEEAnalytics
        send event CNCMachine.MetricsUpdated to outlet CNCMachineEventSplitToAlarmAnalytics
        tell event CNCMachine.MetricsUpdated to entity CNCContext.CNCMachine
      }
      on other is {
        error "Unexpected message for processor CNCMachineEventSplit"
      }
    } with {
      briefly "CNCMachine event fan-out handler"
      described as {
        |Delivers each CNCMachine event to all of its consumers.
      }
    }
  } with {
    briefly "CNCMachine event fan-out"
    described as {
      |Fans CNCMachine events out to the repository and projectors.
    }
  }
  connector 'CNCMachineEvent Stream' is from outlet CNCContext.CNCMachine.CNCMachineEvents2 to inlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitIn with {
    briefly "CNCMachine events, fanned out to storage and read models"
  }
  connector 'CNCMachineEvent Storage' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToCNCRepository to inlet CNCContext.CNCRepository.CNCRepositoryFromCNCMachine with {
    briefly "CNCMachine events on their way to storage"
  }
  connector 'MachineUtilization Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToMachineUtilization to inlet CNCContext.MachineUtilization.MachineUtilizationFromCNCMachine with {
    briefly "CNCMachine events feeding the MachineUtilization projection"
  }
  connector 'CycleTimeAnalytics Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToCycleTimeAnalytics to inlet CNCContext.CycleTimeAnalytics.CycleTimeAnalyticsFromCNCMachine with {
    briefly "CNCMachine events feeding the CycleTimeAnalytics projection"
  }
  connector 'OEEAnalytics Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToOEEAnalytics to inlet CNCContext.OEEAnalytics.OEEAnalyticsFromCNCMachine with {
    briefly "CNCMachine events feeding the OEEAnalytics projection"
  }
  connector 'AlarmAnalytics Feed' is from outlet CNCContext.CNCMachineEventSplit.CNCMachineEventSplitToAlarmAnalytics to inlet CNCContext.AlarmAnalytics.AlarmAnalyticsFromCNCMachine with {
    briefly "CNCMachine events feeding the AlarmAnalytics projection"
  }
  connector 'MachineUtilization Storage' is from outlet CNCContext.MachineUtilization.MachineUtilizationOut to inlet CNCContext.CNCRepository.CNCRepositoryFromMachineUtilization with {
    briefly "The MachineUtilization projection on its way to storage"
  }
  connector 'CycleTimeAnalytics Storage' is from outlet CNCContext.CycleTimeAnalytics.CycleTimeAnalyticsOut to inlet CNCContext.CNCRepository.CNCRepositoryFromCycleTimeAnalytics with {
    briefly "The CycleTimeAnalytics projection on its way to storage"
  }
  connector 'OEEAnalytics Storage' is from outlet CNCContext.OEEAnalytics.OEEAnalyticsOut to inlet CNCContext.CNCRepository.CNCRepositoryFromOEEAnalytics with {
    briefly "The OEEAnalytics projection on its way to storage"
  }
  connector 'AlarmAnalytics Storage' is from outlet CNCContext.AlarmAnalytics.AlarmAnalyticsOut to inlet CNCContext.CNCRepository.CNCRepositoryFromAlarmAnalytics with {
    briefly "The AlarmAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for CNC operations"
  described as {
    | The CNCContext is the bounded context for
    | CNC machine operations, monitoring, and analytics.
  }
}
