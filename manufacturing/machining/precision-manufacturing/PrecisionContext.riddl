// Precision Manufacturing - Precision Context
context PrecisionContext as router is {
  type ToCMMIntegrationCommand is one of {
    PrecisionPart.RecordCMMResult or PrecisionPart.UpdateInspectionPlan
  } with {
    briefly "What ToCMMIntegration turns its answers into"
  }
  inlet PrecisionContextFromToCMMIntegration is type ToCMMIntegrationCommand with {
    briefly "What ToCMMIntegration makes of the answers it gets"
  }
  connector 'ToCMMIntegration Intake' is from outlet PrecisionContext.ToCMMIntegration.ToCMMIntegrationToPrecisionContext to inlet PrecisionContext.PrecisionContextFromToCMMIntegration with {
    briefly "Answers translated by ToCMMIntegration, on their way in"
  }
  inlet PrecisionContextFromToCertificationService is command PrecisionPart.UpdateInspectionPlan with {
    briefly "What ToCertificationService makes of the answers it gets"
  }
  connector 'ToCertificationService Intake' is from outlet PrecisionContext.ToCertificationService.ToCertificationServiceToPrecisionContext to inlet PrecisionContext.PrecisionContextFromToCertificationService with {
    briefly "Answers translated by ToCertificationService, on their way in"
  }
  type ToGageCalibrationServiceCommand is one of {
    PrecisionPart.EvaluateTolerance or PrecisionPart.UpdateInspectionPlan
  } with {
    briefly "What ToGageCalibrationService turns its answers into"
  }
  inlet PrecisionContextFromToGageCalibrationService is type ToGageCalibrationServiceCommand with {
    briefly "What ToGageCalibrationService makes of the answers it gets"
  }
  connector 'ToGageCalibrationService Intake' is from outlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceToPrecisionContext to inlet PrecisionContext.PrecisionContextFromToGageCalibrationService with {
    briefly "Answers translated by ToGageCalibrationService, on their way in"
  }
  inlet PrecisionContextFromCMMIntegration is command PrecisionPart.RecordCMMResult with {
    briefly "What FromCMMIntegration makes of that service's news"
  }
  connector 'FromCMMIntegration Intake' is from outlet PrecisionContext.FromCMMIntegration.FromCMMIntegrationToPrecisionContext to inlet PrecisionContext.PrecisionContextFromCMMIntegration with {
    briefly "What FromCMMIntegration makes of that news, on its way in"
  }
  connector 'GageTracking Storage' is from outlet PrecisionContext.GageTracking.GageTrackingToRepository to inlet PrecisionContext.MeasurementRepository.MeasurementRepositoryFromGageTracking with {
    briefly "GageTracking messages on their way to MeasurementRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet PrecisionPartCommandStreamIn is type PrecisionPartCommand  outlet PrecisionPartCommandStreamOut is type PrecisionPartCommand
  inlet PrecisionPartResultStreamIn is result PrecisionPart.PrecisionPartResult  outlet PrecisionPartResultStreamOut is result PrecisionPart.PrecisionPartResult
  handler PrecisionContextBoundary is {
    on createInspectionPlan: command PrecisionPart.CreateInspectionPlan is {
      send createInspectionPlan to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on recordMeasurement: command PrecisionPart.RecordMeasurement is {
      send recordMeasurement to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on evaluateTolerance: command PrecisionPart.EvaluateTolerance is {
      send evaluateTolerance to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on initiateRework: command PrecisionPart.InitiateRework is {
      send initiateRework to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on scrapPart: command PrecisionPart.ScrapPart is {
      send scrapPart to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on certifyPart: command PrecisionPart.CertifyPart is {
      send certifyPart to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on recordCMMResult: command PrecisionPart.RecordCMMResult is {
      send recordCMMResult to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on updateInspectionPlan: command PrecisionPart.UpdateInspectionPlan is {
      send updateInspectionPlan to outlet PrecisionContext.PrecisionPartCommandStreamOut
    }
    on precisionPartResult: result PrecisionPart.PrecisionPartResult is {
      send precisionPartResult to outlet PrecisionContext.PrecisionPartResultStreamOut
    }
    on other is {
      error "Unexpected message at the PrecisionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PrecisionPartCommand Stream Intake' is from outlet PrecisionContext.PrecisionPartCommandStreamOut to inlet PrecisionContext.PrecisionPart.PrecisionPartCommands  connector 'PrecisionPartResult Stream Egress' is from outlet PrecisionContext.MeasurementRepository.MeasurementRepositoryResponses to inlet PrecisionContext.PrecisionPartResultStreamIn  adaptor FromCMMIntegration from context CMMIntegration as flow is { 
    inlet FromCMMIntegrationIn is type CMMIntegration.CMMIntegrationEvent    outlet FromCMMIntegrationToPrecisionContext is command PrecisionPart.RecordCMMResult
    handler FromCMMIntegrationHandler is {
      on cMMProgramCompleted: event CMMIntegration.CMMProgramCompleted is {
        let item0: type PrecisionPart.RecordCMMResult = prompt("translate the cMMProgramCompleted event into a RecordCMMResult, the CMM's measurements are what the part records")
        send item0 to outlet PrecisionContext.FromCMMIntegration.FromCMMIntegrationToPrecisionContext
      }
      on cMMProgramFailed: event CMMIntegration.CMMProgramFailed is {
        do "the CMM run failed; rerunning it is the operator's act"
      }
      on cMMProgramStarted: event CMMIntegration.CMMProgramStarted is {
        do "the CMM is measuring; the plan that asked for it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromCMMIntegration"
      }
    } with {
      briefly "from cmm integration"
      described as {
        |Carries messages from the external CMMIntegration.
      }
    }
  } with {
    briefly "CMMIntegration integration"
    described as {
      |The model's side of the CMMIntegration conversation.
    }
  }
  adaptor ToCMMIntegration to context CMMIntegration as router is { 
    outlet ToCMMIntegrationToPrecisionContext is type ToCMMIntegrationCommand
    inlet ToCMMIntegrationIn is type PrecisionPartEvent    inlet ToCMMIntegrationReplies is type CMMIntegration.CMMIntegrationReply    outlet ToCMMIntegrationOut is type CMMIntegration.CMMIntegrationRequest
    handler ToCMMIntegrationHandler is {
      on inspectionPlanUpdated: event PrecisionPart.InspectionPlanUpdated is {
        let askAnswer: type CMMIntegration.CMMProgramList = ask query CMMIntegration.GetCMMPrograms of context CMMIntegration
        do "a changed plan needing the programs available to run it"
        when prompt("the plan names no CMM program") then
          send command PrecisionPart.UpdateInspectionPlan(partId = inspectionPlanUpdated.partId, inspectionPlan = prompt("the plan naming the program in askAnswer.programs that runs it"), reason = prompt("CMM program assigned")) to outlet PrecisionContext.ToCMMIntegration.ToCMMIntegrationToPrecisionContext
        end
      }
      on cMMResultRecorded: event PrecisionPart.CMMResultRecorded is {
        let askAnswer: type CMMIntegration.CMMStatus = ask query CMMIntegration.GetCMMStatus of context CMMIntegration
        do "a result arriving being when the machine's own state matters"
        when prompt("askAnswer.cmmStatus casts doubt on the result") then
          send command PrecisionPart.RecordCMMResult(partId = cMMResultRecorded.partId, cmmResult = prompt("the result annotated with askAnswer.lastCalibration and askAnswer.cmmStatus")) to outlet PrecisionContext.ToCMMIntegration.ToCMMIntegrationToPrecisionContext
        end
      }
      on inspectionPlanCreated: event PrecisionPart.InspectionPlanCreated is {
        let item0: type CMMIntegration.ExecuteCMMProgram = prompt("translate the inspectionPlanCreated event into a ExecuteCMMProgram, the plan being the program the machine runs")
        send item0 to outlet PrecisionContext.ToCMMIntegration.ToCMMIntegrationOut
      }
      on other is {
        error "Unexpected message for adaptor ToCMMIntegration"
      }
    } with {
      briefly "to cmm integration"
      described as {
        |Carries messages to the external CMMIntegration.
      }
    }
  } with {
    briefly "CMMIntegration integration"
    described as {
      |The model's side of the CMMIntegration conversation.
    }
  }
  adaptor FromCertificationService from context CertificationService as sink is { 
    inlet FromCertificationServiceIn is type CertificationService.CertificationServiceEvent    handler FromCertificationServiceHandler is {
      on certificateCreated: event CertificationService.CertificateCreated is {
        do "the certificate exists; certifying was recorded here"
      }
      on certificationRevoked: event CertificationService.CertificationRevoked is {
        do "the certification is withdrawn; scrapping was recorded here"
      }
      on certificationValidated: event CertificationService.CertificationValidated is {
        do "the certification checks out; a quality engineer signs the part off"
      }
      on other is {
        error "Unexpected message for adaptor FromCertificationService"
      }
    } with {
      briefly "from certification service"
      described as {
        |Carries messages from the external CertificationService.
      }
    }
  } with {
    briefly "CertificationService integration"
    described as {
      |The model's side of the CertificationService conversation.
    }
  }
  adaptor ToCertificationService to context CertificationService as router is { 
    outlet ToCertificationServiceToPrecisionContext is command PrecisionPart.UpdateInspectionPlan
    inlet ToCertificationServiceIn is type PrecisionPartEvent    inlet ToCertificationServiceReplies is type CertificationService.CertificationServiceReply    outlet ToCertificationServiceOut is type CertificationService.CertificationServiceCommand
    handler ToCertificationServiceHandler is {
      on inspectionPlanCreated: event PrecisionPart.InspectionPlanCreated is {
        let askAnswer: type CertificationService.ComplianceStandards = ask query CertificationService.GetComplianceStandards of context CertificationService
        do "and which standards it is written against"
        send command PrecisionPart.UpdateInspectionPlan(partId = inspectionPlanCreated.partId, inspectionPlan = prompt("the plan written against askAnswer.standards"), reason = prompt("compliance standards applied")) to outlet PrecisionContext.ToCertificationService.ToCertificationServiceToPrecisionContext
        let askAnswer: type CertificationService.CertificateRequirements = ask query CertificationService.GetCertificateRequirements of context CertificationService
        do "the plan needing to know what the certificate will have to show"
        send command PrecisionPart.UpdateInspectionPlan(partId = inspectionPlanCreated.partId, inspectionPlan = prompt("the plan extended with askAnswer.requiredMeasurements and askAnswer.requiredDocuments"), reason = prompt("certificate requirements applied")) to outlet PrecisionContext.ToCertificationService.ToCertificationServiceToPrecisionContext
      }
      on partCertified: event PrecisionPart.PartCertified is {
        let item0: type CertificationService.CreateCertificate = prompt("translate the partCertified event into a CreateCertificate, certification being what a certificate records")
        send item0 to outlet PrecisionContext.ToCertificationService.ToCertificationServiceOut
      }
      on toleranceEvaluated: event PrecisionPart.ToleranceEvaluated is {
        let item0: type CertificationService.ValidateCertification = prompt("translate the toleranceEvaluated event into a ValidateCertification, an evaluation being what a certificate is checked against")
        send item0 to outlet PrecisionContext.ToCertificationService.ToCertificationServiceOut
      }
      on partScrapped: event PrecisionPart.PartScrapped is {
        let item0: type CertificationService.RevokeCertification = prompt("translate the partScrapped event into a RevokeCertification, scrapping being what invalidates one")
        send item0 to outlet PrecisionContext.ToCertificationService.ToCertificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCertificationService"
      }
    } with {
      briefly "to certification service"
      described as {
        |Carries messages to the external CertificationService.
      }
    }
  } with {
    briefly "CertificationService integration"
    described as {
      |The model's side of the CertificationService conversation.
    }
  }
  adaptor FromGageCalibrationService from context GageCalibrationService as sink is { 
    inlet FromGageCalibrationServiceIn is type GageCalibrationService.GageCalibrationServiceEvent    handler FromGageCalibrationServiceHandler is {
      on calibrationRecorded: event GageCalibrationService.CalibrationRecorded is {
        do "the calibration is on record; the measurement was recorded here"
      }
      on calibrationScheduled: event GageCalibrationService.CalibrationScheduled is {
        do "the calibration is booked; the plan was recorded here"
      }
      on gageOutOfCalibration: event GageCalibrationService.GageOutOfCalibration is {
        do "a gage is out of calibration; which measurements to repeat is the inspector's call"
      }
      on other is {
        error "Unexpected message for adaptor FromGageCalibrationService"
      }
    } with {
      briefly "from gage calibration service"
      described as {
        |Carries messages from the external GageCalibrationService.
      }
    }
  } with {
    briefly "GageCalibrationService integration"
    described as {
      |The model's side of the GageCalibrationService conversation.
    }
  }
  adaptor ToGageCalibrationService to context GageCalibrationService as router is { 
    outlet ToGageCalibrationServiceToPrecisionContext is type ToGageCalibrationServiceCommand
    inlet ToGageCalibrationServiceIn is type PrecisionPartEvent    inlet ToGageCalibrationServiceReplies is type GageCalibrationService.GageCalibrationServiceReply    outlet ToGageCalibrationServiceOut is type GageCalibrationService.GageCalibrationServiceCommand
    handler ToGageCalibrationServiceHandler is {
      on inspectionPlanCreated: event PrecisionPart.InspectionPlanCreated is {
        let askAnswer: type GageCalibrationService.CalibrationsDueList = ask query GageCalibrationService.GetCalibrationsDue of context GageCalibrationService
        do "and whether the gauges it names are still in date"
        when prompt("askAnswer.gages names a gauge the plan uses") then
          send command PrecisionPart.UpdateInspectionPlan(partId = inspectionPlanCreated.partId, inspectionPlan = prompt("the plan with the gauges in askAnswer.gages replaced by ones in date"), reason = prompt("gauges due for calibration")) to outlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceToPrecisionContext
        end
        let item0: type GageCalibrationService.ScheduleCalibration = prompt("translate the inspectionPlanCreated event into a ScheduleCalibration, a plan being worthless measured with gauges out of calibration")
        send item0 to outlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceOut
      }
      on measurementRecorded: event PrecisionPart.MeasurementRecorded is {
        let askAnswer: type GageCalibrationService.GageCalibrationStatus = ask query GageCalibrationService.GetGageCalibration of context GageCalibrationService
        do "each measurement being only as good as the gauge that took it"
        when prompt("askAnswer.nextCalibrationDue has passed") then
          send command PrecisionPart.EvaluateTolerance(partId = measurementRecorded.partId, featureId = prompt("the feature measured"), evaluatedBy = prompt("the gage calibration service")) to outlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceToPrecisionContext
        end
        let item0: type GageCalibrationService.RecordCalibration = prompt("translate the measurementRecorded event into a RecordCalibration, each measurement being what a gauge's drift is judged from")
        send item0 to outlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToGageCalibrationService"
      }
    } with {
      briefly "to gage calibration service"
      described as {
        |Carries messages to the external GageCalibrationService.
      }
    }
  } with {
    briefly "GageCalibrationService integration"
    described as {
      |The model's side of the GageCalibrationService conversation.
    }
  }
  include "types.riddl"
  include "PrecisionPart.riddl"
  // Repository for measurement and certification persistence
  type MeasurementRepositoryCommand is one of {
    PrecisionContext.MeasurementRepository.PersistCMMResultRecorded or PrecisionContext.MeasurementRepository.PersistInspectionPlanCreated or PrecisionContext.MeasurementRepository.PersistInspectionPlanUpdated or PrecisionContext.MeasurementRepository.PersistMeasurementRecorded or PrecisionContext.MeasurementRepository.PersistPartCertified or PrecisionContext.MeasurementRepository.PersistPartScrapped or PrecisionContext.MeasurementRepository.PersistReworkInitiated or PrecisionContext.MeasurementRepository.PersistToleranceEvaluated
  } with {
    briefly "Anything that writes MeasurementRepository"
    described as {
      |The persistence commands MeasurementRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MeasurementRepository as merge is {
    inlet MeasurementRepositoryFromGageTracking is type MeasurementRepositoryCommand with {
      briefly "What GageTracking sends MeasurementRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet MeasurementRepositoryFromSPCAnalytics is type MeasurementRepositoryCommand    command PersistInspectionPlanCreated is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionPlanCreated applies to.
        }
      }
    } with {
      briefly "Persist InspectionPlanCreated"
      described as {
        |Instructs this repository to apply InspectionPlanCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInspectionPlanUpdated is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionPlanUpdated applies to.
        }
      }
    } with {
      briefly "Persist InspectionPlanUpdated"
      described as {
        |Instructs this repository to apply InspectionPlanUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCMMResultRecorded is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row CMMResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist CMMResultRecorded"
      described as {
        |Instructs this repository to apply CMMResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMeasurementRecorded is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row MeasurementRecorded applies to.
        }
      }
    } with {
      briefly "Persist MeasurementRecorded"
      described as {
        |Instructs this repository to apply MeasurementRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPartCertified is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row PartCertified applies to.
        }
      }
    } with {
      briefly "Persist PartCertified"
      described as {
        |Instructs this repository to apply PartCertified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPartScrapped is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row PartScrapped applies to.
        }
      }
    } with {
      briefly "Persist PartScrapped"
      described as {
        |Instructs this repository to apply PartScrapped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReworkInitiated is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReworkInitiated applies to.
        }
      }
    } with {
      briefly "Persist ReworkInitiated"
      described as {
        |Instructs this repository to apply ReworkInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistToleranceEvaluated is {
      partId: PartId with {
        briefly "Row addressed"
        described as {
          |Which stored row ToleranceEvaluated applies to.
        }
      }
    } with {
      briefly "Persist ToleranceEvaluated"
      described as {
        |Instructs this repository to apply ToleranceEvaluated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MeasurementRepositoryResponses is result PrecisionPart.PrecisionPartResult
    record StoredPrecisionPart is {
      precisionPartId: UUID with {
        briefly "precisionPartId"
        described as {
          |The precisionPartId column of the stored precisionPart row.
        }
      }
      certification: CertificationInfo with {
        briefly "certification"
        described as {
          |The certification column of the stored precisionPart row.
        }
      }
      partId: PartId with {
        briefly "partId"
        described as {
          |The partId column of the stored precisionPart row.
        }
      }
    } with {
      briefly "Stored precisionPart row"
      described as {
        |The persistence shape of precisionPart data as this repository stores it.
      }
    }
    schema MeasurementData is relational
      of measurements as record StoredPrecisionPart
        index on field StoredPrecisionPart.partId
        index on field StoredPrecisionPart.status
        index on field StoredPrecisionPart.certification.certificationNumber
 with {
      briefly "Measurement data schema"
      described as {
        |The relational schema holding measurement data for the MeasurementRepository.
      }
    }
    handler MeasurementPersistence is {
      on persistInspectionPlanCreated: command PersistInspectionPlanCreated is {
        do "apply InspectionPlanCreated to the stored row"
      }
      on persistInspectionPlanUpdated: command PersistInspectionPlanUpdated is {
        do "apply InspectionPlanUpdated to the stored row"
      }
      on persistCMMResultRecorded: command PersistCMMResultRecorded is {
        do "apply CMMResultRecorded to the stored row"
      }
      on persistMeasurementRecorded: command PersistMeasurementRecorded is {
        do "apply MeasurementRecorded to the stored row"
      }
      on persistPartCertified: command PersistPartCertified is {
        do "apply PartCertified to the stored row"
      }
      on persistPartScrapped: command PersistPartScrapped is {
        do "apply PartScrapped to the stored row"
      }
      on persistReworkInitiated: command PersistReworkInitiated is {
        do "apply ReworkInitiated to the stored row"
      }
      on persistToleranceEvaluated: command PersistToleranceEvaluated is {
        do "apply ToleranceEvaluated to the stored row"
      }
      on query GetSPCChartData is {
        let sPCChartDataView: type SPCChartDataView = prompt("read the spc chart data projection")
        reply sPCChartDataView
      }
      on query GetCapabilityTrend is {
        let capabilityTrendView: type CapabilityTrendView = prompt("read the capability trend projection")
        reply capabilityTrendView
      }
      on query GetToleranceSummary is {
        let theToleranceSummaryView: type ToleranceSummaryView = prompt("read the tolerance summary projection")
        reply theToleranceSummaryView
      }
      on query GetGageUsageStats is {
        let gageUsageStatsView: type GageUsageStatsView = prompt("read the gage usage stats projection")
        reply gageUsageStatsView
      }
    } with {
      briefly "Persists measurement commands"
      described as {
        |Handles command-driven persistence for measurements.
      }
    }
  } with {
    briefly "Measurement data persistence"
    described as {
      | The MeasurementRepository provides persistent storage for
      | measurements, CMM results, and certification records.
    }
  }
  // Projector for SPC and process capability analytics
  query GetSPCChartData replies result SPCChartDataView is {
    sPCChartDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which spc chart data to retrieve.
      }
    }
  } with {
    briefly "Get spc chart data"
    described as {
      |Retrieves the spc chart data projection.
    }
  }
  result SPCChartDataView is {
    sPCChartData: SPCAnalytics.SPCChartData with {
      briefly "Spc chart data"
      described as {
        |The spc chart data being returned.
      }
    }
  } with {
    briefly "Spc chart data view"
    described as {
      |Read model view carrying the spc chart data projection.
    }
  }
  query GetCapabilityTrend replies result CapabilityTrendView is {
    capabilityTrendKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which capability trend to retrieve.
      }
    }
  } with {
    briefly "Get capability trend"
    described as {
      |Retrieves the capability trend projection.
    }
  }
  result CapabilityTrendView is {
    capabilityTrend: SPCAnalytics.CapabilityTrend with {
      briefly "Capability trend"
      described as {
        |The capability trend being returned.
      }
    }
  } with {
    briefly "Capability trend view"
    described as {
      |Read model view carrying the capability trend projection.
    }
  }
  query GetToleranceSummary replies result ToleranceSummaryView is {
    toleranceSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which tolerance summary to retrieve.
      }
    }
  } with {
    briefly "Get tolerance summary"
    described as {
      |Retrieves the tolerance summary projection.
    }
  }
  result ToleranceSummaryView is {
    toleranceSummary: SPCAnalytics.ToleranceSummary with {
      briefly "Tolerance summary"
      described as {
        |The tolerance summary being returned.
      }
    }
  } with {
    briefly "Tolerance summary view"
    described as {
      |Read model view carrying the tolerance summary projection.
    }
  }
  projector SPCAnalytics as flow is {
    updates repository PrecisionContext.MeasurementRepository
    outlet SPCAnalyticsToRepository is type MeasurementRepositoryCommand
    inlet SPCAnalyticsFromPrecisionPart is type PrecisionPartEvent    record SPCChartData is {
      featureId: FeatureId with {
        briefly "Feature"
        described as {
          |Feature being tracked.
        }
      }
      chartType: String(1,50) with {
        briefly "Chart type"
        described as {
          |SPC chart type (X-bar, R, etc.).
        }
      }
      ucl: Decimal(15,6) with {
        briefly "UCL"
        described as {
          |Upper control limit.
        }
      }
      lcl: Decimal(15,6) with {
        briefly "LCL"
        described as {
          |Lower control limit.
        }
      }
      centerLine: Decimal(15,6) with {
        briefly "Center"
        described as {
          |Center line.
        }
      }
      dataPoints: Decimal(15,6)+ with {
        briefly "Points"
        described as {
          |Data points.
        }
      }
      isInControl: Boolean with {
        briefly "In control"
        described as {
          |Whether process is in control.
        }
      }
      outOfControlPoints: Natural with {
        briefly "OOC points"
        described as {
          |Count of out-of-control points.
        }
      }
    } with {
      briefly "SPC chart data"
      described as {
        |Statistical process control chart.
      }
    }
    record CapabilityTrend is {
      featureId: FeatureId with {
        briefly "Feature"
        described as {
          |Feature being tracked.
        }
      }
      cpkHistory: Decimal(6,4)+ with {
        briefly "Cpk history"
        described as {
          |Historical Cpk values.
        }
      }
      ppkHistory: Decimal(6,4)+ with {
        briefly "Ppk history"
        described as {
          |Historical Ppk values.
        }
      }
      timestamps: TimeStamp+ with {
        briefly "Timestamps"
        described as {
          |Calculation timestamps.
        }
      }
      trend: String(1,20) with {
        briefly "Trend"
        described as {
          |Trend direction (improving, stable, degrading).
        }
      }
      lastCalculated: TimeStamp with {
        briefly "Last calculated"
        described as {
          |Last calculation time.
        }
      }
    } with {
      briefly "Capability trend"
      described as {
        |Process capability trend data.
      }
    }
    record ToleranceSummary is {
      totalFeatures: Natural with {
        briefly "Total"
        described as {
          |Total features inspected.
        }
      }
      inTolerance: Natural with {
        briefly "In tolerance"
        described as {
          |Features in tolerance.
        }
      }
      outOfTolerance: Natural with {
        briefly "Out of tolerance"
        described as {
          |Features out of tolerance.
        }
      }
      firstPassYield: Decimal(5,4) with {
        briefly "FPY"
        described as {
          |First pass yield.
        }
      }
      reworkRate: Decimal(5,4) with {
        briefly "Rework rate"
        described as {
          |Rework percentage.
        }
      }
      scrapRate: Decimal(5,4) with {
        briefly "Scrap rate"
        described as {
          |Scrap percentage.
        }
      }
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
    } with {
      briefly "Tolerance summary"
      described as {
        |Summary of tolerance performance.
      }
    }
    handler SPCHandler is {
      on inspectionPlanCreated: event PrecisionPart.InspectionPlanCreated is {
        tell command PrecisionContext.MeasurementRepository.PersistInspectionPlanCreated(partId = inspectionPlanCreated.partId) to repository PrecisionContext.MeasurementRepository
        do "apply InspectionPlanCreated to the SPCAnalytics projection"
      }
      on inspectionPlanUpdated: event PrecisionPart.InspectionPlanUpdated is {
        tell command PrecisionContext.MeasurementRepository.PersistInspectionPlanUpdated(partId = inspectionPlanUpdated.partId) to repository PrecisionContext.MeasurementRepository
        do "apply InspectionPlanUpdated to the SPCAnalytics projection"
      }
      on measurementRecorded: event PrecisionPart.MeasurementRecorded is {
        tell command PrecisionContext.MeasurementRepository.PersistMeasurementRecorded(partId = measurementRecorded.partId) to repository PrecisionContext.MeasurementRepository
        do "Update SPC chart data points"
      }
      on toleranceEvaluated: event PrecisionPart.ToleranceEvaluated is {
        tell command PrecisionContext.MeasurementRepository.PersistToleranceEvaluated(partId = toleranceEvaluated.partId) to repository PrecisionContext.MeasurementRepository
        do "Recalculate control limits and capability"
      }
      on cMMResultRecorded: event PrecisionPart.CMMResultRecorded is {
        tell command PrecisionContext.MeasurementRepository.PersistCMMResultRecorded(partId = cMMResultRecorded.partId) to repository PrecisionContext.MeasurementRepository
        do "Batch update SPC from CMM data"
      }
      on partCertified: event PrecisionPart.PartCertified is {
        tell command PrecisionContext.MeasurementRepository.PersistPartCertified(partId = partCertified.partId) to repository PrecisionContext.MeasurementRepository
        do "Update yield and certification metrics"
      }
      on reworkInitiated: event PrecisionPart.ReworkInitiated is {
        tell command PrecisionContext.MeasurementRepository.PersistReworkInitiated(partId = reworkInitiated.partId) to repository PrecisionContext.MeasurementRepository
        do "Update rework rate metrics"
      }
      on partScrapped: event PrecisionPart.PartScrapped is {
        tell command PrecisionContext.MeasurementRepository.PersistPartScrapped(partId = partScrapped.partId) to repository PrecisionContext.MeasurementRepository
        do "Update scrap rate metrics"
      }
    } with {
      briefly "Maintains SPC analytics"
      described as {
        |Projects events into SPC charts and capability metrics.
      }
    }
  } with {
    briefly "SPC and capability analytics"
    described as {
      | Maintains statistical process control charts, Cpk/Ppk
      | calculations, and tolerance trend analysis.
    }
  }
  // Projector for gage tracking and calibration
  query GetGageUsageStats replies result GageUsageStatsView is {
    gageUsageStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which gage usage stats to retrieve.
      }
    }
  } with {
    briefly "Get gage usage stats"
    described as {
      |Retrieves the gage usage stats projection.
    }
  }
  result GageUsageStatsView is {
    gageUsageStats: GageTracking.GageUsageStats with {
      briefly "Gage usage stats"
      described as {
        |The gage usage stats being returned.
      }
    }
  } with {
    briefly "Gage usage stats view"
    described as {
      |Read model view carrying the gage usage stats projection.
    }
  }
  projector GageTracking as flow is {
    updates repository PrecisionContext.MeasurementRepository
    outlet GageTrackingToRepository is type MeasurementRepositoryCommand
 with {
      briefly "What GageTracking publishes to MeasurementRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to MeasurementRepository needs this port to travel on.
      }
    }
    inlet GageTrackingFromPrecisionPart is type PrecisionPartEvent    record GageUsageStats is {
      gageId: GageId with {
        briefly "Gage"
        described as {
          |Gage identifier.
        }
      }
      measurementCount: Natural with {
        briefly "Count"
        described as {
          |Total measurements taken.
        }
      }
      lastUsed: TimeStamp with {
        briefly "Last used"
        described as {
          |Last usage time.
        }
      }
      daysUntilCalibration: Integer with {
        briefly "Days"
        described as {
          |Days until calibration due.
        }
      }
      needsCalibration: Boolean with {
        briefly "Needs cal"
        described as {
          |Whether calibration is due soon.
        }
      }
    } with {
      briefly "Gage usage statistics"
      described as {
        |Tracking of gage usage and calibration status.
      }
    }
    handler GageTrackingHandler is {
      on inspectionPlanCreated: event PrecisionPart.InspectionPlanCreated is {
        tell command PrecisionContext.MeasurementRepository.PersistInspectionPlanCreated(partId = inspectionPlanCreated.partId) to repository PrecisionContext.MeasurementRepository
        do "apply InspectionPlanCreated to the GageTracking projection"
      }
      on inspectionPlanUpdated: event PrecisionPart.InspectionPlanUpdated is {
        tell command PrecisionContext.MeasurementRepository.PersistInspectionPlanUpdated(partId = inspectionPlanUpdated.partId) to repository PrecisionContext.MeasurementRepository
        do "apply InspectionPlanUpdated to the GageTracking projection"
      }
      on partCertified: event PrecisionPart.PartCertified is {
        tell command PrecisionContext.MeasurementRepository.PersistPartCertified(partId = partCertified.partId) to repository PrecisionContext.MeasurementRepository
        do "apply PartCertified to the GageTracking projection"
      }
      on partScrapped: event PrecisionPart.PartScrapped is {
        tell command PrecisionContext.MeasurementRepository.PersistPartScrapped(partId = partScrapped.partId) to repository PrecisionContext.MeasurementRepository
        do "apply PartScrapped to the GageTracking projection"
      }
      on reworkInitiated: event PrecisionPart.ReworkInitiated is {
        tell command PrecisionContext.MeasurementRepository.PersistReworkInitiated(partId = reworkInitiated.partId) to repository PrecisionContext.MeasurementRepository
        do "apply ReworkInitiated to the GageTracking projection"
      }
      on toleranceEvaluated: event PrecisionPart.ToleranceEvaluated is {
        tell command PrecisionContext.MeasurementRepository.PersistToleranceEvaluated(partId = toleranceEvaluated.partId) to repository PrecisionContext.MeasurementRepository
        do "apply ToleranceEvaluated to the GageTracking projection"
      }
      on measurementRecorded: event PrecisionPart.MeasurementRecorded is {
        tell command PrecisionContext.MeasurementRepository.PersistMeasurementRecorded(partId = measurementRecorded.partId) to repository PrecisionContext.MeasurementRepository
        do "Update gage usage count and last used"
      }
      on cMMResultRecorded: event PrecisionPart.CMMResultRecorded is {
        tell command PrecisionContext.MeasurementRepository.PersistCMMResultRecorded(partId = cMMResultRecorded.partId) to repository PrecisionContext.MeasurementRepository
        do "Update CMM usage statistics"
      }
    } with {
      briefly "Tracks gage usage"
      described as {
        |Projects measurement events into gage usage statistics.
      }
    }
  } with {
    briefly "Gage tracking projections"
    described as {
      |Tracks gage usage and calibration status.
    }
  }
  // ---- Event publication for PrecisionPart ----
  type PrecisionPartEvent is one of {
    PrecisionContext.PrecisionPart.InspectionPlanCreated or PrecisionContext.PrecisionPart.MeasurementRecorded or PrecisionContext.PrecisionPart.ToleranceEvaluated or PrecisionContext.PrecisionPart.ReworkInitiated or PrecisionContext.PrecisionPart.PartScrapped or PrecisionContext.PrecisionPart.PartCertified or PrecisionContext.PrecisionPart.CMMResultRecorded or PrecisionContext.PrecisionPart.InspectionPlanUpdated
  } with {
    briefly "PrecisionPart event alternation"
    described as {
      |Union of all PrecisionPart events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet PrecisionPartEventSplit as split is {
    outlet PrecisionPartEventSplitToToGageCalibrationService is type PrecisionPartEvent
    outlet PrecisionPartEventSplitToToCertificationService is type PrecisionPartEvent
    outlet PrecisionPartEventSplitToToCMMIntegration is type PrecisionPartEvent
    inlet PrecisionPartEventSplitIn is type PrecisionPartEvent    outlet PrecisionPartEventSplitToSPCAnalytics is type PrecisionPartEvent
    outlet PrecisionPartEventSplitToGageTracking is type PrecisionPartEvent
    handler PrecisionPartEventSplitHandler is {
      on inspectionPlanCreated: event PrecisionPart.InspectionPlanCreated is {
        send inspectionPlanCreated to outlet PrecisionPartEventSplitToSPCAnalytics
        send inspectionPlanCreated to outlet PrecisionPartEventSplitToGageTracking
        send inspectionPlanCreated to outlet PrecisionPartEventSplitToToGageCalibrationService
        send inspectionPlanCreated to outlet PrecisionPartEventSplitToToCertificationService
        send inspectionPlanCreated to outlet PrecisionPartEventSplitToToCMMIntegration
        tell inspectionPlanCreated to entity PrecisionContext.PrecisionPart
      }
      on measurementRecorded: event PrecisionPart.MeasurementRecorded is {
        send measurementRecorded to outlet PrecisionPartEventSplitToSPCAnalytics
        send measurementRecorded to outlet PrecisionPartEventSplitToGageTracking
        send measurementRecorded to outlet PrecisionPartEventSplitToToGageCalibrationService
        tell measurementRecorded to entity PrecisionContext.PrecisionPart
      }
      on toleranceEvaluated: event PrecisionPart.ToleranceEvaluated is {
        send toleranceEvaluated to outlet PrecisionPartEventSplitToSPCAnalytics
        send toleranceEvaluated to outlet PrecisionPartEventSplitToGageTracking
        send toleranceEvaluated to outlet PrecisionPartEventSplitToToCertificationService
        tell toleranceEvaluated to entity PrecisionContext.PrecisionPart
      }
      on reworkInitiated: event PrecisionPart.ReworkInitiated is {
        send reworkInitiated to outlet PrecisionPartEventSplitToSPCAnalytics
        send reworkInitiated to outlet PrecisionPartEventSplitToGageTracking
        tell reworkInitiated to entity PrecisionContext.PrecisionPart
      }
      on partScrapped: event PrecisionPart.PartScrapped is {
        send partScrapped to outlet PrecisionPartEventSplitToSPCAnalytics
        send partScrapped to outlet PrecisionPartEventSplitToGageTracking
        send partScrapped to outlet PrecisionPartEventSplitToToCertificationService
        tell partScrapped to entity PrecisionContext.PrecisionPart
      }
      on partCertified: event PrecisionPart.PartCertified is {
        send partCertified to outlet PrecisionPartEventSplitToSPCAnalytics
        send partCertified to outlet PrecisionPartEventSplitToGageTracking
        send partCertified to outlet PrecisionPartEventSplitToToCertificationService
        tell partCertified to entity PrecisionContext.PrecisionPart
      }
      on cMMResultRecorded: event PrecisionPart.CMMResultRecorded is {
        send cMMResultRecorded to outlet PrecisionPartEventSplitToSPCAnalytics
        send cMMResultRecorded to outlet PrecisionPartEventSplitToGageTracking
        send cMMResultRecorded to outlet PrecisionPartEventSplitToToCMMIntegration
        tell cMMResultRecorded to entity PrecisionContext.PrecisionPart
      }
      on inspectionPlanUpdated: event PrecisionPart.InspectionPlanUpdated is {
        send inspectionPlanUpdated to outlet PrecisionPartEventSplitToSPCAnalytics
        send inspectionPlanUpdated to outlet PrecisionPartEventSplitToGageTracking
        send inspectionPlanUpdated to outlet PrecisionPartEventSplitToToCMMIntegration
        tell inspectionPlanUpdated to entity PrecisionContext.PrecisionPart
      }
      on other is {
        error "Unexpected message for processor PrecisionPartEventSplit"
      }
    } with {
      briefly "PrecisionPart event fan-out handler"
      described as {
        |Delivers each PrecisionPart event to all of its consumers.
      }
    }
  } with {
    briefly "PrecisionPart event fan-out"
    described as {
      |Fans PrecisionPart events out to the repository and projectors.
    }
  }
  connector 'ToGageCalibrationService Feed' is from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToToGageCalibrationService to inlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceIn with {
    briefly "The PrecisionPart events ToGageCalibrationService translates, on their way to it"
  }
  connector 'ToCertificationService Feed' is from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToToCertificationService to inlet PrecisionContext.ToCertificationService.ToCertificationServiceIn with {
    briefly "The PrecisionPart events ToCertificationService translates, on their way to it"
  }
  connector 'ToCMMIntegration Feed' is from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToToCMMIntegration to inlet PrecisionContext.ToCMMIntegration.ToCMMIntegrationIn with {
    briefly "The PrecisionPart events ToCMMIntegration translates, on their way to it"
  }
  connector 'PrecisionPartEvent Stream' is from outlet PrecisionContext.PrecisionPart.PrecisionPartEvents2 to inlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitIn with {
    briefly "PrecisionPart events, fanned out to storage and read models"
  }
  connector 'SPCAnalytics Feed' is from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToSPCAnalytics to inlet PrecisionContext.SPCAnalytics.SPCAnalyticsFromPrecisionPart with {
    briefly "PrecisionPart events feeding the SPCAnalytics projection"
  }
  connector 'GageTracking Feed' is from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToGageTracking to inlet PrecisionContext.GageTracking.GageTrackingFromPrecisionPart with {
    briefly "PrecisionPart events feeding the GageTracking projection"
  }
  connector 'SPCAnalytics Storage' is from outlet PrecisionContext.SPCAnalytics.SPCAnalyticsToRepository to inlet PrecisionContext.MeasurementRepository.MeasurementRepositoryFromSPCAnalytics with {
    briefly "SPCAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for precision manufacturing"
  described as {
    | The PrecisionContext is the bounded context for
    | precision measurement, SPC analysis, and certification.
  }
}
