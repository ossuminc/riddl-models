// Precision Manufacturing - Precision Context
context PrecisionContext is {
  include "types.riddl"
  include "PrecisionPart.riddl"
  // Repository for measurement and certification persistence
  repository MeasurementRepository is {
    inlet MeasurementRepositoryFromPrecisionPart is type PrecisionPartEvent
    inlet MeasurementRepositoryFromSPCAnalytics is type PrecisionPartEvent
    inlet MeasurementRepositoryFromGageTracking is type PrecisionPartEvent
    outlet MeasurementRepositoryResponses is type PrecisionPart.PrecisionPartResult
    schema MeasurementData is relational
      of measurements as type PrecisionPart
        index on field PrecisionPart.partId
        index on field PrecisionPart.status
        index on field PrecisionPart.certification.certificationNumber

    handler MeasurementPersistence is {
      on command PrecisionPart.CreateInspectionPlan is {
        tell event PrecisionPart.InspectionPlanCreated to entity PrecisionContext.PrecisionPart
        do "Store new inspection plan"
      }
      on command PrecisionPart.RecordMeasurement is {
        tell event PrecisionPart.MeasurementRecorded to entity PrecisionContext.PrecisionPart
        do "Store measurement record"
      }
      on command PrecisionPart.EvaluateTolerance is {
        do "Update tolerance evaluation"
      }
      on command PrecisionPart.RecordCMMResult is {
        tell event PrecisionPart.CMMResultRecorded to entity PrecisionContext.PrecisionPart
        do "Store CMM inspection result"
      }
      on command PrecisionPart.UpdateInspectionPlan is {
        tell event PrecisionPart.InspectionPlanUpdated to entity PrecisionContext.PrecisionPart
        do "Update inspection plan"
      }
      on command PrecisionPart.InitiateRework is {
        tell event PrecisionPart.ReworkInitiated to entity PrecisionContext.PrecisionPart
        do "Update to rework status"
      }
      on command PrecisionPart.ScrapPart is {
        do "Update to scrapped status"
      }
      on command PrecisionPart.CertifyPart is {
        do "Store certification record"
      }
    } with {
      briefly "Persists measurement commands"
      described as {
        |Handles command-driven persistence for measurements.
      }
    }
  } with {
    briefly "Measurement data persistence"
    described as {
      | The MeasurementRepository provides persistent storage for
      | measurements, CMM results, and certification records.
    }
  }
  // Projector for SPC and process capability analytics
  projector SPCAnalytics is {
    inlet SPCAnalyticsFromPrecisionPart is type PrecisionPartEvent
    outlet SPCAnalyticsOut is type PrecisionPartEvent
    updates repository PrecisionContext.MeasurementRepository
    record SPCChartData is  {
      featureId: FeatureId with {
        briefly "Feature"
        described as {
          |Feature being tracked.
        }
      }
      chartType: String(1,50) with {
        briefly "Chart type"
        described as {
          |SPC chart type (X-bar, R, etc.).
        }
      }
      ucl: Decimal(15,6) with {
        briefly "UCL"
        described as {
          |Upper control limit.
        }
      }
      lcl: Decimal(15,6) with {
        briefly "LCL"
        described as {
          |Lower control limit.
        }
      }
      centerLine: Decimal(15,6) with {
        briefly "Center"
        described as {
          |Center line.
        }
      }
      dataPoints: Decimal(15,6)+ with {
        briefly "Points"
        described as {
          |Data points.
        }
      }
      isInControl: Boolean with {
        briefly "In control"
        described as {
          |Whether process is in control.
        }
      }
      outOfControlPoints: Natural with {
        briefly "OOC points"
        described as {
          |Count of out-of-control points.
        }
      }
    } with {
      briefly "SPC chart data"
      described as {
        |Statistical process control chart.
      }
    }
    record CapabilityTrend is  {
      featureId: FeatureId with {
        briefly "Feature"
        described as {
          |Feature being tracked.
        }
      }
      cpkHistory: Decimal(6,4)+ with {
        briefly "Cpk history"
        described as {
          |Historical Cpk values.
        }
      }
      ppkHistory: Decimal(6,4)+ with {
        briefly "Ppk history"
        described as {
          |Historical Ppk values.
        }
      }
      timestamps: TimeStamp+ with {
        briefly "Timestamps"
        described as {
          |Calculation timestamps.
        }
      }
      trend: String(1,20) with {
        briefly "Trend"
        described as {
          |Trend direction (improving, stable, degrading).
        }
      }
      lastCalculated: TimeStamp with {
        briefly "Last calculated"
        described as {
          |Last calculation time.
        }
      }
    } with {
      briefly "Capability trend"
      described as {
        |Process capability trend data.
      }
    }
    record ToleranceSummary is  {
      totalFeatures: Natural with {
        briefly "Total"
        described as {
          |Total features inspected.
        }
      }
      inTolerance: Natural with {
        briefly "In tolerance"
        described as {
          |Features in tolerance.
        }
      }
      outOfTolerance: Natural with {
        briefly "Out of tolerance"
        described as {
          |Features out of tolerance.
        }
      }
      firstPassYield: Decimal(5,4) with {
        briefly "FPY"
        described as {
          |First pass yield.
        }
      }
      reworkRate: Decimal(5,4) with {
        briefly "Rework rate"
        described as {
          |Rework percentage.
        }
      }
      scrapRate: Decimal(5,4) with {
        briefly "Scrap rate"
        described as {
          |Scrap percentage.
        }
      }
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
    } with {
      briefly "Tolerance summary"
      described as {
        |Summary of tolerance performance.
      }
    }
    handler SPCHandler is {
      on event PrecisionPart.MeasurementRecorded is {
        tell event PrecisionPart.MeasurementRecorded to repository PrecisionContext.MeasurementRepository
        do "Update SPC chart data points"
      }
      on event PrecisionPart.ToleranceEvaluated is {
        tell event PrecisionPart.ToleranceEvaluated to repository PrecisionContext.MeasurementRepository
        do "Recalculate control limits and capability"
      }
      on event PrecisionPart.CMMResultRecorded is {
        tell event PrecisionPart.CMMResultRecorded to repository PrecisionContext.MeasurementRepository
        do "Batch update SPC from CMM data"
      }
      on event PrecisionPart.PartCertified is {
        tell event PrecisionPart.PartCertified to repository PrecisionContext.MeasurementRepository
        do "Update yield and certification metrics"
      }
      on event PrecisionPart.ReworkInitiated is {
        tell event PrecisionPart.ReworkInitiated to repository PrecisionContext.MeasurementRepository
        do "Update rework rate metrics"
      }
      on event PrecisionPart.PartScrapped is {
        tell event PrecisionPart.PartScrapped to repository PrecisionContext.MeasurementRepository
        do "Update scrap rate metrics"
      }
    } with {
      briefly "Maintains SPC analytics"
      described as {
        |Projects events into SPC charts and capability metrics.
      }
    }
  } with {
    briefly "SPC and capability analytics"
    described as {
      | Maintains statistical process control charts, Cpk/Ppk
      | calculations, and tolerance trend analysis.
    }
  }
  // Projector for gage tracking and calibration
  projector GageTracking is {
    inlet GageTrackingFromPrecisionPart is type PrecisionPartEvent
    outlet GageTrackingOut is type PrecisionPartEvent
    updates repository PrecisionContext.MeasurementRepository
    record GageUsageStats is  {
      gageId: GageId with {
        briefly "Gage"
        described as {
          |Gage identifier.
        }
      }
      measurementCount: Natural with {
        briefly "Count"
        described as {
          |Total measurements taken.
        }
      }
      lastUsed: TimeStamp with {
        briefly "Last used"
        described as {
          |Last usage time.
        }
      }
      daysUntilCalibration: Integer with {
        briefly "Days"
        described as {
          |Days until calibration due.
        }
      }
      needsCalibration: Boolean with {
        briefly "Needs cal"
        described as {
          |Whether calibration is due soon.
        }
      }
    } with {
      briefly "Gage usage statistics"
      described as {
        |Tracking of gage usage and calibration status.
      }
    }
    handler GageTrackingHandler is {
      on event PrecisionPart.MeasurementRecorded is {
        tell event PrecisionPart.MeasurementRecorded to repository PrecisionContext.MeasurementRepository
        do "Update gage usage count and last used"
      }
      on event PrecisionPart.CMMResultRecorded is {
        tell event PrecisionPart.CMMResultRecorded to repository PrecisionContext.MeasurementRepository
        do "Update CMM usage statistics"
      }
    } with {
      briefly "Tracks gage usage"
      described as {
        |Projects measurement events into gage usage statistics.
      }
    }
  } with {
    briefly "Gage tracking projections"
    described as {
      |Tracks gage usage and calibration status.
    }
  }
  // ---- Event publication for PrecisionPart ----
  type PrecisionPartEvent is one of {
    PrecisionContext.PrecisionPart.InspectionPlanCreated,
    PrecisionContext.PrecisionPart.MeasurementRecorded,
    PrecisionContext.PrecisionPart.ToleranceEvaluated,
    PrecisionContext.PrecisionPart.ReworkInitiated,
    PrecisionContext.PrecisionPart.PartScrapped,
    PrecisionContext.PrecisionPart.PartCertified,
    PrecisionContext.PrecisionPart.CMMResultRecorded,
    PrecisionContext.PrecisionPart.InspectionPlanUpdated
  } with {
    briefly "PrecisionPart event alternation"
    described as {
      |Union of all PrecisionPart events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PrecisionPartEventSource as source is {
    outlet PrecisionPartEvents is type PrecisionPartEvent
    handler PrecisionPartSourceHandler is {
      on event PrecisionPart.InspectionPlanCreated is {
        send event PrecisionPart.InspectionPlanCreated to outlet PrecisionPartEvents
      }
      on event PrecisionPart.MeasurementRecorded is {
        send event PrecisionPart.MeasurementRecorded to outlet PrecisionPartEvents
      }
      on event PrecisionPart.ToleranceEvaluated is {
        send event PrecisionPart.ToleranceEvaluated to outlet PrecisionPartEvents
      }
      on event PrecisionPart.ReworkInitiated is {
        send event PrecisionPart.ReworkInitiated to outlet PrecisionPartEvents
      }
      on event PrecisionPart.PartScrapped is {
        send event PrecisionPart.PartScrapped to outlet PrecisionPartEvents
      }
      on event PrecisionPart.PartCertified is {
        send event PrecisionPart.PartCertified to outlet PrecisionPartEvents
      }
      on event PrecisionPart.CMMResultRecorded is {
        send event PrecisionPart.CMMResultRecorded to outlet PrecisionPartEvents
      }
      on event PrecisionPart.InspectionPlanUpdated is {
        send event PrecisionPart.InspectionPlanUpdated to outlet PrecisionPartEvents
      }
      on other is {
        error "Unexpected message for source PrecisionPartEventSource"
      }
    } with {
      briefly "PrecisionPart source handler"
      described as {
        |Publishes PrecisionPart events onto the outlet.
      }
    }
  } with {
    briefly "PrecisionPart event source"
    described as {
      |Publishes PrecisionPart entity events into the streaming topology.
    }
  }
  processor PrecisionPartEventSink as sink is {
    inlet PrecisionPartInlet is type PrecisionPartEvent
    handler PrecisionPartSinkHandler is {
      on event PrecisionPart.InspectionPlanCreated is {
        tell event PrecisionPart.InspectionPlanCreated to repository PrecisionContext.MeasurementRepository
      }
      on event PrecisionPart.MeasurementRecorded is {
        tell event PrecisionPart.MeasurementRecorded to repository PrecisionContext.MeasurementRepository
      }
      on event PrecisionPart.ToleranceEvaluated is {
        tell event PrecisionPart.ToleranceEvaluated to repository PrecisionContext.MeasurementRepository
      }
      on event PrecisionPart.ReworkInitiated is {
        tell event PrecisionPart.ReworkInitiated to repository PrecisionContext.MeasurementRepository
      }
      on event PrecisionPart.PartScrapped is {
        tell event PrecisionPart.PartScrapped to repository PrecisionContext.MeasurementRepository
      }
      on event PrecisionPart.PartCertified is {
        tell event PrecisionPart.PartCertified to repository PrecisionContext.MeasurementRepository
      }
      on event PrecisionPart.CMMResultRecorded is {
        tell event PrecisionPart.CMMResultRecorded to repository PrecisionContext.MeasurementRepository
      }
      on event PrecisionPart.InspectionPlanUpdated is {
        tell event PrecisionPart.InspectionPlanUpdated to repository PrecisionContext.MeasurementRepository
      }
      on other is {
        error "Unexpected message for sink PrecisionPartEventSink"
      }
    } with {
      briefly "PrecisionPart sink handler"
      described as {
        |Persists PrecisionPart events via the repository.
      }
    }
  } with {
    briefly "PrecisionPart event sink"
    described as {
      |Receives PrecisionPart events for persistence.
    }
  }
  connector PrecisionPartEventFlow is {
    from outlet PrecisionContext.PrecisionPartEventSource.PrecisionPartEvents to
      inlet PrecisionContext.PrecisionPartEventSink.PrecisionPartInlet
  } with {
    briefly "PrecisionPart event flow"
    described as {
      |Connects the PrecisionPart source to its sink.
    }
  }
  processor PrecisionPartEventSplit is {
    inlet PrecisionPartEventSplitIn is type PrecisionPartEvent
    outlet PrecisionPartEventSplitToMeasurementRepository is type PrecisionPartEvent
    outlet PrecisionPartEventSplitToSPCAnalytics is type PrecisionPartEvent
    outlet PrecisionPartEventSplitToGageTracking is type PrecisionPartEvent
    handler PrecisionPartEventSplitHandler is {
      on event PrecisionPart.InspectionPlanCreated is {
        send event PrecisionPart.InspectionPlanCreated to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.InspectionPlanCreated to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.InspectionPlanCreated to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.InspectionPlanCreated to entity PrecisionContext.PrecisionPart
      }
      on event PrecisionPart.MeasurementRecorded is {
        send event PrecisionPart.MeasurementRecorded to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.MeasurementRecorded to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.MeasurementRecorded to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.MeasurementRecorded to entity PrecisionContext.PrecisionPart
      }
      on event PrecisionPart.ToleranceEvaluated is {
        send event PrecisionPart.ToleranceEvaluated to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.ToleranceEvaluated to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.ToleranceEvaluated to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.ToleranceEvaluated to entity PrecisionContext.PrecisionPart
      }
      on event PrecisionPart.ReworkInitiated is {
        send event PrecisionPart.ReworkInitiated to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.ReworkInitiated to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.ReworkInitiated to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.ReworkInitiated to entity PrecisionContext.PrecisionPart
      }
      on event PrecisionPart.PartScrapped is {
        send event PrecisionPart.PartScrapped to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.PartScrapped to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.PartScrapped to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.PartScrapped to entity PrecisionContext.PrecisionPart
      }
      on event PrecisionPart.PartCertified is {
        send event PrecisionPart.PartCertified to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.PartCertified to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.PartCertified to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.PartCertified to entity PrecisionContext.PrecisionPart
      }
      on event PrecisionPart.CMMResultRecorded is {
        send event PrecisionPart.CMMResultRecorded to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.CMMResultRecorded to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.CMMResultRecorded to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.CMMResultRecorded to entity PrecisionContext.PrecisionPart
      }
      on event PrecisionPart.InspectionPlanUpdated is {
        send event PrecisionPart.InspectionPlanUpdated to outlet PrecisionPartEventSplitToMeasurementRepository
        send event PrecisionPart.InspectionPlanUpdated to outlet PrecisionPartEventSplitToSPCAnalytics
        send event PrecisionPart.InspectionPlanUpdated to outlet PrecisionPartEventSplitToGageTracking
        tell event PrecisionPart.InspectionPlanUpdated to entity PrecisionContext.PrecisionPart
      }
      on other is {
        error "Unexpected message for processor PrecisionPartEventSplit"
      }
    } with {
      briefly "PrecisionPart event fan-out handler"
      described as {
        |Delivers each PrecisionPart event to all of its consumers.
      }
    }
  } with {
    briefly "PrecisionPart event fan-out"
    described as {
      |Fans PrecisionPart events out to the repository and projectors.
    }
  }
  connector LinkPrecisionPartToPrecisionPartEventSplit is {
    from outlet PrecisionContext.PrecisionPart.PrecisionPartEvents2 to
      inlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitIn
  } with {
    briefly "LinkPrecisionPartToPrecisionPartEventSplit"
  }
  connector LinkPrecisionPartEventSplitToMeasurementRepository is {
    from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToMeasurementRepository to
      inlet PrecisionContext.MeasurementRepository.MeasurementRepositoryFromPrecisionPart
  } with {
    briefly "LinkPrecisionPartEventSplitToMeasurementRepository"
  }
  connector LinkPrecisionPartEventSplitToSPCAnalytics is {
    from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToSPCAnalytics to
      inlet PrecisionContext.SPCAnalytics.SPCAnalyticsFromPrecisionPart
  } with {
    briefly "LinkPrecisionPartEventSplitToSPCAnalytics"
  }
  connector LinkPrecisionPartEventSplitToGageTracking is {
    from outlet PrecisionContext.PrecisionPartEventSplit.PrecisionPartEventSplitToGageTracking to
      inlet PrecisionContext.GageTracking.GageTrackingFromPrecisionPart
  } with {
    briefly "LinkPrecisionPartEventSplitToGageTracking"
  }
  connector LinkSPCAnalyticsToMeasurementRepository is {
    from outlet PrecisionContext.SPCAnalytics.SPCAnalyticsOut to
      inlet PrecisionContext.MeasurementRepository.MeasurementRepositoryFromSPCAnalytics
  } with {
    briefly "LinkSPCAnalyticsToMeasurementRepository"
  }
  connector LinkGageTrackingToMeasurementRepository is {
    from outlet PrecisionContext.GageTracking.GageTrackingOut to
      inlet PrecisionContext.MeasurementRepository.MeasurementRepositoryFromGageTracking
  } with {
    briefly "LinkGageTrackingToMeasurementRepository"
  }
} with {
  briefly "Bounded context for precision manufacturing"
  described as {
    | The PrecisionContext is the bounded context for
    | precision measurement, SPC analysis, and certification.
  }
}
