// Precision Manufacturing Domain Model
// High-tolerance machining, metrology, and quality control
domain PrecisionManufacturing is {
  persistent connector 'GageCalibrationServiceReply Stream' is from outlet GageCalibrationService.GageCalibrationServiceRepliesOut to inlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceReplies with {
    briefly "What GageCalibrationService answers PrecisionContext"
  }
  persistent connector 'CertificationServiceReply Stream' is from outlet CertificationService.CertificationServiceRepliesOut to inlet PrecisionContext.ToCertificationService.ToCertificationServiceReplies with {
    briefly "What CertificationService answers PrecisionContext"
  }
  persistent connector 'CMMIntegrationReply Stream' is from outlet CMMIntegration.CMMIntegrationRepliesOut to inlet PrecisionContext.ToCMMIntegration.ToCMMIntegrationReplies with {
    briefly "What CMMIntegration answers PrecisionContext"
  }
  persistent connector 'CMMIntegrationEvent Stream' is from outlet CMMIntegration.CMMIntegrationEventsOut to inlet PrecisionContext.FromCMMIntegration.FromCMMIntegrationIn with {
    briefly "What CMMIntegration tells PrecisionContext, unasked"
  }
  persistent connector 'CertificationServiceEvent Stream' is from outlet CertificationService.CertificationServiceEventsOut to inlet PrecisionContext.FromCertificationService.FromCertificationServiceIn with {
    briefly "What CertificationService tells PrecisionContext, unasked"
  }
  persistent connector 'GageCalibrationServiceEvent Stream' is from outlet GageCalibrationService.GageCalibrationServiceEventsOut to inlet PrecisionContext.FromGageCalibrationService.FromGageCalibrationServiceIn with {
    briefly "What GageCalibrationService tells PrecisionContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MetrologyTechnician is "person performing dimensional measurements" with {
    briefly "Metrology Technician"
    described as {
      |Person operating CMMs and precision measurement equipment.
    }
  }
  user QualityEngineer is "person ensuring quality standards compliance" with {
    briefly "Quality Engineer"
    described as {
      |Person responsible for quality assurance and certification.
    }
  }
  user ProcessEngineer is "person optimizing manufacturing processes" with {
    briefly "Process Engineer"
    described as {
      |Person analyzing SPC data and improving process capability.
    }
  }
  epic PrecisionMachiningEpic is {
    user MetrologyTechnician wants to "to measure parts with tight tolerances" so that "dimensional conformance is verified"
    case InspectPrecisionPart is {
      user MetrologyTechnician wants to "to verify part dimensions against specifications" so that "only conforming parts are certified"
      step is "Technician reviews" "inspection plan" "and tolerance specifications" with {
        briefly "Review plan"
        described as {
          |Check inspection requirements.
        }
      }
      step is "Technician selects" "appropriate gage" "with valid calibration" with {
        briefly "Select gage"
        described as {
          |Choose calibrated measurement tool.
        }
      }
      step take input PrecisionManufacturingApp.PrecisionManufacturingScreen.RecordMeasurementInput from user MetrologyTechnician with {
        briefly "Record measurement"
        described as {
          |Capture dimensional data.
        }
      }
      step is "System evaluates" "measurement against tolerance" "and determines status" with {
        briefly "Evaluate tolerance"
        described as {
          |Compare to specification.
        }
      }
      step is "Technician certifies" "conforming part" "or initiates disposition" with {
        briefly "Certify or disposition"
        described as {
          |Complete inspection cycle.
        }
      }
    } with {
      briefly "Precision part inspection"
      described as {
        |Inspecting parts against tight tolerance requirements.
      }
    }
    case MonitorProcessCapability is {
      user ProcessEngineer wants to "to monitor Cpk and Ppk metrics" so that "process drift is detected early"
      step is "Engineer reviews" "SPC charts" "for trend analysis" with {
        briefly "Review SPC"
        described as {
          |Analyze statistical control charts.
        }
      }
      step is "System calculates" "Cpk and Ppk" "from measurement data" with {
        briefly "Calculate capability"
        described as {
          |Compute process indices.
        }
      }
      step is "Engineer identifies" "assignable causes" "for out-of-control conditions" with {
        briefly "Root cause analysis"
        described as {
          |Investigate variation sources.
        }
      }
    } with {
      briefly "Process capability monitoring"
      described as {
        |Monitoring and improving process capability indices.
      }
    }
  } with {
    briefly "Precision machining operations"
    described as {
      | Epic covering precision measurement, tolerance verification,
      | process capability monitoring, and part certification.
    }
  }
  include "PrecisionContext.riddl"
  include "external-contexts.riddl"
  application context PrecisionManufacturingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PrecisionManufacturing are delivered.
      }
    }
    group PrecisionManufacturingScreen is {
      input RecordMeasurementInput acquires command PrecisionContext.PrecisionPart.RecordMeasurement with {
        briefly "Record measurement control"
        described as {
          |The control through which a user submits the record measurement request.
        }
      }
    } with {
      briefly "Precision manufacturing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppPrecisionPartCommands is type PrecisionContext.PrecisionPart.PrecisionPartCommand
    inlet AppMeasurementRepositoryResponses is result PrecisionContext.PrecisionPart.PrecisionPartResult    handler PrecisionManufacturingAppHandler is {
      on other is {
        error "Unexpected message for application context PrecisionManufacturingApp"
      }
    } with {
      briefly "PrecisionManufacturingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PrecisionManufacturingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'GageCalibrationServiceRequest Stream' is from outlet PrecisionContext.ToGageCalibrationService.ToGageCalibrationServiceOut to inlet GageCalibrationService.GageCalibrationServiceRequests with {
    briefly "What PrecisionContext asks GageCalibrationService to send"
  }
  persistent connector 'CertificationServiceRequest Stream' is from outlet PrecisionContext.ToCertificationService.ToCertificationServiceOut to inlet CertificationService.CertificationServiceRequests with {
    briefly "What PrecisionContext asks CertificationService to send"
  }
  persistent connector 'CMMIntegrationRequest Stream' is from outlet PrecisionContext.ToCMMIntegration.ToCMMIntegrationOut to inlet CMMIntegration.CMMIntegrationRequests with {
    briefly "What PrecisionContext asks CMMIntegration to send"
  }
  persistent connector 'PrecisionPartCommand Stream' is from outlet PrecisionManufacturingApp.AppPrecisionPartCommands to inlet PrecisionContext.PrecisionPartCommandStreamIn with {
    briefly "PrecisionPart commands from the application"
  }
  persistent connector 'PrecisionPartResult Stream' is from outlet PrecisionContext.PrecisionPartResultStreamOut to inlet PrecisionManufacturingApp.AppMeasurementRepositoryResponses with {
    briefly "Measurement query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PrecisionManufacturingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Precision manufacturing domain"
  described as {
    | The PrecisionManufacturing domain handles high-tolerance
    | machining, dimensional metrology, SPC analysis, and
    | quality certification for aerospace and similar industries.
  }
}
