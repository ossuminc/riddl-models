// Batch Processing - BatchContext
context BatchContext is {
  adaptor FromInventoryService from context InventoryService is {
    handler FromInventoryServiceHandler is {
      on event InventoryService.BatchReceived is {
        do "the model receives batch received"
      }
      on event InventoryService.MaterialConsumed is {
        do "the model receives material consumed"
      }
      on result InventoryService.MaterialLotDetails is {
        do "the model receives material lot details"
      }
      on event InventoryService.MaterialReserved is {
        do "the model receives material reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
      briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is {
    handler ToInventoryServiceHandler is {
      on command InventoryService.ConsumeMaterial is {
        do "the model sends consume material"
      }
      on query InventoryService.GetMaterialLot is {
        do "the model sends get material lot"
      }
      on command InventoryService.ReceiveFinishedBatch is {
        do "the model sends receive finished batch"
      }
      on command InventoryService.ReserveMaterial is {
        do "the model sends reserve material"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
      briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromLaboratoryService from context LaboratoryService is {
    handler FromLaboratoryServiceHandler is {
      on event LaboratoryService.BatchQualityRejected is {
        do "the model receives batch quality rejected"
      }
      on event LaboratoryService.BatchQualityReleased is {
        do "the model receives batch quality released"
      }
      on result LaboratoryService.CertificateOfAnalysis is {
        do "the model receives certificate of analysis"
      }
      on event LaboratoryService.SampleCollected is {
        do "the model receives sample collected"
      }
      on event LaboratoryService.SampleRequested is {
        do "the model receives sample requested"
      }
      on event LaboratoryService.TestResultsAvailable is {
        do "the model receives test results available"
      }
      on other is {
        error "Unexpected message for adaptor FromLaboratoryService"
      }
    } with {
      briefly "from laboratory service"
      described as {
        |Carries messages from the external LaboratoryService.
      }
    }
  } with {
      briefly "LaboratoryService integration"
    described as {
      |The model's side of the LaboratoryService conversation.
    }
  }
  adaptor ToLaboratoryService to context LaboratoryService is {
    handler ToLaboratoryServiceHandler is {
      on query LaboratoryService.GetCertificateOfAnalysis is {
        do "the model sends get certificate of analysis"
      }
      on command LaboratoryService.RejectBatchQuality is {
        do "the model sends reject batch quality"
      }
      on command LaboratoryService.ReleaseBatchQuality is {
        do "the model sends release batch quality"
      }
      on command LaboratoryService.RequestSample is {
        do "the model sends request sample"
      }
      on other is {
        error "Unexpected message for adaptor ToLaboratoryService"
      }
    } with {
      briefly "to laboratory service"
      described as {
        |Carries messages to the external LaboratoryService.
      }
    }
  } with {
      briefly "LaboratoryService integration"
    described as {
      |The model's side of the LaboratoryService conversation.
    }
  }
  adaptor FromRecipeManagement from context RecipeManagement is {
    handler FromRecipeManagementHandler is {
      on result RecipeManagement.RecipeDetails is {
        do "the model receives recipe details"
      }
      on event RecipeManagement.RecipeUpdated is {
        do "the model receives recipe updated"
      }
      on result RecipeManagement.RecipeVersionList is {
        do "the model receives recipe version list"
      }
      on other is {
        error "Unexpected message for adaptor FromRecipeManagement"
      }
    } with {
      briefly "from recipe management"
      described as {
        |Carries messages from the external RecipeManagement.
      }
    }
  } with {
      briefly "RecipeManagement integration"
    described as {
      |The model's side of the RecipeManagement conversation.
    }
  }
  adaptor ToRecipeManagement to context RecipeManagement is {
    handler ToRecipeManagementHandler is {
      on query RecipeManagement.GetRecipe is {
        do "the model sends get recipe"
      }
      on query RecipeManagement.GetRecipeVersions is {
        do "the model sends get recipe versions"
      }
      on other is {
        error "Unexpected message for adaptor ToRecipeManagement"
      }
    } with {
      briefly "to recipe management"
      described as {
        |Carries messages to the external RecipeManagement.
      }
    }
  } with {
      briefly "RecipeManagement integration"
    described as {
      |The model's side of the RecipeManagement conversation.
    }
  }
  include "types.riddl"
  include "Batch.riddl"
  // Repository for batch persistence
  repository BatchRepository is {
    inlet BatchRepositoryFromBatch is type BatchEvent
    inlet BatchRepositoryFromBatchYieldAnalytics is type BatchEvent
    inlet BatchRepositoryFromCycleTimeAnalytics is type BatchEvent
    inlet BatchRepositoryFromEquipmentUtilization is type BatchEvent
    outlet BatchRepositoryResponses is type Batch.BatchResult
    record StoredBatch is {
      batchId: BatchId with {
        briefly "batchId"
        described as {
          |The batchId column of the stored batch row.
        }
      }
      recipe: Recipe with {
        briefly "recipe"
        described as {
          |The recipe column of the stored batch row.
        }
      }
      vessel: VesselInfo with {
        briefly "vessel"
        described as {
          |The vessel column of the stored batch row.
        }
      }
    } with {
      briefly "Stored batch row"
      described as {
        |The persistence shape of batch data as this repository stores it.
      }
    }
    schema BatchData is relational
      of batches as type StoredBatch
        index on field StoredBatch.batchId
        index on field StoredBatch.recipe.recipeId
        index on field StoredBatch.vessel.vesselId
        index on field StoredBatch.status
      with {
      briefly "Batch data schema"
      described as {
        |The relational schema holding batch data for the BatchRepository.
      }
    }

    handler BatchPersistence is {
      on command Batch.CreateBatch is {
        tell event Batch.BatchCreated to entity BatchContext.Batch
        do "Store new batch record"
      }
      on command Batch.ChargeIngredient is {
        do "Store ingredient charge record"
      }
      on command Batch.StartProcessing is {
        tell event Batch.ProcessingStarted to entity BatchContext.Batch
        do "Update batch to processing"
      }
      on command Batch.RecordParameter is {
        tell event Batch.ParameterRecorded to entity BatchContext.Batch
        do "Store parameter reading"
      }
      on command Batch.AdvancePhase is {
        do "Update phase completion"
      }
      on command Batch.HoldBatch is {
        do "Update batch to held status"
      }
      on command Batch.ReleaseBatchHold is {
        tell event Batch.BatchHoldReleased to entity BatchContext.Batch
        do "Update batch from held status"
      }
      on command Batch.DischargeBatch is {
        do "Store discharge record"
      }
      on command Batch.CompleteBatch is {
        tell event Batch.BatchCompleted to entity BatchContext.Batch
        do "Update batch to completed"
      }
      on command Batch.RejectBatch is {
        tell event Batch.BatchRejected to entity BatchContext.Batch
        do "Update batch to rejected"
      }
    } with {
      briefly "Persists batch commands"
      described as {
        |Handles command-driven persistence for batches.
      }
    }
  } with {
    briefly "Batch data persistence"
    described as {
      | The BatchRepository provides persistent storage for
      | batch records, ingredient charges, and process parameters.
    }
  }
  // Repository for batch genealogy and traceability
  repository GenealogyRepository is {
    schema GenealogyData is relational
      of genealogy as type BatchGenealogy
        index on field BatchGenealogy.batchId
        index on field BatchGenealogy.rawMaterialLots
      with {
      briefly "Genealogy data schema"
      described as {
        |The relational schema holding genealogy data for the GenealogyRepository.
      }
    }

    handler GenealogyPersistence is {
      on command Batch.CreateBatch is {
        tell event Batch.BatchCreated to entity BatchContext.Batch
        do "Initialize genealogy record"
      }
      on command Batch.ChargeIngredient is {
        do "Link raw material lot to batch"
      }
      on command Batch.CompleteBatch is {
        tell event Batch.BatchCompleted to entity BatchContext.Batch
        do "Finalize genealogy record"
      }
    } with {
      briefly "Persists genealogy data"
      described as {
        |Handles batch traceability persistence.
      }
    }
  } with {
    briefly "Genealogy persistence"
    described as {
      | The GenealogyRepository provides traceability storage
      | linking batches to raw materials and other batches.
    }
  }
  // Projector for batch yield analysis
  projector BatchYieldAnalytics is {
    inlet BatchYieldAnalyticsFromBatch is type BatchEvent
    outlet BatchYieldAnalyticsOut is type BatchEvent
    updates repository BatchContext.BatchRepository
    record YieldMetrics is  {
      recipeId: RecipeId with {
        briefly "Recipe"
        described as {
          |Recipe identifier.
        }
      }
      recipeName: String(1,200) with {
        briefly "Name"
        described as {
          |Recipe name.
        }
      }
      batchCount: Natural with {
        briefly "Batches"
        described as {
          |Number of batches.
        }
      }
      averageYieldPercent: Decimal(5,2) with {
        briefly "Avg yield"
        described as {
          |Average yield percent.
        }
      }
      minYieldPercent: Decimal(5,2) with {
        briefly "Min yield"
        described as {
          |Minimum yield percent.
        }
      }
      maxYieldPercent: Decimal(5,2) with {
        briefly "Max yield"
        described as {
          |Maximum yield percent.
        }
      }
      totalProduced: Decimal(15,4) with {
        briefly "Total"
        described as {
          |Total quantity produced.
        }
      }
      totalWaste: Decimal(15,4) with {
        briefly "Waste"
        described as {
          |Total waste quantity.
        }
      }
    } with {
      briefly "Yield metrics"
      described as {
        |Batch yield statistics by recipe.
      }
    }
    handler YieldHandler is {
      on event Batch.BatchCompleted is {
        tell event Batch.BatchCompleted to repository BatchContext.BatchRepository
        do "Update yield metrics for recipe"
      }
      on event Batch.BatchRejected is {
        tell event Batch.BatchRejected to repository BatchContext.BatchRepository
        do "Update rejection metrics for recipe"
      }
    } with {
      briefly "Maintains yield analytics"
      described as {
        |Projects events into yield analysis views.
      }
    }
  } with {
    briefly "Batch yield projections"
    described as {
      |Maintains batch yield analytics by recipe.
    }
  }
  // Projector for cycle time analysis
  projector CycleTimeAnalytics is {
    inlet CycleTimeAnalyticsFromBatch is type BatchEvent
    outlet CycleTimeAnalyticsOut is type BatchEvent
    updates repository BatchContext.BatchRepository
    record CycleTimeMetrics is  {
      vesselId: VesselId with {
        briefly "Vessel"
        described as {
          |Vessel identifier.
        }
      }
      vesselName: String(1,100) with {
        briefly "Name"
        described as {
          |Vessel name.
        }
      }
      batchCount: Natural with {
        briefly "Batches"
        described as {
          |Number of batches.
        }
      }
      averageCycleTime: Natural with {
        briefly "Avg cycle"
        described as {
          |Average cycle time (min).
        }
      }
      averageChargingTime: Natural with {
        briefly "Avg charging"
        described as {
          |Average charging time (min).
        }
      }
      averageProcessingTime: Natural with {
        briefly "Avg processing"
        described as {
          |Average processing time (min).
        }
      }
      averageDischargeTime: Natural with {
        briefly "Avg discharge"
        described as {
          |Average discharge time (min).
        }
      }
      totalHoldTime: Natural with {
        briefly "Hold time"
        described as {
          |Total hold time (min).
        }
      }
    } with {
      briefly "Cycle time metrics"
      described as {
        |Batch cycle time statistics by vessel.
      }
    }
    handler CycleTimeHandler is {
      on event Batch.BatchCreated is {
        tell event Batch.BatchCreated to repository BatchContext.BatchRepository
        do "Start cycle time tracking"
      }
      on event Batch.ProcessingStarted is {
        tell event Batch.ProcessingStarted to repository BatchContext.BatchRepository
        do "Record charging phase duration"
      }
      on event Batch.BatchDischarged is {
        tell event Batch.BatchDischarged to repository BatchContext.BatchRepository
        do "Record processing phase duration"
      }
      on event Batch.BatchCompleted is {
        tell event Batch.BatchCompleted to repository BatchContext.BatchRepository
        do "Finalize cycle time metrics"
      }
      on event Batch.BatchHeld is {
        tell event Batch.BatchHeld to repository BatchContext.BatchRepository
        do "Start hold time tracking"
      }
      on event Batch.BatchHoldReleased is {
        tell event Batch.BatchHoldReleased to repository BatchContext.BatchRepository
        do "Record hold duration"
      }
    } with {
      briefly "Maintains cycle time analytics"
      described as {
        |Projects events into cycle time views.
      }
    }
  } with {
    briefly "Cycle time projections"
    described as {
      |Maintains batch cycle time analytics by vessel.
    }
  }
  // Projector for equipment utilization
  projector EquipmentUtilization is {
    inlet EquipmentUtilizationFromBatch is type BatchEvent
    outlet EquipmentUtilizationOut is type BatchEvent
    updates repository BatchContext.BatchRepository
    record UtilizationMetrics is  {
      vesselId: VesselId with {
        briefly "Vessel"
        described as {
          |Vessel identifier.
        }
      }
      vesselName: String(1,100) with {
        briefly "Name"
        described as {
          |Vessel name.
        }
      }
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
      totalAvailableMinutes: Natural with {
        briefly "Available"
        described as {
          |Total available minutes.
        }
      }
      totalOperatingMinutes: Natural with {
        briefly "Operating"
        described as {
          |Total operating minutes.
        }
      }
      utilizationPercent: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Utilization percentage.
        }
      }
      batchCount: Natural with {
        briefly "Batches"
        described as {
          |Number of batches run.
        }
      }
      downtimeMinutes: Natural with {
        briefly "Downtime"
        described as {
          |Downtime minutes.
        }
      }
    } with {
      briefly "Utilization metrics"
      described as {
        |Equipment utilization statistics.
      }
    }
    handler UtilizationHandler is {
      on event Batch.ProcessingStarted is {
        tell event Batch.ProcessingStarted to repository BatchContext.BatchRepository
        do "Update vessel utilization start"
      }
      on event Batch.BatchCompleted is {
        tell event Batch.BatchCompleted to repository BatchContext.BatchRepository
        do "Update vessel utilization end"
      }
      on event Batch.BatchRejected is {
        tell event Batch.BatchRejected to repository BatchContext.BatchRepository
        do "Update vessel utilization with rejection"
      }
    } with {
      briefly "Maintains utilization analytics"
      described as {
        |Projects events into utilization views.
      }
    }
  } with {
    briefly "Equipment utilization projections"
    described as {
      |Maintains vessel utilization analytics.
    }
  }
  // ---- Event publication for Batch ----
  type BatchEvent is one of {
    BatchContext.Batch.BatchCreated,
    BatchContext.Batch.IngredientCharged,
    BatchContext.Batch.ProcessingStarted,
    BatchContext.Batch.ParameterRecorded,
    BatchContext.Batch.PhaseAdvanced,
    BatchContext.Batch.BatchHeld,
    BatchContext.Batch.BatchHoldReleased,
    BatchContext.Batch.BatchDischarged,
    BatchContext.Batch.BatchCompleted,
    BatchContext.Batch.BatchRejected
  } with {
    briefly "Batch event alternation"
    described as {
      |Union of all Batch events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BatchEventSource as source is {
    outlet BatchEvents is type BatchEvent
    handler BatchSourceHandler is {
      on event Batch.BatchCreated is {
        send event Batch.BatchCreated to outlet BatchEvents
      }
      on event Batch.IngredientCharged is {
        send event Batch.IngredientCharged to outlet BatchEvents
      }
      on event Batch.ProcessingStarted is {
        send event Batch.ProcessingStarted to outlet BatchEvents
      }
      on event Batch.ParameterRecorded is {
        send event Batch.ParameterRecorded to outlet BatchEvents
      }
      on event Batch.PhaseAdvanced is {
        send event Batch.PhaseAdvanced to outlet BatchEvents
      }
      on event Batch.BatchHeld is {
        send event Batch.BatchHeld to outlet BatchEvents
      }
      on event Batch.BatchHoldReleased is {
        send event Batch.BatchHoldReleased to outlet BatchEvents
      }
      on event Batch.BatchDischarged is {
        send event Batch.BatchDischarged to outlet BatchEvents
      }
      on event Batch.BatchCompleted is {
        send event Batch.BatchCompleted to outlet BatchEvents
      }
      on event Batch.BatchRejected is {
        send event Batch.BatchRejected to outlet BatchEvents
      }
      on other is {
        error "Unexpected message for source BatchEventSource"
      }
    } with {
      briefly "Batch source handler"
      described as {
        |Publishes Batch events onto the outlet.
      }
    }
  } with {
    briefly "Batch event source"
    described as {
      |Publishes Batch entity events into the streaming topology.
    }
  }
  processor BatchEventSink as sink is {
    inlet BatchInlet is type BatchEvent
    handler BatchSinkHandler is {
      on event Batch.BatchCreated is {
        tell event Batch.BatchCreated to repository BatchContext.BatchRepository
      }
      on event Batch.IngredientCharged is {
        tell event Batch.IngredientCharged to repository BatchContext.BatchRepository
      }
      on event Batch.ProcessingStarted is {
        tell event Batch.ProcessingStarted to repository BatchContext.BatchRepository
      }
      on event Batch.ParameterRecorded is {
        tell event Batch.ParameterRecorded to repository BatchContext.BatchRepository
      }
      on event Batch.PhaseAdvanced is {
        tell event Batch.PhaseAdvanced to repository BatchContext.BatchRepository
      }
      on event Batch.BatchHeld is {
        tell event Batch.BatchHeld to repository BatchContext.BatchRepository
      }
      on event Batch.BatchHoldReleased is {
        tell event Batch.BatchHoldReleased to repository BatchContext.BatchRepository
      }
      on event Batch.BatchDischarged is {
        tell event Batch.BatchDischarged to repository BatchContext.BatchRepository
      }
      on event Batch.BatchCompleted is {
        tell event Batch.BatchCompleted to repository BatchContext.BatchRepository
      }
      on event Batch.BatchRejected is {
        tell event Batch.BatchRejected to repository BatchContext.BatchRepository
      }
      on other is {
        error "Unexpected message for sink BatchEventSink"
      }
    } with {
      briefly "Batch sink handler"
      described as {
        |Persists Batch events via the repository.
      }
    }
  } with {
    briefly "Batch event sink"
    described as {
      |Receives Batch events for persistence.
    }
  }
  connector BatchEventFlow is {
    from outlet BatchContext.BatchEventSource.BatchEvents to
      inlet BatchContext.BatchEventSink.BatchInlet
  } with {
    briefly "Batch event flow"
    described as {
      |Connects the Batch source to its sink.
    }
  }
  processor BatchEventSplit is {
    inlet BatchEventSplitIn is type BatchEvent
    outlet BatchEventSplitToBatchRepository is type BatchEvent
    outlet BatchEventSplitToBatchYieldAnalytics is type BatchEvent
    outlet BatchEventSplitToCycleTimeAnalytics is type BatchEvent
    outlet BatchEventSplitToEquipmentUtilization is type BatchEvent
    handler BatchEventSplitHandler is {
      on event Batch.BatchCreated is {
        send event Batch.BatchCreated to outlet BatchEventSplitToBatchRepository
        send event Batch.BatchCreated to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.BatchCreated to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.BatchCreated to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.BatchCreated to entity BatchContext.Batch
      }
      on event Batch.IngredientCharged is {
        send event Batch.IngredientCharged to outlet BatchEventSplitToBatchRepository
        send event Batch.IngredientCharged to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.IngredientCharged to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.IngredientCharged to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.IngredientCharged to entity BatchContext.Batch
      }
      on event Batch.ProcessingStarted is {
        send event Batch.ProcessingStarted to outlet BatchEventSplitToBatchRepository
        send event Batch.ProcessingStarted to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.ProcessingStarted to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.ProcessingStarted to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.ProcessingStarted to entity BatchContext.Batch
      }
      on event Batch.ParameterRecorded is {
        send event Batch.ParameterRecorded to outlet BatchEventSplitToBatchRepository
        send event Batch.ParameterRecorded to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.ParameterRecorded to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.ParameterRecorded to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.ParameterRecorded to entity BatchContext.Batch
      }
      on event Batch.PhaseAdvanced is {
        send event Batch.PhaseAdvanced to outlet BatchEventSplitToBatchRepository
        send event Batch.PhaseAdvanced to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.PhaseAdvanced to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.PhaseAdvanced to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.PhaseAdvanced to entity BatchContext.Batch
      }
      on event Batch.BatchHeld is {
        send event Batch.BatchHeld to outlet BatchEventSplitToBatchRepository
        send event Batch.BatchHeld to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.BatchHeld to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.BatchHeld to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.BatchHeld to entity BatchContext.Batch
      }
      on event Batch.BatchHoldReleased is {
        send event Batch.BatchHoldReleased to outlet BatchEventSplitToBatchRepository
        send event Batch.BatchHoldReleased to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.BatchHoldReleased to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.BatchHoldReleased to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.BatchHoldReleased to entity BatchContext.Batch
      }
      on event Batch.BatchDischarged is {
        send event Batch.BatchDischarged to outlet BatchEventSplitToBatchRepository
        send event Batch.BatchDischarged to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.BatchDischarged to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.BatchDischarged to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.BatchDischarged to entity BatchContext.Batch
      }
      on event Batch.BatchCompleted is {
        send event Batch.BatchCompleted to outlet BatchEventSplitToBatchRepository
        send event Batch.BatchCompleted to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.BatchCompleted to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.BatchCompleted to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.BatchCompleted to entity BatchContext.Batch
      }
      on event Batch.BatchRejected is {
        send event Batch.BatchRejected to outlet BatchEventSplitToBatchRepository
        send event Batch.BatchRejected to outlet BatchEventSplitToBatchYieldAnalytics
        send event Batch.BatchRejected to outlet BatchEventSplitToCycleTimeAnalytics
        send event Batch.BatchRejected to outlet BatchEventSplitToEquipmentUtilization
        tell event Batch.BatchRejected to entity BatchContext.Batch
      }
      on other is {
        error "Unexpected message for processor BatchEventSplit"
      }
    } with {
      briefly "Batch event fan-out handler"
      described as {
        |Delivers each Batch event to all of its consumers.
      }
    }
  } with {
    briefly "Batch event fan-out"
    described as {
      |Fans Batch events out to the repository and projectors.
    }
  }
  connector LinkBatchToBatchEventSplit is {
    from outlet BatchContext.Batch.BatchEvents2 to
      inlet BatchContext.BatchEventSplit.BatchEventSplitIn
  } with {
    briefly "LinkBatchToBatchEventSplit"
  }
  connector LinkBatchEventSplitToBatchRepository is {
    from outlet BatchContext.BatchEventSplit.BatchEventSplitToBatchRepository to
      inlet BatchContext.BatchRepository.BatchRepositoryFromBatch
  } with {
    briefly "LinkBatchEventSplitToBatchRepository"
  }
  connector LinkBatchEventSplitToBatchYieldAnalytics is {
    from outlet BatchContext.BatchEventSplit.BatchEventSplitToBatchYieldAnalytics to
      inlet BatchContext.BatchYieldAnalytics.BatchYieldAnalyticsFromBatch
  } with {
    briefly "LinkBatchEventSplitToBatchYieldAnalytics"
  }
  connector LinkBatchEventSplitToCycleTimeAnalytics is {
    from outlet BatchContext.BatchEventSplit.BatchEventSplitToCycleTimeAnalytics to
      inlet BatchContext.CycleTimeAnalytics.CycleTimeAnalyticsFromBatch
  } with {
    briefly "LinkBatchEventSplitToCycleTimeAnalytics"
  }
  connector LinkBatchEventSplitToEquipmentUtilization is {
    from outlet BatchContext.BatchEventSplit.BatchEventSplitToEquipmentUtilization to
      inlet BatchContext.EquipmentUtilization.EquipmentUtilizationFromBatch
