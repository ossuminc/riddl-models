// Batch Processing - BatchContext
context BatchContext as router is {
  inlet BatchCommandStreamIn is type BatchCommand  outlet BatchCommandStreamOut is type BatchCommand
  inlet DrugBatchResultStreamIn is result Batch.BatchResult  outlet DrugBatchResultStreamOut is result Batch.BatchResult
  handler BatchContextBoundary is {
    on createBatch: command Batch.CreateBatch is {
      send createBatch to outlet BatchContext.BatchCommandStreamOut
    }
    on chargeIngredient: command Batch.ChargeIngredient is {
      send chargeIngredient to outlet BatchContext.BatchCommandStreamOut
    }
    on startProcessing: command Batch.StartProcessing is {
      send startProcessing to outlet BatchContext.BatchCommandStreamOut
    }
    on recordParameter: command Batch.RecordParameter is {
      send recordParameter to outlet BatchContext.BatchCommandStreamOut
    }
    on advancePhase: command Batch.AdvancePhase is {
      send advancePhase to outlet BatchContext.BatchCommandStreamOut
    }
    on holdBatch: command Batch.HoldBatch is {
      send holdBatch to outlet BatchContext.BatchCommandStreamOut
    }
    on releaseBatchHold: command Batch.ReleaseBatchHold is {
      send releaseBatchHold to outlet BatchContext.BatchCommandStreamOut
    }
    on dischargeBatch: command Batch.DischargeBatch is {
      send dischargeBatch to outlet BatchContext.BatchCommandStreamOut
    }
    on completeBatch: command Batch.CompleteBatch is {
      send completeBatch to outlet BatchContext.BatchCommandStreamOut
    }
    on rejectBatch: command Batch.RejectBatch is {
      send rejectBatch to outlet BatchContext.BatchCommandStreamOut
    }
    on batchResult: result Batch.BatchResult is {
      send batchResult to outlet BatchContext.DrugBatchResultStreamOut
    }
    on other is {
      error "Unexpected message at the BatchContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BatchYieldAnalytics To GenealogyRepository Storage' is from outlet BatchContext.BatchYieldAnalytics.BatchYieldAnalyticsToGenealogyRepository to inlet BatchContext.GenealogyRepository.GenealogyRepositoryFromBatchYieldAnalytics with {
    briefly "BatchYieldAnalytics commands on their way to GenealogyRepository"
  }
  connector 'BatchCommand Stream Intake' is from outlet BatchContext.BatchCommandStreamOut to inlet BatchContext.Batch.BatchCommands  connector 'DrugBatchResult Stream Egress' is from outlet BatchContext.BatchRepository.BatchRepositoryResponses to inlet BatchContext.DrugBatchResultStreamIn  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on event InventoryService.BatchReceived is {
        do "the model receives batch received"
      }
      on event InventoryService.MaterialConsumed is {
        do "the model receives material consumed"
      }
      on result InventoryService.MaterialLotDetails is {
        do "the model receives material lot details"
      }
      on event InventoryService.MaterialReserved is {
        do "the model receives material reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on command InventoryService.ConsumeMaterial is {
        do "the model sends consume material"
      }
      on query InventoryService.GetMaterialLot is {
        do "the model sends get material lot"
      }
      on command InventoryService.ReceiveFinishedBatch is {
        do "the model sends receive finished batch"
      }
      on command InventoryService.ReserveMaterial is {
        do "the model sends reserve material"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromLaboratoryService from context LaboratoryService is { 
    handler FromLaboratoryServiceHandler is {
      on event LaboratoryService.BatchQualityRejected is {
        do "the model receives batch quality rejected"
      }
      on event LaboratoryService.BatchQualityReleased is {
        do "the model receives batch quality released"
      }
      on result LaboratoryService.CertificateOfAnalysis is {
        do "the model receives certificate of analysis"
      }
      on event LaboratoryService.SampleCollected is {
        do "the model receives sample collected"
      }
      on event LaboratoryService.SampleRequested is {
        do "the model receives sample requested"
      }
      on event LaboratoryService.TestResultsAvailable is {
        do "the model receives test results available"
      }
      on other is {
        error "Unexpected message for adaptor FromLaboratoryService"
      }
    } with {
      briefly "from laboratory service"
      described as {
        |Carries messages from the external LaboratoryService.
      }
    }
  } with {
    briefly "LaboratoryService integration"
    described as {
      |The model's side of the LaboratoryService conversation.
    }
  }
  adaptor ToLaboratoryService to context LaboratoryService is { 
    handler ToLaboratoryServiceHandler is {
      on query LaboratoryService.GetCertificateOfAnalysis is {
        do "the model sends get certificate of analysis"
      }
      on command LaboratoryService.RejectBatchQuality is {
        do "the model sends reject batch quality"
      }
      on command LaboratoryService.ReleaseBatchQuality is {
        do "the model sends release batch quality"
      }
      on command LaboratoryService.RequestSample is {
        do "the model sends request sample"
      }
      on other is {
        error "Unexpected message for adaptor ToLaboratoryService"
      }
    } with {
      briefly "to laboratory service"
      described as {
        |Carries messages to the external LaboratoryService.
      }
    }
  } with {
    briefly "LaboratoryService integration"
    described as {
      |The model's side of the LaboratoryService conversation.
    }
  }
  adaptor FromRecipeManagement from context RecipeManagement is { 
    handler FromRecipeManagementHandler is {
      on result RecipeManagement.RecipeDetails is {
        do "the model receives recipe details"
      }
      on event RecipeManagement.RecipeUpdated is {
        do "the model receives recipe updated"
      }
      on result RecipeManagement.RecipeVersionList is {
        do "the model receives recipe version list"
      }
      on other is {
        error "Unexpected message for adaptor FromRecipeManagement"
      }
    } with {
      briefly "from recipe management"
      described as {
        |Carries messages from the external RecipeManagement.
      }
    }
  } with {
    briefly "RecipeManagement integration"
    described as {
      |The model's side of the RecipeManagement conversation.
    }
  }
  adaptor ToRecipeManagement to context RecipeManagement is { 
    handler ToRecipeManagementHandler is {
      on query RecipeManagement.GetRecipe is {
        do "the model sends get recipe"
      }
      on query RecipeManagement.GetRecipeVersions is {
        do "the model sends get recipe versions"
      }
      on other is {
        error "Unexpected message for adaptor ToRecipeManagement"
      }
    } with {
      briefly "to recipe management"
      described as {
        |Carries messages to the external RecipeManagement.
      }
    }
  } with {
    briefly "RecipeManagement integration"
    described as {
      |The model's side of the RecipeManagement conversation.
    }
  }
  include "types.riddl"
  include "Batch.riddl"
  // Repository for batch persistence
  type BatchRepositoryCommand is one of {
    BatchContext.BatchRepository.PersistBatchCompleted or BatchContext.BatchRepository.PersistBatchCreated or BatchContext.BatchRepository.PersistBatchDischarged or BatchContext.BatchRepository.PersistBatchHeld or BatchContext.BatchRepository.PersistBatchHoldReleased or BatchContext.BatchRepository.PersistBatchRejected or BatchContext.BatchRepository.PersistParameterRecorded or BatchContext.BatchRepository.PersistPhaseAdvanced or BatchContext.BatchRepository.PersistProcessingStarted
  } with {
    briefly "Anything that writes BatchRepository"
    described as {
      |The persistence commands BatchRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BatchRepository as flow is {
    inlet BatchRepositoryFromBatchYieldAnalytics is type BatchRepositoryCommand
    command PersistParameterRecorded is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ParameterRecorded applies to.
        }
      }
    } with {
      briefly "Persist ParameterRecorded"
      described as {
        |Instructs this repository to apply ParameterRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPhaseAdvanced is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row PhaseAdvanced applies to.
        }
      }
    } with {
      briefly "Persist PhaseAdvanced"
      described as {
        |Instructs this repository to apply PhaseAdvanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchCompleted is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row BatchCompleted applies to.
        }
      }
    } with {
      briefly "Persist BatchCompleted"
      described as {
        |Instructs this repository to apply BatchCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchCreated is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row BatchCreated applies to.
        }
      }
    } with {
      briefly "Persist BatchCreated"
      described as {
        |Instructs this repository to apply BatchCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchDischarged is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row BatchDischarged applies to.
        }
      }
    } with {
      briefly "Persist BatchDischarged"
      described as {
        |Instructs this repository to apply BatchDischarged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchHeld is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row BatchHeld applies to.
        }
      }
    } with {
      briefly "Persist BatchHeld"
      described as {
        |Instructs this repository to apply BatchHeld to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchHoldReleased is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row BatchHoldReleased applies to.
        }
      }
    } with {
      briefly "Persist BatchHoldReleased"
      described as {
        |Instructs this repository to apply BatchHoldReleased to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBatchRejected is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row BatchRejected applies to.
        }
      }
    } with {
      briefly "Persist BatchRejected"
      described as {
        |Instructs this repository to apply BatchRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProcessingStarted is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProcessingStarted applies to.
        }
      }
    } with {
      briefly "Persist ProcessingStarted"
      described as {
        |Instructs this repository to apply ProcessingStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BatchRepositoryResponses is result Batch.BatchResult
    record StoredBatch is  {
      batchId: BatchId with {
        briefly "batchId"
        described as {
          |The batchId column of the stored batch row.
        }
      }
      recipe: Recipe with {
        briefly "recipe"
        described as {
          |The recipe column of the stored batch row.
        }
      }
      vessel: VesselInfo with {
        briefly "vessel"
        described as {
          |The vessel column of the stored batch row.
        }
      }
    } with {
      briefly "Stored batch row"
      described as {
        |The persistence shape of batch data as this repository stores it.
      }
    }
    schema BatchData is relational
      of batches as record StoredBatch
        index on field StoredBatch.batchId
        index on field StoredBatch.recipe.recipeId
        index on field StoredBatch.vessel.vesselId
        index on field StoredBatch.status
 with {
      briefly "Batch data schema"
      described as {
        |The relational schema holding batch data for the BatchRepository.
      }
    }
    handler BatchPersistence is {
      on persistParameterRecorded: command PersistParameterRecorded is {
        do "apply ParameterRecorded to the stored row"
      }
      on persistPhaseAdvanced: command PersistPhaseAdvanced is {
        do "apply PhaseAdvanced to the stored row"
      }
      on persistBatchCompleted: command PersistBatchCompleted is {
        do "apply BatchCompleted to the stored row"
      }
      on persistBatchCreated: command PersistBatchCreated is {
        do "apply BatchCreated to the stored row"
      }
      on persistBatchDischarged: command PersistBatchDischarged is {
        do "apply BatchDischarged to the stored row"
      }
      on persistBatchHeld: command PersistBatchHeld is {
        do "apply BatchHeld to the stored row"
      }
      on persistBatchHoldReleased: command PersistBatchHoldReleased is {
        do "apply BatchHoldReleased to the stored row"
      }
      on persistBatchRejected: command PersistBatchRejected is {
        do "apply BatchRejected to the stored row"
      }
      on persistProcessingStarted: command PersistProcessingStarted is {
        do "apply ProcessingStarted to the stored row"
      }
      on query GetYieldMetrics is {
        let yieldMetricsView: type YieldMetricsView = prompt("read the yield metrics projection")
        reply yieldMetricsView
      }
      on query GetCycleTimeMetrics is {
        let cycleTimeMetricsView: type CycleTimeMetricsView = prompt("read the cycle time metrics projection")
        reply cycleTimeMetricsView
      }
      on query GetUtilizationMetrics is {
        let utilizationMetricsView: type UtilizationMetricsView = prompt("read the utilization metrics projection")
        reply utilizationMetricsView
      }
    } with {
      briefly "Persists batch commands"
      described as {
        |Handles command-driven persistence for batches.
      }
    }
  } with {
    briefly "Batch data persistence"
    described as {
      | The BatchRepository provides persistent storage for
      | batch records, ingredient charges, and process parameters.
    }
  }
  // Repository for batch genealogy and traceability
  repository GenealogyRepository as sink is {
    inlet GenealogyRepositoryFromBatchYieldAnalytics is command BatchContext.GenealogyRepository.PersistIngredientCharged
    command PersistIngredientCharged is  {
      batchId: BatchId with {
        briefly "Row addressed"
        described as {
          |Which stored row IngredientCharged applies to.
        }
      }
    } with {
      briefly "Persist IngredientCharged"
      described as {
        |Instructs this repository to apply IngredientCharged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    schema GenealogyData is relational
      of genealogy as type BatchGenealogy
        index on field BatchGenealogy.batchId
        index on field BatchGenealogy.rawMaterialLots
 with {
      briefly "Genealogy data schema"
      described as {
        |The relational schema holding genealogy data for the GenealogyRepository.
      }
    }
    handler GenealogyPersistence is {
      on persistIngredientCharged: command PersistIngredientCharged is {
        do "apply IngredientCharged to the stored row"
      }
    } with {
      briefly "Persists genealogy data"
      described as {
        |Handles batch traceability persistence.
      }
    }
  } with {
    briefly "Genealogy persistence"
    described as {
      | The GenealogyRepository provides traceability storage
      | linking batches to raw materials and other batches.
    }
  }
  // Projector for batch yield analysis
  query GetYieldMetrics replies result YieldMetricsView is  {
    yieldMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which yield metrics to retrieve.
      }
    }
  } with {
    briefly "Get yield metrics"
    described as {
      |Retrieves the yield metrics projection.
    }
  }
  result YieldMetricsView is  {
    yieldMetrics: BatchYieldAnalytics.YieldMetrics with {
      briefly "Yield metrics"
      described as {
        |The yield metrics being returned.
      }
    }
  } with {
    briefly "Yield metrics view"
    described as {
      |Read model view carrying the yield metrics projection.
    }
  }
  projector BatchYieldAnalytics as split is {
    outlet BatchYieldAnalyticsToRepository is type BatchRepositoryCommand
    outlet BatchYieldAnalyticsToGenealogyRepository is command BatchContext.GenealogyRepository.PersistIngredientCharged
    updates repository BatchContext.BatchRepository
    inlet BatchYieldAnalyticsFromBatch is type BatchEvent
    record YieldMetrics is  {
      recipeId: RecipeId with {
        briefly "Recipe"
        described as {
          |Recipe identifier.
        }
      }
      recipeName: String(1,200) with {
        briefly "Name"
        described as {
          |Recipe name.
        }
      }
      batchCount: Natural with {
        briefly "Batches"
        described as {
          |Number of batches.
        }
      }
      averageYieldPercent: Decimal(5,2) with {
        briefly "Avg yield"
        described as {
          |Average yield percent.
        }
      }
      minYieldPercent: Decimal(5,2) with {
        briefly "Min yield"
        described as {
          |Minimum yield percent.
        }
      }
      maxYieldPercent: Decimal(5,2) with {
        briefly "Max yield"
        described as {
          |Maximum yield percent.
        }
      }
      totalProduced: Decimal(15,4) with {
        briefly "Total"
        described as {
          |Total quantity produced.
        }
      }
      totalWaste: Decimal(15,4) with {
        briefly "Waste"
        described as {
          |Total waste quantity.
        }
      }
    } with {
      briefly "Yield metrics"
      described as {
        |Batch yield statistics by recipe.
      }
    }
    handler YieldHandler is {
      on batchCreated: event Batch.BatchCreated is {
        tell command BatchContext.BatchRepository.PersistBatchCreated(batchId = batchCreated.batchId) to repository BatchContext.BatchRepository
        do "apply BatchCreated to the BatchYieldAnalytics projection"
      }
      on batchDischarged: event Batch.BatchDischarged is {
        tell command BatchContext.BatchRepository.PersistBatchDischarged(batchId = batchDischarged.batchId) to repository BatchContext.BatchRepository
        do "apply BatchDischarged to the BatchYieldAnalytics projection"
      }
      on batchHeld: event Batch.BatchHeld is {
        tell command BatchContext.BatchRepository.PersistBatchHeld(batchId = batchHeld.batchId) to repository BatchContext.BatchRepository
        do "apply BatchHeld to the BatchYieldAnalytics projection"
      }
      on batchHoldReleased: event Batch.BatchHoldReleased is {
        tell command BatchContext.BatchRepository.PersistBatchHoldReleased(batchId = batchHoldReleased.batchId) to repository BatchContext.BatchRepository
        do "apply BatchHoldReleased to the BatchYieldAnalytics projection"
      }
      on ingredientCharged: event Batch.IngredientCharged is {
        tell command BatchContext.GenealogyRepository.PersistIngredientCharged(batchId = ingredientCharged.batchId) to repository BatchContext.GenealogyRepository
        do "apply IngredientCharged to the BatchYieldAnalytics projection"
      }
      on parameterRecorded: event Batch.ParameterRecorded is {
        tell command BatchContext.BatchRepository.PersistParameterRecorded(batchId = parameterRecorded.batchId) to repository BatchContext.BatchRepository
        do "apply ParameterRecorded to the BatchYieldAnalytics projection"
      }
      on phaseAdvanced: event Batch.PhaseAdvanced is {
        tell command BatchContext.BatchRepository.PersistPhaseAdvanced(batchId = phaseAdvanced.batchId) to repository BatchContext.BatchRepository
        do "apply PhaseAdvanced to the BatchYieldAnalytics projection"
      }
      on processingStarted: event Batch.ProcessingStarted is {
        tell command BatchContext.BatchRepository.PersistProcessingStarted(batchId = processingStarted.batchId) to repository BatchContext.BatchRepository
        do "apply ProcessingStarted to the BatchYieldAnalytics projection"
      }
      on batchCompleted: event Batch.BatchCompleted is {
        tell command BatchContext.BatchRepository.PersistBatchCompleted(batchId = batchCompleted.batchId) to repository BatchContext.BatchRepository
        do "Update yield metrics for recipe"
      }
      on batchRejected: event Batch.BatchRejected is {
        tell command BatchContext.BatchRepository.PersistBatchRejected(batchId = batchRejected.batchId) to repository BatchContext.BatchRepository
        do "Update rejection metrics for recipe"
      }
    } with {
      briefly "Maintains yield analytics"
      described as {
        |Projects events into yield analysis views.
      }
    }
  } with {
    briefly "Batch yield projections"
    described as {
      |Maintains batch yield analytics by recipe.
    }
  }
  // Projector for cycle time analysis
  query GetCycleTimeMetrics replies result CycleTimeMetricsView is  {
    cycleTimeMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which cycle time metrics to retrieve.
      }
    }
  } with {
    briefly "Get cycle time metrics"
    described as {
      |Retrieves the cycle time metrics projection.
    }
  }
  result CycleTimeMetricsView is  {
    cycleTimeMetrics: CycleTimeAnalytics.CycleTimeMetrics with {
      briefly "Cycle time metrics"
      described as {
        |The cycle time metrics being returned.
      }
    }
  } with {
    briefly "Cycle time metrics view"
    described as {
      |Read model view carrying the cycle time metrics projection.
    }
  }
  projector CycleTimeAnalytics as sink is {
    updates repository BatchContext.BatchRepository
    inlet CycleTimeAnalyticsFromBatch is type BatchEvent
    record CycleTimeMetrics is  {
      vesselId: VesselId with {
        briefly "Vessel"
        described as {
          |Vessel identifier.
        }
      }
      vesselName: String(1,100) with {
        briefly "Name"
        described as {
          |Vessel name.
        }
      }
      batchCount: Natural with {
        briefly "Batches"
        described as {
          |Number of batches.
        }
      }
      averageCycleTime: Natural with {
        briefly "Avg cycle"
        described as {
          |Average cycle time (min).
        }
      }
      averageChargingTime: Natural with {
        briefly "Avg charging"
        described as {
          |Average charging time (min).
        }
      }
      averageProcessingTime: Natural with {
        briefly "Avg processing"
        described as {
          |Average processing time (min).
        }
      }
      averageDischargeTime: Natural with {
        briefly "Avg discharge"
        described as {
          |Average discharge time (min).
        }
      }
      totalHoldTime: Natural with {
        briefly "Hold time"
        described as {
          |Total hold time (min).
        }
      }
    } with {
      briefly "Cycle time metrics"
      described as {
        |Batch cycle time statistics by vessel.
      }
    }
    handler CycleTimeHandler is {
      on batchRejected: event Batch.BatchRejected is {
        tell command BatchContext.BatchRepository.PersistBatchRejected(batchId = batchRejected.batchId) to repository BatchContext.BatchRepository
        do "apply BatchRejected to the CycleTimeAnalytics projection"
      }
      on ingredientCharged: event Batch.IngredientCharged is {
        tell command BatchContext.GenealogyRepository.PersistIngredientCharged(batchId = ingredientCharged.batchId) to repository BatchContext.GenealogyRepository
        do "apply IngredientCharged to the CycleTimeAnalytics projection"
      }
      on parameterRecorded: event Batch.ParameterRecorded is {
        tell command BatchContext.BatchRepository.PersistParameterRecorded(batchId = parameterRecorded.batchId) to repository BatchContext.BatchRepository
        do "apply ParameterRecorded to the CycleTimeAnalytics projection"
      }
      on phaseAdvanced: event Batch.PhaseAdvanced is {
        tell command BatchContext.BatchRepository.PersistPhaseAdvanced(batchId = phaseAdvanced.batchId) to repository BatchContext.BatchRepository
        do "apply PhaseAdvanced to the CycleTimeAnalytics projection"
      }
      on batchCreated: event Batch.BatchCreated is {
        tell command BatchContext.BatchRepository.PersistBatchCreated(batchId = batchCreated.batchId) to repository BatchContext.BatchRepository
        do "Start cycle time tracking"
      }
      on processingStarted: event Batch.ProcessingStarted is {
        tell command BatchContext.BatchRepository.PersistProcessingStarted(batchId = processingStarted.batchId) to repository BatchContext.BatchRepository
        do "Record charging phase duration"
      }
      on batchDischarged: event Batch.BatchDischarged is {
        tell command BatchContext.BatchRepository.PersistBatchDischarged(batchId = batchDischarged.batchId) to repository BatchContext.BatchRepository
        do "Record processing phase duration"
      }
      on batchCompleted: event Batch.BatchCompleted is {
        tell command BatchContext.BatchRepository.PersistBatchCompleted(batchId = batchCompleted.batchId) to repository BatchContext.BatchRepository
        do "Finalize cycle time metrics"
      }
      on batchHeld: event Batch.BatchHeld is {
        tell command BatchContext.BatchRepository.PersistBatchHeld(batchId = batchHeld.batchId) to repository BatchContext.BatchRepository
        do "Start hold time tracking"
      }
      on batchHoldReleased: event Batch.BatchHoldReleased is {
        tell command BatchContext.BatchRepository.PersistBatchHoldReleased(batchId = batchHoldReleased.batchId) to repository BatchContext.BatchRepository
        do "Record hold duration"
      }
    } with {
      briefly "Maintains cycle time analytics"
      described as {
        |Projects events into cycle time views.
      }
    }
  } with {
    briefly "Cycle time projections"
    described as {
      |Maintains batch cycle time analytics by vessel.
    }
  }
  // Projector for equipment utilization
  query GetUtilizationMetrics replies result UtilizationMetricsView is  {
    utilizationMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which utilization metrics to retrieve.
      }
    }
  } with {
    briefly "Get utilization metrics"
    described as {
      |Retrieves the utilization metrics projection.
    }
  }
  result UtilizationMetricsView is  {
    utilizationMetrics: EquipmentUtilization.UtilizationMetrics with {
      briefly "Utilization metrics"
      described as {
        |The utilization metrics being returned.
      }
    }
  } with {
    briefly "Utilization metrics view"
    described as {
      |Read model view carrying the utilization metrics projection.
    }
  }
  projector EquipmentUtilization as sink is {
    updates repository BatchContext.BatchRepository
    inlet EquipmentUtilizationFromBatch is type BatchEvent
    record UtilizationMetrics is  {
      vesselId: VesselId with {
        briefly "Vessel"
        described as {
          |Vessel identifier.
        }
      }
      vesselName: String(1,100) with {
        briefly "Name"
        described as {
          |Vessel name.
        }
      }
      periodStart: Date with {
        briefly "Period start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "Period end"
        described as {
          |Analysis period end.
        }
      }
      totalAvailableMinutes: Natural with {
        briefly "Available"
        described as {
          |Total available minutes.
        }
      }
      totalOperatingMinutes: Natural with {
        briefly "Operating"
        described as {
          |Total operating minutes.
        }
      }
      utilizationPercent: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Utilization percentage.
        }
      }
      batchCount: Natural with {
        briefly "Batches"
        described as {
          |Number of batches run.
        }
      }
      downtimeMinutes: Natural with {
        briefly "Downtime"
        described as {
          |Downtime minutes.
        }
      }
    } with {
      briefly "Utilization metrics"
      described as {
        |Equipment utilization statistics.
      }
    }
    handler UtilizationHandler is {
      on batchCreated: event Batch.BatchCreated is {
        tell command BatchContext.BatchRepository.PersistBatchCreated(batchId = batchCreated.batchId) to repository BatchContext.BatchRepository
        do "apply BatchCreated to the EquipmentUtilization projection"
      }
      on batchDischarged: event Batch.BatchDischarged is {
        tell command BatchContext.BatchRepository.PersistBatchDischarged(batchId = batchDischarged.batchId) to repository BatchContext.BatchRepository
        do "apply BatchDischarged to the EquipmentUtilization projection"
      }
      on batchHeld: event Batch.BatchHeld is {
        tell command BatchContext.BatchRepository.PersistBatchHeld(batchId = batchHeld.batchId) to repository BatchContext.BatchRepository
        do "apply BatchHeld to the EquipmentUtilization projection"
      }
      on batchHoldReleased: event Batch.BatchHoldReleased is {
        tell command BatchContext.BatchRepository.PersistBatchHoldReleased(batchId = batchHoldReleased.batchId) to repository BatchContext.BatchRepository
        do "apply BatchHoldReleased to the EquipmentUtilization projection"
      }
      on ingredientCharged: event Batch.IngredientCharged is {
        tell command BatchContext.GenealogyRepository.PersistIngredientCharged(batchId = ingredientCharged.batchId) to repository BatchContext.GenealogyRepository
        do "apply IngredientCharged to the EquipmentUtilization projection"
      }
      on parameterRecorded: event Batch.ParameterRecorded is {
        tell command BatchContext.BatchRepository.PersistParameterRecorded(batchId = parameterRecorded.batchId) to repository BatchContext.BatchRepository
        do "apply ParameterRecorded to the EquipmentUtilization projection"
      }
      on phaseAdvanced: event Batch.PhaseAdvanced is {
        tell command BatchContext.BatchRepository.PersistPhaseAdvanced(batchId = phaseAdvanced.batchId) to repository BatchContext.BatchRepository
        do "apply PhaseAdvanced to the EquipmentUtilization projection"
      }
      on processingStarted: event Batch.ProcessingStarted is {
        tell command BatchContext.BatchRepository.PersistProcessingStarted(batchId = processingStarted.batchId) to repository BatchContext.BatchRepository
        do "Update vessel utilization start"
      }
      on batchCompleted: event Batch.BatchCompleted is {
        tell command BatchContext.BatchRepository.PersistBatchCompleted(batchId = batchCompleted.batchId) to repository BatchContext.BatchRepository
        do "Update vessel utilization end"
      }
      on batchRejected: event Batch.BatchRejected is {
        tell command BatchContext.BatchRepository.PersistBatchRejected(batchId = batchRejected.batchId) to repository BatchContext.BatchRepository
        do "Update vessel utilization with rejection"
      }
    } with {
      briefly "Maintains utilization analytics"
      described as {
        |Projects events into utilization views.
      }
    }
  } with {
    briefly "Equipment utilization projections"
    described as {
      |Maintains vessel utilization analytics.
    }
  }
  // ---- Event publication for Batch ----
  type BatchEvent is one of {
    BatchContext.Batch.BatchCreated or BatchContext.Batch.IngredientCharged or BatchContext.Batch.ProcessingStarted or BatchContext.Batch.ParameterRecorded or BatchContext.Batch.PhaseAdvanced or BatchContext.Batch.BatchHeld or BatchContext.Batch.BatchHoldReleased or BatchContext.Batch.BatchDischarged or BatchContext.Batch.BatchCompleted or BatchContext.Batch.BatchRejected
  } with {
    briefly "Batch event alternation"
    described as {
      |Union of all Batch events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BatchEventSplit as split is {
    inlet BatchEventSplitIn is type BatchEvent
    outlet BatchEventSplitToBatchYieldAnalytics is type BatchEvent
    outlet BatchEventSplitToCycleTimeAnalytics is type BatchEvent
    outlet BatchEventSplitToEquipmentUtilization is type BatchEvent

    handler BatchEventSplitHandler is {
      on batchCreated: event Batch.BatchCreated is {
        send batchCreated to outlet BatchEventSplitToBatchYieldAnalytics
        send batchCreated to outlet BatchEventSplitToCycleTimeAnalytics
        send batchCreated to outlet BatchEventSplitToEquipmentUtilization
        tell batchCreated to entity BatchContext.Batch
      }
      on ingredientCharged: event Batch.IngredientCharged is {
        send ingredientCharged to outlet BatchEventSplitToBatchYieldAnalytics
        send ingredientCharged to outlet BatchEventSplitToCycleTimeAnalytics
        send ingredientCharged to outlet BatchEventSplitToEquipmentUtilization
        tell ingredientCharged to entity BatchContext.Batch
      }
      on processingStarted: event Batch.ProcessingStarted is {
        send processingStarted to outlet BatchEventSplitToBatchYieldAnalytics
        send processingStarted to outlet BatchEventSplitToCycleTimeAnalytics
        send processingStarted to outlet BatchEventSplitToEquipmentUtilization
        tell processingStarted to entity BatchContext.Batch
      }
      on parameterRecorded: event Batch.ParameterRecorded is {
        send parameterRecorded to outlet BatchEventSplitToBatchYieldAnalytics
        send parameterRecorded to outlet BatchEventSplitToCycleTimeAnalytics
        send parameterRecorded to outlet BatchEventSplitToEquipmentUtilization
        tell parameterRecorded to entity BatchContext.Batch
      }
      on phaseAdvanced: event Batch.PhaseAdvanced is {
        send phaseAdvanced to outlet BatchEventSplitToBatchYieldAnalytics
        send phaseAdvanced to outlet BatchEventSplitToCycleTimeAnalytics
        send phaseAdvanced to outlet BatchEventSplitToEquipmentUtilization
        tell phaseAdvanced to entity BatchContext.Batch
      }
      on batchHeld: event Batch.BatchHeld is {
        send batchHeld to outlet BatchEventSplitToBatchYieldAnalytics
        send batchHeld to outlet BatchEventSplitToCycleTimeAnalytics
        send batchHeld to outlet BatchEventSplitToEquipmentUtilization
        tell batchHeld to entity BatchContext.Batch
      }
      on batchHoldReleased: event Batch.BatchHoldReleased is {
        send batchHoldReleased to outlet BatchEventSplitToBatchYieldAnalytics
        send batchHoldReleased to outlet BatchEventSplitToCycleTimeAnalytics
        send batchHoldReleased to outlet BatchEventSplitToEquipmentUtilization
        tell batchHoldReleased to entity BatchContext.Batch
      }
      on batchDischarged: event Batch.BatchDischarged is {
        send batchDischarged to outlet BatchEventSplitToBatchYieldAnalytics
        send batchDischarged to outlet BatchEventSplitToCycleTimeAnalytics
        send batchDischarged to outlet BatchEventSplitToEquipmentUtilization
        tell batchDischarged to entity BatchContext.Batch
      }
      on batchCompleted: event Batch.BatchCompleted is {
        send batchCompleted to outlet BatchEventSplitToBatchYieldAnalytics
        send batchCompleted to outlet BatchEventSplitToCycleTimeAnalytics
        send batchCompleted to outlet BatchEventSplitToEquipmentUtilization
        tell batchCompleted to entity BatchContext.Batch
      }
      on batchRejected: event Batch.BatchRejected is {
        send batchRejected to outlet BatchEventSplitToBatchYieldAnalytics
        send batchRejected to outlet BatchEventSplitToCycleTimeAnalytics
        send batchRejected to outlet BatchEventSplitToEquipmentUtilization
        tell batchRejected to entity BatchContext.Batch
      }
      on other is {
        error "Unexpected message for processor BatchEventSplit"
      }
    } with {
      briefly "Batch event fan-out handler"
      described as {
        |Delivers each Batch event to all of its consumers.
      }
    }
  } with {
    briefly "Batch event fan-out"
    described as {
      |Fans Batch events out to the repository and projectors.
    }
  }
  connector 'BatchEvent Stream' is from outlet BatchContext.Batch.BatchEvents2 to inlet BatchContext.BatchEventSplit.BatchEventSplitIn with {
    briefly "Batch events, fanned out to storage and read models"
  }
  connector 'BatchYieldAnalytics Feed' is from outlet BatchContext.BatchEventSplit.BatchEventSplitToBatchYieldAnalytics to inlet BatchContext.BatchYieldAnalytics.BatchYieldAnalyticsFromBatch with {
    briefly "Batch events feeding the BatchYieldAnalytics projection"
  }
  connector 'CycleTimeAnalytics Feed' is from outlet BatchContext.BatchEventSplit.BatchEventSplitToCycleTimeAnalytics to inlet BatchContext.CycleTimeAnalytics.CycleTimeAnalyticsFromBatch with {
    briefly "Batch events feeding the CycleTimeAnalytics projection"
  }
  connector 'EquipmentUtilization Feed' is from outlet BatchContext.BatchEventSplit.BatchEventSplitToEquipmentUtilization to inlet BatchContext.EquipmentUtilization.EquipmentUtilizationFromBatch with {
    briefly "Batch events feeding the EquipmentUtilization projection"
  }
  connector 'BatchYieldAnalytics Storage' is from outlet BatchContext.BatchYieldAnalytics.BatchYieldAnalyticsToRepository to inlet BatchContext.BatchRepository.BatchRepositoryFromBatchYieldAnalytics with {
    briefly "BatchYieldAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for batch processing"
  described as {
    | The BatchContext is the bounded context for
    | process manufacturing batch operations including
    | recipe execution, parameter tracking, and analytics.
  }
}
