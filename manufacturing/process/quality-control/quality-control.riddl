// Quality Control Domain Model
// Process manufacturing quality inspection and control
domain QualityControl is {
  persistent connector 'ProductionServiceReply Stream' is from outlet ProductionService.ProductionServiceRepliesOut to inlet QualityContext.ToProductionService.ToProductionServiceReplies with {
    briefly "What ProductionService answers QualityContext"
  }
  persistent connector 'LaboratoryInformationSystemReply Stream' is from outlet LaboratoryInformationSystem.LaboratoryInformationSystemRepliesOut to inlet QualityContext.ToLaboratoryInformationSystem.ToLaboratoryInformationSystemReplies with {
    briefly "What LaboratoryInformationSystem answers QualityContext"
  }
  persistent connector 'CAPAServiceReply Stream' is from outlet CAPAService.CAPAServiceRepliesOut to inlet QualityContext.ToCAPAService.ToCAPAServiceReplies with {
    briefly "What CAPAService answers QualityContext"
  }
  persistent connector 'CAPAServiceEvent Stream' is from outlet CAPAService.CAPAServiceEventsOut to inlet QualityContext.FromCAPAService.FromCAPAServiceIn with {
    briefly "What CAPAService tells QualityContext, unasked"
  }
  persistent connector 'LaboratoryInformationSystemEvent Stream' is from outlet LaboratoryInformationSystem.LaboratoryInformationSystemEventsOut to inlet QualityContext.FromLaboratoryInformationSystem.FromLaboratoryInformationSystemIn with {
    briefly "What LaboratoryInformationSystem tells QualityContext, unasked"
  }
  persistent connector 'ProductionServiceEvent Stream' is from outlet ProductionService.ProductionServiceEventsOut to inlet QualityContext.FromProductionService.FromProductionServiceIn with {
    briefly "What ProductionService tells QualityContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user QualityInspector is "person performing quality inspections" with {
    briefly "Quality Inspector"
    described as {
      |Person conducting inspections and recording test results.
    }
  }
  user QualityManager is "person managing quality operations" with {
    briefly "Quality Manager"
    described as {
      |Person overseeing quality control and approving dispositions.
    }
  }
  user LabTechnician is "person performing laboratory tests" with {
    briefly "Lab Technician"
    described as {
      |Person executing lab tests and analyzing samples.
    }
  }
  epic QualityInspectionEpic is {
    user QualityManager wants to "to ensure product quality through systematic inspection" so that "only conforming products reach customers"
    case PerformInspection is {
      user QualityInspector wants to "to inspect production lots for quality compliance" so that "non-conforming material is identified"
      step is "Inspector reviews" "inspection plan" "for the product specification" with {
        briefly "Review plan"
        described as {
          |Check inspection requirements.
        }
      }
      step is "Inspector collects" "samples from lot" "per sampling plan" with {
        briefly "Collect samples"
        described as {
          |Take representative samples.
        }
      }
      step take input QualityControlApp.QualityControlScreen.CollectSampleInput from user QualityInspector with {
        briefly "Record sample"
        described as {
          |Document sample collection.
        }
      }
      step is "Technician performs" "laboratory tests" "on samples" with {
        briefly "Test samples"
        described as {
          |Execute required tests.
        }
      }
      step take input QualityControlApp.QualityControlScreen.RecordTestResultInput from user LabTechnician with {
        briefly "Record result"
        described as {
          |Document test results.
        }
      }
      step take input QualityControlApp.QualityControlScreen.EvaluateResultsInput from user QualityInspector with {
        briefly "Evaluate"
        described as {
          |Compare results to specifications.
        }
      }
    } with {
      briefly "Quality inspection workflow"
      described as {
        |Collecting samples and recording test results.
      }
    }
    case HandleNonConformance is {
      user QualityManager wants to "to disposition non-conforming material" so that "appropriate corrective action is taken"
      step is "Manager reviews" "inspection results" "and non-conformance details" with {
        briefly "Review NC"
        described as {
          |Analyze non-conformance.
        }
      }
      step take input QualityControlApp.QualityControlScreen.InitiateNCRInput from user QualityManager with {
        briefly "Initiate NCR"
        described as {
          |Create non-conformance report.
        }
      }
      step is "CAPA system tracks" "corrective actions" "to closure" with {
        briefly "Track CAPA"
        described as {
          |Monitor corrective actions.
        }
      }
    } with {
      briefly "Non-conformance handling"
      described as {
        |Managing quality failures and corrective actions.
      }
    }
  } with {
    briefly "Quality inspection epic"
    described as {
      | Epic covering quality inspection processes including
      | sample collection, testing, evaluation, and NCR initiation.
    }
  }
  include "QualityContext.riddl"
  include "external-contexts.riddl"
  application context QualityControlApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in QualityControl are delivered.
      }
    }
    group QualityControlScreen is {
      input GetYieldSummaryInput acquires query QualityContext.GetYieldSummary with {
        briefly "Get yield summary control"
        described as {
          |The control through which a user asks the get yield summary question.
        }
      }
      input GetYieldTrendDataInput acquires query QualityContext.GetYieldTrendData with {
        briefly "Get yield trend data control"
        described as {
          |The control through which a user asks the get yield trend data question.
        }
      }
      input GetControlChartSummaryInput acquires query QualityContext.GetControlChartSummary with {
        briefly "Get control chart summary control"
        described as {
          |The control through which a user asks the get control chart summary question.
        }
      }
      input GetSPCDataPointInput acquires query QualityContext.GetSPCDataPoint with {
        briefly "Get SPC data point control"
        described as {
          |The control through which a user asks the get spc data point question.
        }
      }
      input GetDefectParetoDataInput acquires query QualityContext.GetDefectParetoData with {
        briefly "Get defect pareto data control"
        described as {
          |The control through which a user asks the get defect pareto data question.
        }
      }
      input GetInspectionInput acquires query QualityContext.Inspection.GetInspection with {
        briefly "Get inspection control"
        described as {
          |The control through which a user asks the get inspection question.
        }
      }
      input CreateInspectionInput acquires command QualityContext.CreateInspection with {
        briefly "Create inspection control"
        described as {
          |The control through which a user submits the create inspection request.
        }
      }
      input ApproveInspectionInput acquires command QualityContext.Inspection.ApproveInspection with {
        briefly "Approve inspection control"
        described as {
          |The control through which a user submits the approve inspection request.
        }
      }
      input CollectSampleInput acquires command QualityContext.Inspection.CollectSample with {
        briefly "Collect sample control"
        described as {
          |The control through which a user submits the collect sample request.
        }
      }
      input RecordTestResultInput acquires command QualityContext.Inspection.RecordTestResult with {
        briefly "Record test result control"
        described as {
          |The control through which a user submits the record test result request.
        }
      }
      input EvaluateResultsInput acquires command QualityContext.Inspection.EvaluateResults with {
        briefly "Evaluate results control"
        described as {
          |The control through which a user submits the evaluate results request.
        }
      }
      input InitiateNCRInput acquires command QualityContext.Inspection.InitiateNCR with {
        briefly "Initiate ncr control"
        described as {
          |The control through which a user submits the initiate ncr request.
        }
      }
    } with {
      briefly "Quality control screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppInspectionRepositoryQueries is type QualityContext.InspectionRepository.InspectionRepositoryQuery
    inlet AppInspectionRepositoryReplies is type QualityContext.InspectionRepository.InspectionRepositoryReply
    outlet AppInspectionQueries is query QualityContext.Inspection.GetInspection
    outlet AppInspectionCommands is type QualityContext.InspectionRequest
    inlet AppInspectionRepositoryResponses is result QualityContext.Inspection.InspectionQueryResult
    handler QualityControlAppHandler is {
      on other is {
        error "Unexpected message for application context QualityControlApp"
      }
    } with {
      briefly "QualityControlApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "QualityControlApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CAPAServiceRequest Stream' is from outlet QualityContext.ToCAPAService.ToCAPAServiceOut to inlet CAPAService.CAPAServiceRequests with {
    briefly "What QualityContext asks CAPAService to send"
  }
  persistent connector 'LaboratoryInformationSystemRequest Stream' is from outlet QualityContext.ToLaboratoryInformationSystem.ToLaboratoryInformationSystemOut to inlet LaboratoryInformationSystem.LaboratoryInformationSystemRequests with {
    briefly "What QualityContext asks LaboratoryInformationSystem to send"
  }
  persistent connector 'ProductionServiceRequest Stream' is from outlet QualityContext.ToProductionService.ToProductionServiceOut to inlet ProductionService.ProductionServiceRequests with {
    briefly "What QualityContext asks ProductionService to send"
  }
  persistent connector 'InspectionRepositoryQuery Stream' is from outlet QualityControlApp.AppInspectionRepositoryQueries to inlet QualityContext.InspectionRepositoryQueriesIn with {
    briefly "QualityControlApp's look-ups of the inspection repository"
  }
  persistent connector 'InspectionRepositoryReply Stream' is from outlet QualityContext.InspectionRepositoryRepliesOut to inlet QualityControlApp.AppInspectionRepositoryReplies with {
    briefly "The inspection repository's answers returned to QualityControlApp"
  }
  persistent connector 'InspectionQuery Stream' is from outlet QualityControlApp.AppInspectionQueries to inlet QualityContext.InspectionQueriesIn with {
    briefly "QualityControlApp's look-ups of the inspection"
  }
  persistent connector 'InspectionCommand Stream' is from outlet QualityControlApp.AppInspectionCommands to inlet QualityContext.InspectionCommandStreamIn with {
    briefly "Inspection commands from the application"
  }
  persistent connector 'InspectionQueryResult Stream' is from outlet QualityContext.InspectionQueryResultStreamOut to inlet QualityControlApp.AppInspectionRepositoryResponses with {
    briefly "Inspection query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet QualityControlApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Quality control domain"
  described as {
    | The QualityControl domain handles process manufacturing
    | quality inspection, testing, and compliance verification.
  }
}
