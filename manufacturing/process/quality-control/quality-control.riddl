// Quality Control Domain Model
// Process manufacturing quality inspection and control
domain QualityControl is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user QualityInspector is "person performing quality inspections" with {
    briefly "Quality Inspector"
    described as {
      |Person conducting inspections and recording test results.
    }
  }
  user QualityManager is "person managing quality operations" with {
    briefly "Quality Manager"
    described as {
      |Person overseeing quality control and approving dispositions.
    }
  }
  user LabTechnician is "person performing laboratory tests" with {
    briefly "Lab Technician"
    described as {
      |Person executing lab tests and analyzing samples.
    }
  }
  epic QualityInspectionEpic is {
    user QualityManager wants to "to ensure product quality through systematic inspection" so that "only conforming products reach customers"
    case PerformInspection is {
      user QualityInspector wants to "to inspect production lots for quality compliance" so that "non-conforming material is identified"
      step is "Inspector reviews" "inspection plan" "for the product specification" with {
        briefly "Review plan"
        described as {
          |Check inspection requirements.
        }
      }
      step is "Inspector collects" "samples from lot" "per sampling plan" with {
        briefly "Collect samples"
        described as {
          |Take representative samples.
        }
      }
      step take input QualityControlApp.QualityControlScreen.CollectSampleInput from user QualityInspector with {
        briefly "Record sample"
        described as {
          |Document sample collection.
        }
      }
      step is "Technician performs" "laboratory tests" "on samples" with {
        briefly "Test samples"
        described as {
          |Execute required tests.
        }
      }
      step take input QualityControlApp.QualityControlScreen.RecordTestResultInput from user LabTechnician with {
        briefly "Record result"
        described as {
          |Document test results.
        }
      }
      step take input QualityControlApp.QualityControlScreen.EvaluateResultsInput from user QualityInspector with {
        briefly "Evaluate"
        described as {
          |Compare results to specifications.
        }
      }
    } with {
      briefly "Quality inspection workflow"
      described as {
        |Collecting samples and recording test results.
      }
    }
    case HandleNonConformance is {
      user QualityManager wants to "to disposition non-conforming material" so that "appropriate corrective action is taken"
      step is "Manager reviews" "inspection results" "and non-conformance details" with {
        briefly "Review NC"
        described as {
          |Analyze non-conformance.
        }
      }
      step take input QualityControlApp.QualityControlScreen.InitiateNCRInput from user QualityManager with {
        briefly "Initiate NCR"
        described as {
          |Create non-conformance report.
        }
      }
      step is "CAPA system tracks" "corrective actions" "to closure" with {
        briefly "Track CAPA"
        described as {
          |Monitor corrective actions.
        }
      }
    } with {
      briefly "Non-conformance handling"
      described as {
        |Managing quality failures and corrective actions.
      }
    }
  } with {
    briefly "Quality inspection epic"
    described as {
      | Epic covering quality inspection processes including
      | sample collection, testing, evaluation, and NCR initiation.
    }
  }
  include "QualityContext.riddl"
  include "external-contexts.riddl"
  application context QualityControlApp is {
    group QualityControlScreen is {
      input CollectSampleInput acquires command QualityContext.Inspection.CollectSample with {
        briefly "Collect sample control"
        described as {
          |The control through which a user submits the collect sample request.
        }
      }
      input RecordTestResultInput acquires command QualityContext.Inspection.RecordTestResult with {
        briefly "Record test result control"
        described as {
          |The control through which a user submits the record test result request.
        }
      }
      input EvaluateResultsInput acquires command QualityContext.Inspection.EvaluateResults with {
        briefly "Evaluate results control"
        described as {
          |The control through which a user submits the evaluate results request.
        }
      }
      input InitiateNCRInput acquires command QualityContext.Inspection.InitiateNCR with {
        briefly "Initiate ncr control"
        described as {
          |The control through which a user submits the initiate ncr request.
        }
      }
    } with {
      briefly "Quality control screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppInspectionCommands is type QualityContext.Inspection.InspectionCommand
    inlet AppInspectionRepositoryResponses is type QualityContext.Inspection.InspectionQueryResult
    handler QualityControlAppHandler is {
      on other is {
        error "Unexpected message for application context QualityControlApp"
      }
    } with {
      briefly "QualityControlApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "QualityControlApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppInspectionCommands is {
    from outlet QualityControlApp.AppInspectionCommands to
      inlet QualityContext.Inspection.InspectionCommands
  } with {
    option is persistent
    briefly "LinkAppInspectionCommands"
  }
  connector LinkAppInspectionRepositoryResponses is {
    from outlet QualityContext.InspectionRepository.InspectionRepositoryResponses to
      inlet QualityControlApp.AppInspectionRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppInspectionRepositoryResponses"
  }
} with {
  briefly "Quality control domain"
  described as {
    | The QualityControl domain handles process manufacturing
    | quality inspection, testing, and compliance verification.
  }
}
