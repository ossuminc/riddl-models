// Quality Control - Quality Context
context QualityContext as router is {
  connector 'YieldTrendingAnalytics Storage' is from outlet QualityContext.YieldTrendingAnalytics.YieldTrendingAnalyticsToRepository to inlet QualityContext.InspectionRepository.InspectionRepositoryFromYieldTrendingAnalytics with {
    briefly "YieldTrendingAnalytics messages on their way to InspectionRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  connector 'SPCChartAnalytics Storage' is from outlet QualityContext.SPCChartAnalytics.SPCChartAnalyticsToRepository to inlet QualityContext.InspectionRepository.InspectionRepositoryFromSPCChartAnalytics with {
    briefly "SPCChartAnalytics messages on their way to InspectionRepository"
    described as {
      |The channel the `tell` travels.
    }
  }
  inlet InspectionCommandStreamIn is type InspectionCommand  outlet InspectionCommandStreamOut is type InspectionCommand
  inlet InspectionQueryResultStreamIn is result Inspection.InspectionQueryResult  outlet InspectionQueryResultStreamOut is result Inspection.InspectionQueryResult
  handler QualityContextBoundary is {
    on createInspection: command Inspection.CreateInspection is {
      send createInspection to outlet QualityContext.InspectionCommandStreamOut
    }
    on collectSample: command Inspection.CollectSample is {
      send collectSample to outlet QualityContext.InspectionCommandStreamOut
    }
    on recordTestResult: command Inspection.RecordTestResult is {
      send recordTestResult to outlet QualityContext.InspectionCommandStreamOut
    }
    on evaluateResults: command Inspection.EvaluateResults is {
      send evaluateResults to outlet QualityContext.InspectionCommandStreamOut
    }
    on approveInspection: command Inspection.ApproveInspection is {
      send approveInspection to outlet QualityContext.InspectionCommandStreamOut
    }
    on rejectInspection: command Inspection.RejectInspection is {
      send rejectInspection to outlet QualityContext.InspectionCommandStreamOut
    }
    on initiateNCR: command Inspection.InitiateNCR is {
      send initiateNCR to outlet QualityContext.InspectionCommandStreamOut
    }
    on inspectionQueryResult: result Inspection.InspectionQueryResult is {
      send inspectionQueryResult to outlet QualityContext.InspectionQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the QualityContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'InspectionCommand Stream Intake' is from outlet QualityContext.InspectionCommandStreamOut to inlet QualityContext.Inspection.InspectionCommands  connector 'InspectionQueryResult Stream Egress' is from outlet QualityContext.InspectionRepository.InspectionRepositoryResponses to inlet QualityContext.InspectionQueryResultStreamIn  adaptor FromCAPAService from context CAPAService is { 
    handler FromCAPAServiceHandler is {
      on event CAPAService.CAPAClosed is {
        do "the model receives capa closed"
      }
      on event CAPAService.CAPACreated is {
        do "the model receives capa created"
      }
      on event CAPAService.NCRLinkedToCAPA is {
        do "the model receives ncr linked to capa"
      }
      on result CAPAService.OpenCAPAs is {
        do "the model receives open cap as"
      }
      on other is {
        error "Unexpected message for adaptor FromCAPAService"
      }
    } with {
      briefly "from capa service"
      described as {
        |Carries messages from the external CAPAService.
      }
    }
  } with {
    briefly "CAPAService integration"
    described as {
      |The model's side of the CAPAService conversation.
    }
  }
  adaptor ToCAPAService to context CAPAService is { 
    handler ToCAPAServiceHandler is {
      on command CAPAService.CreateCAPA is {
        do "the model sends create capa"
      }
      on query CAPAService.GetCAPAStatus is {
        do "the model sends get capa status"
      }
      on query CAPAService.GetOpenCAPAsForProduct is {
        do "the model sends get open cap as for product"
      }
      on command CAPAService.LinkNCRToCAPA is {
        do "the model sends link ncr to capa"
      }
      on other is {
        error "Unexpected message for adaptor ToCAPAService"
      }
    } with {
      briefly "to capa service"
      described as {
        |Carries messages to the external CAPAService.
      }
    }
  } with {
    briefly "CAPAService integration"
    described as {
      |The model's side of the CAPAService conversation.
    }
  }
  adaptor FromLaboratoryInformationSystem from context LaboratoryInformationSystem is { 
    handler FromLaboratoryInformationSystemHandler is {
      on result LaboratoryInformationSystem.LabCapacity is {
        do "the model receives lab capacity"
      }
      on event LaboratoryInformationSystem.SampleReceived is {
        do "the model receives sample received"
      }
      on result LaboratoryInformationSystem.TestMethodDetails is {
        do "the model receives test method details"
      }
      on event LaboratoryInformationSystem.TestingCompleted is {
        do "the model receives testing completed"
      }
      on other is {
        error "Unexpected message for adaptor FromLaboratoryInformationSystem"
      }
    } with {
      briefly "from laboratory information system"
      described as {
        |Carries messages from the external LaboratoryInformationSystem.
      }
    }
  } with {
    briefly "LaboratoryInformationSystem integration"
    described as {
      |The model's side of the LaboratoryInformationSystem conversation.
    }
  }
  adaptor ToLaboratoryInformationSystem to context LaboratoryInformationSystem is { 
    handler ToLaboratoryInformationSystemHandler is {
      on query LaboratoryInformationSystem.GetLabCapacity is {
        do "the model sends get lab capacity"
      }
      on query LaboratoryInformationSystem.GetTestMethodDetails is {
        do "the model sends get test method details"
      }
      on command LaboratoryInformationSystem.SubmitSampleForTesting is {
        do "the model sends submit sample for testing"
      }
      on other is {
        error "Unexpected message for adaptor ToLaboratoryInformationSystem"
      }
    } with {
      briefly "to laboratory information system"
      described as {
        |Carries messages to the external LaboratoryInformationSystem.
      }
    }
  } with {
    briefly "LaboratoryInformationSystem integration"
    described as {
      |The model's side of the LaboratoryInformationSystem conversation.
    }
  }
  adaptor FromProductionService from context ProductionService is { 
    handler FromProductionServiceHandler is {
      on result ProductionService.LotDetails is {
        do "the model receives lot details"
      }
      on event ProductionService.LotPlacedOnHold is {
        do "the model receives lot placed on hold"
      }
      on event ProductionService.LotReleasedFromHold is {
        do "the model receives lot released from hold"
      }
      on result ProductionService.RelatedLots is {
        do "the model receives related lots"
      }
      on other is {
        error "Unexpected message for adaptor FromProductionService"
      }
    } with {
      briefly "from production service"
      described as {
        |Carries messages from the external ProductionService.
      }
    }
  } with {
    briefly "ProductionService integration"
    described as {
      |The model's side of the ProductionService conversation.
    }
  }
  adaptor ToProductionService to context ProductionService is { 
    handler ToProductionServiceHandler is {
      on query ProductionService.GetLotDetails is {
        do "the model sends get lot details"
      }
      on query ProductionService.GetRelatedLots is {
        do "the model sends get related lots"
      }
      on command ProductionService.PlaceLotOnQualityHold is {
        do "the model sends place lot on quality hold"
      }
      on command ProductionService.ReleaseLotFromHold is {
        do "the model sends release lot from hold"
      }
      on other is {
        error "Unexpected message for adaptor ToProductionService"
      }
    } with {
      briefly "to production service"
      described as {
        |Carries messages to the external ProductionService.
      }
    }
  } with {
    briefly "ProductionService integration"
    described as {
      |The model's side of the ProductionService conversation.
    }
  }
  include "types.riddl"
  include "Inspection.riddl"
  // Repository for inspection data persistence
  type InspectionRepositoryCommand is one of {
    QualityContext.InspectionRepository.PersistInspectionApproved or QualityContext.InspectionRepository.PersistInspectionCreated or QualityContext.InspectionRepository.PersistInspectionRejected or QualityContext.InspectionRepository.PersistNCRInitiated or QualityContext.InspectionRepository.PersistResultsEvaluated or QualityContext.InspectionRepository.PersistSampleCollected or QualityContext.InspectionRepository.PersistTestResultRecorded
  } with {
    briefly "Anything that writes InspectionRepository"
    described as {
      |The persistence commands InspectionRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository InspectionRepository as merge is {
    inlet InspectionRepositoryFromYieldTrendingAnalytics is type InspectionRepositoryCommand with {
      briefly "What YieldTrendingAnalytics sends InspectionRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet InspectionRepositoryFromSPCChartAnalytics is type InspectionRepositoryCommand with {
      briefly "What SPCChartAnalytics sends InspectionRepository"
      described as {
        |Its own inlet: an inlet accepts exactly one connector.
      }
    }
    inlet InspectionRepositoryFromDefectParetoAnalytics is type InspectionRepositoryCommand    command PersistInspectionCreated is {
      inspectionId: InspectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionCreated applies to.
        }
      }
    } with {
      briefly "Persist InspectionCreated"
      described as {
        |Instructs this repository to apply InspectionCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSampleCollected is {
      inspectionId: InspectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row SampleCollected applies to.
        }
      }
    } with {
      briefly "Persist SampleCollected"
      described as {
        |Instructs this repository to apply SampleCollected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInspectionApproved is {
      inspectionId: InspectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionApproved applies to.
        }
      }
    } with {
      briefly "Persist InspectionApproved"
      described as {
        |Instructs this repository to apply InspectionApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInspectionRejected is {
      inspectionId: InspectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row InspectionRejected applies to.
        }
      }
    } with {
      briefly "Persist InspectionRejected"
      described as {
        |Instructs this repository to apply InspectionRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNCRInitiated is {
      inspectionId: InspectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row NCRInitiated applies to.
        }
      }
    } with {
      briefly "Persist NCRInitiated"
      described as {
        |Instructs this repository to apply NCRInitiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistResultsEvaluated is {
      inspectionId: InspectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResultsEvaluated applies to.
        }
      }
    } with {
      briefly "Persist ResultsEvaluated"
      described as {
        |Instructs this repository to apply ResultsEvaluated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTestResultRecorded is {
      inspectionId: InspectionId with {
        briefly "Row addressed"
        described as {
          |Which stored row TestResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist TestResultRecorded"
      described as {
        |Instructs this repository to apply TestResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet InspectionRepositoryResponses is result Inspection.InspectionQueryResult
    record StoredInspection is {
      inspectionId: InspectionId with {
        briefly "inspectionId"
        described as {
          |The inspectionId column of the stored inspection row.
        }
      }
      finalResult: InspectionResult with {
        briefly "finalResult"
        described as {
          |The finalResult column of the stored inspection row.
        }
      }
      lot: LotInfo with {
        briefly "lot"
        described as {
          |The lot column of the stored inspection row.
        }
      }
    } with {
      briefly "Stored inspection row"
      described as {
        |The persistence shape of inspection data as this repository stores it.
      }
    }
    schema InspectionData is relational
      of inspections as record StoredInspection
        index on field StoredInspection.inspectionId
        index on field StoredInspection.lot.lotId
        index on field StoredInspection.finalResult
 with {
      briefly "Inspection data schema"
      described as {
        |The relational schema holding inspection data for the InspectionRepository.
      }
    }
    handler InspectionPersistence is {
      on persistInspectionCreated: command PersistInspectionCreated is {
        do "apply InspectionCreated to the stored row"
      }
      on persistSampleCollected: command PersistSampleCollected is {
        do "apply SampleCollected to the stored row"
      }
      on persistInspectionApproved: command PersistInspectionApproved is {
        do "apply InspectionApproved to the stored row"
      }
      on persistInspectionRejected: command PersistInspectionRejected is {
        do "apply InspectionRejected to the stored row"
      }
      on persistNCRInitiated: command PersistNCRInitiated is {
        do "apply NCRInitiated to the stored row"
      }
      on persistResultsEvaluated: command PersistResultsEvaluated is {
        do "apply ResultsEvaluated to the stored row"
      }
      on persistTestResultRecorded: command PersistTestResultRecorded is {
        do "apply TestResultRecorded to the stored row"
      }
      on query GetDefectParetoData is {
        let defectParetoDataView: type DefectParetoDataView = prompt("read the defect pareto data projection")
        reply defectParetoDataView
      }
      on query GetSPCDataPoint is {
        let sPCDataPointView: type SPCDataPointView = prompt("read the spc data point projection")
        reply sPCDataPointView
      }
      on query GetControlChartSummary is {
        let controlChartSummaryView: type ControlChartSummaryView = prompt("read the control chart summary projection")
        reply controlChartSummaryView
      }
      on query GetYieldTrendData is {
        let yieldTrendDataView: type YieldTrendDataView = prompt("read the yield trend data projection")
        reply yieldTrendDataView
      }
      on query GetYieldSummary is {
        let yieldSummaryView: type YieldSummaryView = prompt("read the yield summary projection")
        reply yieldSummaryView
      }
    } with {
      briefly "Persists inspection commands"
      described as {
        |Handles command-driven persistence for inspections.
      }
    }
  } with {
    briefly "Inspection data persistence"
    described as {
      | The InspectionRepository provides persistent storage for
      | inspections, samples, test results, and non-conformances.
    }
  }
  // Projector for defect Pareto analysis
  query GetDefectParetoData replies result DefectParetoDataView is {
    defectParetoDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which defect pareto data to retrieve.
      }
    }
  } with {
    briefly "Get defect pareto data"
    described as {
      |Retrieves the defect pareto data projection.
    }
  }
  result DefectParetoDataView is {
    defectParetoData: DefectParetoAnalytics.DefectParetoData with {
      briefly "Defect pareto data"
      described as {
        |The defect pareto data being returned.
      }
    }
  } with {
    briefly "Defect pareto data view"
    described as {
      |Read model view carrying the defect pareto data projection.
    }
  }
  projector DefectParetoAnalytics as flow is {
    updates repository QualityContext.InspectionRepository
    outlet DefectParetoAnalyticsToRepository is type InspectionRepositoryCommand
    inlet DefectParetoAnalyticsFromInspection is type InspectionEvent    record DefectParetoData is {
      defectCategory: String(1,100) with {
        briefly "Category"
        described as {
          |Defect category.
        }
      }
      occurrenceCount: Natural with {
        briefly "Count"
        described as {
          |Number of occurrences.
        }
      }
      cumulativePercent: Decimal(5,2) with {
        briefly "Cumulative"
        described as {
          |Cumulative percentage.
        }
      }
      affectedQuantity: Decimal(15,4) with {
        briefly "Quantity"
        described as {
          |Affected quantity.
        }
      }
      productCode: String(1,50) with {
        briefly "Product"
        described as {
          |Product code.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Analysis period end.
        }
      }
    } with {
      briefly "Defect Pareto data"
      described as {
        |Defect frequency analysis data.
      }
    }
    handler DefectParetoHandler is {
      on inspectionApproved: event Inspection.InspectionApproved is {
        tell command QualityContext.InspectionRepository.PersistInspectionApproved(inspectionId = inspectionApproved.inspectionId) to repository QualityContext.InspectionRepository
        do "apply InspectionApproved to the DefectParetoAnalytics projection"
      }
      on inspectionCreated: event Inspection.InspectionCreated is {
        tell command QualityContext.InspectionRepository.PersistInspectionCreated(inspectionId = inspectionCreated.inspectionId) to repository QualityContext.InspectionRepository
        do "apply InspectionCreated to the DefectParetoAnalytics projection"
      }
      on resultsEvaluated: event Inspection.ResultsEvaluated is {
        tell command QualityContext.InspectionRepository.PersistResultsEvaluated(inspectionId = resultsEvaluated.inspectionId) to repository QualityContext.InspectionRepository
        do "apply ResultsEvaluated to the DefectParetoAnalytics projection"
      }
      on sampleCollected: event Inspection.SampleCollected is {
        tell command QualityContext.InspectionRepository.PersistSampleCollected(inspectionId = sampleCollected.inspectionId) to repository QualityContext.InspectionRepository
        do "apply SampleCollected to the DefectParetoAnalytics projection"
      }
      on inspectionRejected: event Inspection.InspectionRejected is {
        tell command QualityContext.InspectionRepository.PersistInspectionRejected(inspectionId = inspectionRejected.inspectionId) to repository QualityContext.InspectionRepository
        do "Update defect category counts"
      }
      on nCRInitiated: event Inspection.NCRInitiated is {
        tell command QualityContext.InspectionRepository.PersistNCRInitiated(inspectionId = nCRInitiated.inspectionId) to repository QualityContext.InspectionRepository
        do "Increment defect occurrence for NCR category"
      }
      on testResultRecorded: event Inspection.TestResultRecorded is {
        tell command QualityContext.InspectionRepository.PersistTestResultRecorded(inspectionId = testResultRecorded.inspectionId) to repository QualityContext.InspectionRepository
        do "Track out-of-spec results by parameter"
      }
    } with {
      briefly "Maintains defect Pareto analysis"
      described as {
        |Projects defect events into Pareto chart data.
      }
    }
  } with {
    briefly "Defect Pareto projections"
    described as {
      |Maintains defect Pareto analysis for quality improvement.
    }
  }
  // Projector for Statistical Process Control (SPC) charts
  query GetSPCDataPoint replies result SPCDataPointView is {
    sPCDataPointKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which spc data point to retrieve.
      }
    }
  } with {
    briefly "Get spc data point"
    described as {
      |Retrieves the spc data point projection.
    }
  }
  result SPCDataPointView is {
    sPCDataPoint: SPCChartAnalytics.SPCDataPoint with {
      briefly "Spc data point"
      described as {
        |The spc data point being returned.
      }
    }
  } with {
    briefly "Spc data point view"
    described as {
      |Read model view carrying the spc data point projection.
    }
  }
  query GetControlChartSummary replies result ControlChartSummaryView is {
    controlChartSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which control chart summary to retrieve.
      }
    }
  } with {
    briefly "Get control chart summary"
    described as {
      |Retrieves the control chart summary projection.
    }
  }
  result ControlChartSummaryView is {
    controlChartSummary: SPCChartAnalytics.ControlChartSummary with {
      briefly "Control chart summary"
      described as {
        |The control chart summary being returned.
      }
    }
  } with {
    briefly "Control chart summary view"
    described as {
      |Read model view carrying the control chart summary projection.
    }
  }
  projector SPCChartAnalytics as flow is {
    updates repository QualityContext.InspectionRepository
    outlet SPCChartAnalyticsToRepository is type InspectionRepositoryCommand
 with {
      briefly "What SPCChartAnalytics publishes to InspectionRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to InspectionRepository needs this port to travel on.
      }
    }
    inlet SPCChartAnalyticsFromInspection is type InspectionEvent    record SPCDataPoint is {
      parameter: String(1,100) with {
        briefly "Parameter"
        described as {
          |Measured parameter.
        }
      }
      measuredValue: Decimal(15,6) with {
        briefly "Value"
        described as {
          |Measured value.
        }
      }
      sampleId: SampleId with {
        briefly "Sample"
        described as {
          |Sample identifier.
        }
      }
      lotId: LotId with {
        briefly "Lot"
        described as {
          |Lot identifier.
        }
      }
      timestamp: TimeStamp with {
        briefly "Time"
        described as {
          |Measurement time.
        }
      }
      mean: Decimal(15,6) with {
        briefly "Mean"
        described as {
          |Running mean.
        }
      }
      standardDeviation: Decimal(15,6) with {
        briefly "StdDev"
        described as {
          |Standard deviation.
        }
      }
      upperControlLimit: Decimal(15,6) with {
        briefly "UCL"
        described as {
          |Upper control limit.
        }
      }
      lowerControlLimit: Decimal(15,6) with {
        briefly "LCL"
        described as {
          |Lower control limit.
        }
      }
      isOutOfControl: Boolean with {
        briefly "OOC"
        described as {
          |Out of control indicator.
        }
      }
    } with {
      briefly "SPC data point"
      described as {
        |Statistical process control data point.
      }
    }
    record ControlChartSummary is {
      parameter: String(1,100) with {
        briefly "Parameter"
        described as {
          |Measured parameter.
        }
      }
      processCapabilityIndex: Decimal(5,3) with {
        briefly "Cpk"
        described as {
          |Process capability index.
        }
      }
      processPerformanceIndex: Decimal(5,3) with {
        briefly "Ppk"
        described as {
          |Process performance index.
        }
      }
      centerLine: Decimal(15,6) with {
        briefly "CL"
        described as {
          |Center line (mean).
        }
      }
      oocCount: Natural with {
        briefly "OOC count"
        described as {
          |Out of control count.
        }
      }
      totalPoints: Natural with {
        briefly "Total"
        described as {
          |Total data points.
        }
      }
    } with {
      briefly "Control chart summary"
      described as {
        |Summary statistics for control chart.
      }
    }
    handler SPCHandler is {
      on inspectionApproved: event Inspection.InspectionApproved is {
        tell command QualityContext.InspectionRepository.PersistInspectionApproved(inspectionId = inspectionApproved.inspectionId) to repository QualityContext.InspectionRepository
        do "apply InspectionApproved to the SPCChartAnalytics projection"
      }
      on inspectionCreated: event Inspection.InspectionCreated is {
        tell command QualityContext.InspectionRepository.PersistInspectionCreated(inspectionId = inspectionCreated.inspectionId) to repository QualityContext.InspectionRepository
        do "apply InspectionCreated to the SPCChartAnalytics projection"
      }
      on inspectionRejected: event Inspection.InspectionRejected is {
        tell command QualityContext.InspectionRepository.PersistInspectionRejected(inspectionId = inspectionRejected.inspectionId) to repository QualityContext.InspectionRepository
        do "apply InspectionRejected to the SPCChartAnalytics projection"
      }
      on nCRInitiated: event Inspection.NCRInitiated is {
        tell command QualityContext.InspectionRepository.PersistNCRInitiated(inspectionId = nCRInitiated.inspectionId) to repository QualityContext.InspectionRepository
        do "apply NCRInitiated to the SPCChartAnalytics projection"
      }
      on resultsEvaluated: event Inspection.ResultsEvaluated is {
        tell command QualityContext.InspectionRepository.PersistResultsEvaluated(inspectionId = resultsEvaluated.inspectionId) to repository QualityContext.InspectionRepository
        do "apply ResultsEvaluated to the SPCChartAnalytics projection"
      }
      on sampleCollected: event Inspection.SampleCollected is {
        tell command QualityContext.InspectionRepository.PersistSampleCollected(inspectionId = sampleCollected.inspectionId) to repository QualityContext.InspectionRepository
        do "apply SampleCollected to the SPCChartAnalytics projection"
      }
      on testResultRecorded: event Inspection.TestResultRecorded is {
        tell command QualityContext.InspectionRepository.PersistTestResultRecorded(inspectionId = testResultRecorded.inspectionId) to repository QualityContext.InspectionRepository
        do "Add data point and recalculate control limits"
      }
    } with {
      briefly "Maintains SPC chart data"
      described as {
        |Projects test results into SPC chart data.
      }
    }
  } with {
    briefly "SPC chart projections"
    described as {
      |Maintains Statistical Process Control chart data.
    }
  }
  // Projector for yield trending
  query GetYieldTrendData replies result YieldTrendDataView is {
    yieldTrendDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which yield trend data to retrieve.
      }
    }
  } with {
    briefly "Get yield trend data"
    described as {
      |Retrieves the yield trend data projection.
    }
  }
  result YieldTrendDataView is {
    yieldTrendData: YieldTrendingAnalytics.YieldTrendData with {
      briefly "Yield trend data"
      described as {
        |The yield trend data being returned.
      }
    }
  } with {
    briefly "Yield trend data view"
    described as {
      |Read model view carrying the yield trend data projection.
    }
  }
  query GetYieldSummary replies result YieldSummaryView is {
    yieldSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which yield summary to retrieve.
      }
    }
  } with {
    briefly "Get yield summary"
    described as {
      |Retrieves the yield summary projection.
    }
  }
  result YieldSummaryView is {
    yieldSummary: YieldTrendingAnalytics.YieldSummary with {
      briefly "Yield summary"
      described as {
        |The yield summary being returned.
      }
    }
  } with {
    briefly "Yield summary view"
    described as {
      |Read model view carrying the yield summary projection.
    }
  }
  projector YieldTrendingAnalytics as flow is {
    updates repository QualityContext.InspectionRepository
    outlet YieldTrendingAnalyticsToRepository is type InspectionRepositoryCommand
 with {
      briefly "What YieldTrendingAnalytics publishes to InspectionRepository"
      described as {
        |A sender publishes only through its OWN outlet, so the
        |`tell` to InspectionRepository needs this port to travel on.
      }
    }
    inlet YieldTrendingAnalyticsFromInspection is type InspectionEvent    record YieldTrendData is {
      periodDate: Date with {
        briefly "Date"
        described as {
          |Period date.
        }
      }
      productCode: String(1,50) with {
        briefly "Product"
        described as {
          |Product code.
        }
      }
      inspectionCount: Natural with {
        briefly "Inspections"
        described as {
          |Number of inspections.
        }
      }
      passCount: Natural with {
        briefly "Passed"
        described as {
          |Passed inspections.
        }
      }
      failCount: Natural with {
        briefly "Failed"
        described as {
          |Failed inspections.
        }
      }
      conditionalCount: Natural with {
        briefly "Conditional"
        described as {
          |Conditional passes.
        }
      }
      firstPassYield: Decimal(5,4) with {
        briefly "FPY"
        described as {
          |First pass yield.
        }
      }
      rolledThroughputYield: Decimal(5,4) with {
        briefly "RTY"
        described as {
          |Rolled throughput yield.
        }
      }
      totalQuantityInspected: Decimal(15,4) with {
        briefly "Inspected"
        described as {
          |Total quantity inspected.
        }
      }
      totalQuantityPassed: Decimal(15,4) with {
        briefly "Passed qty"
        described as {
          |Quantity passed.
        }
      }
      totalQuantityRejected: Decimal(15,4) with {
        briefly "Rejected qty"
        described as {
          |Quantity rejected.
        }
      }
    } with {
      briefly "Yield trend data"
      described as {
        |Quality yield trending data.
      }
    }
    record YieldSummary is {
      productCode: String(1,50) with {
        briefly "Product"
        described as {
          |Product code.
        }
      }
      periodType: String(1,20) with {
        briefly "Period"
        described as {
          |Period type (day/week/month).
        }
      }
      averageYield: Decimal(5,4) with {
        briefly "Avg yield"
        described as {
          |Average yield.
        }
      }
      yieldTrend: Decimal(6,4) with {
        briefly "Trend"
        described as {
          |Yield trend (positive=improving).
        }
      }
      targetYield: Decimal(5,4) with {
        briefly "Target"
        described as {
          |Target yield.
        }
      }
      gapToTarget: Decimal(6,4) with {
        briefly "Gap"
        described as {
          |Gap to target.
        }
      }
    } with {
      briefly "Yield summary"
      described as {
        |Yield performance summary.
      }
    }
    handler YieldHandler is {
      on inspectionCreated: event Inspection.InspectionCreated is {
        tell command QualityContext.InspectionRepository.PersistInspectionCreated(inspectionId = inspectionCreated.inspectionId) to repository QualityContext.InspectionRepository
        do "apply InspectionCreated to the YieldTrendingAnalytics projection"
      }
      on nCRInitiated: event Inspection.NCRInitiated is {
        tell command QualityContext.InspectionRepository.PersistNCRInitiated(inspectionId = nCRInitiated.inspectionId) to repository QualityContext.InspectionRepository
        do "apply NCRInitiated to the YieldTrendingAnalytics projection"
      }
      on sampleCollected: event Inspection.SampleCollected is {
        tell command QualityContext.InspectionRepository.PersistSampleCollected(inspectionId = sampleCollected.inspectionId) to repository QualityContext.InspectionRepository
        do "apply SampleCollected to the YieldTrendingAnalytics projection"
      }
      on testResultRecorded: event Inspection.TestResultRecorded is {
        tell command QualityContext.InspectionRepository.PersistTestResultRecorded(inspectionId = testResultRecorded.inspectionId) to repository QualityContext.InspectionRepository
        do "apply TestResultRecorded to the YieldTrendingAnalytics projection"
      }
      on inspectionApproved: event Inspection.InspectionApproved is {
        tell command QualityContext.InspectionRepository.PersistInspectionApproved(inspectionId = inspectionApproved.inspectionId) to repository QualityContext.InspectionRepository
        do "Increment pass counts and update yield"
      }
      on inspectionRejected: event Inspection.InspectionRejected is {
        tell command QualityContext.InspectionRepository.PersistInspectionRejected(inspectionId = inspectionRejected.inspectionId) to repository QualityContext.InspectionRepository
        do "Increment fail counts and update yield"
      }
      on resultsEvaluated: event Inspection.ResultsEvaluated is {
        tell command QualityContext.InspectionRepository.PersistResultsEvaluated(inspectionId = resultsEvaluated.inspectionId) to repository QualityContext.InspectionRepository
        do "Update inspection counts for period"
      }
    } with {
      briefly "Maintains yield trending data"
      described as {
        |Projects inspection results into yield trend analytics.
      }
    }
  } with {
    briefly "Yield trending projections"
    described as {
      |Maintains yield trending analytics for quality performance.
    }
  }
  // ---- Event publication for Inspection ----
  type InspectionEvent is one of {
    QualityContext.Inspection.InspectionCreated or QualityContext.Inspection.SampleCollected or QualityContext.Inspection.TestResultRecorded or QualityContext.Inspection.ResultsEvaluated or QualityContext.Inspection.InspectionApproved or QualityContext.Inspection.InspectionRejected or QualityContext.Inspection.NCRInitiated
  } with {
    briefly "Inspection event alternation"
    described as {
      |Union of all Inspection events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet InspectionEventSplit as split is {
    inlet InspectionEventSplitIn is type InspectionEvent    outlet InspectionEventSplitToDefectParetoAnalytics is type InspectionEvent
    outlet InspectionEventSplitToSPCChartAnalytics is type InspectionEvent
    outlet InspectionEventSplitToYieldTrendingAnalytics is type InspectionEvent
    handler InspectionEventSplitHandler is {
      on inspectionCreated: event Inspection.InspectionCreated is {
        send inspectionCreated to outlet InspectionEventSplitToDefectParetoAnalytics
        send inspectionCreated to outlet InspectionEventSplitToSPCChartAnalytics
        send inspectionCreated to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell inspectionCreated to entity QualityContext.Inspection
      }
      on sampleCollected: event Inspection.SampleCollected is {
        send sampleCollected to outlet InspectionEventSplitToDefectParetoAnalytics
        send sampleCollected to outlet InspectionEventSplitToSPCChartAnalytics
        send sampleCollected to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell sampleCollected to entity QualityContext.Inspection
      }
      on testResultRecorded: event Inspection.TestResultRecorded is {
        send testResultRecorded to outlet InspectionEventSplitToDefectParetoAnalytics
        send testResultRecorded to outlet InspectionEventSplitToSPCChartAnalytics
        send testResultRecorded to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell testResultRecorded to entity QualityContext.Inspection
      }
      on resultsEvaluated: event Inspection.ResultsEvaluated is {
        send resultsEvaluated to outlet InspectionEventSplitToDefectParetoAnalytics
        send resultsEvaluated to outlet InspectionEventSplitToSPCChartAnalytics
        send resultsEvaluated to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell resultsEvaluated to entity QualityContext.Inspection
      }
      on inspectionApproved: event Inspection.InspectionApproved is {
        send inspectionApproved to outlet InspectionEventSplitToDefectParetoAnalytics
        send inspectionApproved to outlet InspectionEventSplitToSPCChartAnalytics
        send inspectionApproved to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell inspectionApproved to entity QualityContext.Inspection
      }
      on inspectionRejected: event Inspection.InspectionRejected is {
        send inspectionRejected to outlet InspectionEventSplitToDefectParetoAnalytics
        send inspectionRejected to outlet InspectionEventSplitToSPCChartAnalytics
        send inspectionRejected to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell inspectionRejected to entity QualityContext.Inspection
      }
      on nCRInitiated: event Inspection.NCRInitiated is {
        send nCRInitiated to outlet InspectionEventSplitToDefectParetoAnalytics
        send nCRInitiated to outlet InspectionEventSplitToSPCChartAnalytics
        send nCRInitiated to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell nCRInitiated to entity QualityContext.Inspection
      }
      on other is {
        error "Unexpected message for processor InspectionEventSplit"
      }
    } with {
      briefly "Inspection event fan-out handler"
      described as {
        |Delivers each Inspection event to all of its consumers.
      }
    }
  } with {
    briefly "Inspection event fan-out"
    described as {
      |Fans Inspection events out to the repository and projectors.
    }
  }
  connector 'InspectionEvent Stream' is from outlet QualityContext.Inspection.InspectionEvents2 to inlet QualityContext.InspectionEventSplit.InspectionEventSplitIn with {
    briefly "Inspection events, fanned out to storage and read models"
  }
  connector 'DefectParetoAnalytics Feed' is from outlet QualityContext.InspectionEventSplit.InspectionEventSplitToDefectParetoAnalytics to inlet QualityContext.DefectParetoAnalytics.DefectParetoAnalyticsFromInspection with {
    briefly "Inspection events feeding the DefectParetoAnalytics projection"
  }
  connector 'SPCChartAnalytics Feed' is from outlet QualityContext.InspectionEventSplit.InspectionEventSplitToSPCChartAnalytics to inlet QualityContext.SPCChartAnalytics.SPCChartAnalyticsFromInspection with {
    briefly "Inspection events feeding the SPCChartAnalytics projection"
  }
  connector 'YieldTrendingAnalytics Feed' is from outlet QualityContext.InspectionEventSplit.InspectionEventSplitToYieldTrendingAnalytics to inlet QualityContext.YieldTrendingAnalytics.YieldTrendingAnalyticsFromInspection with {
    briefly "Inspection events feeding the YieldTrendingAnalytics projection"
  }
  connector 'DefectParetoAnalytics Storage' is from outlet QualityContext.DefectParetoAnalytics.DefectParetoAnalyticsToRepository to inlet QualityContext.InspectionRepository.InspectionRepositoryFromDefectParetoAnalytics with {
    briefly "DefectParetoAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for quality control"
  described as {
    | The QualityContext is the bounded context for
    | quality inspections, testing, and analytics.
  }
}
