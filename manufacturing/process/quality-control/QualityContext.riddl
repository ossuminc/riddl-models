// Quality Control - Quality Context
context QualityContext is {
  adaptor FromCAPAService from context CAPAService is { 
    handler FromCAPAServiceHandler is {
      on event CAPAService.CAPAClosed is {
        do "the model receives capa closed"
      }
      on event CAPAService.CAPACreated is {
        do "the model receives capa created"
      }
      on event CAPAService.NCRLinkedToCAPA is {
        do "the model receives ncr linked to capa"
      }
      on result CAPAService.OpenCAPAs is {
        do "the model receives open cap as"
      }
      on other is {
        error "Unexpected message for adaptor FromCAPAService"
      }
    } with {
      briefly "from capa service"
      described as {
        |Carries messages from the external CAPAService.
      }
    }
  } with {
    briefly "CAPAService integration"
    described as {
      |The model's side of the CAPAService conversation.
    }
  }
  adaptor ToCAPAService to context CAPAService is { 
    handler ToCAPAServiceHandler is {
      on command CAPAService.CreateCAPA is {
        do "the model sends create capa"
      }
      on query CAPAService.GetCAPAStatus is {
        do "the model sends get capa status"
      }
      on query CAPAService.GetOpenCAPAsForProduct is {
        do "the model sends get open cap as for product"
      }
      on command CAPAService.LinkNCRToCAPA is {
        do "the model sends link ncr to capa"
      }
      on other is {
        error "Unexpected message for adaptor ToCAPAService"
      }
    } with {
      briefly "to capa service"
      described as {
        |Carries messages to the external CAPAService.
      }
    }
  } with {
    briefly "CAPAService integration"
    described as {
      |The model's side of the CAPAService conversation.
    }
  }
  adaptor FromLaboratoryInformationSystem from context LaboratoryInformationSystem is { 
    handler FromLaboratoryInformationSystemHandler is {
      on result LaboratoryInformationSystem.LabCapacity is {
        do "the model receives lab capacity"
      }
      on event LaboratoryInformationSystem.SampleReceived is {
        do "the model receives sample received"
      }
      on result LaboratoryInformationSystem.TestMethodDetails is {
        do "the model receives test method details"
      }
      on event LaboratoryInformationSystem.TestingCompleted is {
        do "the model receives testing completed"
      }
      on other is {
        error "Unexpected message for adaptor FromLaboratoryInformationSystem"
      }
    } with {
      briefly "from laboratory information system"
      described as {
        |Carries messages from the external LaboratoryInformationSystem.
      }
    }
  } with {
    briefly "LaboratoryInformationSystem integration"
    described as {
      |The model's side of the LaboratoryInformationSystem conversation.
    }
  }
  adaptor ToLaboratoryInformationSystem to context LaboratoryInformationSystem is { 
    handler ToLaboratoryInformationSystemHandler is {
      on query LaboratoryInformationSystem.GetLabCapacity is {
        do "the model sends get lab capacity"
      }
      on query LaboratoryInformationSystem.GetTestMethodDetails is {
        do "the model sends get test method details"
      }
      on command LaboratoryInformationSystem.SubmitSampleForTesting is {
        do "the model sends submit sample for testing"
      }
      on other is {
        error "Unexpected message for adaptor ToLaboratoryInformationSystem"
      }
    } with {
      briefly "to laboratory information system"
      described as {
        |Carries messages to the external LaboratoryInformationSystem.
      }
    }
  } with {
    briefly "LaboratoryInformationSystem integration"
    described as {
      |The model's side of the LaboratoryInformationSystem conversation.
    }
  }
  adaptor FromProductionService from context ProductionService is { 
    handler FromProductionServiceHandler is {
      on result ProductionService.LotDetails is {
        do "the model receives lot details"
      }
      on event ProductionService.LotPlacedOnHold is {
        do "the model receives lot placed on hold"
      }
      on event ProductionService.LotReleasedFromHold is {
        do "the model receives lot released from hold"
      }
      on result ProductionService.RelatedLots is {
        do "the model receives related lots"
      }
      on other is {
        error "Unexpected message for adaptor FromProductionService"
      }
    } with {
      briefly "from production service"
      described as {
        |Carries messages from the external ProductionService.
      }
    }
  } with {
    briefly "ProductionService integration"
    described as {
      |The model's side of the ProductionService conversation.
    }
  }
  adaptor ToProductionService to context ProductionService is { 
    handler ToProductionServiceHandler is {
      on query ProductionService.GetLotDetails is {
        do "the model sends get lot details"
      }
      on query ProductionService.GetRelatedLots is {
        do "the model sends get related lots"
      }
      on command ProductionService.PlaceLotOnQualityHold is {
        do "the model sends place lot on quality hold"
      }
      on command ProductionService.ReleaseLotFromHold is {
        do "the model sends release lot from hold"
      }
      on other is {
        error "Unexpected message for adaptor ToProductionService"
      }
    } with {
      briefly "to production service"
      described as {
        |Carries messages to the external ProductionService.
      }
    }
  } with {
    briefly "ProductionService integration"
    described as {
      |The model's side of the ProductionService conversation.
    }
  }
  include "types.riddl"
  include "Inspection.riddl"
  // Repository for inspection data persistence
  repository InspectionRepository as merge is {
    inlet InspectionRepositoryFromInspection is type InspectionEvent    inlet InspectionRepositoryFromDefectParetoAnalytics is type InspectionEvent    inlet InspectionRepositoryFromSPCChartAnalytics is type InspectionEvent    inlet InspectionRepositoryFromYieldTrendingAnalytics is type InspectionEvent    outlet InspectionRepositoryResponses is type Inspection.InspectionQueryResult
    record StoredInspection is  {
      inspectionId: InspectionId with {
        briefly "inspectionId"
        described as {
          |The inspectionId column of the stored inspection row.
        }
      }
      finalResult: InspectionResult with {
        briefly "finalResult"
        described as {
          |The finalResult column of the stored inspection row.
        }
      }
      lot: LotInfo with {
        briefly "lot"
        described as {
          |The lot column of the stored inspection row.
        }
      }
    } with {
      briefly "Stored inspection row"
      described as {
        |The persistence shape of inspection data as this repository stores it.
      }
    }
    schema InspectionData is relational
      of inspections as type StoredInspection
        index on field StoredInspection.inspectionId
        index on field StoredInspection.lot.lotId
        index on field StoredInspection.finalResult
 with {
      briefly "Inspection data schema"
      described as {
        |The relational schema holding inspection data for the InspectionRepository.
      }
    }
    handler InspectionPersistence is {
      on query GetDefectParetoData is {
        do "read the defect pareto data projection"
        reply result DefectParetoDataView
      }
      on query GetSPCDataPoint is {
        do "read the spc data point projection"
        reply result SPCDataPointView
      }
      on query GetControlChartSummary is {
        do "read the control chart summary projection"
        reply result ControlChartSummaryView
      }
      on query GetYieldTrendData is {
        do "read the yield trend data projection"
        reply result YieldTrendDataView
      }
      on query GetYieldSummary is {
        do "read the yield summary projection"
        reply result YieldSummaryView
      }
      on command Inspection.CreateInspection is {
        tell event Inspection.InspectionCreated to entity QualityContext.Inspection
        do "Store new inspection record"
      }
      on command Inspection.CollectSample is {
        do "Store sample collection"
      }
      on command Inspection.RecordTestResult is {
        tell event Inspection.TestResultRecorded to entity QualityContext.Inspection
        do "Store test result"
      }
      on command Inspection.EvaluateResults is {
        do "Update evaluation summary"
      }
      on command Inspection.ApproveInspection is {
        tell event Inspection.InspectionApproved to entity QualityContext.Inspection
        do "Update to approved status"
      }
      on command Inspection.RejectInspection is {
        tell event Inspection.InspectionRejected to entity QualityContext.Inspection
        do "Update to rejected status"
      }
      on command Inspection.InitiateNCR is {
        tell event Inspection.NCRInitiated to entity QualityContext.Inspection
        do "Store non-conformance record"
      }
    } with {
      briefly "Persists inspection commands"
      described as {
        |Handles command-driven persistence for inspections.
      }
    }
  } with {
    briefly "Inspection data persistence"
    described as {
      | The InspectionRepository provides persistent storage for
      | inspections, samples, test results, and non-conformances.
    }
  }
  // Projector for defect Pareto analysis
  query GetDefectParetoData is  {
    defectParetoDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which defect pareto data to retrieve.
      }
    }
  } with {
    briefly "Get defect pareto data"
    described as {
      |Retrieves the defect pareto data projection.
    }
  }
  result DefectParetoDataView is  {
    defectParetoData: DefectParetoAnalytics.DefectParetoData with {
      briefly "Defect pareto data"
      described as {
        |The defect pareto data being returned.
      }
    }
  } with {
    briefly "Defect pareto data view"
    described as {
      |Read model view carrying the defect pareto data projection.
    }
  }
  projector DefectParetoAnalytics as flow is {
    updates repository QualityContext.InspectionRepository
    inlet DefectParetoAnalyticsFromInspection is type InspectionEvent    outlet DefectParetoAnalyticsOut is type InspectionEvent
    record DefectParetoData is  {
      defectCategory: String(1,100) with {
        briefly "Category"
        described as {
          |Defect category.
        }
      }
      occurrenceCount: Natural with {
        briefly "Count"
        described as {
          |Number of occurrences.
        }
      }
      cumulativePercent: Decimal(5,2) with {
        briefly "Cumulative"
        described as {
          |Cumulative percentage.
        }
      }
      affectedQuantity: Decimal(15,4) with {
        briefly "Quantity"
        described as {
          |Affected quantity.
        }
      }
      productCode: String(1,50) with {
        briefly "Product"
        described as {
          |Product code.
        }
      }
      periodStart: Date with {
        briefly "Start"
        described as {
          |Analysis period start.
        }
      }
      periodEnd: Date with {
        briefly "End"
        described as {
          |Analysis period end.
        }
      }
    } with {
      briefly "Defect Pareto data"
      described as {
        |Defect frequency analysis data.
      }
    }
    handler DefectParetoHandler is {
      on event Inspection.InspectionRejected is {
        tell event Inspection.InspectionRejected to repository QualityContext.InspectionRepository
        do "Update defect category counts"
      }
      on event Inspection.NCRInitiated is {
        tell event Inspection.NCRInitiated to repository QualityContext.InspectionRepository
        do "Increment defect occurrence for NCR category"
      }
      on event Inspection.TestResultRecorded is {
        tell event Inspection.TestResultRecorded to repository QualityContext.InspectionRepository
        do "Track out-of-spec results by parameter"
      }
    } with {
      briefly "Maintains defect Pareto analysis"
      described as {
        |Projects defect events into Pareto chart data.
      }
    }
  } with {
    briefly "Defect Pareto projections"
    described as {
      |Maintains defect Pareto analysis for quality improvement.
    }
  }
  // Projector for Statistical Process Control (SPC) charts
  query GetSPCDataPoint is  {
    sPCDataPointKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which spc data point to retrieve.
      }
    }
  } with {
    briefly "Get spc data point"
    described as {
      |Retrieves the spc data point projection.
    }
  }
  result SPCDataPointView is  {
    sPCDataPoint: SPCChartAnalytics.SPCDataPoint with {
      briefly "Spc data point"
      described as {
        |The spc data point being returned.
      }
    }
  } with {
    briefly "Spc data point view"
    described as {
      |Read model view carrying the spc data point projection.
    }
  }
  query GetControlChartSummary is  {
    controlChartSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which control chart summary to retrieve.
      }
    }
  } with {
    briefly "Get control chart summary"
    described as {
      |Retrieves the control chart summary projection.
    }
  }
  result ControlChartSummaryView is  {
    controlChartSummary: SPCChartAnalytics.ControlChartSummary with {
      briefly "Control chart summary"
      described as {
        |The control chart summary being returned.
      }
    }
  } with {
    briefly "Control chart summary view"
    described as {
      |Read model view carrying the control chart summary projection.
    }
  }
  projector SPCChartAnalytics as flow is {
    updates repository QualityContext.InspectionRepository
    inlet SPCChartAnalyticsFromInspection is type InspectionEvent    outlet SPCChartAnalyticsOut is type InspectionEvent
    record SPCDataPoint is  {
      parameter: String(1,100) with {
        briefly "Parameter"
        described as {
          |Measured parameter.
        }
      }
      measuredValue: Decimal(15,6) with {
        briefly "Value"
        described as {
          |Measured value.
        }
      }
      sampleId: SampleId with {
        briefly "Sample"
        described as {
          |Sample identifier.
        }
      }
      lotId: LotId with {
        briefly "Lot"
        described as {
          |Lot identifier.
        }
      }
      timestamp: TimeStamp with {
        briefly "Time"
        described as {
          |Measurement time.
        }
      }
      mean: Decimal(15,6) with {
        briefly "Mean"
        described as {
          |Running mean.
        }
      }
      standardDeviation: Decimal(15,6) with {
        briefly "StdDev"
        described as {
          |Standard deviation.
        }
      }
      upperControlLimit: Decimal(15,6) with {
        briefly "UCL"
        described as {
          |Upper control limit.
        }
      }
      lowerControlLimit: Decimal(15,6) with {
        briefly "LCL"
        described as {
          |Lower control limit.
        }
      }
      isOutOfControl: Boolean with {
        briefly "OOC"
        described as {
          |Out of control indicator.
        }
      }
    } with {
      briefly "SPC data point"
      described as {
        |Statistical process control data point.
      }
    }
    record ControlChartSummary is  {
      parameter: String(1,100) with {
        briefly "Parameter"
        described as {
          |Measured parameter.
        }
      }
      processCapabilityIndex: Decimal(5,3) with {
        briefly "Cpk"
        described as {
          |Process capability index.
        }
      }
      processPerformanceIndex: Decimal(5,3) with {
        briefly "Ppk"
        described as {
          |Process performance index.
        }
      }
      centerLine: Decimal(15,6) with {
        briefly "CL"
        described as {
          |Center line (mean).
        }
      }
      oocCount: Natural with {
        briefly "OOC count"
        described as {
          |Out of control count.
        }
      }
      totalPoints: Natural with {
        briefly "Total"
        described as {
          |Total data points.
        }
      }
    } with {
      briefly "Control chart summary"
      described as {
        |Summary statistics for control chart.
      }
    }
    handler SPCHandler is {
      on event Inspection.TestResultRecorded is {
        tell event Inspection.TestResultRecorded to repository QualityContext.InspectionRepository
        do "Add data point and recalculate control limits"
      }
    } with {
      briefly "Maintains SPC chart data"
      described as {
        |Projects test results into SPC chart data.
      }
    }
  } with {
    briefly "SPC chart projections"
    described as {
      |Maintains Statistical Process Control chart data.
    }
  }
  // Projector for yield trending
  query GetYieldTrendData is  {
    yieldTrendDataKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which yield trend data to retrieve.
      }
    }
  } with {
    briefly "Get yield trend data"
    described as {
      |Retrieves the yield trend data projection.
    }
  }
  result YieldTrendDataView is  {
    yieldTrendData: YieldTrendingAnalytics.YieldTrendData with {
      briefly "Yield trend data"
      described as {
        |The yield trend data being returned.
      }
    }
  } with {
    briefly "Yield trend data view"
    described as {
      |Read model view carrying the yield trend data projection.
    }
  }
  query GetYieldSummary is  {
    yieldSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which yield summary to retrieve.
      }
    }
  } with {
    briefly "Get yield summary"
    described as {
      |Retrieves the yield summary projection.
    }
  }
  result YieldSummaryView is  {
    yieldSummary: YieldTrendingAnalytics.YieldSummary with {
      briefly "Yield summary"
      described as {
        |The yield summary being returned.
      }
    }
  } with {
    briefly "Yield summary view"
    described as {
      |Read model view carrying the yield summary projection.
    }
  }
  projector YieldTrendingAnalytics as flow is {
    updates repository QualityContext.InspectionRepository
    inlet YieldTrendingAnalyticsFromInspection is type InspectionEvent    outlet YieldTrendingAnalyticsOut is type InspectionEvent
    record YieldTrendData is  {
      periodDate: Date with {
        briefly "Date"
        described as {
          |Period date.
        }
      }
      productCode: String(1,50) with {
        briefly "Product"
        described as {
          |Product code.
        }
      }
      inspectionCount: Natural with {
        briefly "Inspections"
        described as {
          |Number of inspections.
        }
      }
      passCount: Natural with {
        briefly "Passed"
        described as {
          |Passed inspections.
        }
      }
      failCount: Natural with {
        briefly "Failed"
        described as {
          |Failed inspections.
        }
      }
      conditionalCount: Natural with {
        briefly "Conditional"
        described as {
          |Conditional passes.
        }
      }
      firstPassYield: Decimal(5,4) with {
        briefly "FPY"
        described as {
          |First pass yield.
        }
      }
      rolledThroughputYield: Decimal(5,4) with {
        briefly "RTY"
        described as {
          |Rolled throughput yield.
        }
      }
      totalQuantityInspected: Decimal(15,4) with {
        briefly "Inspected"
        described as {
          |Total quantity inspected.
        }
      }
      totalQuantityPassed: Decimal(15,4) with {
        briefly "Passed qty"
        described as {
          |Quantity passed.
        }
      }
      totalQuantityRejected: Decimal(15,4) with {
        briefly "Rejected qty"
        described as {
          |Quantity rejected.
        }
      }
    } with {
      briefly "Yield trend data"
      described as {
        |Quality yield trending data.
      }
    }
    record YieldSummary is  {
      productCode: String(1,50) with {
        briefly "Product"
        described as {
          |Product code.
        }
      }
      periodType: String(1,20) with {
        briefly "Period"
        described as {
          |Period type (day/week/month).
        }
      }
      averageYield: Decimal(5,4) with {
        briefly "Avg yield"
        described as {
          |Average yield.
        }
      }
      yieldTrend: Decimal(6,4) with {
        briefly "Trend"
        described as {
          |Yield trend (positive=improving).
        }
      }
      targetYield: Decimal(5,4) with {
        briefly "Target"
        described as {
          |Target yield.
        }
      }
      gapToTarget: Decimal(6,4) with {
        briefly "Gap"
        described as {
          |Gap to target.
        }
      }
    } with {
      briefly "Yield summary"
      described as {
        |Yield performance summary.
      }
    }
    handler YieldHandler is {
      on event Inspection.InspectionApproved is {
        tell event Inspection.InspectionApproved to repository QualityContext.InspectionRepository
        do "Increment pass counts and update yield"
      }
      on event Inspection.InspectionRejected is {
        tell event Inspection.InspectionRejected to repository QualityContext.InspectionRepository
        do "Increment fail counts and update yield"
      }
      on event Inspection.ResultsEvaluated is {
        tell event Inspection.ResultsEvaluated to repository QualityContext.InspectionRepository
        do "Update inspection counts for period"
      }
    } with {
      briefly "Maintains yield trending data"
      described as {
        |Projects inspection results into yield trend analytics.
      }
    }
  } with {
    briefly "Yield trending projections"
    described as {
      |Maintains yield trending analytics for quality performance.
    }
  }
  // ---- Event publication for Inspection ----
  type InspectionEvent is one of {
    QualityContext.Inspection.InspectionCreated or QualityContext.Inspection.SampleCollected or QualityContext.Inspection.TestResultRecorded or QualityContext.Inspection.ResultsEvaluated or QualityContext.Inspection.InspectionApproved or QualityContext.Inspection.InspectionRejected or QualityContext.Inspection.NCRInitiated
  } with {
    briefly "Inspection event alternation"
    described as {
      |Union of all Inspection events, for streaming and event-sourced
      |persistence.
    }
  }
  processor InspectionEventSource as source is {
    outlet InspectionEvents is type InspectionEvent
    handler InspectionSourceHandler is {
      on event Inspection.InspectionCreated is {
        send event Inspection.InspectionCreated to outlet InspectionEvents
      }
      on event Inspection.SampleCollected is {
        send event Inspection.SampleCollected to outlet InspectionEvents
      }
      on event Inspection.TestResultRecorded is {
        send event Inspection.TestResultRecorded to outlet InspectionEvents
      }
      on event Inspection.ResultsEvaluated is {
        send event Inspection.ResultsEvaluated to outlet InspectionEvents
      }
      on event Inspection.InspectionApproved is {
        send event Inspection.InspectionApproved to outlet InspectionEvents
      }
      on event Inspection.InspectionRejected is {
        send event Inspection.InspectionRejected to outlet InspectionEvents
      }
      on event Inspection.NCRInitiated is {
        send event Inspection.NCRInitiated to outlet InspectionEvents
      }
      on other is {
        error "Unexpected message for source InspectionEventSource"
      }
    } with {
      briefly "Inspection source handler"
      described as {
        |Publishes Inspection events onto the outlet.
      }
    }
  } with {
    briefly "Inspection event source"
    described as {
      |Publishes Inspection entity events into the streaming topology.
    }
  }
  processor InspectionEventSink as sink is {
    inlet InspectionInlet is type InspectionEvent    handler InspectionSinkHandler is {
      on event Inspection.InspectionCreated is {
        tell event Inspection.InspectionCreated to repository QualityContext.InspectionRepository
      }
      on event Inspection.SampleCollected is {
        tell event Inspection.SampleCollected to repository QualityContext.InspectionRepository
      }
      on event Inspection.TestResultRecorded is {
        tell event Inspection.TestResultRecorded to repository QualityContext.InspectionRepository
      }
      on event Inspection.ResultsEvaluated is {
        tell event Inspection.ResultsEvaluated to repository QualityContext.InspectionRepository
      }
      on event Inspection.InspectionApproved is {
        tell event Inspection.InspectionApproved to repository QualityContext.InspectionRepository
      }
      on event Inspection.InspectionRejected is {
        tell event Inspection.InspectionRejected to repository QualityContext.InspectionRepository
      }
      on event Inspection.NCRInitiated is {
        tell event Inspection.NCRInitiated to repository QualityContext.InspectionRepository
      }
      on other is {
        error "Unexpected message for sink InspectionEventSink"
      }
    } with {
      briefly "Inspection sink handler"
      described as {
        |Persists Inspection events via the repository.
      }
    }
  } with {
    briefly "Inspection event sink"
    described as {
      |Receives Inspection events for persistence.
    }
  }
  connector InspectionEventFlow is from outlet QualityContext.InspectionEventSource.InspectionEvents to inlet QualityContext.InspectionEventSink.InspectionInlet with {
    briefly "Inspection event flow"
    described as {
      |Connects the Inspection source to its sink.
    }
  }
  processor InspectionEventSplit as split is {
    inlet InspectionEventSplitIn is type InspectionEvent    outlet InspectionEventSplitToInspectionRepository is type InspectionEvent
    outlet InspectionEventSplitToDefectParetoAnalytics is type InspectionEvent
    outlet InspectionEventSplitToSPCChartAnalytics is type InspectionEvent
    outlet InspectionEventSplitToYieldTrendingAnalytics is type InspectionEvent
    handler InspectionEventSplitHandler is {
      on event Inspection.InspectionCreated is {
        send event Inspection.InspectionCreated to outlet InspectionEventSplitToInspectionRepository
        send event Inspection.InspectionCreated to outlet InspectionEventSplitToDefectParetoAnalytics
        send event Inspection.InspectionCreated to outlet InspectionEventSplitToSPCChartAnalytics
        send event Inspection.InspectionCreated to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell event Inspection.InspectionCreated to entity QualityContext.Inspection
      }
      on event Inspection.SampleCollected is {
        send event Inspection.SampleCollected to outlet InspectionEventSplitToInspectionRepository
        send event Inspection.SampleCollected to outlet InspectionEventSplitToDefectParetoAnalytics
        send event Inspection.SampleCollected to outlet InspectionEventSplitToSPCChartAnalytics
        send event Inspection.SampleCollected to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell event Inspection.SampleCollected to entity QualityContext.Inspection
      }
      on event Inspection.TestResultRecorded is {
        send event Inspection.TestResultRecorded to outlet InspectionEventSplitToInspectionRepository
        send event Inspection.TestResultRecorded to outlet InspectionEventSplitToDefectParetoAnalytics
        send event Inspection.TestResultRecorded to outlet InspectionEventSplitToSPCChartAnalytics
        send event Inspection.TestResultRecorded to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell event Inspection.TestResultRecorded to entity QualityContext.Inspection
      }
      on event Inspection.ResultsEvaluated is {
        send event Inspection.ResultsEvaluated to outlet InspectionEventSplitToInspectionRepository
        send event Inspection.ResultsEvaluated to outlet InspectionEventSplitToDefectParetoAnalytics
        send event Inspection.ResultsEvaluated to outlet InspectionEventSplitToSPCChartAnalytics
        send event Inspection.ResultsEvaluated to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell event Inspection.ResultsEvaluated to entity QualityContext.Inspection
      }
      on event Inspection.InspectionApproved is {
        send event Inspection.InspectionApproved to outlet InspectionEventSplitToInspectionRepository
        send event Inspection.InspectionApproved to outlet InspectionEventSplitToDefectParetoAnalytics
        send event Inspection.InspectionApproved to outlet InspectionEventSplitToSPCChartAnalytics
        send event Inspection.InspectionApproved to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell event Inspection.InspectionApproved to entity QualityContext.Inspection
      }
      on event Inspection.InspectionRejected is {
        send event Inspection.InspectionRejected to outlet InspectionEventSplitToInspectionRepository
        send event Inspection.InspectionRejected to outlet InspectionEventSplitToDefectParetoAnalytics
        send event Inspection.InspectionRejected to outlet InspectionEventSplitToSPCChartAnalytics
        send event Inspection.InspectionRejected to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell event Inspection.InspectionRejected to entity QualityContext.Inspection
      }
      on event Inspection.NCRInitiated is {
        send event Inspection.NCRInitiated to outlet InspectionEventSplitToInspectionRepository
        send event Inspection.NCRInitiated to outlet InspectionEventSplitToDefectParetoAnalytics
        send event Inspection.NCRInitiated to outlet InspectionEventSplitToSPCChartAnalytics
        send event Inspection.NCRInitiated to outlet InspectionEventSplitToYieldTrendingAnalytics
        tell event Inspection.NCRInitiated to entity QualityContext.Inspection
      }
      on other is {
        error "Unexpected message for processor InspectionEventSplit"
      }
    } with {
      briefly "Inspection event fan-out handler"
      described as {
        |Delivers each Inspection event to all of its consumers.
      }
    }
  } with {
    briefly "Inspection event fan-out"
    described as {
      |Fans Inspection events out to the repository and projectors.
    }
  }
  connector 'InspectionEvent Stream' is from outlet QualityContext.Inspection.InspectionEvents2 to inlet QualityContext.InspectionEventSplit.InspectionEventSplitIn with {
    briefly "Inspection events, fanned out to storage and read models"
  }
  connector 'InspectionEvent Storage' is from outlet QualityContext.InspectionEventSplit.InspectionEventSplitToInspectionRepository to inlet QualityContext.InspectionRepository.InspectionRepositoryFromInspection with {
    briefly "Inspection events on their way to storage"
  }
  connector 'DefectParetoAnalytics Feed' is from outlet QualityContext.InspectionEventSplit.InspectionEventSplitToDefectParetoAnalytics to inlet QualityContext.DefectParetoAnalytics.DefectParetoAnalyticsFromInspection with {
    briefly "Inspection events feeding the DefectParetoAnalytics projection"
  }
  connector 'SPCChartAnalytics Feed' is from outlet QualityContext.InspectionEventSplit.InspectionEventSplitToSPCChartAnalytics to inlet QualityContext.SPCChartAnalytics.SPCChartAnalyticsFromInspection with {
    briefly "Inspection events feeding the SPCChartAnalytics projection"
  }
  connector 'YieldTrendingAnalytics Feed' is from outlet QualityContext.InspectionEventSplit.InspectionEventSplitToYieldTrendingAnalytics to inlet QualityContext.YieldTrendingAnalytics.YieldTrendingAnalyticsFromInspection with {
    briefly "Inspection events feeding the YieldTrendingAnalytics projection"
  }
  connector 'DefectParetoAnalytics Storage' is from outlet QualityContext.DefectParetoAnalytics.DefectParetoAnalyticsOut to inlet QualityContext.InspectionRepository.InspectionRepositoryFromDefectParetoAnalytics with {
    briefly "The DefectParetoAnalytics projection on its way to storage"
  }
  connector 'SPCChartAnalytics Storage' is from outlet QualityContext.SPCChartAnalytics.SPCChartAnalyticsOut to inlet QualityContext.InspectionRepository.InspectionRepositoryFromSPCChartAnalytics with {
    briefly "The SPCChartAnalytics projection on its way to storage"
  }
  connector 'YieldTrendingAnalytics Storage' is from outlet QualityContext.YieldTrendingAnalytics.YieldTrendingAnalyticsOut to inlet QualityContext.InspectionRepository.InspectionRepositoryFromYieldTrendingAnalytics with {
    briefly "The YieldTrendingAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for quality control"
  described as {
    | The QualityContext is the bounded context for
    | quality inspections, testing, and analytics.
  }
}
