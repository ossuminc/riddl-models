// Tour Operations Domain Model
// Tour package and excursion management
domain TourOperations is {
  persistent connector 'TourCatalogServiceReply Stream' is from outlet TourCatalogService.TourCatalogServiceRepliesOut to inlet TourContext.ToTourCatalogService.ToTourCatalogServiceReplies with {
    briefly "What TourCatalogService answers TourContext"
  }
  persistent connector 'GuideAssignmentServiceReply Stream' is from outlet GuideAssignmentService.GuideAssignmentServiceRepliesOut to inlet TourContext.ToGuideAssignmentService.ToGuideAssignmentServiceReplies with {
    briefly "What GuideAssignmentService answers TourContext"
  }
  persistent connector 'DepartureAvailabilityServiceReply Stream' is from outlet DepartureAvailabilityService.DepartureAvailabilityServiceRepliesOut to inlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceReplies with {
    briefly "What DepartureAvailabilityService answers TourContext"
  }
  persistent connector 'DepartureAvailabilityServiceEvent Stream' is from outlet DepartureAvailabilityService.DepartureAvailabilityServiceEventsOut to inlet TourContext.FromDepartureAvailabilityService.FromDepartureAvailabilityServiceIn with {
    briefly "What DepartureAvailabilityService tells TourContext, unasked"
  }
  persistent connector 'GuideAssignmentServiceEvent Stream' is from outlet GuideAssignmentService.GuideAssignmentServiceEventsOut to inlet TourContext.FromGuideAssignmentService.FromGuideAssignmentServiceIn with {
    briefly "What GuideAssignmentService tells TourContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet TourContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells TourContext, unasked"
  }
  persistent connector 'WaiverManagementServiceEvent Stream' is from outlet WaiverManagementService.WaiverManagementServiceEventsOut to inlet TourContext.FromWaiverManagementService.FromWaiverManagementServiceIn with {
    briefly "What WaiverManagementService tells TourContext, unasked"
  }
  persistent connector 'TourCatalogServiceRequest Stream' is from outlet TourContext.ToTourCatalogService.ToTourCatalogServiceOut to inlet TourCatalogService.TourCatalogServiceRequests with {
    briefly "What TourContext asks TourCatalogService to send"
  }
  persistent connector 'GuideAssignmentServiceRequest Stream' is from outlet TourContext.ToGuideAssignmentService.ToGuideAssignmentServiceOut to inlet GuideAssignmentService.GuideAssignmentServiceRequests with {
    briefly "What TourContext asks GuideAssignmentService to send"
  }
  persistent connector 'WaiverManagementServiceRequest Stream' is from outlet TourContext.ToWaiverManagementService.ToWaiverManagementServiceOut to inlet WaiverManagementService.WaiverManagementServiceRequests with {
    briefly "What TourContext asks WaiverManagementService to send"
  }
  persistent connector 'DepartureAvailabilityServiceRequest Stream' is from outlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceOut to inlet DepartureAvailabilityService.DepartureAvailabilityServiceRequests with {
    briefly "What TourContext asks DepartureAvailabilityService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet TourContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What TourContext asks PaymentProcessingService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet TourContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What TourContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Tourist is "person booking tour" with {
    briefly "Tourist"
    described as {
      |Person booking a tour.
    }
  }
  user TourOperator is "person managing tours" with {
    briefly "Tour Operator"
    described as {
      |Person organizing tours.
    }
  }
  user TourGuide is "person leading tours" with {
    briefly "Tour Guide"
    described as {
      |Person conducting tours.
    }
  }
  epic TourEpic is {
    user Tourist wants to "to book tours and excursions" so that "I can experience destinations"
    case BookTour is {
      user Tourist wants to "to reserve a spot on a tour" so that "I have a guided experience"
      step is "Tourist browses" "available tours" "by destination" with {
        briefly "Browse tours"
        described as {
          |Find available tours.
        }
      }
      step is "Tourist selects" "preferred tour and date" "from options" with {
        briefly "Select tour"
        described as {
          |Choose tour and date.
        }
      }
      step take input TourOperationsApp.TourOperationsScreen.CreateBookingInput from user Tourist with {
        briefly "Create booking"
        described as {
          |Submit tour booking.
        }
      }
      step is "System confirms" "booking details" "to tourist" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Book tour"
      described as {
        |Booking tour packages.
      }
    }
  } with {
    briefly "Tour management"
    described as {
      | Epic covering tour bookings, scheduling,
      | and customer experience.
    }
  }
  include "TourContext.riddl"
  include "external-contexts.riddl"
  application context TourOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TourOperations are delivered.
      }
    }
    group TourOperationsScreen is {
      input CreateBookingInput acquires command TourContext.TourBooking.CreateBooking with {
        briefly "Create booking control"
        described as {
          |The control through which a user submits the create booking request.
        }
      }
    } with {
      briefly "Tour operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTourBookingCommands is type TourContext.TourBooking.TourBookingCommand
    inlet AppBookingRepositoryResponses is result TourContext.TourBooking.TourBookingResult    handler TourOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context TourOperationsApp"
      }
    } with {
      briefly "TourOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TourOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TourBookingCommand Stream' is from outlet TourOperationsApp.AppTourBookingCommands to inlet TourContext.TourBookingCommandStreamIn with {
    briefly "TourBooking commands from the application"
  }
  persistent connector 'BookingResult Stream' is from outlet TourContext.BookingResultStreamOut to inlet TourOperationsApp.AppBookingRepositoryResponses with {
    briefly "Booking query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TourOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Tour operations domain"
  described as {
    | The TourOperations domain handles tour packages,
    | bookings, and excursion management.
  }
}
