// Tour Operations Domain Model
// Tour package and excursion management
domain TourOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Tourist is "person booking tour" with {
    briefly "Tourist"
    described as {
      |Person booking a tour.
    }
  }
  user TourOperator is "person managing tours" with {
    briefly "Tour Operator"
    described as {
      |Person organizing tours.
    }
  }
  user TourGuide is "person leading tours" with {
    briefly "Tour Guide"
    described as {
      |Person conducting tours.
    }
  }
  epic TourEpic is {
    user Tourist wants to "to book tours and excursions" so that "I can experience destinations"
    case BookTour is {
      user Tourist wants to "to reserve a spot on a tour" so that "I have a guided experience"
      step is "Tourist browses" "available tours" "by destination" with {
        briefly "Browse tours"
        described as {
          |Find available tours.
        }
      }
      step is "Tourist selects" "preferred tour and date" "from options" with {
        briefly "Select tour"
        described as {
          |Choose tour and date.
        }
      }
      step take input TourOperationsApp.TourOperationsScreen.CreateBookingInput from user Tourist with {
        briefly "Create booking"
        described as {
          |Submit tour booking.
        }
      }
      step is "System confirms" "booking details" "to tourist" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Book tour"
      described as {
        |Booking tour packages.
      }
    }
  } with {
    briefly "Tour management"
    described as {
      | Epic covering tour bookings, scheduling,
      | and customer experience.
    }
  }
  include "TourContext.riddl"
  include "external-contexts.riddl"
  application context TourOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in TourOperations are delivered.
      }
    }
    group TourOperationsScreen is {
      input CreateBookingInput acquires command TourContext.TourBooking.CreateBooking with {
        briefly "Create booking control"
        described as {
          |The control through which a user submits the create booking request.
        }
      }
    } with {
      briefly "Tour operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTourBookingCommands is type TourContext.TourBooking.TourBookingCommand
    inlet AppBookingRepositoryResponses is result TourContext.TourBooking.TourBookingResult    handler TourOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context TourOperationsApp"
      }
    } with {
      briefly "TourOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "TourOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TourBookingCommand Stream' is from outlet TourOperationsApp.AppTourBookingCommands to inlet TourContext.TourBookingCommandStreamIn with {
    briefly "TourBooking commands from the application"
  }
  persistent connector 'BookingResult Stream' is from outlet TourContext.BookingResultStreamOut to inlet TourOperationsApp.AppBookingRepositoryResponses with {
    briefly "Booking query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet TourOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Tour operations domain"
  described as {
    | The TourOperations domain handles tour packages,
    | bookings, and excursion management.
  }
}
