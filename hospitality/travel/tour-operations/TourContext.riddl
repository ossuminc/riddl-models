// Tour Operations - Tour Context
context TourContext is {
  include "types.riddl"
  include "TourBooking.riddl"
  // Repository for booking persistence
  repository BookingRepository is {
    schema BookingData is relational
      of bookings as type TourBooking
        index on field TourBooking.bookingId
        index on field TourBooking.customer.customerId
        index on field TourBooking.tour.tourId
        index on field TourBooking.departure.departureId

    handler BookingPersistence is {
      on command TourBooking.CreateBooking is {
        tell event TourBooking.BookingCreated to entity TourContext.TourBooking
        prompt "Store new booking"
      }
      on command TourBooking.AddParticipant is {
        tell event TourBooking.ParticipantAdded to entity TourContext.TourBooking
        prompt "Add participant to booking"
      }
      on command TourBooking.RemoveParticipant is {
        tell event TourBooking.ParticipantRemoved to entity TourContext.TourBooking
        prompt "Remove participant from booking"
      }
      on command TourBooking.AddAddOn is {
        tell event TourBooking.AddOnAdded to entity TourContext.TourBooking
        prompt "Add add-on to booking"
      }
      on command TourBooking.ProcessDeposit is {
        tell event TourBooking.DepositProcessed to entity TourContext.TourBooking
        prompt "Store deposit payment"
      }
      on command TourBooking.ConfirmBooking is {
        tell event TourBooking.BookingConfirmed to entity TourContext.TourBooking
        prompt "Update to confirmed"
      }
      on command TourBooking.ProcessFinalPayment is {
        tell event TourBooking.FinalPaymentProcessed to entity TourContext.TourBooking
        prompt "Store final payment"
      }
      on command TourBooking.CheckIn is {
        prompt "Update to checked in"
      }
      on command TourBooking.StartTour is {
        tell event TourBooking.TourStarted to entity TourContext.TourBooking
        prompt "Update to in progress"
      }
      on command TourBooking.CompleteTour is {
        tell event TourBooking.TourCompleted to entity TourContext.TourBooking
        prompt "Update to completed"
      }
      on command TourBooking.SubmitReview is {
        tell event TourBooking.ReviewSubmitted to entity TourContext.TourBooking
        prompt "Store review"
      }
      on command TourBooking.CancelBooking is {
        tell event TourBooking.BookingCancelled to entity TourContext.TourBooking
        prompt "Update to cancelled"
      }
      on command TourBooking.ProcessRefund is {
        tell event TourBooking.RefundProcessed to entity TourContext.TourBooking
        prompt "Store refund"
      }
    } with {
      briefly "Persists booking commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Booking data persistence"
    described as {
      | The BookingRepository provides persistent storage for
      | tour bookings and related data.
    }
  }
  // Projector for tour analytics
  projector TourAnalytics is {
    updates repository TourContext.BookingRepository
    record TourStats is  {
      totalBookings: Natural with {
        briefly "Total"
        described as {
          |Total bookings.
        }
      }
      confirmedBookings: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed bookings.
        }
      }
      completedTours: Natural with {
        briefly "Completed"
        described as {
          |Completed tours.
        }
      }
      cancelledBookings: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled bookings.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      totalParticipants: Natural with {
        briefly "Participants"
        described as {
          |Total participants.
        }
      }
    } with {
      briefly "Tour statistics"
      described as {
        |Tour booking metrics.
      }
    }
    handler AnalyticsHandler is {
      on event TourBooking.BookingCreated is {
        tell event TourBooking.BookingCreated to repository TourContext.BookingRepository
        prompt "Update booking counts"
      }
      on event TourBooking.BookingConfirmed is {
        tell event TourBooking.BookingConfirmed to repository TourContext.BookingRepository
        prompt "Update confirmed counts"
      }
      on event TourBooking.FinalPaymentProcessed is {
        tell event TourBooking.FinalPaymentProcessed to repository TourContext.BookingRepository
        prompt "Update revenue metrics"
      }
      on event TourBooking.TourCompleted is {
        tell event TourBooking.TourCompleted to repository TourContext.BookingRepository
        prompt "Update completion metrics"
      }
      on event TourBooking.ReviewSubmitted is {
        tell event TourBooking.ReviewSubmitted to repository TourContext.BookingRepository
        prompt "Update rating metrics"
      }
      on event TourBooking.BookingCancelled is {
        tell event TourBooking.BookingCancelled to repository TourContext.BookingRepository
        prompt "Update cancellation metrics"
      }
    } with {
      briefly "Maintains tour analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Tour analytics projections"
    described as {
      |Maintains tour booking analytics data.
    }
  }
  // ---- Event publication for TourBooking ----
  type TourBookingEvent is one of {
    TourContext.TourBooking.BookingCreated,
    TourContext.TourBooking.ParticipantAdded,
    TourContext.TourBooking.ParticipantRemoved,
    TourContext.TourBooking.AddOnAdded,
    TourContext.TourBooking.DepositProcessed,
    TourContext.TourBooking.BookingConfirmed,
    TourContext.TourBooking.FinalPaymentProcessed,
    TourContext.TourBooking.GuestCheckedIn,
    TourContext.TourBooking.TourStarted,
    TourContext.TourBooking.TourCompleted,
    TourContext.TourBooking.ReviewSubmitted,
    TourContext.TourBooking.BookingCancelled,
    TourContext.TourBooking.RefundProcessed
  } with {
    briefly "TourBooking event alternation"
    described as {
      |Union of all TourBooking events, for streaming and event-sourced
      |persistence.
    }
  }
  source TourBookingEventSource is {
    outlet TourBookingEvents is type TourBookingEvent
    handler TourBookingSourceHandler is {
      on event TourBooking.BookingCreated is {
        send event TourBooking.BookingCreated to outlet TourBookingEvents
      }
      on event TourBooking.ParticipantAdded is {
        send event TourBooking.ParticipantAdded to outlet TourBookingEvents
      }
      on event TourBooking.ParticipantRemoved is {
        send event TourBooking.ParticipantRemoved to outlet TourBookingEvents
      }
      on event TourBooking.AddOnAdded is {
        send event TourBooking.AddOnAdded to outlet TourBookingEvents
      }
      on event TourBooking.DepositProcessed is {
        send event TourBooking.DepositProcessed to outlet TourBookingEvents
      }
      on event TourBooking.BookingConfirmed is {
        send event TourBooking.BookingConfirmed to outlet TourBookingEvents
      }
      on event TourBooking.FinalPaymentProcessed is {
        send event TourBooking.FinalPaymentProcessed to outlet TourBookingEvents
      }
      on event TourBooking.GuestCheckedIn is {
        send event TourBooking.GuestCheckedIn to outlet TourBookingEvents
      }
      on event TourBooking.TourStarted is {
        send event TourBooking.TourStarted to outlet TourBookingEvents
      }
      on event TourBooking.TourCompleted is {
        send event TourBooking.TourCompleted to outlet TourBookingEvents
      }
      on event TourBooking.ReviewSubmitted is {
        send event TourBooking.ReviewSubmitted to outlet TourBookingEvents
      }
      on event TourBooking.BookingCancelled is {
        send event TourBooking.BookingCancelled to outlet TourBookingEvents
      }
      on event TourBooking.RefundProcessed is {
        send event TourBooking.RefundProcessed to outlet TourBookingEvents
      }
      on other is {
        error "Unexpected message for source TourBookingEventSource"
      }
    } with {
      briefly "TourBooking source handler"
      described as {
        |Publishes TourBooking events onto the outlet.
      }
    }
  } with {
    briefly "TourBooking event source"
    described as {
      |Publishes TourBooking entity events into the streaming topology.
    }
  }
  sink TourBookingEventSink is {
    inlet TourBookingInlet is type TourBookingEvent
    handler TourBookingSinkHandler is {
      on event TourBooking.BookingCreated is {
        tell event TourBooking.BookingCreated to repository TourContext.BookingRepository
      }
      on event TourBooking.ParticipantAdded is {
        tell event TourBooking.ParticipantAdded to repository TourContext.BookingRepository
      }
      on event TourBooking.ParticipantRemoved is {
        tell event TourBooking.ParticipantRemoved to repository TourContext.BookingRepository
      }
      on event TourBooking.AddOnAdded is {
        tell event TourBooking.AddOnAdded to repository TourContext.BookingRepository
      }
      on event TourBooking.DepositProcessed is {
        tell event TourBooking.DepositProcessed to repository TourContext.BookingRepository
      }
      on event TourBooking.BookingConfirmed is {
        tell event TourBooking.BookingConfirmed to repository TourContext.BookingRepository
      }
      on event TourBooking.FinalPaymentProcessed is {
        tell event TourBooking.FinalPaymentProcessed to repository TourContext.BookingRepository
      }
      on event TourBooking.GuestCheckedIn is {
        tell event TourBooking.GuestCheckedIn to repository TourContext.BookingRepository
      }
      on event TourBooking.TourStarted is {
        tell event TourBooking.TourStarted to repository TourContext.BookingRepository
      }
      on event TourBooking.TourCompleted is {
        tell event TourBooking.TourCompleted to repository TourContext.BookingRepository
      }
      on event TourBooking.ReviewSubmitted is {
        tell event TourBooking.ReviewSubmitted to repository TourContext.BookingRepository
      }
      on event TourBooking.BookingCancelled is {
        tell event TourBooking.BookingCancelled to repository TourContext.BookingRepository
      }
      on event TourBooking.RefundProcessed is {
        tell event TourBooking.RefundProcessed to repository TourContext.BookingRepository
      }
      on other is {
        error "Unexpected message for sink TourBookingEventSink"
      }
    } with {
      briefly "TourBooking sink handler"
      described as {
        |Persists TourBooking events via the repository.
      }
    }
  } with {
    briefly "TourBooking event sink"
    described as {
      |Receives TourBooking events for persistence.
    }
  }
  connector TourBookingEventFlow is {
    from outlet TourContext.TourBookingEventSource.TourBookingEvents to
      inlet TourContext.TourBookingEventSink.TourBookingInlet
  } with {
    briefly "TourBooking event flow"
    described as {
      |Connects the TourBooking source to its sink.
    }
  }
} with {
  briefly "Bounded context for tour operations"
  described as {
    | The TourContext is the bounded context for
    | tour bookings and excursion management.
  }
}
