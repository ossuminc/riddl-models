// Tour Operations - Tour Context
context TourContext as router is {
  inlet TourContextFromToGuideAssignmentService is command TourBooking.RecordGuide with {
    briefly "What ToGuideAssignmentService makes of the answers it gets"
  }
  connector 'ToGuideAssignmentService Intake' is from outlet TourContext.ToGuideAssignmentService.ToGuideAssignmentServiceToTourContext to inlet TourContext.TourContextFromToGuideAssignmentService with {
    briefly "Answers translated by ToGuideAssignmentService, on their way in"
  }
  type ToTourCatalogServiceCommand is one of {
    TourBooking.RecordAlternativeTours or TourBooking.RecordTourDetails
  } with {
    briefly "What ToTourCatalogService turns its answers into"
  }
  inlet TourContextFromToTourCatalogService is type ToTourCatalogServiceCommand with {
    briefly "What ToTourCatalogService makes of the answers it gets"
  }
  connector 'ToTourCatalogService Intake' is from outlet TourContext.ToTourCatalogService.ToTourCatalogServiceToTourContext to inlet TourContext.TourContextFromToTourCatalogService with {
    briefly "Answers translated by ToTourCatalogService, on their way in"
  }
  inlet TourContextFromToDepartureAvailabilityService is command TourBooking.CancelBooking with {
    briefly "What ToDepartureAvailabilityService makes of the answers it gets"
  }
  connector 'ToDepartureAvailabilityService Intake' is from outlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceToTourContext to inlet TourContext.TourContextFromToDepartureAvailabilityService with {
    briefly "Answers translated by ToDepartureAvailabilityService, on their way in"
  }
  inlet TourContextFromPaymentProcessingService is command TourBooking.ProcessRefund with {
    briefly "What FromPaymentProcessingService makes of that service's news"
  }
  connector 'FromPaymentProcessingService Intake' is from outlet TourContext.FromPaymentProcessingService.FromPaymentProcessingServiceToTourContext to inlet TourContext.TourContextFromPaymentProcessingService with {
    briefly "What FromPaymentProcessingService makes of that news, on its way in"
  }
  inlet TourBookingCommandStreamIn is type TourBookingCommand  outlet TourBookingCommandStreamOut is type TourBookingCommand
  inlet BookingResultStreamIn is result TourBooking.TourBookingResult  outlet BookingResultStreamOut is result TourBooking.TourBookingResult
  handler TourContextBoundary is {
    on recordTourDetails: command TourBooking.RecordTourDetails is {
      send recordTourDetails to outlet TourContext.TourBookingCommandStreamOut
    }
    on recordAlternativeTours: command TourBooking.RecordAlternativeTours is {
      send recordAlternativeTours to outlet TourContext.TourBookingCommandStreamOut
    }
    on recordGuide: command TourBooking.RecordGuide is {
      send recordGuide to outlet TourContext.TourBookingCommandStreamOut
    }
    on createBooking: command TourBooking.CreateBooking is {
      send createBooking to outlet TourContext.TourBookingCommandStreamOut
    }
    on addParticipant: command TourBooking.AddParticipant is {
      send addParticipant to outlet TourContext.TourBookingCommandStreamOut
    }
    on removeParticipant: command TourBooking.RemoveParticipant is {
      send removeParticipant to outlet TourContext.TourBookingCommandStreamOut
    }
    on addAddOn: command TourBooking.AddAddOn is {
      send addAddOn to outlet TourContext.TourBookingCommandStreamOut
    }
    on processDeposit: command TourBooking.ProcessDeposit is {
      send processDeposit to outlet TourContext.TourBookingCommandStreamOut
    }
    on confirmBooking: command TourBooking.ConfirmBooking is {
      send confirmBooking to outlet TourContext.TourBookingCommandStreamOut
    }
    on processFinalPayment: command TourBooking.ProcessFinalPayment is {
      send processFinalPayment to outlet TourContext.TourBookingCommandStreamOut
    }
    on checkInMsg: command TourBooking.CheckIn is {
      send checkInMsg to outlet TourContext.TourBookingCommandStreamOut
    }
    on startTour: command TourBooking.StartTour is {
      send startTour to outlet TourContext.TourBookingCommandStreamOut
    }
    on completeTour: command TourBooking.CompleteTour is {
      send completeTour to outlet TourContext.TourBookingCommandStreamOut
    }
    on submitReview: command TourBooking.SubmitReview is {
      send submitReview to outlet TourContext.TourBookingCommandStreamOut
    }
    on cancelBooking: command TourBooking.CancelBooking is {
      send cancelBooking to outlet TourContext.TourBookingCommandStreamOut
    }
    on processRefund: command TourBooking.ProcessRefund is {
      send processRefund to outlet TourContext.TourBookingCommandStreamOut
    }
    on tourBookingResult: result TourBooking.TourBookingResult is {
      send tourBookingResult to outlet TourContext.BookingResultStreamOut
    }
    on other is {
      error "Unexpected message at the TourContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TourBookingCommand Stream Intake' is from outlet TourContext.TourBookingCommandStreamOut to inlet TourContext.TourBooking.TourBookingCommands  connector 'BookingResult Stream Egress' is from outlet TourContext.BookingRepository.BookingRepositoryResponses to inlet TourContext.BookingResultStreamIn  adaptor FromDepartureAvailabilityService from context DepartureAvailabilityService as sink is { 
    inlet FromDepartureAvailabilityServiceIn is type DepartureAvailabilityService.DepartureAvailabilityServiceEvent    handler FromDepartureAvailabilityServiceHandler is {
      on spotsReleased: event DepartureAvailabilityService.SpotsReleased is {
        do "the spots are open again; removing the participant or cancelling was recorded here"
      }
      on spotsReserved: event DepartureAvailabilityService.SpotsReserved is {
        do "the spots are held; adding the participant was recorded before they were asked for"
      }
      on other is {
        error "Unexpected message for adaptor FromDepartureAvailabilityService"
      }
    } with {
      briefly "from departure availability service"
      described as {
        |Carries messages from the external DepartureAvailabilityService.
      }
    }
  } with {
    briefly "DepartureAvailabilityService integration"
    described as {
      |The model's side of the DepartureAvailabilityService conversation.
    }
  }
  adaptor ToDepartureAvailabilityService to context DepartureAvailabilityService as router is { 
    outlet ToDepartureAvailabilityServiceToTourContext is command TourBooking.CancelBooking
    inlet ToDepartureAvailabilityServiceIn is type TourBookingEvent    inlet ToDepartureAvailabilityServiceReplies is result DepartureAvailabilityService.DepartureAvailability    outlet ToDepartureAvailabilityServiceOut is type DepartureAvailabilityService.DepartureAvailabilityServiceCommand
    handler ToDepartureAvailabilityServiceHandler is {
      on bookingCreated: event TourBooking.BookingCreated is {
        let askAnswer: type DepartureAvailabilityService.DepartureAvailability = ask query DepartureAvailabilityService.CheckAvailability of context DepartureAvailabilityService
        do "a booking needing places left on the departure it names"
        when prompt("not askAnswer.available") then
          send command TourBooking.CancelBooking(bookingId = bookingCreated.bookingId, reason = prompt("no places left on the departure"), requestRefund = prompt("true")) to outlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceToTourContext
        end
      }
      on participantAdded: event TourBooking.ParticipantAdded is {
        let item0: type DepartureAvailabilityService.ReserveSpots = prompt("translate the participantAdded event into a ReserveSpots, each participant being what consumes a place")
        send item0 to outlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceOut
      }
      on participantRemoved: event TourBooking.ParticipantRemoved is {
        let item0: type DepartureAvailabilityService.ReleaseSpots = prompt("translate the participantRemoved event into a ReleaseSpots, removal returning it")
        send item0 to outlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceOut
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        let item0: type DepartureAvailabilityService.ReleaseSpots = prompt("translate the bookingCancelled event into a ReleaseSpots, and cancellation returning all of them")
        send item0 to outlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDepartureAvailabilityService"
      }
    } with {
      briefly "to departure availability service"
      described as {
        |Carries messages to the external DepartureAvailabilityService.
      }
    }
  } with {
    briefly "DepartureAvailabilityService integration"
    described as {
      |The model's side of the DepartureAvailabilityService conversation.
    }
  }
  adaptor FromGuideAssignmentService from context GuideAssignmentService as sink is { 
    inlet FromGuideAssignmentServiceIn is event GuideAssignmentService.GuideAssigned    handler FromGuideAssignmentServiceHandler is {
      on guideAssigned: event GuideAssignmentService.GuideAssigned is {
        do "the guide is assigned; the booking holds no guide of its own"
      }
      on other is {
        error "Unexpected message for adaptor FromGuideAssignmentService"
      }
    } with {
      briefly "from guide assignment service"
      described as {
        |Carries messages from the external GuideAssignmentService.
      }
    }
  } with {
    briefly "GuideAssignmentService integration"
    described as {
      |The model's side of the GuideAssignmentService conversation.
    }
  }
  adaptor ToGuideAssignmentService to context GuideAssignmentService as router is { 
    outlet ToGuideAssignmentServiceToTourContext is command TourBooking.RecordGuide
    inlet ToGuideAssignmentServiceIn is type TourBookingEvent    inlet ToGuideAssignmentServiceReplies is result GuideAssignmentService.AvailableGuides    outlet ToGuideAssignmentServiceOut is type GuideAssignmentService.GuideAssignmentServiceRequest
    handler ToGuideAssignmentServiceHandler is {
      on bookingConfirmed: event TourBooking.BookingConfirmed is {
        let askAnswer: type GuideAssignmentService.AvailableGuides = ask query GuideAssignmentService.GetAvailableGuides of context GuideAssignmentService
        do "a confirmed booking needing a guide free to lead it"
        send command TourBooking.RecordGuide(bookingId = bookingConfirmed.bookingId, guide = prompt("the guide of this record guide")) to outlet TourContext.ToGuideAssignmentService.ToGuideAssignmentServiceToTourContext
        let item0: type GuideAssignmentService.AssignGuide = prompt("translate the bookingConfirmed event into a AssignGuide, a confirmed booking being what needs someone to lead it")
        send item0 to outlet TourContext.ToGuideAssignmentService.ToGuideAssignmentServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToGuideAssignmentService"
      }
    } with {
      briefly "to guide assignment service"
      described as {
        |Carries messages to the external GuideAssignmentService.
      }
    }
  } with {
    briefly "GuideAssignmentService integration"
    described as {
      |The model's side of the GuideAssignmentService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type TourBookingEvent    outlet ToNotificationServiceOut is type NotificationService.NotificationServiceCommand
    handler ToNotificationServiceHandler is {
      on bookingCreated: event BookingCreated is {
        let ack: type NotificationService.SendBookingAcknowledgement = prompt("translate the bookingCreated event into a SendBookingAcknowledgement telling the customer the request has been received, not that it is committed")
        send ack to outlet TourContext.ToNotificationService.ToNotificationServiceOut
      }
      on bookingConfirmed: event BookingConfirmed is {
        let confirmed: type NotificationService.SendBookingConfirmation = prompt("translate the bookingConfirmed event into a SendBookingConfirmation telling the customer the commitment is now firm")
        send confirmed to outlet TourContext.ToNotificationService.ToNotificationServiceOut
        let reminder: type NotificationService.SendTourReminder = prompt("translate the bookingConfirmed event into a SendTourReminder carrying the confirmed departure's start time and meeting point, so the service can raise it before the customer has to travel — carrying remindAt, the instant it should go out, which is why this send is scheduled rather than immediate")
        send reminder to outlet TourContext.ToNotificationService.ToNotificationServiceOut at reminder.remindAt
      }
      on tourCompleted: event TourCompleted is {
        let notice: type NotificationService.SendReviewRequest = prompt("translate the tourCompleted event into a SendReviewRequest asking the customer to review the tour now that it has finished, while it is fresh")
        send notice to outlet TourContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService as flow is { 
    inlet FromPaymentProcessingServiceIn is type PaymentProcessingService.PaymentProcessingServiceEvent    outlet FromPaymentProcessingServiceToTourContext is command TourBooking.ProcessRefund
    handler FromPaymentProcessingServiceHandler is {
      on paymentFailed: event PaymentProcessingService.PaymentFailed is {
        do "an unpaid booking stays as it is; the customer is asked again"
      }
      on paymentSucceeded: event PaymentProcessingService.PaymentSucceeded is {
        do "the money is taken; the deposit or final payment was recorded before it was asked for"
      }
      on refundSucceeded: event PaymentProcessingService.RefundSucceeded is {
        let item0: type TourBooking.ProcessRefund = prompt("translate the refundSucceeded event into a ProcessRefund, money actually returned is what the booking records as refunded")
        send item0 to outlet TourContext.FromPaymentProcessingService.FromPaymentProcessingServiceToTourContext
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService as flow is { 
    inlet ToPaymentProcessingServiceIn is type TourBookingEvent    outlet ToPaymentProcessingServiceOut is type PaymentProcessingService.PaymentProcessingServiceCommand
    handler ToPaymentProcessingServiceHandler is {
      on depositProcessed: event DepositProcessed is {
        let notice: type PaymentProcessingService.ProcessPayment = prompt("translate the depositProcessed event into a ProcessPayment taking the deposit that holds the places on the tour")
        send notice to outlet TourContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on finalPaymentProcessed: event FinalPaymentProcessed is {
        let notice: type PaymentProcessingService.ProcessPayment = prompt("translate the finalPaymentProcessed event into a ProcessPayment taking the balance now that departure is near")
        send notice to outlet TourContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on bookingCancelled: event BookingCancelled is {
        let notice: type PaymentProcessingService.ProcessBookingRefund = prompt("translate the bookingCancelled event into a ProcessBookingRefund returning whatever the cancellation terms leave owing to the customer")
        send notice to outlet TourContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToTourCatalogService to context TourCatalogService as router is { 
    outlet ToTourCatalogServiceToTourContext is type ToTourCatalogServiceCommand
    inlet ToTourCatalogServiceIn is type TourBookingEvent    inlet ToTourCatalogServiceReplies is type TourCatalogService.TourCatalogServiceReply    outlet ToTourCatalogServiceOut is type TourCatalogService.TourCatalogServiceRequest
    handler ToTourCatalogServiceHandler is {
      on bookingCreated: event TourBooking.BookingCreated is {
        let askAnswer: type TourCatalogService.TourDetails = ask query TourCatalogService.GetTourDetails of context TourCatalogService
        do "a new booking needing the tour's dates, capacity and itinerary"
        send command TourBooking.RecordTourDetails(bookingId = bookingCreated.bookingId, tour = bookingCreated.tour) to outlet TourContext.ToTourCatalogService.ToTourCatalogServiceToTourContext
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        let askAnswer: type TourCatalogService.TourSearchResults = ask query TourCatalogService.SearchTours of context TourCatalogService
        do "a cancellation needing other tours to offer instead"
        send command TourBooking.RecordAlternativeTours(bookingId = bookingCancelled.bookingId, tours = prompt("the tours of this record alternative tours")) to outlet TourContext.ToTourCatalogService.ToTourCatalogServiceToTourContext
      }
      on other is {
        error "Unexpected message for adaptor ToTourCatalogService"
      }
    } with {
      briefly "to tour catalog service"
      described as {
        |Carries messages to the external TourCatalogService.
      }
    }
  } with {
    briefly "TourCatalogService integration"
    described as {
      |The model's side of the TourCatalogService conversation.
    }
  }
  adaptor FromWaiverManagementService from context WaiverManagementService as sink is { 
    inlet FromWaiverManagementServiceIn is type WaiverManagementService.WaiverManagementServiceEvent    handler FromWaiverManagementServiceHandler is {
      on waiverSent: event WaiverManagementService.WaiverSent is {
        do "the participant has the waiver; sending it was recorded here"
      }
      on waiverSignedEvent: event WaiverManagementService.WaiverSigned is {
        do "the waiver is signed; check-in is where it is needed and a person does that"
      }
      on other is {
        error "Unexpected message for adaptor FromWaiverManagementService"
      }
    } with {
      briefly "from waiver management service"
      described as {
        |Carries messages from the external WaiverManagementService.
      }
    }
  } with {
    briefly "WaiverManagementService integration"
    described as {
      |The model's side of the WaiverManagementService conversation.
    }
  }
  adaptor ToWaiverManagementService to context WaiverManagementService as flow is { 
    inlet ToWaiverManagementServiceIn is type TourBookingEvent    outlet ToWaiverManagementServiceOut is command WaiverManagementService.SendWaiver
    handler ToWaiverManagementServiceHandler is {
      on participantAdded: event TourBooking.ParticipantAdded is {
        let item0: type WaiverManagementService.SendWaiver = prompt("translate the participantAdded event into a SendWaiver, each participant owing a signature before they travel")
        send item0 to outlet TourContext.ToWaiverManagementService.ToWaiverManagementServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToWaiverManagementService"
      }
    } with {
      briefly "to waiver management service"
      described as {
        |Carries messages to the external WaiverManagementService.
      }
    }
  } with {
    briefly "WaiverManagementService integration"
    described as {
      |The model's side of the WaiverManagementService conversation.
    }
  }
  include "types.riddl"
  include "TourBooking.riddl"
  // Repository for booking persistence
  type BookingRepositoryCommand is one of {
    TourContext.BookingRepository.PersistAddOnAdded or TourContext.BookingRepository.PersistBookingCancelled or TourContext.BookingRepository.PersistBookingConfirmed or TourContext.BookingRepository.PersistBookingCreated or TourContext.BookingRepository.PersistDepositProcessed or TourContext.BookingRepository.PersistFinalPaymentProcessed or TourContext.BookingRepository.PersistGuestCheckedIn or TourContext.BookingRepository.PersistParticipantAdded or TourContext.BookingRepository.PersistParticipantRemoved or TourContext.BookingRepository.PersistRefundProcessed or TourContext.BookingRepository.PersistReviewSubmitted or TourContext.BookingRepository.PersistTourCompleted or TourContext.BookingRepository.PersistTourStarted
  } with {
    briefly "Anything that writes BookingRepository"
    described as {
      |The persistence commands BookingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BookingRepository as flow is {
    inlet BookingRepositoryFromTourAnalytics is type BookingRepositoryCommand    command PersistAddOnAdded is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row AddOnAdded applies to.
        }
      }
    } with {
      briefly "Persist AddOnAdded"
      described as {
        |Instructs this repository to apply AddOnAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDepositProcessed is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row DepositProcessed applies to.
        }
      }
    } with {
      briefly "Persist DepositProcessed"
      described as {
        |Instructs this repository to apply DepositProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGuestCheckedIn is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row GuestCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist GuestCheckedIn"
      described as {
        |Instructs this repository to apply GuestCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistParticipantAdded is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row ParticipantAdded applies to.
        }
      }
    } with {
      briefly "Persist ParticipantAdded"
      described as {
        |Instructs this repository to apply ParticipantAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistParticipantRemoved is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row ParticipantRemoved applies to.
        }
      }
    } with {
      briefly "Persist ParticipantRemoved"
      described as {
        |Instructs this repository to apply ParticipantRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefundProcessed is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefundProcessed applies to.
        }
      }
    } with {
      briefly "Persist RefundProcessed"
      described as {
        |Instructs this repository to apply RefundProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTourStarted is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TourStarted applies to.
        }
      }
    } with {
      briefly "Persist TourStarted"
      described as {
        |Instructs this repository to apply TourStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingCancelled is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCancelled applies to.
        }
      }
    } with {
      briefly "Persist BookingCancelled"
      described as {
        |Instructs this repository to apply BookingCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingConfirmed is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingConfirmed applies to.
        }
      }
    } with {
      briefly "Persist BookingConfirmed"
      described as {
        |Instructs this repository to apply BookingConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingCreated is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCreated applies to.
        }
      }
    } with {
      briefly "Persist BookingCreated"
      described as {
        |Instructs this repository to apply BookingCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinalPaymentProcessed is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinalPaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist FinalPaymentProcessed"
      described as {
        |Instructs this repository to apply FinalPaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewSubmitted is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ReviewSubmitted"
      described as {
        |Instructs this repository to apply ReviewSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTourCompleted is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TourCompleted applies to.
        }
      }
    } with {
      briefly "Persist TourCompleted"
      described as {
        |Instructs this repository to apply TourCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BookingRepositoryResponses is result TourBooking.TourBookingResult
    record StoredTourBooking is {
      tourBookingId: TourBookingId with {
        briefly "tourBookingId"
        described as {
          |The tourBookingId column of the stored tourBooking row.
        }
      }
      bookingId: TourBookingId with {
        briefly "bookingId"
        described as {
          |The bookingId column of the stored tourBooking row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored tourBooking row.
        }
      }
      departure: TourDeparture with {
        briefly "departure"
        described as {
          |The departure column of the stored tourBooking row.
        }
      }
      tour: TourInfo with {
        briefly "tour"
        described as {
          |The tour column of the stored tourBooking row.
        }
      }
    } with {
      briefly "Stored tourBooking row"
      described as {
        |The persistence shape of tourBooking data as this repository stores it.
      }
    }
    schema BookingData is relational
      of bookings as record StoredTourBooking
        index on field StoredTourBooking.bookingId
        index on field StoredTourBooking.customer.customerId
        index on field StoredTourBooking.tour.tourId
        index on field StoredTourBooking.departure.departureId
 with {
      briefly "Booking data schema"
      described as {
        |The relational schema holding booking data for the BookingRepository.
      }
    }
    handler BookingPersistence is {
      on persistAddOnAdded: command PersistAddOnAdded is {
        do "apply AddOnAdded to the stored row"
      }
      on persistDepositProcessed: command PersistDepositProcessed is {
        do "apply DepositProcessed to the stored row"
      }
      on persistGuestCheckedIn: command PersistGuestCheckedIn is {
        do "apply GuestCheckedIn to the stored row"
      }
      on persistParticipantAdded: command PersistParticipantAdded is {
        do "apply ParticipantAdded to the stored row"
      }
      on persistParticipantRemoved: command PersistParticipantRemoved is {
        do "apply ParticipantRemoved to the stored row"
      }
      on persistRefundProcessed: command PersistRefundProcessed is {
        do "apply RefundProcessed to the stored row"
      }
      on persistTourStarted: command PersistTourStarted is {
        do "apply TourStarted to the stored row"
      }
      on persistBookingCancelled: command PersistBookingCancelled is {
        do "apply BookingCancelled to the stored row"
      }
      on persistBookingConfirmed: command PersistBookingConfirmed is {
        do "apply BookingConfirmed to the stored row"
      }
      on persistBookingCreated: command PersistBookingCreated is {
        do "apply BookingCreated to the stored row"
      }
      on persistFinalPaymentProcessed: command PersistFinalPaymentProcessed is {
        do "apply FinalPaymentProcessed to the stored row"
      }
      on persistReviewSubmitted: command PersistReviewSubmitted is {
        do "apply ReviewSubmitted to the stored row"
      }
      on persistTourCompleted: command PersistTourCompleted is {
        do "apply TourCompleted to the stored row"
      }
      on query GetTourStats is {
        let theTourStatsView: type TourStatsView = prompt("read the tour stats projection")
        reply theTourStatsView
      }
    } with {
      briefly "Persists booking commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Booking data persistence"
    described as {
      | The BookingRepository provides persistent storage for
      | tour bookings and related data.
    }
  }
  // Projector for tour analytics
  query GetTourStats replies result TourStatsView is {
    tourStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which tour stats to retrieve.
      }
    }
  } with {
    briefly "Get tour stats"
    described as {
      |Retrieves the tour stats projection.
    }
  }
  result TourStatsView is {
    tourStats: TourAnalytics.TourStats with {
      briefly "Tour stats"
      described as {
        |The tour stats being returned.
      }
    }
  } with {
    briefly "Tour stats view"
    described as {
      |Read model view carrying the tour stats projection.
    }
  }
  projector TourAnalytics as flow is {
    updates repository TourContext.BookingRepository
    outlet TourAnalyticsToRepository is type BookingRepositoryCommand
    inlet TourAnalyticsFromTourBooking is type TourBookingEvent    record TourStats is {
      totalBookings: Natural with {
        briefly "Total"
        described as {
          |Total bookings.
        }
      }
      confirmedBookings: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed bookings.
        }
      }
      completedTours: Natural with {
        briefly "Completed"
        described as {
          |Completed tours.
        }
      }
      cancelledBookings: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled bookings.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      totalParticipants: Natural with {
        briefly "Participants"
        described as {
          |Total participants.
        }
      }
    } with {
      briefly "Tour statistics"
      described as {
        |Tour booking metrics.
      }
    }
    handler AnalyticsHandler is {
      on addOnAdded: event TourBooking.AddOnAdded is {
        tell command TourContext.BookingRepository.PersistAddOnAdded(bookingId = addOnAdded.bookingId) to repository TourContext.BookingRepository
        do "apply AddOnAdded to the TourAnalytics projection"
      }
      on depositProcessed: event TourBooking.DepositProcessed is {
        tell command TourContext.BookingRepository.PersistDepositProcessed(bookingId = depositProcessed.bookingId) to repository TourContext.BookingRepository
        do "apply DepositProcessed to the TourAnalytics projection"
      }
      on guestCheckedIn: event TourBooking.GuestCheckedIn is {
        tell command TourContext.BookingRepository.PersistGuestCheckedIn(bookingId = guestCheckedIn.bookingId) to repository TourContext.BookingRepository
        do "apply GuestCheckedIn to the TourAnalytics projection"
      }
      on participantAdded: event TourBooking.ParticipantAdded is {
        tell command TourContext.BookingRepository.PersistParticipantAdded(bookingId = participantAdded.bookingId) to repository TourContext.BookingRepository
        do "apply ParticipantAdded to the TourAnalytics projection"
      }
      on participantRemoved: event TourBooking.ParticipantRemoved is {
        tell command TourContext.BookingRepository.PersistParticipantRemoved(bookingId = participantRemoved.bookingId) to repository TourContext.BookingRepository
        do "apply ParticipantRemoved to the TourAnalytics projection"
      }
      on refundProcessed: event TourBooking.RefundProcessed is {
        tell command TourContext.BookingRepository.PersistRefundProcessed(bookingId = refundProcessed.bookingId) to repository TourContext.BookingRepository
        do "apply RefundProcessed to the TourAnalytics projection"
      }
      on tourStarted: event TourBooking.TourStarted is {
        tell command TourContext.BookingRepository.PersistTourStarted(bookingId = tourStarted.bookingId) to repository TourContext.BookingRepository
        do "apply TourStarted to the TourAnalytics projection"
      }
      on bookingCreated: event TourBooking.BookingCreated is {
        tell command TourContext.BookingRepository.PersistBookingCreated(bookingId = bookingCreated.bookingId) to repository TourContext.BookingRepository
        do "Update booking counts"
      }
      on bookingConfirmed: event TourBooking.BookingConfirmed is {
        tell command TourContext.BookingRepository.PersistBookingConfirmed(bookingId = bookingConfirmed.bookingId) to repository TourContext.BookingRepository
        do "Update confirmed counts"
      }
      on finalPaymentProcessed: event TourBooking.FinalPaymentProcessed is {
        tell command TourContext.BookingRepository.PersistFinalPaymentProcessed(bookingId = finalPaymentProcessed.bookingId) to repository TourContext.BookingRepository
        do "Update revenue metrics"
      }
      on tourCompleted: event TourBooking.TourCompleted is {
        tell command TourContext.BookingRepository.PersistTourCompleted(bookingId = tourCompleted.bookingId) to repository TourContext.BookingRepository
        do "Update completion metrics"
      }
      on reviewSubmitted: event TourBooking.ReviewSubmitted is {
        tell command TourContext.BookingRepository.PersistReviewSubmitted(bookingId = reviewSubmitted.bookingId) to repository TourContext.BookingRepository
        do "Update rating metrics"
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        tell command TourContext.BookingRepository.PersistBookingCancelled(bookingId = bookingCancelled.bookingId) to repository TourContext.BookingRepository
        do "Update cancellation metrics"
      }
      on alternativeToursRecorded: event TourBooking.AlternativeToursRecorded is {
        do "a alternative tours recorded changes nothing this projector keeps"
      }
      on guideRecorded: event TourBooking.GuideRecorded is {
        do "a guide recorded changes nothing this projector keeps"
      }
      on tourDetailsRecorded: event TourBooking.TourDetailsRecorded is {
        do "a tour details recorded changes nothing this projector keeps"
      }
    } with {
      briefly "Maintains tour analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Tour analytics projections"
    described as {
      |Maintains tour booking analytics data.
    }
  }
  // ---- Event publication for TourBooking ----
  type TourBookingEvent is one of {
    TourContext.TourBooking.BookingCreated or TourContext.TourBooking.ParticipantAdded or TourContext.TourBooking.ParticipantRemoved or TourContext.TourBooking.AddOnAdded or TourContext.TourBooking.DepositProcessed or TourContext.TourBooking.BookingConfirmed or TourContext.TourBooking.FinalPaymentProcessed or TourContext.TourBooking.GuestCheckedIn or TourContext.TourBooking.TourStarted or TourContext.TourBooking.TourCompleted or TourContext.TourBooking.ReviewSubmitted or TourContext.TourBooking.BookingCancelled or TourContext.TourBooking.RefundProcessed or TourContext.TourBooking.AlternativeToursRecorded or TourContext.TourBooking.TourDetailsRecorded or TourContext.TourBooking.GuideRecorded
  } with {
    briefly "TourBooking event alternation"
    described as {
      |Union of all TourBooking events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet TourBookingEventSplit as split is {
    outlet TourBookingEventSplitToToWaiverManagementService is type TourBookingEvent
    outlet TourBookingEventSplitToToTourCatalogService is type TourBookingEvent
    outlet TourBookingEventSplitToToPaymentProcessingService is type TourBookingEvent
    outlet TourBookingEventSplitToToNotificationService is type TourBookingEvent
    outlet TourBookingEventSplitToToGuideAssignmentService is type TourBookingEvent
    outlet TourBookingEventSplitToToDepartureAvailabilityService is type TourBookingEvent
    inlet TourBookingEventSplitIn is type TourBookingEvent    outlet TourBookingEventSplitToTourAnalytics is type TourBookingEvent
    handler TourBookingEventSplitHandler is {
      on bookingCreated: event TourBooking.BookingCreated is {
        send bookingCreated to outlet TourBookingEventSplitToTourAnalytics
        send bookingCreated to outlet TourBookingEventSplitToToTourCatalogService
        send bookingCreated to outlet TourBookingEventSplitToToNotificationService
        send bookingCreated to outlet TourBookingEventSplitToToDepartureAvailabilityService
        tell bookingCreated to entity TourContext.TourBooking
      }
      on participantAdded: event TourBooking.ParticipantAdded is {
        send participantAdded to outlet TourBookingEventSplitToTourAnalytics
        send participantAdded to outlet TourBookingEventSplitToToWaiverManagementService
        send participantAdded to outlet TourBookingEventSplitToToDepartureAvailabilityService
        tell participantAdded to entity TourContext.TourBooking
      }
      on participantRemoved: event TourBooking.ParticipantRemoved is {
        send participantRemoved to outlet TourBookingEventSplitToTourAnalytics
        send participantRemoved to outlet TourBookingEventSplitToToDepartureAvailabilityService
        tell participantRemoved to entity TourContext.TourBooking
      }
      on addOnAdded: event TourBooking.AddOnAdded is {
        send addOnAdded to outlet TourBookingEventSplitToTourAnalytics
        tell addOnAdded to entity TourContext.TourBooking
      }
      on depositProcessed: event TourBooking.DepositProcessed is {
        send depositProcessed to outlet TourBookingEventSplitToTourAnalytics
        send depositProcessed to outlet TourBookingEventSplitToToPaymentProcessingService
        tell depositProcessed to entity TourContext.TourBooking
      }
      on bookingConfirmed: event TourBooking.BookingConfirmed is {
        send bookingConfirmed to outlet TourBookingEventSplitToTourAnalytics
        send bookingConfirmed to outlet TourBookingEventSplitToToNotificationService
        send bookingConfirmed to outlet TourBookingEventSplitToToGuideAssignmentService
        tell bookingConfirmed to entity TourContext.TourBooking
      }
      on finalPaymentProcessed: event TourBooking.FinalPaymentProcessed is {
        send finalPaymentProcessed to outlet TourBookingEventSplitToTourAnalytics
        send finalPaymentProcessed to outlet TourBookingEventSplitToToPaymentProcessingService
        tell finalPaymentProcessed to entity TourContext.TourBooking
      }
      on guestCheckedIn: event TourBooking.GuestCheckedIn is {
        send guestCheckedIn to outlet TourBookingEventSplitToTourAnalytics
        tell guestCheckedIn to entity TourContext.TourBooking
      }
      on tourStarted: event TourBooking.TourStarted is {
        send tourStarted to outlet TourBookingEventSplitToTourAnalytics
        tell tourStarted to entity TourContext.TourBooking
      }
      on tourCompleted: event TourBooking.TourCompleted is {
        send tourCompleted to outlet TourBookingEventSplitToTourAnalytics
        send tourCompleted to outlet TourBookingEventSplitToToNotificationService
        tell tourCompleted to entity TourContext.TourBooking
      }
      on reviewSubmitted: event TourBooking.ReviewSubmitted is {
        send reviewSubmitted to outlet TourBookingEventSplitToTourAnalytics
        tell reviewSubmitted to entity TourContext.TourBooking
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        send bookingCancelled to outlet TourBookingEventSplitToTourAnalytics
        send bookingCancelled to outlet TourBookingEventSplitToToTourCatalogService
        send bookingCancelled to outlet TourBookingEventSplitToToPaymentProcessingService
        send bookingCancelled to outlet TourBookingEventSplitToToDepartureAvailabilityService
        tell bookingCancelled to entity TourContext.TourBooking
      }
      on refundProcessed: event TourBooking.RefundProcessed is {
        send refundProcessed to outlet TourBookingEventSplitToTourAnalytics
        tell refundProcessed to entity TourContext.TourBooking
      }
      on alternativeToursRecorded: event TourBooking.AlternativeToursRecorded is {
        send alternativeToursRecorded to outlet TourBookingEventSplitToTourAnalytics
        tell alternativeToursRecorded to entity TourContext.TourBooking
      }
      on tourDetailsRecorded: event TourBooking.TourDetailsRecorded is {
        send tourDetailsRecorded to outlet TourBookingEventSplitToTourAnalytics
        tell tourDetailsRecorded to entity TourContext.TourBooking
      }
      on guideRecorded: event TourBooking.GuideRecorded is {
        send guideRecorded to outlet TourBookingEventSplitToTourAnalytics
        tell guideRecorded to entity TourContext.TourBooking
      }
      on other is {
        error "Unexpected message for processor TourBookingEventSplit"
      }
    } with {
      briefly "TourBooking event fan-out handler"
      described as {
        |Delivers each TourBooking event to all of its consumers.
      }
    }
  } with {
    briefly "TourBooking event fan-out"
    described as {
      |Fans TourBooking events out to the repository and projectors.
    }
  }
  connector 'ToWaiverManagementService Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToToWaiverManagementService to inlet TourContext.ToWaiverManagementService.ToWaiverManagementServiceIn with {
    briefly "The TourBooking events ToWaiverManagementService translates, on their way to it"
  }
  connector 'ToTourCatalogService Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToToTourCatalogService to inlet TourContext.ToTourCatalogService.ToTourCatalogServiceIn with {
    briefly "The TourBooking events ToTourCatalogService translates, on their way to it"
  }
  connector 'ToPaymentProcessingService Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToToPaymentProcessingService to inlet TourContext.ToPaymentProcessingService.ToPaymentProcessingServiceIn with {
    briefly "The TourBooking events ToPaymentProcessingService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToToNotificationService to inlet TourContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The TourBooking events ToNotificationService translates, on their way to it"
  }
  connector 'ToGuideAssignmentService Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToToGuideAssignmentService to inlet TourContext.ToGuideAssignmentService.ToGuideAssignmentServiceIn with {
    briefly "The TourBooking events ToGuideAssignmentService translates, on their way to it"
  }
  connector 'ToDepartureAvailabilityService Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToToDepartureAvailabilityService to inlet TourContext.ToDepartureAvailabilityService.ToDepartureAvailabilityServiceIn with {
    briefly "The TourBooking events ToDepartureAvailabilityService translates, on their way to it"
  }
  connector 'TourBookingEvent Stream' is from outlet TourContext.TourBooking.TourBookingEvents2 to inlet TourContext.TourBookingEventSplit.TourBookingEventSplitIn with {
    briefly "TourBookingTo events, fanned out to storage and read models"
  }
  connector 'TourAnalytics Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToTourAnalytics to inlet TourContext.TourAnalytics.TourAnalyticsFromTourBooking with {
    briefly "TourBooking events feeding the TourAnalytics projection"
  }
  connector 'TourAnalytics Storage' is from outlet TourContext.TourAnalytics.TourAnalyticsToRepository to inlet TourContext.BookingRepository.BookingRepositoryFromTourAnalytics with {
    briefly "TourAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for tour operations"
  described as {
    | The TourContext is the bounded context for
    | tour bookings and excursion management.
  }
}
