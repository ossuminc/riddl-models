// Tour Operations - Tour Context
context TourContext as router is {
  inlet TourBookingCommandStreamIn is type TourBookingCommand
  outlet TourBookingCommandStreamOut is type TourBookingCommand
  inlet BookingResultStreamIn is type TourBooking.TourBookingResult
  outlet BookingResultStreamOut is type TourBooking.TourBookingResult
  handler TourContextBoundary is {
    on createBooking: command TourBooking.CreateBooking is {
      send createBooking to outlet TourContext.TourBookingCommandStreamOut
    }
    on addParticipant: command TourBooking.AddParticipant is {
      send addParticipant to outlet TourContext.TourBookingCommandStreamOut
    }
    on removeParticipant: command TourBooking.RemoveParticipant is {
      send removeParticipant to outlet TourContext.TourBookingCommandStreamOut
    }
    on addAddOn: command TourBooking.AddAddOn is {
      send addAddOn to outlet TourContext.TourBookingCommandStreamOut
    }
    on processDeposit: command TourBooking.ProcessDeposit is {
      send processDeposit to outlet TourContext.TourBookingCommandStreamOut
    }
    on confirmBooking: command TourBooking.ConfirmBooking is {
      send confirmBooking to outlet TourContext.TourBookingCommandStreamOut
    }
    on processFinalPayment: command TourBooking.ProcessFinalPayment is {
      send processFinalPayment to outlet TourContext.TourBookingCommandStreamOut
    }
    on checkInMsg: command TourBooking.CheckIn is {
      send checkInMsg to outlet TourContext.TourBookingCommandStreamOut
    }
    on startTour: command TourBooking.StartTour is {
      send startTour to outlet TourContext.TourBookingCommandStreamOut
    }
    on completeTour: command TourBooking.CompleteTour is {
      send completeTour to outlet TourContext.TourBookingCommandStreamOut
    }
    on submitReview: command TourBooking.SubmitReview is {
      send submitReview to outlet TourContext.TourBookingCommandStreamOut
    }
    on cancelBooking: command TourBooking.CancelBooking is {
      send cancelBooking to outlet TourContext.TourBookingCommandStreamOut
    }
    on processRefund: command TourBooking.ProcessRefund is {
      send processRefund to outlet TourContext.TourBookingCommandStreamOut
    }
    on tourBookingResult: result TourBooking.TourBookingResult is {
      send tourBookingResult to outlet TourContext.BookingResultStreamOut
    }
    on other is {
      error "Unexpected message at the TourContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'TourBookingCommand Stream Intake' is from outlet TourContext.TourBookingCommandStreamOut to inlet TourContext.TourBooking.TourBookingCommands
  connector 'BookingResult Stream Egress' is from outlet TourContext.BookingRepository.BookingRepositoryResponses to inlet TourContext.BookingResultStreamIn
  adaptor FromDepartureAvailabilityService from context DepartureAvailabilityService is { 
    handler FromDepartureAvailabilityServiceHandler is {
      on result DepartureAvailabilityService.DepartureAvailability is {
        do "the model receives departure availability"
      }
      on event DepartureAvailabilityService.SpotsReleased is {
        do "the model receives spots released"
      }
      on event DepartureAvailabilityService.SpotsReserved is {
        do "the model receives spots reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromDepartureAvailabilityService"
      }
    } with {
      briefly "from departure availability service"
      described as {
        |Carries messages from the external DepartureAvailabilityService.
      }
    }
  } with {
    briefly "DepartureAvailabilityService integration"
    described as {
      |The model's side of the DepartureAvailabilityService conversation.
    }
  }
  adaptor ToDepartureAvailabilityService to context DepartureAvailabilityService is { 
    handler ToDepartureAvailabilityServiceHandler is {
      on query DepartureAvailabilityService.CheckAvailability is {
        do "the model sends check availability"
      }
      on command DepartureAvailabilityService.ReleaseSpots is {
        do "the model sends release spots"
      }
      on command DepartureAvailabilityService.ReserveSpots is {
        do "the model sends reserve spots"
      }
      on other is {
        error "Unexpected message for adaptor ToDepartureAvailabilityService"
      }
    } with {
      briefly "to departure availability service"
      described as {
        |Carries messages to the external DepartureAvailabilityService.
      }
    }
  } with {
    briefly "DepartureAvailabilityService integration"
    described as {
      |The model's side of the DepartureAvailabilityService conversation.
    }
  }
  adaptor FromGuideAssignmentService from context GuideAssignmentService is { 
    handler FromGuideAssignmentServiceHandler is {
      on result GuideAssignmentService.AvailableGuides is {
        do "the model receives available guides"
      }
      on event GuideAssignmentService.GuideAssigned is {
        do "the model receives guide assigned"
      }
      on other is {
        error "Unexpected message for adaptor FromGuideAssignmentService"
      }
    } with {
      briefly "from guide assignment service"
      described as {
        |Carries messages from the external GuideAssignmentService.
      }
    }
  } with {
    briefly "GuideAssignmentService integration"
    described as {
      |The model's side of the GuideAssignmentService conversation.
    }
  }
  adaptor ToGuideAssignmentService to context GuideAssignmentService is { 
    handler ToGuideAssignmentServiceHandler is {
      on command GuideAssignmentService.AssignGuide is {
        do "the model sends assign guide"
      }
      on query GuideAssignmentService.GetAvailableGuides is {
        do "the model sends get available guides"
      }
      on other is {
        error "Unexpected message for adaptor ToGuideAssignmentService"
      }
    } with {
      briefly "to guide assignment service"
      described as {
        |Carries messages to the external GuideAssignmentService.
      }
    }
  } with {
    briefly "GuideAssignmentService integration"
    described as {
      |The model's side of the GuideAssignmentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event NotificationService.ReminderSent is {
        do "the model receives reminder sent"
      }
      on event NotificationService.ReviewRequestSent is {
        do "the model receives review request sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendBookingConfirmation is {
        do "the model sends send booking confirmation"
      }
      on command NotificationService.SendReviewRequest is {
        do "the model sends send review request"
      }
      on command NotificationService.SendTourReminder is {
        do "the model sends send tour reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentSucceeded is {
        do "the model receives payment succeeded"
      }
      on event PaymentProcessingService.RefundSucceeded is {
        do "the model receives refund succeeded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessBookingRefund is {
        do "the model sends process booking refund"
      }
      on command PaymentProcessingService.ProcessPayment is {
        do "the model sends process payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromTourCatalogService from context TourCatalogService is { 
    handler FromTourCatalogServiceHandler is {
      on result TourCatalogService.TourDetails is {
        do "the model receives tour details"
      }
      on result TourCatalogService.TourSearchResults is {
        do "the model receives tour search results"
      }
      on other is {
        error "Unexpected message for adaptor FromTourCatalogService"
      }
    } with {
      briefly "from tour catalog service"
      described as {
        |Carries messages from the external TourCatalogService.
      }
    }
  } with {
    briefly "TourCatalogService integration"
    described as {
      |The model's side of the TourCatalogService conversation.
    }
  }
  adaptor ToTourCatalogService to context TourCatalogService is { 
    handler ToTourCatalogServiceHandler is {
      on query TourCatalogService.GetTourDetails is {
        do "the model sends get tour details"
      }
      on query TourCatalogService.SearchTours is {
        do "the model sends search tours"
      }
      on other is {
        error "Unexpected message for adaptor ToTourCatalogService"
      }
    } with {
      briefly "to tour catalog service"
      described as {
        |Carries messages to the external TourCatalogService.
      }
    }
  } with {
    briefly "TourCatalogService integration"
    described as {
      |The model's side of the TourCatalogService conversation.
    }
  }
  adaptor FromWaiverManagementService from context WaiverManagementService is { 
    handler FromWaiverManagementServiceHandler is {
      on event WaiverManagementService.WaiverSent is {
        do "the model receives waiver sent"
      }
      on event WaiverManagementService.WaiverSigned is {
        do "the model receives waiver signed"
      }
      on other is {
        error "Unexpected message for adaptor FromWaiverManagementService"
      }
    } with {
      briefly "from waiver management service"
      described as {
        |Carries messages from the external WaiverManagementService.
      }
    }
  } with {
    briefly "WaiverManagementService integration"
    described as {
      |The model's side of the WaiverManagementService conversation.
    }
  }
  adaptor ToWaiverManagementService to context WaiverManagementService is { 
    handler ToWaiverManagementServiceHandler is {
      on command WaiverManagementService.SendWaiver is {
        do "the model sends send waiver"
      }
      on other is {
        error "Unexpected message for adaptor ToWaiverManagementService"
      }
    } with {
      briefly "to waiver management service"
      described as {
        |Carries messages to the external WaiverManagementService.
      }
    }
  } with {
    briefly "WaiverManagementService integration"
    described as {
      |The model's side of the WaiverManagementService conversation.
    }
  }
  include "types.riddl"
  include "TourBooking.riddl"
  // Repository for booking persistence
  repository BookingRepository as merge is {
    command PersistBookingCancelled is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCancelled applies to.
        }
      }
    } with {
      briefly "Persist BookingCancelled"
      described as {
        |Instructs this repository to apply BookingCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingConfirmed is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingConfirmed applies to.
        }
      }
    } with {
      briefly "Persist BookingConfirmed"
      described as {
        |Instructs this repository to apply BookingConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingCreated is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCreated applies to.
        }
      }
    } with {
      briefly "Persist BookingCreated"
      described as {
        |Instructs this repository to apply BookingCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinalPaymentProcessed is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinalPaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist FinalPaymentProcessed"
      described as {
        |Instructs this repository to apply FinalPaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewSubmitted is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ReviewSubmitted"
      described as {
        |Instructs this repository to apply ReviewSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTourCompleted is {
      bookingId: TourBookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row TourCompleted applies to.
        }
      }
    } with {
      briefly "Persist TourCompleted"
      described as {
        |Instructs this repository to apply TourCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet BookingRepositoryFromTourBooking is type TourBookingEvent    inlet BookingRepositoryFromTourAnalytics is type TourBookingEvent    outlet BookingRepositoryResponses is type TourBooking.TourBookingResult
    record StoredTourBooking is  {
      tourBookingId: TourBookingId with {
        briefly "tourBookingId"
        described as {
          |The tourBookingId column of the stored tourBooking row.
        }
      }
      bookingId: TourBookingId with {
        briefly "bookingId"
        described as {
          |The bookingId column of the stored tourBooking row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored tourBooking row.
        }
      }
      departure: TourDeparture with {
        briefly "departure"
        described as {
          |The departure column of the stored tourBooking row.
        }
      }
      tour: TourInfo with {
        briefly "tour"
        described as {
          |The tour column of the stored tourBooking row.
        }
      }
    } with {
      briefly "Stored tourBooking row"
      described as {
        |The persistence shape of tourBooking data as this repository stores it.
      }
    }
    schema BookingData is relational
      of bookings as type StoredTourBooking
        index on field StoredTourBooking.bookingId
        index on field StoredTourBooking.customer.customerId
        index on field StoredTourBooking.tour.tourId
        index on field StoredTourBooking.departure.departureId
 with {
      briefly "Booking data schema"
      described as {
        |The relational schema holding booking data for the BookingRepository.
      }
    }
    handler BookingPersistence is {
      on persistBookingCancelled: command PersistBookingCancelled is {
        do "apply BookingCancelled to the stored row"
      }
      on persistBookingConfirmed: command PersistBookingConfirmed is {
        do "apply BookingConfirmed to the stored row"
      }
      on persistBookingCreated: command PersistBookingCreated is {
        do "apply BookingCreated to the stored row"
      }
      on persistFinalPaymentProcessed: command PersistFinalPaymentProcessed is {
        do "apply FinalPaymentProcessed to the stored row"
      }
      on persistReviewSubmitted: command PersistReviewSubmitted is {
        do "apply ReviewSubmitted to the stored row"
      }
      on persistTourCompleted: command PersistTourCompleted is {
        do "apply TourCompleted to the stored row"
      }
      on query GetTourStats is {
        let theTourStatsView: type TourStatsView = prompt("read the tour stats projection")
        reply theTourStatsView
      }
      on createBooking: command TourBooking.CreateBooking is {
        tell event TourBooking.BookingCreated(bookingId = createBooking.bookingId, customer = createBooking.customer, tour = createBooking.tour, departure = createBooking.departure, participants = createBooking.participants) to entity TourContext.TourBooking
        do "Store new booking"
      }
      on addParticipant: command TourBooking.AddParticipant is {
        tell event TourBooking.ParticipantAdded(bookingId = addParticipant.bookingId, participant = addParticipant.participant) to entity TourContext.TourBooking
        do "Add participant to booking"
      }
      on removeParticipant: command TourBooking.RemoveParticipant is {
        tell event TourBooking.ParticipantRemoved(bookingId = removeParticipant.bookingId, participantName = removeParticipant.participantName) to entity TourContext.TourBooking
        do "Remove participant from booking"
      }
      on addAddOn: command TourBooking.AddAddOn is {
        tell event TourBooking.AddOnAdded(bookingId = addAddOn.bookingId, addOn = addAddOn.addOn) to entity TourContext.TourBooking
        do "Add add-on to booking"
      }
      on processDeposit: command TourBooking.ProcessDeposit is {
        tell event TourBooking.DepositProcessed(bookingId = processDeposit.bookingId, amount = processDeposit.amount) to entity TourContext.TourBooking
        do "Store deposit payment"
      }
      on confirmBooking: command TourBooking.ConfirmBooking is {
        tell event TourBooking.BookingConfirmed(bookingId = confirmBooking.bookingId, confirmationCode = confirmBooking.confirmationCode) to entity TourContext.TourBooking
        do "Update to confirmed"
      }
      on processFinalPayment: command TourBooking.ProcessFinalPayment is {
        tell event TourBooking.FinalPaymentProcessed(bookingId = processFinalPayment.bookingId, amount = processFinalPayment.amount) to entity TourContext.TourBooking
        do "Store final payment"
      }
      on command TourBooking.CheckIn is {
        do "Update to checked in"
      }
      on startTour: command TourBooking.StartTour is {
        tell event TourBooking.TourStarted(bookingId = startTour.bookingId, startedAt = startTour.startedAt) to entity TourContext.TourBooking
        do "Update to in progress"
      }
      on completeTour: command TourBooking.CompleteTour is {
        tell event TourBooking.TourCompleted(bookingId = completeTour.bookingId, completedAt = completeTour.completedAt) to entity TourContext.TourBooking
        do "Update to completed"
      }
      on submitReview: command TourBooking.SubmitReview is {
        tell event TourBooking.ReviewSubmitted(bookingId = submitReview.bookingId, rating = submitReview.rating, review = submitReview.review) to entity TourContext.TourBooking
        do "Store review"
      }
      on cancelBooking: command TourBooking.CancelBooking is {
        tell event TourBooking.BookingCancelled(bookingId = cancelBooking.bookingId, reason = cancelBooking.reason) to entity TourContext.TourBooking
        do "Update to cancelled"
      }
      on processRefund: command TourBooking.ProcessRefund is {
        tell event TourBooking.RefundProcessed(bookingId = processRefund.bookingId, refundAmount = processRefund.refundAmount) to entity TourContext.TourBooking
        do "Store refund"
      }
    } with {
      briefly "Persists booking commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Booking data persistence"
    described as {
      | The BookingRepository provides persistent storage for
      | tour bookings and related data.
    }
  }
  // Projector for tour analytics
  query GetTourStats is  {
    tourStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which tour stats to retrieve.
      }
    }
  } with {
    briefly "Get tour stats"
    described as {
      |Retrieves the tour stats projection.
    }
  }
  result TourStatsView is  {
    tourStats: TourAnalytics.TourStats with {
      briefly "Tour stats"
      described as {
        |The tour stats being returned.
      }
    }
  } with {
    briefly "Tour stats view"
    described as {
      |Read model view carrying the tour stats projection.
    }
  }
  projector TourAnalytics as flow is {
    updates repository TourContext.BookingRepository
    inlet TourAnalyticsFromTourBooking is type TourBookingEvent    outlet TourAnalyticsOut is type TourBookingEvent
    record TourStats is  {
      totalBookings: Natural with {
        briefly "Total"
        described as {
          |Total bookings.
        }
      }
      confirmedBookings: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed bookings.
        }
      }
      completedTours: Natural with {
        briefly "Completed"
        described as {
          |Completed tours.
        }
      }
      cancelledBookings: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled bookings.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      totalParticipants: Natural with {
        briefly "Participants"
        described as {
          |Total participants.
        }
      }
    } with {
      briefly "Tour statistics"
      described as {
        |Tour booking metrics.
      }
    }
    handler AnalyticsHandler is {
      on bookingCreated: event TourBooking.BookingCreated is {
        tell command TourContext.BookingRepository.PersistBookingCreated(bookingId = bookingCreated.bookingId) to repository TourContext.BookingRepository
        do "Update booking counts"
      }
      on bookingConfirmed: event TourBooking.BookingConfirmed is {
        tell command TourContext.BookingRepository.PersistBookingConfirmed(bookingId = bookingConfirmed.bookingId) to repository TourContext.BookingRepository
        do "Update confirmed counts"
      }
      on finalPaymentProcessed: event TourBooking.FinalPaymentProcessed is {
        tell command TourContext.BookingRepository.PersistFinalPaymentProcessed(bookingId = finalPaymentProcessed.bookingId) to repository TourContext.BookingRepository
        do "Update revenue metrics"
      }
      on tourCompleted: event TourBooking.TourCompleted is {
        tell command TourContext.BookingRepository.PersistTourCompleted(bookingId = tourCompleted.bookingId) to repository TourContext.BookingRepository
        do "Update completion metrics"
      }
      on reviewSubmitted: event TourBooking.ReviewSubmitted is {
        tell command TourContext.BookingRepository.PersistReviewSubmitted(bookingId = reviewSubmitted.bookingId) to repository TourContext.BookingRepository
        do "Update rating metrics"
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        tell command TourContext.BookingRepository.PersistBookingCancelled(bookingId = bookingCancelled.bookingId) to repository TourContext.BookingRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains tour analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Tour analytics projections"
    described as {
      |Maintains tour booking analytics data.
    }
  }
  // ---- Event publication for TourBooking ----
  type TourBookingEvent is one of {
    TourContext.TourBooking.BookingCreated or TourContext.TourBooking.ParticipantAdded or TourContext.TourBooking.ParticipantRemoved or TourContext.TourBooking.AddOnAdded or TourContext.TourBooking.DepositProcessed or TourContext.TourBooking.BookingConfirmed or TourContext.TourBooking.FinalPaymentProcessed or TourContext.TourBooking.GuestCheckedIn or TourContext.TourBooking.TourStarted or TourContext.TourBooking.TourCompleted or TourContext.TourBooking.ReviewSubmitted or TourContext.TourBooking.BookingCancelled or TourContext.TourBooking.RefundProcessed
  } with {
    briefly "TourBooking event alternation"
    described as {
      |Union of all TourBooking events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TourBookingEventSource as source is {
    outlet TourBookingEvents is type TourBookingEvent
    handler TourBookingSourceHandler is {
      on bookingCreated: event TourBooking.BookingCreated is {
        send bookingCreated to outlet TourBookingEvents
      }
      on participantAdded: event TourBooking.ParticipantAdded is {
        send participantAdded to outlet TourBookingEvents
      }
      on participantRemoved: event TourBooking.ParticipantRemoved is {
        send participantRemoved to outlet TourBookingEvents
      }
      on addOnAdded: event TourBooking.AddOnAdded is {
        send addOnAdded to outlet TourBookingEvents
      }
      on depositProcessed: event TourBooking.DepositProcessed is {
        send depositProcessed to outlet TourBookingEvents
      }
      on bookingConfirmed: event TourBooking.BookingConfirmed is {
        send bookingConfirmed to outlet TourBookingEvents
      }
      on finalPaymentProcessed: event TourBooking.FinalPaymentProcessed is {
        send finalPaymentProcessed to outlet TourBookingEvents
      }
      on guestCheckedIn: event TourBooking.GuestCheckedIn is {
        send guestCheckedIn to outlet TourBookingEvents
      }
      on tourStarted: event TourBooking.TourStarted is {
        send tourStarted to outlet TourBookingEvents
      }
      on tourCompleted: event TourBooking.TourCompleted is {
        send tourCompleted to outlet TourBookingEvents
      }
      on reviewSubmitted: event TourBooking.ReviewSubmitted is {
        send reviewSubmitted to outlet TourBookingEvents
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        send bookingCancelled to outlet TourBookingEvents
      }
      on refundProcessed: event TourBooking.RefundProcessed is {
        send refundProcessed to outlet TourBookingEvents
      }
      on other is {
        error "Unexpected message for source TourBookingEventSource"
      }
    } with {
      briefly "TourBooking source handler"
      described as {
        |Publishes TourBooking events onto the outlet.
      }
    }
  } with {
    briefly "TourBooking event source"
    described as {
      |Publishes TourBooking entity events into the streaming topology.
    }
  }
  processor TourBookingEventSink as sink is {
    inlet TourBookingInlet is type TourBookingEvent    handler TourBookingSinkHandler is {
      on bookingCreated: event TourBooking.BookingCreated is {
        tell bookingCreated to repository TourContext.BookingRepository
      }
      on participantAdded: event TourBooking.ParticipantAdded is {
        tell participantAdded to repository TourContext.BookingRepository
      }
      on participantRemoved: event TourBooking.ParticipantRemoved is {
        tell participantRemoved to repository TourContext.BookingRepository
      }
      on addOnAdded: event TourBooking.AddOnAdded is {
        tell addOnAdded to repository TourContext.BookingRepository
      }
      on depositProcessed: event TourBooking.DepositProcessed is {
        tell depositProcessed to repository TourContext.BookingRepository
      }
      on bookingConfirmed: event TourBooking.BookingConfirmed is {
        tell bookingConfirmed to repository TourContext.BookingRepository
      }
      on finalPaymentProcessed: event TourBooking.FinalPaymentProcessed is {
        tell finalPaymentProcessed to repository TourContext.BookingRepository
      }
      on guestCheckedIn: event TourBooking.GuestCheckedIn is {
        tell guestCheckedIn to repository TourContext.BookingRepository
      }
      on tourStarted: event TourBooking.TourStarted is {
        tell tourStarted to repository TourContext.BookingRepository
      }
      on tourCompleted: event TourBooking.TourCompleted is {
        tell tourCompleted to repository TourContext.BookingRepository
      }
      on reviewSubmitted: event TourBooking.ReviewSubmitted is {
        tell reviewSubmitted to repository TourContext.BookingRepository
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        tell bookingCancelled to repository TourContext.BookingRepository
      }
      on refundProcessed: event TourBooking.RefundProcessed is {
        tell refundProcessed to repository TourContext.BookingRepository
      }
      on other is {
        error "Unexpected message for sink TourBookingEventSink"
      }
    } with {
      briefly "TourBooking sink handler"
      described as {
        |Persists TourBooking events via the repository.
      }
    }
  } with {
    briefly "TourBooking event sink"
    described as {
      |Receives TourBooking events for persistence.
    }
  }
  connector TourBookingEventFlow is from outlet TourContext.TourBookingEventSource.TourBookingEvents to inlet TourContext.TourBookingEventSink.TourBookingInlet with {
    briefly "TourBooking event flow"
    described as {
      |Connects the TourBooking source to its sink.
    }
  }
  processor TourBookingEventSplit as split is {
    inlet TourBookingEventSplitIn is type TourBookingEvent    outlet TourBookingEventSplitToBookingRepository is type TourBookingEvent
    outlet TourBookingEventSplitToTourAnalytics is type TourBookingEvent
    handler TourBookingEventSplitHandler is {
      on bookingCreated: event TourBooking.BookingCreated is {
        send bookingCreated to outlet TourBookingEventSplitToBookingRepository
        send bookingCreated to outlet TourBookingEventSplitToTourAnalytics
        tell bookingCreated to entity TourContext.TourBooking
      }
      on participantAdded: event TourBooking.ParticipantAdded is {
        send participantAdded to outlet TourBookingEventSplitToBookingRepository
        send participantAdded to outlet TourBookingEventSplitToTourAnalytics
        tell participantAdded to entity TourContext.TourBooking
      }
      on participantRemoved: event TourBooking.ParticipantRemoved is {
        send participantRemoved to outlet TourBookingEventSplitToBookingRepository
        send participantRemoved to outlet TourBookingEventSplitToTourAnalytics
        tell participantRemoved to entity TourContext.TourBooking
      }
      on addOnAdded: event TourBooking.AddOnAdded is {
        send addOnAdded to outlet TourBookingEventSplitToBookingRepository
        send addOnAdded to outlet TourBookingEventSplitToTourAnalytics
        tell addOnAdded to entity TourContext.TourBooking
      }
      on depositProcessed: event TourBooking.DepositProcessed is {
        send depositProcessed to outlet TourBookingEventSplitToBookingRepository
        send depositProcessed to outlet TourBookingEventSplitToTourAnalytics
        tell depositProcessed to entity TourContext.TourBooking
      }
      on bookingConfirmed: event TourBooking.BookingConfirmed is {
        send bookingConfirmed to outlet TourBookingEventSplitToBookingRepository
        send bookingConfirmed to outlet TourBookingEventSplitToTourAnalytics
        tell bookingConfirmed to entity TourContext.TourBooking
      }
      on finalPaymentProcessed: event TourBooking.FinalPaymentProcessed is {
        send finalPaymentProcessed to outlet TourBookingEventSplitToBookingRepository
        send finalPaymentProcessed to outlet TourBookingEventSplitToTourAnalytics
        tell finalPaymentProcessed to entity TourContext.TourBooking
      }
      on guestCheckedIn: event TourBooking.GuestCheckedIn is {
        send guestCheckedIn to outlet TourBookingEventSplitToBookingRepository
        send guestCheckedIn to outlet TourBookingEventSplitToTourAnalytics
        tell guestCheckedIn to entity TourContext.TourBooking
      }
      on tourStarted: event TourBooking.TourStarted is {
        send tourStarted to outlet TourBookingEventSplitToBookingRepository
        send tourStarted to outlet TourBookingEventSplitToTourAnalytics
        tell tourStarted to entity TourContext.TourBooking
      }
      on tourCompleted: event TourBooking.TourCompleted is {
        send tourCompleted to outlet TourBookingEventSplitToBookingRepository
        send tourCompleted to outlet TourBookingEventSplitToTourAnalytics
        tell tourCompleted to entity TourContext.TourBooking
      }
      on reviewSubmitted: event TourBooking.ReviewSubmitted is {
        send reviewSubmitted to outlet TourBookingEventSplitToBookingRepository
        send reviewSubmitted to outlet TourBookingEventSplitToTourAnalytics
        tell reviewSubmitted to entity TourContext.TourBooking
      }
      on bookingCancelled: event TourBooking.BookingCancelled is {
        send bookingCancelled to outlet TourBookingEventSplitToBookingRepository
        send bookingCancelled to outlet TourBookingEventSplitToTourAnalytics
        tell bookingCancelled to entity TourContext.TourBooking
      }
      on refundProcessed: event TourBooking.RefundProcessed is {
        send refundProcessed to outlet TourBookingEventSplitToBookingRepository
        send refundProcessed to outlet TourBookingEventSplitToTourAnalytics
        tell refundProcessed to entity TourContext.TourBooking
      }
      on other is {
        error "Unexpected message for processor TourBookingEventSplit"
      }
    } with {
      briefly "TourBooking event fan-out handler"
      described as {
        |Delivers each TourBooking event to all of its consumers.
      }
    }
  } with {
    briefly "TourBooking event fan-out"
    described as {
      |Fans TourBooking events out to the repository and projectors.
    }
  }
  connector 'TourBookingEvent Stream' is from outlet TourContext.TourBooking.TourBookingEvents2 to inlet TourContext.TourBookingEventSplit.TourBookingEventSplitIn with {
    briefly "TourBookingTo events, fanned out to storage and read models"
  }
  connector 'TourBookingEvent Storage' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToBookingRepository to inlet TourContext.BookingRepository.BookingRepositoryFromTourBooking with {
    briefly "TourBooking events on their way to storage"
  }
  connector 'TourAnalytics Feed' is from outlet TourContext.TourBookingEventSplit.TourBookingEventSplitToTourAnalytics to inlet TourContext.TourAnalytics.TourAnalyticsFromTourBooking with {
    briefly "TourBooking events feeding the TourAnalytics projection"
  }
  connector 'TourAnalytics Storage' is from outlet TourContext.TourAnalytics.TourAnalyticsOut to inlet TourContext.BookingRepository.BookingRepositoryFromTourAnalytics with {
    briefly "The TourAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for tour operations"
  described as {
    | The TourContext is the bounded context for
    | tour bookings and excursion management.
  }
}
