// Car Rental Domain Model
// Vehicle rental and fleet management
domain CarRental is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "person renting vehicle" with {
    briefly "Customer"
    described as {
      |Person renting a vehicle.
    }
  }
  user RentalAgent is "person processing rentals" with {
    briefly "Rental Agent"
    described as {
      |Staff processing rental transactions.
    }
  }
  user FleetManager is "person managing vehicle fleet" with {
    briefly "Fleet Manager"
    described as {
      |Person overseeing vehicle fleet.
    }
  }
  epic RentalEpic is {
    user Customer wants to "to rent a vehicle" so that "I have transportation"
    case RentVehicle is {
      user Customer wants to "to reserve and pick up a vehicle" so that "I can travel to my destination"
      step is "Customer selects" "vehicle type and dates" "from options" with {
        briefly "Select vehicle"
        described as {
          |Choose vehicle and dates.
        }
      }
      step is "Customer provides" "driver information" "and payment" with {
        briefly "Provide info"
        described as {
          |Enter details.
        }
      }
      step take input CarRentalApp.CarRentalScreen.CreateRentalInput from user Customer with {
        briefly "Create rental"
        described as {
          |Submit rental reservation.
        }
      }
      step is "System confirms" "reservation details" "to customer" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Rent vehicle"
      described as {
        |Renting a vehicle.
      }
    }
  } with {
    briefly "Rental management"
    described as {
      | Epic covering vehicle rentals, reservations,
      | and fleet management.
    }
  }
  include "RentalContext.riddl"
  include "external-contexts.riddl"
  application context CarRentalApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CarRental are delivered.
      }
    }
    group CarRentalScreen is {
      input CreateRentalInput acquires command RentalContext.Rental.CreateRental with {
        briefly "Create rental control"
        described as {
          |The control through which a user submits the create rental request.
        }
      }
    } with {
      briefly "Car rental screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRentalCommands is type RentalContext.Rental.RentalCommand
    inlet AppRentalRepositoryResponses is type RentalContext.Rental.RentalResult    handler CarRentalAppHandler is {
      on other is {
        error "Unexpected message for application context CarRentalApp"
      }
    } with {
      briefly "CarRentalApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CarRentalApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppRentalCommands is from outlet CarRentalApp.AppRentalCommands to inlet RentalContext.Rental.RentalCommands with {
    option persistent()
    briefly "LinkAppRentalCommands"
  }
  connector LinkAppRentalRepositoryResponses is from outlet RentalContext.RentalRepository.RentalRepositoryResponses to inlet CarRentalApp.AppRentalRepositoryResponses with {
    option persistent()
    briefly "LinkAppRentalRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CarRentalApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Car rental domain"
  described as {
    | The CarRental domain handles vehicle rentals,
    | reservations, and fleet management.
  }
}
