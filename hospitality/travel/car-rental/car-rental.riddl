// Car Rental Domain Model
// Vehicle rental and fleet management
domain CarRental is {
  persistent connector 'DriverVerificationServiceEvent Stream' is from outlet DriverVerificationService.DriverVerificationServiceEventsOut to inlet RentalContext.FromDriverVerificationService.FromDriverVerificationServiceIn with {
    briefly "What DriverVerificationService tells RentalContext, unasked"
  }
  persistent connector 'FleetMaintenanceServiceEvent Stream' is from outlet FleetMaintenanceService.FleetMaintenanceServiceEventsOut to inlet RentalContext.FromFleetMaintenanceService.FromFleetMaintenanceServiceIn with {
    briefly "What FleetMaintenanceService tells RentalContext, unasked"
  }
  persistent connector 'InsuranceProviderServiceEvent Stream' is from outlet InsuranceProviderService.InsuranceProviderServiceEventsOut to inlet RentalContext.FromInsuranceProviderService.FromInsuranceProviderServiceIn with {
    briefly "What InsuranceProviderService tells RentalContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet RentalContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells RentalContext, unasked"
  }
  persistent connector 'VehicleAvailabilityServiceEvent Stream' is from outlet VehicleAvailabilityService.VehicleAvailabilityServiceEventsOut to inlet RentalContext.FromVehicleAvailabilityService.FromVehicleAvailabilityServiceIn with {
    briefly "What VehicleAvailabilityService tells RentalContext, unasked"
  }
  persistent connector 'PricingServiceRequest Stream' is from outlet RentalContext.ToPricingService.ToPricingServiceOut to inlet PricingService.PricingServiceRequests with {
    briefly "What RentalContext asks PricingService to send"
  }
  persistent connector 'InsuranceProviderServiceRequest Stream' is from outlet RentalContext.ToInsuranceProviderService.ToInsuranceProviderServiceOut to inlet InsuranceProviderService.InsuranceProviderServiceRequests with {
    briefly "What RentalContext asks InsuranceProviderService to send"
  }
  persistent connector 'FleetMaintenanceServiceRequest Stream' is from outlet RentalContext.ToFleetMaintenanceService.ToFleetMaintenanceServiceOut to inlet FleetMaintenanceService.FleetMaintenanceServiceRequests with {
    briefly "What RentalContext asks FleetMaintenanceService to send"
  }
  persistent connector 'VehicleAvailabilityServiceRequest Stream' is from outlet RentalContext.ToVehicleAvailabilityService.ToVehicleAvailabilityServiceOut to inlet VehicleAvailabilityService.VehicleAvailabilityServiceRequests with {
    briefly "What RentalContext asks VehicleAvailabilityService to send"
  }
  persistent connector 'DriverVerificationServiceRequest Stream' is from outlet RentalContext.ToDriverVerificationService.ToDriverVerificationServiceOut to inlet DriverVerificationService.DriverVerificationServiceRequests with {
    briefly "What RentalContext asks DriverVerificationService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet RentalContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What RentalContext asks PaymentProcessingService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet RentalContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What RentalContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Customer is "person renting vehicle" with {
    briefly "Customer"
    described as {
      |Person renting a vehicle.
    }
  }
  user RentalAgent is "person processing rentals" with {
    briefly "Rental Agent"
    described as {
      |Staff processing rental transactions.
    }
  }
  user FleetManager is "person managing vehicle fleet" with {
    briefly "Fleet Manager"
    described as {
      |Person overseeing vehicle fleet.
    }
  }
  epic RentalEpic is {
    user Customer wants to "to rent a vehicle" so that "I have transportation"
    case RentVehicle is {
      user Customer wants to "to reserve and pick up a vehicle" so that "I can travel to my destination"
      step is "Customer selects" "vehicle type and dates" "from options" with {
        briefly "Select vehicle"
        described as {
          |Choose vehicle and dates.
        }
      }
      step is "Customer provides" "driver information" "and payment" with {
        briefly "Provide info"
        described as {
          |Enter details.
        }
      }
      step take input CarRentalApp.CarRentalScreen.CreateRentalInput from user Customer with {
        briefly "Create rental"
        described as {
          |Submit rental reservation.
        }
      }
      step is "System confirms" "reservation details" "to customer" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Rent vehicle"
      described as {
        |Renting a vehicle.
      }
    }
  } with {
    briefly "Rental management"
    described as {
      | Epic covering vehicle rentals, reservations,
      | and fleet management.
    }
  }
  include "RentalContext.riddl"
  include "external-contexts.riddl"
  application context CarRentalApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CarRental are delivered.
      }
    }
    group CarRentalScreen is {
      input CreateRentalInput acquires command RentalContext.Rental.CreateRental with {
        briefly "Create rental control"
        described as {
          |The control through which a user submits the create rental request.
        }
      }
    } with {
      briefly "Car rental screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRentalCommands is type RentalContext.Rental.RentalCommand
    inlet AppRentalRepositoryResponses is result RentalContext.Rental.RentalResult    handler CarRentalAppHandler is {
      on other is {
        error "Unexpected message for application context CarRentalApp"
      }
    } with {
      briefly "CarRentalApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CarRentalApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'RentalCommand Stream' is from outlet CarRentalApp.AppRentalCommands to inlet RentalContext.RentalCommandStreamIn with {
    briefly "Rental commands from the application"
  }
  persistent connector 'RentalResult Stream' is from outlet RentalContext.RentalResultStreamOut to inlet CarRentalApp.AppRentalRepositoryResponses with {
    briefly "Rental query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CarRentalApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Car rental domain"
  described as {
    | The CarRental domain handles vehicle rentals,
    | reservations, and fleet management.
  }
}
