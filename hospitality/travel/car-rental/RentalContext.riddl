// Car Rental - Rental Context
context RentalContext as router is {
  inlet RentalCommandStreamIn is type RentalCommand  outlet RentalCommandStreamOut is type RentalCommand
  inlet RentalResultStreamIn is result Rental.RentalResult  outlet RentalResultStreamOut is result Rental.RentalResult
  handler RentalContextBoundary is {
    on createRental: command Rental.CreateRental is {
      send createRental to outlet RentalContext.RentalCommandStreamOut
    }
    on addAddOn: command Rental.AddAddOn is {
      send addAddOn to outlet RentalContext.RentalCommandStreamOut
    }
    on selectInsurance: command Rental.SelectInsurance is {
      send selectInsurance to outlet RentalContext.RentalCommandStreamOut
    }
    on authorizePayment: command Rental.AuthorizePayment is {
      send authorizePayment to outlet RentalContext.RentalCommandStreamOut
    }
    on checkOutVehicle: command Rental.CheckOutVehicle is {
      send checkOutVehicle to outlet RentalContext.RentalCommandStreamOut
    }
    on extendRental: command Rental.ExtendRental is {
      send extendRental to outlet RentalContext.RentalCommandStreamOut
    }
    on modifyReturnLocation: command Rental.ModifyReturnLocation is {
      send modifyReturnLocation to outlet RentalContext.RentalCommandStreamOut
    }
    on checkInVehicle: command Rental.CheckInVehicle is {
      send checkInVehicle to outlet RentalContext.RentalCommandStreamOut
    }
    on assessDamages: command Rental.AssessDamages is {
      send assessDamages to outlet RentalContext.RentalCommandStreamOut
    }
    on processFinalCharges: command Rental.ProcessFinalCharges is {
      send processFinalCharges to outlet RentalContext.RentalCommandStreamOut
    }
    on completeRental: command Rental.CompleteRental is {
      send completeRental to outlet RentalContext.RentalCommandStreamOut
    }
    on cancelRental: command Rental.CancelRental is {
      send cancelRental to outlet RentalContext.RentalCommandStreamOut
    }
    on rentalResult: result Rental.RentalResult is {
      send rentalResult to outlet RentalContext.RentalResultStreamOut
    }
    on other is {
      error "Unexpected message at the RentalContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'RentalCommand Stream Intake' is from outlet RentalContext.RentalCommandStreamOut to inlet RentalContext.Rental.RentalCommands  connector 'RentalResult Stream Egress' is from outlet RentalContext.RentalRepository.RentalRepositoryResponses to inlet RentalContext.RentalResultStreamIn  adaptor FromDriverVerificationService from context DriverVerificationService is { 
    handler FromDriverVerificationServiceHandler is {
      on event DriverVerificationService.DriverVerified is {
        do "the model receives driver verified"
      }
      on event DriverVerificationService.VerificationFailed is {
        do "the model receives verification failed"
      }
      on other is {
        error "Unexpected message for adaptor FromDriverVerificationService"
      }
    } with {
      briefly "from driver verification service"
      described as {
        |Carries messages from the external DriverVerificationService.
      }
    }
  } with {
    briefly "DriverVerificationService integration"
    described as {
      |The model's side of the DriverVerificationService conversation.
    }
  }
  adaptor ToDriverVerificationService to context DriverVerificationService is { 
    handler ToDriverVerificationServiceHandler is {
      on command DriverVerificationService.VerifyDriver is {
        do "the model sends verify driver"
      }
      on other is {
        error "Unexpected message for adaptor ToDriverVerificationService"
      }
    } with {
      briefly "to driver verification service"
      described as {
        |Carries messages to the external DriverVerificationService.
      }
    }
  } with {
    briefly "DriverVerificationService integration"
    described as {
      |The model's side of the DriverVerificationService conversation.
    }
  }
  adaptor FromFleetMaintenanceService from context FleetMaintenanceService is { 
    handler FromFleetMaintenanceServiceHandler is {
      on event FleetMaintenanceService.DamageReported is {
        do "the model receives damage reported"
      }
      on event FleetMaintenanceService.InspectionScheduled is {
        do "the model receives inspection scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromFleetMaintenanceService"
      }
    } with {
      briefly "from fleet maintenance service"
      described as {
        |Carries messages from the external FleetMaintenanceService.
      }
    }
  } with {
    briefly "FleetMaintenanceService integration"
    described as {
      |The model's side of the FleetMaintenanceService conversation.
    }
  }
  adaptor ToFleetMaintenanceService to context FleetMaintenanceService is { 
    handler ToFleetMaintenanceServiceHandler is {
      on command FleetMaintenanceService.ReportDamage is {
        do "the model sends report damage"
      }
      on command FleetMaintenanceService.ScheduleInspection is {
        do "the model sends schedule inspection"
      }
      on other is {
        error "Unexpected message for adaptor ToFleetMaintenanceService"
      }
    } with {
      briefly "to fleet maintenance service"
      described as {
        |Carries messages to the external FleetMaintenanceService.
      }
    }
  } with {
    briefly "FleetMaintenanceService integration"
    described as {
      |The model's side of the FleetMaintenanceService conversation.
    }
  }
  adaptor FromInsuranceProviderService from context InsuranceProviderService is { 
    handler FromInsuranceProviderServiceHandler is {
      on event InsuranceProviderService.CoverageActivated is {
        do "the model receives coverage activated"
      }
      on result InsuranceProviderService.InsuranceOptions is {
        do "the model receives insurance options"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceProviderService"
      }
    } with {
      briefly "from insurance provider service"
      described as {
        |Carries messages from the external InsuranceProviderService.
      }
    }
  } with {
    briefly "InsuranceProviderService integration"
    described as {
      |The model's side of the InsuranceProviderService conversation.
    }
  }
  adaptor ToInsuranceProviderService to context InsuranceProviderService is { 
    handler ToInsuranceProviderServiceHandler is {
      on command InsuranceProviderService.ActivateCoverage is {
        do "the model sends activate coverage"
      }
      on query InsuranceProviderService.GetInsuranceOptions is {
        do "the model sends get insurance options"
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceProviderService"
      }
    } with {
      briefly "to insurance provider service"
      described as {
        |Carries messages to the external InsuranceProviderService.
      }
    }
  } with {
    briefly "InsuranceProviderService integration"
    described as {
      |The model's side of the InsuranceProviderService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event NotificationService.ReceiptSent is {
        do "the model receives receipt sent"
      }
      on event NotificationService.ReminderSent is {
        do "the model receives reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendPickupReminder is {
        do "the model sends send pickup reminder"
      }
      on command NotificationService.SendReceipt is {
        do "the model sends send receipt"
      }
      on command NotificationService.SendReservationConfirmation is {
        do "the model sends send reservation confirmation"
      }
      on command NotificationService.SendReturnReminder is {
        do "the model sends send return reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentCaptured is {
        do "the model receives payment captured"
      }
      on event PaymentProcessingService.RefundProcessed is {
        do "the model receives refund processed"
      }
      on event PaymentProcessingService.RentalPaymentAuthorized is {
        do "the model receives rental payment authorized"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.AuthorizeRentalPayment is {
        do "the model sends authorize rental payment"
      }
      on command PaymentProcessingService.CapturePayment is {
        do "the model sends capture payment"
      }
      on command PaymentProcessingService.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromPricingService from context PricingService is { 
    handler FromPricingServiceHandler is {
      on result PricingService.RentalPrice is {
        do "the model receives rental price"
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor ToPricingService to context PricingService is { 
    handler ToPricingServiceHandler is {
      on query PricingService.CalculateRentalPrice is {
        do "the model sends calculate rental price"
      }
      on other is {
        error "Unexpected message for adaptor ToPricingService"
      }
    } with {
      briefly "to pricing service"
      described as {
        |Carries messages to the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromVehicleAvailabilityService from context VehicleAvailabilityService is { 
    handler FromVehicleAvailabilityServiceHandler is {
      on result VehicleAvailabilityService.AvailableVehicles is {
        do "the model receives available vehicles"
      }
      on event VehicleAvailabilityService.VehicleReleased is {
        do "the model receives vehicle released"
      }
      on event VehicleAvailabilityService.VehicleReserved is {
        do "the model receives vehicle reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromVehicleAvailabilityService"
      }
    } with {
      briefly "from vehicle availability service"
      described as {
        |Carries messages from the external VehicleAvailabilityService.
      }
    }
  } with {
    briefly "VehicleAvailabilityService integration"
    described as {
      |The model's side of the VehicleAvailabilityService conversation.
    }
  }
  adaptor ToVehicleAvailabilityService to context VehicleAvailabilityService is { 
    handler ToVehicleAvailabilityServiceHandler is {
      on command VehicleAvailabilityService.ReleaseVehicle is {
        do "the model sends release vehicle"
      }
      on command VehicleAvailabilityService.ReserveVehicle is {
        do "the model sends reserve vehicle"
      }
      on query VehicleAvailabilityService.SearchAvailableVehicles is {
        do "the model sends search available vehicles"
      }
      on other is {
        error "Unexpected message for adaptor ToVehicleAvailabilityService"
      }
    } with {
      briefly "to vehicle availability service"
      described as {
        |Carries messages to the external VehicleAvailabilityService.
      }
    }
  } with {
    briefly "VehicleAvailabilityService integration"
    described as {
      |The model's side of the VehicleAvailabilityService conversation.
    }
  }
  include "types.riddl"
  include "Rental.riddl"
  // Repository for rental persistence
  type RentalRepositoryCommand is one of {
    RentalContext.RentalRepository.PersistAddOnAdded or RentalContext.RentalRepository.PersistDamagesAssessed or RentalContext.RentalRepository.PersistFinalChargesProcessed or RentalContext.RentalRepository.PersistInsuranceSelected or RentalContext.RentalRepository.PersistPaymentAuthorized or RentalContext.RentalRepository.PersistRentalCancelled or RentalContext.RentalRepository.PersistRentalCompleted or RentalContext.RentalRepository.PersistRentalCreated or RentalContext.RentalRepository.PersistRentalExtended or RentalContext.RentalRepository.PersistReturnLocationModified or RentalContext.RentalRepository.PersistVehicleCheckedIn or RentalContext.RentalRepository.PersistVehicleCheckedOut
  } with {
    briefly "Anything that writes RentalRepository"
    described as {
      |The persistence commands RentalRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository RentalRepository as flow is {
    inlet RentalRepositoryFromRentalAnalytics is type RentalRepositoryCommand
    command PersistAddOnAdded is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row AddOnAdded applies to.
        }
      }
    } with {
      briefly "Persist AddOnAdded"
      described as {
        |Instructs this repository to apply AddOnAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDamagesAssessed is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row DamagesAssessed applies to.
        }
      }
    } with {
      briefly "Persist DamagesAssessed"
      described as {
        |Instructs this repository to apply DamagesAssessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInsuranceSelected is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row InsuranceSelected applies to.
        }
      }
    } with {
      briefly "Persist InsuranceSelected"
      described as {
        |Instructs this repository to apply InsuranceSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentAuthorized is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentAuthorized applies to.
        }
      }
    } with {
      briefly "Persist PaymentAuthorized"
      described as {
        |Instructs this repository to apply PaymentAuthorized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalExtended is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalExtended applies to.
        }
      }
    } with {
      briefly "Persist RentalExtended"
      described as {
        |Instructs this repository to apply RentalExtended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnLocationModified is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnLocationModified applies to.
        }
      }
    } with {
      briefly "Persist ReturnLocationModified"
      described as {
        |Instructs this repository to apply ReturnLocationModified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleCheckedIn is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist VehicleCheckedIn"
      described as {
        |Instructs this repository to apply VehicleCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinalChargesProcessed is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinalChargesProcessed applies to.
        }
      }
    } with {
      briefly "Persist FinalChargesProcessed"
      described as {
        |Instructs this repository to apply FinalChargesProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalCancelled is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalCancelled applies to.
        }
      }
    } with {
      briefly "Persist RentalCancelled"
      described as {
        |Instructs this repository to apply RentalCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalCompleted is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalCompleted applies to.
        }
      }
    } with {
      briefly "Persist RentalCompleted"
      described as {
        |Instructs this repository to apply RentalCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalCreated is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalCreated applies to.
        }
      }
    } with {
      briefly "Persist RentalCreated"
      described as {
        |Instructs this repository to apply RentalCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleCheckedOut is  {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleCheckedOut applies to.
        }
      }
    } with {
      briefly "Persist VehicleCheckedOut"
      described as {
        |Instructs this repository to apply VehicleCheckedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet RentalRepositoryResponses is result Rental.RentalResult
    record StoredRental is  {
      rentalId: RentalId with {
        briefly "rentalId"
        described as {
          |The rentalId column of the stored rental row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored rental row.
        }
      }
      period: RentalPeriod with {
        briefly "period"
        described as {
          |The period column of the stored rental row.
        }
      }
      vehicle: VehicleInfo with {
        briefly "vehicle"
        described as {
          |The vehicle column of the stored rental row.
        }
      }
    } with {
      briefly "Stored rental row"
      described as {
        |The persistence shape of rental data as this repository stores it.
      }
    }
    schema RentalData is relational
      of rentals as record StoredRental
        index on field StoredRental.rentalId
        index on field StoredRental.customer.customerId
        index on field StoredRental.vehicle.vehicleId
        index on field StoredRental.period.pickupLocation.locationId
 with {
      briefly "Rental data schema"
      described as {
        |The relational schema holding rental data for the RentalRepository.
      }
    }
    handler RentalPersistence is {
      on persistAddOnAdded: command PersistAddOnAdded is {
        do "apply AddOnAdded to the stored row"
      }
      on persistDamagesAssessed: command PersistDamagesAssessed is {
        do "apply DamagesAssessed to the stored row"
      }
      on persistInsuranceSelected: command PersistInsuranceSelected is {
        do "apply InsuranceSelected to the stored row"
      }
      on persistPaymentAuthorized: command PersistPaymentAuthorized is {
        do "apply PaymentAuthorized to the stored row"
      }
      on persistRentalExtended: command PersistRentalExtended is {
        do "apply RentalExtended to the stored row"
      }
      on persistReturnLocationModified: command PersistReturnLocationModified is {
        do "apply ReturnLocationModified to the stored row"
      }
      on persistVehicleCheckedIn: command PersistVehicleCheckedIn is {
        do "apply VehicleCheckedIn to the stored row"
      }
      on persistFinalChargesProcessed: command PersistFinalChargesProcessed is {
        do "apply FinalChargesProcessed to the stored row"
      }
      on persistRentalCancelled: command PersistRentalCancelled is {
        do "apply RentalCancelled to the stored row"
      }
      on persistRentalCompleted: command PersistRentalCompleted is {
        do "apply RentalCompleted to the stored row"
      }
      on persistRentalCreated: command PersistRentalCreated is {
        do "apply RentalCreated to the stored row"
      }
      on persistVehicleCheckedOut: command PersistVehicleCheckedOut is {
        do "apply VehicleCheckedOut to the stored row"
      }
      on query GetRentalStats is {
        let rentalStatsView: type RentalStatsView = prompt("read the rental stats projection")
        reply rentalStatsView
      }
    } with {
      briefly "Persists rental commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Rental data persistence"
    described as {
      | The RentalRepository provides persistent storage for
      | rentals and related data.
    }
  }
  // Projector for rental analytics
  query GetRentalStats replies result RentalStatsView is  {
    rentalStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which rental stats to retrieve.
      }
    }
  } with {
    briefly "Get rental stats"
    described as {
      |Retrieves the rental stats projection.
    }
  }
  result RentalStatsView is  {
    rentalStats: RentalAnalytics.RentalStats with {
      briefly "Rental stats"
      described as {
        |The rental stats being returned.
      }
    }
  } with {
    briefly "Rental stats view"
    described as {
      |Read model view carrying the rental stats projection.
    }
  }
  projector RentalAnalytics as flow is {
    outlet RentalAnalyticsToRepository is type RentalRepositoryCommand
    updates repository RentalContext.RentalRepository
    inlet RentalAnalyticsFromRental is type RentalEvent
    record RentalStats is  {
      totalRentals: Natural with {
        briefly "Total"
        described as {
          |Total rentals.
        }
      }
      activeRentals: Natural with {
        briefly "Active"
        described as {
          |Active rentals.
        }
      }
      completedRentals: Natural with {
        briefly "Completed"
        described as {
          |Completed rentals.
        }
      }
      cancelledRentals: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled rentals.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageRentalDays: Decimal(5,2) with {
        briefly "Avg days"
        described as {
          |Average rental duration.
        }
      }
      fleetUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Fleet utilization rate.
        }
      }
    } with {
      briefly "Rental statistics"
      described as {
        |Rental operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on addOnAdded: event Rental.AddOnAdded is {
        tell command RentalContext.RentalRepository.PersistAddOnAdded(rentalId = addOnAdded.rentalId) to repository RentalContext.RentalRepository
        do "apply AddOnAdded to the RentalAnalytics projection"
      }
      on damagesAssessed: event Rental.DamagesAssessed is {
        tell command RentalContext.RentalRepository.PersistDamagesAssessed(rentalId = damagesAssessed.rentalId) to repository RentalContext.RentalRepository
        do "apply DamagesAssessed to the RentalAnalytics projection"
      }
      on insuranceSelected: event Rental.InsuranceSelected is {
        tell command RentalContext.RentalRepository.PersistInsuranceSelected(rentalId = insuranceSelected.rentalId) to repository RentalContext.RentalRepository
        do "apply InsuranceSelected to the RentalAnalytics projection"
      }
      on paymentAuthorized: event Rental.PaymentAuthorized is {
        tell command RentalContext.RentalRepository.PersistPaymentAuthorized(rentalId = paymentAuthorized.rentalId) to repository RentalContext.RentalRepository
        do "apply PaymentAuthorized to the RentalAnalytics projection"
      }
      on rentalExtended: event Rental.RentalExtended is {
        tell command RentalContext.RentalRepository.PersistRentalExtended(rentalId = rentalExtended.rentalId) to repository RentalContext.RentalRepository
        do "apply RentalExtended to the RentalAnalytics projection"
      }
      on returnLocationModified: event Rental.ReturnLocationModified is {
        tell command RentalContext.RentalRepository.PersistReturnLocationModified(rentalId = returnLocationModified.rentalId) to repository RentalContext.RentalRepository
        do "apply ReturnLocationModified to the RentalAnalytics projection"
      }
      on vehicleCheckedIn: event Rental.VehicleCheckedIn is {
        tell command RentalContext.RentalRepository.PersistVehicleCheckedIn(rentalId = vehicleCheckedIn.rentalId) to repository RentalContext.RentalRepository
        do "apply VehicleCheckedIn to the RentalAnalytics projection"
      }
      on rentalCreated: event Rental.RentalCreated is {
        tell command RentalContext.RentalRepository.PersistRentalCreated(rentalId = rentalCreated.rentalId) to repository RentalContext.RentalRepository
        do "Update rental counts"
      }
      on vehicleCheckedOut: event Rental.VehicleCheckedOut is {
        tell command RentalContext.RentalRepository.PersistVehicleCheckedOut(rentalId = vehicleCheckedOut.rentalId) to repository RentalContext.RentalRepository
        do "Update active counts"
      }
      on finalChargesProcessed: event Rental.FinalChargesProcessed is {
        tell command RentalContext.RentalRepository.PersistFinalChargesProcessed(rentalId = finalChargesProcessed.rentalId) to repository RentalContext.RentalRepository
        do "Update revenue metrics"
      }
      on rentalCompleted: event Rental.RentalCompleted is {
        tell command RentalContext.RentalRepository.PersistRentalCompleted(rentalId = rentalCompleted.rentalId) to repository RentalContext.RentalRepository
        do "Update completion metrics"
      }
      on rentalCancelled: event Rental.RentalCancelled is {
        tell command RentalContext.RentalRepository.PersistRentalCancelled(rentalId = rentalCancelled.rentalId) to repository RentalContext.RentalRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains rental analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Rental analytics projections"
    described as {
      |Maintains rental operations analytics data.
    }
  }
  // ---- Event publication for Rental ----
  type RentalEvent is one of {
    RentalContext.Rental.RentalCreated or RentalContext.Rental.AddOnAdded or RentalContext.Rental.InsuranceSelected or RentalContext.Rental.PaymentAuthorized or RentalContext.Rental.VehicleCheckedOut or RentalContext.Rental.RentalExtended or RentalContext.Rental.ReturnLocationModified or RentalContext.Rental.VehicleCheckedIn or RentalContext.Rental.DamagesAssessed or RentalContext.Rental.FinalChargesProcessed or RentalContext.Rental.RentalCompleted or RentalContext.Rental.RentalCancelled
  } with {
    briefly "Rental event alternation"
    described as {
      |Union of all Rental events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RentalEventSplit as flow is {
    inlet RentalEventSplitIn is type RentalEvent
    outlet RentalEventSplitToRentalAnalytics is type RentalEvent
    handler RentalEventSplitHandler is {
      on rentalCreated: event Rental.RentalCreated is {
        send rentalCreated to outlet RentalEventSplitToRentalAnalytics
        tell rentalCreated to entity RentalContext.Rental
      }
      on addOnAdded: event Rental.AddOnAdded is {
        send addOnAdded to outlet RentalEventSplitToRentalAnalytics
        tell addOnAdded to entity RentalContext.Rental
      }
      on insuranceSelected: event Rental.InsuranceSelected is {
        send insuranceSelected to outlet RentalEventSplitToRentalAnalytics
        tell insuranceSelected to entity RentalContext.Rental
      }
      on paymentAuthorized: event Rental.PaymentAuthorized is {
        send paymentAuthorized to outlet RentalEventSplitToRentalAnalytics
        tell paymentAuthorized to entity RentalContext.Rental
      }
      on vehicleCheckedOut: event Rental.VehicleCheckedOut is {
        send vehicleCheckedOut to outlet RentalEventSplitToRentalAnalytics
        tell vehicleCheckedOut to entity RentalContext.Rental
      }
      on rentalExtended: event Rental.RentalExtended is {
        send rentalExtended to outlet RentalEventSplitToRentalAnalytics
        tell rentalExtended to entity RentalContext.Rental
      }
      on returnLocationModified: event Rental.ReturnLocationModified is {
        send returnLocationModified to outlet RentalEventSplitToRentalAnalytics
        tell returnLocationModified to entity RentalContext.Rental
      }
      on vehicleCheckedIn: event Rental.VehicleCheckedIn is {
        send vehicleCheckedIn to outlet RentalEventSplitToRentalAnalytics
        tell vehicleCheckedIn to entity RentalContext.Rental
      }
      on damagesAssessed: event Rental.DamagesAssessed is {
        send damagesAssessed to outlet RentalEventSplitToRentalAnalytics
        tell damagesAssessed to entity RentalContext.Rental
      }
      on finalChargesProcessed: event Rental.FinalChargesProcessed is {
        send finalChargesProcessed to outlet RentalEventSplitToRentalAnalytics
        tell finalChargesProcessed to entity RentalContext.Rental
      }
      on rentalCompleted: event Rental.RentalCompleted is {
        send rentalCompleted to outlet RentalEventSplitToRentalAnalytics
        tell rentalCompleted to entity RentalContext.Rental
      }
      on rentalCancelled: event Rental.RentalCancelled is {
        send rentalCancelled to outlet RentalEventSplitToRentalAnalytics
        tell rentalCancelled to entity RentalContext.Rental
      }
      on other is {
        error "Unexpected message for processor RentalEventSplit"
      }
    } with {
      briefly "Rental event fan-out handler"
      described as {
        |Delivers each Rental event to all of its consumers.
      }
    }
  } with {
    briefly "Rental event fan-out"
    described as {
      |Fans Rental events out to the repository and projectors.
    }
  }
  connector 'RentalEvent Stream' is from outlet RentalContext.Rental.RentalEvents2 to inlet RentalContext.RentalEventSplit.RentalEventSplitIn with {
    briefly "Rental events, fanned out to storage and read models"
  }
  connector 'RentalAnalytics Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToRentalAnalytics to inlet RentalContext.RentalAnalytics.RentalAnalyticsFromRental with {
    briefly "Rental events feeding the RentalAnalytics projection"
  }
  connector 'RentalAnalytics Storage' is from outlet RentalContext.RentalAnalytics.RentalAnalyticsToRepository to inlet RentalContext.RentalRepository.RentalRepositoryFromRentalAnalytics with {
    briefly "RentalAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for car rental"
  described as {
    | The RentalContext is the bounded context for
    | vehicle rentals and fleet management.
  }
}
