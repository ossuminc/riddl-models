// Car Rental - Rental Context
context RentalContext as router is {
  inlet RentalContextFromToInsuranceProviderService is command Rental.SelectInsurance with {
    briefly "What ToInsuranceProviderService makes of the answers it gets"
  }
  connector 'ToInsuranceProviderService Intake' is from outlet RentalContext.ToInsuranceProviderService.ToInsuranceProviderServiceToRentalContext to inlet RentalContext.RentalContextFromToInsuranceProviderService with {
    briefly "Answers translated by ToInsuranceProviderService, on their way in"
  }
  inlet RentalContextFromToPricingService is command Rental.ProcessFinalCharges with {
    briefly "What ToPricingService makes of the answers it gets"
  }
  connector 'ToPricingService Intake' is from outlet RentalContext.ToPricingService.ToPricingServiceToRentalContext to inlet RentalContext.RentalContextFromToPricingService with {
    briefly "Answers translated by ToPricingService, on their way in"
  }
  inlet RentalContextFromToVehicleAvailabilityService is command Rental.CreateRental with {
    briefly "What ToVehicleAvailabilityService makes of the answers it gets"
  }
  connector 'ToVehicleAvailabilityService Intake' is from outlet RentalContext.ToVehicleAvailabilityService.ToVehicleAvailabilityServiceToRentalContext to inlet RentalContext.RentalContextFromToVehicleAvailabilityService with {
    briefly "Answers translated by ToVehicleAvailabilityService, on their way in"
  }
  inlet RentalContextFromDriverVerificationService is command Rental.CancelRental with {
    briefly "What FromDriverVerificationService makes of that service's news"
  }
  connector 'FromDriverVerificationService Intake' is from outlet RentalContext.FromDriverVerificationService.FromDriverVerificationServiceToRentalContext to inlet RentalContext.RentalContextFromDriverVerificationService with {
    briefly "What FromDriverVerificationService makes of that news, on its way in"
  }
  inlet RentalContextFromPaymentProcessingService is command Rental.AuthorizePayment with {
    briefly "What FromPaymentProcessingService makes of that service's news"
  }
  connector 'FromPaymentProcessingService Intake' is from outlet RentalContext.FromPaymentProcessingService.FromPaymentProcessingServiceToRentalContext to inlet RentalContext.RentalContextFromPaymentProcessingService with {
    briefly "What FromPaymentProcessingService makes of that news, on its way in"
  }
  inlet RentalCommandStreamIn is type RentalCommand  outlet RentalCommandStreamOut is type RentalCommand
  inlet RentalResultStreamIn is result Rental.RentalResult  outlet RentalResultStreamOut is result Rental.RentalResult
  handler RentalContextBoundary is {
    on createRental: command Rental.CreateRental is {
      send createRental to outlet RentalContext.RentalCommandStreamOut
    }
    on addAddOn: command Rental.AddAddOn is {
      send addAddOn to outlet RentalContext.RentalCommandStreamOut
    }
    on selectInsurance: command Rental.SelectInsurance is {
      send selectInsurance to outlet RentalContext.RentalCommandStreamOut
    }
    on authorizePayment: command Rental.AuthorizePayment is {
      send authorizePayment to outlet RentalContext.RentalCommandStreamOut
    }
    on checkOutVehicle: command Rental.CheckOutVehicle is {
      send checkOutVehicle to outlet RentalContext.RentalCommandStreamOut
    }
    on extendRental: command Rental.ExtendRental is {
      send extendRental to outlet RentalContext.RentalCommandStreamOut
      let due: type Rental.ReturnReminderDue = prompt("a ReturnReminderDue naming this rental and the new return time it is scheduled against; any reminder scheduled at an earlier return time is left to arrive and be refused as stale")
      send due to outlet RentalContext.RentalCommandStreamOut at extendRental.newReturnDateTime
    }
    on modifyReturnLocation: command Rental.ModifyReturnLocation is {
      send modifyReturnLocation to outlet RentalContext.RentalCommandStreamOut
    }
    on checkInVehicle: command Rental.CheckInVehicle is {
      send checkInVehicle to outlet RentalContext.RentalCommandStreamOut
    }
    on assessDamages: command Rental.AssessDamages is {
      send assessDamages to outlet RentalContext.RentalCommandStreamOut
    }
    on processFinalCharges: command Rental.ProcessFinalCharges is {
      send processFinalCharges to outlet RentalContext.RentalCommandStreamOut
    }
    on completeRental: command Rental.CompleteRental is {
      send completeRental to outlet RentalContext.RentalCommandStreamOut
    }
    on cancelRental: command Rental.CancelRental is {
      send cancelRental to outlet RentalContext.RentalCommandStreamOut
    }
    on rentalResult: result Rental.RentalResult is {
      send rentalResult to outlet RentalContext.RentalResultStreamOut
    }
    on other is {
      error "Unexpected message at the RentalContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'RentalCommand Stream Intake' is from outlet RentalContext.RentalCommandStreamOut to inlet RentalContext.Rental.RentalCommands  connector 'RentalResult Stream Egress' is from outlet RentalContext.RentalRepository.RentalRepositoryResponses to inlet RentalContext.RentalResultStreamIn  adaptor FromDriverVerificationService from context DriverVerificationService as flow is { 
    inlet FromDriverVerificationServiceIn is type DriverVerificationService.DriverVerificationServiceEvent    outlet FromDriverVerificationServiceToRentalContext is command Rental.CancelRental
    handler FromDriverVerificationServiceHandler is {
      on driverVerified: event DriverVerificationService.DriverVerified is {
        do "the driver may rent; the counter still hands over the vehicle"
      }
      on verificationFailed: event DriverVerificationService.VerificationFailed is {
        let item0: type Rental.CancelRental = prompt("translate the verificationFailed event into a CancelRental, a driver who cannot be verified cannot take the car, so the rental is cancelled")
        send item0 to outlet RentalContext.FromDriverVerificationService.FromDriverVerificationServiceToRentalContext
      }
      on other is {
        error "Unexpected message for adaptor FromDriverVerificationService"
      }
    } with {
      briefly "from driver verification service"
      described as {
        |Carries messages from the external DriverVerificationService.
      }
    }
  } with {
    briefly "DriverVerificationService integration"
    described as {
      |The model's side of the DriverVerificationService conversation.
    }
  }
  adaptor ToDriverVerificationService to context DriverVerificationService as flow is { 
    inlet ToDriverVerificationServiceIn is type RentalEvent    outlet ToDriverVerificationServiceOut is command DriverVerificationService.VerifyDriver
    handler ToDriverVerificationServiceHandler is {
      on rentalCreated: event RentalCreated is {
        let check0: type DriverVerificationService.VerifyDriver = prompt("translate the rentalCreated event into a VerifyDriver checking the licence before a vehicle is handed over")
        send check0 to outlet RentalContext.ToDriverVerificationService.ToDriverVerificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDriverVerificationService"
      }
    } with {
      briefly "to driver verification service"
      described as {
        |Carries messages to the external DriverVerificationService.
      }
    }
  } with {
    briefly "DriverVerificationService integration"
    described as {
      |The model's side of the DriverVerificationService conversation.
    }
  }
  adaptor FromFleetMaintenanceService from context FleetMaintenanceService as sink is { 
    inlet FromFleetMaintenanceServiceIn is type FleetMaintenanceService.FleetMaintenanceServiceEvent    handler FromFleetMaintenanceServiceHandler is {
      on damageReported: event FleetMaintenanceService.DamageReported is {
        do "maintenance has the damage report; assessing the damage was recorded here"
      }
      on inspectionScheduled: event FleetMaintenanceService.InspectionScheduled is {
        do "the inspection is booked; the check-in that asked for it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromFleetMaintenanceService"
      }
    } with {
      briefly "from fleet maintenance service"
      described as {
        |Carries messages from the external FleetMaintenanceService.
      }
    }
  } with {
    briefly "FleetMaintenanceService integration"
    described as {
      |The model's side of the FleetMaintenanceService conversation.
    }
  }
  adaptor ToFleetMaintenanceService to context FleetMaintenanceService as flow is { 
    inlet ToFleetMaintenanceServiceIn is type RentalEvent    outlet ToFleetMaintenanceServiceOut is type FleetMaintenanceService.FleetMaintenanceServiceCommand
    handler ToFleetMaintenanceServiceHandler is {
      on vehicleCheckedIn: event Rental.VehicleCheckedIn is {
        let item0: type FleetMaintenanceService.ScheduleInspection = prompt("translate the vehicleCheckedIn event into a ScheduleInspection, return being when a vehicle is looked over")
        send item0 to outlet RentalContext.ToFleetMaintenanceService.ToFleetMaintenanceServiceOut
      }
      on damagesAssessed: event Rental.DamagesAssessed is {
        let item0: type FleetMaintenanceService.ReportDamage = prompt("translate the damagesAssessed event into a ReportDamage, assessment being what fixes what is wrong with it")
        send item0 to outlet RentalContext.ToFleetMaintenanceService.ToFleetMaintenanceServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToFleetMaintenanceService"
      }
    } with {
      briefly "to fleet maintenance service"
      described as {
        |Carries messages to the external FleetMaintenanceService.
      }
    }
  } with {
    briefly "FleetMaintenanceService integration"
    described as {
      |The model's side of the FleetMaintenanceService conversation.
    }
  }
  adaptor FromInsuranceProviderService from context InsuranceProviderService as sink is { 
    inlet FromInsuranceProviderServiceIn is event InsuranceProviderService.CoverageActivated    handler FromInsuranceProviderServiceHandler is {
      on coverageActivated: event InsuranceProviderService.CoverageActivated is {
        do "the cover is live; selecting it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromInsuranceProviderService"
      }
    } with {
      briefly "from insurance provider service"
      described as {
        |Carries messages from the external InsuranceProviderService.
      }
    }
  } with {
    briefly "InsuranceProviderService integration"
    described as {
      |The model's side of the InsuranceProviderService conversation.
    }
  }
  adaptor ToInsuranceProviderService to context InsuranceProviderService as router is { 
    outlet ToInsuranceProviderServiceToRentalContext is command Rental.SelectInsurance
    inlet ToInsuranceProviderServiceIn is type RentalEvent    inlet ToInsuranceProviderServiceReplies is result InsuranceProviderService.InsuranceOptions    outlet ToInsuranceProviderServiceOut is type InsuranceProviderService.InsuranceProviderServiceRequest
    handler ToInsuranceProviderServiceHandler is {
      on rentalCreated: event Rental.RentalCreated is {
        let askAnswer: type InsuranceProviderService.InsuranceOptions = ask query InsuranceProviderService.GetInsuranceOptions of context InsuranceProviderService
        do "a rental needing the cover it can be sold with"
        send command Rental.SelectInsurance(rentalId = rentalCreated.rentalId, insurance = prompt("the first of askAnswer.options the customer takes")) to outlet RentalContext.ToInsuranceProviderService.ToInsuranceProviderServiceToRentalContext
      }
      on insuranceSelected: event Rental.InsuranceSelected is {
        let item0: type InsuranceProviderService.ActivateCoverage = prompt("translate the insuranceSelected event into a ActivateCoverage, selection being what must be made real before the keys are handed over")
        send item0 to outlet RentalContext.ToInsuranceProviderService.ToInsuranceProviderServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToInsuranceProviderService"
      }
    } with {
      briefly "to insurance provider service"
      described as {
        |Carries messages to the external InsuranceProviderService.
      }
    }
  } with {
    briefly "InsuranceProviderService integration"
    described as {
      |The model's side of the InsuranceProviderService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type RentalEvent    outlet ToNotificationServiceOut is type NotificationService.NotificationServiceCommand
    handler ToNotificationServiceHandler is {
      on rentalCreated: event RentalCreated is {
        let ack: type NotificationService.SendReservationAcknowledgement = prompt("translate the rentalCreated event into a SendReservationAcknowledgement telling the customer their booking is held")
        send ack to outlet RentalContext.ToNotificationService.ToNotificationServiceOut
        let pickup: type NotificationService.SendPickupReminder = prompt("translate the rentalCreated event into a SendPickupReminder carrying remindAt, the moment it should reach the customer ahead of pickupDateTime")
        send pickup to outlet RentalContext.ToNotificationService.ToNotificationServiceOut at pickup.remindAt
      }
      on finalChargesProcessed: event FinalChargesProcessed is {
        let msg: type NotificationService.SendReceipt = prompt("translate the finalChargesProcessed event into a SendReceipt for the customer")
        send msg to outlet RentalContext.ToNotificationService.ToNotificationServiceOut
      }
      on returnReminderRaised: event Rental.ReturnReminderRaised is {
        let dropoff: type NotificationService.SendReturnReminder = prompt("translate the returnReminderRaised event into a SendReturnReminder telling the renter the vehicle is due back; the schedule was set when the rental was extended and the rental was re-checked at fire time, so this sends without deciding again")
        send dropoff to outlet RentalContext.ToNotificationService.ToNotificationServiceOut
      }
      on paymentAuthorized: event PaymentAuthorized is {
        let confirmed: type NotificationService.SendReservationConfirmation = prompt("translate the paymentAuthorized event into a SendReservationConfirmation telling the customer the commitment is now firm")
        send confirmed to outlet RentalContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService as flow is { 
    inlet FromPaymentProcessingServiceIn is type PaymentProcessingService.PaymentProcessingServiceEvent    outlet FromPaymentProcessingServiceToRentalContext is command Rental.AuthorizePayment
    handler FromPaymentProcessingServiceHandler is {
      on paymentCaptured: event PaymentProcessingService.PaymentCaptured is {
        do "the money is taken; the final charges were recorded here"
      }
      on refundProcessed: event PaymentProcessingService.RefundProcessed is {
        do "the refund has gone; cancelling was recorded here"
      }
      on rentalPaymentAuthorized: event PaymentProcessingService.RentalPaymentAuthorized is {
        let item0: type Rental.AuthorizePayment = prompt("translate the rentalPaymentAuthorized event into a AuthorizePayment, a card actually held is what the rental records as authorised")
        send item0 to outlet RentalContext.FromPaymentProcessingService.FromPaymentProcessingServiceToRentalContext
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService as flow is { 
    inlet ToPaymentProcessingServiceIn is type RentalEvent    outlet ToPaymentProcessingServiceOut is type PaymentProcessingService.PaymentProcessingServiceCommand
    handler ToPaymentProcessingServiceHandler is {
      on rentalCreated: event RentalCreated is {
        let msg: type PaymentProcessingService.AuthorizeRentalPayment = prompt("translate the rentalCreated event into a AuthorizeRentalPayment for its recipient")
        send msg to outlet RentalContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
        let rentalCreatedPayment: type PaymentProcessingService.AuthorizeRentalPayment = prompt("a AuthorizeRentalPayment holding the estimated rental cost against the customer's card, which is what makes the reservation firm")
        send rentalCreatedPayment to outlet RentalContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on finalChargesProcessed: event FinalChargesProcessed is {
        let notice: type PaymentProcessingService.CapturePayment = prompt("translate the finalChargesProcessed event into a CapturePayment taking the final amount once the vehicle is back and the charges are settled")
        send notice to outlet RentalContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on rentalCancelled: event RentalCancelled is {
        let notice: type PaymentProcessingService.ProcessRefund = prompt("translate the rentalCancelled event into a ProcessRefund releasing or returning what the cancellation terms leave owing")
        send notice to outlet RentalContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPricingService to context PricingService as router is { 
    outlet ToPricingServiceToRentalContext is command Rental.ProcessFinalCharges
    inlet ToPricingServiceIn is type RentalEvent    inlet ToPricingServiceReplies is result PricingService.RentalPrice    outlet ToPricingServiceOut is query PricingService.CalculateRentalPrice
    handler ToPricingServiceHandler is {
      on rentalCreated: event Rental.RentalCreated is {
        let askAnswer: type PricingService.RentalPrice = ask query PricingService.CalculateRentalPrice of context PricingService
        do "a new rental needing a price for the car, the days and the extras"
        send command Rental.ProcessFinalCharges(rentalId = rentalCreated.rentalId, charges = askAnswer.charges) to outlet RentalContext.ToPricingService.ToPricingServiceToRentalContext
      }
      on other is {
        error "Unexpected message for adaptor ToPricingService"
      }
    } with {
      briefly "to pricing service"
      described as {
        |Carries messages to the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromVehicleAvailabilityService from context VehicleAvailabilityService as sink is { 
    inlet FromVehicleAvailabilityServiceIn is type VehicleAvailabilityService.VehicleAvailabilityServiceEvent    handler FromVehicleAvailabilityServiceHandler is {
      on vehicleReleased: event VehicleAvailabilityService.VehicleReleased is {
        do "the vehicle is available again; the check-in or cancellation that freed it was recorded here"
      }
      on vehicleReserved: event VehicleAvailabilityService.VehicleReserved is {
        do "the vehicle is held; creating the rental was recorded before it was asked for"
      }
      on other is {
        error "Unexpected message for adaptor FromVehicleAvailabilityService"
      }
    } with {
      briefly "from vehicle availability service"
      described as {
        |Carries messages from the external VehicleAvailabilityService.
      }
    }
  } with {
    briefly "VehicleAvailabilityService integration"
    described as {
      |The model's side of the VehicleAvailabilityService conversation.
    }
  }
  adaptor ToVehicleAvailabilityService to context VehicleAvailabilityService as router is { 
    outlet ToVehicleAvailabilityServiceToRentalContext is command Rental.CreateRental
    inlet ToVehicleAvailabilityServiceIn is type RentalEvent    inlet ToVehicleAvailabilityServiceReplies is result VehicleAvailabilityService.AvailableVehicles    outlet ToVehicleAvailabilityServiceOut is type VehicleAvailabilityService.VehicleAvailabilityServiceCommand
    handler ToVehicleAvailabilityServiceHandler is {
      on rentalCreated: event Rental.RentalCreated is {
        let askAnswer: type VehicleAvailabilityService.AvailableVehicles = ask query VehicleAvailabilityService.SearchAvailableVehicles of context VehicleAvailabilityService
        do "a rental needing a vehicle free at that branch and those dates"
        when prompt("rentalCreated.vehicle is not among askAnswer.vehicles") then
          send command Rental.CreateRental(rentalId = rentalCreated.rentalId, customer = rentalCreated.customer, vehicle = prompt("the first of askAnswer.vehicles"), period = rentalCreated.period) to outlet RentalContext.ToVehicleAvailabilityService.ToVehicleAvailabilityServiceToRentalContext
        end
        let item0: type VehicleAvailabilityService.ReserveVehicle = prompt("translate the rentalCreated event into a ReserveVehicle, the rental being what claims the vehicle")
        send item0 to outlet RentalContext.ToVehicleAvailabilityService.ToVehicleAvailabilityServiceOut
      }
      on vehicleCheckedIn: event Rental.VehicleCheckedIn is {
        let item0: type VehicleAvailabilityService.ReleaseVehicle = prompt("translate the vehicleCheckedIn event into a ReleaseVehicle, return being what puts it back on the lot")
        send item0 to outlet RentalContext.ToVehicleAvailabilityService.ToVehicleAvailabilityServiceOut
      }
      on rentalCancelled: event Rental.RentalCancelled is {
        let item0: type VehicleAvailabilityService.ReleaseVehicle = prompt("translate the rentalCancelled event into a ReleaseVehicle, and cancellation freeing it before it leaves")
        send item0 to outlet RentalContext.ToVehicleAvailabilityService.ToVehicleAvailabilityServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToVehicleAvailabilityService"
      }
    } with {
      briefly "to vehicle availability service"
      described as {
        |Carries messages to the external VehicleAvailabilityService.
      }
    }
  } with {
    briefly "VehicleAvailabilityService integration"
    described as {
      |The model's side of the VehicleAvailabilityService conversation.
    }
  }
  include "types.riddl"
  include "Rental.riddl"
  // Repository for rental persistence
  type RentalRepositoryCommand is one of {
    RentalContext.RentalRepository.PersistAddOnAdded or RentalContext.RentalRepository.PersistDamagesAssessed or RentalContext.RentalRepository.PersistFinalChargesProcessed or RentalContext.RentalRepository.PersistInsuranceSelected or RentalContext.RentalRepository.PersistPaymentAuthorized or RentalContext.RentalRepository.PersistRentalCancelled or RentalContext.RentalRepository.PersistRentalCompleted or RentalContext.RentalRepository.PersistRentalCreated or RentalContext.RentalRepository.PersistRentalExtended or RentalContext.RentalRepository.PersistReturnLocationModified or RentalContext.RentalRepository.PersistVehicleCheckedIn or RentalContext.RentalRepository.PersistVehicleCheckedOut
  } with {
    briefly "Anything that writes RentalRepository"
    described as {
      |The persistence commands RentalRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository RentalRepository as flow is {
    inlet RentalRepositoryFromRentalAnalytics is type RentalRepositoryCommand    command PersistAddOnAdded is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row AddOnAdded applies to.
        }
      }
    } with {
      briefly "Persist AddOnAdded"
      described as {
        |Instructs this repository to apply AddOnAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDamagesAssessed is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row DamagesAssessed applies to.
        }
      }
    } with {
      briefly "Persist DamagesAssessed"
      described as {
        |Instructs this repository to apply DamagesAssessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistInsuranceSelected is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row InsuranceSelected applies to.
        }
      }
    } with {
      briefly "Persist InsuranceSelected"
      described as {
        |Instructs this repository to apply InsuranceSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentAuthorized is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentAuthorized applies to.
        }
      }
    } with {
      briefly "Persist PaymentAuthorized"
      described as {
        |Instructs this repository to apply PaymentAuthorized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalExtended is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalExtended applies to.
        }
      }
    } with {
      briefly "Persist RentalExtended"
      described as {
        |Instructs this repository to apply RentalExtended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReturnLocationModified is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnLocationModified applies to.
        }
      }
    } with {
      briefly "Persist ReturnLocationModified"
      described as {
        |Instructs this repository to apply ReturnLocationModified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleCheckedIn is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist VehicleCheckedIn"
      described as {
        |Instructs this repository to apply VehicleCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinalChargesProcessed is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinalChargesProcessed applies to.
        }
      }
    } with {
      briefly "Persist FinalChargesProcessed"
      described as {
        |Instructs this repository to apply FinalChargesProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalCancelled is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalCancelled applies to.
        }
      }
    } with {
      briefly "Persist RentalCancelled"
      described as {
        |Instructs this repository to apply RentalCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalCompleted is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalCompleted applies to.
        }
      }
    } with {
      briefly "Persist RentalCompleted"
      described as {
        |Instructs this repository to apply RentalCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRentalCreated is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RentalCreated applies to.
        }
      }
    } with {
      briefly "Persist RentalCreated"
      described as {
        |Instructs this repository to apply RentalCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVehicleCheckedOut is {
      rentalId: RentalId with {
        briefly "Row addressed"
        described as {
          |Which stored row VehicleCheckedOut applies to.
        }
      }
    } with {
      briefly "Persist VehicleCheckedOut"
      described as {
        |Instructs this repository to apply VehicleCheckedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet RentalRepositoryResponses is result Rental.RentalResult
    record StoredRental is {
      rentalId: RentalId with {
        briefly "rentalId"
        described as {
          |The rentalId column of the stored rental row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored rental row.
        }
      }
      period: RentalPeriod with {
        briefly "period"
        described as {
          |The period column of the stored rental row.
        }
      }
      vehicle: VehicleInfo with {
        briefly "vehicle"
        described as {
          |The vehicle column of the stored rental row.
        }
      }
    } with {
      briefly "Stored rental row"
      described as {
        |The persistence shape of rental data as this repository stores it.
      }
    }
    schema RentalData is relational
      of rentals as record StoredRental
        index on field StoredRental.rentalId
        index on field StoredRental.customer.customerId
        index on field StoredRental.vehicle.vehicleId
        index on field StoredRental.period.pickupLocation.locationId
 with {
      briefly "Rental data schema"
      described as {
        |The relational schema holding rental data for the RentalRepository.
      }
    }
    handler RentalPersistence is {
      on persistAddOnAdded: command PersistAddOnAdded is {
        do "apply AddOnAdded to the stored row"
      }
      on persistDamagesAssessed: command PersistDamagesAssessed is {
        do "apply DamagesAssessed to the stored row"
      }
      on persistInsuranceSelected: command PersistInsuranceSelected is {
        do "apply InsuranceSelected to the stored row"
      }
      on persistPaymentAuthorized: command PersistPaymentAuthorized is {
        do "apply PaymentAuthorized to the stored row"
      }
      on persistRentalExtended: command PersistRentalExtended is {
        do "apply RentalExtended to the stored row"
      }
      on persistReturnLocationModified: command PersistReturnLocationModified is {
        do "apply ReturnLocationModified to the stored row"
      }
      on persistVehicleCheckedIn: command PersistVehicleCheckedIn is {
        do "apply VehicleCheckedIn to the stored row"
      }
      on persistFinalChargesProcessed: command PersistFinalChargesProcessed is {
        do "apply FinalChargesProcessed to the stored row"
      }
      on persistRentalCancelled: command PersistRentalCancelled is {
        do "apply RentalCancelled to the stored row"
      }
      on persistRentalCompleted: command PersistRentalCompleted is {
        do "apply RentalCompleted to the stored row"
      }
      on persistRentalCreated: command PersistRentalCreated is {
        do "apply RentalCreated to the stored row"
      }
      on persistVehicleCheckedOut: command PersistVehicleCheckedOut is {
        do "apply VehicleCheckedOut to the stored row"
      }
      on query GetRentalStats is {
        let rentalStatsView: type RentalStatsView = prompt("read the rental stats projection")
        reply rentalStatsView
      }
    } with {
      briefly "Persists rental commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Rental data persistence"
    described as {
      | The RentalRepository provides persistent storage for
      | rentals and related data.
    }
  }
  // Projector for rental analytics
  query GetRentalStats replies result RentalStatsView is {
    rentalStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which rental stats to retrieve.
      }
    }
  } with {
    briefly "Get rental stats"
    described as {
      |Retrieves the rental stats projection.
    }
  }
  result RentalStatsView is {
    rentalStats: RentalAnalytics.RentalStats with {
      briefly "Rental stats"
      described as {
        |The rental stats being returned.
      }
    }
  } with {
    briefly "Rental stats view"
    described as {
      |Read model view carrying the rental stats projection.
    }
  }
  projector RentalAnalytics as flow is {
    updates repository RentalContext.RentalRepository
    outlet RentalAnalyticsToRepository is type RentalRepositoryCommand
    inlet RentalAnalyticsFromRental is type RentalEvent    record RentalStats is {
      totalRentals: Natural with {
        briefly "Total"
        described as {
          |Total rentals.
        }
      }
      activeRentals: Natural with {
        briefly "Active"
        described as {
          |Active rentals.
        }
      }
      completedRentals: Natural with {
        briefly "Completed"
        described as {
          |Completed rentals.
        }
      }
      cancelledRentals: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled rentals.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageRentalDays: Decimal(5,2) with {
        briefly "Avg days"
        described as {
          |Average rental duration.
        }
      }
      fleetUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Fleet utilization rate.
        }
      }
    } with {
      briefly "Rental statistics"
      described as {
        |Rental operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on addOnAdded: event Rental.AddOnAdded is {
        tell command RentalContext.RentalRepository.PersistAddOnAdded(rentalId = addOnAdded.rentalId) to repository RentalContext.RentalRepository
        do "apply AddOnAdded to the RentalAnalytics projection"
      }
      on damagesAssessed: event Rental.DamagesAssessed is {
        tell command RentalContext.RentalRepository.PersistDamagesAssessed(rentalId = damagesAssessed.rentalId) to repository RentalContext.RentalRepository
        do "apply DamagesAssessed to the RentalAnalytics projection"
      }
      on insuranceSelected: event Rental.InsuranceSelected is {
        tell command RentalContext.RentalRepository.PersistInsuranceSelected(rentalId = insuranceSelected.rentalId) to repository RentalContext.RentalRepository
        do "apply InsuranceSelected to the RentalAnalytics projection"
      }
      on paymentAuthorized: event Rental.PaymentAuthorized is {
        tell command RentalContext.RentalRepository.PersistPaymentAuthorized(rentalId = paymentAuthorized.rentalId) to repository RentalContext.RentalRepository
        do "apply PaymentAuthorized to the RentalAnalytics projection"
      }
      on rentalExtended: event Rental.RentalExtended is {
        tell command RentalContext.RentalRepository.PersistRentalExtended(rentalId = rentalExtended.rentalId) to repository RentalContext.RentalRepository
        do "apply RentalExtended to the RentalAnalytics projection"
      }
      on returnLocationModified: event Rental.ReturnLocationModified is {
        tell command RentalContext.RentalRepository.PersistReturnLocationModified(rentalId = returnLocationModified.rentalId) to repository RentalContext.RentalRepository
        do "apply ReturnLocationModified to the RentalAnalytics projection"
      }
      on vehicleCheckedIn: event Rental.VehicleCheckedIn is {
        tell command RentalContext.RentalRepository.PersistVehicleCheckedIn(rentalId = vehicleCheckedIn.rentalId) to repository RentalContext.RentalRepository
        do "apply VehicleCheckedIn to the RentalAnalytics projection"
      }
      on rentalCreated: event Rental.RentalCreated is {
        tell command RentalContext.RentalRepository.PersistRentalCreated(rentalId = rentalCreated.rentalId) to repository RentalContext.RentalRepository
        do "Update rental counts"
      }
      on vehicleCheckedOut: event Rental.VehicleCheckedOut is {
        tell command RentalContext.RentalRepository.PersistVehicleCheckedOut(rentalId = vehicleCheckedOut.rentalId) to repository RentalContext.RentalRepository
        do "Update active counts"
      }
      on finalChargesProcessed: event Rental.FinalChargesProcessed is {
        tell command RentalContext.RentalRepository.PersistFinalChargesProcessed(rentalId = finalChargesProcessed.rentalId) to repository RentalContext.RentalRepository
        do "Update revenue metrics"
      }
      on rentalCompleted: event Rental.RentalCompleted is {
        tell command RentalContext.RentalRepository.PersistRentalCompleted(rentalId = rentalCompleted.rentalId) to repository RentalContext.RentalRepository
        do "Update completion metrics"
      }
      on rentalCancelled: event Rental.RentalCancelled is {
        tell command RentalContext.RentalRepository.PersistRentalCancelled(rentalId = rentalCancelled.rentalId) to repository RentalContext.RentalRepository
        do "Update cancellation metrics"
      }
      on returnReminderRaised: event Rental.ReturnReminderRaised is {
        do "a return reminder raised changes nothing this projection keeps"
      }
    } with {
      briefly "Maintains rental analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Rental analytics projections"
    described as {
      |Maintains rental operations analytics data.
    }
  }
  // ---- Event publication for Rental ----
  type RentalEvent is one of {
    RentalContext.Rental.RentalCreated or RentalContext.Rental.AddOnAdded or RentalContext.Rental.InsuranceSelected or RentalContext.Rental.PaymentAuthorized or RentalContext.Rental.VehicleCheckedOut or RentalContext.Rental.RentalExtended or RentalContext.Rental.ReturnLocationModified or RentalContext.Rental.VehicleCheckedIn or RentalContext.Rental.DamagesAssessed or RentalContext.Rental.FinalChargesProcessed or RentalContext.Rental.RentalCompleted or RentalContext.Rental.RentalCancelled or Rental.ReturnReminderRaised
  } with {
    briefly "Rental event alternation"
    described as {
      |Union of all Rental events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet RentalEventSplit as split is {
    outlet RentalEventSplitToToNotificationService is type RentalEvent
    outlet RentalEventSplitToToVehicleAvailabilityService is type RentalEvent
    outlet RentalEventSplitToToPricingService is type RentalEvent
    outlet RentalEventSplitToToPaymentProcessingService is type RentalEvent
    outlet RentalEventSplitToToInsuranceProviderService is type RentalEvent
    outlet RentalEventSplitToToFleetMaintenanceService is type RentalEvent
    outlet RentalEventSplitToToDriverVerificationService is type RentalEvent
    inlet RentalEventSplitIn is type RentalEvent    outlet RentalEventSplitToRentalAnalytics is type RentalEvent
    handler RentalEventSplitHandler is {
      on rentalCreated: event Rental.RentalCreated is {
        send rentalCreated to outlet RentalEventSplitToRentalAnalytics
        send rentalCreated to outlet RentalEventSplitToToVehicleAvailabilityService
        send rentalCreated to outlet RentalEventSplitToToPricingService
        send rentalCreated to outlet RentalEventSplitToToPaymentProcessingService
        send rentalCreated to outlet RentalEventSplitToToInsuranceProviderService
        send rentalCreated to outlet RentalEventSplitToToDriverVerificationService
        send rentalCreated to outlet RentalEventSplitToToNotificationService
        tell rentalCreated to entity RentalContext.Rental
      }
      on addOnAdded: event Rental.AddOnAdded is {
        send addOnAdded to outlet RentalEventSplitToRentalAnalytics
        tell addOnAdded to entity RentalContext.Rental
      }
      on insuranceSelected: event Rental.InsuranceSelected is {
        send insuranceSelected to outlet RentalEventSplitToRentalAnalytics
        send insuranceSelected to outlet RentalEventSplitToToInsuranceProviderService
        tell insuranceSelected to entity RentalContext.Rental
      }
      on paymentAuthorized: event Rental.PaymentAuthorized is {
        send paymentAuthorized to outlet RentalEventSplitToRentalAnalytics
        send paymentAuthorized to outlet RentalEventSplitToToNotificationService
        tell paymentAuthorized to entity RentalContext.Rental
      }
      on vehicleCheckedOut: event Rental.VehicleCheckedOut is {
        send vehicleCheckedOut to outlet RentalEventSplitToRentalAnalytics
        tell vehicleCheckedOut to entity RentalContext.Rental
      }
      on rentalExtended: event Rental.RentalExtended is {
        send rentalExtended to outlet RentalEventSplitToRentalAnalytics
        tell rentalExtended to entity RentalContext.Rental
      }
      on returnLocationModified: event Rental.ReturnLocationModified is {
        send returnLocationModified to outlet RentalEventSplitToRentalAnalytics
        tell returnLocationModified to entity RentalContext.Rental
      }
      on vehicleCheckedIn: event Rental.VehicleCheckedIn is {
        send vehicleCheckedIn to outlet RentalEventSplitToRentalAnalytics
        send vehicleCheckedIn to outlet RentalEventSplitToToVehicleAvailabilityService
        send vehicleCheckedIn to outlet RentalEventSplitToToFleetMaintenanceService
        tell vehicleCheckedIn to entity RentalContext.Rental
      }
      on damagesAssessed: event Rental.DamagesAssessed is {
        send damagesAssessed to outlet RentalEventSplitToRentalAnalytics
        send damagesAssessed to outlet RentalEventSplitToToFleetMaintenanceService
        tell damagesAssessed to entity RentalContext.Rental
      }
      on finalChargesProcessed: event Rental.FinalChargesProcessed is {
        send finalChargesProcessed to outlet RentalEventSplitToRentalAnalytics
        send finalChargesProcessed to outlet RentalEventSplitToToPaymentProcessingService
        send finalChargesProcessed to outlet RentalEventSplitToToNotificationService
        tell finalChargesProcessed to entity RentalContext.Rental
      }
      on rentalCompleted: event Rental.RentalCompleted is {
        send rentalCompleted to outlet RentalEventSplitToRentalAnalytics
        tell rentalCompleted to entity RentalContext.Rental
      }
      on rentalCancelled: event Rental.RentalCancelled is {
        send rentalCancelled to outlet RentalEventSplitToRentalAnalytics
        send rentalCancelled to outlet RentalEventSplitToToVehicleAvailabilityService
        send rentalCancelled to outlet RentalEventSplitToToPaymentProcessingService
        tell rentalCancelled to entity RentalContext.Rental
      }
      on returnReminderRaised: event Rental.ReturnReminderRaised is {
        send returnReminderRaised to outlet RentalEventSplitToToNotificationService
      }
      on other is {
        error "Unexpected message for processor RentalEventSplit"
      }
    } with {
      briefly "Rental event fan-out handler"
      described as {
        |Delivers each Rental event to all of its consumers.
      }
    }
  } with {
    briefly "Rental event fan-out"
    described as {
      |Fans Rental events out to the repository and projectors.
    }
  }
  connector 'ToVehicleAvailabilityService Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToToVehicleAvailabilityService to inlet RentalContext.ToVehicleAvailabilityService.ToVehicleAvailabilityServiceIn with {
    briefly "The Rental events ToVehicleAvailabilityService translates, on their way to it"
  }
  connector 'ToPricingService Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToToPricingService to inlet RentalContext.ToPricingService.ToPricingServiceIn with {
    briefly "The Rental events ToPricingService translates, on their way to it"
  }
  connector 'ToPaymentProcessingService Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToToPaymentProcessingService to inlet RentalContext.ToPaymentProcessingService.ToPaymentProcessingServiceIn with {
    briefly "The Rental events ToPaymentProcessingService translates, on their way to it"
  }
  connector 'ToInsuranceProviderService Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToToInsuranceProviderService to inlet RentalContext.ToInsuranceProviderService.ToInsuranceProviderServiceIn with {
    briefly "The Rental events ToInsuranceProviderService translates, on their way to it"
  }
  connector 'ToFleetMaintenanceService Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToToFleetMaintenanceService to inlet RentalContext.ToFleetMaintenanceService.ToFleetMaintenanceServiceIn with {
    briefly "The Rental events ToFleetMaintenanceService translates, on their way to it"
  }
  connector 'ToDriverVerificationService Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToToDriverVerificationService to inlet RentalContext.ToDriverVerificationService.ToDriverVerificationServiceIn with {
    briefly "The Rental events ToDriverVerificationService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToToNotificationService to inlet RentalContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Rental events ToNotificationService translates, on their way to it"
  }
  connector 'RentalEvent Stream' is from outlet RentalContext.Rental.RentalEvents2 to inlet RentalContext.RentalEventSplit.RentalEventSplitIn with {
    briefly "Rental events, fanned out to storage and read models"
  }
  connector 'RentalAnalytics Feed' is from outlet RentalContext.RentalEventSplit.RentalEventSplitToRentalAnalytics to inlet RentalContext.RentalAnalytics.RentalAnalyticsFromRental with {
    briefly "Rental events feeding the RentalAnalytics projection"
  }
  connector 'RentalAnalytics Storage' is from outlet RentalContext.RentalAnalytics.RentalAnalyticsToRepository to inlet RentalContext.RentalRepository.RentalRepositoryFromRentalAnalytics with {
    briefly "RentalAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for car rental"
  described as {
    | The RentalContext is the bounded context for
    | vehicle rentals and fleet management.
  }
}
