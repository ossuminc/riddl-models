// Car Rental - Rental Context
context RentalContext is {
  include "types.riddl"
  include "Rental.riddl"
  // Repository for rental persistence
  repository RentalRepository is {
    inlet RentalRepositoryFromRental is type RentalEvent
    inlet RentalRepositoryFromRentalAnalytics is type RentalEvent
    outlet RentalRepositoryResponses is type Rental.RentalResult
    schema RentalData is relational
      of rentals as type Rental
        index on field Rental.rentalId
        index on field Rental.customer.customerId
        index on field Rental.vehicle.vehicleId
        index on field Rental.period.pickupLocation.locationId

    handler RentalPersistence is {
      on command Rental.CreateRental is {
        tell event Rental.RentalCreated to entity RentalContext.Rental
        prompt "Store new rental"
      }
      on command Rental.AddAddOn is {
        tell event Rental.AddOnAdded to entity RentalContext.Rental
        prompt "Add add-on to rental"
      }
      on command Rental.SelectInsurance is {
        prompt "Store insurance selection"
      }
      on command Rental.AuthorizePayment is {
        prompt "Store payment authorization"
      }
      on command Rental.CheckOutVehicle is {
        prompt "Update to active"
      }
      on command Rental.ExtendRental is {
        prompt "Update rental period"
      }
      on command Rental.ModifyReturnLocation is {
        prompt "Update return location"
      }
      on command Rental.CheckInVehicle is {
        prompt "Update to returned"
      }
      on command Rental.AssessDamages is {
        prompt "Store damage assessment"
      }
      on command Rental.ProcessFinalCharges is {
        tell event Rental.FinalChargesProcessed to entity RentalContext.Rental
        prompt "Store final charges"
      }
      on command Rental.CompleteRental is {
        tell event Rental.RentalCompleted to entity RentalContext.Rental
        prompt "Update to completed"
      }
      on command Rental.CancelRental is {
        tell event Rental.RentalCancelled to entity RentalContext.Rental
        prompt "Update to cancelled"
      }
    } with {
      briefly "Persists rental commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Rental data persistence"
    described as {
      | The RentalRepository provides persistent storage for
      | rentals and related data.
    }
  }
  // Projector for rental analytics
  projector RentalAnalytics is {
    inlet RentalAnalyticsFromRental is type RentalEvent
    outlet RentalAnalyticsOut is type RentalEvent
    updates repository RentalContext.RentalRepository
    record RentalStats is  {
      totalRentals: Natural with {
        briefly "Total"
        described as {
          |Total rentals.
        }
      }
      activeRentals: Natural with {
        briefly "Active"
        described as {
          |Active rentals.
        }
      }
      completedRentals: Natural with {
        briefly "Completed"
        described as {
          |Completed rentals.
        }
      }
      cancelledRentals: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled rentals.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageRentalDays: Decimal(5,2) with {
        briefly "Avg days"
        described as {
          |Average rental duration.
        }
      }
      fleetUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Fleet utilization rate.
        }
      }
    } with {
      briefly "Rental statistics"
      described as {
        |Rental operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Rental.RentalCreated is {
        tell event Rental.RentalCreated to repository RentalContext.RentalRepository
        prompt "Update rental counts"
      }
      on event Rental.VehicleCheckedOut is {
        tell event Rental.VehicleCheckedOut to repository RentalContext.RentalRepository
        prompt "Update active counts"
      }
      on event Rental.FinalChargesProcessed is {
        tell event Rental.FinalChargesProcessed to repository RentalContext.RentalRepository
        prompt "Update revenue metrics"
      }
      on event Rental.RentalCompleted is {
        tell event Rental.RentalCompleted to repository RentalContext.RentalRepository
        prompt "Update completion metrics"
      }
      on event Rental.RentalCancelled is {
        tell event Rental.RentalCancelled to repository RentalContext.RentalRepository
        prompt "Update cancellation metrics"
      }
    } with {
      briefly "Maintains rental analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Rental analytics projections"
    described as {
      |Maintains rental operations analytics data.
    }
  }
  // ---- Event publication for Rental ----
  type RentalEvent is one of {
    RentalContext.Rental.RentalCreated,
    RentalContext.Rental.AddOnAdded,
    RentalContext.Rental.InsuranceSelected,
    RentalContext.Rental.PaymentAuthorized,
    RentalContext.Rental.VehicleCheckedOut,
    RentalContext.Rental.RentalExtended,
    RentalContext.Rental.ReturnLocationModified,
    RentalContext.Rental.VehicleCheckedIn,
    RentalContext.Rental.DamagesAssessed,
    RentalContext.Rental.FinalChargesProcessed,
    RentalContext.Rental.RentalCompleted,
    RentalContext.Rental.RentalCancelled
  } with {
    briefly "Rental event alternation"
    described as {
      |Union of all Rental events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RentalEventSource as source is {
    outlet RentalEvents is type RentalEvent
    handler RentalSourceHandler is {
      on event Rental.RentalCreated is {
        send event Rental.RentalCreated to outlet RentalEvents
      }
      on event Rental.AddOnAdded is {
        send event Rental.AddOnAdded to outlet RentalEvents
      }
      on event Rental.InsuranceSelected is {
        send event Rental.InsuranceSelected to outlet RentalEvents
      }
      on event Rental.PaymentAuthorized is {
        send event Rental.PaymentAuthorized to outlet RentalEvents
      }
      on event Rental.VehicleCheckedOut is {
        send event Rental.VehicleCheckedOut to outlet RentalEvents
      }
      on event Rental.RentalExtended is {
        send event Rental.RentalExtended to outlet RentalEvents
      }
      on event Rental.ReturnLocationModified is {
        send event Rental.ReturnLocationModified to outlet RentalEvents
      }
      on event Rental.VehicleCheckedIn is {
        send event Rental.VehicleCheckedIn to outlet RentalEvents
      }
      on event Rental.DamagesAssessed is {
        send event Rental.DamagesAssessed to outlet RentalEvents
      }
      on event Rental.FinalChargesProcessed is {
        send event Rental.FinalChargesProcessed to outlet RentalEvents
      }
      on event Rental.RentalCompleted is {
        send event Rental.RentalCompleted to outlet RentalEvents
      }
      on event Rental.RentalCancelled is {
        send event Rental.RentalCancelled to outlet RentalEvents
      }
      on other is {
        error "Unexpected message for source RentalEventSource"
      }
    } with {
      briefly "Rental source handler"
      described as {
        |Publishes Rental events onto the outlet.
      }
    }
  } with {
    briefly "Rental event source"
    described as {
      |Publishes Rental entity events into the streaming topology.
    }
  }
  processor RentalEventSink as sink is {
    inlet RentalInlet is type RentalEvent
    handler RentalSinkHandler is {
      on event Rental.RentalCreated is {
        tell event Rental.RentalCreated to repository RentalContext.RentalRepository
      }
      on event Rental.AddOnAdded is {
        tell event Rental.AddOnAdded to repository RentalContext.RentalRepository
      }
      on event Rental.InsuranceSelected is {
        tell event Rental.InsuranceSelected to repository RentalContext.RentalRepository
      }
      on event Rental.PaymentAuthorized is {
        tell event Rental.PaymentAuthorized to repository RentalContext.RentalRepository
      }
      on event Rental.VehicleCheckedOut is {
        tell event Rental.VehicleCheckedOut to repository RentalContext.RentalRepository
      }
      on event Rental.RentalExtended is {
        tell event Rental.RentalExtended to repository RentalContext.RentalRepository
      }
      on event Rental.ReturnLocationModified is {
        tell event Rental.ReturnLocationModified to repository RentalContext.RentalRepository
      }
      on event Rental.VehicleCheckedIn is {
        tell event Rental.VehicleCheckedIn to repository RentalContext.RentalRepository
      }
      on event Rental.DamagesAssessed is {
        tell event Rental.DamagesAssessed to repository RentalContext.RentalRepository
      }
      on event Rental.FinalChargesProcessed is {
        tell event Rental.FinalChargesProcessed to repository RentalContext.RentalRepository
      }
      on event Rental.RentalCompleted is {
        tell event Rental.RentalCompleted to repository RentalContext.RentalRepository
      }
      on event Rental.RentalCancelled is {
        tell event Rental.RentalCancelled to repository RentalContext.RentalRepository
      }
      on other is {
        error "Unexpected message for sink RentalEventSink"
      }
    } with {
      briefly "Rental sink handler"
      described as {
        |Persists Rental events via the repository.
      }
    }
  } with {
    briefly "Rental event sink"
    described as {
      |Receives Rental events for persistence.
    }
  }
  connector RentalEventFlow is {
    from outlet RentalContext.RentalEventSource.RentalEvents to
      inlet RentalContext.RentalEventSink.RentalInlet
  } with {
    briefly "Rental event flow"
    described as {
      |Connects the Rental source to its sink.
    }
  }
  processor RentalEventSplit is {
    inlet RentalEventSplitIn is type RentalEvent
    outlet RentalEventSplitToRentalRepository is type RentalEvent
    outlet RentalEventSplitToRentalAnalytics is type RentalEvent
    handler RentalEventSplitHandler is {
      on event Rental.RentalCreated is {
        send event Rental.RentalCreated to outlet RentalEventSplitToRentalRepository
        send event Rental.RentalCreated to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.RentalCreated to entity RentalContext.Rental
      }
      on event Rental.AddOnAdded is {
        send event Rental.AddOnAdded to outlet RentalEventSplitToRentalRepository
        send event Rental.AddOnAdded to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.AddOnAdded to entity RentalContext.Rental
      }
      on event Rental.InsuranceSelected is {
        send event Rental.InsuranceSelected to outlet RentalEventSplitToRentalRepository
        send event Rental.InsuranceSelected to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.InsuranceSelected to entity RentalContext.Rental
      }
      on event Rental.PaymentAuthorized is {
        send event Rental.PaymentAuthorized to outlet RentalEventSplitToRentalRepository
        send event Rental.PaymentAuthorized to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.PaymentAuthorized to entity RentalContext.Rental
      }
      on event Rental.VehicleCheckedOut is {
        send event Rental.VehicleCheckedOut to outlet RentalEventSplitToRentalRepository
        send event Rental.VehicleCheckedOut to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.VehicleCheckedOut to entity RentalContext.Rental
      }
      on event Rental.RentalExtended is {
        send event Rental.RentalExtended to outlet RentalEventSplitToRentalRepository
        send event Rental.RentalExtended to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.RentalExtended to entity RentalContext.Rental
      }
      on event Rental.ReturnLocationModified is {
        send event Rental.ReturnLocationModified to outlet RentalEventSplitToRentalRepository
        send event Rental.ReturnLocationModified to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.ReturnLocationModified to entity RentalContext.Rental
      }
      on event Rental.VehicleCheckedIn is {
        send event Rental.VehicleCheckedIn to outlet RentalEventSplitToRentalRepository
        send event Rental.VehicleCheckedIn to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.VehicleCheckedIn to entity RentalContext.Rental
      }
      on event Rental.DamagesAssessed is {
        send event Rental.DamagesAssessed to outlet RentalEventSplitToRentalRepository
        send event Rental.DamagesAssessed to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.DamagesAssessed to entity RentalContext.Rental
      }
      on event Rental.FinalChargesProcessed is {
        send event Rental.FinalChargesProcessed to outlet RentalEventSplitToRentalRepository
        send event Rental.FinalChargesProcessed to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.FinalChargesProcessed to entity RentalContext.Rental
      }
      on event Rental.RentalCompleted is {
        send event Rental.RentalCompleted to outlet RentalEventSplitToRentalRepository
        send event Rental.RentalCompleted to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.RentalCompleted to entity RentalContext.Rental
      }
      on event Rental.RentalCancelled is {
        send event Rental.RentalCancelled to outlet RentalEventSplitToRentalRepository
        send event Rental.RentalCancelled to outlet RentalEventSplitToRentalAnalytics
        tell event Rental.RentalCancelled to entity RentalContext.Rental
      }
      on other is {
        error "Unexpected message for processor RentalEventSplit"
      }
    } with {
      briefly "Rental event fan-out handler"
      described as {
        |Delivers each Rental event to all of its consumers.
      }
    }
  } with {
    briefly "Rental event fan-out"
    described as {
      |Fans Rental events out to the repository and projectors.
    }
  }
  connector LinkRentalToRentalEventSplit is {
    from outlet RentalContext.Rental.RentalEvents2 to
      inlet RentalContext.RentalEventSplit.RentalEventSplitIn
  } with {
    briefly "LinkRentalToRentalEventSplit"
  }
  connector LinkRentalEventSplitToRentalRepository is {
    from outlet RentalContext.RentalEventSplit.RentalEventSplitToRentalRepository to
      inlet RentalContext.RentalRepository.RentalRepositoryFromRental
  } with {
    briefly "LinkRentalEventSplitToRentalRepository"
  }
  connector LinkRentalEventSplitToRentalAnalytics is {
    from outlet RentalContext.RentalEventSplit.RentalEventSplitToRentalAnalytics to
      inlet RentalContext.RentalAnalytics.RentalAnalyticsFromRental
  } with {
    briefly "LinkRentalEventSplitToRentalAnalytics"
  }
  connector LinkRentalAnalyticsToRentalRepository is {
    from outlet RentalContext.RentalAnalytics.RentalAnalyticsOut to
      inlet RentalContext.RentalRepository.RentalRepositoryFromRentalAnalytics
  } with {
    briefly "LinkRentalAnalyticsToRentalRepository"
  }
} with {
  briefly "Bounded context for car rental"
  described as {
    | The RentalContext is the bounded context for
    | vehicle rentals and fleet management.
  }
}
