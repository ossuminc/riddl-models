// Airline Reservations Domain Model
// Flight booking and passenger management
domain AirlineReservations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Passenger is "person booking travel" with {
    briefly "Passenger"
    described as {
      |Person traveling by air.
    }
  }
  user BookingAgent is "person assisting with reservations" with {
    briefly "Booking Agent"
    described as {
      |Agent processing reservations.
    }
  }
  user GateAgent is "person managing boarding" with {
    briefly "Gate Agent"
    described as {
      |Agent at departure gate.
    }
  }
  epic ReservationEpic is {
    user Passenger wants to "to book flights" so that "I can travel to my destination"
    case BookFlight is {
      user Passenger wants to "to reserve a seat on a flight" so that "I have confirmed travel"
      step is "Passenger searches" "available flights" "by criteria" with {
        briefly "Search flights"
        described as {
          |Find available flights.
        }
      }
      step is "Passenger selects" "preferred flight and seat" "from options" with {
        briefly "Select flight"
        described as {
          |Choose flight and seat.
        }
      }
      step take input AirlineReservationsApp.AirlineReservationsScreen.CreateReservationInput from user Passenger with {
        briefly "Create reservation"
        described as {
          |Submit booking.
        }
      }
      step is "System sends" "confirmation and e-ticket" "to passenger" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Book flight"
      described as {
        |Booking air travel.
      }
    }
  } with {
    briefly "Reservation management"
    described as {
      | Epic covering flight reservations, check-in,
      | and boarding processes.
    }
  }
  include "ReservationContext.riddl"
  include "external-contexts.riddl"
  application context AirlineReservationsApp is {
    group AirlineReservationsScreen is {
      input CreateReservationInput acquires command ReservationContext.Reservation.CreateReservation with {
        briefly "Create reservation control"
        described as {
          |The control through which a user submits the create reservation request.
        }
      }
    } with {
      briefly "Airline reservations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppReservationCommands is type ReservationContext.Reservation.ReservationCommand
    inlet AppReservationRepositoryResponses is type ReservationContext.Reservation.ReservationResult
    handler AirlineReservationsAppHandler is {
      on other is {
        error "Unexpected message for application context AirlineReservationsApp"
      }
    } with {
      briefly "AirlineReservationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AirlineReservationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppReservationCommands is {
    from outlet AirlineReservationsApp.AppReservationCommands to
      inlet ReservationContext.Reservation.ReservationCommands
  } with {
    option is persistent
    briefly "LinkAppReservationCommands"
  }
  connector LinkAppReservationRepositoryResponses is {
    from outlet ReservationContext.ReservationRepository.ReservationRepositoryResponses to
      inlet AirlineReservationsApp.AppReservationRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppReservationRepositoryResponses"
  }
} with {
  briefly "Airline reservations domain"
  described as {
    | The AirlineReservations domain handles flight
    | bookings, check-in, and passenger management.
  }
}
