// Airline Reservations - Reservation Context
context ReservationContext as router is {
  inlet ReservationCommandStreamIn is type ReservationCommand  outlet ReservationCommandStreamOut is type ReservationCommand
  inlet ReservationBoardViewStreamIn is type Reservation.ReservationResult  outlet ReservationBoardViewStreamOut is type Reservation.ReservationResult
  handler ReservationContextBoundary is {
    on createReservation: command Reservation.CreateReservation is {
      send createReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on selectSeat: command Reservation.SelectSeat is {
      send selectSeat to outlet ReservationContext.ReservationCommandStreamOut
    }
    on addExtraBaggage: command Reservation.AddExtraBaggage is {
      send addExtraBaggage to outlet ReservationContext.ReservationCommandStreamOut
    }
    on setMealPreference: command Reservation.SetMealPreference is {
      send setMealPreference to outlet ReservationContext.ReservationCommandStreamOut
    }
    on requestSpecialService: command Reservation.RequestSpecialService is {
      send requestSpecialService to outlet ReservationContext.ReservationCommandStreamOut
    }
    on processPayment: command Reservation.ProcessPayment is {
      send processPayment to outlet ReservationContext.ReservationCommandStreamOut
    }
    on confirmReservation: command Reservation.ConfirmReservation is {
      send confirmReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on checkIn: command Reservation.CheckIn is {
      send checkIn to outlet ReservationContext.ReservationCommandStreamOut
    }
    on issueBoardingPass: command Reservation.IssueBoardingPass is {
      send issueBoardingPass to outlet ReservationContext.ReservationCommandStreamOut
    }
    on boardFlight: command Reservation.BoardFlight is {
      send boardFlight to outlet ReservationContext.ReservationCommandStreamOut
    }
    on changeFlightSegment: command Reservation.ChangeFlightSegment is {
      send changeFlightSegment to outlet ReservationContext.ReservationCommandStreamOut
    }
    on cancelReservation: command Reservation.CancelReservation is {
      send cancelReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on processRefund: command Reservation.ProcessRefund is {
      send processRefund to outlet ReservationContext.ReservationCommandStreamOut
    }
    on reservationResult: result Reservation.ReservationResult is {
      send reservationResult to outlet ReservationContext.ReservationBoardViewStreamOut
    }
    on other is {
      error "Unexpected message at the ReservationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ReservationCommand Stream Intake' is from outlet ReservationContext.ReservationCommandStreamOut to inlet ReservationContext.Reservation.ReservationCommands  connector 'ReservationBoardView Stream Egress' is from outlet ReservationContext.ReservationRepository.ReservationRepositoryResponses to inlet ReservationContext.ReservationBoardViewStreamIn  adaptor FromBoardingService from context BoardingService is { 
    handler FromBoardingServiceHandler is {
      on event BoardingService.BoardingCompleted is {
        do "the model receives boarding completed"
      }
      on event BoardingService.BoardingPassScanned is {
        do "the model receives boarding pass scanned"
      }
      on event BoardingService.BoardingStarted is {
        do "the model receives boarding started"
      }
      on other is {
        error "Unexpected message for adaptor FromBoardingService"
      }
    } with {
      briefly "from boarding service"
      described as {
        |Carries messages from the external BoardingService.
      }
    }
  } with {
    briefly "BoardingService integration"
    described as {
      |The model's side of the BoardingService conversation.
    }
  }
  adaptor ToBoardingService to context BoardingService is { 
    handler ToBoardingServiceHandler is {
      on command BoardingService.CompleteBoarding is {
        do "the model sends complete boarding"
      }
      on command BoardingService.ScanBoardingPass is {
        do "the model sends scan boarding pass"
      }
      on command BoardingService.StartBoarding is {
        do "the model sends start boarding"
      }
      on other is {
        error "Unexpected message for adaptor ToBoardingService"
      }
    } with {
      briefly "to boarding service"
      described as {
        |Carries messages to the external BoardingService.
      }
    }
  } with {
    briefly "BoardingService integration"
    described as {
      |The model's side of the BoardingService conversation.
    }
  }
  adaptor FromCheckInService from context CheckInService is { 
    handler FromCheckInServiceHandler is {
      on event CheckInService.CheckInClosed is {
        do "the model receives check in closed"
      }
      on event CheckInService.CheckInOpened is {
        do "the model receives check in opened"
      }
      on other is {
        error "Unexpected message for adaptor FromCheckInService"
      }
    } with {
      briefly "from check in service"
      described as {
        |Carries messages from the external CheckInService.
      }
    }
  } with {
    briefly "CheckInService integration"
    described as {
      |The model's side of the CheckInService conversation.
    }
  }
  adaptor ToCheckInService to context CheckInService is { 
    handler ToCheckInServiceHandler is {
      on command CheckInService.CloseCheckIn is {
        do "the model sends close check in"
      }
      on command CheckInService.OpenCheckIn is {
        do "the model sends open check in"
      }
      on other is {
        error "Unexpected message for adaptor ToCheckInService"
      }
    } with {
      briefly "to check in service"
      described as {
        |Carries messages to the external CheckInService.
      }
    }
  } with {
    briefly "CheckInService integration"
    described as {
      |The model's side of the CheckInService conversation.
    }
  }
  adaptor FromFlightSearchService from context FlightSearchService is { 
    handler FromFlightSearchServiceHandler is {
      on result FlightSearchService.FlightDetails is {
        do "the model receives flight details"
      }
      on result FlightSearchService.FlightSearchResults is {
        do "the model receives flight search results"
      }
      on other is {
        error "Unexpected message for adaptor FromFlightSearchService"
      }
    } with {
      briefly "from flight search service"
      described as {
        |Carries messages from the external FlightSearchService.
      }
    }
  } with {
    briefly "FlightSearchService integration"
    described as {
      |The model's side of the FlightSearchService conversation.
    }
  }
  adaptor ToFlightSearchService to context FlightSearchService is { 
    handler ToFlightSearchServiceHandler is {
      on query FlightSearchService.GetFlightDetails is {
        do "the model sends get flight details"
      }
      on query FlightSearchService.SearchFlights is {
        do "the model sends search flights"
      }
      on other is {
        error "Unexpected message for adaptor ToFlightSearchService"
      }
    } with {
      briefly "to flight search service"
      described as {
        |Carries messages to the external FlightSearchService.
      }
    }
  } with {
    briefly "FlightSearchService integration"
    described as {
      |The model's side of the FlightSearchService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.BoardingPassSent is {
        do "the model receives boarding pass sent"
      }
      on event NotificationService.CheckInReminderSent is {
        do "the model receives check in reminder sent"
      }
      on event NotificationService.FlightStatusSent is {
        do "the model receives flight status sent"
      }
      on event NotificationService.ItinerarySent is {
        do "the model receives itinerary sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendBoardingPass is {
        do "the model sends send boarding pass"
      }
      on command NotificationService.SendCheckInReminder is {
        do "the model sends send check in reminder"
      }
      on command NotificationService.SendFlightStatusUpdate is {
        do "the model sends send flight status update"
      }
      on command NotificationService.SendItineraryConfirmation is {
        do "the model sends send itinerary confirmation"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentSucceeded is {
        do "the model receives payment succeeded"
      }
      on event PaymentProcessingService.RefundSucceeded is {
        do "the model receives refund succeeded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessReservationPayment is {
        do "the model sends process reservation payment"
      }
      on command PaymentProcessingService.ProcessReservationRefund is {
        do "the model sends process reservation refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromPricingService from context PricingService is { 
    handler FromPricingServiceHandler is {
      on result PricingService.FareCalculation is {
        do "the model receives fare calculation"
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor ToPricingService to context PricingService is { 
    handler ToPricingServiceHandler is {
      on query PricingService.CalculateFare is {
        do "the model sends calculate fare"
      }
      on other is {
        error "Unexpected message for adaptor ToPricingService"
      }
    } with {
      briefly "to pricing service"
      described as {
        |Carries messages to the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromSeatInventoryService from context SeatInventoryService is { 
    handler FromSeatInventoryServiceHandler is {
      on result SeatInventoryService.AvailableSeats is {
        do "the model receives available seats"
      }
      on event SeatInventoryService.SeatReleased is {
        do "the model receives seat released"
      }
      on event SeatInventoryService.SeatReserved is {
        do "the model receives seat reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromSeatInventoryService"
      }
    } with {
      briefly "from seat inventory service"
      described as {
        |Carries messages from the external SeatInventoryService.
      }
    }
  } with {
    briefly "SeatInventoryService integration"
    described as {
      |The model's side of the SeatInventoryService conversation.
    }
  }
  adaptor ToSeatInventoryService to context SeatInventoryService is { 
    handler ToSeatInventoryServiceHandler is {
      on query SeatInventoryService.GetAvailableSeats is {
        do "the model sends get available seats"
      }
      on command SeatInventoryService.ReleaseSeat is {
        do "the model sends release seat"
      }
      on command SeatInventoryService.ReserveSeat is {
        do "the model sends reserve seat"
      }
      on other is {
        error "Unexpected message for adaptor ToSeatInventoryService"
      }
    } with {
      briefly "to seat inventory service"
      described as {
        |Carries messages to the external SeatInventoryService.
      }
    }
  } with {
    briefly "SeatInventoryService integration"
    described as {
      |The model's side of the SeatInventoryService conversation.
    }
  }
  include "types.riddl"
  include "Reservation.riddl"
  // Repository for reservation persistence
  type ReservationRepositoryCommand is one of {
    ReservationContext.ReservationRepository.PersistBoardingPassIssued or ReservationContext.ReservationRepository.PersistExtraBaggageAdded or ReservationContext.ReservationRepository.PersistFlightSegmentChanged or ReservationContext.ReservationRepository.PersistMealPreferenceSet or ReservationContext.ReservationRepository.PersistPassengerBoarded or ReservationContext.ReservationRepository.PersistPassengerCheckedIn or ReservationContext.ReservationRepository.PersistPaymentProcessed or ReservationContext.ReservationRepository.PersistRefundProcessed or ReservationContext.ReservationRepository.PersistReservationCancelled or ReservationContext.ReservationRepository.PersistReservationConfirmed or ReservationContext.ReservationRepository.PersistReservationCreated or ReservationContext.ReservationRepository.PersistSeatSelected or ReservationContext.ReservationRepository.PersistSpecialServiceRequested
  } with {
    briefly "Anything that writes ReservationRepository"
    described as {
      |The persistence commands ReservationRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ReservationRepository as flow is {
    inlet ReservationRepositoryFromAirlineAnalytics is type ReservationRepositoryCommand
    command PersistBoardingPassIssued is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row BoardingPassIssued applies to.
        }
      }
    } with {
      briefly "Persist BoardingPassIssued"
      described as {
        |Instructs this repository to apply BoardingPassIssued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistExtraBaggageAdded is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ExtraBaggageAdded applies to.
        }
      }
    } with {
      briefly "Persist ExtraBaggageAdded"
      described as {
        |Instructs this repository to apply ExtraBaggageAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFlightSegmentChanged is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row FlightSegmentChanged applies to.
        }
      }
    } with {
      briefly "Persist FlightSegmentChanged"
      described as {
        |Instructs this repository to apply FlightSegmentChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMealPreferenceSet is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row MealPreferenceSet applies to.
        }
      }
    } with {
      briefly "Persist MealPreferenceSet"
      described as {
        |Instructs this repository to apply MealPreferenceSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPassengerBoarded is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row PassengerBoarded applies to.
        }
      }
    } with {
      briefly "Persist PassengerBoarded"
      described as {
        |Instructs this repository to apply PassengerBoarded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefundProcessed is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefundProcessed applies to.
        }
      }
    } with {
      briefly "Persist RefundProcessed"
      described as {
        |Instructs this repository to apply RefundProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSeatSelected is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SeatSelected applies to.
        }
      }
    } with {
      briefly "Persist SeatSelected"
      described as {
        |Instructs this repository to apply SeatSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSpecialServiceRequested is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SpecialServiceRequested applies to.
        }
      }
    } with {
      briefly "Persist SpecialServiceRequested"
      described as {
        |Instructs this repository to apply SpecialServiceRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPassengerCheckedIn is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row PassengerCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist PassengerCheckedIn"
      described as {
        |Instructs this repository to apply PassengerCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCancelled is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationCancelled applies to.
        }
      }
    } with {
      briefly "Persist ReservationCancelled"
      described as {
        |Instructs this repository to apply ReservationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationConfirmed is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationConfirmed applies to.
        }
      }
    } with {
      briefly "Persist ReservationConfirmed"
      described as {
        |Instructs this repository to apply ReservationConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCreated is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationCreated applies to.
        }
      }
    } with {
      briefly "Persist ReservationCreated"
      described as {
        |Instructs this repository to apply ReservationCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ReservationRepositoryResponses is type Reservation.ReservationResult
    record StoredReservation is  {
      reservationId: ReservationId with {
        briefly "reservationId"
        described as {
          |The reservationId column of the stored reservation row.
        }
      }
      confirmationCode: String(6,6) with {
        briefly "confirmationCode"
        described as {
          |The confirmationCode column of the stored reservation row.
        }
      }
      passenger: PassengerInfo with {
        briefly "passenger"
        described as {
          |The passenger column of the stored reservation row.
        }
      }
    } with {
      briefly "Stored reservation row"
      described as {
        |The persistence shape of reservation data as this repository stores it.
      }
    }
    schema ReservationData is relational
      of reservations as type StoredReservation
        index on field StoredReservation.reservationId
        index on field StoredReservation.passenger.passengerId
        index on field StoredReservation.confirmationCode
 with {
      briefly "Reservation data schema"
      described as {
        |The relational schema holding reservation data for the ReservationRepository.
      }
    }
    handler ReservationPersistence is {
      on persistBoardingPassIssued: command PersistBoardingPassIssued is {
        do "apply BoardingPassIssued to the stored row"
      }
      on persistExtraBaggageAdded: command PersistExtraBaggageAdded is {
        do "apply ExtraBaggageAdded to the stored row"
      }
      on persistFlightSegmentChanged: command PersistFlightSegmentChanged is {
        do "apply FlightSegmentChanged to the stored row"
      }
      on persistMealPreferenceSet: command PersistMealPreferenceSet is {
        do "apply MealPreferenceSet to the stored row"
      }
      on persistPassengerBoarded: command PersistPassengerBoarded is {
        do "apply PassengerBoarded to the stored row"
      }
      on persistRefundProcessed: command PersistRefundProcessed is {
        do "apply RefundProcessed to the stored row"
      }
      on persistSeatSelected: command PersistSeatSelected is {
        do "apply SeatSelected to the stored row"
      }
      on persistSpecialServiceRequested: command PersistSpecialServiceRequested is {
        do "apply SpecialServiceRequested to the stored row"
      }
      on persistPassengerCheckedIn: command PersistPassengerCheckedIn is {
        do "apply PassengerCheckedIn to the stored row"
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        do "apply PaymentProcessed to the stored row"
      }
      on persistReservationCancelled: command PersistReservationCancelled is {
        do "apply ReservationCancelled to the stored row"
      }
      on persistReservationConfirmed: command PersistReservationConfirmed is {
        do "apply ReservationConfirmed to the stored row"
      }
      on persistReservationCreated: command PersistReservationCreated is {
        do "apply ReservationCreated to the stored row"
      }
      on query GetAirlineStats is {
        let airlineStatsView: type AirlineStatsView = prompt("read the airline stats projection")
        reply airlineStatsView
      }
    } with {
      briefly "Persists reservation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reservation data persistence"
    described as {
      | The ReservationRepository provides persistent storage for
      | reservations and related data.
    }
  }
  // Projector for airline analytics
  query GetAirlineStats replies result AirlineStatsView is  {
    airlineStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which airline stats to retrieve.
      }
    }
  } with {
    briefly "Get airline stats"
    described as {
      |Retrieves the airline stats projection.
    }
  }
  result AirlineStatsView is  {
    airlineStats: AirlineAnalytics.AirlineStats with {
      briefly "Airline stats"
      described as {
        |The airline stats being returned.
      }
    }
  } with {
    briefly "Airline stats view"
    described as {
      |Read model view carrying the airline stats projection.
    }
  }
  projector AirlineAnalytics as flow is {
    outlet AirlineAnalyticsToRepository is type ReservationRepositoryCommand
    updates repository ReservationContext.ReservationRepository
    inlet AirlineAnalyticsFromReservation is type ReservationEvent
    record AirlineStats is  {
      totalReservations: Natural with {
        briefly "Total"
        described as {
          |Total reservations.
        }
      }
      confirmedReservations: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed reservations.
        }
      }
      checkedInCount: Natural with {
        briefly "Checked in"
        described as {
          |Checked in count.
        }
      }
      cancelledReservations: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled reservations.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      loadFactor: Decimal(5,2) with {
        briefly "Load factor"
        described as {
          |Seat occupancy rate.
        }
      }
    } with {
      briefly "Airline statistics"
      described as {
        |Airline booking metrics.
      }
    }
    handler AnalyticsHandler is {
      on boardingPassIssued: event Reservation.BoardingPassIssued is {
        tell command ReservationContext.ReservationRepository.PersistBoardingPassIssued(reservationId = boardingPassIssued.reservationId) to repository ReservationContext.ReservationRepository
        do "apply BoardingPassIssued to the AirlineAnalytics projection"
      }
      on extraBaggageAdded: event Reservation.ExtraBaggageAdded is {
        tell command ReservationContext.ReservationRepository.PersistExtraBaggageAdded(reservationId = extraBaggageAdded.reservationId) to repository ReservationContext.ReservationRepository
        do "apply ExtraBaggageAdded to the AirlineAnalytics projection"
      }
      on flightSegmentChanged: event Reservation.FlightSegmentChanged is {
        tell command ReservationContext.ReservationRepository.PersistFlightSegmentChanged(reservationId = flightSegmentChanged.reservationId) to repository ReservationContext.ReservationRepository
        do "apply FlightSegmentChanged to the AirlineAnalytics projection"
      }
      on mealPreferenceSet: event Reservation.MealPreferenceSet is {
        tell command ReservationContext.ReservationRepository.PersistMealPreferenceSet(reservationId = mealPreferenceSet.reservationId) to repository ReservationContext.ReservationRepository
        do "apply MealPreferenceSet to the AirlineAnalytics projection"
      }
      on passengerBoarded: event Reservation.PassengerBoarded is {
        tell command ReservationContext.ReservationRepository.PersistPassengerBoarded(reservationId = passengerBoarded.reservationId) to repository ReservationContext.ReservationRepository
        do "apply PassengerBoarded to the AirlineAnalytics projection"
      }
      on refundProcessed: event Reservation.RefundProcessed is {
        tell command ReservationContext.ReservationRepository.PersistRefundProcessed(reservationId = refundProcessed.reservationId) to repository ReservationContext.ReservationRepository
        do "apply RefundProcessed to the AirlineAnalytics projection"
      }
      on seatSelected: event Reservation.SeatSelected is {
        tell command ReservationContext.ReservationRepository.PersistSeatSelected(reservationId = seatSelected.reservationId) to repository ReservationContext.ReservationRepository
        do "apply SeatSelected to the AirlineAnalytics projection"
      }
      on specialServiceRequested: event Reservation.SpecialServiceRequested is {
        tell command ReservationContext.ReservationRepository.PersistSpecialServiceRequested(reservationId = specialServiceRequested.reservationId) to repository ReservationContext.ReservationRepository
        do "apply SpecialServiceRequested to the AirlineAnalytics projection"
      }
      on reservationCreated: event Reservation.ReservationCreated is {
        tell command ReservationContext.ReservationRepository.PersistReservationCreated(reservationId = reservationCreated.reservationId) to repository ReservationContext.ReservationRepository
        do "Update reservation counts"
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        tell command ReservationContext.ReservationRepository.PersistReservationConfirmed(reservationId = reservationConfirmed.reservationId) to repository ReservationContext.ReservationRepository
        do "Update confirmed counts"
      }
      on paymentProcessed: event Reservation.PaymentProcessed is {
        tell command ReservationContext.ReservationRepository.PersistPaymentProcessed(reservationId = paymentProcessed.reservationId) to repository ReservationContext.ReservationRepository
        do "Update revenue metrics"
      }
      on passengerCheckedIn: event Reservation.PassengerCheckedIn is {
        tell command ReservationContext.ReservationRepository.PersistPassengerCheckedIn(reservationId = passengerCheckedIn.reservationId) to repository ReservationContext.ReservationRepository
        do "Update check-in metrics"
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        tell command ReservationContext.ReservationRepository.PersistReservationCancelled(reservationId = reservationCancelled.reservationId) to repository ReservationContext.ReservationRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains airline analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Airline analytics projections"
    described as {
      |Maintains airline booking analytics data.
    }
  }
  // ---- Event publication for Reservation ----
  type ReservationEvent is one of {
    ReservationContext.Reservation.ReservationCreated or ReservationContext.Reservation.SeatSelected or ReservationContext.Reservation.ExtraBaggageAdded or ReservationContext.Reservation.MealPreferenceSet or ReservationContext.Reservation.SpecialServiceRequested or ReservationContext.Reservation.PaymentProcessed or ReservationContext.Reservation.ReservationConfirmed or ReservationContext.Reservation.PassengerCheckedIn or ReservationContext.Reservation.BoardingPassIssued or ReservationContext.Reservation.PassengerBoarded or ReservationContext.Reservation.FlightSegmentChanged or ReservationContext.Reservation.ReservationCancelled or ReservationContext.Reservation.RefundProcessed
  } with {
    briefly "Reservation event alternation"
    described as {
      |Union of all Reservation events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReservationEventSplit as flow is {
    inlet ReservationEventSplitIn is type ReservationEvent
    outlet ReservationEventSplitToAirlineAnalytics is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on reservationCreated: event Reservation.ReservationCreated is {
        send reservationCreated to outlet ReservationEventSplitToAirlineAnalytics
        tell reservationCreated to entity ReservationContext.Reservation
      }
      on seatSelected: event Reservation.SeatSelected is {
        send seatSelected to outlet ReservationEventSplitToAirlineAnalytics
        tell seatSelected to entity ReservationContext.Reservation
      }
      on extraBaggageAdded: event Reservation.ExtraBaggageAdded is {
        send extraBaggageAdded to outlet ReservationEventSplitToAirlineAnalytics
        tell extraBaggageAdded to entity ReservationContext.Reservation
      }
      on mealPreferenceSet: event Reservation.MealPreferenceSet is {
        send mealPreferenceSet to outlet ReservationEventSplitToAirlineAnalytics
        tell mealPreferenceSet to entity ReservationContext.Reservation
      }
      on specialServiceRequested: event Reservation.SpecialServiceRequested is {
        send specialServiceRequested to outlet ReservationEventSplitToAirlineAnalytics
        tell specialServiceRequested to entity ReservationContext.Reservation
      }
      on paymentProcessed: event Reservation.PaymentProcessed is {
        send paymentProcessed to outlet ReservationEventSplitToAirlineAnalytics
        tell paymentProcessed to entity ReservationContext.Reservation
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        send reservationConfirmed to outlet ReservationEventSplitToAirlineAnalytics
        tell reservationConfirmed to entity ReservationContext.Reservation
      }
      on passengerCheckedIn: event Reservation.PassengerCheckedIn is {
        send passengerCheckedIn to outlet ReservationEventSplitToAirlineAnalytics
        tell passengerCheckedIn to entity ReservationContext.Reservation
      }
      on boardingPassIssued: event Reservation.BoardingPassIssued is {
        send boardingPassIssued to outlet ReservationEventSplitToAirlineAnalytics
        tell boardingPassIssued to entity ReservationContext.Reservation
      }
      on passengerBoarded: event Reservation.PassengerBoarded is {
        send passengerBoarded to outlet ReservationEventSplitToAirlineAnalytics
        tell passengerBoarded to entity ReservationContext.Reservation
      }
      on flightSegmentChanged: event Reservation.FlightSegmentChanged is {
        send flightSegmentChanged to outlet ReservationEventSplitToAirlineAnalytics
        tell flightSegmentChanged to entity ReservationContext.Reservation
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        send reservationCancelled to outlet ReservationEventSplitToAirlineAnalytics
        tell reservationCancelled to entity ReservationContext.Reservation
      }
      on refundProcessed: event Reservation.RefundProcessed is {
        send refundProcessed to outlet ReservationEventSplitToAirlineAnalytics
        tell refundProcessed to entity ReservationContext.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  connector 'ReservationEvent Stream' is from outlet ReservationContext.Reservation.ReservationEvents2 to inlet ReservationContext.ReservationEventSplit.ReservationEventSplitIn with {
    briefly "Reservation events, fanned out to storage and read models"
  }
  connector 'AirlineAnalytics Feed' is from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToAirlineAnalytics to inlet ReservationContext.AirlineAnalytics.AirlineAnalyticsFromReservation with {
    briefly "Reservation events feeding the AirlineAnalytics projection"
  }
  connector 'AirlineAnalytics Storage' is from outlet ReservationContext.AirlineAnalytics.AirlineAnalyticsToRepository to inlet ReservationContext.ReservationRepository.ReservationRepositoryFromAirlineAnalytics with {
    briefly "AirlineAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for airline reservations"
  described as {
    | The ReservationContext is the bounded context for
    | flight reservations and passenger management.
  }
}
