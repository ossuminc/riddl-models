// Airline Reservations - Reservation Context
context ReservationContext is {
  include "types.riddl"
  include "Reservation.riddl"
  // Repository for reservation persistence
  repository ReservationRepository is {
    inlet ReservationRepositoryFromReservation is type ReservationEvent
    inlet ReservationRepositoryFromAirlineAnalytics is type ReservationEvent
    outlet ReservationRepositoryResponses is type Reservation.ReservationResult
    schema ReservationData is relational
      of reservations as type Reservation
        index on field Reservation.reservationId
        index on field Reservation.passenger.passengerId
        index on field Reservation.confirmationCode
      with {
      briefly "Reservation data schema"
      described as {
        |The relational schema holding reservation data for the ReservationRepository.
      }
    }

    handler ReservationPersistence is {
      on command Reservation.CreateReservation is {
        tell event Reservation.ReservationCreated to entity ReservationContext.Reservation
        do "Store new reservation"
      }
      on command Reservation.SelectSeat is {
        do "Update seat assignment"
      }
      on command Reservation.AddExtraBaggage is {
        tell event Reservation.ExtraBaggageAdded to entity ReservationContext.Reservation
        do "Store extra baggage"
      }
      on command Reservation.SetMealPreference is {
        tell event Reservation.MealPreferenceSet to entity ReservationContext.Reservation
        do "Store meal preference"
      }
      on command Reservation.RequestSpecialService is {
        do "Store special service"
      }
      on command Reservation.ProcessPayment is {
        tell event Reservation.PaymentProcessed to entity ReservationContext.Reservation
        do "Store payment"
      }
      on command Reservation.ConfirmReservation is {
        tell event Reservation.ReservationConfirmed to entity ReservationContext.Reservation
        do "Update to confirmed"
      }
      on command Reservation.CheckIn is {
        do "Update to checked in"
      }
      on command Reservation.IssueBoardingPass is {
        tell event Reservation.BoardingPassIssued to entity ReservationContext.Reservation
        do "Store boarding pass"
      }
      on command Reservation.BoardFlight is {
        do "Update to boarded"
      }
      on command Reservation.ChangeFlightSegment is {
        do "Update flight segment"
      }
      on command Reservation.CancelReservation is {
        tell event Reservation.ReservationCancelled to entity ReservationContext.Reservation
        do "Update to cancelled"
      }
      on command Reservation.ProcessRefund is {
        tell event Reservation.RefundProcessed to entity ReservationContext.Reservation
        do "Store refund"
      }
    } with {
      briefly "Persists reservation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reservation data persistence"
    described as {
      | The ReservationRepository provides persistent storage for
      | reservations and related data.
    }
  }
  // Projector for airline analytics
  projector AirlineAnalytics is {
    inlet AirlineAnalyticsFromReservation is type ReservationEvent
    outlet AirlineAnalyticsOut is type ReservationEvent
    updates repository ReservationContext.ReservationRepository
    record AirlineStats is  {
      totalReservations: Natural with {
        briefly "Total"
        described as {
          |Total reservations.
        }
      }
      confirmedReservations: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed reservations.
        }
      }
      checkedInCount: Natural with {
        briefly "Checked in"
        described as {
          |Checked in count.
        }
      }
      cancelledReservations: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled reservations.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      loadFactor: Decimal(5,2) with {
        briefly "Load factor"
        described as {
          |Seat occupancy rate.
        }
      }
    } with {
      briefly "Airline statistics"
      described as {
        |Airline booking metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Reservation.ReservationCreated is {
        tell event Reservation.ReservationCreated to repository ReservationContext.ReservationRepository
        do "Update reservation counts"
      }
      on event Reservation.ReservationConfirmed is {
        tell event Reservation.ReservationConfirmed to repository ReservationContext.ReservationRepository
        do "Update confirmed counts"
      }
      on event Reservation.PaymentProcessed is {
        tell event Reservation.PaymentProcessed to repository ReservationContext.ReservationRepository
        do "Update revenue metrics"
      }
      on event Reservation.PassengerCheckedIn is {
        tell event Reservation.PassengerCheckedIn to repository ReservationContext.ReservationRepository
        do "Update check-in metrics"
      }
      on event Reservation.ReservationCancelled is {
        tell event Reservation.ReservationCancelled to repository ReservationContext.ReservationRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains airline analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Airline analytics projections"
    described as {
      |Maintains airline booking analytics data.
    }
  }
  // ---- Event publication for Reservation ----
  type ReservationEvent is one of {
    ReservationContext.Reservation.ReservationCreated,
    ReservationContext.Reservation.SeatSelected,
    ReservationContext.Reservation.ExtraBaggageAdded,
    ReservationContext.Reservation.MealPreferenceSet,
    ReservationContext.Reservation.SpecialServiceRequested,
    ReservationContext.Reservation.PaymentProcessed,
    ReservationContext.Reservation.ReservationConfirmed,
    ReservationContext.Reservation.PassengerCheckedIn,
    ReservationContext.Reservation.BoardingPassIssued,
    ReservationContext.Reservation.PassengerBoarded,
    ReservationContext.Reservation.FlightSegmentChanged,
    ReservationContext.Reservation.ReservationCancelled,
    ReservationContext.Reservation.RefundProcessed
  } with {
    briefly "Reservation event alternation"
    described as {
      |Union of all Reservation events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReservationEventSource as source is {
    outlet ReservationEvents is type ReservationEvent
    handler ReservationSourceHandler is {
      on event Reservation.ReservationCreated is {
        send event Reservation.ReservationCreated to outlet ReservationEvents
      }
      on event Reservation.SeatSelected is {
        send event Reservation.SeatSelected to outlet ReservationEvents
      }
      on event Reservation.ExtraBaggageAdded is {
        send event Reservation.ExtraBaggageAdded to outlet ReservationEvents
      }
      on event Reservation.MealPreferenceSet is {
        send event Reservation.MealPreferenceSet to outlet ReservationEvents
      }
      on event Reservation.SpecialServiceRequested is {
        send event Reservation.SpecialServiceRequested to outlet ReservationEvents
      }
      on event Reservation.PaymentProcessed is {
        send event Reservation.PaymentProcessed to outlet ReservationEvents
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEvents
      }
      on event Reservation.PassengerCheckedIn is {
        send event Reservation.PassengerCheckedIn to outlet ReservationEvents
      }
      on event Reservation.BoardingPassIssued is {
        send event Reservation.BoardingPassIssued to outlet ReservationEvents
      }
      on event Reservation.PassengerBoarded is {
        send event Reservation.PassengerBoarded to outlet ReservationEvents
      }
      on event Reservation.FlightSegmentChanged is {
        send event Reservation.FlightSegmentChanged to outlet ReservationEvents
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEvents
      }
      on event Reservation.RefundProcessed is {
        send event Reservation.RefundProcessed to outlet ReservationEvents
      }
      on other is {
        error "Unexpected message for source ReservationEventSource"
      }
    } with {
      briefly "Reservation source handler"
      described as {
        |Publishes Reservation events onto the outlet.
      }
    }
  } with {
    briefly "Reservation event source"
    described as {
      |Publishes Reservation entity events into the streaming topology.
    }
  }
  processor ReservationEventSink as sink is {
    inlet ReservationInlet is type ReservationEvent
    handler ReservationSinkHandler is {
      on event Reservation.ReservationCreated is {
        tell event Reservation.ReservationCreated to repository ReservationContext.ReservationRepository
      }
      on event Reservation.SeatSelected is {
        tell event Reservation.SeatSelected to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ExtraBaggageAdded is {
        tell event Reservation.ExtraBaggageAdded to repository ReservationContext.ReservationRepository
      }
      on event Reservation.MealPreferenceSet is {
        tell event Reservation.MealPreferenceSet to repository ReservationContext.ReservationRepository
      }
      on event Reservation.SpecialServiceRequested is {
        tell event Reservation.SpecialServiceRequested to repository ReservationContext.ReservationRepository
      }
      on event Reservation.PaymentProcessed is {
        tell event Reservation.PaymentProcessed to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationConfirmed is {
        tell event Reservation.ReservationConfirmed to repository ReservationContext.ReservationRepository
      }
      on event Reservation.PassengerCheckedIn is {
        tell event Reservation.PassengerCheckedIn to repository ReservationContext.ReservationRepository
      }
      on event Reservation.BoardingPassIssued is {
        tell event Reservation.BoardingPassIssued to repository ReservationContext.ReservationRepository
      }
      on event Reservation.PassengerBoarded is {
        tell event Reservation.PassengerBoarded to repository ReservationContext.ReservationRepository
      }
      on event Reservation.FlightSegmentChanged is {
        tell event Reservation.FlightSegmentChanged to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationCancelled is {
        tell event Reservation.ReservationCancelled to repository ReservationContext.ReservationRepository
      }
      on event Reservation.RefundProcessed is {
        tell event Reservation.RefundProcessed to repository ReservationContext.ReservationRepository
      }
      on other is {
        error "Unexpected message for sink ReservationEventSink"
      }
    } with {
      briefly "Reservation sink handler"
      described as {
        |Persists Reservation events via the repository.
      }
    }
  } with {
    briefly "Reservation event sink"
    described as {
      |Receives Reservation events for persistence.
    }
  }
  connector ReservationEventFlow is {
    from outlet ReservationContext.ReservationEventSource.ReservationEvents to
      inlet ReservationContext.ReservationEventSink.ReservationInlet
  } with {
    briefly "Reservation event flow"
    described as {
      |Connects the Reservation source to its sink.
    }
  }
  processor ReservationEventSplit is {
    inlet ReservationEventSplitIn is type ReservationEvent
    outlet ReservationEventSplitToReservationRepository is type ReservationEvent
    outlet ReservationEventSplitToAirlineAnalytics is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on event Reservation.ReservationCreated is {
        send event Reservation.ReservationCreated to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationCreated to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.ReservationCreated to entity ReservationContext.Reservation
      }
      on event Reservation.SeatSelected is {
        send event Reservation.SeatSelected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.SeatSelected to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.SeatSelected to entity ReservationContext.Reservation
      }
      on event Reservation.ExtraBaggageAdded is {
        send event Reservation.ExtraBaggageAdded to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ExtraBaggageAdded to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.ExtraBaggageAdded to entity ReservationContext.Reservation
      }
      on event Reservation.MealPreferenceSet is {
        send event Reservation.MealPreferenceSet to outlet ReservationEventSplitToReservationRepository
        send event Reservation.MealPreferenceSet to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.MealPreferenceSet to entity ReservationContext.Reservation
      }
      on event Reservation.SpecialServiceRequested is {
        send event Reservation.SpecialServiceRequested to outlet ReservationEventSplitToReservationRepository
        send event Reservation.SpecialServiceRequested to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.SpecialServiceRequested to entity ReservationContext.Reservation
      }
      on event Reservation.PaymentProcessed is {
        send event Reservation.PaymentProcessed to outlet ReservationEventSplitToReservationRepository
        send event Reservation.PaymentProcessed to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.PaymentProcessed to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.ReservationConfirmed to entity ReservationContext.Reservation
      }
      on event Reservation.PassengerCheckedIn is {
        send event Reservation.PassengerCheckedIn to outlet ReservationEventSplitToReservationRepository
        send event Reservation.PassengerCheckedIn to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.PassengerCheckedIn to entity ReservationContext.Reservation
      }
      on event Reservation.BoardingPassIssued is {
        send event Reservation.BoardingPassIssued to outlet ReservationEventSplitToReservationRepository
        send event Reservation.BoardingPassIssued to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.BoardingPassIssued to entity ReservationContext.Reservation
      }
      on event Reservation.PassengerBoarded is {
        send event Reservation.PassengerBoarded to outlet ReservationEventSplitToReservationRepository
        send event Reservation.PassengerBoarded to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.PassengerBoarded to entity ReservationContext.Reservation
      }
      on event Reservation.FlightSegmentChanged is {
        send event Reservation.FlightSegmentChanged to outlet ReservationEventSplitToReservationRepository
        send event Reservation.FlightSegmentChanged to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.FlightSegmentChanged to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.ReservationCancelled to entity ReservationContext.Reservation
      }
      on event Reservation.RefundProcessed is {
        send event Reservation.RefundProcessed to outlet ReservationEventSplitToReservationRepository
        send event Reservation.RefundProcessed to outlet ReservationEventSplitToAirlineAnalytics
        tell event Reservation.RefundProcessed to entity ReservationContext.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  connector LinkReservationToReservationEventSplit is {
    from outlet ReservationContext.Reservation.ReservationEvents2 to
      inlet ReservationContext.ReservationEventSplit.ReservationEventSplitIn
  } with {
    briefly "LinkReservationToReservationEventSplit"
  }
  connector LinkReservationEventSplitToReservationRepository is {
    from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToReservationRepository to
      inlet ReservationContext.ReservationRepository.ReservationRepositoryFromReservation
  } with {
    briefly "LinkReservationEventSplitToReservationRepository"
  }
  connector LinkReservationEventSplitToAirlineAnalytics is {
    from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToAirlineAnalytics to
      inlet ReservationContext.AirlineAnalytics.AirlineAnalyticsFromReservation
  } with {
    briefly "LinkReservationEventSplitToAirlineAnalytics"
  }
  connector LinkAirlineAnalyticsToReservationRepository is {
    from outlet ReservationContext.AirlineAnalytics.AirlineAnalyticsOut to
      inlet ReservationContext.ReservationRepository.ReservationRepositoryFromAirlineAnalytics
  } with {
    briefly "LinkAirlineAnalyticsToReservationRepository"
  }
} with {
  briefly "Bounded context for airline reservations"
  described as {
    | The ReservationContext is the bounded context for
    | flight reservations and passenger management.
  }
}
