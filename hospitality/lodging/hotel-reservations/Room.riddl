// Hotel Reservations - Room Entity
// // A room is its own aggregate. RoomStatus enumerates its occupancy cycle --
// available, reserved, occupied, cleaning, maintenance -- which belongs to the
// physical room, not to a Reservation. A reservation is an agreement with a
// guest; it is not "Cleaning", and the room outlives every booking made
// against it.
aggregate entity Room as router is {
  type RoomCommand is one of {
    Room.HoldRoom or Room.OccupyRoom or Room.VacateRoom or Room.CompleteTurnover or Room.SendToMaintenance or Room.ReturnFromMaintenance
  } with {
    briefly "Room command alternation"
    described as {
      |Commands accepted by the Room entity.
    }
  }
  type RoomEvent is one of {
    Room.RoomRegistered or Room.RoomHeld or Room.RoomOccupied or Room.RoomVacated or Room.TurnoverCompleted or Room.SentToMaintenance or Room.ReturnedFromMaintenance
  } with {
    briefly "Room event alternation"
    described as {
      |Events published by the Room entity.
    }
  }
  inlet RoomQueries is query GetRoom with {
    briefly "Look-ups of this room"
    described as {
      |What HotelReservationsApp asks of the room, by way of ReservationContext.
    }
  }
  outlet RoomReplies is result RoomResult
 with {
    briefly "This room's answers"
    described as {
      |What the room answers, on its way back to ReservationContext.
    }
  }
  inlet RoomCommands is type RoomCommand
  outlet RoomEvents is type RoomEvent
  query GetRoom replies result Room.RoomResult is {
    roomId: RoomId with {
      briefly "ID"
      described as {
        |Identifier of the room to retrieve.
      }
    }
  } with {
    briefly "Get room"
    described as {
      |Retrieve room data by identifier.
    }
  }
  result RoomResult is {
    roomData: Room.AvailableStateData with {
      briefly "Room data"
      described as {
        |The requested room data.
      }
    }
  } with {
    briefly "Room result"
    described as {
      |Result carrying the requested room data.
    }
  }
  command HoldRoom is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this command addresses.
      }
    }
  } with {
    briefly "Hold a room"
    described as {
      |Holds the room against a confirmed reservation.
    }
  }
  command OccupyRoom is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this command addresses.
      }
    }
  } with {
    briefly "Occupy a room"
    described as {
      |Records a guest taking occupancy at check-in.
    }
  }
  command VacateRoom is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this command addresses.
      }
    }
  } with {
    briefly "Vacate a room"
    described as {
      |Records departure and sends the room for turnover.
    }
  }
  command CompleteTurnover is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this command addresses.
      }
    }
  } with {
    briefly "Complete turnover"
    described as {
      |Returns a cleaned room to sellable inventory.
    }
  }
  command SendToMaintenance is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this command addresses.
      }
    }
  } with {
    briefly "Send to maintenance"
    described as {
      |Takes the room out of service for repair.
    }
  }
  command ReturnFromMaintenance is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this command addresses.
      }
    }
  } with {
    briefly "Return from maintenance"
    described as {
      |Returns a repaired room to sellable inventory.
    }
  }
  event RoomRegistered is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this event concerns.
      }
    }
  } with {
    briefly "RoomRegistered"
    described as {
      |Records the outcome of RegisterRoom.
    }
  }
  event RoomHeld is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this event concerns.
      }
    }
  } with {
    briefly "RoomHeld"
    described as {
      |Records the outcome of HoldRoom.
    }
  }
  event RoomOccupied is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this event concerns.
      }
    }
  } with {
    briefly "RoomOccupied"
    described as {
      |Records the outcome of OccupyRoom.
    }
  }
  event RoomVacated is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this event concerns.
      }
    }
  } with {
    briefly "RoomVacated"
    described as {
      |Records the outcome of VacateRoom.
    }
  }
  event TurnoverCompleted is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this event concerns.
      }
    }
  } with {
    briefly "TurnoverCompleted"
    described as {
      |Records the outcome of CompleteTurnover.
    }
  }
  event SentToMaintenance is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this event concerns.
      }
    }
  } with {
    briefly "SentToMaintenance"
    described as {
      |Records the outcome of SendToMaintenance.
    }
  }
  event ReturnedFromMaintenance is {
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this event concerns.
      }
    }
  } with {
    briefly "ReturnedFromMaintenance"
    described as {
      |Records the outcome of ReturnFromMaintenance.
    }
  }
  record AvailableStateData is {
    stateValue: RoomStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this state belongs to.
      }
    }
    roomInfo: RoomInfo with {
      briefly "Room details"
      described as {
        |Number, type and attributes of the room.
      }
    }
  } with {
    briefly "Available room"
    described as {
      |A room that is vacant, clean and sellable.
    }
  }
  record ReservedStateData is {
    stateValue: RoomStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this state belongs to.
      }
    }
    roomInfo: RoomInfo with {
      briefly "Room details"
      described as {
        |Number, type and attributes of the room.
      }
    }
  } with {
    briefly "Reserved room"
    described as {
      |A room that is held for a confirmed reservation but not yet occupied.
    }
  }
  record OccupiedStateData is {
    stateValue: RoomStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this state belongs to.
      }
    }
    roomInfo: RoomInfo with {
      briefly "Room details"
      described as {
        |Number, type and attributes of the room.
      }
    }
  } with {
    briefly "Occupied room"
    described as {
      |A room that is in use by a checked-in guest.
    }
  }
  record CleaningStateData is {
    stateValue: RoomStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this state belongs to.
      }
    }
    roomInfo: RoomInfo with {
      briefly "Room details"
      described as {
        |Number, type and attributes of the room.
      }
    }
  } with {
    briefly "Cleaning room"
    described as {
      |A room that is vacated and being turned over by housekeeping.
    }
  }
  record MaintenanceStateData is {
    stateValue: RoomStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room this state belongs to.
      }
    }
    roomInfo: RoomInfo with {
      briefly "Room details"
      described as {
        |Number, type and attributes of the room.
      }
    }
  } with {
    briefly "Maintenance room"
    described as {
      |A room that is out of service for repair.
    }
  }
  state AvailableState of record Room.AvailableStateData is {
    initial handler AvailableStateHandler is {
      on holdRoom: command HoldRoom is {
        morph entity ReservationContext.Room to state ReservationContext.Room.ReservedState with record Room.ReservedStateData(roomId = holdRoom.roomId, stateValue = AvailableStateData.stateValue, roomInfo = AvailableStateData.roomInfo)
        send event Room.RoomHeld(roomId = holdRoom.roomId) to outlet RoomEvents
      }
      on sendToMaintenance: command SendToMaintenance is {
        morph entity ReservationContext.Room to state ReservationContext.Room.MaintenanceState with record Room.MaintenanceStateData(roomId = sendToMaintenance.roomId, stateValue = AvailableStateData.stateValue, roomInfo = AvailableStateData.roomInfo)
        send event Room.SentToMaintenance(roomId = sendToMaintenance.roomId) to outlet RoomEvents
      }
    } with {
      briefly "While AvailableState"
      described as {
        |The commands and folds accepted while the entity is in AvailableState.
      }
    }
  } with {
    briefly "Available state"
    described as {
      |A room that is vacant, clean and sellable.
    }
  }
  state ReservedState of record Room.ReservedStateData is {
    initial handler ReservedStateHandler is {
      on occupyRoom: command OccupyRoom is {
        morph entity ReservationContext.Room to state ReservationContext.Room.OccupiedState with record Room.OccupiedStateData(roomId = occupyRoom.roomId, stateValue = ReservedStateData.stateValue, roomInfo = ReservedStateData.roomInfo)
        send event Room.RoomOccupied(roomId = occupyRoom.roomId) to outlet RoomEvents
      }
    } with {
      briefly "While ReservedState"
      described as {
        |The commands and folds accepted while the entity is in ReservedState.
      }
    }
  } with {
    briefly "Reserved state"
    described as {
      |A room that is held for a confirmed reservation but not yet occupied.
    }
  }
  state OccupiedState of record Room.OccupiedStateData is {
    initial handler OccupiedStateHandler is {
      on vacateRoom: command VacateRoom is {
        morph entity ReservationContext.Room to state ReservationContext.Room.CleaningState with record Room.CleaningStateData(roomId = vacateRoom.roomId, stateValue = OccupiedStateData.stateValue, roomInfo = OccupiedStateData.roomInfo)
        send event Room.RoomVacated(roomId = vacateRoom.roomId) to outlet RoomEvents
      }
    } with {
      briefly "While OccupiedState"
      described as {
        |The commands and folds accepted while the entity is in OccupiedState.
      }
    }
  } with {
    briefly "Occupied state"
    described as {
      |A room that is in use by a checked-in guest.
    }
  }
  state CleaningState of record Room.CleaningStateData is {
    initial handler CleaningStateHandler is {
      on completeTurnover: command CompleteTurnover is {
        morph entity ReservationContext.Room to state ReservationContext.Room.AvailableState with record Room.AvailableStateData(roomId = completeTurnover.roomId, stateValue = CleaningStateData.stateValue, roomInfo = CleaningStateData.roomInfo)
        send event Room.TurnoverCompleted(roomId = completeTurnover.roomId) to outlet RoomEvents
      }
      on sendToMaintenance: command SendToMaintenance is {
        morph entity ReservationContext.Room to state ReservationContext.Room.MaintenanceState with record Room.MaintenanceStateData(roomId = sendToMaintenance.roomId, stateValue = CleaningStateData.stateValue, roomInfo = CleaningStateData.roomInfo)
        send event Room.SentToMaintenance(roomId = sendToMaintenance.roomId) to outlet RoomEvents
      }
    } with {
      briefly "While CleaningState"
      described as {
        |The commands and folds accepted while the entity is in CleaningState.
      }
    }
  } with {
    briefly "Cleaning state"
    described as {
      |A room that is vacated and being turned over by housekeeping.
    }
  }
  state MaintenanceState of record Room.MaintenanceStateData is {
    initial handler MaintenanceInitHandler is {
      on query GetRoom is {
        let roomResult: type Room.RoomResult = prompt("read the room from the store")
        reply roomResult
      }
      on other is {
        error "a room out of service cannot be held or occupied until it returns"
      }
      on returnFromMaintenance: command ReturnFromMaintenance is {
        morph entity ReservationContext.Room to state ReservationContext.Room.AvailableState with record Room.AvailableStateData(roomId = returnFromMaintenance.roomId, stateValue = MaintenanceStateData.stateValue, roomInfo = MaintenanceStateData.roomInfo)
        send event Room.ReturnedFromMaintenance(roomId = returnFromMaintenance.roomId) to outlet RoomEvents
      }
    } with {
      briefly "Maintenance init handler"
      described as {
        |Initializes a room on entry to the Maintenance state.
      }
    }
  } with {
    briefly "Maintenance state"
    described as {
      |A room that is out of service for repair.
    }
  }
  handler RoomHandler is {
    on init is {
      morph entity ReservationContext.Room to state ReservationContext.Room.AvailableState with record Room.AvailableStateData(roomId = self.id, stateValue = prompt("the state value of this available state data"), roomInfo = prompt("the room info of this available state data"))
      send event Room.RoomRegistered(roomId = self.id) to outlet RoomEvents
    }
    on query GetRoom is {
      let roomResult: type Room.RoomResult = prompt("read the room from the store")
      reply roomResult
    }
  } with {
    briefly "Room command handler"
    described as {
      |Walks a room around its occupancy cycle: held for a booking, occupied,
      |turned over, and back to sellable -- with a maintenance detour.
    }
  }
} with {
  briefly "A hotel room"
  described as {
    |The physical room, whose occupancy status cycles independently of any one
    |reservation.
  }
}
