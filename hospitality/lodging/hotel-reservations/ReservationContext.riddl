// Hotel Reservations - Reservation Context
context ReservationContext as router is {
  inlet RoomCommandStreamIn is type RoomCommand  outlet RoomCommandStreamOut is type RoomCommand
  inlet ReservationCommandStreamIn is type ReservationCommand  outlet ReservationCommandStreamOut is type ReservationCommand
  inlet ReservationBoardViewStreamIn is type Reservation.ReservationResult  outlet ReservationBoardViewStreamOut is type Reservation.ReservationResult
  handler ReservationContextBoundary is {
    on registerRoom: command Room.RegisterRoom is {
      send registerRoom to outlet ReservationContext.RoomCommandStreamOut
    }
    on holdRoom: command Room.HoldRoom is {
      send holdRoom to outlet ReservationContext.RoomCommandStreamOut
    }
    on occupyRoom: command Room.OccupyRoom is {
      send occupyRoom to outlet ReservationContext.RoomCommandStreamOut
    }
    on vacateRoom: command Room.VacateRoom is {
      send vacateRoom to outlet ReservationContext.RoomCommandStreamOut
    }
    on completeTurnover: command Room.CompleteTurnover is {
      send completeTurnover to outlet ReservationContext.RoomCommandStreamOut
    }
    on sendToMaintenance: command Room.SendToMaintenance is {
      send sendToMaintenance to outlet ReservationContext.RoomCommandStreamOut
    }
    on returnFromMaintenance: command Room.ReturnFromMaintenance is {
      send returnFromMaintenance to outlet ReservationContext.RoomCommandStreamOut
    }
    on createReservation: command Reservation.CreateReservation is {
      send createReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on confirmReservation: command Reservation.ConfirmReservation is {
      send confirmReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on modifyReservation: command Reservation.ModifyReservation is {
      send modifyReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on addSpecialRequest: command Reservation.AddSpecialRequest is {
      send addSpecialRequest to outlet ReservationContext.ReservationCommandStreamOut
    }
    on checkInMsg: command Reservation.CheckIn is {
      send checkInMsg to outlet ReservationContext.ReservationCommandStreamOut
    }
    on postCharge: command Reservation.PostCharge is {
      send postCharge to outlet ReservationContext.ReservationCommandStreamOut
    }
    on checkOutMsg: command Reservation.CheckOut is {
      send checkOutMsg to outlet ReservationContext.ReservationCommandStreamOut
    }
    on cancelReservation: command Reservation.CancelReservation is {
      send cancelReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on markNoShow: command Reservation.MarkNoShow is {
      send markNoShow to outlet ReservationContext.ReservationCommandStreamOut
    }
    on reservationResult: result Reservation.ReservationResult is {
      send reservationResult to outlet ReservationContext.ReservationBoardViewStreamOut
    }
    on other is {
      error "Unexpected message at the ReservationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'RoomEvent Feed' is from outlet ReservationContext.Room.RoomEvents to inlet ReservationContext.HotelAnalytics.HotelAnalyticsFromRoom with {
    briefly "Room events feeding the HotelAnalytics projection"
  }
  connector 'RoomCommand Stream Intake' is from outlet ReservationContext.RoomCommandStreamOut to inlet ReservationContext.Room.RoomCommands  connector 'ReservationCommand Stream Intake' is from outlet ReservationContext.ReservationCommandStreamOut to inlet ReservationContext.Reservation.ReservationCommands  connector 'ReservationBoardView Stream Egress' is from outlet ReservationContext.ReservationRepository.ReservationRepositoryResponses to inlet ReservationContext.ReservationBoardViewStreamIn  adaptor FromChannelManagerService from context ChannelManagerService is { 
    handler FromChannelManagerServiceHandler is {
      on event ChannelManagerService.AvailabilitySynced is {
        do "the model receives availability synced"
      }
      on event ChannelManagerService.RatesSynced is {
        do "the model receives rates synced"
      }
      on other is {
        error "Unexpected message for adaptor FromChannelManagerService"
      }
    } with {
      briefly "from channel manager service"
      described as {
        |Carries messages from the external ChannelManagerService.
      }
    }
  } with {
    briefly "ChannelManagerService integration"
    described as {
      |The model's side of the ChannelManagerService conversation.
    }
  }
  adaptor ToChannelManagerService to context ChannelManagerService is { 
    handler ToChannelManagerServiceHandler is {
      on command ChannelManagerService.SyncAvailability is {
        do "the model sends sync availability"
      }
      on command ChannelManagerService.SyncRates is {
        do "the model sends sync rates"
      }
      on other is {
        error "Unexpected message for adaptor ToChannelManagerService"
      }
    } with {
      briefly "to channel manager service"
      described as {
        |Carries messages to the external ChannelManagerService.
      }
    }
  } with {
    briefly "ChannelManagerService integration"
    described as {
      |The model's side of the ChannelManagerService conversation.
    }
  }
  adaptor FromGuestCommunicationService from context GuestCommunicationService is { 
    handler FromGuestCommunicationServiceHandler is {
      on event GuestCommunicationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event GuestCommunicationService.PreArrivalSent is {
        do "the model receives pre arrival sent"
      }
      on other is {
        error "Unexpected message for adaptor FromGuestCommunicationService"
      }
    } with {
      briefly "from guest communication service"
      described as {
        |Carries messages from the external GuestCommunicationService.
      }
    }
  } with {
    briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor ToGuestCommunicationService to context GuestCommunicationService is { 
    handler ToGuestCommunicationServiceHandler is {
      on command GuestCommunicationService.SendConfirmation is {
        do "the model sends send confirmation"
      }
      on command GuestCommunicationService.SendPreArrivalMessage is {
        do "the model sends send pre arrival message"
      }
      on other is {
        error "Unexpected message for adaptor ToGuestCommunicationService"
      }
    } with {
      briefly "to guest communication service"
      described as {
        |Carries messages to the external GuestCommunicationService.
      }
    }
  } with {
    briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor FromHousekeepingService from context HousekeepingService is { 
    handler FromHousekeepingServiceHandler is {
      on event HousekeepingService.MaintenanceReported is {
        do "the model receives maintenance reported"
      }
      on event HousekeepingService.RoomAssigned is {
        do "the model receives room assigned"
      }
      on event HousekeepingService.RoomCleaned is {
        do "the model receives room cleaned"
      }
      on other is {
        error "Unexpected message for adaptor FromHousekeepingService"
      }
    } with {
      briefly "from housekeeping service"
      described as {
        |Carries messages from the external HousekeepingService.
      }
    }
  } with {
    briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor ToHousekeepingService to context HousekeepingService is { 
    handler ToHousekeepingServiceHandler is {
      on command HousekeepingService.AssignRoom is {
        do "the model sends assign room"
      }
      on command HousekeepingService.MarkRoomClean is {
        do "the model sends mark room clean"
      }
      on command HousekeepingService.ReportMaintenance is {
        do "the model sends report maintenance"
      }
      on other is {
        error "Unexpected message for adaptor ToHousekeepingService"
      }
    } with {
      briefly "to housekeeping service"
      described as {
        |Carries messages to the external HousekeepingService.
      }
    }
  } with {
    briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor FromLoyaltyProgramService from context LoyaltyProgramService is { 
    handler FromLoyaltyProgramServiceHandler is {
      on result LoyaltyProgramService.MemberStatus is {
        do "the model receives member status"
      }
      on event LoyaltyProgramService.PointsAccrued is {
        do "the model receives points accrued"
      }
      on event LoyaltyProgramService.PointsRedeemed is {
        do "the model receives points redeemed"
      }
      on other is {
        error "Unexpected message for adaptor FromLoyaltyProgramService"
      }
    } with {
      briefly "from loyalty program service"
      described as {
        |Carries messages from the external LoyaltyProgramService.
      }
    }
  } with {
    briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor ToLoyaltyProgramService to context LoyaltyProgramService is { 
    handler ToLoyaltyProgramServiceHandler is {
      on command LoyaltyProgramService.AccruePoints is {
        do "the model sends accrue points"
      }
      on query LoyaltyProgramService.GetMemberStatus is {
        do "the model sends get member status"
      }
      on command LoyaltyProgramService.RedeemPoints is {
        do "the model sends redeem points"
      }
      on other is {
        error "Unexpected message for adaptor ToLoyaltyProgramService"
      }
    } with {
      briefly "to loyalty program service"
      described as {
        |Carries messages to the external LoyaltyProgramService.
      }
    }
  } with {
    briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor FromPaymentGatewayService from context PaymentGatewayService is { 
    handler FromPaymentGatewayServiceHandler is {
      on event PaymentGatewayService.PaymentAuthorized is {
        do "the model receives payment authorized"
      }
      on event PaymentGatewayService.PaymentCaptured is {
        do "the model receives payment captured"
      }
      on event PaymentGatewayService.PaymentRefunded is {
        do "the model receives payment refunded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGatewayService"
      }
    } with {
      briefly "from payment gateway service"
      described as {
        |Carries messages from the external PaymentGatewayService.
      }
    }
  } with {
    briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  adaptor ToPaymentGatewayService to context PaymentGatewayService is { 
    handler ToPaymentGatewayServiceHandler is {
      on command PaymentGatewayService.AuthorizePayment is {
        do "the model sends authorize payment"
      }
      on command PaymentGatewayService.CapturePayment is {
        do "the model sends capture payment"
      }
      on command PaymentGatewayService.RefundPayment is {
        do "the model sends refund payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGatewayService"
      }
    } with {
      briefly "to payment gateway service"
      described as {
        |Carries messages to the external PaymentGatewayService.
      }
    }
  } with {
    briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  include "types.riddl"
  include "Reservation.riddl"
  include "Room.riddl"
  // Repository for reservation persistence
  type ReservationRepositoryCommand is one of {
    ReservationContext.ReservationRepository.PersistChargePosted or ReservationContext.ReservationRepository.PersistGuestCheckedIn or ReservationContext.ReservationRepository.PersistGuestCheckedOut or ReservationContext.ReservationRepository.PersistNoShowRecorded or ReservationContext.ReservationRepository.PersistReservationCancelled or ReservationContext.ReservationRepository.PersistReservationConfirmed or ReservationContext.ReservationRepository.PersistReservationCreated or ReservationContext.ReservationRepository.PersistReservationModified or ReservationContext.ReservationRepository.PersistSpecialRequestAdded or ReservationContext.ReservationRepository.PersistRoomRegistered or ReservationContext.ReservationRepository.PersistRoomHeld or ReservationContext.ReservationRepository.PersistRoomOccupied or ReservationContext.ReservationRepository.PersistRoomVacated or ReservationContext.ReservationRepository.PersistTurnoverCompleted or ReservationContext.ReservationRepository.PersistSentToMaintenance or ReservationContext.ReservationRepository.PersistReturnedFromMaintenance
  } with {
    briefly "Anything that writes ReservationRepository"
    described as {
      |The persistence commands ReservationRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ReservationRepository as flow is {
    command PersistRoomRegistered is  {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomRegistered applies to.
        }
      }
    } with {
      briefly "Persist RoomRegistered"
      described as {
        |Instructs this repository to apply RoomRegistered to the stored row.
      }
    }
    command PersistRoomHeld is  {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomHeld applies to.
        }
      }
    } with {
      briefly "Persist RoomHeld"
      described as {
        |Instructs this repository to apply RoomHeld to the stored row.
      }
    }
    command PersistRoomOccupied is  {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomOccupied applies to.
        }
      }
    } with {
      briefly "Persist RoomOccupied"
      described as {
        |Instructs this repository to apply RoomOccupied to the stored row.
      }
    }
    command PersistRoomVacated is  {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomVacated applies to.
        }
      }
    } with {
      briefly "Persist RoomVacated"
      described as {
        |Instructs this repository to apply RoomVacated to the stored row.
      }
    }
    command PersistTurnoverCompleted is  {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row TurnoverCompleted applies to.
        }
      }
    } with {
      briefly "Persist TurnoverCompleted"
      described as {
        |Instructs this repository to apply TurnoverCompleted to the stored row.
      }
    }
    command PersistSentToMaintenance is  {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row SentToMaintenance applies to.
        }
      }
    } with {
      briefly "Persist SentToMaintenance"
      described as {
        |Instructs this repository to apply SentToMaintenance to the stored row.
      }
    }
    command PersistReturnedFromMaintenance is  {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReturnedFromMaintenance applies to.
        }
      }
    } with {
      briefly "Persist ReturnedFromMaintenance"
      described as {
        |Instructs this repository to apply ReturnedFromMaintenance to the stored row.
      }
    }
    inlet ReservationRepositoryFromHotelAnalytics is type ReservationRepositoryCommand
    command PersistChargePosted is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChargePosted applies to.
        }
      }
    } with {
      briefly "Persist ChargePosted"
      described as {
        |Instructs this repository to apply ChargePosted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNoShowRecorded is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row NoShowRecorded applies to.
        }
      }
    } with {
      briefly "Persist NoShowRecorded"
      described as {
        |Instructs this repository to apply NoShowRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationConfirmed is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationConfirmed applies to.
        }
      }
    } with {
      briefly "Persist ReservationConfirmed"
      described as {
        |Instructs this repository to apply ReservationConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationModified is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationModified applies to.
        }
      }
    } with {
      briefly "Persist ReservationModified"
      described as {
        |Instructs this repository to apply ReservationModified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSpecialRequestAdded is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SpecialRequestAdded applies to.
        }
      }
    } with {
      briefly "Persist SpecialRequestAdded"
      described as {
        |Instructs this repository to apply SpecialRequestAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGuestCheckedIn is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row GuestCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist GuestCheckedIn"
      described as {
        |Instructs this repository to apply GuestCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGuestCheckedOut is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row GuestCheckedOut applies to.
        }
      }
    } with {
      briefly "Persist GuestCheckedOut"
      described as {
        |Instructs this repository to apply GuestCheckedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCancelled is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationCancelled applies to.
        }
      }
    } with {
      briefly "Persist ReservationCancelled"
      described as {
        |Instructs this repository to apply ReservationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCreated is  {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationCreated applies to.
        }
      }
    } with {
      briefly "Persist ReservationCreated"
      described as {
        |Instructs this repository to apply ReservationCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ReservationRepositoryResponses is type Reservation.ReservationResult
    record StoredReservation is  {
      reservationId: ReservationId with {
        briefly "reservationId"
        described as {
          |The reservationId column of the stored reservation row.
        }
      }
      dates: StayDates with {
        briefly "dates"
        described as {
          |The dates column of the stored reservation row.
        }
      }
      guest: GuestInfo with {
        briefly "guest"
        described as {
          |The guest column of the stored reservation row.
        }
      }
    } with {
      briefly "Stored reservation row"
      described as {
        |The persistence shape of reservation data as this repository stores it.
      }
    }
    schema ReservationData is relational
      of reservations as type StoredReservation
        index on field StoredReservation.reservationId
        index on field StoredReservation.guest.guestId
        index on field StoredReservation.dates.checkIn
 with {
      briefly "Reservation data schema"
      described as {
        |The relational schema holding reservation data for the ReservationRepository.
      }
    }
    handler ReservationPersistence is {
      on command ReservationRepository.PersistRoomRegistered is {
        do "apply RoomRegistered to the stored row"
      }
      on command ReservationRepository.PersistRoomHeld is {
        do "apply RoomHeld to the stored row"
      }
      on command ReservationRepository.PersistRoomOccupied is {
        do "apply RoomOccupied to the stored row"
      }
      on command ReservationRepository.PersistRoomVacated is {
        do "apply RoomVacated to the stored row"
      }
      on command ReservationRepository.PersistTurnoverCompleted is {
        do "apply TurnoverCompleted to the stored row"
      }
      on command ReservationRepository.PersistSentToMaintenance is {
        do "apply SentToMaintenance to the stored row"
      }
      on command ReservationRepository.PersistReturnedFromMaintenance is {
        do "apply ReturnedFromMaintenance to the stored row"
      }
      on persistChargePosted: command PersistChargePosted is {
        do "apply ChargePosted to the stored row"
      }
      on persistNoShowRecorded: command PersistNoShowRecorded is {
        do "apply NoShowRecorded to the stored row"
      }
      on persistReservationConfirmed: command PersistReservationConfirmed is {
        do "apply ReservationConfirmed to the stored row"
      }
      on persistReservationModified: command PersistReservationModified is {
        do "apply ReservationModified to the stored row"
      }
      on persistSpecialRequestAdded: command PersistSpecialRequestAdded is {
        do "apply SpecialRequestAdded to the stored row"
      }
      on persistGuestCheckedIn: command PersistGuestCheckedIn is {
        do "apply GuestCheckedIn to the stored row"
      }
      on persistGuestCheckedOut: command PersistGuestCheckedOut is {
        do "apply GuestCheckedOut to the stored row"
      }
      on persistReservationCancelled: command PersistReservationCancelled is {
        do "apply ReservationCancelled to the stored row"
      }
      on persistReservationCreated: command PersistReservationCreated is {
        do "apply ReservationCreated to the stored row"
      }
      on query GetHotelStats is {
        let hotelStatsView: type HotelStatsView = prompt("read the hotel stats projection")
        reply hotelStatsView
      }
    } with {
      briefly "Persists reservation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reservation data persistence"
    described as {
      | The ReservationRepository provides persistent storage for
      | reservations, folios, and guest history.
    }
  }
  // Projector for hotel analytics
  query GetHotelStats replies result HotelStatsView is  {
    hotelStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which hotel stats to retrieve.
      }
    }
  } with {
    briefly "Get hotel stats"
    described as {
      |Retrieves the hotel stats projection.
    }
  }
  result HotelStatsView is  {
    hotelStats: HotelAnalytics.HotelStats with {
      briefly "Hotel stats"
      described as {
        |The hotel stats being returned.
      }
    }
  } with {
    briefly "Hotel stats view"
    described as {
      |Read model view carrying the hotel stats projection.
    }
  }
  projector HotelAnalytics as merge is {
    inlet HotelAnalyticsFromRoom is type RoomEvent
    outlet HotelAnalyticsToRepository is type ReservationRepositoryCommand
    updates repository ReservationContext.ReservationRepository
    inlet HotelAnalyticsFromReservation is type ReservationEvent
    record HotelStats is  {
      occupancyRate: Decimal(5,4) with {
        briefly "Occupancy"
        described as {
          |Occupancy rate.
        }
      }
      adr: Decimal(10,2) with {
        briefly "ADR"
        described as {
          |Average daily rate.
        }
      }
      revPar: Decimal(10,2) with {
        briefly "RevPAR"
        described as {
          |Revenue per available room.
        }
      }
      arrivalsToday: Natural with {
        briefly "Arrivals"
        described as {
          |Arrivals today.
        }
      }
      departuresToday: Natural with {
        briefly "Departures"
        described as {
          |Departures today.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Cancellation rate"
        described as {
          |Cancellation rate.
        }
      }
    } with {
      briefly "Hotel statistics"
      described as {
        |Hotel performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on roomRegistered: event Room.RoomRegistered is {
        tell command ReservationContext.ReservationRepository.PersistRoomRegistered(roomId = roomRegistered.roomId) to repository ReservationContext.ReservationRepository
      }
      on roomHeld: event Room.RoomHeld is {
        tell command ReservationContext.ReservationRepository.PersistRoomHeld(roomId = roomHeld.roomId) to repository ReservationContext.ReservationRepository
      }
      on roomOccupied: event Room.RoomOccupied is {
        tell command ReservationContext.ReservationRepository.PersistRoomOccupied(roomId = roomOccupied.roomId) to repository ReservationContext.ReservationRepository
      }
      on roomVacated: event Room.RoomVacated is {
        tell command ReservationContext.ReservationRepository.PersistRoomVacated(roomId = roomVacated.roomId) to repository ReservationContext.ReservationRepository
      }
      on turnoverCompleted: event Room.TurnoverCompleted is {
        tell command ReservationContext.ReservationRepository.PersistTurnoverCompleted(roomId = turnoverCompleted.roomId) to repository ReservationContext.ReservationRepository
      }
      on sentToMaintenance: event Room.SentToMaintenance is {
        tell command ReservationContext.ReservationRepository.PersistSentToMaintenance(roomId = sentToMaintenance.roomId) to repository ReservationContext.ReservationRepository
      }
      on returnedFromMaintenance: event Room.ReturnedFromMaintenance is {
        tell command ReservationContext.ReservationRepository.PersistReturnedFromMaintenance(roomId = returnedFromMaintenance.roomId) to repository ReservationContext.ReservationRepository
      }
      on chargePosted: event Reservation.ChargePosted is {
        tell command ReservationContext.ReservationRepository.PersistChargePosted(reservationId = chargePosted.reservationId) to repository ReservationContext.ReservationRepository
        do "apply ChargePosted to the HotelAnalytics projection"
      }
      on noShowRecorded: event Reservation.NoShowRecorded is {
        tell command ReservationContext.ReservationRepository.PersistNoShowRecorded(reservationId = noShowRecorded.reservationId) to repository ReservationContext.ReservationRepository
        do "apply NoShowRecorded to the HotelAnalytics projection"
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        tell command ReservationContext.ReservationRepository.PersistReservationConfirmed(reservationId = reservationConfirmed.reservationId) to repository ReservationContext.ReservationRepository
        do "apply ReservationConfirmed to the HotelAnalytics projection"
      }
      on reservationModified: event Reservation.ReservationModified is {
        tell command ReservationContext.ReservationRepository.PersistReservationModified(reservationId = reservationModified.reservationId) to repository ReservationContext.ReservationRepository
        do "apply ReservationModified to the HotelAnalytics projection"
      }
      on specialRequestAdded: event Reservation.SpecialRequestAdded is {
        tell command ReservationContext.ReservationRepository.PersistSpecialRequestAdded(reservationId = specialRequestAdded.reservationId) to repository ReservationContext.ReservationRepository
        do "apply SpecialRequestAdded to the HotelAnalytics projection"
      }
      on reservationCreated: event Reservation.ReservationCreated is {
        tell command ReservationContext.ReservationRepository.PersistReservationCreated(reservationId = reservationCreated.reservationId) to repository ReservationContext.ReservationRepository
        do "Update booking metrics"
      }
      on guestCheckedIn: event Reservation.GuestCheckedIn is {
        tell command ReservationContext.ReservationRepository.PersistGuestCheckedIn(reservationId = guestCheckedIn.reservationId) to repository ReservationContext.ReservationRepository
        do "Update occupancy metrics"
      }
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        tell command ReservationContext.ReservationRepository.PersistGuestCheckedOut(reservationId = guestCheckedOut.reservationId) to repository ReservationContext.ReservationRepository
        do "Update revenue metrics"
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        tell command ReservationContext.ReservationRepository.PersistReservationCancelled(reservationId = reservationCancelled.reservationId) to repository ReservationContext.ReservationRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains hotel analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Hotel analytics projections"
    described as {
      |Maintains hotel performance analytics data.
    }
  }
  // ---- Event publication for Reservation ----
  type ReservationEvent is one of {
    ReservationContext.Reservation.ReservationCreated or ReservationContext.Reservation.ReservationConfirmed or ReservationContext.Reservation.ReservationModified or ReservationContext.Reservation.SpecialRequestAdded or ReservationContext.Reservation.GuestCheckedIn or ReservationContext.Reservation.ChargePosted or ReservationContext.Reservation.GuestCheckedOut or ReservationContext.Reservation.ReservationCancelled or ReservationContext.Reservation.NoShowRecorded
  } with {
    briefly "Reservation event alternation"
    described as {
      |Union of all Reservation events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReservationEventSplit as flow is {
    inlet ReservationEventSplitIn is type ReservationEvent
    outlet ReservationEventSplitToHotelAnalytics is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on reservationCreated: event Reservation.ReservationCreated is {
        send reservationCreated to outlet ReservationEventSplitToHotelAnalytics
        tell reservationCreated to entity ReservationContext.Reservation
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        send reservationConfirmed to outlet ReservationEventSplitToHotelAnalytics
        tell reservationConfirmed to entity ReservationContext.Reservation
      }
      on reservationModified: event Reservation.ReservationModified is {
        send reservationModified to outlet ReservationEventSplitToHotelAnalytics
        tell reservationModified to entity ReservationContext.Reservation
      }
      on specialRequestAdded: event Reservation.SpecialRequestAdded is {
        send specialRequestAdded to outlet ReservationEventSplitToHotelAnalytics
        tell specialRequestAdded to entity ReservationContext.Reservation
      }
      on guestCheckedIn: event Reservation.GuestCheckedIn is {
        send guestCheckedIn to outlet ReservationEventSplitToHotelAnalytics
        tell guestCheckedIn to entity ReservationContext.Reservation
      }
      on chargePosted: event Reservation.ChargePosted is {
        send chargePosted to outlet ReservationEventSplitToHotelAnalytics
        tell chargePosted to entity ReservationContext.Reservation
      }
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        send guestCheckedOut to outlet ReservationEventSplitToHotelAnalytics
        tell guestCheckedOut to entity ReservationContext.Reservation
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        send reservationCancelled to outlet ReservationEventSplitToHotelAnalytics
        tell reservationCancelled to entity ReservationContext.Reservation
      }
      on noShowRecorded: event Reservation.NoShowRecorded is {
        send noShowRecorded to outlet ReservationEventSplitToHotelAnalytics
        tell noShowRecorded to entity ReservationContext.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  connector 'ReservationEvent Stream' is from outlet ReservationContext.Reservation.ReservationEvents2 to inlet ReservationContext.ReservationEventSplit.ReservationEventSplitIn with {
    briefly "Reservation events, fanned out to storage and read models"
  }
  connector 'HotelAnalytics Feed' is from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToHotelAnalytics to inlet ReservationContext.HotelAnalytics.HotelAnalyticsFromReservation with {
    briefly "Reservation events feeding the HotelAnalytics projection"
  }
  connector 'HotelAnalytics Storage' is from outlet ReservationContext.HotelAnalytics.HotelAnalyticsToRepository to inlet ReservationContext.ReservationRepository.ReservationRepositoryFromHotelAnalytics with {
    briefly "HotelAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for hotel reservations"
  described as {
    | The ReservationContext is the bounded context for
    | hotel booking and guest management.
  }
}
