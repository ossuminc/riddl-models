// Hotel Reservations - Reservation Context
context ReservationContext is {
  adaptor FromChannelManagerService from context ChannelManagerService is {
    handler FromChannelManagerServiceHandler is {
      on event ChannelManagerService.AvailabilitySynced is {
        do "the model receives availability synced"
      }
      on event ChannelManagerService.RatesSynced is {
        do "the model receives rates synced"
      }
      on other is {
        error "Unexpected message for adaptor FromChannelManagerService"
      }
    } with {
      briefly "from channel manager service"
      described as {
        |Carries messages from the external ChannelManagerService.
      }
    }
  } with {
      briefly "ChannelManagerService integration"
    described as {
      |The model's side of the ChannelManagerService conversation.
    }
  }
  adaptor ToChannelManagerService to context ChannelManagerService is {
    handler ToChannelManagerServiceHandler is {
      on command ChannelManagerService.SyncAvailability is {
        do "the model sends sync availability"
      }
      on command ChannelManagerService.SyncRates is {
        do "the model sends sync rates"
      }
      on other is {
        error "Unexpected message for adaptor ToChannelManagerService"
      }
    } with {
      briefly "to channel manager service"
      described as {
        |Carries messages to the external ChannelManagerService.
      }
    }
  } with {
      briefly "ChannelManagerService integration"
    described as {
      |The model's side of the ChannelManagerService conversation.
    }
  }
  adaptor FromGuestCommunicationService from context GuestCommunicationService is {
    handler FromGuestCommunicationServiceHandler is {
      on event GuestCommunicationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event GuestCommunicationService.PreArrivalSent is {
        do "the model receives pre arrival sent"
      }
      on other is {
        error "Unexpected message for adaptor FromGuestCommunicationService"
      }
    } with {
      briefly "from guest communication service"
      described as {
        |Carries messages from the external GuestCommunicationService.
      }
    }
  } with {
      briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor ToGuestCommunicationService to context GuestCommunicationService is {
    handler ToGuestCommunicationServiceHandler is {
      on command GuestCommunicationService.SendConfirmation is {
        do "the model sends send confirmation"
      }
      on command GuestCommunicationService.SendPreArrivalMessage is {
        do "the model sends send pre arrival message"
      }
      on other is {
        error "Unexpected message for adaptor ToGuestCommunicationService"
      }
    } with {
      briefly "to guest communication service"
      described as {
        |Carries messages to the external GuestCommunicationService.
      }
    }
  } with {
      briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor FromHousekeepingService from context HousekeepingService is {
    handler FromHousekeepingServiceHandler is {
      on event HousekeepingService.MaintenanceReported is {
        do "the model receives maintenance reported"
      }
      on event HousekeepingService.RoomAssigned is {
        do "the model receives room assigned"
      }
      on event HousekeepingService.RoomCleaned is {
        do "the model receives room cleaned"
      }
      on other is {
        error "Unexpected message for adaptor FromHousekeepingService"
      }
    } with {
      briefly "from housekeeping service"
      described as {
        |Carries messages from the external HousekeepingService.
      }
    }
  } with {
      briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor ToHousekeepingService to context HousekeepingService is {
    handler ToHousekeepingServiceHandler is {
      on command HousekeepingService.AssignRoom is {
        do "the model sends assign room"
      }
      on command HousekeepingService.MarkRoomClean is {
        do "the model sends mark room clean"
      }
      on command HousekeepingService.ReportMaintenance is {
        do "the model sends report maintenance"
      }
      on other is {
        error "Unexpected message for adaptor ToHousekeepingService"
      }
    } with {
      briefly "to housekeeping service"
      described as {
        |Carries messages to the external HousekeepingService.
      }
    }
  } with {
      briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor FromLoyaltyProgramService from context LoyaltyProgramService is {
    handler FromLoyaltyProgramServiceHandler is {
      on result LoyaltyProgramService.MemberStatus is {
        do "the model receives member status"
      }
      on event LoyaltyProgramService.PointsAccrued is {
        do "the model receives points accrued"
      }
      on event LoyaltyProgramService.PointsRedeemed is {
        do "the model receives points redeemed"
      }
      on other is {
        error "Unexpected message for adaptor FromLoyaltyProgramService"
      }
    } with {
      briefly "from loyalty program service"
      described as {
        |Carries messages from the external LoyaltyProgramService.
      }
    }
  } with {
      briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor ToLoyaltyProgramService to context LoyaltyProgramService is {
    handler ToLoyaltyProgramServiceHandler is {
      on command LoyaltyProgramService.AccruePoints is {
        do "the model sends accrue points"
      }
      on query LoyaltyProgramService.GetMemberStatus is {
        do "the model sends get member status"
      }
      on command LoyaltyProgramService.RedeemPoints is {
        do "the model sends redeem points"
      }
      on other is {
        error "Unexpected message for adaptor ToLoyaltyProgramService"
      }
    } with {
      briefly "to loyalty program service"
      described as {
        |Carries messages to the external LoyaltyProgramService.
      }
    }
  } with {
      briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor FromPaymentGatewayService from context PaymentGatewayService is {
    handler FromPaymentGatewayServiceHandler is {
      on event PaymentGatewayService.PaymentAuthorized is {
        do "the model receives payment authorized"
      }
      on event PaymentGatewayService.PaymentCaptured is {
        do "the model receives payment captured"
      }
      on event PaymentGatewayService.PaymentRefunded is {
        do "the model receives payment refunded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentGatewayService"
      }
    } with {
      briefly "from payment gateway service"
      described as {
        |Carries messages from the external PaymentGatewayService.
      }
    }
  } with {
      briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  adaptor ToPaymentGatewayService to context PaymentGatewayService is {
    handler ToPaymentGatewayServiceHandler is {
      on command PaymentGatewayService.AuthorizePayment is {
        do "the model sends authorize payment"
      }
      on command PaymentGatewayService.CapturePayment is {
        do "the model sends capture payment"
      }
      on command PaymentGatewayService.RefundPayment is {
        do "the model sends refund payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGatewayService"
      }
    } with {
      briefly "to payment gateway service"
      described as {
        |Carries messages to the external PaymentGatewayService.
      }
    }
  } with {
      briefly "PaymentGatewayService integration"
    described as {
      |The model's side of the PaymentGatewayService conversation.
    }
  }
  include "types.riddl"
  include "Reservation.riddl"
  // Repository for reservation persistence
  repository ReservationRepository is {
    inlet ReservationRepositoryFromReservation is type ReservationEvent
    inlet ReservationRepositoryFromHotelAnalytics is type ReservationEvent
    outlet ReservationRepositoryResponses is type Reservation.ReservationResult
    record StoredReservation is {
      reservationId: ReservationId with {
        briefly "reservationId"
        described as {
          |The reservationId column of the stored reservation row.
        }
      }
      dates: StayDates with {
        briefly "dates"
        described as {
          |The dates column of the stored reservation row.
        }
      }
      guest: GuestInfo with {
        briefly "guest"
        described as {
          |The guest column of the stored reservation row.
        }
      }
    } with {
      briefly "Stored reservation row"
      described as {
        |The persistence shape of reservation data as this repository stores it.
      }
    }
    schema ReservationData is relational
      of reservations as type StoredReservation
        index on field StoredReservation.reservationId
        index on field StoredReservation.guest.guestId
        index on field StoredReservation.dates.checkIn
      with {
      briefly "Reservation data schema"
      described as {
        |The relational schema holding reservation data for the ReservationRepository.
      }
    }

    handler ReservationPersistence is {
      on query GetHotelStats is {
        do "read the hotel stats projection"
        yield result HotelStatsView
      }
      on command Reservation.CreateReservation is {
        tell event Reservation.ReservationCreated to entity ReservationContext.Reservation
        do "Store new reservation"
      }
      on command Reservation.ConfirmReservation is {
        tell event Reservation.ReservationConfirmed to entity ReservationContext.Reservation
        do "Update to confirmed"
      }
      on command Reservation.ModifyReservation is {
        do "Update reservation details"
      }
      on command Reservation.AddSpecialRequest is {
        tell event Reservation.SpecialRequestAdded to entity ReservationContext.Reservation
        do "Store special request"
      }
      on command Reservation.CheckIn is {
        do "Update to checked in"
      }
      on command Reservation.PostCharge is {
        do "Store folio item"
      }
      on command Reservation.CheckOut is {
        do "Update to checked out"
      }
      on command Reservation.CancelReservation is {
        tell event Reservation.ReservationCancelled to entity ReservationContext.Reservation
        do "Update to cancelled"
      }
      on command Reservation.MarkNoShow is {
        do "Update to no-show"
      }
    } with {
      briefly "Persists reservation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reservation data persistence"
    described as {
      | The ReservationRepository provides persistent storage for
      | reservations, folios, and guest history.
    }
  }
  // Projector for hotel analytics
  query GetHotelStats is {
    hotelStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which hotel stats to retrieve.
      }
    }
  } with {
    briefly "Get hotel stats"
    described as {
      |Retrieves the hotel stats projection.
    }
  }
  result HotelStatsView is {
    hotelStats: HotelAnalytics.HotelStats with {
      briefly "Hotel stats"
      described as {
        |The hotel stats being returned.
      }
    }
  } with {
    briefly "Hotel stats view"
    described as {
      |Read model view carrying the hotel stats projection.
    }
  }
  projector HotelAnalytics is {
    inlet HotelAnalyticsFromReservation is type ReservationEvent
    outlet HotelAnalyticsOut is type ReservationEvent
    updates repository ReservationContext.ReservationRepository
    record HotelStats is  {
      occupancyRate: Decimal(5,4) with {
        briefly "Occupancy"
        described as {
          |Occupancy rate.
        }
      }
      adr: Decimal(10,2) with {
        briefly "ADR"
        described as {
          |Average daily rate.
        }
      }
      revPar: Decimal(10,2) with {
        briefly "RevPAR"
        described as {
          |Revenue per available room.
        }
      }
      arrivalsToday: Natural with {
        briefly "Arrivals"
        described as {
          |Arrivals today.
        }
      }
      departuresToday: Natural with {
        briefly "Departures"
        described as {
          |Departures today.
        }
      }
      cancellationRate: Decimal(5,4) with {
        briefly "Cancellation rate"
        described as {
          |Cancellation rate.
        }
      }
    } with {
      briefly "Hotel statistics"
      described as {
        |Hotel performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Reservation.ReservationCreated is {
        tell event Reservation.ReservationCreated to repository ReservationContext.ReservationRepository
        do "Update booking metrics"
      }
      on event Reservation.GuestCheckedIn is {
        tell event Reservation.GuestCheckedIn to repository ReservationContext.ReservationRepository
        do "Update occupancy metrics"
      }
      on event Reservation.GuestCheckedOut is {
        tell event Reservation.GuestCheckedOut to repository ReservationContext.ReservationRepository
        do "Update revenue metrics"
      }
      on event Reservation.ReservationCancelled is {
        tell event Reservation.ReservationCancelled to repository ReservationContext.ReservationRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains hotel analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Hotel analytics projections"
    described as {
      |Maintains hotel performance analytics data.
    }
  }
  // ---- Event publication for Reservation ----
  type ReservationEvent is one of {
    ReservationContext.Reservation.ReservationCreated,
    ReservationContext.Reservation.ReservationConfirmed,
    ReservationContext.Reservation.ReservationModified,
    ReservationContext.Reservation.SpecialRequestAdded,
    ReservationContext.Reservation.GuestCheckedIn,
    ReservationContext.Reservation.ChargePosted,
    ReservationContext.Reservation.GuestCheckedOut,
    ReservationContext.Reservation.ReservationCancelled,
    ReservationContext.Reservation.NoShowRecorded
  } with {
    briefly "Reservation event alternation"
    described as {
      |Union of all Reservation events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReservationEventSource as source is {
    outlet ReservationEvents is type ReservationEvent
    handler ReservationSourceHandler is {
      on event Reservation.ReservationCreated is {
        send event Reservation.ReservationCreated to outlet ReservationEvents
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEvents
      }
      on event Reservation.ReservationModified is {
        send event Reservation.ReservationModified to outlet ReservationEvents
      }
      on event Reservation.SpecialRequestAdded is {
        send event Reservation.SpecialRequestAdded to outlet ReservationEvents
      }
      on event Reservation.GuestCheckedIn is {
        send event Reservation.GuestCheckedIn to outlet ReservationEvents
      }
      on event Reservation.ChargePosted is {
        send event Reservation.ChargePosted to outlet ReservationEvents
      }
      on event Reservation.GuestCheckedOut is {
        send event Reservation.GuestCheckedOut to outlet ReservationEvents
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEvents
      }
      on event Reservation.NoShowRecorded is {
        send event Reservation.NoShowRecorded to outlet ReservationEvents
      }
      on other is {
        error "Unexpected message for source ReservationEventSource"
      }
    } with {
      briefly "Reservation source handler"
      described as {
        |Publishes Reservation events onto the outlet.
      }
    }
  } with {
    briefly "Reservation event source"
    described as {
      |Publishes Reservation entity events into the streaming topology.
    }
  }
  processor ReservationEventSink as sink is {
    inlet ReservationInlet is type ReservationEvent
    handler ReservationSinkHandler is {
      on event Reservation.ReservationCreated is {
        tell event Reservation.ReservationCreated to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationConfirmed is {
        tell event Reservation.ReservationConfirmed to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationModified is {
        tell event Reservation.ReservationModified to repository ReservationContext.ReservationRepository
      }
      on event Reservation.SpecialRequestAdded is {
        tell event Reservation.SpecialRequestAdded to repository ReservationContext.ReservationRepository
      }
      on event Reservation.GuestCheckedIn is {
        tell event Reservation.GuestCheckedIn to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ChargePosted is {
        tell event Reservation.ChargePosted to repository ReservationContext.ReservationRepository
      }
      on event Reservation.GuestCheckedOut is {
        tell event Reservation.GuestCheckedOut to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationCancelled is {
        tell event Reservation.ReservationCancelled to repository ReservationContext.ReservationRepository
      }
      on event Reservation.NoShowRecorded is {
        tell event Reservation.NoShowRecorded to repository ReservationContext.ReservationRepository
      }
      on other is {
        error "Unexpected message for sink ReservationEventSink"
      }
    } with {
      briefly "Reservation sink handler"
      described as {
        |Persists Reservation events via the repository.
      }
    }
  } with {
    briefly "Reservation event sink"
    described as {
      |Receives Reservation events for persistence.
    }
  }
  connector ReservationEventFlow is {
    from outlet ReservationContext.ReservationEventSource.ReservationEvents to
      inlet ReservationContext.ReservationEventSink.ReservationInlet
  } with {
    briefly "Reservation event flow"
    described as {
      |Connects the Reservation source to its sink.
    }
  }
  processor ReservationEventSplit is {
    inlet ReservationEventSplitIn is type ReservationEvent
    outlet ReservationEventSplitToReservationRepository is type ReservationEvent
    outlet ReservationEventSplitToHotelAnalytics is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on event Reservation.ReservationCreated is {
        send event Reservation.ReservationCreated to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationCreated to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.ReservationCreated to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.ReservationConfirmed to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationModified is {
        send event Reservation.ReservationModified to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationModified to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.ReservationModified to entity ReservationContext.Reservation
      }
      on event Reservation.SpecialRequestAdded is {
        send event Reservation.SpecialRequestAdded to outlet ReservationEventSplitToReservationRepository
        send event Reservation.SpecialRequestAdded to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.SpecialRequestAdded to entity ReservationContext.Reservation
      }
      on event Reservation.GuestCheckedIn is {
        send event Reservation.GuestCheckedIn to outlet ReservationEventSplitToReservationRepository
        send event Reservation.GuestCheckedIn to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.GuestCheckedIn to entity ReservationContext.Reservation
      }
      on event Reservation.ChargePosted is {
        send event Reservation.ChargePosted to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ChargePosted to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.ChargePosted to entity ReservationContext.Reservation
      }
      on event Reservation.GuestCheckedOut is {
        send event Reservation.GuestCheckedOut to outlet ReservationEventSplitToReservationRepository
        send event Reservation.GuestCheckedOut to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.GuestCheckedOut to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.ReservationCancelled to entity ReservationContext.Reservation
      }
      on event Reservation.NoShowRecorded is {
        send event Reservation.NoShowRecorded to outlet ReservationEventSplitToReservationRepository
        send event Reservation.NoShowRecorded to outlet ReservationEventSplitToHotelAnalytics
        tell event Reservation.NoShowRecorded to entity ReservationContext.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  connector LinkReservationToReservationEventSplit is {
    from outlet ReservationContext.Reservation.ReservationEvents2 to
      inlet ReservationContext.ReservationEventSplit.ReservationEventSplitIn
  } with {
    briefly "LinkReservationToReservationEventSplit"
  }
  connector LinkReservationEventSplitToReservationRepository is {
    from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToReservationRepository to
      inlet ReservationContext.ReservationRepository.ReservationRepositoryFromReservation
  } with {
    briefly "LinkReservationEventSplitToReservationRepository"
  }
  connector LinkReservationEventSplitToHotelAnalytics is {
    from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToHotelAnalytics to
      inlet ReservationContext.HotelAnalytics.HotelAnalyticsFromReservation
  } with {
    briefly "LinkReservationEventSplitToHotelAnalytics"
  }
  connector LinkHotelAnalyticsToReservationRepository is {
    from outlet ReservationContext.HotelAnalytics.HotelAnalyticsOut to
      inlet ReservationContext.ReservationRepository.ReservationRepositoryFromHotelAnalytics
  } with {
    briefly "LinkHotelAnalyticsToReservationRepository"
  }
} with {
  briefly "Bounded context for hotel reservations"
  described as {
    | The ReservationContext is the bounded context for
    | hotel booking and guest management.
  }
}
