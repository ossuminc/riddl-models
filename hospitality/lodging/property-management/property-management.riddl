// Property Management Domain Model
// Hotel property and room inventory management
domain PropertyManagement is {
  persistent connector 'StaffSchedulingServiceReply Stream' is from outlet StaffSchedulingService.StaffSchedulingServiceRepliesOut to inlet RoomContext.ToStaffSchedulingService.ToStaffSchedulingServiceReplies with {
    briefly "What StaffSchedulingService answers RoomContext"
  }
  persistent connector 'MaintenanceManagementServiceReply Stream' is from outlet MaintenanceManagementService.MaintenanceManagementServiceRepliesOut to inlet RoomContext.ToMaintenanceManagementService.ToMaintenanceManagementServiceReplies with {
    briefly "What MaintenanceManagementService answers RoomContext"
  }
  persistent connector 'InventoryServiceReply Stream' is from outlet InventoryService.InventoryServiceRepliesOut to inlet RoomContext.ToInventoryService.ToInventoryServiceReplies with {
    briefly "What InventoryService answers RoomContext"
  }
  persistent connector 'ReservationServiceReply Stream' is from outlet ReservationService.ReservationServiceRepliesOut to inlet RoomContext.ToReservationService.ToReservationServiceReplies with {
    briefly "What ReservationService answers RoomContext"
  }
  persistent connector 'QualityManagementServiceReply Stream' is from outlet QualityManagementService.QualityManagementServiceRepliesOut to inlet RoomContext.ToQualityManagementService.ToQualityManagementServiceReplies with {
    briefly "What QualityManagementService answers RoomContext"
  }
  persistent connector 'HousekeepingManagementServiceReply Stream' is from outlet HousekeepingManagementService.HousekeepingManagementServiceRepliesOut to inlet RoomContext.ToHousekeepingManagementService.ToHousekeepingManagementServiceReplies with {
    briefly "What HousekeepingManagementService answers RoomContext"
  }
  persistent connector 'HousekeepingManagementServiceEvent Stream' is from outlet HousekeepingManagementService.HousekeepingManagementServiceEventsOut to inlet RoomContext.FromHousekeepingManagementService.FromHousekeepingManagementServiceIn with {
    briefly "What HousekeepingManagementService tells RoomContext, unasked"
  }
  persistent connector 'InventoryServiceEvent Stream' is from outlet InventoryService.InventoryServiceEventsOut to inlet RoomContext.FromInventoryService.FromInventoryServiceIn with {
    briefly "What InventoryService tells RoomContext, unasked"
  }
  persistent connector 'MaintenanceManagementServiceEvent Stream' is from outlet MaintenanceManagementService.MaintenanceManagementServiceEventsOut to inlet RoomContext.FromMaintenanceManagementService.FromMaintenanceManagementServiceIn with {
    briefly "What MaintenanceManagementService tells RoomContext, unasked"
  }
  persistent connector 'QualityManagementServiceEvent Stream' is from outlet QualityManagementService.QualityManagementServiceEventsOut to inlet RoomContext.FromQualityManagementService.FromQualityManagementServiceIn with {
    briefly "What QualityManagementService tells RoomContext, unasked"
  }
  persistent connector 'ReservationServiceEvent Stream' is from outlet ReservationService.ReservationServiceEventsOut to inlet RoomContext.FromReservationService.FromReservationServiceIn with {
    briefly "What ReservationService tells RoomContext, unasked"
  }
  persistent connector 'StaffSchedulingServiceEvent Stream' is from outlet StaffSchedulingService.StaffSchedulingServiceEventsOut to inlet RoomContext.FromStaffSchedulingService.FromStaffSchedulingServiceIn with {
    briefly "What StaffSchedulingService tells RoomContext, unasked"
  }
  persistent connector 'StaffSchedulingServiceRequest Stream' is from outlet RoomContext.ToStaffSchedulingService.ToStaffSchedulingServiceOut to inlet StaffSchedulingService.StaffSchedulingServiceRequests with {
    briefly "What RoomContext asks StaffSchedulingService to send"
  }
  persistent connector 'ReservationServiceRequest Stream' is from outlet RoomContext.ToReservationService.ToReservationServiceOut to inlet ReservationService.ReservationServiceRequests with {
    briefly "What RoomContext asks ReservationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PropertyManager is "person managing the property" with {
    briefly "Property Manager"
    described as {
      |Manager overseeing property operations.
    }
  }
  user Housekeeper is "person cleaning rooms" with {
    briefly "Housekeeper"
    described as {
      |Staff responsible for room cleaning.
    }
  }
  user MaintenanceTech is "person maintaining facilities" with {
    briefly "Maintenance Tech"
    described as {
      |Staff handling property maintenance.
    }
  }
  epic PropertyEpic is {
    user PropertyManager wants to "to manage hotel rooms and facilities" so that "the property operates efficiently"
    case ManageRoom is {
      user PropertyManager wants to "to track room status and inventory" so that "rooms are properly maintained"
      step is "Manager updates" "room status" "after inspection" with {
        briefly "Update status"
        described as {
          |Track room condition.
        }
      }
      step take input PropertyManagementApp.PropertyManagementScreen.UpdateRoomStatusInput from user PropertyManager with {
        briefly "Update room"
        described as {
          |Change room status.
        }
      }
      step is "System notifies" "relevant staff" "of changes" with {
        briefly "Notify"
        described as {
          |Alert staff.
        }
      }
    } with {
      briefly "Manage room"
      described as {
        |Room status management workflow.
      }
    }
  } with {
    briefly "Property management"
    described as {
      | Epic covering room inventory, housekeeping,
      | and facility maintenance.
    }
  }
  include "RoomContext.riddl"
  include "external-contexts.riddl"
  application context PropertyManagementApp as split is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PropertyManagement are delivered.
      }
    }
    outlet AppWorkOrderCommands is type RoomContext.WorkOrder.WorkOrderCommand
    group PropertyManagementScreen is {
      input UpdateRoomStatusInput acquires command RoomContext.Room.UpdateRoomStatus with {
        briefly "Update room status control"
        described as {
          |The control through which a user submits the update room status request.
        }
      }
    } with {
      briefly "Property management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRoomCommands is type RoomContext.Room.RoomCommand
    inlet AppRoomRepositoryResponses is result RoomContext.Room.RoomResult    handler PropertyManagementAppHandler is {
      on other is {
        error "Unexpected message for application context PropertyManagementApp"
      }
    } with {
      briefly "PropertyManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PropertyManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MaintenanceManagementServiceRequest Stream' is from outlet RoomContext.ToMaintenanceManagementService.ToMaintenanceManagementServiceOut to inlet MaintenanceManagementService.MaintenanceManagementServiceRequests with {
    briefly "What RoomContext asks MaintenanceManagementService to send"
  }
  persistent connector 'HousekeepingManagementServiceRequest Stream' is from outlet RoomContext.ToHousekeepingManagementService.ToHousekeepingManagementServiceOut to inlet HousekeepingManagementService.HousekeepingManagementServiceRequests with {
    briefly "What RoomContext asks HousekeepingManagementService to send"
  }
  persistent connector 'QualityManagementServiceRequest Stream' is from outlet RoomContext.ToQualityManagementService.ToQualityManagementServiceOut to inlet QualityManagementService.QualityManagementServiceRequests with {
    briefly "What RoomContext asks QualityManagementService to send"
  }
  persistent connector 'InventoryServiceRequest Stream' is from outlet RoomContext.ToInventoryService.ToInventoryServiceOut to inlet InventoryService.InventoryServiceRequests with {
    briefly "What RoomContext asks InventoryService to send"
  }
  persistent connector 'WorkOrderCommand Stream' is from outlet PropertyManagementApp.AppWorkOrderCommands to inlet RoomContext.WorkOrderCommandStreamIn with {
    briefly "Application commands to work order"
    described as {
      |Carries work order commands from the application.
    }
  }
  persistent connector 'RoomCommand Stream' is from outlet PropertyManagementApp.AppRoomCommands to inlet RoomContext.RoomCommandStreamIn with {
    briefly "Room commands from the application"
  }
  persistent connector 'RoomResult Stream' is from outlet RoomContext.RoomResultStreamOut to inlet PropertyManagementApp.AppRoomRepositoryResponses with {
    briefly "Room query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PropertyManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term HousekeepingStaff is "Staff notified of relevant room status changes."
  briefly "Property management domain"
  described as {
    | The PropertyManagement domain handles hotel
    | room inventory and facility management.
  }
}
