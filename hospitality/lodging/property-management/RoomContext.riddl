// Property Management - Room Context
context RoomContext is {
  include "types.riddl"
  include "Room.riddl"
  // Repository for room persistence
  repository RoomRepository is {
    schema RoomData is relational
      of rooms as type Room
        index on field Room.roomId
        index on field Room.propertyId
        index on field Room.details.roomNumber
        index on field Room.details.floor
        index on field Room.status

    handler RoomPersistence is {
      on command Room.CreateRoom is {
        tell event Room.RoomCreated to entity RoomContext.Room
        prompt "Store new room"
      }
      on command Room.UpdateRoomDetails is {
        tell event Room.RoomDetailsUpdated to entity RoomContext.Room
        prompt "Update room details"
      }
      on command Room.UpdateAmenities is {
        tell event Room.AmenitiesUpdated to entity RoomContext.Room
        prompt "Update room amenities"
      }
      on command Room.UpdateRoomStatus is {
        prompt "Update room status"
      }
      on command Room.AssignHousekeeper is {
        tell event Room.HousekeeperAssigned to entity RoomContext.Room
        prompt "Store assignment"
      }
      on command Room.RecordCleaning is {
        tell event Room.CleaningRecorded to entity RoomContext.Room
        prompt "Store cleaning record"
      }
      on command Room.InspectRoom is {
        prompt "Store inspection record"
      }
      on command Room.ReportMaintenance is {
        prompt "Store maintenance request"
      }
      on command Room.CompleteMaintenance is {
        tell event Room.MaintenanceCompleted to entity RoomContext.Room
        prompt "Update maintenance status"
      }
      on command Room.BlockRoom is {
        prompt "Update room blocking"
      }
      on command Room.UnblockRoom is {
        prompt "Clear room blocking"
      }
      on command Room.DecommissionRoom is {
        prompt "Archive room record"
      }
    } with {
      briefly "Persists room commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Room data persistence"
    described as {
      | The RoomRepository provides persistent storage
      | for room inventory and housekeeping data.
    }
  }
  // Projector for housekeeping analytics
  projector HousekeepingAnalytics is {
    updates repository RoomContext.RoomRepository
    record HousekeepingStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      roomsCleaned: Natural with {
        briefly "Cleaned"
        described as {
          |Rooms cleaned.
        }
      }
      roomsInspected: Natural with {
        briefly "Inspected"
        described as {
          |Rooms inspected.
        }
      }
      inspectionPassRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Inspection pass rate.
        }
      }
      averageCleaningTime: Duration with {
        briefly "Avg time"
        described as {
          |Average cleaning time.
        }
      }
      openMaintenanceIssues: Natural with {
        briefly "Open issues"
        described as {
          |Open maintenance issues.
        }
      }
      roomsOutOfOrder: Natural with {
        briefly "Out of order"
        described as {
          |Rooms out of order.
        }
      }
    } with {
      briefly "Housekeeping statistics"
      described as {
        |Daily housekeeping metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Room.CleaningRecorded is {
        tell event Room.CleaningRecorded to repository RoomContext.RoomRepository
        prompt "Update cleaning metrics"
      }
      on event Room.RoomInspected is {
        tell event Room.RoomInspected to repository RoomContext.RoomRepository
        prompt "Update inspection metrics"
      }
      on event Room.MaintenanceReported is {
        tell event Room.MaintenanceReported to repository RoomContext.RoomRepository
        prompt "Update maintenance metrics"
      }
      on event Room.MaintenanceCompleted is {
        tell event Room.MaintenanceCompleted to repository RoomContext.RoomRepository
        prompt "Update resolution metrics"
      }
      on event Room.RoomStatusChanged is {
        tell event Room.RoomStatusChanged to repository RoomContext.RoomRepository
        prompt "Update status metrics"
      }
    } with {
      briefly "Maintains housekeeping analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Housekeeping analytics projections"
    described as {
      |Maintains housekeeping performance analytics.
    }
  }
  // ---- Event publication for Room ----
  type RoomEvent is one of {
    RoomContext.Room.RoomCreated,
    RoomContext.Room.RoomDetailsUpdated,
    RoomContext.Room.AmenitiesUpdated,
    RoomContext.Room.RoomStatusChanged,
    RoomContext.Room.HousekeeperAssigned,
    RoomContext.Room.CleaningRecorded,
    RoomContext.Room.RoomInspected,
    RoomContext.Room.MaintenanceReported,
    RoomContext.Room.MaintenanceCompleted,
    RoomContext.Room.RoomBlocked,
    RoomContext.Room.RoomUnblocked,
    RoomContext.Room.RoomDecommissioned
  } with {
    briefly "Room event alternation"
    described as {
      |Union of all Room events, for streaming and event-sourced
      |persistence.
    }
  }
  source RoomEventSource is {
    outlet RoomEvents is type RoomEvent
    handler RoomSourceHandler is {
      on event Room.RoomCreated is {
        send event Room.RoomCreated to outlet RoomEvents
      }
      on event Room.RoomDetailsUpdated is {
        send event Room.RoomDetailsUpdated to outlet RoomEvents
      }
      on event Room.AmenitiesUpdated is {
        send event Room.AmenitiesUpdated to outlet RoomEvents
      }
      on event Room.RoomStatusChanged is {
        send event Room.RoomStatusChanged to outlet RoomEvents
      }
      on event Room.HousekeeperAssigned is {
        send event Room.HousekeeperAssigned to outlet RoomEvents
      }
      on event Room.CleaningRecorded is {
        send event Room.CleaningRecorded to outlet RoomEvents
      }
      on event Room.RoomInspected is {
        send event Room.RoomInspected to outlet RoomEvents
      }
      on event Room.MaintenanceReported is {
        send event Room.MaintenanceReported to outlet RoomEvents
      }
      on event Room.MaintenanceCompleted is {
        send event Room.MaintenanceCompleted to outlet RoomEvents
      }
      on event Room.RoomBlocked is {
        send event Room.RoomBlocked to outlet RoomEvents
      }
      on event Room.RoomUnblocked is {
        send event Room.RoomUnblocked to outlet RoomEvents
      }
      on event Room.RoomDecommissioned is {
        send event Room.RoomDecommissioned to outlet RoomEvents
      }
      on other is {
        error "Unexpected message for source RoomEventSource"
      }
    } with {
      briefly "Room source handler"
      described as {
        |Publishes Room events onto the outlet.
      }
    }
  } with {
    briefly "Room event source"
    described as {
      |Publishes Room entity events into the streaming topology.
    }
  }
  sink RoomEventSink is {
    inlet RoomInlet is type RoomEvent
    handler RoomSinkHandler is {
      on event Room.RoomCreated is {
        tell event Room.RoomCreated to repository RoomContext.RoomRepository
      }
      on event Room.RoomDetailsUpdated is {
        tell event Room.RoomDetailsUpdated to repository RoomContext.RoomRepository
      }
      on event Room.AmenitiesUpdated is {
        tell event Room.AmenitiesUpdated to repository RoomContext.RoomRepository
      }
      on event Room.RoomStatusChanged is {
        tell event Room.RoomStatusChanged to repository RoomContext.RoomRepository
      }
      on event Room.HousekeeperAssigned is {
        tell event Room.HousekeeperAssigned to repository RoomContext.RoomRepository
      }
      on event Room.CleaningRecorded is {
        tell event Room.CleaningRecorded to repository RoomContext.RoomRepository
      }
      on event Room.RoomInspected is {
        tell event Room.RoomInspected to repository RoomContext.RoomRepository
      }
      on event Room.MaintenanceReported is {
        tell event Room.MaintenanceReported to repository RoomContext.RoomRepository
      }
      on event Room.MaintenanceCompleted is {
        tell event Room.MaintenanceCompleted to repository RoomContext.RoomRepository
      }
      on event Room.RoomBlocked is {
        tell event Room.RoomBlocked to repository RoomContext.RoomRepository
      }
      on event Room.RoomUnblocked is {
        tell event Room.RoomUnblocked to repository RoomContext.RoomRepository
      }
      on event Room.RoomDecommissioned is {
        tell event Room.RoomDecommissioned to repository RoomContext.RoomRepository
      }
      on other is {
        error "Unexpected message for sink RoomEventSink"
      }
    } with {
      briefly "Room sink handler"
      described as {
        |Persists Room events via the repository.
      }
    }
  } with {
    briefly "Room event sink"
    described as {
      |Receives Room events for persistence.
    }
  }
  connector RoomEventFlow is {
    from outlet RoomContext.RoomEventSource.RoomEvents to
      inlet RoomContext.RoomEventSink.RoomInlet
  } with {
    briefly "Room event flow"
    described as {
      |Connects the Room source to its sink.
    }
  }
} with {
  briefly "Bounded context for room management"
  described as {
    | The RoomContext is the bounded context for
    | room inventory and housekeeping management.
  }
}
