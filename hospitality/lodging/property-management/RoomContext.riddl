// Property Management - Room Context
context RoomContext as router is {
  inlet WorkOrderCommandStreamIn is type WorkOrderCommand  outlet WorkOrderCommandStreamOut is type WorkOrderCommand
  inlet RoomCommandStreamIn is type RoomCommand  outlet RoomCommandStreamOut is type RoomCommand
  inlet RoomResultStreamIn is result Room.RoomResult  outlet RoomResultStreamOut is result Room.RoomResult
  handler RoomContextBoundary is {
    on openWorkOrder: command WorkOrder.OpenWorkOrder is {
      send openWorkOrder to outlet RoomContext.WorkOrderCommandStreamOut
    }
    on assignWorkOrder: command WorkOrder.AssignWorkOrder is {
      send assignWorkOrder to outlet RoomContext.WorkOrderCommandStreamOut
    }
    on startWork: command WorkOrder.StartWork is {
      send startWork to outlet RoomContext.WorkOrderCommandStreamOut
    }
    on awaitParts: command WorkOrder.AwaitParts is {
      send awaitParts to outlet RoomContext.WorkOrderCommandStreamOut
    }
    on resumeWork: command WorkOrder.ResumeWork is {
      send resumeWork to outlet RoomContext.WorkOrderCommandStreamOut
    }
    on completeWorkOrder: command WorkOrder.CompleteWorkOrder is {
      send completeWorkOrder to outlet RoomContext.WorkOrderCommandStreamOut
    }
    on cancelWorkOrder: command WorkOrder.CancelWorkOrder is {
      send cancelWorkOrder to outlet RoomContext.WorkOrderCommandStreamOut
    }
    on createRoom: command Room.CreateRoom is {
      send createRoom to outlet RoomContext.RoomCommandStreamOut
    }
    on updateRoomDetails: command Room.UpdateRoomDetails is {
      send updateRoomDetails to outlet RoomContext.RoomCommandStreamOut
    }
    on updateAmenities: command Room.UpdateAmenities is {
      send updateAmenities to outlet RoomContext.RoomCommandStreamOut
    }
    on updateRoomStatus: command Room.UpdateRoomStatus is {
      send updateRoomStatus to outlet RoomContext.RoomCommandStreamOut
    }
    on assignHousekeeper: command Room.AssignHousekeeper is {
      send assignHousekeeper to outlet RoomContext.RoomCommandStreamOut
    }
    on recordCleaning: command Room.RecordCleaning is {
      send recordCleaning to outlet RoomContext.RoomCommandStreamOut
    }
    on inspectRoom: command Room.InspectRoom is {
      send inspectRoom to outlet RoomContext.RoomCommandStreamOut
    }
    on reportMaintenance: command Room.ReportMaintenance is {
      send reportMaintenance to outlet RoomContext.RoomCommandStreamOut
    }
    on completeMaintenance: command Room.CompleteMaintenance is {
      send completeMaintenance to outlet RoomContext.RoomCommandStreamOut
    }
    on blockRoom: command Room.BlockRoom is {
      send blockRoom to outlet RoomContext.RoomCommandStreamOut
    }
    on unblockRoom: command Room.UnblockRoom is {
      send unblockRoom to outlet RoomContext.RoomCommandStreamOut
    }
    on decommissionRoom: command Room.DecommissionRoom is {
      send decommissionRoom to outlet RoomContext.RoomCommandStreamOut
    }
    on roomResult: result Room.RoomResult is {
      send roomResult to outlet RoomContext.RoomResultStreamOut
    }
    on other is {
      error "Unexpected message at the RoomContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'WorkOrderEvent Feed' is from outlet RoomContext.WorkOrder.WorkOrderEvents to inlet RoomContext.HousekeepingAnalytics.HousekeepingAnalyticsFromWorkOrder with {
    briefly "WorkOrder events feeding the HousekeepingAnalytics projection"
  }
  connector 'WorkOrderCommand Stream Intake' is from outlet RoomContext.WorkOrderCommandStreamOut to inlet RoomContext.WorkOrder.WorkOrderCommands  connector 'RoomCommand Stream Intake' is from outlet RoomContext.RoomCommandStreamOut to inlet RoomContext.Room.RoomCommands  connector 'RoomResult Stream Egress' is from outlet RoomContext.RoomRepository.RoomRepositoryResponses to inlet RoomContext.RoomResultStreamIn  adaptor FromHousekeepingManagementService from context HousekeepingManagementService is { 
    handler FromHousekeepingManagementServiceHandler is {
      on event HousekeepingManagementService.AssignmentsOptimized is {
        do "the model receives assignments optimized"
      }
      on result HousekeepingManagementService.HousekeepingQueueResult is {
        do "the model receives housekeeping queue result"
      }
      on other is {
        error "Unexpected message for adaptor FromHousekeepingManagementService"
      }
    } with {
      briefly "from housekeeping management service"
      described as {
        |Carries messages from the external HousekeepingManagementService.
      }
    }
  } with {
    briefly "HousekeepingManagementService integration"
    described as {
      |The model's side of the HousekeepingManagementService conversation.
    }
  }
  adaptor ToHousekeepingManagementService to context HousekeepingManagementService is { 
    handler ToHousekeepingManagementServiceHandler is {
      on query HousekeepingManagementService.GetHousekeepingQueue is {
        do "the model sends get housekeeping queue"
      }
      on command HousekeepingManagementService.OptimizeAssignments is {
        do "the model sends optimize assignments"
      }
      on other is {
        error "Unexpected message for adaptor ToHousekeepingManagementService"
      }
    } with {
      briefly "to housekeeping management service"
      described as {
        |Carries messages to the external HousekeepingManagementService.
      }
    }
  } with {
    briefly "HousekeepingManagementService integration"
    described as {
      |The model's side of the HousekeepingManagementService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on result InventoryService.InventoryLevelsResult is {
        do "the model receives inventory levels result"
      }
      on event InventoryService.SuppliesOrdered is {
        do "the model receives supplies ordered"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on query InventoryService.GetInventoryLevels is {
        do "the model sends get inventory levels"
      }
      on command InventoryService.OrderSupplies is {
        do "the model sends order supplies"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromMaintenanceManagementService from context MaintenanceManagementService is { 
    handler FromMaintenanceManagementServiceHandler is {
      on result MaintenanceManagementService.OpenWorkOrdersResult is {
        do "the model receives open work orders result"
      }
      on event MaintenanceManagementService.TechnicianAssigned is {
        do "the model receives technician assigned"
      }
      on event MaintenanceManagementService.WorkOrderCreated is {
        do "the model receives work order created"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceManagementService"
      }
    } with {
      briefly "from maintenance management service"
      described as {
        |Carries messages from the external MaintenanceManagementService.
      }
    }
  } with {
    briefly "MaintenanceManagementService integration"
    described as {
      |The model's side of the MaintenanceManagementService conversation.
    }
  }
  adaptor ToMaintenanceManagementService to context MaintenanceManagementService is { 
    handler ToMaintenanceManagementServiceHandler is {
      on command MaintenanceManagementService.AssignTechnician is {
        do "the model sends assign technician"
      }
      on command MaintenanceManagementService.CreateWorkOrder is {
        do "the model sends create work order"
      }
      on query MaintenanceManagementService.GetOpenWorkOrders is {
        do "the model sends get open work orders"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceManagementService"
      }
    } with {
      briefly "to maintenance management service"
      described as {
        |Carries messages to the external MaintenanceManagementService.
      }
    }
  } with {
    briefly "MaintenanceManagementService integration"
    described as {
      |The model's side of the MaintenanceManagementService conversation.
    }
  }
  adaptor FromQualityManagementService from context QualityManagementService is { 
    handler FromQualityManagementServiceHandler is {
      on event QualityManagementService.QualityIssueRecorded is {
        do "the model receives quality issue recorded"
      }
      on result QualityManagementService.QualityMetricsResult is {
        do "the model receives quality metrics result"
      }
      on other is {
        error "Unexpected message for adaptor FromQualityManagementService"
      }
    } with {
      briefly "from quality management service"
      described as {
        |Carries messages from the external QualityManagementService.
      }
    }
  } with {
    briefly "QualityManagementService integration"
    described as {
      |The model's side of the QualityManagementService conversation.
    }
  }
  adaptor ToQualityManagementService to context QualityManagementService is { 
    handler ToQualityManagementServiceHandler is {
      on query QualityManagementService.GetQualityMetrics is {
        do "the model sends get quality metrics"
      }
      on command QualityManagementService.RecordQualityIssue is {
        do "the model sends record quality issue"
      }
      on other is {
        error "Unexpected message for adaptor ToQualityManagementService"
      }
    } with {
      briefly "to quality management service"
      described as {
        |Carries messages to the external QualityManagementService.
      }
    }
  } with {
    briefly "QualityManagementService integration"
    described as {
      |The model's side of the QualityManagementService conversation.
    }
  }
  adaptor FromReservationService from context ReservationService is { 
    handler FromReservationServiceHandler is {
      on event ReservationService.GuestCheckedOut is {
        do "the model receives guest checked out"
      }
      on event ReservationService.GuestCheckingIn is {
        do "the model receives guest checking in"
      }
      on result ReservationService.RoomReservationsResult is {
        do "the model receives room reservations result"
      }
      on other is {
        error "Unexpected message for adaptor FromReservationService"
      }
    } with {
      briefly "from reservation service"
      described as {
        |Carries messages from the external ReservationService.
      }
    }
  } with {
    briefly "ReservationService integration"
    described as {
      |The model's side of the ReservationService conversation.
    }
  }
  adaptor ToReservationService to context ReservationService is { 
    handler ToReservationServiceHandler is {
      on query ReservationService.GetRoomReservations is {
        do "the model sends get room reservations"
      }
      on other is {
        error "Unexpected message for adaptor ToReservationService"
      }
    } with {
      briefly "to reservation service"
      described as {
        |Carries messages to the external ReservationService.
      }
    }
  } with {
    briefly "ReservationService integration"
    described as {
      |The model's side of the ReservationService conversation.
    }
  }
  adaptor FromStaffSchedulingService from context StaffSchedulingService is { 
    handler FromStaffSchedulingServiceHandler is {
      on result StaffSchedulingService.ScheduledStaffResult is {
        do "the model receives scheduled staff result"
      }
      on event StaffSchedulingService.StaffClockIn is {
        do "the model receives staff clock in"
      }
      on event StaffSchedulingService.StaffClockOut is {
        do "the model receives staff clock out"
      }
      on other is {
        error "Unexpected message for adaptor FromStaffSchedulingService"
      }
    } with {
      briefly "from staff scheduling service"
      described as {
        |Carries messages from the external StaffSchedulingService.
      }
    }
  } with {
    briefly "StaffSchedulingService integration"
    described as {
      |The model's side of the StaffSchedulingService conversation.
    }
  }
  adaptor ToStaffSchedulingService to context StaffSchedulingService is { 
    handler ToStaffSchedulingServiceHandler is {
      on query StaffSchedulingService.GetScheduledStaff is {
        do "the model sends get scheduled staff"
      }
      on other is {
        error "Unexpected message for adaptor ToStaffSchedulingService"
      }
    } with {
      briefly "to staff scheduling service"
      described as {
        |Carries messages to the external StaffSchedulingService.
      }
    }
  } with {
    briefly "StaffSchedulingService integration"
    described as {
      |The model's side of the StaffSchedulingService conversation.
    }
  }
  include "types.riddl"
  include "Room.riddl"
  include "WorkOrder.riddl"
  // Repository for room persistence
  type RoomRepositoryCommand is one of {
    RoomContext.RoomRepository.PersistAmenitiesUpdated or RoomContext.RoomRepository.PersistCleaningRecorded or RoomContext.RoomRepository.PersistHousekeeperAssigned or RoomContext.RoomRepository.PersistMaintenanceCompleted or RoomContext.RoomRepository.PersistMaintenanceReported or RoomContext.RoomRepository.PersistRoomBlocked or RoomContext.RoomRepository.PersistRoomCreated or RoomContext.RoomRepository.PersistRoomDecommissioned or RoomContext.RoomRepository.PersistRoomDetailsUpdated or RoomContext.RoomRepository.PersistRoomInspected or RoomContext.RoomRepository.PersistRoomStatusChanged or RoomContext.RoomRepository.PersistRoomUnblocked or RoomContext.RoomRepository.PersistWorkOrderOpened or RoomContext.RoomRepository.PersistWorkOrderAssigned or RoomContext.RoomRepository.PersistWorkStarted or RoomContext.RoomRepository.PersistPartsAwaited or RoomContext.RoomRepository.PersistWorkResumed or RoomContext.RoomRepository.PersistWorkOrderCompleted or RoomContext.RoomRepository.PersistWorkOrderCancelled
  } with {
    briefly "Anything that writes RoomRepository"
    described as {
      |The persistence commands RoomRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository RoomRepository as flow is {
    command PersistWorkOrderOpened is {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderOpened applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderOpened"
      described as {
        |Instructs this repository to apply WorkOrderOpened to the stored row.
      }
    }
    command PersistWorkOrderAssigned is {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderAssigned applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderAssigned"
      described as {
        |Instructs this repository to apply WorkOrderAssigned to the stored row.
      }
    }
    command PersistWorkStarted is {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkStarted applies to.
        }
      }
    } with {
      briefly "Persist WorkStarted"
      described as {
        |Instructs this repository to apply WorkStarted to the stored row.
      }
    }
    command PersistPartsAwaited is {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row PartsAwaited applies to.
        }
      }
    } with {
      briefly "Persist PartsAwaited"
      described as {
        |Instructs this repository to apply PartsAwaited to the stored row.
      }
    }
    command PersistWorkResumed is {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkResumed applies to.
        }
      }
    } with {
      briefly "Persist WorkResumed"
      described as {
        |Instructs this repository to apply WorkResumed to the stored row.
      }
    }
    command PersistWorkOrderCompleted is {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderCompleted applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderCompleted"
      described as {
        |Instructs this repository to apply WorkOrderCompleted to the stored row.
      }
    }
    command PersistWorkOrderCancelled is {
      workOrderId: WorkOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkOrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist WorkOrderCancelled"
      described as {
        |Instructs this repository to apply WorkOrderCancelled to the stored row.
      }
    }
    inlet RoomRepositoryFromHousekeepingAnalytics is type RoomRepositoryCommand    command PersistAmenitiesUpdated is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row AmenitiesUpdated applies to.
        }
      }
    } with {
      briefly "Persist AmenitiesUpdated"
      described as {
        |Instructs this repository to apply AmenitiesUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistHousekeeperAssigned is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row HousekeeperAssigned applies to.
        }
      }
    } with {
      briefly "Persist HousekeeperAssigned"
      described as {
        |Instructs this repository to apply HousekeeperAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomBlocked is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomBlocked applies to.
        }
      }
    } with {
      briefly "Persist RoomBlocked"
      described as {
        |Instructs this repository to apply RoomBlocked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomCreated is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomCreated applies to.
        }
      }
    } with {
      briefly "Persist RoomCreated"
      described as {
        |Instructs this repository to apply RoomCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomDecommissioned is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomDecommissioned applies to.
        }
      }
    } with {
      briefly "Persist RoomDecommissioned"
      described as {
        |Instructs this repository to apply RoomDecommissioned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomDetailsUpdated is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomDetailsUpdated applies to.
        }
      }
    } with {
      briefly "Persist RoomDetailsUpdated"
      described as {
        |Instructs this repository to apply RoomDetailsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomUnblocked is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomUnblocked applies to.
        }
      }
    } with {
      briefly "Persist RoomUnblocked"
      described as {
        |Instructs this repository to apply RoomUnblocked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCleaningRecorded is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row CleaningRecorded applies to.
        }
      }
    } with {
      briefly "Persist CleaningRecorded"
      described as {
        |Instructs this repository to apply CleaningRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceCompleted is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceCompleted applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceCompleted"
      described as {
        |Instructs this repository to apply MaintenanceCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMaintenanceReported is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row MaintenanceReported applies to.
        }
      }
    } with {
      briefly "Persist MaintenanceReported"
      described as {
        |Instructs this repository to apply MaintenanceReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomInspected is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomInspected applies to.
        }
      }
    } with {
      briefly "Persist RoomInspected"
      described as {
        |Instructs this repository to apply RoomInspected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomStatusChanged is {
      roomId: RoomId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomStatusChanged applies to.
        }
      }
    } with {
      briefly "Persist RoomStatusChanged"
      described as {
        |Instructs this repository to apply RoomStatusChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet RoomRepositoryResponses is result Room.RoomResult
    record StoredRoom is {
      roomId: RoomId with {
        briefly "roomId"
        described as {
          |The roomId column of the stored room row.
        }
      }
      details: RoomDetails with {
        briefly "details"
        described as {
          |The details column of the stored room row.
        }
      }
      propertyId: PropertyId with {
        briefly "propertyId"
        described as {
          |The propertyId column of the stored room row.
        }
      }
      status: RoomStatus with {
        briefly "status"
        described as {
          |The status column of the stored room row.
        }
      }
    } with {
      briefly "Stored room row"
      described as {
        |The persistence shape of room data as this repository stores it.
      }
    }
    schema RoomData is relational
      of rooms as record StoredRoom
        index on field StoredRoom.roomId
        index on field StoredRoom.propertyId
        index on field StoredRoom.details.roomNumber
        index on field StoredRoom.details.floor
        index on field StoredRoom.status
 with {
      briefly "Room data schema"
      described as {
        |The relational schema holding room data for the RoomRepository.
      }
    }
    handler RoomPersistence is {
      on command RoomRepository.PersistWorkOrderOpened is {
        do "apply WorkOrderOpened to the stored row"
      }
      on command RoomRepository.PersistWorkOrderAssigned is {
        do "apply WorkOrderAssigned to the stored row"
      }
      on command RoomRepository.PersistWorkStarted is {
        do "apply WorkStarted to the stored row"
      }
      on command RoomRepository.PersistPartsAwaited is {
        do "apply PartsAwaited to the stored row"
      }
      on command RoomRepository.PersistWorkResumed is {
        do "apply WorkResumed to the stored row"
      }
      on command RoomRepository.PersistWorkOrderCompleted is {
        do "apply WorkOrderCompleted to the stored row"
      }
      on command RoomRepository.PersistWorkOrderCancelled is {
        do "apply WorkOrderCancelled to the stored row"
      }
      on persistAmenitiesUpdated: command PersistAmenitiesUpdated is {
        do "apply AmenitiesUpdated to the stored row"
      }
      on persistHousekeeperAssigned: command PersistHousekeeperAssigned is {
        do "apply HousekeeperAssigned to the stored row"
      }
      on persistRoomBlocked: command PersistRoomBlocked is {
        do "apply RoomBlocked to the stored row"
      }
      on persistRoomCreated: command PersistRoomCreated is {
        do "apply RoomCreated to the stored row"
      }
      on persistRoomDecommissioned: command PersistRoomDecommissioned is {
        do "apply RoomDecommissioned to the stored row"
      }
      on persistRoomDetailsUpdated: command PersistRoomDetailsUpdated is {
        do "apply RoomDetailsUpdated to the stored row"
      }
      on persistRoomUnblocked: command PersistRoomUnblocked is {
        do "apply RoomUnblocked to the stored row"
      }
      on persistCleaningRecorded: command PersistCleaningRecorded is {
        do "apply CleaningRecorded to the stored row"
      }
      on persistMaintenanceCompleted: command PersistMaintenanceCompleted is {
        do "apply MaintenanceCompleted to the stored row"
      }
      on persistMaintenanceReported: command PersistMaintenanceReported is {
        do "apply MaintenanceReported to the stored row"
      }
      on persistRoomInspected: command PersistRoomInspected is {
        do "apply RoomInspected to the stored row"
      }
      on persistRoomStatusChanged: command PersistRoomStatusChanged is {
        do "apply RoomStatusChanged to the stored row"
      }
      on query GetHousekeepingStats is {
        let housekeepingStatsView: type HousekeepingStatsView = prompt("read the housekeeping stats projection")
        reply housekeepingStatsView
      }
    } with {
      briefly "Persists room commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Room data persistence"
    described as {
      | The RoomRepository provides persistent storage
      | for room inventory and housekeeping data.
    }
  }
  // Projector for housekeeping analytics
  query GetHousekeepingStats replies result HousekeepingStatsView is {
    housekeepingStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which housekeeping stats to retrieve.
      }
    }
  } with {
    briefly "Get housekeeping stats"
    described as {
      |Retrieves the housekeeping stats projection.
    }
  }
  result HousekeepingStatsView is {
    housekeepingStats: HousekeepingAnalytics.HousekeepingStats with {
      briefly "Housekeeping stats"
      described as {
        |The housekeeping stats being returned.
      }
    }
  } with {
    briefly "Housekeeping stats view"
    described as {
      |Read model view carrying the housekeeping stats projection.
    }
  }
  projector HousekeepingAnalytics as merge is {
    updates repository RoomContext.RoomRepository
    inlet HousekeepingAnalyticsFromWorkOrder is type WorkOrderEvent    outlet HousekeepingAnalyticsToRepository is type RoomRepositoryCommand
    inlet HousekeepingAnalyticsFromRoom is type RoomEvent    record HousekeepingStats is {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      roomsCleaned: Natural with {
        briefly "Cleaned"
        described as {
          |Rooms cleaned.
        }
      }
      roomsInspected: Natural with {
        briefly "Inspected"
        described as {
          |Rooms inspected.
        }
      }
      inspectionPassRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Inspection pass rate.
        }
      }
      averageCleaningTime: Duration with {
        briefly "Avg time"
        described as {
          |Average cleaning time.
        }
      }
      openMaintenanceIssues: Natural with {
        briefly "Open issues"
        described as {
          |Open maintenance issues.
        }
      }
      roomsOutOfOrder: Natural with {
        briefly "Out of order"
        described as {
          |Rooms out of order.
        }
      }
    } with {
      briefly "Housekeeping statistics"
      described as {
        |Daily housekeeping metrics.
      }
    }
    handler AnalyticsHandler is {
      on workOrderOpened: event WorkOrder.WorkOrderOpened is {
        tell command RoomContext.RoomRepository.PersistWorkOrderOpened(workOrderId = workOrderOpened.workOrderId) to repository RoomContext.RoomRepository
      }
      on workOrderAssigned: event WorkOrder.WorkOrderAssigned is {
        tell command RoomContext.RoomRepository.PersistWorkOrderAssigned(workOrderId = workOrderAssigned.workOrderId) to repository RoomContext.RoomRepository
      }
      on workStarted: event WorkOrder.WorkStarted is {
        tell command RoomContext.RoomRepository.PersistWorkStarted(workOrderId = workStarted.workOrderId) to repository RoomContext.RoomRepository
      }
      on partsAwaited: event WorkOrder.PartsAwaited is {
        tell command RoomContext.RoomRepository.PersistPartsAwaited(workOrderId = partsAwaited.workOrderId) to repository RoomContext.RoomRepository
      }
      on workResumed: event WorkOrder.WorkResumed is {
        tell command RoomContext.RoomRepository.PersistWorkResumed(workOrderId = workResumed.workOrderId) to repository RoomContext.RoomRepository
      }
      on workOrderCompleted: event WorkOrder.WorkOrderCompleted is {
        tell command RoomContext.RoomRepository.PersistWorkOrderCompleted(workOrderId = workOrderCompleted.workOrderId) to repository RoomContext.RoomRepository
      }
      on workOrderCancelled: event WorkOrder.WorkOrderCancelled is {
        tell command RoomContext.RoomRepository.PersistWorkOrderCancelled(workOrderId = workOrderCancelled.workOrderId) to repository RoomContext.RoomRepository
      }
      on amenitiesUpdated: event Room.AmenitiesUpdated is {
        tell command RoomContext.RoomRepository.PersistAmenitiesUpdated(roomId = amenitiesUpdated.roomId) to repository RoomContext.RoomRepository
        do "apply AmenitiesUpdated to the HousekeepingAnalytics projection"
      }
      on housekeeperAssigned: event Room.HousekeeperAssigned is {
        tell command RoomContext.RoomRepository.PersistHousekeeperAssigned(roomId = housekeeperAssigned.roomId) to repository RoomContext.RoomRepository
        do "apply HousekeeperAssigned to the HousekeepingAnalytics projection"
      }
      on roomBlocked: event Room.RoomBlocked is {
        tell command RoomContext.RoomRepository.PersistRoomBlocked(roomId = roomBlocked.roomId) to repository RoomContext.RoomRepository
        do "apply RoomBlocked to the HousekeepingAnalytics projection"
      }
      on roomCreated: event Room.RoomCreated is {
        tell command RoomContext.RoomRepository.PersistRoomCreated(roomId = roomCreated.roomId) to repository RoomContext.RoomRepository
        do "apply RoomCreated to the HousekeepingAnalytics projection"
      }
      on roomDecommissioned: event Room.RoomDecommissioned is {
        tell command RoomContext.RoomRepository.PersistRoomDecommissioned(roomId = roomDecommissioned.roomId) to repository RoomContext.RoomRepository
        do "apply RoomDecommissioned to the HousekeepingAnalytics projection"
      }
      on roomDetailsUpdated: event Room.RoomDetailsUpdated is {
        tell command RoomContext.RoomRepository.PersistRoomDetailsUpdated(roomId = roomDetailsUpdated.roomId) to repository RoomContext.RoomRepository
        do "apply RoomDetailsUpdated to the HousekeepingAnalytics projection"
      }
      on roomUnblocked: event Room.RoomUnblocked is {
        tell command RoomContext.RoomRepository.PersistRoomUnblocked(roomId = roomUnblocked.roomId) to repository RoomContext.RoomRepository
        do "apply RoomUnblocked to the HousekeepingAnalytics projection"
      }
      on cleaningRecorded: event Room.CleaningRecorded is {
        tell command RoomContext.RoomRepository.PersistCleaningRecorded(roomId = cleaningRecorded.roomId) to repository RoomContext.RoomRepository
        do "Update cleaning metrics"
      }
      on roomInspected: event Room.RoomInspected is {
        tell command RoomContext.RoomRepository.PersistRoomInspected(roomId = roomInspected.roomId) to repository RoomContext.RoomRepository
        do "Update inspection metrics"
      }
      on maintenanceReported: event Room.MaintenanceReported is {
        tell command RoomContext.RoomRepository.PersistMaintenanceReported(roomId = maintenanceReported.roomId) to repository RoomContext.RoomRepository
        do "Update maintenance metrics"
      }
      on maintenanceCompleted: event Room.MaintenanceCompleted is {
        tell command RoomContext.RoomRepository.PersistMaintenanceCompleted(roomId = maintenanceCompleted.roomId) to repository RoomContext.RoomRepository
        do "Update resolution metrics"
      }
      on roomStatusChanged: event Room.RoomStatusChanged is {
        tell command RoomContext.RoomRepository.PersistRoomStatusChanged(roomId = roomStatusChanged.roomId) to repository RoomContext.RoomRepository
        do "Update status metrics"
      }
    } with {
      briefly "Maintains housekeeping analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Housekeeping analytics projections"
    described as {
      |Maintains housekeeping performance analytics.
    }
  }
  // ---- Event publication for Room ----
  type RoomEvent is one of {
    RoomContext.Room.RoomCreated or RoomContext.Room.RoomDetailsUpdated or RoomContext.Room.AmenitiesUpdated or RoomContext.Room.RoomStatusChanged or RoomContext.Room.HousekeeperAssigned or RoomContext.Room.CleaningRecorded or RoomContext.Room.RoomInspected or RoomContext.Room.MaintenanceReported or RoomContext.Room.MaintenanceCompleted or RoomContext.Room.RoomBlocked or RoomContext.Room.RoomUnblocked or RoomContext.Room.RoomDecommissioned
  } with {
    briefly "Room event alternation"
    described as {
      |Union of all Room events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet RoomEventSplit as flow is {
    inlet RoomEventSplitIn is type RoomEvent    outlet RoomEventSplitToHousekeepingAnalytics is type RoomEvent
    handler RoomEventSplitHandler is {
      on roomCreated: event Room.RoomCreated is {
        send roomCreated to outlet RoomEventSplitToHousekeepingAnalytics
        tell roomCreated to entity RoomContext.Room
      }
      on roomDetailsUpdated: event Room.RoomDetailsUpdated is {
        send roomDetailsUpdated to outlet RoomEventSplitToHousekeepingAnalytics
        tell roomDetailsUpdated to entity RoomContext.Room
      }
      on amenitiesUpdated: event Room.AmenitiesUpdated is {
        send amenitiesUpdated to outlet RoomEventSplitToHousekeepingAnalytics
        tell amenitiesUpdated to entity RoomContext.Room
      }
      on roomStatusChanged: event Room.RoomStatusChanged is {
        send roomStatusChanged to outlet RoomEventSplitToHousekeepingAnalytics
        tell roomStatusChanged to entity RoomContext.Room
      }
      on housekeeperAssigned: event Room.HousekeeperAssigned is {
        send housekeeperAssigned to outlet RoomEventSplitToHousekeepingAnalytics
        tell housekeeperAssigned to entity RoomContext.Room
      }
      on cleaningRecorded: event Room.CleaningRecorded is {
        send cleaningRecorded to outlet RoomEventSplitToHousekeepingAnalytics
        tell cleaningRecorded to entity RoomContext.Room
      }
      on roomInspected: event Room.RoomInspected is {
        send roomInspected to outlet RoomEventSplitToHousekeepingAnalytics
        tell roomInspected to entity RoomContext.Room
      }
      on maintenanceReported: event Room.MaintenanceReported is {
        send maintenanceReported to outlet RoomEventSplitToHousekeepingAnalytics
        tell maintenanceReported to entity RoomContext.Room
      }
      on maintenanceCompleted: event Room.MaintenanceCompleted is {
        send maintenanceCompleted to outlet RoomEventSplitToHousekeepingAnalytics
        tell maintenanceCompleted to entity RoomContext.Room
      }
      on roomBlocked: event Room.RoomBlocked is {
        send roomBlocked to outlet RoomEventSplitToHousekeepingAnalytics
        tell roomBlocked to entity RoomContext.Room
      }
      on roomUnblocked: event Room.RoomUnblocked is {
        send roomUnblocked to outlet RoomEventSplitToHousekeepingAnalytics
        tell roomUnblocked to entity RoomContext.Room
      }
      on roomDecommissioned: event Room.RoomDecommissioned is {
        send roomDecommissioned to outlet RoomEventSplitToHousekeepingAnalytics
        tell roomDecommissioned to entity RoomContext.Room
      }
      on other is {
        error "Unexpected message for processor RoomEventSplit"
      }
    } with {
      briefly "Room event fan-out handler"
      described as {
        |Delivers each Room event to all of its consumers.
      }
    }
  } with {
    briefly "Room event fan-out"
    described as {
      |Fans Room events out to the repository and projectors.
    }
  }
  connector 'RoomEvent Stream' is from outlet RoomContext.Room.RoomEvents2 to inlet RoomContext.RoomEventSplit.RoomEventSplitIn with {
    briefly "Room events, fanned out to storage and read models"
  }
  connector 'HousekeepingAnalytics Feed' is from outlet RoomContext.RoomEventSplit.RoomEventSplitToHousekeepingAnalytics to inlet RoomContext.HousekeepingAnalytics.HousekeepingAnalyticsFromRoom with {
    briefly "Room events feeding the HousekeepingAnalytics projection"
  }
  connector 'HousekeepingAnalytics Storage' is from outlet RoomContext.HousekeepingAnalytics.HousekeepingAnalyticsToRepository to inlet RoomContext.RoomRepository.RoomRepositoryFromHousekeepingAnalytics with {
    briefly "HousekeepingAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for room management"
  described as {
    | The RoomContext is the bounded context for
    | room inventory and housekeeping management.
  }
}
