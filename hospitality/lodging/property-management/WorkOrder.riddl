// Property Management - WorkOrder Entity
// // A maintenance work order is its own aggregate. MaintenanceStatus enumerates
// its lifecycle -- open, assigned, in progress, awaiting parts, completed or
// cancelled -- and that belongs here rather than on Room: a room is not
// "PendingParts", and it outlives every work order raised against it.
aggregate entity WorkOrder as flow is {
  type WorkOrderCommand is one of {
    WorkOrder.OpenWorkOrder or WorkOrder.AssignWorkOrder or WorkOrder.StartWork or WorkOrder.AwaitParts or WorkOrder.ResumeWork or WorkOrder.CompleteWorkOrder or WorkOrder.CancelWorkOrder
  } with {
    briefly "Work order command alternation"
    described as {
      |Commands accepted by the WorkOrder entity.
    }
  }
  type WorkOrderEvent is one of {
    WorkOrder.WorkOrderOpened or WorkOrder.WorkOrderAssigned or WorkOrder.WorkStarted or WorkOrder.PartsAwaited or WorkOrder.WorkResumed or WorkOrder.WorkOrderCompleted or WorkOrder.WorkOrderCancelled
  } with {
    briefly "Work order event alternation"
    described as {
      |Events published by the WorkOrder entity.
    }
  }
  inlet WorkOrderCommands is type WorkOrderCommand  outlet WorkOrderEvents is type WorkOrderEvent
  query GetWorkOrder is  {
    workOrderId: WorkOrderId with {
      briefly "ID"
      described as {
        |Identifier of the work order to retrieve.
      }
    }
  } with {
    briefly "Get work order"
    described as {
      |Retrieve work order data by identifier.
    }
  }
  result WorkOrderResult is  {
    workOrderData: WorkOrder.OpenStateData with {
      briefly "Work order data"
      described as {
        |The requested work order data.
      }
    }
  } with {
    briefly "Work order result"
    described as {
      |Result carrying the requested work order data.
    }
  }
  command OpenWorkOrder is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this command addresses.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Raise a work order"
    described as {
      |Raises a work order against a room from a maintenance report.
    }
  }
  command AssignWorkOrder is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this command addresses.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Assign a work order"
    described as {
      |Assigns the order to a technician.
    }
  }
  command StartWork is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this command addresses.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Start work"
    described as {
      |Records that work has begun.
    }
  }
  command AwaitParts is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this command addresses.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Await parts"
    described as {
      |Halts the order until parts arrive.
    }
  }
  command ResumeWork is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this command addresses.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Resume work"
    described as {
      |Resumes work once parts have arrived.
    }
  }
  command CompleteWorkOrder is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this command addresses.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Complete a work order"
    described as {
      |Signs the order off as finished.
    }
  }
  command CancelWorkOrder is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this command addresses.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Cancel a work order"
    described as {
      |Abandons the order without completing it.
    }
  }
  event WorkOrderOpened is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this event concerns.
      }
    }
  } with {
    briefly "WorkOrderOpened"
    described as {
      |Records the outcome of OpenWorkOrder.
    }
  }
  event WorkOrderAssigned is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this event concerns.
      }
    }
  } with {
    briefly "WorkOrderAssigned"
    described as {
      |Records the outcome of AssignWorkOrder.
    }
  }
  event WorkStarted is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this event concerns.
      }
    }
  } with {
    briefly "WorkStarted"
    described as {
      |Records the outcome of StartWork.
    }
  }
  event PartsAwaited is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this event concerns.
      }
    }
  } with {
    briefly "PartsAwaited"
    described as {
      |Records the outcome of AwaitParts.
    }
  }
  event WorkResumed is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this event concerns.
      }
    }
  } with {
    briefly "WorkResumed"
    described as {
      |Records the outcome of ResumeWork.
    }
  }
  event WorkOrderCompleted is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this event concerns.
      }
    }
  } with {
    briefly "WorkOrderCompleted"
    described as {
      |Records the outcome of CompleteWorkOrder.
    }
  }
  event WorkOrderCancelled is  {
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this event concerns.
      }
    }
  } with {
    briefly "WorkOrderCancelled"
    described as {
      |Records the outcome of CancelWorkOrder.
    }
  }
  record OpenStateData is  {
    stateValue: MaintenanceStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this state belongs to.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Open work order"
    described as {
      |A work order raised but not yet assigned to anyone.
    }
  }
  record AssignedStateData is  {
    stateValue: MaintenanceStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this state belongs to.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Assigned work order"
    described as {
      |A work order assigned to a technician who has not started.
    }
  }
  record InProgressStateData is  {
    stateValue: MaintenanceStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this state belongs to.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "InProgress work order"
    described as {
      |A work order being worked on.
    }
  }
  record PendingPartsStateData is  {
    stateValue: MaintenanceStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this state belongs to.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "PendingParts work order"
    described as {
      |A work order halted awaiting parts.
    }
  }
  record CompletedStateData is  {
    stateValue: MaintenanceStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this state belongs to.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Completed work order"
    described as {
      |A work order finished and signed off.
    }
  }
  record CancelledStateData is  {
    stateValue: MaintenanceStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    workOrderId: WorkOrderId with {
      briefly "Work order"
      described as {
        |The work order this state belongs to.
      }
    }
    roomId: RoomId with {
      briefly "Room"
      described as {
        |The room the work concerns.
      }
    }
  } with {
    briefly "Cancelled work order"
    described as {
      |A work order abandoned without completion.
    }
  }
  initial state OpenState of record WorkOrder.OpenStateData is {
    initial handler OpenInitHandler is {
      on init is {
        set state OpenState to "initialize from the preceding event"
        set field WorkOrder.OpenStateData.stateValue to "Open"
      }
    } with {
      briefly "Open init handler"
      described as {
        |Initializes a work order on entry to the Open state.
      }
    }
  } with {
    briefly "Open state"
    described as {
      |A work order raised but not yet assigned to anyone.
    }
  }
  state AssignedState of record WorkOrder.AssignedStateData is {
    initial handler AssignedInitHandler is {
      on init is {
        set state AssignedState to "initialize from the preceding event"
        set field WorkOrder.AssignedStateData.stateValue to "Assigned"
      }
    } with {
      briefly "Assigned init handler"
      described as {
        |Initializes a work order on entry to the Assigned state.
      }
    }
  } with {
    briefly "Assigned state"
    described as {
      |A work order assigned to a technician who has not started.
    }
  }
  state InProgressState of record WorkOrder.InProgressStateData is {
    initial handler InProgressInitHandler is {
      on init is {
        set state InProgressState to "initialize from the preceding event"
        set field WorkOrder.InProgressStateData.stateValue to "InProgress"
      }
    } with {
      briefly "InProgress init handler"
      described as {
        |Initializes a work order on entry to the InProgress state.
      }
    }
  } with {
    briefly "InProgress state"
    described as {
      |A work order being worked on.
    }
  }
  state PendingPartsState of record WorkOrder.PendingPartsStateData is {
    initial handler PendingPartsInitHandler is {
      on init is {
        set state PendingPartsState to "initialize from the preceding event"
        set field WorkOrder.PendingPartsStateData.stateValue to "PendingParts"
      }
    } with {
      briefly "PendingParts init handler"
      described as {
        |Initializes a work order on entry to the PendingParts state.
      }
    }
  } with {
    briefly "PendingParts state"
    described as {
      |A work order halted awaiting parts.
    }
  }
  state CompletedState of record WorkOrder.CompletedStateData is {
    initial handler CompletedInitHandler is {
      on init is {
        set state CompletedState to "initialize from the preceding event"
        set field WorkOrder.CompletedStateData.stateValue to "Completed"
      }
      on query GetWorkOrder is {
        reply result WorkOrder.WorkOrderResult
      }
      on other is {
        error "a completed work order is read-only; it reports itself but accepts no changes"
      }
    } with {
      briefly "Completed init handler"
      described as {
        |Initializes a work order on entry to the Completed state.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |A work order finished and signed off.
    }
  }
  state CancelledState of record WorkOrder.CancelledStateData is {
    initial handler CancelledInitHandler is {
      on init is {
        set state CancelledState to "initialize from the preceding event"
        set field WorkOrder.CancelledStateData.stateValue to "Cancelled"
      }
      on other is {
        error "the work order was cancelled and accepts no further activity"
      }
    } with {
      briefly "Cancelled init handler"
      described as {
        |Initializes a work order on entry to the Cancelled state.
      }
    }
  } with {
    briefly "Cancelled state"
    described as {
      |A work order abandoned without completion.
    }
  }
  handler WorkOrderHandler is {
    on query GetWorkOrder is {
      reply result WorkOrder.WorkOrderResult
    }
    on openWorkOrder: command OpenWorkOrder is {
      morph entity RoomContext.WorkOrder to state RoomContext.WorkOrder.OpenState with record WorkOrder.OpenStateData
      send event WorkOrder.WorkOrderOpened(workOrderId = openWorkOrder.workOrderId) to outlet WorkOrderEvents
    }
    on assignWorkOrder: command AssignWorkOrder is {
      morph entity RoomContext.WorkOrder to state RoomContext.WorkOrder.AssignedState with record WorkOrder.AssignedStateData
      send event WorkOrder.WorkOrderAssigned(workOrderId = assignWorkOrder.workOrderId) to outlet WorkOrderEvents
    }
    on startWork: command StartWork is {
      morph entity RoomContext.WorkOrder to state RoomContext.WorkOrder.InProgressState with record WorkOrder.InProgressStateData
      send event WorkOrder.WorkStarted(workOrderId = startWork.workOrderId) to outlet WorkOrderEvents
    }
    on awaitParts: command AwaitParts is {
      morph entity RoomContext.WorkOrder to state RoomContext.WorkOrder.PendingPartsState with record WorkOrder.PendingPartsStateData
      send event WorkOrder.PartsAwaited(workOrderId = awaitParts.workOrderId) to outlet WorkOrderEvents
    }
    on resumeWork: command ResumeWork is {
      morph entity RoomContext.WorkOrder to state RoomContext.WorkOrder.InProgressState with record WorkOrder.InProgressStateData
      send event WorkOrder.WorkResumed(workOrderId = resumeWork.workOrderId) to outlet WorkOrderEvents
    }
    on completeWorkOrder: command CompleteWorkOrder is {
      morph entity RoomContext.WorkOrder to state RoomContext.WorkOrder.CompletedState with record WorkOrder.CompletedStateData
      send event WorkOrder.WorkOrderCompleted(workOrderId = completeWorkOrder.workOrderId) to outlet WorkOrderEvents
    }
    on cancelWorkOrder: command CancelWorkOrder is {
      morph entity RoomContext.WorkOrder to state RoomContext.WorkOrder.CancelledState with record WorkOrder.CancelledStateData
      send event WorkOrder.WorkOrderCancelled(workOrderId = cancelWorkOrder.workOrderId) to outlet WorkOrderEvents
    }
  } with {
    briefly "Work order command handler"
    described as {
      |Walks a work order from raising through assignment and execution to
      |completion, with a parts hold and a cancellation path.
    }
  }
} with {
  briefly "A maintenance work order"
  described as {
    |One unit of maintenance work against a room. Its own aggregate, because a
    |room outlives every order raised against it.
  }
}
