// Guest Services - Service Request Context
context ServiceRequestContext as router is {
  inlet ServiceRequestContextFromKitchenService is command ServiceRequest.CompleteService with {
    briefly "What FromKitchenService makes of that service's news"
  }
  connector 'FromKitchenService Intake' is from outlet ServiceRequestContext.FromKitchenService.FromKitchenServiceToServiceRequestContext to inlet ServiceRequestContext.ServiceRequestContextFromKitchenService with {
    briefly "What FromKitchenService makes of that news, on its way in"
  }
  inlet ServiceRequestContextFromLaundryService is command ServiceRequest.CompleteService with {
    briefly "What FromLaundryService makes of that service's news"
  }
  connector 'FromLaundryService Intake' is from outlet ServiceRequestContext.FromLaundryService.FromLaundryServiceToServiceRequestContext to inlet ServiceRequestContext.ServiceRequestContextFromLaundryService with {
    briefly "What FromLaundryService makes of that news, on its way in"
  }
  inlet ServiceRequestContextFromMaintenanceService is command ServiceRequest.CompleteService with {
    briefly "What FromMaintenanceService makes of that service's news"
  }
  connector 'FromMaintenanceService Intake' is from outlet ServiceRequestContext.FromMaintenanceService.FromMaintenanceServiceToServiceRequestContext to inlet ServiceRequestContext.ServiceRequestContextFromMaintenanceService with {
    briefly "What FromMaintenanceService makes of that news, on its way in"
  }
  inlet ServiceRequestContextFromStaffDispatchService is command ServiceRequest.AssignStaff with {
    briefly "What FromStaffDispatchService makes of that service's news"
  }
  connector 'FromStaffDispatchService Intake' is from outlet ServiceRequestContext.FromStaffDispatchService.FromStaffDispatchServiceToServiceRequestContext to inlet ServiceRequestContext.ServiceRequestContextFromStaffDispatchService with {
    briefly "What FromStaffDispatchService makes of that news, on its way in"
  }
  inlet ServiceRequestContextFromTelephonyService is command ServiceRequest.CompleteService with {
    briefly "What FromTelephonyService makes of that service's news"
  }
  connector 'FromTelephonyService Intake' is from outlet ServiceRequestContext.FromTelephonyService.FromTelephonyServiceToServiceRequestContext to inlet ServiceRequestContext.ServiceRequestContextFromTelephonyService with {
    briefly "What FromTelephonyService makes of that news, on its way in"
  }
  inlet ServiceRequestCommandStreamIn is type ServiceRequestCommand  outlet ServiceRequestCommandStreamOut is type ServiceRequestCommand
  inlet ServiceRequestResultStreamIn is result ServiceRequest.ServiceRequestResult  outlet ServiceRequestResultStreamOut is result ServiceRequest.ServiceRequestResult
  handler ServiceRequestContextBoundary is {
    on createServiceRequest: command ServiceRequest.CreateServiceRequest is {
      send createServiceRequest to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on updateRequestDetails: command ServiceRequest.UpdateRequestDetails is {
      send updateRequestDetails to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on assignStaff: command ServiceRequest.AssignStaff is {
      send assignStaff to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on startService: command ServiceRequest.StartService is {
      send startService to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on completeService: command ServiceRequest.CompleteService is {
      send completeService to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on cancelRequest: command ServiceRequest.CancelRequest is {
      send cancelRequest to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on escalateRequest: command ServiceRequest.EscalateRequest is {
      send escalateRequest to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on recordFeedback: command ServiceRequest.RecordFeedback is {
      send recordFeedback to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on addRoomServiceOrder: command ServiceRequest.AddRoomServiceOrder is {
      send addRoomServiceOrder to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on addLaundryOrder: command ServiceRequest.AddLaundryOrder is {
      send addLaundryOrder to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on scheduleWakeupCall: command ServiceRequest.ScheduleWakeupCall is {
      send scheduleWakeupCall to outlet ServiceRequestContext.ServiceRequestCommandStreamOut
    }
    on serviceRequestResult: result ServiceRequest.ServiceRequestResult is {
      send serviceRequestResult to outlet ServiceRequestContext.ServiceRequestResultStreamOut
    }
    on other is {
      error "Unexpected message at the ServiceRequestContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ServiceRequestCommand Stream Intake' is from outlet ServiceRequestContext.ServiceRequestCommandStreamOut to inlet ServiceRequestContext.ServiceRequest.ServiceRequestCommands  connector 'ServiceRequestResult Stream Egress' is from outlet ServiceRequestContext.ServiceRequestRepository.ServiceRequestRepositoryResponses to inlet ServiceRequestContext.ServiceRequestResultStreamIn  adaptor FromBillingService from context BillingService is { 
    inlet FromBillingServiceIn is event BillingService.ChargePosted    handler FromBillingServiceHandler is {
      on chargePosted: event BillingService.ChargePosted is {
        do "the charge is on the folio; the service recorded making it"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService as flow is { 
    inlet ToBillingServiceIn is type ServiceRequestEvent    outlet ToBillingServiceOut is command BillingService.PostCharge
    handler ToBillingServiceHandler is {
      on serviceCompleted: event ServiceRequest.ServiceCompleted is {
        let notice: type BillingService.PostCharge = prompt("translate the serviceCompleted event into a PostCharge putting what the guest now owes for the delivered service onto their folio")
        send notice to outlet ServiceRequestContext.ToBillingService.ToBillingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromGuestNotificationService from context GuestNotificationService is { 
    inlet FromGuestNotificationServiceIn is type GuestNotificationService.GuestNotificationServiceEvent    handler FromGuestNotificationServiceHandler is {
      on feedbackRequested: event GuestNotificationService.FeedbackRequested is {
        do "the guest has been asked; feedback is recorded when they give it"
      }
      on updateSent: event GuestNotificationService.UpdateSent is {
        do "the guest has been told; the request's own state is unchanged"
      }
      on other is {
        error "Unexpected message for adaptor FromGuestNotificationService"
      }
    } with {
      briefly "from guest notification service"
      described as {
        |Carries messages from the external GuestNotificationService.
      }
    }
  } with {
    briefly "GuestNotificationService integration"
    described as {
      |The model's side of the GuestNotificationService conversation.
    }
  }
  adaptor ToGuestNotificationService to context GuestNotificationService as flow is { 
    inlet ToGuestNotificationServiceIn is type ServiceRequestEvent    outlet ToGuestNotificationServiceOut is type GuestNotificationService.GuestNotificationServiceCommand
    handler ToGuestNotificationServiceHandler is {
      on serviceStarted: event ServiceStarted is {
        let notice: type GuestNotificationService.SendServiceUpdate = prompt("translate the serviceStarted event into a SendServiceUpdate telling the guest someone is on the way, so they know their request is moving")
        send notice to outlet ServiceRequestContext.ToGuestNotificationService.ToGuestNotificationServiceOut
      }
      on serviceCompleted: event ServiceCompleted is {
        let notice: type GuestNotificationService.SendServiceUpdate = prompt("translate the serviceCompleted event into a SendServiceUpdate telling the guest the request is done")
        send notice to outlet ServiceRequestContext.ToGuestNotificationService.ToGuestNotificationServiceOut
        let feedbackRequest: type GuestNotificationService.RequestFeedback = prompt("a RequestFeedback asking the guest how the service went, now that it is finished and they can judge it")
        send feedbackRequest to outlet ServiceRequestContext.ToGuestNotificationService.ToGuestNotificationServiceOut
      }
      on requestCancelled: event RequestCancelled is {
        let notice: type GuestNotificationService.SendServiceUpdate = prompt("translate the requestCancelled event into a SendServiceUpdate telling the guest their request will not be actioned and why")
        send notice to outlet ServiceRequestContext.ToGuestNotificationService.ToGuestNotificationServiceOut
      }
      on staffAssigned: event StaffAssigned is {
        let notice: type GuestNotificationService.SendServiceUpdate = prompt("translate the staffAssigned event into a SendServiceUpdate telling the guest who is handling their request")
        send notice to outlet ServiceRequestContext.ToGuestNotificationService.ToGuestNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToGuestNotificationService"
      }
    } with {
      briefly "to guest notification service"
      described as {
        |Carries messages to the external GuestNotificationService.
      }
    }
  } with {
    briefly "GuestNotificationService integration"
    described as {
      |The model's side of the GuestNotificationService conversation.
    }
  }
  adaptor FromKitchenService from context KitchenService as flow is { 
    inlet FromKitchenServiceIn is type KitchenService.KitchenServiceEvent    outlet FromKitchenServiceToServiceRequestContext is command ServiceRequest.CompleteService
    handler FromKitchenServiceHandler is {
      on foodOrderDelivered: event KitchenService.FoodOrderDelivered is {
        let item0: type ServiceRequest.CompleteService = prompt("translate the foodOrderDelivered event into a CompleteService, food actually delivered completes the room-service request")
        send item0 to outlet ServiceRequestContext.FromKitchenService.FromKitchenServiceToServiceRequestContext
      }
      on foodOrderReady: event KitchenService.FoodOrderReady is {
        do "the food is ready; delivering it is the next act"
      }
      on foodOrderReceived: event KitchenService.FoodOrderReceived is {
        do "the kitchen has the order; submitting it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromKitchenService"
      }
    } with {
      briefly "from kitchen service"
      described as {
        |Carries messages from the external KitchenService.
      }
    }
  } with {
    briefly "KitchenService integration"
    described as {
      |The model's side of the KitchenService conversation.
    }
  }
  adaptor ToKitchenService to context KitchenService as flow is { 
    inlet ToKitchenServiceIn is type ServiceRequestEvent    outlet ToKitchenServiceOut is command KitchenService.SubmitFoodOrder
    handler ToKitchenServiceHandler is {
      on roomServiceOrderAdded: event ServiceRequest.RoomServiceOrderAdded is {
        let item0: type KitchenService.SubmitFoodOrder = prompt("translate the roomServiceOrderAdded event into a SubmitFoodOrder, a room service order being what the kitchen cooks")
        send item0 to outlet ServiceRequestContext.ToKitchenService.ToKitchenServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToKitchenService"
      }
    } with {
      briefly "to kitchen service"
      described as {
        |Carries messages to the external KitchenService.
      }
    }
  } with {
    briefly "KitchenService integration"
    described as {
      |The model's side of the KitchenService conversation.
    }
  }
  adaptor FromLaundryService from context LaundryService as flow is { 
    inlet FromLaundryServiceIn is type LaundryService.LaundryServiceEvent    outlet FromLaundryServiceToServiceRequestContext is command ServiceRequest.CompleteService
    handler FromLaundryServiceHandler is {
      on laundryDelivered: event LaundryService.LaundryDelivered is {
        let item0: type ServiceRequest.CompleteService = prompt("translate the laundryDelivered event into a CompleteService, laundry returned to the room completes the request")
        send item0 to outlet ServiceRequestContext.FromLaundryService.FromLaundryServiceToServiceRequestContext
      }
      on laundryPickedUp: event LaundryService.LaundryPickedUp is {
        do "the laundry is collected; the request runs until it comes back"
      }
      on laundryProcessed: event LaundryService.LaundryProcessed is {
        do "the laundry is done; the request completes when it is returned"
      }
      on other is {
        error "Unexpected message for adaptor FromLaundryService"
      }
    } with {
      briefly "from laundry service"
      described as {
        |Carries messages from the external LaundryService.
      }
    }
  } with {
    briefly "LaundryService integration"
    described as {
      |The model's side of the LaundryService conversation.
    }
  }
  adaptor ToLaundryService to context LaundryService as flow is { 
    inlet ToLaundryServiceIn is type ServiceRequestEvent    outlet ToLaundryServiceOut is command LaundryService.SubmitLaundryOrder
    handler ToLaundryServiceHandler is {
      on laundryOrderAdded: event ServiceRequest.LaundryOrderAdded is {
        let item0: type LaundryService.SubmitLaundryOrder = prompt("translate the laundryOrderAdded event into a SubmitLaundryOrder, a laundry order being what the laundry washes")
        send item0 to outlet ServiceRequestContext.ToLaundryService.ToLaundryServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToLaundryService"
      }
    } with {
      briefly "to laundry service"
      described as {
        |Carries messages to the external LaundryService.
      }
    }
  } with {
    briefly "LaundryService integration"
    described as {
      |The model's side of the LaundryService conversation.
    }
  }
  adaptor FromMaintenanceService from context MaintenanceService as flow is { 
    inlet FromMaintenanceServiceIn is type MaintenanceService.MaintenanceServiceEvent    outlet FromMaintenanceServiceToServiceRequestContext is command ServiceRequest.CompleteService
    handler FromMaintenanceServiceHandler is {
      on maintenanceCompleted: event MaintenanceService.MaintenanceCompleted is {
        let item0: type ServiceRequest.CompleteService = prompt("translate the maintenanceCompleted event into a CompleteService, the repair being done is what completes the guest's request")
        send item0 to outlet ServiceRequestContext.FromMaintenanceService.FromMaintenanceServiceToServiceRequestContext
      }
      on maintenanceTicketCreated: event MaintenanceService.MaintenanceTicketCreated is {
        do "maintenance has the ticket; the request recorded raising it"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceService"
      }
    } with {
      briefly "from maintenance service"
      described as {
        |Carries messages from the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor ToMaintenanceService to context MaintenanceService as flow is { 
    inlet ToMaintenanceServiceIn is type ServiceRequestEvent    outlet ToMaintenanceServiceOut is command MaintenanceService.CreateMaintenanceTicket
    handler ToMaintenanceServiceHandler is {
      on requestEscalated: event ServiceRequest.RequestEscalated is {
        let item0: type MaintenanceService.CreateMaintenanceTicket = prompt("translate the requestEscalated event into a CreateMaintenanceTicket, escalation being what hands the job to maintenance")
        send item0 to outlet ServiceRequestContext.ToMaintenanceService.ToMaintenanceServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceService"
      }
    } with {
      briefly "to maintenance service"
      described as {
        |Carries messages to the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor FromStaffDispatchService from context StaffDispatchService as flow is { 
    inlet FromStaffDispatchServiceIn is event StaffDispatchService.StaffDispatched    outlet FromStaffDispatchServiceToServiceRequestContext is command ServiceRequest.AssignStaff
    handler FromStaffDispatchServiceHandler is {
      on staffDispatched: event StaffDispatchService.StaffDispatched is {
        let item0: type ServiceRequest.AssignStaff = prompt("translate the staffDispatched event into a AssignStaff, whoever is actually dispatched is who the request is assigned to")
        send item0 to outlet ServiceRequestContext.FromStaffDispatchService.FromStaffDispatchServiceToServiceRequestContext
      }
      on other is {
        error "Unexpected message for adaptor FromStaffDispatchService"
      }
    } with {
      briefly "from staff dispatch service"
      described as {
        |Carries messages from the external StaffDispatchService.
      }
    }
  } with {
    briefly "StaffDispatchService integration"
    described as {
      |The model's side of the StaffDispatchService conversation.
    }
  }
  adaptor ToStaffDispatchService to context StaffDispatchService as merge is { 
    inlet ToStaffDispatchServiceIn is type ServiceRequestEvent    inlet ToStaffDispatchServiceReplies is result StaffDispatchService.AvailableStaffResult    outlet ToStaffDispatchServiceOut is type StaffDispatchService.StaffDispatchServiceRequest
    handler ToStaffDispatchServiceHandler is {
      on serviceRequestCreated: event ServiceRequest.ServiceRequestCreated is {
        let askAnswer: type StaffDispatchService.AvailableStaffResult = ask query StaffDispatchService.GetAvailableStaff of context StaffDispatchService
        do "a request needing someone free to do it"
        let notice: type StaffDispatchService.DispatchStaff = prompt("translate the serviceRequestCreated event into a DispatchStaff sending someone to the guest's request")
        send notice to outlet ServiceRequestContext.ToStaffDispatchService.ToStaffDispatchServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToStaffDispatchService"
      }
    } with {
      briefly "to staff dispatch service"
      described as {
        |Carries messages to the external StaffDispatchService.
      }
    }
  } with {
    briefly "StaffDispatchService integration"
    described as {
      |The model's side of the StaffDispatchService conversation.
    }
  }
  adaptor FromTelephonyService from context TelephonyService as flow is { 
    inlet FromTelephonyServiceIn is type TelephonyService.TelephonyServiceEvent    outlet FromTelephonyServiceToServiceRequestContext is command ServiceRequest.CompleteService
    handler FromTelephonyServiceHandler is {
      on guestWakeupScheduled: event TelephonyService.GuestWakeupScheduled is {
        do "the call is scheduled; the request recorded asking for it"
      }
      on wakeupCallCancelled: event TelephonyService.WakeupCallCancelled is {
        do "the call is cancelled; the request recorded cancelling it"
      }
      on wakeupCallPlaced: event TelephonyService.WakeupCallPlaced is {
        let item0: type ServiceRequest.CompleteService = prompt("translate the wakeupCallPlaced event into a CompleteService, the call actually being placed completes the wake-up request")
        send item0 to outlet ServiceRequestContext.FromTelephonyService.FromTelephonyServiceToServiceRequestContext
      }
      on other is {
        error "Unexpected message for adaptor FromTelephonyService"
      }
    } with {
      briefly "from telephony service"
      described as {
        |Carries messages from the external TelephonyService.
      }
    }
  } with {
    briefly "TelephonyService integration"
    described as {
      |The model's side of the TelephonyService conversation.
    }
  }
  adaptor ToTelephonyService to context TelephonyService as flow is { 
    inlet ToTelephonyServiceIn is type ServiceRequestEvent    outlet ToTelephonyServiceOut is type TelephonyService.TelephonyServiceCommand
    handler ToTelephonyServiceHandler is {
      on wakeupCallScheduled: event ServiceRequest.WakeupCallScheduled is {
        let item0: type TelephonyService.ScheduleGuestWakeup = prompt("translate the wakeupCallScheduled event into a ScheduleGuestWakeup, the scheduled call being what the switchboard must hold")
        send item0 to outlet ServiceRequestContext.ToTelephonyService.ToTelephonyServiceOut
      }
      on requestCancelled: event ServiceRequest.RequestCancelled is {
        let item0: type TelephonyService.CancelWakeupCall = prompt("translate the requestCancelled event into a CancelWakeupCall, cancellation being what releases it")
        send item0 to outlet ServiceRequestContext.ToTelephonyService.ToTelephonyServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToTelephonyService"
      }
    } with {
      briefly "to telephony service"
      described as {
        |Carries messages to the external TelephonyService.
      }
    }
  } with {
    briefly "TelephonyService integration"
    described as {
      |The model's side of the TelephonyService conversation.
    }
  }
  include "types.riddl"
  include "ServiceRequest.riddl"
  // Repository for service request persistence
  type ServiceRequestRepositoryCommand is one of {
    ServiceRequestContext.ServiceRequestRepository.PersistFeedbackRecorded or ServiceRequestContext.ServiceRequestRepository.PersistLaundryOrderAdded or ServiceRequestContext.ServiceRequestRepository.PersistRequestCancelled or ServiceRequestContext.ServiceRequestRepository.PersistRequestDetailsUpdated or ServiceRequestContext.ServiceRequestRepository.PersistRequestEscalated or ServiceRequestContext.ServiceRequestRepository.PersistRoomServiceOrderAdded or ServiceRequestContext.ServiceRequestRepository.PersistServiceCompleted or ServiceRequestContext.ServiceRequestRepository.PersistServiceRequestCreated or ServiceRequestContext.ServiceRequestRepository.PersistServiceStarted or ServiceRequestContext.ServiceRequestRepository.PersistStaffAssigned or ServiceRequestContext.ServiceRequestRepository.PersistWakeupCallScheduled
  } with {
    briefly "Anything that writes ServiceRequestRepository"
    described as {
      |The persistence commands ServiceRequestRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ServiceRequestRepository as flow is {
    inlet ServiceRequestRepositoryFromServiceAnalytics is type ServiceRequestRepositoryCommand    command PersistLaundryOrderAdded is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row LaundryOrderAdded applies to.
        }
      }
    } with {
      briefly "Persist LaundryOrderAdded"
      described as {
        |Instructs this repository to apply LaundryOrderAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequestCancelled is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequestCancelled applies to.
        }
      }
    } with {
      briefly "Persist RequestCancelled"
      described as {
        |Instructs this repository to apply RequestCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequestDetailsUpdated is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequestDetailsUpdated applies to.
        }
      }
    } with {
      briefly "Persist RequestDetailsUpdated"
      described as {
        |Instructs this repository to apply RequestDetailsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRequestEscalated is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row RequestEscalated applies to.
        }
      }
    } with {
      briefly "Persist RequestEscalated"
      described as {
        |Instructs this repository to apply RequestEscalated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomServiceOrderAdded is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomServiceOrderAdded applies to.
        }
      }
    } with {
      briefly "Persist RoomServiceOrderAdded"
      described as {
        |Instructs this repository to apply RoomServiceOrderAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceStarted is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceStarted applies to.
        }
      }
    } with {
      briefly "Persist ServiceStarted"
      described as {
        |Instructs this repository to apply ServiceStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWakeupCallScheduled is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row WakeupCallScheduled applies to.
        }
      }
    } with {
      briefly "Persist WakeupCallScheduled"
      described as {
        |Instructs this repository to apply WakeupCallScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFeedbackRecorded is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row FeedbackRecorded applies to.
        }
      }
    } with {
      briefly "Persist FeedbackRecorded"
      described as {
        |Instructs this repository to apply FeedbackRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceCompleted is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceCompleted applies to.
        }
      }
    } with {
      briefly "Persist ServiceCompleted"
      described as {
        |Instructs this repository to apply ServiceCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServiceRequestCreated is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row ServiceRequestCreated applies to.
        }
      }
    } with {
      briefly "Persist ServiceRequestCreated"
      described as {
        |Instructs this repository to apply ServiceRequestCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStaffAssigned is {
      requestId: ServiceRequestId with {
        briefly "Row addressed"
        described as {
          |Which stored row StaffAssigned applies to.
        }
      }
    } with {
      briefly "Persist StaffAssigned"
      described as {
        |Instructs this repository to apply StaffAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ServiceRequestRepositoryResponses is result ServiceRequest.ServiceRequestResult
    record StoredServiceRequest is {
      serviceRequestId: ServiceRequestId with {
        briefly "serviceRequestId"
        described as {
          |The serviceRequestId column of the stored serviceRequest row.
        }
      }
      guest: GuestInfo with {
        briefly "guest"
        described as {
          |The guest column of the stored serviceRequest row.
        }
      }
      request: ServiceRequestDetails with {
        briefly "request"
        described as {
          |The request column of the stored serviceRequest row.
        }
      }
      requestId: ServiceRequestId with {
        briefly "requestId"
        described as {
          |The requestId column of the stored serviceRequest row.
        }
      }
      status: RequestStatus with {
        briefly "status"
        described as {
          |The status column of the stored serviceRequest row.
        }
      }
    } with {
      briefly "Stored serviceRequest row"
      described as {
        |The persistence shape of serviceRequest data as this repository stores it.
      }
    }
    schema ServiceRequestData is relational
      of requests as record StoredServiceRequest
        index on field StoredServiceRequest.requestId
        index on field StoredServiceRequest.guest.guestId
        index on field StoredServiceRequest.guest.roomNumber
        index on field StoredServiceRequest.request.category
        index on field StoredServiceRequest.status
 with {
      briefly "Service request data schema"
      described as {
        |The relational schema holding service request data for the ServiceRequestRepository.
      }
    }
    handler ServiceRequestPersistence is {
      on persistLaundryOrderAdded: command PersistLaundryOrderAdded is {
        do "apply LaundryOrderAdded to the stored row"
      }
      on persistRequestCancelled: command PersistRequestCancelled is {
        do "apply RequestCancelled to the stored row"
      }
      on persistRequestDetailsUpdated: command PersistRequestDetailsUpdated is {
        do "apply RequestDetailsUpdated to the stored row"
      }
      on persistRequestEscalated: command PersistRequestEscalated is {
        do "apply RequestEscalated to the stored row"
      }
      on persistRoomServiceOrderAdded: command PersistRoomServiceOrderAdded is {
        do "apply RoomServiceOrderAdded to the stored row"
      }
      on persistServiceStarted: command PersistServiceStarted is {
        do "apply ServiceStarted to the stored row"
      }
      on persistWakeupCallScheduled: command PersistWakeupCallScheduled is {
        do "apply WakeupCallScheduled to the stored row"
      }
      on persistFeedbackRecorded: command PersistFeedbackRecorded is {
        do "apply FeedbackRecorded to the stored row"
      }
      on persistServiceCompleted: command PersistServiceCompleted is {
        do "apply ServiceCompleted to the stored row"
      }
      on persistServiceRequestCreated: command PersistServiceRequestCreated is {
        do "apply ServiceRequestCreated to the stored row"
      }
      on persistStaffAssigned: command PersistStaffAssigned is {
        do "apply StaffAssigned to the stored row"
      }
      on query GetServiceStats is {
        let serviceStatsView: type ServiceStatsView = prompt("read the service stats projection")
        reply serviceStatsView
      }
    } with {
      briefly "Persists service request events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Service request data persistence"
    described as {
      | The ServiceRequestRepository provides persistent
      | storage for service requests.
    }
  }
  // Projector for service analytics
  query GetServiceStats replies result ServiceStatsView is {
    serviceStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which service stats to retrieve.
      }
    }
  } with {
    briefly "Get service stats"
    described as {
      |Retrieves the service stats projection.
    }
  }
  result ServiceStatsView is {
    serviceStats: ServiceAnalytics.ServiceStats with {
      briefly "Service stats"
      described as {
        |The service stats being returned.
      }
    }
  } with {
    briefly "Service stats view"
    described as {
      |Read model view carrying the service stats projection.
    }
  }
  projector ServiceAnalytics as flow is {
    updates repository ServiceRequestContext.ServiceRequestRepository
    outlet ServiceAnalyticsToRepository is type ServiceRequestRepositoryCommand
    inlet ServiceAnalyticsFromServiceRequest is type ServiceRequestEvent    record ServiceStats is {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalRequests: Natural with {
        briefly "Total"
        described as {
          |Total requests.
        }
      }
      completedRequests: Natural with {
        briefly "Completed"
        described as {
          |Completed requests.
        }
      }
      averageResponseTime: Duration with {
        briefly "Response time"
        described as {
          |Avg response time.
        }
      }
      averageFulfillmentTime: Duration with {
        briefly "Fulfillment time"
        described as {
          |Avg fulfillment time.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      requestsByCategory: Natural+ with {
        briefly "By category"
        described as {
          |Requests by category.
        }
      }
    } with {
      briefly "Service statistics"
      described as {
        |Daily service metrics.
      }
    }
    handler AnalyticsHandler is {
      on laundryOrderAdded: event ServiceRequest.LaundryOrderAdded is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistLaundryOrderAdded(requestId = laundryOrderAdded.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "apply LaundryOrderAdded to the ServiceAnalytics projection"
      }
      on requestCancelled: event ServiceRequest.RequestCancelled is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistRequestCancelled(requestId = requestCancelled.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "apply RequestCancelled to the ServiceAnalytics projection"
      }
      on requestDetailsUpdated: event ServiceRequest.RequestDetailsUpdated is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistRequestDetailsUpdated(requestId = requestDetailsUpdated.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "apply RequestDetailsUpdated to the ServiceAnalytics projection"
      }
      on requestEscalated: event ServiceRequest.RequestEscalated is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistRequestEscalated(requestId = requestEscalated.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "apply RequestEscalated to the ServiceAnalytics projection"
      }
      on roomServiceOrderAdded: event ServiceRequest.RoomServiceOrderAdded is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistRoomServiceOrderAdded(requestId = roomServiceOrderAdded.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "apply RoomServiceOrderAdded to the ServiceAnalytics projection"
      }
      on serviceStarted: event ServiceRequest.ServiceStarted is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistServiceStarted(requestId = serviceStarted.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "apply ServiceStarted to the ServiceAnalytics projection"
      }
      on wakeupCallScheduled: event ServiceRequest.WakeupCallScheduled is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistWakeupCallScheduled(requestId = wakeupCallScheduled.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "apply WakeupCallScheduled to the ServiceAnalytics projection"
      }
      on serviceRequestCreated: event ServiceRequest.ServiceRequestCreated is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistServiceRequestCreated(requestId = serviceRequestCreated.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "Update request counts"
      }
      on staffAssigned: event ServiceRequest.StaffAssigned is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistStaffAssigned(requestId = staffAssigned.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "Calculate response time"
      }
      on serviceCompleted: event ServiceRequest.ServiceCompleted is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistServiceCompleted(requestId = serviceCompleted.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "Update completion metrics"
      }
      on feedbackRecorded: event ServiceRequest.FeedbackRecorded is {
        tell command ServiceRequestContext.ServiceRequestRepository.PersistFeedbackRecorded(requestId = feedbackRecorded.requestId) to repository ServiceRequestContext.ServiceRequestRepository
        do "Update rating metrics"
      }
    } with {
      briefly "Maintains service analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Service analytics projections"
    described as {
      |Maintains service quality analytics.
    }
  }
  // ---- Event publication for ServiceRequest ----
  type ServiceRequestEvent is one of {
    ServiceRequestContext.ServiceRequest.ServiceRequestCreated or ServiceRequestContext.ServiceRequest.RequestDetailsUpdated or ServiceRequestContext.ServiceRequest.StaffAssigned or ServiceRequestContext.ServiceRequest.ServiceStarted or ServiceRequestContext.ServiceRequest.ServiceCompleted or ServiceRequestContext.ServiceRequest.RequestCancelled or ServiceRequestContext.ServiceRequest.RequestEscalated or ServiceRequestContext.ServiceRequest.FeedbackRecorded or ServiceRequestContext.ServiceRequest.RoomServiceOrderAdded or ServiceRequestContext.ServiceRequest.LaundryOrderAdded or ServiceRequestContext.ServiceRequest.WakeupCallScheduled
  } with {
    briefly "ServiceRequest event alternation"
    described as {
      |Union of all ServiceRequest events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ServiceRequestEventSplit as split is {
    outlet ServiceRequestEventSplitToToTelephonyService is type ServiceRequestEvent
    outlet ServiceRequestEventSplitToToStaffDispatchService is type ServiceRequestEvent
    outlet ServiceRequestEventSplitToToMaintenanceService is type ServiceRequestEvent
    outlet ServiceRequestEventSplitToToLaundryService is type ServiceRequestEvent
    outlet ServiceRequestEventSplitToToKitchenService is type ServiceRequestEvent
    outlet ServiceRequestEventSplitToToGuestNotificationService is type ServiceRequestEvent
    outlet ServiceRequestEventSplitToToBillingService is type ServiceRequestEvent
    inlet ServiceRequestEventSplitIn is type ServiceRequestEvent    outlet ServiceRequestEventSplitToServiceAnalytics is type ServiceRequestEvent
    handler ServiceRequestEventSplitHandler is {
      on serviceRequestCreated: event ServiceRequest.ServiceRequestCreated is {
        send serviceRequestCreated to outlet ServiceRequestEventSplitToServiceAnalytics
        send serviceRequestCreated to outlet ServiceRequestEventSplitToToStaffDispatchService
        tell serviceRequestCreated to entity ServiceRequestContext.ServiceRequest
      }
      on requestDetailsUpdated: event ServiceRequest.RequestDetailsUpdated is {
        send requestDetailsUpdated to outlet ServiceRequestEventSplitToServiceAnalytics
        tell requestDetailsUpdated to entity ServiceRequestContext.ServiceRequest
      }
      on staffAssigned: event ServiceRequest.StaffAssigned is {
        send staffAssigned to outlet ServiceRequestEventSplitToServiceAnalytics
        send staffAssigned to outlet ServiceRequestEventSplitToToGuestNotificationService
        tell staffAssigned to entity ServiceRequestContext.ServiceRequest
      }
      on serviceStarted: event ServiceRequest.ServiceStarted is {
        send serviceStarted to outlet ServiceRequestEventSplitToServiceAnalytics
        send serviceStarted to outlet ServiceRequestEventSplitToToGuestNotificationService
        tell serviceStarted to entity ServiceRequestContext.ServiceRequest
      }
      on serviceCompleted: event ServiceRequest.ServiceCompleted is {
        send serviceCompleted to outlet ServiceRequestEventSplitToServiceAnalytics
        send serviceCompleted to outlet ServiceRequestEventSplitToToGuestNotificationService
        send serviceCompleted to outlet ServiceRequestEventSplitToToBillingService
        tell serviceCompleted to entity ServiceRequestContext.ServiceRequest
      }
      on requestCancelled: event ServiceRequest.RequestCancelled is {
        send requestCancelled to outlet ServiceRequestEventSplitToServiceAnalytics
        send requestCancelled to outlet ServiceRequestEventSplitToToTelephonyService
        send requestCancelled to outlet ServiceRequestEventSplitToToGuestNotificationService
        tell requestCancelled to entity ServiceRequestContext.ServiceRequest
      }
      on requestEscalated: event ServiceRequest.RequestEscalated is {
        send requestEscalated to outlet ServiceRequestEventSplitToServiceAnalytics
        send requestEscalated to outlet ServiceRequestEventSplitToToMaintenanceService
        tell requestEscalated to entity ServiceRequestContext.ServiceRequest
      }
      on feedbackRecorded: event ServiceRequest.FeedbackRecorded is {
        send feedbackRecorded to outlet ServiceRequestEventSplitToServiceAnalytics
        tell feedbackRecorded to entity ServiceRequestContext.ServiceRequest
      }
      on roomServiceOrderAdded: event ServiceRequest.RoomServiceOrderAdded is {
        send roomServiceOrderAdded to outlet ServiceRequestEventSplitToServiceAnalytics
        send roomServiceOrderAdded to outlet ServiceRequestEventSplitToToKitchenService
        tell roomServiceOrderAdded to entity ServiceRequestContext.ServiceRequest
      }
      on laundryOrderAdded: event ServiceRequest.LaundryOrderAdded is {
        send laundryOrderAdded to outlet ServiceRequestEventSplitToServiceAnalytics
        send laundryOrderAdded to outlet ServiceRequestEventSplitToToLaundryService
        tell laundryOrderAdded to entity ServiceRequestContext.ServiceRequest
      }
      on wakeupCallScheduled: event ServiceRequest.WakeupCallScheduled is {
        send wakeupCallScheduled to outlet ServiceRequestEventSplitToServiceAnalytics
        send wakeupCallScheduled to outlet ServiceRequestEventSplitToToTelephonyService
        tell wakeupCallScheduled to entity ServiceRequestContext.ServiceRequest
      }
      on other is {
        error "Unexpected message for processor ServiceRequestEventSplit"
      }
    } with {
      briefly "ServiceRequest event fan-out handler"
      described as {
        |Delivers each ServiceRequest event to all of its consumers.
      }
    }
  } with {
    briefly "ServiceRequest event fan-out"
    described as {
      |Fans ServiceRequest events out to the repository and projectors.
    }
  }
  connector 'ToTelephonyService Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToToTelephonyService to inlet ServiceRequestContext.ToTelephonyService.ToTelephonyServiceIn with {
    briefly "The ServiceRequest events ToTelephonyService translates, on their way to it"
  }
  connector 'ToStaffDispatchService Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToToStaffDispatchService to inlet ServiceRequestContext.ToStaffDispatchService.ToStaffDispatchServiceIn with {
    briefly "The ServiceRequest events ToStaffDispatchService translates, on their way to it"
  }
  connector 'ToMaintenanceService Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToToMaintenanceService to inlet ServiceRequestContext.ToMaintenanceService.ToMaintenanceServiceIn with {
    briefly "The ServiceRequest events ToMaintenanceService translates, on their way to it"
  }
  connector 'ToLaundryService Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToToLaundryService to inlet ServiceRequestContext.ToLaundryService.ToLaundryServiceIn with {
    briefly "The ServiceRequest events ToLaundryService translates, on their way to it"
  }
  connector 'ToKitchenService Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToToKitchenService to inlet ServiceRequestContext.ToKitchenService.ToKitchenServiceIn with {
    briefly "The ServiceRequest events ToKitchenService translates, on their way to it"
  }
  connector 'ToGuestNotificationService Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToToGuestNotificationService to inlet ServiceRequestContext.ToGuestNotificationService.ToGuestNotificationServiceIn with {
    briefly "The ServiceRequest events ToGuestNotificationService translates, on their way to it"
  }
  connector 'ToBillingService Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToToBillingService to inlet ServiceRequestContext.ToBillingService.ToBillingServiceIn with {
    briefly "The ServiceRequest events ToBillingService translates, on their way to it"
  }
  connector 'ServiceRequestEvent Stream' is from outlet ServiceRequestContext.ServiceRequest.ServiceRequestEvents2 to inlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitIn with {
    briefly "ServiceRequest events, fanned out to storage and read models"
  }
  connector 'ServiceAnalytics Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToServiceAnalytics to inlet ServiceRequestContext.ServiceAnalytics.ServiceAnalyticsFromServiceRequest with {
    briefly "ServiceRequest events feeding the ServiceAnalytics projection"
  }
  connector 'ServiceAnalytics Storage' is from outlet ServiceRequestContext.ServiceAnalytics.ServiceAnalyticsToRepository to inlet ServiceRequestContext.ServiceRequestRepository.ServiceRequestRepositoryFromServiceAnalytics with {
    briefly "ServiceAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for service requests"
  described as {
    | The ServiceRequestContext is the bounded context
    | for guest service request management.
  }
}
