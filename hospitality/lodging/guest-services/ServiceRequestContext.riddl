// Guest Services - Service Request Context
context ServiceRequestContext is {
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.ChargePosted is {
        do "the model receives charge posted"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.PostCharge is {
        do "the model sends post charge"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromGuestNotificationService from context GuestNotificationService is { 
    handler FromGuestNotificationServiceHandler is {
      on event GuestNotificationService.FeedbackRequested is {
        do "the model receives feedback requested"
      }
      on event GuestNotificationService.UpdateSent is {
        do "the model receives update sent"
      }
      on other is {
        error "Unexpected message for adaptor FromGuestNotificationService"
      }
    } with {
      briefly "from guest notification service"
      described as {
        |Carries messages from the external GuestNotificationService.
      }
    }
  } with {
    briefly "GuestNotificationService integration"
    described as {
      |The model's side of the GuestNotificationService conversation.
    }
  }
  adaptor ToGuestNotificationService to context GuestNotificationService is { 
    handler ToGuestNotificationServiceHandler is {
      on command GuestNotificationService.RequestFeedback is {
        do "the model sends request feedback"
      }
      on command GuestNotificationService.SendServiceUpdate is {
        do "the model sends send service update"
      }
      on other is {
        error "Unexpected message for adaptor ToGuestNotificationService"
      }
    } with {
      briefly "to guest notification service"
      described as {
        |Carries messages to the external GuestNotificationService.
      }
    }
  } with {
    briefly "GuestNotificationService integration"
    described as {
      |The model's side of the GuestNotificationService conversation.
    }
  }
  adaptor FromKitchenService from context KitchenService is { 
    handler FromKitchenServiceHandler is {
      on event KitchenService.FoodOrderDelivered is {
        do "the model receives food order delivered"
      }
      on event KitchenService.FoodOrderReady is {
        do "the model receives food order ready"
      }
      on event KitchenService.FoodOrderReceived is {
        do "the model receives food order received"
      }
      on other is {
        error "Unexpected message for adaptor FromKitchenService"
      }
    } with {
      briefly "from kitchen service"
      described as {
        |Carries messages from the external KitchenService.
      }
    }
  } with {
    briefly "KitchenService integration"
    described as {
      |The model's side of the KitchenService conversation.
    }
  }
  adaptor ToKitchenService to context KitchenService is { 
    handler ToKitchenServiceHandler is {
      on command KitchenService.SubmitFoodOrder is {
        do "the model sends submit food order"
      }
      on other is {
        error "Unexpected message for adaptor ToKitchenService"
      }
    } with {
      briefly "to kitchen service"
      described as {
        |Carries messages to the external KitchenService.
      }
    }
  } with {
    briefly "KitchenService integration"
    described as {
      |The model's side of the KitchenService conversation.
    }
  }
  adaptor FromLaundryService from context LaundryService is { 
    handler FromLaundryServiceHandler is {
      on event LaundryService.LaundryDelivered is {
        do "the model receives laundry delivered"
      }
      on event LaundryService.LaundryPickedUp is {
        do "the model receives laundry picked up"
      }
      on event LaundryService.LaundryProcessed is {
        do "the model receives laundry processed"
      }
      on other is {
        error "Unexpected message for adaptor FromLaundryService"
      }
    } with {
      briefly "from laundry service"
      described as {
        |Carries messages from the external LaundryService.
      }
    }
  } with {
    briefly "LaundryService integration"
    described as {
      |The model's side of the LaundryService conversation.
    }
  }
  adaptor ToLaundryService to context LaundryService is { 
    handler ToLaundryServiceHandler is {
      on command LaundryService.SubmitLaundryOrder is {
        do "the model sends submit laundry order"
      }
      on other is {
        error "Unexpected message for adaptor ToLaundryService"
      }
    } with {
      briefly "to laundry service"
      described as {
        |Carries messages to the external LaundryService.
      }
    }
  } with {
    briefly "LaundryService integration"
    described as {
      |The model's side of the LaundryService conversation.
    }
  }
  adaptor FromMaintenanceService from context MaintenanceService is { 
    handler FromMaintenanceServiceHandler is {
      on event MaintenanceService.MaintenanceCompleted is {
        do "the model receives maintenance completed"
      }
      on event MaintenanceService.MaintenanceTicketCreated is {
        do "the model receives maintenance ticket created"
      }
      on other is {
        error "Unexpected message for adaptor FromMaintenanceService"
      }
    } with {
      briefly "from maintenance service"
      described as {
        |Carries messages from the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor ToMaintenanceService to context MaintenanceService is { 
    handler ToMaintenanceServiceHandler is {
      on command MaintenanceService.CreateMaintenanceTicket is {
        do "the model sends create maintenance ticket"
      }
      on other is {
        error "Unexpected message for adaptor ToMaintenanceService"
      }
    } with {
      briefly "to maintenance service"
      described as {
        |Carries messages to the external MaintenanceService.
      }
    }
  } with {
    briefly "MaintenanceService integration"
    described as {
      |The model's side of the MaintenanceService conversation.
    }
  }
  adaptor FromStaffDispatchService from context StaffDispatchService is { 
    handler FromStaffDispatchServiceHandler is {
      on result StaffDispatchService.AvailableStaffResult is {
        do "the model receives available staff result"
      }
      on event StaffDispatchService.StaffDispatched is {
        do "the model receives staff dispatched"
      }
      on other is {
        error "Unexpected message for adaptor FromStaffDispatchService"
      }
    } with {
      briefly "from staff dispatch service"
      described as {
        |Carries messages from the external StaffDispatchService.
      }
    }
  } with {
    briefly "StaffDispatchService integration"
    described as {
      |The model's side of the StaffDispatchService conversation.
    }
  }
  adaptor ToStaffDispatchService to context StaffDispatchService is { 
    handler ToStaffDispatchServiceHandler is {
      on command StaffDispatchService.DispatchStaff is {
        do "the model sends dispatch staff"
      }
      on query StaffDispatchService.GetAvailableStaff is {
        do "the model sends get available staff"
      }
      on other is {
        error "Unexpected message for adaptor ToStaffDispatchService"
      }
    } with {
      briefly "to staff dispatch service"
      described as {
        |Carries messages to the external StaffDispatchService.
      }
    }
  } with {
    briefly "StaffDispatchService integration"
    described as {
      |The model's side of the StaffDispatchService conversation.
    }
  }
  adaptor FromTelephonyService from context TelephonyService is { 
    handler FromTelephonyServiceHandler is {
      on event TelephonyService.GuestWakeupScheduled is {
        do "the model receives guest wakeup scheduled"
      }
      on event TelephonyService.WakeupCallCancelled is {
        do "the model receives wakeup call cancelled"
      }
      on event TelephonyService.WakeupCallPlaced is {
        do "the model receives wakeup call placed"
      }
      on other is {
        error "Unexpected message for adaptor FromTelephonyService"
      }
    } with {
      briefly "from telephony service"
      described as {
        |Carries messages from the external TelephonyService.
      }
    }
  } with {
    briefly "TelephonyService integration"
    described as {
      |The model's side of the TelephonyService conversation.
    }
  }
  adaptor ToTelephonyService to context TelephonyService is { 
    handler ToTelephonyServiceHandler is {
      on command TelephonyService.CancelWakeupCall is {
        do "the model sends cancel wakeup call"
      }
      on command TelephonyService.ScheduleGuestWakeup is {
        do "the model sends schedule guest wakeup"
      }
      on other is {
        error "Unexpected message for adaptor ToTelephonyService"
      }
    } with {
      briefly "to telephony service"
      described as {
        |Carries messages to the external TelephonyService.
      }
    }
  } with {
    briefly "TelephonyService integration"
    described as {
      |The model's side of the TelephonyService conversation.
    }
  }
  include "types.riddl"
  include "ServiceRequest.riddl"
  // Repository for service request persistence
  repository ServiceRequestRepository as merge is {
    inlet ServiceRequestRepositoryFromServiceRequest is type ServiceRequestEvent    inlet ServiceRequestRepositoryFromServiceAnalytics is type ServiceRequestEvent    outlet ServiceRequestRepositoryResponses is type ServiceRequest.ServiceRequestResult
    record StoredServiceRequest is  {
      serviceRequestId: ServiceRequestId with {
        briefly "serviceRequestId"
        described as {
          |The serviceRequestId column of the stored serviceRequest row.
        }
      }
      guest: GuestInfo with {
        briefly "guest"
        described as {
          |The guest column of the stored serviceRequest row.
        }
      }
      request: ServiceRequestDetails with {
        briefly "request"
        described as {
          |The request column of the stored serviceRequest row.
        }
      }
      requestId: ServiceRequestId with {
        briefly "requestId"
        described as {
          |The requestId column of the stored serviceRequest row.
        }
      }
      status: RequestStatus with {
        briefly "status"
        described as {
          |The status column of the stored serviceRequest row.
        }
      }
    } with {
      briefly "Stored serviceRequest row"
      described as {
        |The persistence shape of serviceRequest data as this repository stores it.
      }
    }
    schema ServiceRequestData is relational
      of requests as type StoredServiceRequest
        index on field StoredServiceRequest.requestId
        index on field StoredServiceRequest.guest.guestId
        index on field StoredServiceRequest.guest.roomNumber
        index on field StoredServiceRequest.request.category
        index on field StoredServiceRequest.status
 with {
      briefly "Service request data schema"
      described as {
        |The relational schema holding service request data for the ServiceRequestRepository.
      }
    }
    handler ServiceRequestPersistence is {
      on query GetServiceStats is {
        do "read the service stats projection"
        reply result ServiceStatsView
      }
      on command ServiceRequest.CreateServiceRequest is {
        tell event ServiceRequest.ServiceRequestCreated to entity ServiceRequestContext.ServiceRequest
        do "Store new service request"
      }
      on command ServiceRequest.UpdateRequestDetails is {
        tell event ServiceRequest.RequestDetailsUpdated to entity ServiceRequestContext.ServiceRequest
        do "Update request details"
      }
      on command ServiceRequest.AssignStaff is {
        tell event ServiceRequest.StaffAssigned to entity ServiceRequestContext.ServiceRequest
        do "Store staff assignment"
      }
      on command ServiceRequest.StartService is {
        tell event ServiceRequest.ServiceStarted to entity ServiceRequestContext.ServiceRequest
        do "Update to in progress"
      }
      on command ServiceRequest.CompleteService is {
        tell event ServiceRequest.ServiceCompleted to entity ServiceRequestContext.ServiceRequest
        do "Update to completed"
      }
      on command ServiceRequest.CancelRequest is {
        tell event ServiceRequest.RequestCancelled to entity ServiceRequestContext.ServiceRequest
        do "Update to cancelled"
      }
      on command ServiceRequest.EscalateRequest is {
        do "Update priority"
      }
      on command ServiceRequest.RecordFeedback is {
        tell event ServiceRequest.FeedbackRecorded to entity ServiceRequestContext.ServiceRequest
        do "Store feedback"
      }
      on command ServiceRequest.AddRoomServiceOrder is {
        tell event ServiceRequest.RoomServiceOrderAdded to entity ServiceRequestContext.ServiceRequest
        do "Store room service order"
      }
      on command ServiceRequest.AddLaundryOrder is {
        tell event ServiceRequest.LaundryOrderAdded to entity ServiceRequestContext.ServiceRequest
        do "Store laundry order"
      }
      on command ServiceRequest.ScheduleWakeupCall is {
        tell event ServiceRequest.WakeupCallScheduled to entity ServiceRequestContext.ServiceRequest
        do "Store wakeup call"
      }
    } with {
      briefly "Persists service request events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Service request data persistence"
    described as {
      | The ServiceRequestRepository provides persistent
      | storage for service requests.
    }
  }
  // Projector for service analytics
  query GetServiceStats is  {
    serviceStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which service stats to retrieve.
      }
    }
  } with {
    briefly "Get service stats"
    described as {
      |Retrieves the service stats projection.
    }
  }
  result ServiceStatsView is  {
    serviceStats: ServiceAnalytics.ServiceStats with {
      briefly "Service stats"
      described as {
        |The service stats being returned.
      }
    }
  } with {
    briefly "Service stats view"
    described as {
      |Read model view carrying the service stats projection.
    }
  }
  projector ServiceAnalytics as flow is {
    updates repository ServiceRequestContext.ServiceRequestRepository
    inlet ServiceAnalyticsFromServiceRequest is type ServiceRequestEvent    outlet ServiceAnalyticsOut is type ServiceRequestEvent
    record ServiceStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalRequests: Natural with {
        briefly "Total"
        described as {
          |Total requests.
        }
      }
      completedRequests: Natural with {
        briefly "Completed"
        described as {
          |Completed requests.
        }
      }
      averageResponseTime: Duration with {
        briefly "Response time"
        described as {
          |Avg response time.
        }
      }
      averageFulfillmentTime: Duration with {
        briefly "Fulfillment time"
        described as {
          |Avg fulfillment time.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      requestsByCategory: Natural+ with {
        briefly "By category"
        described as {
          |Requests by category.
        }
      }
    } with {
      briefly "Service statistics"
      described as {
        |Daily service metrics.
      }
    }
    handler AnalyticsHandler is {
      on event ServiceRequest.ServiceRequestCreated is {
        tell event ServiceRequest.ServiceRequestCreated to repository ServiceRequestContext.ServiceRequestRepository
        do "Update request counts"
      }
      on event ServiceRequest.StaffAssigned is {
        tell event ServiceRequest.StaffAssigned to repository ServiceRequestContext.ServiceRequestRepository
        do "Calculate response time"
      }
      on event ServiceRequest.ServiceCompleted is {
        tell event ServiceRequest.ServiceCompleted to repository ServiceRequestContext.ServiceRequestRepository
        do "Update completion metrics"
      }
      on event ServiceRequest.FeedbackRecorded is {
        tell event ServiceRequest.FeedbackRecorded to repository ServiceRequestContext.ServiceRequestRepository
        do "Update rating metrics"
      }
    } with {
      briefly "Maintains service analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Service analytics projections"
    described as {
      |Maintains service quality analytics.
    }
  }
  // ---- Event publication for ServiceRequest ----
  type ServiceRequestEvent is one of {
    ServiceRequestContext.ServiceRequest.ServiceRequestCreated or ServiceRequestContext.ServiceRequest.RequestDetailsUpdated or ServiceRequestContext.ServiceRequest.StaffAssigned or ServiceRequestContext.ServiceRequest.ServiceStarted or ServiceRequestContext.ServiceRequest.ServiceCompleted or ServiceRequestContext.ServiceRequest.RequestCancelled or ServiceRequestContext.ServiceRequest.RequestEscalated or ServiceRequestContext.ServiceRequest.FeedbackRecorded or ServiceRequestContext.ServiceRequest.RoomServiceOrderAdded or ServiceRequestContext.ServiceRequest.LaundryOrderAdded or ServiceRequestContext.ServiceRequest.WakeupCallScheduled
  } with {
    briefly "ServiceRequest event alternation"
    described as {
      |Union of all ServiceRequest events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ServiceRequestEventSource as source is {
    outlet ServiceRequestEvents is type ServiceRequestEvent
    handler ServiceRequestSourceHandler is {
      on event ServiceRequest.ServiceRequestCreated is {
        send event ServiceRequest.ServiceRequestCreated to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RequestDetailsUpdated is {
        send event ServiceRequest.RequestDetailsUpdated to outlet ServiceRequestEvents
      }
      on event ServiceRequest.StaffAssigned is {
        send event ServiceRequest.StaffAssigned to outlet ServiceRequestEvents
      }
      on event ServiceRequest.ServiceStarted is {
        send event ServiceRequest.ServiceStarted to outlet ServiceRequestEvents
      }
      on event ServiceRequest.ServiceCompleted is {
        send event ServiceRequest.ServiceCompleted to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RequestCancelled is {
        send event ServiceRequest.RequestCancelled to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RequestEscalated is {
        send event ServiceRequest.RequestEscalated to outlet ServiceRequestEvents
      }
      on event ServiceRequest.FeedbackRecorded is {
        send event ServiceRequest.FeedbackRecorded to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RoomServiceOrderAdded is {
        send event ServiceRequest.RoomServiceOrderAdded to outlet ServiceRequestEvents
      }
      on event ServiceRequest.LaundryOrderAdded is {
        send event ServiceRequest.LaundryOrderAdded to outlet ServiceRequestEvents
      }
      on event ServiceRequest.WakeupCallScheduled is {
        send event ServiceRequest.WakeupCallScheduled to outlet ServiceRequestEvents
      }
      on other is {
        error "Unexpected message for source ServiceRequestEventSource"
      }
    } with {
      briefly "ServiceRequest source handler"
      described as {
        |Publishes ServiceRequest events onto the outlet.
      }
    }
  } with {
    briefly "ServiceRequest event source"
    described as {
      |Publishes ServiceRequest entity events into the streaming topology.
    }
  }
  processor ServiceRequestEventSink as sink is {
    inlet ServiceRequestInlet is type ServiceRequestEvent    handler ServiceRequestSinkHandler is {
      on event ServiceRequest.ServiceRequestCreated is {
        tell event ServiceRequest.ServiceRequestCreated to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RequestDetailsUpdated is {
        tell event ServiceRequest.RequestDetailsUpdated to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.StaffAssigned is {
        tell event ServiceRequest.StaffAssigned to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.ServiceStarted is {
        tell event ServiceRequest.ServiceStarted to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.ServiceCompleted is {
        tell event ServiceRequest.ServiceCompleted to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RequestCancelled is {
        tell event ServiceRequest.RequestCancelled to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RequestEscalated is {
        tell event ServiceRequest.RequestEscalated to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.FeedbackRecorded is {
        tell event ServiceRequest.FeedbackRecorded to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RoomServiceOrderAdded is {
        tell event ServiceRequest.RoomServiceOrderAdded to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.LaundryOrderAdded is {
        tell event ServiceRequest.LaundryOrderAdded to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.WakeupCallScheduled is {
        tell event ServiceRequest.WakeupCallScheduled to repository ServiceRequestContext.ServiceRequestRepository
      }
      on other is {
        error "Unexpected message for sink ServiceRequestEventSink"
      }
    } with {
      briefly "ServiceRequest sink handler"
      described as {
        |Persists ServiceRequest events via the repository.
      }
    }
  } with {
    briefly "ServiceRequest event sink"
    described as {
      |Receives ServiceRequest events for persistence.
    }
  }
  connector ServiceRequestEventFlow is from outlet ServiceRequestContext.ServiceRequestEventSource.ServiceRequestEvents to inlet ServiceRequestContext.ServiceRequestEventSink.ServiceRequestInlet with {
    briefly "ServiceRequest event flow"
    described as {
      |Connects the ServiceRequest source to its sink.
    }
  }
  processor ServiceRequestEventSplit as split is {
    inlet ServiceRequestEventSplitIn is type ServiceRequestEvent    outlet ServiceRequestEventSplitToServiceRequestRepository is type ServiceRequestEvent
    outlet ServiceRequestEventSplitToServiceAnalytics is type ServiceRequestEvent
    handler ServiceRequestEventSplitHandler is {
      on event ServiceRequest.ServiceRequestCreated is {
        send event ServiceRequest.ServiceRequestCreated to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.ServiceRequestCreated to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.ServiceRequestCreated to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.RequestDetailsUpdated is {
        send event ServiceRequest.RequestDetailsUpdated to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.RequestDetailsUpdated to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.RequestDetailsUpdated to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.StaffAssigned is {
        send event ServiceRequest.StaffAssigned to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.StaffAssigned to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.StaffAssigned to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.ServiceStarted is {
        send event ServiceRequest.ServiceStarted to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.ServiceStarted to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.ServiceStarted to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.ServiceCompleted is {
        send event ServiceRequest.ServiceCompleted to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.ServiceCompleted to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.ServiceCompleted to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.RequestCancelled is {
        send event ServiceRequest.RequestCancelled to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.RequestCancelled to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.RequestCancelled to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.RequestEscalated is {
        send event ServiceRequest.RequestEscalated to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.RequestEscalated to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.RequestEscalated to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.FeedbackRecorded is {
        send event ServiceRequest.FeedbackRecorded to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.FeedbackRecorded to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.FeedbackRecorded to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.RoomServiceOrderAdded is {
        send event ServiceRequest.RoomServiceOrderAdded to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.RoomServiceOrderAdded to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.RoomServiceOrderAdded to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.LaundryOrderAdded is {
        send event ServiceRequest.LaundryOrderAdded to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.LaundryOrderAdded to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.LaundryOrderAdded to entity ServiceRequestContext.ServiceRequest
      }
      on event ServiceRequest.WakeupCallScheduled is {
        send event ServiceRequest.WakeupCallScheduled to outlet ServiceRequestEventSplitToServiceRequestRepository
        send event ServiceRequest.WakeupCallScheduled to outlet ServiceRequestEventSplitToServiceAnalytics
        tell event ServiceRequest.WakeupCallScheduled to entity ServiceRequestContext.ServiceRequest
      }
      on other is {
        error "Unexpected message for processor ServiceRequestEventSplit"
      }
    } with {
      briefly "ServiceRequest event fan-out handler"
      described as {
        |Delivers each ServiceRequest event to all of its consumers.
      }
    }
  } with {
    briefly "ServiceRequest event fan-out"
    described as {
      |Fans ServiceRequest events out to the repository and projectors.
    }
  }
  connector 'ServiceRequestEvent Stream' is from outlet ServiceRequestContext.ServiceRequest.ServiceRequestEvents2 to inlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitIn with {
    briefly "ServiceRequest events, fanned out to storage and read models"
  }
  connector 'ServiceRequestEvent Storage' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToServiceRequestRepository to inlet ServiceRequestContext.ServiceRequestRepository.ServiceRequestRepositoryFromServiceRequest with {
    briefly "ServiceRequest events on their way to storage"
  }
  connector 'ServiceAnalytics Feed' is from outlet ServiceRequestContext.ServiceRequestEventSplit.ServiceRequestEventSplitToServiceAnalytics to inlet ServiceRequestContext.ServiceAnalytics.ServiceAnalyticsFromServiceRequest with {
    briefly "ServiceRequest events feeding the ServiceAnalytics projection"
  }
  connector 'ServiceAnalytics Storage' is from outlet ServiceRequestContext.ServiceAnalytics.ServiceAnalyticsOut to inlet ServiceRequestContext.ServiceRequestRepository.ServiceRequestRepositoryFromServiceAnalytics with {
    briefly "The ServiceAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for service requests"
  described as {
    | The ServiceRequestContext is the bounded context
    | for guest service request management.
  }
}
