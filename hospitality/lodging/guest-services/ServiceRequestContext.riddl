// Guest Services - Service Request Context
context ServiceRequestContext is {
  include "types.riddl"
  include "ServiceRequest.riddl"
  // Repository for service request persistence
  repository ServiceRequestRepository is {
    schema ServiceRequestData is relational
      of requests as type ServiceRequest
        index on field ServiceRequest.requestId
        index on field ServiceRequest.guest.guestId
        index on field ServiceRequest.guest.roomNumber
        index on field ServiceRequest.request.category
        index on field ServiceRequest.status

    handler ServiceRequestPersistence is {
      on command ServiceRequest.CreateServiceRequest is {
        tell event ServiceRequest.ServiceRequestCreated to entity ServiceRequestContext.ServiceRequest
        prompt "Store new service request"
      }
      on command ServiceRequest.UpdateRequestDetails is {
        tell event ServiceRequest.RequestDetailsUpdated to entity ServiceRequestContext.ServiceRequest
        prompt "Update request details"
      }
      on command ServiceRequest.AssignStaff is {
        tell event ServiceRequest.StaffAssigned to entity ServiceRequestContext.ServiceRequest
        prompt "Store staff assignment"
      }
      on command ServiceRequest.StartService is {
        tell event ServiceRequest.ServiceStarted to entity ServiceRequestContext.ServiceRequest
        prompt "Update to in progress"
      }
      on command ServiceRequest.CompleteService is {
        tell event ServiceRequest.ServiceCompleted to entity ServiceRequestContext.ServiceRequest
        prompt "Update to completed"
      }
      on command ServiceRequest.CancelRequest is {
        tell event ServiceRequest.RequestCancelled to entity ServiceRequestContext.ServiceRequest
        prompt "Update to cancelled"
      }
      on command ServiceRequest.EscalateRequest is {
        prompt "Update priority"
      }
      on command ServiceRequest.RecordFeedback is {
        tell event ServiceRequest.FeedbackRecorded to entity ServiceRequestContext.ServiceRequest
        prompt "Store feedback"
      }
      on command ServiceRequest.AddRoomServiceOrder is {
        tell event ServiceRequest.RoomServiceOrderAdded to entity ServiceRequestContext.ServiceRequest
        prompt "Store room service order"
      }
      on command ServiceRequest.AddLaundryOrder is {
        tell event ServiceRequest.LaundryOrderAdded to entity ServiceRequestContext.ServiceRequest
        prompt "Store laundry order"
      }
      on command ServiceRequest.ScheduleWakeupCall is {
        tell event ServiceRequest.WakeupCallScheduled to entity ServiceRequestContext.ServiceRequest
        prompt "Store wakeup call"
      }
    } with {
      briefly "Persists service request events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Service request data persistence"
    described as {
      | The ServiceRequestRepository provides persistent
      | storage for service requests.
    }
  }
  // Projector for service analytics
  projector ServiceAnalytics is {
    updates repository ServiceRequestContext.ServiceRequestRepository
    record ServiceStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalRequests: Natural with {
        briefly "Total"
        described as {
          |Total requests.
        }
      }
      completedRequests: Natural with {
        briefly "Completed"
        described as {
          |Completed requests.
        }
      }
      averageResponseTime: Duration with {
        briefly "Response time"
        described as {
          |Avg response time.
        }
      }
      averageFulfillmentTime: Duration with {
        briefly "Fulfillment time"
        described as {
          |Avg fulfillment time.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
      requestsByCategory: Natural+ with {
        briefly "By category"
        described as {
          |Requests by category.
        }
      }
    } with {
      briefly "Service statistics"
      described as {
        |Daily service metrics.
      }
    }
    handler AnalyticsHandler is {
      on event ServiceRequest.ServiceRequestCreated is {
        tell event ServiceRequest.ServiceRequestCreated to repository ServiceRequestContext.ServiceRequestRepository
        prompt "Update request counts"
      }
      on event ServiceRequest.StaffAssigned is {
        tell event ServiceRequest.StaffAssigned to repository ServiceRequestContext.ServiceRequestRepository
        prompt "Calculate response time"
      }
      on event ServiceRequest.ServiceCompleted is {
        tell event ServiceRequest.ServiceCompleted to repository ServiceRequestContext.ServiceRequestRepository
        prompt "Update completion metrics"
      }
      on event ServiceRequest.FeedbackRecorded is {
        tell event ServiceRequest.FeedbackRecorded to repository ServiceRequestContext.ServiceRequestRepository
        prompt "Update rating metrics"
      }
    } with {
      briefly "Maintains service analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Service analytics projections"
    described as {
      |Maintains service quality analytics.
    }
  }
  // ---- Event publication for ServiceRequest ----
  type ServiceRequestEvent is one of {
    ServiceRequestContext.ServiceRequest.ServiceRequestCreated,
    ServiceRequestContext.ServiceRequest.RequestDetailsUpdated,
    ServiceRequestContext.ServiceRequest.StaffAssigned,
    ServiceRequestContext.ServiceRequest.ServiceStarted,
    ServiceRequestContext.ServiceRequest.ServiceCompleted,
    ServiceRequestContext.ServiceRequest.RequestCancelled,
    ServiceRequestContext.ServiceRequest.RequestEscalated,
    ServiceRequestContext.ServiceRequest.FeedbackRecorded,
    ServiceRequestContext.ServiceRequest.RoomServiceOrderAdded,
    ServiceRequestContext.ServiceRequest.LaundryOrderAdded,
    ServiceRequestContext.ServiceRequest.WakeupCallScheduled
  } with {
    briefly "ServiceRequest event alternation"
    described as {
      |Union of all ServiceRequest events, for streaming and event-sourced
      |persistence.
    }
  }
  source ServiceRequestEventSource is {
    outlet ServiceRequestEvents is type ServiceRequestEvent
    handler ServiceRequestSourceHandler is {
      on event ServiceRequest.ServiceRequestCreated is {
        send event ServiceRequest.ServiceRequestCreated to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RequestDetailsUpdated is {
        send event ServiceRequest.RequestDetailsUpdated to outlet ServiceRequestEvents
      }
      on event ServiceRequest.StaffAssigned is {
        send event ServiceRequest.StaffAssigned to outlet ServiceRequestEvents
      }
      on event ServiceRequest.ServiceStarted is {
        send event ServiceRequest.ServiceStarted to outlet ServiceRequestEvents
      }
      on event ServiceRequest.ServiceCompleted is {
        send event ServiceRequest.ServiceCompleted to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RequestCancelled is {
        send event ServiceRequest.RequestCancelled to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RequestEscalated is {
        send event ServiceRequest.RequestEscalated to outlet ServiceRequestEvents
      }
      on event ServiceRequest.FeedbackRecorded is {
        send event ServiceRequest.FeedbackRecorded to outlet ServiceRequestEvents
      }
      on event ServiceRequest.RoomServiceOrderAdded is {
        send event ServiceRequest.RoomServiceOrderAdded to outlet ServiceRequestEvents
      }
      on event ServiceRequest.LaundryOrderAdded is {
        send event ServiceRequest.LaundryOrderAdded to outlet ServiceRequestEvents
      }
      on event ServiceRequest.WakeupCallScheduled is {
        send event ServiceRequest.WakeupCallScheduled to outlet ServiceRequestEvents
      }
      on other is {
        error "Unexpected message for source ServiceRequestEventSource"
      }
    } with {
      briefly "ServiceRequest source handler"
      described as {
        |Publishes ServiceRequest events onto the outlet.
      }
    }
  } with {
    briefly "ServiceRequest event source"
    described as {
      |Publishes ServiceRequest entity events into the streaming topology.
    }
  }
  sink ServiceRequestEventSink is {
    inlet ServiceRequestInlet is type ServiceRequestEvent
    handler ServiceRequestSinkHandler is {
      on event ServiceRequest.ServiceRequestCreated is {
        tell event ServiceRequest.ServiceRequestCreated to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RequestDetailsUpdated is {
        tell event ServiceRequest.RequestDetailsUpdated to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.StaffAssigned is {
        tell event ServiceRequest.StaffAssigned to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.ServiceStarted is {
        tell event ServiceRequest.ServiceStarted to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.ServiceCompleted is {
        tell event ServiceRequest.ServiceCompleted to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RequestCancelled is {
        tell event ServiceRequest.RequestCancelled to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RequestEscalated is {
        tell event ServiceRequest.RequestEscalated to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.FeedbackRecorded is {
        tell event ServiceRequest.FeedbackRecorded to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.RoomServiceOrderAdded is {
        tell event ServiceRequest.RoomServiceOrderAdded to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.LaundryOrderAdded is {
        tell event ServiceRequest.LaundryOrderAdded to repository ServiceRequestContext.ServiceRequestRepository
      }
      on event ServiceRequest.WakeupCallScheduled is {
        tell event ServiceRequest.WakeupCallScheduled to repository ServiceRequestContext.ServiceRequestRepository
      }
      on other is {
        error "Unexpected message for sink ServiceRequestEventSink"
      }
    } with {
      briefly "ServiceRequest sink handler"
      described as {
        |Persists ServiceRequest events via the repository.
      }
    }
  } with {
    briefly "ServiceRequest event sink"
    described as {
      |Receives ServiceRequest events for persistence.
    }
  }
  connector ServiceRequestEventFlow is {
    from outlet ServiceRequestContext.ServiceRequestEventSource.ServiceRequestEvents to
      inlet ServiceRequestContext.ServiceRequestEventSink.ServiceRequestInlet
  } with {
    briefly "ServiceRequest event flow"
    described as {
      |Connects the ServiceRequest source to its sink.
    }
  }
} with {
  briefly "Bounded context for service requests"
  described as {
    | The ServiceRequestContext is the bounded context
    | for guest service request management.
  }
}
