  event LaundryDelivered is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    deliveredAt: TimeStamp with {
      briefly "Delivered"
      described as {
        |Delivery time.
      }
    }
  } with {
    briefly "Laundry delivered"
    described as {
      |Emitted when laundry is returned.
    }
  }
} with {
  briefly "External laundry service"
  described as {
    |External laundry management system.
  }
}
// Telephony Service
external context TelephonyService as flow is {
  type TelephonyServiceEvent is one of {
    GuestWakeupScheduled or WakeupCallPlaced or WakeupCallCancelled
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet TelephonyServiceEventsOut is type TelephonyServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type TelephonyServiceCommand is one of {
    ScheduleGuestWakeup or CancelWakeupCall
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet TelephonyServiceRequests is type TelephonyServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler TelephonyServiceBoundary is {
    on command ScheduleGuestWakeup is {
      let guestWakeupScheduled: type GuestWakeupScheduled = prompt("the guest wakeup scheduled this produces")
      send guestWakeupScheduled to outlet TelephonyService.TelephonyServiceEventsOut
      do "deliver it to the recipient"
    }
    on command CancelWakeupCall is {
      let wakeupCallCancelled: type WakeupCallCancelled = prompt("the wakeup call cancelled this produces")
      send wakeupCallCancelled to outlet TelephonyService.TelephonyServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context TelephonyService"
    }
  } with {
    briefly "TelephonyService boundary"
  }
  command ScheduleGuestWakeup is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    roomNumber: String(1,20) with {
      briefly "Room"
      described as {
        |Room number.
      }
    }
    wakeupTime: TimeStamp with {
      briefly "Time"
      described as {
        |Wakeup time.
      }
    }
    recurring: Boolean with {
      briefly "Recurring"
      described as {
        |Daily recurring.
      }
    }
  } with {
    briefly "Schedule wakeup call"
    described as {
      |Schedules automated wakeup call.
    }
  }
  event GuestWakeupScheduled is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    scheduledFor: TimeStamp with {
      briefly "Scheduled"
      described as {
        |Scheduled time.
      }
    }
  } with {
    briefly "Wakeup scheduled"
    described as {
      |Emitted when call is scheduled.
    }
  }
  event WakeupCallPlaced is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    placedAt: TimeStamp with {
      briefly "Placed"
      described as {
        |Call time.
      }
    }
    answered: Boolean with {
      briefly "Answered"
      described as {
        |Was answered.
      }
    }
  } with {
    briefly "Wakeup call placed"
    described as {
      |Emitted when wakeup call is placed.
    }
  }
  command CancelWakeupCall is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    roomNumber: String(1,20) with {
      briefly "Room"
      described as {
        |Room number.
      }
    }
  } with {
    briefly "Cancel wakeup call"
    described as {
      |Cancels scheduled wakeup call.
    }
  }
  event WakeupCallCancelled is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Wakeup cancelled"
    described as {
      |Emitted when call is cancelled.
    }
  }
} with {
  briefly "External telephony"
  described as {
    |External phone system integration.
  }
}
// Billing Service
external context BillingService as flow is {
  outlet BillingServiceEventsOut is event ChargePosted
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet BillingServiceRequests is command PostCharge with {
    briefly "What this context asks the service to send"
  }
  handler BillingServiceBoundary is {
    on command PostCharge is {
      let chargePosted: type ChargePosted = prompt("the charge posted this produces")
      send chargePosted to outlet BillingService.BillingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context BillingService"
    }
  } with {
    briefly "BillingService boundary"
  }
  command PostCharge is {
    guestId: GuestId with {
      briefly "Guest"
      described as {
        |Guest ID.
      }
    }
    roomNumber: String(1,20) with {
      briefly "Room"
      described as {
        |Room number.
      }
    }
    description: String(1,200) with {
      briefly "Description"
      described as {
        |Charge description.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Charge amount.
      }
    }
    chargeCategory: String(1,50) with {
      briefly "Category"
      described as {
        |Charge category.
      }
    }
  } with {
    briefly "Post charge"
    described as {
      |Posts charge to guest folio.
    }
  }
  event ChargePosted is {
    guestId: GuestId with {
      briefly "Guest"
      described as {
        |Guest ID.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Charge amount.
      }
    }
    postedAt: TimeStamp with {
      briefly "Posted"
      described as {
        |Post time.
      }
    }
  } with {
    briefly "Charge posted"
    described as {
      |Emitted when charge is posted.
    }
  }
} with {
  briefly "External billing"
  described as {
    |External property billing system.
  }
}
// Guest Notification Service
external context GuestNotificationService as flow is {
  type GuestNotificationServiceEvent is one of {
    FeedbackRequested or UpdateSent
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet GuestNotificationServiceEventsOut is type GuestNotificationServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  command SendServiceUpdate is {
    guestId: GuestId with {
      briefly "Guest"
      described as {
        |Guest ID.
      }
    }
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    message: String(1,500) with {
      briefly "Message"
      described as {
        |Update message.
      }
    }
    channel: String(1,20) with {
      briefly "Channel"
      described as {
        |Notification channel (sms, app, email).
      }
    }
  } with {
    briefly "Send service update"
    described as {
      |Sends status update to guest.
    }
  }
  event UpdateSent is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
    channel: String(1,20) with {
      briefly "Channel"
      described as {
        |Channel used.
      }
    }
  } with {
    briefly "Update sent"
    described as {
      |Emitted when update is sent.
    }
  }
  type GuestNotificationServiceCommand is one of {
    RequestFeedback or SendServiceUpdate
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet GuestNotificationServiceRequests is type GuestNotificationServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler GuestNotificationServiceBoundary is {
    on command RequestFeedback is {
      let feedbackRequested: type FeedbackRequested = prompt("the feedback requested this produces")
      send feedbackRequested to outlet GuestNotificationService.GuestNotificationServiceEventsOut
      do "deliver it to the recipient"
    }
    on command SendServiceUpdate is {
      let updateSent: type UpdateSent = prompt("the update sent this produces")
      send updateSent to outlet GuestNotificationService.GuestNotificationServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context GuestNotificationService"
    }
  } with {
    briefly "GuestNotificationService boundary"
  }
  command RequestFeedback is {
    guestId: GuestId with {
      briefly "Guest"
      described as {
        |Guest ID.
      }
    }
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
  } with {
    briefly "Request feedback"
    described as {
      |Requests guest feedback on service.
    }
  }
  event FeedbackRequested is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    requestedAt: TimeStamp with {
      briefly "Requested"
      described as {
        |Request time.
      }
    }
  } with {
    briefly "Feedback requested"
    described as {
      |Emitted when feedback is requested.
    }
  }
} with {
  briefly "External guest notification"
  described as {
    |External guest communication service.
  }
}
// Maintenance Service
external context MaintenanceService as flow is {
  type MaintenanceServiceEvent is one of {
    MaintenanceTicketCreated or MaintenanceCompleted
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet MaintenanceServiceEventsOut is type MaintenanceServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  inlet MaintenanceServiceRequests is command CreateMaintenanceTicket with {
    briefly "What this context asks the service to send"
  }
  handler MaintenanceServiceBoundary is {
    on command CreateMaintenanceTicket is {
      let maintenanceTicketCreated: type MaintenanceTicketCreated = prompt("the maintenance ticket created this produces")
      send maintenanceTicketCreated to outlet MaintenanceService.MaintenanceServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context MaintenanceService"
    }
  } with {
    briefly "MaintenanceService boundary"
  }
  command CreateMaintenanceTicket is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    roomNumber: String(1,20) with {
      briefly "Room"
      described as {
        |Room number.
      }
    }
    issue: String(1,500) with {
      briefly "Issue"
      described as {
        |Maintenance issue.
      }
    }
    priority: RequestPriority with {
      briefly "Priority"
      described as {
        |Issue priority.
      }
    }
  } with {
    briefly "Create maintenance ticket"
    described as {
      |Creates maintenance work order.
    }
  }
  event MaintenanceTicketCreated is {
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    ticketId: UUID with {
      briefly "Ticket"
      described as {
        |Maintenance ticket ID.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Ticket created"
    described as {
      |Emitted when ticket is created.
    }
  }
  event MaintenanceCompleted is {
    ticketId: UUID with {
      briefly "Ticket"
      described as {
        |Ticket ID.
      }
    }
    requestId: ServiceRequestId with {
      briefly "Request"
      described as {
        |Request ID.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
    resolution: String(1,500) with {
      briefly "Resolution"
      described as {
        |Issue resolution.
      }
    }
  } with {
    briefly "Maintenance completed"
    described as {
      |Emitted when maintenance is done.
    }
  }
} with {
  briefly "External maintenance"
  described as {
    |External maintenance management system.
  }
}
