// Guest Services Domain Model
// Hotel guest service request management
domain GuestServices is {
  persistent connector 'BillingServiceEvent Stream' is from outlet BillingService.BillingServiceEventsOut to inlet ServiceRequestContext.FromBillingService.FromBillingServiceIn with {
    briefly "What BillingService tells ServiceRequestContext, unasked"
  }
  persistent connector 'GuestNotificationServiceEvent Stream' is from outlet GuestNotificationService.GuestNotificationServiceEventsOut to inlet ServiceRequestContext.FromGuestNotificationService.FromGuestNotificationServiceIn with {
    briefly "What GuestNotificationService tells ServiceRequestContext, unasked"
  }
  persistent connector 'KitchenServiceEvent Stream' is from outlet KitchenService.KitchenServiceEventsOut to inlet ServiceRequestContext.FromKitchenService.FromKitchenServiceIn with {
    briefly "What KitchenService tells ServiceRequestContext, unasked"
  }
  persistent connector 'LaundryServiceEvent Stream' is from outlet LaundryService.LaundryServiceEventsOut to inlet ServiceRequestContext.FromLaundryService.FromLaundryServiceIn with {
    briefly "What LaundryService tells ServiceRequestContext, unasked"
  }
  persistent connector 'MaintenanceServiceEvent Stream' is from outlet MaintenanceService.MaintenanceServiceEventsOut to inlet ServiceRequestContext.FromMaintenanceService.FromMaintenanceServiceIn with {
    briefly "What MaintenanceService tells ServiceRequestContext, unasked"
  }
  persistent connector 'StaffDispatchServiceEvent Stream' is from outlet StaffDispatchService.StaffDispatchServiceEventsOut to inlet ServiceRequestContext.FromStaffDispatchService.FromStaffDispatchServiceIn with {
    briefly "What StaffDispatchService tells ServiceRequestContext, unasked"
  }
  persistent connector 'TelephonyServiceEvent Stream' is from outlet TelephonyService.TelephonyServiceEventsOut to inlet ServiceRequestContext.FromTelephonyService.FromTelephonyServiceIn with {
    briefly "What TelephonyService tells ServiceRequestContext, unasked"
  }
  persistent connector 'LaundryServiceRequest Stream' is from outlet ServiceRequestContext.ToLaundryService.ToLaundryServiceOut to inlet LaundryService.LaundryServiceRequests with {
    briefly "What ServiceRequestContext asks LaundryService to send"
  }
  persistent connector 'KitchenServiceRequest Stream' is from outlet ServiceRequestContext.ToKitchenService.ToKitchenServiceOut to inlet KitchenService.KitchenServiceRequests with {
    briefly "What ServiceRequestContext asks KitchenService to send"
  }
  persistent connector 'MaintenanceServiceRequest Stream' is from outlet ServiceRequestContext.ToMaintenanceService.ToMaintenanceServiceOut to inlet MaintenanceService.MaintenanceServiceRequests with {
    briefly "What ServiceRequestContext asks MaintenanceService to send"
  }
  persistent connector 'TelephonyServiceRequest Stream' is from outlet ServiceRequestContext.ToTelephonyService.ToTelephonyServiceOut to inlet TelephonyService.TelephonyServiceRequests with {
    briefly "What ServiceRequestContext asks TelephonyService to send"
  }
  persistent connector 'StaffDispatchServiceRequest Stream' is from outlet ServiceRequestContext.ToStaffDispatchService.ToStaffDispatchServiceOut to inlet StaffDispatchService.StaffDispatchServiceRequests with {
    briefly "What ServiceRequestContext asks StaffDispatchService to send"
  }
  persistent connector 'BillingServiceRequest Stream' is from outlet ServiceRequestContext.ToBillingService.ToBillingServiceOut to inlet BillingService.BillingServiceRequests with {
    briefly "What ServiceRequestContext asks BillingService to send"
  }
  persistent connector 'GuestNotificationServiceRequest Stream' is from outlet ServiceRequestContext.ToGuestNotificationService.ToGuestNotificationServiceOut to inlet GuestNotificationService.GuestNotificationServiceRequests with {
    briefly "What ServiceRequestContext asks GuestNotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Guest is "person requesting services" with {
    briefly "Guest"
    described as {
      |Hotel guest making service requests.
    }
  }
  user ConciergeStaff is "person fulfilling guest requests" with {
    briefly "Concierge"
    described as {
      |Staff handling guest service requests.
    }
  }
  user GuestServicesManager is "person overseeing service operations" with {
    briefly "Guest Services Manager"
    described as {
      |Manager overseeing guest services.
    }
  }
  epic GuestServiceEpic is {
    user Guest wants to "to request hotel services" so that "their stay is comfortable"
    case RequestService is {
      user Guest wants to "to submit a service request" so that "hotel staff can fulfill it"
      step is "Guest submits" "service request" "via app or phone" with {
        briefly "Submit request"
        described as {
          |Create service request.
        }
      }
      step take input GuestServicesApp.GuestServicesScreen.CreateServiceRequestInput from user Guest with {
        briefly "Create request"
        described as {
          |Record the request.
        }
      }
      step is "Staff receives" "and fulfills" "request" with {
        briefly "Fulfill"
        described as {
          |Complete the service.
        }
      }
    } with {
      briefly "Request service"
      described as {
        |Guest service request workflow.
      }
    }
  } with {
    briefly "Guest services"
    described as {
      | Epic covering service requests, fulfillment,
      | and guest feedback.
    }
  }
  include "ServiceRequestContext.riddl"
  include "external-contexts.riddl"
  application context GuestServicesApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in GuestServices are delivered.
      }
    }
    group GuestServicesScreen is {
      input CreateServiceRequestInput acquires command ServiceRequestContext.ServiceRequest.CreateServiceRequest with {
        briefly "Create service request control"
        described as {
          |The control through which a user submits the create service request request.
        }
      }
    } with {
      briefly "Guest services screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppServiceRequestCommands is type ServiceRequestContext.ServiceRequest.ServiceRequestCommand
    inlet AppServiceRequestRepositoryResponses is result ServiceRequestContext.ServiceRequest.ServiceRequestResult    handler GuestServicesAppHandler is {
      on other is {
        error "Unexpected message for application context GuestServicesApp"
      }
    } with {
      briefly "GuestServicesApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "GuestServicesApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ServiceRequestCommand Stream' is from outlet GuestServicesApp.AppServiceRequestCommands to inlet ServiceRequestContext.ServiceRequestCommandStreamIn with {
    briefly "ServiceRequest commands from the application"
  }
  persistent connector 'ServiceRequestResult Stream' is from outlet ServiceRequestContext.ServiceRequestResultStreamOut to inlet GuestServicesApp.AppServiceRequestRepositoryResponses with {
    briefly "ServiceRequest query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet GuestServicesApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Guest services domain"
  described as {
    | The GuestServices domain handles hotel
    | guest service requests and fulfillment.
  }
}
