// Guest Services Domain Model
// Hotel guest service request management
domain GuestServices is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Guest is "person requesting services" with {
    briefly "Guest"
    described as {
      |Hotel guest making service requests.
    }
  }
  user ConciergeStaff is "person fulfilling guest requests" with {
    briefly "Concierge"
    described as {
      |Staff handling guest service requests.
    }
  }
  user GuestServicesManager is "person overseeing service operations" with {
    briefly "Guest Services Manager"
    described as {
      |Manager overseeing guest services.
    }
  }
  epic GuestServiceEpic is {
    user Guest wants to "to request hotel services" so that "their stay is comfortable"
    case RequestService is {
      user Guest wants to "to submit a service request" so that "hotel staff can fulfill it"
      step is "Guest submits" "service request" "via app or phone" with {
        briefly "Submit request"
        described as {
          |Create service request.
        }
      }
      step take input GuestServicesApp.GuestServicesScreen.CreateServiceRequestInput from user Guest with {
        briefly "Create request"
        described as {
          |Record the request.
        }
      }
      step is "Staff receives" "and fulfills" "request" with {
        briefly "Fulfill"
        described as {
          |Complete the service.
        }
      }
    } with {
      briefly "Request service"
      described as {
        |Guest service request workflow.
      }
    }
  } with {
    briefly "Guest services"
    described as {
      | Epic covering service requests, fulfillment,
      | and guest feedback.
    }
  }
  include "ServiceRequestContext.riddl"
  include "external-contexts.riddl"
  application context GuestServicesApp is {
    group GuestServicesScreen is {
      input CreateServiceRequestInput acquires command ServiceRequestContext.ServiceRequest.CreateServiceRequest with {
        briefly "Create service request control"
        described as {
          |The control through which a user submits the create service request request.
        }
      }
    } with {
      briefly "Guest services screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppServiceRequestCommands is type ServiceRequestContext.ServiceRequest.ServiceRequestCommand
    inlet AppServiceRequestRepositoryResponses is type ServiceRequestContext.ServiceRequest.ServiceRequestResult    handler GuestServicesAppHandler is {
      on other is {
        error "Unexpected message for application context GuestServicesApp"
      }
    } with {
      briefly "GuestServicesApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "GuestServicesApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppServiceRequestCommands is from outlet GuestServicesApp.AppServiceRequestCommands to inlet ServiceRequestContext.ServiceRequest.ServiceRequestCommands with {
    option persistent()
    briefly "LinkAppServiceRequestCommands"
  }
  connector LinkAppServiceRequestRepositoryResponses is from outlet ServiceRequestContext.ServiceRequestRepository.ServiceRequestRepositoryResponses to inlet GuestServicesApp.AppServiceRequestRepositoryResponses with {
    option persistent()
    briefly "LinkAppServiceRequestRepositoryResponses"
  }
} with {
  briefly "Guest services domain"
  described as {
    | The GuestServices domain handles hotel
    | guest service requests and fulfillment.
  }
}
