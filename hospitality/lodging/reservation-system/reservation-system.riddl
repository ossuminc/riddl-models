// Reservation System Domain Model
// Hotel reservation booking and management
domain ReservationSystem is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user Guest is "person making a reservation" with {
    briefly "Guest"
    described as {
      |Person booking accommodation.
    }
  }
  user FrontDeskAgent is "person managing reservations" with {
    briefly "Front Desk Agent"
    described as {
      |Staff handling check-in and reservations.
    }
  }
  user ReservationManager is "person overseeing bookings" with {
    briefly "Reservation Manager"
    described as {
      |Manager overseeing reservation operations.
    }
  }
  epic ReservationEpic is {
    user Guest wants to "to book a hotel room" so that "they have confirmed accommodation"
    case BookRoom is {
      user Guest wants to "to make a room reservation" so that "they have a place to stay"
      step is "Guest searches" "available rooms" "for dates" with {
        briefly "Search availability"
        described as {
          |Find available rooms.
        }
      }
      step take input ReservationSystemApp.ReservationSystemScreen.CreateReservationInput from user Guest with {
        briefly "Create reservation"
        described as {
          |Book the room.
        }
      }
      step is "System confirms" "reservation details" "to guest" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Book room"
      described as {
        |Room reservation workflow.
      }
    }
  } with {
    briefly "Reservation management"
    described as {
      | Epic covering room booking, modifications,
      | and cancellation workflows.
    }
  }
  include "ReservationContext.riddl"
  include "external-contexts.riddl"
  application context ReservationSystemApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ReservationSystem are delivered.
      }
    }
    group ReservationSystemScreen is {
      input CreateReservationInput acquires command ReservationContext.Reservation.CreateReservation with {
        briefly "Create reservation control"
        described as {
          |The control through which a user submits the create reservation request.
        }
      }
    } with {
      briefly "Reservation system screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppReservationCommands is type ReservationContext.Reservation.ReservationCommand
    inlet AppReservationRepositoryResponses is type ReservationContext.Reservation.ReservationResult    handler ReservationSystemAppHandler is {
      on other is {
        error "Unexpected message for application context ReservationSystemApp"
      }
    } with {
      briefly "ReservationSystemApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ReservationSystemApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'ReservationCommand Stream' is from outlet ReservationSystemApp.AppReservationCommands to inlet ReservationContext.Reservation.ReservationCommands with {
    option persistent()
    briefly "Reservation commands from the application"
  }
  connector 'ReservationBoardView Stream' is from outlet ReservationContext.ReservationRepository.ReservationRepositoryResponses to inlet ReservationSystemApp.AppReservationRepositoryResponses with {
    option persistent()
    briefly "Reservation query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ReservationSystemApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Reservation system domain"
  described as {
    | The ReservationSystem domain handles hotel
    | room booking and reservation management.
  }
}
