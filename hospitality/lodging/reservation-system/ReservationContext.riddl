// Reservation System - Reservation Context
context ReservationContext is {
  adaptor FromChannelManagementService from context ChannelManagementService is { 
    handler FromChannelManagementServiceHandler is {
      on event ChannelManagementService.InventoryUpdated is {
        do "the model receives inventory updated"
      }
      on event ChannelManagementService.RatesSynced is {
        do "the model receives rates synced"
      }
      on other is {
        error "Unexpected message for adaptor FromChannelManagementService"
      }
    } with {
      briefly "from channel management service"
      described as {
        |Carries messages from the external ChannelManagementService.
      }
    }
  } with {
    briefly "ChannelManagementService integration"
    described as {
      |The model's side of the ChannelManagementService conversation.
    }
  }
  adaptor ToChannelManagementService to context ChannelManagementService is { 
    handler ToChannelManagementServiceHandler is {
      on command ChannelManagementService.SyncRates is {
        do "the model sends sync rates"
      }
      on command ChannelManagementService.UpdateInventory is {
        do "the model sends update inventory"
      }
      on other is {
        error "Unexpected message for adaptor ToChannelManagementService"
      }
    } with {
      briefly "to channel management service"
      described as {
        |Carries messages to the external ChannelManagementService.
      }
    }
  } with {
    briefly "ChannelManagementService integration"
    described as {
      |The model's side of the ChannelManagementService conversation.
    }
  }
  adaptor FromGuestCommunicationService from context GuestCommunicationService is { 
    handler FromGuestCommunicationServiceHandler is {
      on event GuestCommunicationService.CheckoutReceiptSent is {
        do "the model receives checkout receipt sent"
      }
      on event GuestCommunicationService.ConfirmationEmailSent is {
        do "the model receives confirmation email sent"
      }
      on event GuestCommunicationService.PreArrivalEmailSent is {
        do "the model receives pre arrival email sent"
      }
      on other is {
        error "Unexpected message for adaptor FromGuestCommunicationService"
      }
    } with {
      briefly "from guest communication service"
      described as {
        |Carries messages from the external GuestCommunicationService.
      }
    }
  } with {
    briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor ToGuestCommunicationService to context GuestCommunicationService is { 
    handler ToGuestCommunicationServiceHandler is {
      on command GuestCommunicationService.SendCheckoutReceipt is {
        do "the model sends send checkout receipt"
      }
      on command GuestCommunicationService.SendConfirmationEmail is {
        do "the model sends send confirmation email"
      }
      on command GuestCommunicationService.SendPreArrivalEmail is {
        do "the model sends send pre arrival email"
      }
      on other is {
        error "Unexpected message for adaptor ToGuestCommunicationService"
      }
    } with {
      briefly "to guest communication service"
      described as {
        |Carries messages to the external GuestCommunicationService.
      }
    }
  } with {
    briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor FromHousekeepingService from context HousekeepingService is { 
    handler FromHousekeepingServiceHandler is {
      on event HousekeepingService.CleaningRequested is {
        do "the model receives cleaning requested"
      }
      on event HousekeepingService.RoomCleaningCompleted is {
        do "the model receives room cleaning completed"
      }
      on other is {
        error "Unexpected message for adaptor FromHousekeepingService"
      }
    } with {
      briefly "from housekeeping service"
      described as {
        |Carries messages from the external HousekeepingService.
      }
    }
  } with {
    briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor ToHousekeepingService to context HousekeepingService is { 
    handler ToHousekeepingServiceHandler is {
      on command HousekeepingService.RequestRoomCleaning is {
        do "the model sends request room cleaning"
      }
      on other is {
        error "Unexpected message for adaptor ToHousekeepingService"
      }
    } with {
      briefly "to housekeeping service"
      described as {
        |Carries messages to the external HousekeepingService.
      }
    }
  } with {
    briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor FromLoyaltyProgramService from context LoyaltyProgramService is { 
    handler FromLoyaltyProgramServiceHandler is {
      on result LoyaltyProgramService.MemberTierResult is {
        do "the model receives member tier result"
      }
      on event LoyaltyProgramService.PointsAwarded is {
        do "the model receives points awarded"
      }
      on other is {
        error "Unexpected message for adaptor FromLoyaltyProgramService"
      }
    } with {
      briefly "from loyalty program service"
      described as {
        |Carries messages from the external LoyaltyProgramService.
      }
    }
  } with {
    briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor ToLoyaltyProgramService to context LoyaltyProgramService is { 
    handler ToLoyaltyProgramServiceHandler is {
      on command LoyaltyProgramService.AwardPoints is {
        do "the model sends award points"
      }
      on query LoyaltyProgramService.GetMemberTier is {
        do "the model sends get member tier"
      }
      on other is {
        error "Unexpected message for adaptor ToLoyaltyProgramService"
      }
    } with {
      briefly "to loyalty program service"
      described as {
        |Carries messages to the external LoyaltyProgramService.
      }
    }
  } with {
    briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentAuthorized is {
        do "the model receives payment authorized"
      }
      on event PaymentProcessingService.PaymentCaptured is {
        do "the model receives payment captured"
      }
      on event PaymentProcessingService.PaymentRefunded is {
        do "the model receives payment refunded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.AuthorizePayment is {
        do "the model sends authorize payment"
      }
      on command PaymentProcessingService.CapturePayment is {
        do "the model sends capture payment"
      }
      on command PaymentProcessingService.RefundPayment is {
        do "the model sends refund payment"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromRoomManagementService from context RoomManagementService is { 
    handler FromRoomManagementServiceHandler is {
      on result RoomManagementService.AvailableRoomsResult is {
        do "the model receives available rooms result"
      }
      on event RoomManagementService.RoomReleased is {
        do "the model receives room released"
      }
      on event RoomManagementService.RoomReserved is {
        do "the model receives room reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromRoomManagementService"
      }
    } with {
      briefly "from room management service"
      described as {
        |Carries messages from the external RoomManagementService.
      }
    }
  } with {
    briefly "RoomManagementService integration"
    described as {
      |The model's side of the RoomManagementService conversation.
    }
  }
  adaptor ToRoomManagementService to context RoomManagementService is { 
    handler ToRoomManagementServiceHandler is {
      on query RoomManagementService.GetAvailableRooms is {
        do "the model sends get available rooms"
      }
      on command RoomManagementService.ReleaseRoom is {
        do "the model sends release room"
      }
      on command RoomManagementService.ReserveRoom is {
        do "the model sends reserve room"
      }
      on other is {
        error "Unexpected message for adaptor ToRoomManagementService"
      }
    } with {
      briefly "to room management service"
      described as {
        |Carries messages to the external RoomManagementService.
      }
    }
  } with {
    briefly "RoomManagementService integration"
    described as {
      |The model's side of the RoomManagementService conversation.
    }
  }
  include "types.riddl"
  include "Reservation.riddl"
  // Repository for reservation persistence
  repository ReservationRepository as merge is {
    inlet ReservationRepositoryFromReservation is type ReservationEvent    inlet ReservationRepositoryFromReservationAnalytics is type ReservationEvent    outlet ReservationRepositoryResponses is type Reservation.ReservationResult
    record StoredReservation is  {
      reservationId: ReservationId with {
        briefly "reservationId"
        described as {
          |The reservationId column of the stored reservation row.
        }
      }
      guest: GuestInfo with {
        briefly "guest"
        described as {
          |The guest column of the stored reservation row.
        }
      }
      status: ReservationStatus with {
        briefly "status"
        described as {
          |The status column of the stored reservation row.
        }
      }
      stay: StayDetails with {
        briefly "stay"
        described as {
          |The stay column of the stored reservation row.
        }
      }
    } with {
      briefly "Stored reservation row"
      described as {
        |The persistence shape of reservation data as this repository stores it.
      }
    }
    schema ReservationData is relational
      of reservations as type StoredReservation
        index on field StoredReservation.reservationId
        index on field StoredReservation.guest.guestId
        index on field StoredReservation.stay.checkInDate
        index on field StoredReservation.stay.checkOutDate
        index on field StoredReservation.status
 with {
      briefly "Reservation data schema"
      described as {
        |The relational schema holding reservation data for the ReservationRepository.
      }
    }
    handler ReservationPersistence is {
      on query GetOccupancyStats is {
        do "read the occupancy stats projection"
        yield result OccupancyStatsView
      }
      on command Reservation.CreateReservation is {
        tell event Reservation.ReservationCreated to entity ReservationContext.Reservation
        do "Store new reservation"
      }
      on command Reservation.ModifyReservation is {
        do "Update reservation details"
      }
      on command Reservation.ConfirmReservation is {
        tell event Reservation.ReservationConfirmed to entity ReservationContext.Reservation
        do "Update confirmation status"
      }
      on command Reservation.AssignRoom is {
        tell event Reservation.RoomAssigned to entity ReservationContext.Reservation
        do "Store room assignment"
      }
      on command Reservation.CheckIn is {
        do "Update to checked in"
      }
      on command Reservation.AddCharge is {
        tell event Reservation.ChargeAdded to entity ReservationContext.Reservation
        do "Store charge"
      }
      on command Reservation.RecordPayment is {
        tell event Reservation.PaymentRecorded to entity ReservationContext.Reservation
        do "Store payment"
      }
      on command Reservation.CheckOut is {
        do "Update to checked out"
      }
      on command Reservation.CancelReservation is {
        tell event Reservation.ReservationCancelled to entity ReservationContext.Reservation
        do "Update to cancelled"
      }
      on command Reservation.MarkNoShow is {
        do "Update to no show"
      }
    } with {
      briefly "Persists reservation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reservation data persistence"
    described as {
      | The ReservationRepository provides persistent storage
      | for reservations and related data.
    }
  }
  // Projector for reservation analytics
  query GetOccupancyStats is  {
    occupancyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which occupancy stats to retrieve.
      }
    }
  } with {
    briefly "Get occupancy stats"
    described as {
      |Retrieves the occupancy stats projection.
    }
  }
  result OccupancyStatsView is  {
    occupancyStats: ReservationAnalytics.OccupancyStats with {
      briefly "Occupancy stats"
      described as {
        |The occupancy stats being returned.
      }
    }
  } with {
    briefly "Occupancy stats view"
    described as {
      |Read model view carrying the occupancy stats projection.
    }
  }
  projector ReservationAnalytics as flow is {
    updates repository ReservationContext.ReservationRepository
    inlet ReservationAnalyticsFromReservation is type ReservationEvent    outlet ReservationAnalyticsOut is type ReservationEvent
    record OccupancyStats is  {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalRooms: Natural with {
        briefly "Total"
        described as {
          |Total rooms.
        }
      }
      occupiedRooms: Natural with {
        briefly "Occupied"
        described as {
          |Occupied rooms.
        }
      }
      occupancyRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Occupancy rate.
        }
      }
      revenuePerRoom: Decimal(10,2) with {
        briefly "RevPAR"
        described as {
          |Revenue per available room.
        }
      }
      averageDailyRate: Decimal(10,2) with {
        briefly "ADR"
        described as {
          |Average daily rate.
        }
      }
    } with {
      briefly "Occupancy statistics"
      described as {
        |Daily occupancy metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Reservation.ReservationCreated is {
        tell event Reservation.ReservationCreated to repository ReservationContext.ReservationRepository
        do "Update booking metrics"
      }
      on event Reservation.GuestCheckedIn is {
        tell event Reservation.GuestCheckedIn to repository ReservationContext.ReservationRepository
        do "Update occupancy"
      }
      on event Reservation.GuestCheckedOut is {
        tell event Reservation.GuestCheckedOut to repository ReservationContext.ReservationRepository
        do "Update revenue metrics"
      }
      on event Reservation.ReservationCancelled is {
        tell event Reservation.ReservationCancelled to repository ReservationContext.ReservationRepository
        do "Update cancellation metrics"
      }
      on event Reservation.GuestMarkedNoShow is {
        tell event Reservation.GuestMarkedNoShow to repository ReservationContext.ReservationRepository
        do "Update no-show metrics"
      }
    } with {
      briefly "Maintains reservation analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Reservation analytics projections"
    described as {
      |Maintains occupancy and revenue analytics.
    }
  }
  // ---- Event publication for Reservation ----
  type ReservationEvent is one of {
    ReservationContext.Reservation.ReservationCreated or ReservationContext.Reservation.ReservationModified or ReservationContext.Reservation.ReservationConfirmed or ReservationContext.Reservation.RoomAssigned or ReservationContext.Reservation.GuestCheckedIn or ReservationContext.Reservation.ChargeAdded or ReservationContext.Reservation.PaymentRecorded or ReservationContext.Reservation.GuestCheckedOut or ReservationContext.Reservation.ReservationCancelled or ReservationContext.Reservation.GuestMarkedNoShow
  } with {
    briefly "Reservation event alternation"
    described as {
      |Union of all Reservation events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReservationEventSource as source is {
    outlet ReservationEvents is type ReservationEvent
    handler ReservationSourceHandler is {
      on event Reservation.ReservationCreated is {
        send event Reservation.ReservationCreated to outlet ReservationEvents
      }
      on event Reservation.ReservationModified is {
        send event Reservation.ReservationModified to outlet ReservationEvents
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEvents
      }
      on event Reservation.RoomAssigned is {
        send event Reservation.RoomAssigned to outlet ReservationEvents
      }
      on event Reservation.GuestCheckedIn is {
        send event Reservation.GuestCheckedIn to outlet ReservationEvents
      }
      on event Reservation.ChargeAdded is {
        send event Reservation.ChargeAdded to outlet ReservationEvents
      }
      on event Reservation.PaymentRecorded is {
        send event Reservation.PaymentRecorded to outlet ReservationEvents
      }
      on event Reservation.GuestCheckedOut is {
        send event Reservation.GuestCheckedOut to outlet ReservationEvents
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEvents
      }
      on event Reservation.GuestMarkedNoShow is {
        send event Reservation.GuestMarkedNoShow to outlet ReservationEvents
      }
      on other is {
        error "Unexpected message for source ReservationEventSource"
      }
    } with {
      briefly "Reservation source handler"
      described as {
        |Publishes Reservation events onto the outlet.
      }
    }
  } with {
    briefly "Reservation event source"
    described as {
      |Publishes Reservation entity events into the streaming topology.
    }
  }
  processor ReservationEventSink as sink is {
    inlet ReservationInlet is type ReservationEvent    handler ReservationSinkHandler is {
      on event Reservation.ReservationCreated is {
        tell event Reservation.ReservationCreated to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationModified is {
        tell event Reservation.ReservationModified to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationConfirmed is {
        tell event Reservation.ReservationConfirmed to repository ReservationContext.ReservationRepository
      }
      on event Reservation.RoomAssigned is {
        tell event Reservation.RoomAssigned to repository ReservationContext.ReservationRepository
      }
      on event Reservation.GuestCheckedIn is {
        tell event Reservation.GuestCheckedIn to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ChargeAdded is {
        tell event Reservation.ChargeAdded to repository ReservationContext.ReservationRepository
      }
      on event Reservation.PaymentRecorded is {
        tell event Reservation.PaymentRecorded to repository ReservationContext.ReservationRepository
      }
      on event Reservation.GuestCheckedOut is {
        tell event Reservation.GuestCheckedOut to repository ReservationContext.ReservationRepository
      }
      on event Reservation.ReservationCancelled is {
        tell event Reservation.ReservationCancelled to repository ReservationContext.ReservationRepository
      }
      on event Reservation.GuestMarkedNoShow is {
        tell event Reservation.GuestMarkedNoShow to repository ReservationContext.ReservationRepository
      }
      on other is {
        error "Unexpected message for sink ReservationEventSink"
      }
    } with {
      briefly "Reservation sink handler"
      described as {
        |Persists Reservation events via the repository.
      }
    }
  } with {
    briefly "Reservation event sink"
    described as {
      |Receives Reservation events for persistence.
    }
  }
  connector ReservationEventFlow is from outlet ReservationContext.ReservationEventSource.ReservationEvents to inlet ReservationContext.ReservationEventSink.ReservationInlet with {
    briefly "Reservation event flow"
    described as {
      |Connects the Reservation source to its sink.
    }
  }
  processor ReservationEventSplit as split is {
    inlet ReservationEventSplitIn is type ReservationEvent    outlet ReservationEventSplitToReservationRepository is type ReservationEvent
    outlet ReservationEventSplitToReservationAnalytics is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on event Reservation.ReservationCreated is {
        send event Reservation.ReservationCreated to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationCreated to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.ReservationCreated to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationModified is {
        send event Reservation.ReservationModified to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationModified to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.ReservationModified to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.ReservationConfirmed to entity ReservationContext.Reservation
      }
      on event Reservation.RoomAssigned is {
        send event Reservation.RoomAssigned to outlet ReservationEventSplitToReservationRepository
        send event Reservation.RoomAssigned to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.RoomAssigned to entity ReservationContext.Reservation
      }
      on event Reservation.GuestCheckedIn is {
        send event Reservation.GuestCheckedIn to outlet ReservationEventSplitToReservationRepository
        send event Reservation.GuestCheckedIn to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.GuestCheckedIn to entity ReservationContext.Reservation
      }
      on event Reservation.ChargeAdded is {
        send event Reservation.ChargeAdded to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ChargeAdded to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.ChargeAdded to entity ReservationContext.Reservation
      }
      on event Reservation.PaymentRecorded is {
        send event Reservation.PaymentRecorded to outlet ReservationEventSplitToReservationRepository
        send event Reservation.PaymentRecorded to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.PaymentRecorded to entity ReservationContext.Reservation
      }
      on event Reservation.GuestCheckedOut is {
        send event Reservation.GuestCheckedOut to outlet ReservationEventSplitToReservationRepository
        send event Reservation.GuestCheckedOut to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.GuestCheckedOut to entity ReservationContext.Reservation
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.ReservationCancelled to entity ReservationContext.Reservation
      }
      on event Reservation.GuestMarkedNoShow is {
        send event Reservation.GuestMarkedNoShow to outlet ReservationEventSplitToReservationRepository
        send event Reservation.GuestMarkedNoShow to outlet ReservationEventSplitToReservationAnalytics
        tell event Reservation.GuestMarkedNoShow to entity ReservationContext.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  connector 'ReservationEvent Stream' is from outlet ReservationContext.Reservation.ReservationEvents2 to inlet ReservationContext.ReservationEventSplit.ReservationEventSplitIn with {
    briefly "Reservation events, fanned out to storage and read models"
  }
  connector 'ReservationEvent Storage' is from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToReservationRepository to inlet ReservationContext.ReservationRepository.ReservationRepositoryFromReservation with {
    briefly "Reservation events on their way to storage"
  }
  connector 'ReservationAnalytics Feed' is from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToReservationAnalytics to inlet ReservationContext.ReservationAnalytics.ReservationAnalyticsFromReservation with {
    briefly "Reservation events feeding the ReservationAnalytics projection"
  }
  connector 'ReservationAnalytics Storage' is from outlet ReservationContext.ReservationAnalytics.ReservationAnalyticsOut to inlet ReservationContext.ReservationRepository.ReservationRepositoryFromReservationAnalytics with {
    briefly "The ReservationAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for reservations"
  described as {
    | The ReservationContext is the bounded context for
    | hotel reservation management.
  }
}
