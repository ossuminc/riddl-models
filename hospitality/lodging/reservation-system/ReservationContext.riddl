// Reservation System - Reservation Context
context ReservationContext as router is {
  inlet ReservationCommandStreamIn is type ReservationCommand  outlet ReservationCommandStreamOut is type ReservationCommand
  inlet ReservationBoardViewStreamIn is result Reservation.ReservationResult  outlet ReservationBoardViewStreamOut is result Reservation.ReservationResult
  handler ReservationContextBoundary is {
    on createReservation: command Reservation.CreateReservation is {
      send createReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on modifyReservation: command Reservation.ModifyReservation is {
      send modifyReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on confirmReservation: command Reservation.ConfirmReservation is {
      send confirmReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on assignRoom: command Reservation.AssignRoom is {
      send assignRoom to outlet ReservationContext.ReservationCommandStreamOut
    }
    on checkIn: command Reservation.CheckIn is {
      send checkIn to outlet ReservationContext.ReservationCommandStreamOut
    }
    on addCharge: command Reservation.AddCharge is {
      send addCharge to outlet ReservationContext.ReservationCommandStreamOut
    }
    on recordPayment: command Reservation.RecordPayment is {
      send recordPayment to outlet ReservationContext.ReservationCommandStreamOut
    }
    on checkOut: command Reservation.CheckOut is {
      send checkOut to outlet ReservationContext.ReservationCommandStreamOut
    }
    on cancelReservation: command Reservation.CancelReservation is {
      send cancelReservation to outlet ReservationContext.ReservationCommandStreamOut
    }
    on markNoShow: command Reservation.MarkNoShow is {
      send markNoShow to outlet ReservationContext.ReservationCommandStreamOut
    }
    on reservationResult: result Reservation.ReservationResult is {
      send reservationResult to outlet ReservationContext.ReservationBoardViewStreamOut
    }
    on other is {
      error "Unexpected message at the ReservationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ReservationCommand Stream Intake' is from outlet ReservationContext.ReservationCommandStreamOut to inlet ReservationContext.Reservation.ReservationCommands  connector 'ReservationBoardView Stream Egress' is from outlet ReservationContext.ReservationRepository.ReservationRepositoryResponses to inlet ReservationContext.ReservationBoardViewStreamIn  adaptor FromChannelManagementService from context ChannelManagementService is { 
    handler FromChannelManagementServiceHandler is {
      on event ChannelManagementService.InventoryUpdated is {
        do "the model receives inventory updated"
      }
      on event ChannelManagementService.RatesSynced is {
        do "the model receives rates synced"
      }
      on other is {
        error "Unexpected message for adaptor FromChannelManagementService"
      }
    } with {
      briefly "from channel management service"
      described as {
        |Carries messages from the external ChannelManagementService.
      }
    }
  } with {
    briefly "ChannelManagementService integration"
    described as {
      |The model's side of the ChannelManagementService conversation.
    }
  }
  adaptor ToChannelManagementService to context ChannelManagementService as flow is { 
    outlet ToChannelManagementServiceOut is command ChannelManagementService.UpdateInventory
    handler ToChannelManagementServiceHandler is {
      on reservationCreated: event Reservation.ReservationCreated is {
        let item0: type ChannelManagementService.UpdateInventory = prompt("translate the reservationCreated event into a UpdateInventory, a booking removing a room from the pool")
        send item0 to outlet ReservationContext.ToChannelManagementService.ToChannelManagementServiceOut
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        let item0: type ChannelManagementService.UpdateInventory = prompt("translate the reservationCancelled event into a UpdateInventory, and a cancellation returning it")
        send item0 to outlet ReservationContext.ToChannelManagementService.ToChannelManagementServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToChannelManagementService"
      }
    } with {
      briefly "to channel management service"
      described as {
        |Carries messages to the external ChannelManagementService.
      }
    }
  } with {
    briefly "ChannelManagementService integration"
    described as {
      |The model's side of the ChannelManagementService conversation.
    }
  }
  adaptor FromGuestCommunicationService from context GuestCommunicationService is { 
    handler FromGuestCommunicationServiceHandler is {
      on event GuestCommunicationService.CheckoutReceiptSent is {
        do "the model receives checkout receipt sent"
      }
      on event GuestCommunicationService.ConfirmationEmailSent is {
        do "the model receives confirmation email sent"
      }
      on event GuestCommunicationService.PreArrivalEmailSent is {
        do "the model receives pre arrival email sent"
      }
      on other is {
        error "Unexpected message for adaptor FromGuestCommunicationService"
      }
    } with {
      briefly "from guest communication service"
      described as {
        |Carries messages from the external GuestCommunicationService.
      }
    }
  } with {
    briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor ToGuestCommunicationService to context GuestCommunicationService as flow is { 
    outlet ToGuestCommunicationServiceOut is type GuestCommunicationService.GuestCommunicationServiceCommand
    handler ToGuestCommunicationServiceHandler is {
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        let confirmation: type GuestCommunicationService.SendConfirmationEmail = prompt("translate the reservationConfirmed event into a SendConfirmationEmail giving the guest their confirmation number and stay details")
        send confirmation to outlet ReservationContext.ToGuestCommunicationService.ToGuestCommunicationServiceOut
        let preArrival: type GuestCommunicationService.SendPreArrivalEmail = prompt("translate the reservationConfirmed event into a SendPreArrivalEmail carrying checkInDate, which the service schedules against; checkInDate is a Date and so cannot be an `at` operand")
        send preArrival to outlet ReservationContext.ToGuestCommunicationService.ToGuestCommunicationServiceOut
      }
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        let receipt: type GuestCommunicationService.SendCheckoutReceipt = prompt("translate the guestCheckedOut event into a SendCheckoutReceipt itemising what the stay came to, the folio being final at checkout")
        send receipt to outlet ReservationContext.ToGuestCommunicationService.ToGuestCommunicationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToGuestCommunicationService"
      }
    } with {
      briefly "to guest communication service"
      described as {
        |Carries messages to the external GuestCommunicationService.
      }
    }
  } with {
    briefly "GuestCommunicationService integration"
    described as {
      |The model's side of the GuestCommunicationService conversation.
    }
  }
  adaptor FromHousekeepingService from context HousekeepingService is { 
    handler FromHousekeepingServiceHandler is {
      on event HousekeepingService.CleaningRequested is {
        do "the model receives cleaning requested"
      }
      on event HousekeepingService.RoomCleaningCompleted is {
        do "the model receives room cleaning completed"
      }
      on other is {
        error "Unexpected message for adaptor FromHousekeepingService"
      }
    } with {
      briefly "from housekeeping service"
      described as {
        |Carries messages from the external HousekeepingService.
      }
    }
  } with {
    briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor ToHousekeepingService to context HousekeepingService as flow is { 
    outlet ToHousekeepingServiceOut is command HousekeepingService.RequestRoomCleaning
    handler ToHousekeepingServiceHandler is {
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        let item0: type HousekeepingService.RequestRoomCleaning = prompt("translate the guestCheckedOut event into a RequestRoomCleaning, checkout being when the room must be turned over")
        send item0 to outlet ReservationContext.ToHousekeepingService.ToHousekeepingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToHousekeepingService"
      }
    } with {
      briefly "to housekeeping service"
      described as {
        |Carries messages to the external HousekeepingService.
      }
    }
  } with {
    briefly "HousekeepingService integration"
    described as {
      |The model's side of the HousekeepingService conversation.
    }
  }
  adaptor FromLoyaltyProgramService from context LoyaltyProgramService is { 
    handler FromLoyaltyProgramServiceHandler is {
      on result LoyaltyProgramService.MemberTierResult is {
        do "the model receives member tier result"
      }
      on event LoyaltyProgramService.PointsAwarded is {
        do "the model receives points awarded"
      }
      on other is {
        error "Unexpected message for adaptor FromLoyaltyProgramService"
      }
    } with {
      briefly "from loyalty program service"
      described as {
        |Carries messages from the external LoyaltyProgramService.
      }
    }
  } with {
    briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor ToLoyaltyProgramService to context LoyaltyProgramService as flow is { 
    outlet ToLoyaltyProgramServiceOut is command LoyaltyProgramService.AwardPoints
    handler ToLoyaltyProgramServiceHandler is {
      on query LoyaltyProgramService.GetMemberTier is {
        do "the model sends get member tier"
      }
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        let item0: type LoyaltyProgramService.AwardPoints = prompt("translate the guestCheckedOut event into a AwardPoints, the stay being consumed and its spend final at checkout")
        send item0 to outlet ReservationContext.ToLoyaltyProgramService.ToLoyaltyProgramServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToLoyaltyProgramService"
      }
    } with {
      briefly "to loyalty program service"
      described as {
        |Carries messages to the external LoyaltyProgramService.
      }
    }
  } with {
    briefly "LoyaltyProgramService integration"
    described as {
      |The model's side of the LoyaltyProgramService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentAuthorized is {
        do "the model receives payment authorized"
      }
      on event PaymentProcessingService.PaymentCaptured is {
        do "the model receives payment captured"
      }
      on event PaymentProcessingService.PaymentRefunded is {
        do "the model receives payment refunded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService as flow is { 
    outlet ToPaymentProcessingServiceOut is type PaymentProcessingService.PaymentProcessingServiceCommand
    handler ToPaymentProcessingServiceHandler is {
      on reservationConfirmed: event ReservationConfirmed is {
        let notice: type PaymentProcessingService.AuthorizePayment = prompt("translate the reservationConfirmed event into a AuthorizePayment holding the room rate against the guest's card, which is what makes the reservation firm")
        send notice to outlet ReservationContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on guestCheckedOut: event GuestCheckedOut is {
        let notice: type PaymentProcessingService.CapturePayment = prompt("translate the guestCheckedOut event into a CapturePayment taking the folio total now that the stay is complete")
        send notice to outlet ReservationContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on reservationCancelled: event ReservationCancelled is {
        let notice: type PaymentProcessingService.RefundPayment = prompt("translate the reservationCancelled event into a RefundPayment returning whatever the cancellation terms leave owing to the guest")
        send notice to outlet ReservationContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromRoomManagementService from context RoomManagementService is { 
    handler FromRoomManagementServiceHandler is {
      on result RoomManagementService.AvailableRoomsResult is {
        do "the model receives available rooms result"
      }
      on event RoomManagementService.RoomReleased is {
        do "the model receives room released"
      }
      on event RoomManagementService.RoomReserved is {
        do "the model receives room reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromRoomManagementService"
      }
    } with {
      briefly "from room management service"
      described as {
        |Carries messages from the external RoomManagementService.
      }
    }
  } with {
    briefly "RoomManagementService integration"
    described as {
      |The model's side of the RoomManagementService conversation.
    }
  }
  adaptor ToRoomManagementService to context RoomManagementService as flow is { 
    outlet ToRoomManagementServiceOut is type RoomManagementService.RoomManagementServiceCommand
    handler ToRoomManagementServiceHandler is {
      on query RoomManagementService.GetAvailableRooms is {
        do "the model sends get available rooms"
      }
      on roomAssigned: event Reservation.RoomAssigned is {
        let item0: type RoomManagementService.ReserveRoom = prompt("translate the roomAssigned event into a ReserveRoom, assignment being what claims a particular room")
        send item0 to outlet ReservationContext.ToRoomManagementService.ToRoomManagementServiceOut
      }
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        let item0: type RoomManagementService.ReleaseRoom = prompt("translate the guestCheckedOut event into a ReleaseRoom, checkout being what ends the claim")
        send item0 to outlet ReservationContext.ToRoomManagementService.ToRoomManagementServiceOut
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        let item0: type RoomManagementService.ReleaseRoom = prompt("translate the reservationCancelled event into a ReleaseRoom, and cancellation ending it before the stay")
        send item0 to outlet ReservationContext.ToRoomManagementService.ToRoomManagementServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToRoomManagementService"
      }
    } with {
      briefly "to room management service"
      described as {
        |Carries messages to the external RoomManagementService.
      }
    }
  } with {
    briefly "RoomManagementService integration"
    described as {
      |The model's side of the RoomManagementService conversation.
    }
  }
  include "types.riddl"
  include "Reservation.riddl"
  // Repository for reservation persistence
  type ReservationRepositoryCommand is one of {
    ReservationContext.ReservationRepository.PersistChargeAdded or ReservationContext.ReservationRepository.PersistGuestCheckedIn or ReservationContext.ReservationRepository.PersistGuestCheckedOut or ReservationContext.ReservationRepository.PersistGuestMarkedNoShow or ReservationContext.ReservationRepository.PersistPaymentRecorded or ReservationContext.ReservationRepository.PersistReservationCancelled or ReservationContext.ReservationRepository.PersistReservationConfirmed or ReservationContext.ReservationRepository.PersistReservationCreated or ReservationContext.ReservationRepository.PersistReservationModified or ReservationContext.ReservationRepository.PersistRoomAssigned
  } with {
    briefly "Anything that writes ReservationRepository"
    described as {
      |The persistence commands ReservationRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ReservationRepository as flow is {
    inlet ReservationRepositoryFromReservationAnalytics is type ReservationRepositoryCommand    command PersistChargeAdded is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChargeAdded applies to.
        }
      }
    } with {
      briefly "Persist ChargeAdded"
      described as {
        |Instructs this repository to apply ChargeAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentRecorded is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentRecorded applies to.
        }
      }
    } with {
      briefly "Persist PaymentRecorded"
      described as {
        |Instructs this repository to apply PaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationConfirmed is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationConfirmed applies to.
        }
      }
    } with {
      briefly "Persist ReservationConfirmed"
      described as {
        |Instructs this repository to apply ReservationConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationModified is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationModified applies to.
        }
      }
    } with {
      briefly "Persist ReservationModified"
      described as {
        |Instructs this repository to apply ReservationModified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRoomAssigned is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RoomAssigned applies to.
        }
      }
    } with {
      briefly "Persist RoomAssigned"
      described as {
        |Instructs this repository to apply RoomAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGuestCheckedIn is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row GuestCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist GuestCheckedIn"
      described as {
        |Instructs this repository to apply GuestCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGuestCheckedOut is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row GuestCheckedOut applies to.
        }
      }
    } with {
      briefly "Persist GuestCheckedOut"
      described as {
        |Instructs this repository to apply GuestCheckedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistGuestMarkedNoShow is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row GuestMarkedNoShow applies to.
        }
      }
    } with {
      briefly "Persist GuestMarkedNoShow"
      described as {
        |Instructs this repository to apply GuestMarkedNoShow to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCancelled is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationCancelled applies to.
        }
      }
    } with {
      briefly "Persist ReservationCancelled"
      described as {
        |Instructs this repository to apply ReservationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCreated is {
      reservationId: ReservationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReservationCreated applies to.
        }
      }
    } with {
      briefly "Persist ReservationCreated"
      described as {
        |Instructs this repository to apply ReservationCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ReservationRepositoryResponses is result Reservation.ReservationResult
    record StoredReservation is {
      reservationId: ReservationId with {
        briefly "reservationId"
        described as {
          |The reservationId column of the stored reservation row.
        }
      }
      guest: GuestInfo with {
        briefly "guest"
        described as {
          |The guest column of the stored reservation row.
        }
      }
      status: ReservationStatus with {
        briefly "status"
        described as {
          |The status column of the stored reservation row.
        }
      }
      stay: StayDetails with {
        briefly "stay"
        described as {
          |The stay column of the stored reservation row.
        }
      }
    } with {
      briefly "Stored reservation row"
      described as {
        |The persistence shape of reservation data as this repository stores it.
      }
    }
    schema ReservationData is relational
      of reservations as record StoredReservation
        index on field StoredReservation.reservationId
        index on field StoredReservation.guest.guestId
        index on field StoredReservation.stay.checkInDate
        index on field StoredReservation.stay.checkOutDate
        index on field StoredReservation.status
 with {
      briefly "Reservation data schema"
      described as {
        |The relational schema holding reservation data for the ReservationRepository.
      }
    }
    handler ReservationPersistence is {
      on persistChargeAdded: command PersistChargeAdded is {
        do "apply ChargeAdded to the stored row"
      }
      on persistPaymentRecorded: command PersistPaymentRecorded is {
        do "apply PaymentRecorded to the stored row"
      }
      on persistReservationConfirmed: command PersistReservationConfirmed is {
        do "apply ReservationConfirmed to the stored row"
      }
      on persistReservationModified: command PersistReservationModified is {
        do "apply ReservationModified to the stored row"
      }
      on persistRoomAssigned: command PersistRoomAssigned is {
        do "apply RoomAssigned to the stored row"
      }
      on persistGuestCheckedIn: command PersistGuestCheckedIn is {
        do "apply GuestCheckedIn to the stored row"
      }
      on persistGuestCheckedOut: command PersistGuestCheckedOut is {
        do "apply GuestCheckedOut to the stored row"
      }
      on persistGuestMarkedNoShow: command PersistGuestMarkedNoShow is {
        do "apply GuestMarkedNoShow to the stored row"
      }
      on persistReservationCancelled: command PersistReservationCancelled is {
        do "apply ReservationCancelled to the stored row"
      }
      on persistReservationCreated: command PersistReservationCreated is {
        do "apply ReservationCreated to the stored row"
      }
      on query GetOccupancyStats is {
        let occupancyStatsView: type OccupancyStatsView = prompt("read the occupancy stats projection")
        reply occupancyStatsView
      }
    } with {
      briefly "Persists reservation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Reservation data persistence"
    described as {
      | The ReservationRepository provides persistent storage
      | for reservations and related data.
    }
  }
  // Projector for reservation analytics
  query GetOccupancyStats replies result OccupancyStatsView is {
    occupancyStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which occupancy stats to retrieve.
      }
    }
  } with {
    briefly "Get occupancy stats"
    described as {
      |Retrieves the occupancy stats projection.
    }
  }
  result OccupancyStatsView is {
    occupancyStats: ReservationAnalytics.OccupancyStats with {
      briefly "Occupancy stats"
      described as {
        |The occupancy stats being returned.
      }
    }
  } with {
    briefly "Occupancy stats view"
    described as {
      |Read model view carrying the occupancy stats projection.
    }
  }
  projector ReservationAnalytics as flow is {
    updates repository ReservationContext.ReservationRepository
    outlet ReservationAnalyticsToRepository is type ReservationRepositoryCommand
    inlet ReservationAnalyticsFromReservation is type ReservationEvent    record OccupancyStats is {
      date: Date with {
        briefly "Date"
        described as {
          |Statistics date.
        }
      }
      totalRooms: Natural with {
        briefly "Total"
        described as {
          |Total rooms.
        }
      }
      occupiedRooms: Natural with {
        briefly "Occupied"
        described as {
          |Occupied rooms.
        }
      }
      occupancyRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Occupancy rate.
        }
      }
      revenuePerRoom: Decimal(10,2) with {
        briefly "RevPAR"
        described as {
          |Revenue per available room.
        }
      }
      averageDailyRate: Decimal(10,2) with {
        briefly "ADR"
        described as {
          |Average daily rate.
        }
      }
    } with {
      briefly "Occupancy statistics"
      described as {
        |Daily occupancy metrics.
      }
    }
    handler AnalyticsHandler is {
      on chargeAdded: event Reservation.ChargeAdded is {
        tell command ReservationContext.ReservationRepository.PersistChargeAdded(reservationId = chargeAdded.reservationId) to repository ReservationContext.ReservationRepository
        do "apply ChargeAdded to the ReservationAnalytics projection"
      }
      on paymentRecorded: event Reservation.PaymentRecorded is {
        tell command ReservationContext.ReservationRepository.PersistPaymentRecorded(reservationId = paymentRecorded.reservationId) to repository ReservationContext.ReservationRepository
        do "apply PaymentRecorded to the ReservationAnalytics projection"
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        tell command ReservationContext.ReservationRepository.PersistReservationConfirmed(reservationId = reservationConfirmed.reservationId) to repository ReservationContext.ReservationRepository
        do "apply ReservationConfirmed to the ReservationAnalytics projection"
      }
      on reservationModified: event Reservation.ReservationModified is {
        tell command ReservationContext.ReservationRepository.PersistReservationModified(reservationId = reservationModified.reservationId) to repository ReservationContext.ReservationRepository
        do "apply ReservationModified to the ReservationAnalytics projection"
      }
      on roomAssigned: event Reservation.RoomAssigned is {
        tell command ReservationContext.ReservationRepository.PersistRoomAssigned(reservationId = roomAssigned.reservationId) to repository ReservationContext.ReservationRepository
        do "apply RoomAssigned to the ReservationAnalytics projection"
      }
      on reservationCreated: event Reservation.ReservationCreated is {
        tell command ReservationContext.ReservationRepository.PersistReservationCreated(reservationId = reservationCreated.reservationId) to repository ReservationContext.ReservationRepository
        do "Update booking metrics"
      }
      on guestCheckedIn: event Reservation.GuestCheckedIn is {
        tell command ReservationContext.ReservationRepository.PersistGuestCheckedIn(reservationId = guestCheckedIn.reservationId) to repository ReservationContext.ReservationRepository
        do "Update occupancy"
      }
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        tell command ReservationContext.ReservationRepository.PersistGuestCheckedOut(reservationId = guestCheckedOut.reservationId) to repository ReservationContext.ReservationRepository
        do "Update revenue metrics"
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        tell command ReservationContext.ReservationRepository.PersistReservationCancelled(reservationId = reservationCancelled.reservationId) to repository ReservationContext.ReservationRepository
        do "Update cancellation metrics"
      }
      on guestMarkedNoShow: event Reservation.GuestMarkedNoShow is {
        tell command ReservationContext.ReservationRepository.PersistGuestMarkedNoShow(reservationId = guestMarkedNoShow.reservationId) to repository ReservationContext.ReservationRepository
        do "Update no-show metrics"
      }
    } with {
      briefly "Maintains reservation analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Reservation analytics projections"
    described as {
      |Maintains occupancy and revenue analytics.
    }
  }
  // ---- Event publication for Reservation ----
  type ReservationEvent is one of {
    ReservationContext.Reservation.ReservationCreated or ReservationContext.Reservation.ReservationModified or ReservationContext.Reservation.ReservationConfirmed or ReservationContext.Reservation.RoomAssigned or ReservationContext.Reservation.GuestCheckedIn or ReservationContext.Reservation.ChargeAdded or ReservationContext.Reservation.PaymentRecorded or ReservationContext.Reservation.GuestCheckedOut or ReservationContext.Reservation.ReservationCancelled or ReservationContext.Reservation.GuestMarkedNoShow
  } with {
    briefly "Reservation event alternation"
    described as {
      |Union of all Reservation events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ReservationEventSplit as flow is {
    inlet ReservationEventSplitIn is type ReservationEvent    outlet ReservationEventSplitToReservationAnalytics is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on reservationCreated: event Reservation.ReservationCreated is {
        send reservationCreated to outlet ReservationEventSplitToReservationAnalytics
        tell reservationCreated to entity ReservationContext.Reservation
      }
      on reservationModified: event Reservation.ReservationModified is {
        send reservationModified to outlet ReservationEventSplitToReservationAnalytics
        tell reservationModified to entity ReservationContext.Reservation
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        send reservationConfirmed to outlet ReservationEventSplitToReservationAnalytics
        tell reservationConfirmed to entity ReservationContext.Reservation
      }
      on roomAssigned: event Reservation.RoomAssigned is {
        send roomAssigned to outlet ReservationEventSplitToReservationAnalytics
        tell roomAssigned to entity ReservationContext.Reservation
      }
      on guestCheckedIn: event Reservation.GuestCheckedIn is {
        send guestCheckedIn to outlet ReservationEventSplitToReservationAnalytics
        tell guestCheckedIn to entity ReservationContext.Reservation
      }
      on chargeAdded: event Reservation.ChargeAdded is {
        send chargeAdded to outlet ReservationEventSplitToReservationAnalytics
        tell chargeAdded to entity ReservationContext.Reservation
      }
      on paymentRecorded: event Reservation.PaymentRecorded is {
        send paymentRecorded to outlet ReservationEventSplitToReservationAnalytics
        tell paymentRecorded to entity ReservationContext.Reservation
      }
      on guestCheckedOut: event Reservation.GuestCheckedOut is {
        send guestCheckedOut to outlet ReservationEventSplitToReservationAnalytics
        tell guestCheckedOut to entity ReservationContext.Reservation
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        send reservationCancelled to outlet ReservationEventSplitToReservationAnalytics
        tell reservationCancelled to entity ReservationContext.Reservation
      }
      on guestMarkedNoShow: event Reservation.GuestMarkedNoShow is {
        send guestMarkedNoShow to outlet ReservationEventSplitToReservationAnalytics
        tell guestMarkedNoShow to entity ReservationContext.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  connector 'ReservationEvent Stream' is from outlet ReservationContext.Reservation.ReservationEvents2 to inlet ReservationContext.ReservationEventSplit.ReservationEventSplitIn with {
    briefly "Reservation events, fanned out to storage and read models"
  }
  connector 'ReservationAnalytics Feed' is from outlet ReservationContext.ReservationEventSplit.ReservationEventSplitToReservationAnalytics to inlet ReservationContext.ReservationAnalytics.ReservationAnalyticsFromReservation with {
    briefly "Reservation events feeding the ReservationAnalytics projection"
  }
  connector 'ReservationAnalytics Storage' is from outlet ReservationContext.ReservationAnalytics.ReservationAnalyticsToRepository to inlet ReservationContext.ReservationRepository.ReservationRepositoryFromReservationAnalytics with {
    briefly "ReservationAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for reservations"
  described as {
    | The ReservationContext is the bounded context for
    | hotel reservation management.
  }
}
