// Catering Management - Catering Context
context CateringContext as router is {
  inlet CateringOrderCommandStreamIn is type CateringOrderCommand  outlet CateringOrderCommandStreamOut is type CateringOrderCommand
  inlet MarketplaceOrderResultStreamIn is result CateringOrder.CateringOrderResult  outlet MarketplaceOrderResultStreamOut is result CateringOrder.CateringOrderResult
  handler CateringContextBoundary is {
    on createOrder: command CateringOrder.CreateOrder is {
      send createOrder to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on addMenuItem: command CateringOrder.AddMenuItem is {
      send addMenuItem to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on removeMenuItem: command CateringOrder.RemoveMenuItem is {
      send removeMenuItem to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on confirmOrder: command CateringOrder.ConfirmOrder is {
      send confirmOrder to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on setDeliveryInfo: command CateringOrder.SetDeliveryInfo is {
      send setDeliveryInfo to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on assignStaff: command CateringOrder.AssignStaff is {
      send assignStaff to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on startPreparation: command CateringOrder.StartPreparation is {
      send startPreparation to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on markReady: command CateringOrder.MarkReady is {
      send markReady to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on dispatchDelivery: command CateringOrder.DispatchDelivery is {
      send dispatchDelivery to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on confirmDelivery: command CateringOrder.ConfirmDelivery is {
      send confirmDelivery to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on recordPayment: command CateringOrder.RecordPayment is {
      send recordPayment to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on completeOrder: command CateringOrder.CompleteOrder is {
      send completeOrder to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on cancelOrder: command CateringOrder.CancelOrder is {
      send cancelOrder to outlet CateringContext.CateringOrderCommandStreamOut
    }
    on cateringOrderResult: result CateringOrder.CateringOrderResult is {
      send cateringOrderResult to outlet CateringContext.MarketplaceOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the CateringContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CateringOrderCommand Stream Intake' is from outlet CateringContext.CateringOrderCommandStreamOut to inlet CateringContext.CateringOrder.CateringOrderCommands  connector 'MarketplaceOrderResult Stream Egress' is from outlet CateringContext.OrderRepository.OrderRepositoryResponses to inlet CateringContext.MarketplaceOrderResultStreamIn  adaptor FromDeliveryService from context DeliveryService is { 
    handler FromDeliveryServiceHandler is {
      on event DeliveryService.DeliveryScheduled is {
        do "the model receives delivery scheduled"
      }
      on event DeliveryService.DeliveryStatusUpdated is {
        do "the model receives delivery status updated"
      }
      on other is {
        error "Unexpected message for adaptor FromDeliveryService"
      }
    } with {
      briefly "from delivery service"
      described as {
        |Carries messages from the external DeliveryService.
      }
    }
  } with {
    briefly "DeliveryService integration"
    described as {
      |The model's side of the DeliveryService conversation.
    }
  }
  adaptor ToDeliveryService to context DeliveryService is { 
    handler ToDeliveryServiceHandler is {
      on command DeliveryService.ScheduleDelivery is {
        do "the model sends schedule delivery"
      }
      on command DeliveryService.UpdateDeliveryStatus is {
        do "the model sends update delivery status"
      }
      on other is {
        error "Unexpected message for adaptor ToDeliveryService"
      }
    } with {
      briefly "to delivery service"
      described as {
        |Carries messages to the external DeliveryService.
      }
    }
  } with {
    briefly "DeliveryService integration"
    described as {
      |The model's side of the DeliveryService conversation.
    }
  }
  adaptor FromInventoryService from context InventoryService is { 
    handler FromInventoryServiceHandler is {
      on result InventoryService.IngredientAvailability is {
        do "the model receives ingredient availability"
      }
      on event InventoryService.IngredientsReserved is {
        do "the model receives ingredients reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromInventoryService"
      }
    } with {
      briefly "from inventory service"
      described as {
        |Carries messages from the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor ToInventoryService to context InventoryService is { 
    handler ToInventoryServiceHandler is {
      on query InventoryService.CheckIngredientAvailability is {
        do "the model sends check ingredient availability"
      }
      on command InventoryService.ReserveIngredients is {
        do "the model sends reserve ingredients"
      }
      on other is {
        error "Unexpected message for adaptor ToInventoryService"
      }
    } with {
      briefly "to inventory service"
      described as {
        |Carries messages to the external InventoryService.
      }
    }
  } with {
    briefly "InventoryService integration"
    described as {
      |The model's side of the InventoryService conversation.
    }
  }
  adaptor FromMenuCatalogService from context MenuCatalogService is { 
    handler FromMenuCatalogServiceHandler is {
      on result MenuCatalogService.MenuCatalog is {
        do "the model receives menu catalog"
      }
      on result MenuCatalogService.MenuItemDetails is {
        do "the model receives menu item details"
      }
      on other is {
        error "Unexpected message for adaptor FromMenuCatalogService"
      }
    } with {
      briefly "from menu catalog service"
      described as {
        |Carries messages from the external MenuCatalogService.
      }
    }
  } with {
    briefly "MenuCatalogService integration"
    described as {
      |The model's side of the MenuCatalogService conversation.
    }
  }
  adaptor ToMenuCatalogService to context MenuCatalogService is { 
    handler ToMenuCatalogServiceHandler is {
      on query MenuCatalogService.GetMenuItemDetails is {
        do "the model sends get menu item details"
      }
      on query MenuCatalogService.GetMenuItems is {
        do "the model sends get menu items"
      }
      on other is {
        error "Unexpected message for adaptor ToMenuCatalogService"
      }
    } with {
      briefly "to menu catalog service"
      described as {
        |Carries messages to the external MenuCatalogService.
      }
    }
  } with {
    briefly "MenuCatalogService integration"
    described as {
      |The model's side of the MenuCatalogService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event NotificationService.DeliveryNotificationSent is {
        do "the model receives delivery notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendDeliveryNotification is {
        do "the model sends send delivery notification"
      }
      on command NotificationService.SendOrderConfirmation is {
        do "the model sends send order confirmation"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on event PaymentProcessingService.RefundProcessed is {
        do "the model receives refund processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessPayment is {
        do "the model sends process payment"
      }
      on command PaymentProcessingService.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromPricingService from context PricingService is { 
    handler FromPricingServiceHandler is {
      on result PricingService.OrderPricing is {
        do "the model receives order pricing"
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor ToPricingService to context PricingService is { 
    handler ToPricingServiceHandler is {
      on query PricingService.CalculateOrderTotal is {
        do "the model sends calculate order total"
      }
      on other is {
        error "Unexpected message for adaptor ToPricingService"
      }
    } with {
      briefly "to pricing service"
      described as {
        |Carries messages to the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromStaffSchedulingService from context StaffSchedulingService is { 
    handler FromStaffSchedulingServiceHandler is {
      on result StaffSchedulingService.AvailableStaff is {
        do "the model receives available staff"
      }
      on event StaffSchedulingService.StaffScheduled is {
        do "the model receives staff scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromStaffSchedulingService"
      }
    } with {
      briefly "from staff scheduling service"
      described as {
        |Carries messages from the external StaffSchedulingService.
      }
    }
  } with {
    briefly "StaffSchedulingService integration"
    described as {
      |The model's side of the StaffSchedulingService conversation.
    }
  }
  adaptor ToStaffSchedulingService to context StaffSchedulingService is { 
    handler ToStaffSchedulingServiceHandler is {
      on query StaffSchedulingService.GetAvailableStaff is {
        do "the model sends get available staff"
      }
      on command StaffSchedulingService.ScheduleStaff is {
        do "the model sends schedule staff"
      }
      on other is {
        error "Unexpected message for adaptor ToStaffSchedulingService"
      }
    } with {
      briefly "to staff scheduling service"
      described as {
        |Carries messages to the external StaffSchedulingService.
      }
    }
  } with {
    briefly "StaffSchedulingService integration"
    described as {
      |The model's side of the StaffSchedulingService conversation.
    }
  }
  include "types.riddl"
  include "CateringOrder.riddl"
  // Repository for order persistence
  type OrderRepositoryCommand is one of {
    CateringContext.OrderRepository.PersistDeliveryConfirmed or CateringContext.OrderRepository.PersistDeliveryDispatched or CateringContext.OrderRepository.PersistDeliveryInfoSet or CateringContext.OrderRepository.PersistMenuItemAdded or CateringContext.OrderRepository.PersistMenuItemRemoved or CateringContext.OrderRepository.PersistOrderCancelled or CateringContext.OrderRepository.PersistOrderCompleted or CateringContext.OrderRepository.PersistOrderConfirmed or CateringContext.OrderRepository.PersistOrderCreated or CateringContext.OrderRepository.PersistOrderReady or CateringContext.OrderRepository.PersistPaymentRecorded or CateringContext.OrderRepository.PersistPreparationStarted or CateringContext.OrderRepository.PersistStaffAssigned
  } with {
    briefly "Anything that writes OrderRepository"
    described as {
      |The persistence commands OrderRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository OrderRepository as flow is {
    inlet OrderRepositoryFromCateringAnalytics is type OrderRepositoryCommand
    command PersistDeliveryConfirmed is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryConfirmed applies to.
        }
      }
    } with {
      briefly "Persist DeliveryConfirmed"
      described as {
        |Instructs this repository to apply DeliveryConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryDispatched is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryDispatched applies to.
        }
      }
    } with {
      briefly "Persist DeliveryDispatched"
      described as {
        |Instructs this repository to apply DeliveryDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryInfoSet is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryInfoSet applies to.
        }
      }
    } with {
      briefly "Persist DeliveryInfoSet"
      described as {
        |Instructs this repository to apply DeliveryInfoSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMenuItemAdded is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MenuItemAdded applies to.
        }
      }
    } with {
      briefly "Persist MenuItemAdded"
      described as {
        |Instructs this repository to apply MenuItemAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMenuItemRemoved is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MenuItemRemoved applies to.
        }
      }
    } with {
      briefly "Persist MenuItemRemoved"
      described as {
        |Instructs this repository to apply MenuItemRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderReady is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderReady applies to.
        }
      }
    } with {
      briefly "Persist OrderReady"
      described as {
        |Instructs this repository to apply OrderReady to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentRecorded is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentRecorded applies to.
        }
      }
    } with {
      briefly "Persist PaymentRecorded"
      described as {
        |Instructs this repository to apply PaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPreparationStarted is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row PreparationStarted applies to.
        }
      }
    } with {
      briefly "Persist PreparationStarted"
      described as {
        |Instructs this repository to apply PreparationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStaffAssigned is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row StaffAssigned applies to.
        }
      }
    } with {
      briefly "Persist StaffAssigned"
      described as {
        |Instructs this repository to apply StaffAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCancelled is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist OrderCancelled"
      described as {
        |Instructs this repository to apply OrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCompleted is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCompleted applies to.
        }
      }
    } with {
      briefly "Persist OrderCompleted"
      described as {
        |Instructs this repository to apply OrderCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderConfirmed is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderConfirmed applies to.
        }
      }
    } with {
      briefly "Persist OrderConfirmed"
      described as {
        |Instructs this repository to apply OrderConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCreated is  {
      orderId: OrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCreated applies to.
        }
      }
    } with {
      briefly "Persist OrderCreated"
      described as {
        |Instructs this repository to apply OrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet OrderRepositoryResponses is result CateringOrder.CateringOrderResult
    record StoredCateringOrder is  {
      cateringOrderId: UUID with {
        briefly "cateringOrderId"
        described as {
          |The cateringOrderId column of the stored cateringOrder row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored cateringOrder row.
        }
      }
      event: EventDetails with {
        briefly "event"
        described as {
          |The event column of the stored cateringOrder row.
        }
      }
      orderId: OrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored cateringOrder row.
        }
      }
    } with {
      briefly "Stored cateringOrder row"
      described as {
        |The persistence shape of cateringOrder data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as record StoredCateringOrder
        index on field StoredCateringOrder.orderId
        index on field StoredCateringOrder.customer.customerId
        index on field StoredCateringOrder.event.eventDate
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on persistDeliveryConfirmed: command PersistDeliveryConfirmed is {
        do "apply DeliveryConfirmed to the stored row"
      }
      on persistDeliveryDispatched: command PersistDeliveryDispatched is {
        do "apply DeliveryDispatched to the stored row"
      }
      on persistDeliveryInfoSet: command PersistDeliveryInfoSet is {
        do "apply DeliveryInfoSet to the stored row"
      }
      on persistMenuItemAdded: command PersistMenuItemAdded is {
        do "apply MenuItemAdded to the stored row"
      }
      on persistMenuItemRemoved: command PersistMenuItemRemoved is {
        do "apply MenuItemRemoved to the stored row"
      }
      on persistOrderReady: command PersistOrderReady is {
        do "apply OrderReady to the stored row"
      }
      on persistPaymentRecorded: command PersistPaymentRecorded is {
        do "apply PaymentRecorded to the stored row"
      }
      on persistPreparationStarted: command PersistPreparationStarted is {
        do "apply PreparationStarted to the stored row"
      }
      on persistStaffAssigned: command PersistStaffAssigned is {
        do "apply StaffAssigned to the stored row"
      }
      on persistOrderCancelled: command PersistOrderCancelled is {
        do "apply OrderCancelled to the stored row"
      }
      on persistOrderCompleted: command PersistOrderCompleted is {
        do "apply OrderCompleted to the stored row"
      }
      on persistOrderConfirmed: command PersistOrderConfirmed is {
        do "apply OrderConfirmed to the stored row"
      }
      on persistOrderCreated: command PersistOrderCreated is {
        do "apply OrderCreated to the stored row"
      }
      on query GetCateringStats is {
        let cateringStatsView: type CateringStatsView = prompt("read the catering stats projection")
        reply cateringStatsView
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | catering orders and related data.
    }
  }
  // Projector for catering analytics
  query GetCateringStats replies result CateringStatsView is  {
    cateringStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which catering stats to retrieve.
      }
    }
  } with {
    briefly "Get catering stats"
    described as {
      |Retrieves the catering stats projection.
    }
  }
  result CateringStatsView is  {
    cateringStats: CateringAnalytics.CateringStats with {
      briefly "Catering stats"
      described as {
        |The catering stats being returned.
      }
    }
  } with {
    briefly "Catering stats view"
    described as {
      |Read model view carrying the catering stats projection.
    }
  }
  projector CateringAnalytics as flow is {
    outlet CateringAnalyticsToRepository is type OrderRepositoryCommand
    updates repository CateringContext.OrderRepository
    inlet CateringAnalyticsFromCateringOrder is type CateringOrderEvent
    record CateringStats is  {
      totalOrders: Natural with {
        briefly "Total"
        described as {
          |Total orders.
        }
      }
      activeOrders: Natural with {
        briefly "Active"
        described as {
          |Active orders.
        }
      }
      completedOrders: Natural with {
        briefly "Completed"
        described as {
          |Completed orders.
        }
      }
      cancelledOrders: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled orders.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageOrderValue: Decimal(10,2) with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
    } with {
      briefly "Catering statistics"
      described as {
        |Catering operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on deliveryConfirmed: event CateringOrder.DeliveryConfirmed is {
        tell command CateringContext.OrderRepository.PersistDeliveryConfirmed(orderId = deliveryConfirmed.orderId) to repository CateringContext.OrderRepository
        do "apply DeliveryConfirmed to the CateringAnalytics projection"
      }
      on deliveryDispatched: event CateringOrder.DeliveryDispatched is {
        tell command CateringContext.OrderRepository.PersistDeliveryDispatched(orderId = deliveryDispatched.orderId) to repository CateringContext.OrderRepository
        do "apply DeliveryDispatched to the CateringAnalytics projection"
      }
      on deliveryInfoSet: event CateringOrder.DeliveryInfoSet is {
        tell command CateringContext.OrderRepository.PersistDeliveryInfoSet(orderId = deliveryInfoSet.orderId) to repository CateringContext.OrderRepository
        do "apply DeliveryInfoSet to the CateringAnalytics projection"
      }
      on menuItemAdded: event CateringOrder.MenuItemAdded is {
        tell command CateringContext.OrderRepository.PersistMenuItemAdded(orderId = menuItemAdded.orderId) to repository CateringContext.OrderRepository
        do "apply MenuItemAdded to the CateringAnalytics projection"
      }
      on menuItemRemoved: event CateringOrder.MenuItemRemoved is {
        tell command CateringContext.OrderRepository.PersistMenuItemRemoved(orderId = menuItemRemoved.orderId) to repository CateringContext.OrderRepository
        do "apply MenuItemRemoved to the CateringAnalytics projection"
      }
      on orderReady: event CateringOrder.OrderReady is {
        tell command CateringContext.OrderRepository.PersistOrderReady(orderId = orderReady.orderId) to repository CateringContext.OrderRepository
        do "apply OrderReady to the CateringAnalytics projection"
      }
      on paymentRecorded: event CateringOrder.PaymentRecorded is {
        tell command CateringContext.OrderRepository.PersistPaymentRecorded(orderId = paymentRecorded.orderId) to repository CateringContext.OrderRepository
        do "apply PaymentRecorded to the CateringAnalytics projection"
      }
      on preparationStarted: event CateringOrder.PreparationStarted is {
        tell command CateringContext.OrderRepository.PersistPreparationStarted(orderId = preparationStarted.orderId) to repository CateringContext.OrderRepository
        do "apply PreparationStarted to the CateringAnalytics projection"
      }
      on staffAssigned: event CateringOrder.StaffAssigned is {
        tell command CateringContext.OrderRepository.PersistStaffAssigned(orderId = staffAssigned.orderId) to repository CateringContext.OrderRepository
        do "apply StaffAssigned to the CateringAnalytics projection"
      }
      on orderCreated: event CateringOrder.OrderCreated is {
        tell command CateringContext.OrderRepository.PersistOrderCreated(orderId = orderCreated.orderId) to repository CateringContext.OrderRepository
        do "Update order counts"
      }
      on orderConfirmed: event CateringOrder.OrderConfirmed is {
        tell command CateringContext.OrderRepository.PersistOrderConfirmed(orderId = orderConfirmed.orderId) to repository CateringContext.OrderRepository
        do "Update confirmed metrics"
      }
      on orderCompleted: event CateringOrder.OrderCompleted is {
        tell command CateringContext.OrderRepository.PersistOrderCompleted(orderId = orderCompleted.orderId) to repository CateringContext.OrderRepository
        do "Update completion and revenue metrics"
      }
      on orderCancelled: event CateringOrder.OrderCancelled is {
        tell command CateringContext.OrderRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository CateringContext.OrderRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains catering analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Catering analytics projections"
    described as {
      |Maintains catering operations analytics data.
    }
  }
  // ---- Event publication for CateringOrder ----
  type CateringOrderEvent is one of {
    CateringContext.CateringOrder.OrderCreated or CateringContext.CateringOrder.MenuItemAdded or CateringContext.CateringOrder.MenuItemRemoved or CateringContext.CateringOrder.OrderConfirmed or CateringContext.CateringOrder.DeliveryInfoSet or CateringContext.CateringOrder.StaffAssigned or CateringContext.CateringOrder.PreparationStarted or CateringContext.CateringOrder.OrderReady or CateringContext.CateringOrder.DeliveryDispatched or CateringContext.CateringOrder.DeliveryConfirmed or CateringContext.CateringOrder.PaymentRecorded or CateringContext.CateringOrder.OrderCompleted or CateringContext.CateringOrder.OrderCancelled
  } with {
    briefly "CateringOrder event alternation"
    described as {
      |Union of all CateringOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CateringOrderEventSplit as flow is {
    inlet CateringOrderEventSplitIn is type CateringOrderEvent
    outlet CateringOrderEventSplitToCateringAnalytics is type CateringOrderEvent
    handler CateringOrderEventSplitHandler is {
      on orderCreated: event CateringOrder.OrderCreated is {
        send orderCreated to outlet CateringOrderEventSplitToCateringAnalytics
        tell orderCreated to entity CateringContext.CateringOrder
      }
      on menuItemAdded: event CateringOrder.MenuItemAdded is {
        send menuItemAdded to outlet CateringOrderEventSplitToCateringAnalytics
        tell menuItemAdded to entity CateringContext.CateringOrder
      }
      on menuItemRemoved: event CateringOrder.MenuItemRemoved is {
        send menuItemRemoved to outlet CateringOrderEventSplitToCateringAnalytics
        tell menuItemRemoved to entity CateringContext.CateringOrder
      }
      on orderConfirmed: event CateringOrder.OrderConfirmed is {
        send orderConfirmed to outlet CateringOrderEventSplitToCateringAnalytics
        tell orderConfirmed to entity CateringContext.CateringOrder
      }
      on deliveryInfoSet: event CateringOrder.DeliveryInfoSet is {
        send deliveryInfoSet to outlet CateringOrderEventSplitToCateringAnalytics
        tell deliveryInfoSet to entity CateringContext.CateringOrder
      }
      on staffAssigned: event CateringOrder.StaffAssigned is {
        send staffAssigned to outlet CateringOrderEventSplitToCateringAnalytics
        tell staffAssigned to entity CateringContext.CateringOrder
      }
      on preparationStarted: event CateringOrder.PreparationStarted is {
        send preparationStarted to outlet CateringOrderEventSplitToCateringAnalytics
        tell preparationStarted to entity CateringContext.CateringOrder
      }
      on orderReady: event CateringOrder.OrderReady is {
        send orderReady to outlet CateringOrderEventSplitToCateringAnalytics
        tell orderReady to entity CateringContext.CateringOrder
      }
      on deliveryDispatched: event CateringOrder.DeliveryDispatched is {
        send deliveryDispatched to outlet CateringOrderEventSplitToCateringAnalytics
        tell deliveryDispatched to entity CateringContext.CateringOrder
      }
      on deliveryConfirmed: event CateringOrder.DeliveryConfirmed is {
        send deliveryConfirmed to outlet CateringOrderEventSplitToCateringAnalytics
        tell deliveryConfirmed to entity CateringContext.CateringOrder
      }
      on paymentRecorded: event CateringOrder.PaymentRecorded is {
        send paymentRecorded to outlet CateringOrderEventSplitToCateringAnalytics
        tell paymentRecorded to entity CateringContext.CateringOrder
      }
      on orderCompleted: event CateringOrder.OrderCompleted is {
        send orderCompleted to outlet CateringOrderEventSplitToCateringAnalytics
        tell orderCompleted to entity CateringContext.CateringOrder
      }
      on orderCancelled: event CateringOrder.OrderCancelled is {
        send orderCancelled to outlet CateringOrderEventSplitToCateringAnalytics
        tell orderCancelled to entity CateringContext.CateringOrder
      }
      on other is {
        error "Unexpected message for processor CateringOrderEventSplit"
      }
    } with {
      briefly "CateringOrder event fan-out handler"
      described as {
        |Delivers each CateringOrder event to all of its consumers.
      }
    }
  } with {
    briefly "CateringOrder event fan-out"
    described as {
      |Fans CateringOrder events out to the repository and projectors.
    }
  }
  connector 'CateringOrderEvent Stream' is from outlet CateringContext.CateringOrder.CateringOrderEvents2 to inlet CateringContext.CateringOrderEventSplit.CateringOrderEventSplitIn with {
    briefly "CateringOrder events, fanned out to storage and read models"
  }
  connector 'CateringAnalytics Feed' is from outlet CateringContext.CateringOrderEventSplit.CateringOrderEventSplitToCateringAnalytics to inlet CateringContext.CateringAnalytics.CateringAnalyticsFromCateringOrder with {
    briefly "CateringOrder events feeding the CateringAnalytics projection"
  }
  connector 'CateringAnalytics Storage' is from outlet CateringContext.CateringAnalytics.CateringAnalyticsToRepository to inlet CateringContext.OrderRepository.OrderRepositoryFromCateringAnalytics with {
    briefly "CateringAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for catering management"
  described as {
    | The CateringContext is the bounded context for
    | event catering orders and operations.
  }
}
