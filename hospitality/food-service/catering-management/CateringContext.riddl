// Catering Management - Catering Context
context CateringContext is {
  include "types.riddl"
  include "CateringOrder.riddl"
  // Repository for order persistence
  repository OrderRepository is {
    inlet OrderRepositoryFromCateringOrder is type CateringOrderEvent
    inlet OrderRepositoryFromCateringAnalytics is type CateringOrderEvent
    outlet OrderRepositoryResponses is type CateringOrder.CateringOrderResult
    schema OrderData is relational
      of orders as type CateringOrder
        index on field CateringOrder.orderId
        index on field CateringOrder.customer.customerId
        index on field CateringOrder.event.eventDate

    handler OrderPersistence is {
      on command CateringOrder.CreateOrder is {
        tell event CateringOrder.OrderCreated to entity CateringContext.CateringOrder
        do "Store new order"
      }
      on command CateringOrder.AddMenuItem is {
        tell event CateringOrder.MenuItemAdded to entity CateringContext.CateringOrder
        do "Add line item to order"
      }
      on command CateringOrder.RemoveMenuItem is {
        tell event CateringOrder.MenuItemRemoved to entity CateringContext.CateringOrder
        do "Remove line item from order"
      }
      on command CateringOrder.ConfirmOrder is {
        tell event CateringOrder.OrderConfirmed to entity CateringContext.CateringOrder
        do "Update order to confirmed"
      }
      on command CateringOrder.SetDeliveryInfo is {
        tell event CateringOrder.DeliveryInfoSet to entity CateringContext.CateringOrder
        do "Store delivery info"
      }
      on command CateringOrder.AssignStaff is {
        tell event CateringOrder.StaffAssigned to entity CateringContext.CateringOrder
        do "Store staff assignment"
      }
      on command CateringOrder.StartPreparation is {
        tell event CateringOrder.PreparationStarted to entity CateringContext.CateringOrder
        do "Update to in preparation"
      }
      on command CateringOrder.MarkReady is {
        do "Update to ready"
      }
      on command CateringOrder.DispatchDelivery is {
        do "Update to in transit"
      }
      on command CateringOrder.ConfirmDelivery is {
        tell event CateringOrder.DeliveryConfirmed to entity CateringContext.CateringOrder
        do "Update to delivered"
      }
      on command CateringOrder.RecordPayment is {
        tell event CateringOrder.PaymentRecorded to entity CateringContext.CateringOrder
        do "Store payment record"
      }
      on command CateringOrder.CompleteOrder is {
        tell event CateringOrder.OrderCompleted to entity CateringContext.CateringOrder
        do "Update to completed"
      }
      on command CateringOrder.CancelOrder is {
        tell event CateringOrder.OrderCancelled to entity CateringContext.CateringOrder
        do "Update to cancelled"
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | catering orders and related data.
    }
  }
  // Projector for catering analytics
  projector CateringAnalytics is {
    inlet CateringAnalyticsFromCateringOrder is type CateringOrderEvent
    outlet CateringAnalyticsOut is type CateringOrderEvent
    updates repository CateringContext.OrderRepository
    record CateringStats is  {
      totalOrders: Natural with {
        briefly "Total"
        described as {
          |Total orders.
        }
      }
      activeOrders: Natural with {
        briefly "Active"
        described as {
          |Active orders.
        }
      }
      completedOrders: Natural with {
        briefly "Completed"
        described as {
          |Completed orders.
        }
      }
      cancelledOrders: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled orders.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageOrderValue: Decimal(10,2) with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
    } with {
      briefly "Catering statistics"
      described as {
        |Catering operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on event CateringOrder.OrderCreated is {
        tell event CateringOrder.OrderCreated to repository CateringContext.OrderRepository
        do "Update order counts"
      }
      on event CateringOrder.OrderConfirmed is {
        tell event CateringOrder.OrderConfirmed to repository CateringContext.OrderRepository
        do "Update confirmed metrics"
      }
      on event CateringOrder.OrderCompleted is {
        tell event CateringOrder.OrderCompleted to repository CateringContext.OrderRepository
        do "Update completion and revenue metrics"
      }
      on event CateringOrder.OrderCancelled is {
        tell event CateringOrder.OrderCancelled to repository CateringContext.OrderRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains catering analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Catering analytics projections"
    described as {
      |Maintains catering operations analytics data.
    }
  }
  // ---- Event publication for CateringOrder ----
  type CateringOrderEvent is one of {
    CateringContext.CateringOrder.OrderCreated,
    CateringContext.CateringOrder.MenuItemAdded,
    CateringContext.CateringOrder.MenuItemRemoved,
    CateringContext.CateringOrder.OrderConfirmed,
    CateringContext.CateringOrder.DeliveryInfoSet,
    CateringContext.CateringOrder.StaffAssigned,
    CateringContext.CateringOrder.PreparationStarted,
    CateringContext.CateringOrder.OrderReady,
    CateringContext.CateringOrder.DeliveryDispatched,
    CateringContext.CateringOrder.DeliveryConfirmed,
    CateringContext.CateringOrder.PaymentRecorded,
    CateringContext.CateringOrder.OrderCompleted,
    CateringContext.CateringOrder.OrderCancelled
  } with {
    briefly "CateringOrder event alternation"
    described as {
      |Union of all CateringOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor CateringOrderEventSource as source is {
    outlet CateringOrderEvents is type CateringOrderEvent
    handler CateringOrderSourceHandler is {
      on event CateringOrder.OrderCreated is {
        send event CateringOrder.OrderCreated to outlet CateringOrderEvents
      }
      on event CateringOrder.MenuItemAdded is {
        send event CateringOrder.MenuItemAdded to outlet CateringOrderEvents
      }
      on event CateringOrder.MenuItemRemoved is {
        send event CateringOrder.MenuItemRemoved to outlet CateringOrderEvents
      }
      on event CateringOrder.OrderConfirmed is {
        send event CateringOrder.OrderConfirmed to outlet CateringOrderEvents
      }
      on event CateringOrder.DeliveryInfoSet is {
        send event CateringOrder.DeliveryInfoSet to outlet CateringOrderEvents
      }
      on event CateringOrder.StaffAssigned is {
        send event CateringOrder.StaffAssigned to outlet CateringOrderEvents
      }
      on event CateringOrder.PreparationStarted is {
        send event CateringOrder.PreparationStarted to outlet CateringOrderEvents
      }
      on event CateringOrder.OrderReady is {
        send event CateringOrder.OrderReady to outlet CateringOrderEvents
      }
      on event CateringOrder.DeliveryDispatched is {
        send event CateringOrder.DeliveryDispatched to outlet CateringOrderEvents
      }
      on event CateringOrder.DeliveryConfirmed is {
        send event CateringOrder.DeliveryConfirmed to outlet CateringOrderEvents
      }
      on event CateringOrder.PaymentRecorded is {
        send event CateringOrder.PaymentRecorded to outlet CateringOrderEvents
      }
      on event CateringOrder.OrderCompleted is {
        send event CateringOrder.OrderCompleted to outlet CateringOrderEvents
      }
      on event CateringOrder.OrderCancelled is {
        send event CateringOrder.OrderCancelled to outlet CateringOrderEvents
      }
      on other is {
        error "Unexpected message for source CateringOrderEventSource"
      }
    } with {
      briefly "CateringOrder source handler"
      described as {
        |Publishes CateringOrder events onto the outlet.
      }
    }
  } with {
    briefly "CateringOrder event source"
    described as {
      |Publishes CateringOrder entity events into the streaming topology.
    }
  }
  processor CateringOrderEventSink as sink is {
    inlet CateringOrderInlet is type CateringOrderEvent
    handler CateringOrderSinkHandler is {
      on event CateringOrder.OrderCreated is {
        tell event CateringOrder.OrderCreated to repository CateringContext.OrderRepository
      }
      on event CateringOrder.MenuItemAdded is {
        tell event CateringOrder.MenuItemAdded to repository CateringContext.OrderRepository
      }
      on event CateringOrder.MenuItemRemoved is {
        tell event CateringOrder.MenuItemRemoved to repository CateringContext.OrderRepository
      }
      on event CateringOrder.OrderConfirmed is {
        tell event CateringOrder.OrderConfirmed to repository CateringContext.OrderRepository
      }
      on event CateringOrder.DeliveryInfoSet is {
        tell event CateringOrder.DeliveryInfoSet to repository CateringContext.OrderRepository
      }
      on event CateringOrder.StaffAssigned is {
        tell event CateringOrder.StaffAssigned to repository CateringContext.OrderRepository
      }
      on event CateringOrder.PreparationStarted is {
        tell event CateringOrder.PreparationStarted to repository CateringContext.OrderRepository
      }
      on event CateringOrder.OrderReady is {
        tell event CateringOrder.OrderReady to repository CateringContext.OrderRepository
      }
      on event CateringOrder.DeliveryDispatched is {
        tell event CateringOrder.DeliveryDispatched to repository CateringContext.OrderRepository
      }
      on event CateringOrder.DeliveryConfirmed is {
        tell event CateringOrder.DeliveryConfirmed to repository CateringContext.OrderRepository
      }
      on event CateringOrder.PaymentRecorded is {
        tell event CateringOrder.PaymentRecorded to repository CateringContext.OrderRepository
      }
      on event CateringOrder.OrderCompleted is {
        tell event CateringOrder.OrderCompleted to repository CateringContext.OrderRepository
      }
      on event CateringOrder.OrderCancelled is {
        tell event CateringOrder.OrderCancelled to repository CateringContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink CateringOrderEventSink"
      }
    } with {
      briefly "CateringOrder sink handler"
      described as {
        |Persists CateringOrder events via the repository.
      }
    }
  } with {
    briefly "CateringOrder event sink"
    described as {
      |Receives CateringOrder events for persistence.
    }
  }
  connector CateringOrderEventFlow is {
    from outlet CateringContext.CateringOrderEventSource.CateringOrderEvents to
      inlet CateringContext.CateringOrderEventSink.CateringOrderInlet
  } with {
    briefly "CateringOrder event flow"
    described as {
      |Connects the CateringOrder source to its sink.
    }
  }
  processor CateringOrderEventSplit is {
    inlet CateringOrderEventSplitIn is type CateringOrderEvent
    outlet CateringOrderEventSplitToOrderRepository is type CateringOrderEvent
    outlet CateringOrderEventSplitToCateringAnalytics is type CateringOrderEvent
    handler CateringOrderEventSplitHandler is {
      on event CateringOrder.OrderCreated is {
        send event CateringOrder.OrderCreated to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.OrderCreated to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.OrderCreated to entity CateringContext.CateringOrder
      }
      on event CateringOrder.MenuItemAdded is {
        send event CateringOrder.MenuItemAdded to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.MenuItemAdded to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.MenuItemAdded to entity CateringContext.CateringOrder
      }
      on event CateringOrder.MenuItemRemoved is {
        send event CateringOrder.MenuItemRemoved to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.MenuItemRemoved to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.MenuItemRemoved to entity CateringContext.CateringOrder
      }
      on event CateringOrder.OrderConfirmed is {
        send event CateringOrder.OrderConfirmed to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.OrderConfirmed to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.OrderConfirmed to entity CateringContext.CateringOrder
      }
      on event CateringOrder.DeliveryInfoSet is {
        send event CateringOrder.DeliveryInfoSet to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.DeliveryInfoSet to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.DeliveryInfoSet to entity CateringContext.CateringOrder
      }
      on event CateringOrder.StaffAssigned is {
        send event CateringOrder.StaffAssigned to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.StaffAssigned to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.StaffAssigned to entity CateringContext.CateringOrder
      }
      on event CateringOrder.PreparationStarted is {
        send event CateringOrder.PreparationStarted to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.PreparationStarted to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.PreparationStarted to entity CateringContext.CateringOrder
      }
      on event CateringOrder.OrderReady is {
        send event CateringOrder.OrderReady to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.OrderReady to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.OrderReady to entity CateringContext.CateringOrder
      }
      on event CateringOrder.DeliveryDispatched is {
        send event CateringOrder.DeliveryDispatched to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.DeliveryDispatched to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.DeliveryDispatched to entity CateringContext.CateringOrder
      }
      on event CateringOrder.DeliveryConfirmed is {
        send event CateringOrder.DeliveryConfirmed to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.DeliveryConfirmed to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.DeliveryConfirmed to entity CateringContext.CateringOrder
      }
      on event CateringOrder.PaymentRecorded is {
        send event CateringOrder.PaymentRecorded to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.PaymentRecorded to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.PaymentRecorded to entity CateringContext.CateringOrder
      }
      on event CateringOrder.OrderCompleted is {
        send event CateringOrder.OrderCompleted to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.OrderCompleted to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.OrderCompleted to entity CateringContext.CateringOrder
      }
      on event CateringOrder.OrderCancelled is {
        send event CateringOrder.OrderCancelled to outlet CateringOrderEventSplitToOrderRepository
        send event CateringOrder.OrderCancelled to outlet CateringOrderEventSplitToCateringAnalytics
        tell event CateringOrder.OrderCancelled to entity CateringContext.CateringOrder
      }
      on other is {
        error "Unexpected message for processor CateringOrderEventSplit"
      }
    } with {
      briefly "CateringOrder event fan-out handler"
      described as {
        |Delivers each CateringOrder event to all of its consumers.
      }
    }
  } with {
    briefly "CateringOrder event fan-out"
    described as {
      |Fans CateringOrder events out to the repository and projectors.
    }
  }
  connector LinkCateringOrderToCateringOrderEventSplit is {
    from outlet CateringContext.CateringOrder.CateringOrderEvents2 to
      inlet CateringContext.CateringOrderEventSplit.CateringOrderEventSplitIn
  } with {
    briefly "LinkCateringOrderToCateringOrderEventSplit"
  }
  connector LinkCateringOrderEventSplitToOrderRepository is {
    from outlet CateringContext.CateringOrderEventSplit.CateringOrderEventSplitToOrderRepository to
      inlet CateringContext.OrderRepository.OrderRepositoryFromCateringOrder
  } with {
    briefly "LinkCateringOrderEventSplitToOrderRepository"
  }
  connector LinkCateringOrderEventSplitToCateringAnalytics is {
    from outlet CateringContext.CateringOrderEventSplit.CateringOrderEventSplitToCateringAnalytics to
      inlet CateringContext.CateringAnalytics.CateringAnalyticsFromCateringOrder
  } with {
    briefly "LinkCateringOrderEventSplitToCateringAnalytics"
  }
  connector LinkCateringAnalyticsToOrderRepository is {
    from outlet CateringContext.CateringAnalytics.CateringAnalyticsOut to
      inlet CateringContext.OrderRepository.OrderRepositoryFromCateringAnalytics
  } with {
    briefly "LinkCateringAnalyticsToOrderRepository"
  }
} with {
  briefly "Bounded context for catering management"
  described as {
    | The CateringContext is the bounded context for
    | event catering orders and operations.
  }
}
