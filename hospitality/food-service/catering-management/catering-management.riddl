// Catering Management Domain Model
// Event catering services and operations management
domain CateringManagement is {
  persistent connector 'StaffSchedulingServiceReply Stream' is from outlet StaffSchedulingService.StaffSchedulingServiceRepliesOut to inlet CateringContext.ToStaffSchedulingService.ToStaffSchedulingServiceReplies with {
    briefly "What StaffSchedulingService answers CateringContext"
  }
  persistent connector 'PricingServiceReply Stream' is from outlet PricingService.PricingServiceRepliesOut to inlet CateringContext.ToPricingService.ToPricingServiceReplies with {
    briefly "What PricingService answers CateringContext"
  }
  persistent connector 'MenuCatalogServiceReply Stream' is from outlet MenuCatalogService.MenuCatalogServiceRepliesOut to inlet CateringContext.ToMenuCatalogService.ToMenuCatalogServiceReplies with {
    briefly "What MenuCatalogService answers CateringContext"
  }
  persistent connector 'InventoryServiceReply Stream' is from outlet InventoryService.InventoryServiceRepliesOut to inlet CateringContext.ToInventoryService.ToInventoryServiceReplies with {
    briefly "What InventoryService answers CateringContext"
  }
  persistent connector 'DeliveryServiceEvent Stream' is from outlet DeliveryService.DeliveryServiceEventsOut to inlet CateringContext.FromDeliveryService.FromDeliveryServiceIn with {
    briefly "What DeliveryService tells CateringContext, unasked"
  }
  persistent connector 'InventoryServiceEvent Stream' is from outlet InventoryService.InventoryServiceEventsOut to inlet CateringContext.FromInventoryService.FromInventoryServiceIn with {
    briefly "What InventoryService tells CateringContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet CateringContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells CateringContext, unasked"
  }
  persistent connector 'StaffSchedulingServiceEvent Stream' is from outlet StaffSchedulingService.StaffSchedulingServiceEventsOut to inlet CateringContext.FromStaffSchedulingService.FromStaffSchedulingServiceIn with {
    briefly "What StaffSchedulingService tells CateringContext, unasked"
  }
  persistent connector 'PricingServiceRequest Stream' is from outlet CateringContext.ToPricingService.ToPricingServiceOut to inlet PricingService.PricingServiceRequests with {
    briefly "What CateringContext asks PricingService to send"
  }
  persistent connector 'MenuCatalogServiceRequest Stream' is from outlet CateringContext.ToMenuCatalogService.ToMenuCatalogServiceOut to inlet MenuCatalogService.MenuCatalogServiceRequests with {
    briefly "What CateringContext asks MenuCatalogService to send"
  }
  persistent connector 'DeliveryServiceRequest Stream' is from outlet CateringContext.ToDeliveryService.ToDeliveryServiceOut to inlet DeliveryService.DeliveryServiceRequests with {
    briefly "What CateringContext asks DeliveryService to send"
  }
  persistent connector 'StaffSchedulingServiceRequest Stream' is from outlet CateringContext.ToStaffSchedulingService.ToStaffSchedulingServiceOut to inlet StaffSchedulingService.StaffSchedulingServiceRequests with {
    briefly "What CateringContext asks StaffSchedulingService to send"
  }
  persistent connector 'InventoryServiceRequest Stream' is from outlet CateringContext.ToInventoryService.ToInventoryServiceOut to inlet InventoryService.InventoryServiceRequests with {
    briefly "What CateringContext asks InventoryService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet CateringContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What CateringContext asks PaymentProcessingService to send"
  }
  persistent connector 'NotificationRequest Stream' is from outlet CateringContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What catering asks the notification service to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user CateringManager is "person managing catering operations" with {
    briefly "Catering Manager"
    described as {
      |Person overseeing catering services.
    }
  }
  user EventCoordinator is "person coordinating event details" with {
    briefly "Event Coordinator"
    described as {
      |Person arranging event requirements.
    }
  }
  user Chef is "person preparing food" with {
    briefly "Chef"
    described as {
      |Culinary staff member.
    }
  }
  epic CateringEpic is {
    user EventCoordinator wants to "to manage catering orders" so that "events are properly catered"
    case BookCateringService is {
      user EventCoordinator wants to "to book catering for an event" so that "food service is arranged"
      step is "Coordinator selects" "menu options" "from catalog" with {
        briefly "Select menu"
        described as {
          |Choose menu items.
        }
      }
      step is "System calculates" "pricing and requirements" "based on guest count" with {
        briefly "Calculate pricing"
        described as {
          |Determine costs.
        }
      }
      step take input CateringManagementApp.CateringManagementScreen.CreateOrderInput from user EventCoordinator with {
        briefly "Create order"
        described as {
          |Submit catering order.
        }
      }
      step is "System confirms" "order details" "to coordinator" with {
        briefly "Confirm order"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Book catering"
      described as {
        |Booking catering services for events.
      }
    }
  } with {
    briefly "Catering management"
    described as {
      | Epic covering catering order management,
      | menu planning, and event service delivery.
    }
  }
  include "CateringContext.riddl"
  include "external-contexts.riddl"
  application context CateringManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CateringManagement are delivered.
      }
    }
    group CateringManagementScreen is {
      input CreateOrderInput acquires command CateringContext.CateringOrder.CreateOrder with {
        briefly "Create order control"
        described as {
          |The control through which a user submits the create order request.
        }
      }
    } with {
      briefly "Catering management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCateringOrderCommands is type CateringContext.CateringOrder.CateringOrderCommand
    inlet AppOrderRepositoryResponses is result CateringContext.CateringOrder.CateringOrderResult    handler CateringManagementAppHandler is {
      on other is {
        error "Unexpected message for application context CateringManagementApp"
      }
    } with {
      briefly "CateringManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CateringManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CateringOrderCommand Stream' is from outlet CateringManagementApp.AppCateringOrderCommands to inlet CateringContext.CateringOrderCommandStreamIn with {
    briefly "CateringOrder commands from the application"
  }
  persistent connector 'MarketplaceOrderResult Stream' is from outlet CateringContext.MarketplaceOrderResultStreamOut to inlet CateringManagementApp.AppOrderRepositoryResponses with {
    briefly "Order query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CateringManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term GuestCount is "The number of guests, which drives pricing and staffing requirements."
  briefly "Catering management domain"
  described as {
    | The CateringManagement domain handles event catering
    | services including orders, menus, and delivery.
  }
}
