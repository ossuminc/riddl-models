// Restaurant Operations - Order Context
context OrderContext is {
  adaptor FromKitchenDisplayService from context KitchenDisplayService is { 
    handler FromKitchenDisplayServiceHandler is {
      on event KitchenDisplayService.TicketBumped is {
        do "the model receives ticket bumped"
      }
      on event KitchenDisplayService.TicketDisplayed is {
        do "the model receives ticket displayed"
      }
      on other is {
        error "Unexpected message for adaptor FromKitchenDisplayService"
      }
    } with {
      briefly "from kitchen display service"
      described as {
        |Carries messages from the external KitchenDisplayService.
      }
    }
  } with {
    briefly "KitchenDisplayService integration"
    described as {
      |The model's side of the KitchenDisplayService conversation.
    }
  }
  adaptor ToKitchenDisplayService to context KitchenDisplayService is { 
    handler ToKitchenDisplayServiceHandler is {
      on command KitchenDisplayService.BumpTicket is {
        do "the model sends bump ticket"
      }
      on command KitchenDisplayService.SendTicket is {
        do "the model sends send ticket"
      }
      on other is {
        error "Unexpected message for adaptor ToKitchenDisplayService"
      }
    } with {
      briefly "to kitchen display service"
      described as {
        |Carries messages to the external KitchenDisplayService.
      }
    }
  } with {
    briefly "KitchenDisplayService integration"
    described as {
      |The model's side of the KitchenDisplayService conversation.
    }
  }
  adaptor FromMenuService from context MenuService is { 
    handler FromMenuServiceHandler is {
      on event MenuService.AvailabilityUpdated is {
        do "the model receives availability updated"
      }
      on result MenuService.ItemDetails is {
        do "the model receives item details"
      }
      on result MenuService.MenuItems is {
        do "the model receives menu items"
      }
      on other is {
        error "Unexpected message for adaptor FromMenuService"
      }
    } with {
      briefly "from menu service"
      described as {
        |Carries messages from the external MenuService.
      }
    }
  } with {
    briefly "MenuService integration"
    described as {
      |The model's side of the MenuService conversation.
    }
  }
  adaptor ToMenuService to context MenuService is { 
    handler ToMenuServiceHandler is {
      on query MenuService.GetItemDetails is {
        do "the model sends get item details"
      }
      on query MenuService.GetMenuItems is {
        do "the model sends get menu items"
      }
      on command MenuService.UpdateAvailability is {
        do "the model sends update availability"
      }
      on other is {
        error "Unexpected message for adaptor ToMenuService"
      }
    } with {
      briefly "to menu service"
      described as {
        |Carries messages to the external MenuService.
      }
    }
  } with {
    briefly "MenuService integration"
    described as {
      |The model's side of the MenuService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.CardPaymentFailed is {
        do "the model receives card payment failed"
      }
      on event PaymentProcessingService.CardPaymentProcessed is {
        do "the model receives card payment processed"
      }
      on event PaymentProcessingService.RefundProcessed is {
        do "the model receives refund processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessCardPayment is {
        do "the model sends process card payment"
      }
      on command PaymentProcessingService.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromReceiptPrintingService from context ReceiptPrintingService is { 
    handler FromReceiptPrintingServiceHandler is {
      on event ReceiptPrintingService.KitchenTicketPrinted is {
        do "the model receives kitchen ticket printed"
      }
      on event ReceiptPrintingService.ReceiptPrinted is {
        do "the model receives receipt printed"
      }
      on other is {
        error "Unexpected message for adaptor FromReceiptPrintingService"
      }
    } with {
      briefly "from receipt printing service"
      described as {
        |Carries messages from the external ReceiptPrintingService.
      }
    }
  } with {
    briefly "ReceiptPrintingService integration"
    described as {
      |The model's side of the ReceiptPrintingService conversation.
    }
  }
  adaptor ToReceiptPrintingService to context ReceiptPrintingService is { 
    handler ToReceiptPrintingServiceHandler is {
      on command ReceiptPrintingService.PrintKitchenTicket is {
        do "the model sends print kitchen ticket"
      }
      on command ReceiptPrintingService.PrintReceipt is {
        do "the model sends print receipt"
      }
      on other is {
        error "Unexpected message for adaptor ToReceiptPrintingService"
      }
    } with {
      briefly "to receipt printing service"
      described as {
        |Carries messages to the external ReceiptPrintingService.
      }
    }
  } with {
    briefly "ReceiptPrintingService integration"
    described as {
      |The model's side of the ReceiptPrintingService conversation.
    }
  }
  adaptor FromReservationService from context ReservationService is { 
    handler FromReservationServiceHandler is {
      on result ReservationService.ReservationDetails is {
        do "the model receives reservation details"
      }
      on event ReservationService.ReservationSeated is {
        do "the model receives reservation seated"
      }
      on other is {
        error "Unexpected message for adaptor FromReservationService"
      }
    } with {
      briefly "from reservation service"
      described as {
        |Carries messages from the external ReservationService.
      }
    }
  } with {
    briefly "ReservationService integration"
    described as {
      |The model's side of the ReservationService conversation.
    }
  }
  adaptor ToReservationService to context ReservationService is { 
    handler ToReservationServiceHandler is {
      on query ReservationService.GetReservation is {
        do "the model sends get reservation"
      }
      on command ReservationService.MarkSeated is {
        do "the model sends mark seated"
      }
      on other is {
        error "Unexpected message for adaptor ToReservationService"
      }
    } with {
      briefly "to reservation service"
      described as {
        |Carries messages to the external ReservationService.
      }
    }
  } with {
    briefly "ReservationService integration"
    described as {
      |The model's side of the ReservationService conversation.
    }
  }
  adaptor FromTableManagementService from context TableManagementService is { 
    handler FromTableManagementServiceHandler is {
      on result TableManagementService.AvailableTables is {
        do "the model receives available tables"
      }
      on event TableManagementService.TableAssigned is {
        do "the model receives table assigned"
      }
      on event TableManagementService.TableReleased is {
        do "the model receives table released"
      }
      on other is {
        error "Unexpected message for adaptor FromTableManagementService"
      }
    } with {
      briefly "from table management service"
      described as {
        |Carries messages from the external TableManagementService.
      }
    }
  } with {
    briefly "TableManagementService integration"
    described as {
      |The model's side of the TableManagementService conversation.
    }
  }
  adaptor ToTableManagementService to context TableManagementService is { 
    handler ToTableManagementServiceHandler is {
      on command TableManagementService.AssignTable is {
        do "the model sends assign table"
      }
      on query TableManagementService.GetAvailableTables is {
        do "the model sends get available tables"
      }
      on command TableManagementService.ReleaseTable is {
        do "the model sends release table"
      }
      on other is {
        error "Unexpected message for adaptor ToTableManagementService"
      }
    } with {
      briefly "to table management service"
      described as {
        |Carries messages to the external TableManagementService.
      }
    }
  } with {
    briefly "TableManagementService integration"
    described as {
      |The model's side of the TableManagementService conversation.
    }
  }
  include "types.riddl"
  include "TableOrder.riddl"
  // Repository for order persistence
  repository OrderRepository as merge is {
    inlet OrderRepositoryFromTableOrder is type TableOrderEvent    inlet OrderRepositoryFromRestaurantAnalytics is type TableOrderEvent    outlet OrderRepositoryResponses is type TableOrder.TableOrderResult
    record StoredTableOrder is  {
      tableOrderId: TableOrderId with {
        briefly "tableOrderId"
        described as {
          |The tableOrderId column of the stored tableOrder row.
        }
      }
      orderId: TableOrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored tableOrder row.
        }
      }
      server: ServerId with {
        briefly "server"
        described as {
          |The server column of the stored tableOrder row.
        }
      }
      table: TableInfo with {
        briefly "table"
        described as {
          |The table column of the stored tableOrder row.
        }
      }
    } with {
      briefly "Stored tableOrder row"
      described as {
        |The persistence shape of tableOrder data as this repository stores it.
      }
    }
    schema OrderData is relational
      of orders as type StoredTableOrder
        index on field StoredTableOrder.orderId
        index on field StoredTableOrder.table.tableId
        index on field StoredTableOrder.server
 with {
      briefly "Order data schema"
      described as {
        |The relational schema holding order data for the OrderRepository.
      }
    }
    handler OrderPersistence is {
      on query GetRestaurantStats is {
        do "read the restaurant stats projection"
        yield result RestaurantStatsView
      }
      on command TableOrder.CreateOrder is {
        tell event TableOrder.OrderCreated to entity OrderContext.TableOrder
        do "Store new order"
      }
      on command TableOrder.AddItem is {
        tell event TableOrder.ItemAdded to entity OrderContext.TableOrder
        do "Add line item to order"
      }
      on command TableOrder.ModifyItem is {
        do "Update line item"
      }
      on command TableOrder.VoidItem is {
        do "Mark item as voided"
      }
      on command TableOrder.SubmitOrder is {
        tell event TableOrder.OrderSubmitted to entity OrderContext.TableOrder
        do "Update order to submitted"
      }
      on command TableOrder.MarkItemPreparing is {
        do "Update item to preparing"
      }
      on command TableOrder.MarkItemReady is {
        do "Update item to ready"
      }
      on command TableOrder.ServeItem is {
        do "Update item to served"
      }
      on command TableOrder.RequestBill is {
        do "Store bill request"
      }
      on command TableOrder.ApplyDiscount is {
        do "Store discount"
      }
      on command TableOrder.ProcessPayment is {
        tell event TableOrder.PaymentProcessed to entity OrderContext.TableOrder
        do "Store payment"
      }
      on command TableOrder.SplitBill is {
        do "Store bill split"
      }
      on command TableOrder.CloseOrder is {
        tell event TableOrder.OrderClosed to entity OrderContext.TableOrder
        do "Update order to closed"
      }
      on command TableOrder.CancelOrder is {
        tell event TableOrder.OrderCancelled to entity OrderContext.TableOrder
        do "Update order to cancelled"
      }
    } with {
      briefly "Persists order commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Order data persistence"
    described as {
      | The OrderRepository provides persistent storage for
      | table orders and related data.
    }
  }
  // Projector for restaurant analytics
  query GetRestaurantStats is  {
    restaurantStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which restaurant stats to retrieve.
      }
    }
  } with {
    briefly "Get restaurant stats"
    described as {
      |Retrieves the restaurant stats projection.
    }
  }
  result RestaurantStatsView is  {
    restaurantStats: RestaurantAnalytics.RestaurantStats with {
      briefly "Restaurant stats"
      described as {
        |The restaurant stats being returned.
      }
    }
  } with {
    briefly "Restaurant stats view"
    described as {
      |Read model view carrying the restaurant stats projection.
    }
  }
  projector RestaurantAnalytics as flow is {
    updates repository OrderContext.OrderRepository
    inlet RestaurantAnalyticsFromTableOrder is type TableOrderEvent    outlet RestaurantAnalyticsOut is type TableOrderEvent
    record RestaurantStats is  {
      totalOrders: Natural with {
        briefly "Total"
        described as {
          |Total orders.
        }
      }
      openOrders: Natural with {
        briefly "Open"
        described as {
          |Open orders.
        }
      }
      completedOrders: Natural with {
        briefly "Completed"
        described as {
          |Completed orders.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageOrderValue: Decimal(10,2) with {
        briefly "AOV"
        described as {
          |Average order value.
        }
      }
      averageTableTurnTime: Duration with {
        briefly "Turn time"
        described as {
          |Average table turn.
        }
      }
    } with {
      briefly "Restaurant statistics"
      described as {
        |Restaurant operations metrics.
      }
    }
    handler AnalyticsHandler is {
      on event TableOrder.OrderCreated is {
        tell event TableOrder.OrderCreated to repository OrderContext.OrderRepository
        do "Update order counts"
      }
      on event TableOrder.OrderClosed is {
        tell event TableOrder.OrderClosed to repository OrderContext.OrderRepository
        do "Update completion and revenue metrics"
      }
      on event TableOrder.PaymentProcessed is {
        tell event TableOrder.PaymentProcessed to repository OrderContext.OrderRepository
        do "Update payment metrics"
      }
      on event TableOrder.OrderCancelled is {
        tell event TableOrder.OrderCancelled to repository OrderContext.OrderRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains restaurant analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Restaurant analytics projections"
    described as {
      |Maintains restaurant operations analytics data.
    }
  }
  // ---- Event publication for TableOrder ----
  type TableOrderEvent is one of {
    OrderContext.TableOrder.OrderCreated or OrderContext.TableOrder.ItemAdded or OrderContext.TableOrder.ItemModified or OrderContext.TableOrder.ItemVoided or OrderContext.TableOrder.OrderSubmitted or OrderContext.TableOrder.ItemPreparing or OrderContext.TableOrder.ItemReady or OrderContext.TableOrder.ItemServed or OrderContext.TableOrder.BillRequested or OrderContext.TableOrder.DiscountApplied or OrderContext.TableOrder.PaymentProcessed or OrderContext.TableOrder.BillSplit or OrderContext.TableOrder.OrderClosed or OrderContext.TableOrder.OrderCancelled
  } with {
    briefly "TableOrder event alternation"
    described as {
      |Union of all TableOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor TableOrderEventSource as source is {
    outlet TableOrderEvents is type TableOrderEvent
    handler TableOrderSourceHandler is {
      on event TableOrder.OrderCreated is {
        send event TableOrder.OrderCreated to outlet TableOrderEvents
      }
      on event TableOrder.ItemAdded is {
        send event TableOrder.ItemAdded to outlet TableOrderEvents
      }
      on event TableOrder.ItemModified is {
        send event TableOrder.ItemModified to outlet TableOrderEvents
      }
      on event TableOrder.ItemVoided is {
        send event TableOrder.ItemVoided to outlet TableOrderEvents
      }
      on event TableOrder.OrderSubmitted is {
        send event TableOrder.OrderSubmitted to outlet TableOrderEvents
      }
      on event TableOrder.ItemPreparing is {
        send event TableOrder.ItemPreparing to outlet TableOrderEvents
      }
      on event TableOrder.ItemReady is {
        send event TableOrder.ItemReady to outlet TableOrderEvents
      }
      on event TableOrder.ItemServed is {
        send event TableOrder.ItemServed to outlet TableOrderEvents
      }
      on event TableOrder.BillRequested is {
        send event TableOrder.BillRequested to outlet TableOrderEvents
      }
      on event TableOrder.DiscountApplied is {
        send event TableOrder.DiscountApplied to outlet TableOrderEvents
      }
      on event TableOrder.PaymentProcessed is {
        send event TableOrder.PaymentProcessed to outlet TableOrderEvents
      }
      on event TableOrder.BillSplit is {
        send event TableOrder.BillSplit to outlet TableOrderEvents
      }
      on event TableOrder.OrderClosed is {
        send event TableOrder.OrderClosed to outlet TableOrderEvents
      }
      on event TableOrder.OrderCancelled is {
        send event TableOrder.OrderCancelled to outlet TableOrderEvents
      }
      on other is {
        error "Unexpected message for source TableOrderEventSource"
      }
    } with {
      briefly "TableOrder source handler"
      described as {
        |Publishes TableOrder events onto the outlet.
      }
    }
  } with {
    briefly "TableOrder event source"
    described as {
      |Publishes TableOrder entity events into the streaming topology.
    }
  }
  processor TableOrderEventSink as sink is {
    inlet TableOrderInlet is type TableOrderEvent    handler TableOrderSinkHandler is {
      on event TableOrder.OrderCreated is {
        tell event TableOrder.OrderCreated to repository OrderContext.OrderRepository
      }
      on event TableOrder.ItemAdded is {
        tell event TableOrder.ItemAdded to repository OrderContext.OrderRepository
      }
      on event TableOrder.ItemModified is {
        tell event TableOrder.ItemModified to repository OrderContext.OrderRepository
      }
      on event TableOrder.ItemVoided is {
        tell event TableOrder.ItemVoided to repository OrderContext.OrderRepository
      }
      on event TableOrder.OrderSubmitted is {
        tell event TableOrder.OrderSubmitted to repository OrderContext.OrderRepository
      }
      on event TableOrder.ItemPreparing is {
        tell event TableOrder.ItemPreparing to repository OrderContext.OrderRepository
      }
      on event TableOrder.ItemReady is {
        tell event TableOrder.ItemReady to repository OrderContext.OrderRepository
      }
      on event TableOrder.ItemServed is {
        tell event TableOrder.ItemServed to repository OrderContext.OrderRepository
      }
      on event TableOrder.BillRequested is {
        tell event TableOrder.BillRequested to repository OrderContext.OrderRepository
      }
      on event TableOrder.DiscountApplied is {
        tell event TableOrder.DiscountApplied to repository OrderContext.OrderRepository
      }
      on event TableOrder.PaymentProcessed is {
        tell event TableOrder.PaymentProcessed to repository OrderContext.OrderRepository
      }
      on event TableOrder.BillSplit is {
        tell event TableOrder.BillSplit to repository OrderContext.OrderRepository
      }
      on event TableOrder.OrderClosed is {
        tell event TableOrder.OrderClosed to repository OrderContext.OrderRepository
      }
      on event TableOrder.OrderCancelled is {
        tell event TableOrder.OrderCancelled to repository OrderContext.OrderRepository
      }
      on other is {
        error "Unexpected message for sink TableOrderEventSink"
      }
    } with {
      briefly "TableOrder sink handler"
      described as {
        |Persists TableOrder events via the repository.
      }
    }
  } with {
    briefly "TableOrder event sink"
    described as {
      |Receives TableOrder events for persistence.
    }
  }
  connector TableOrderEventFlow is from outlet OrderContext.TableOrderEventSource.TableOrderEvents to inlet OrderContext.TableOrderEventSink.TableOrderInlet with {
    briefly "TableOrder event flow"
    described as {
      |Connects the TableOrder source to its sink.
    }
  }
  processor TableOrderEventSplit as split is {
    inlet TableOrderEventSplitIn is type TableOrderEvent    outlet TableOrderEventSplitToOrderRepository is type TableOrderEvent
    outlet TableOrderEventSplitToRestaurantAnalytics is type TableOrderEvent
    handler TableOrderEventSplitHandler is {
      on event TableOrder.OrderCreated is {
        send event TableOrder.OrderCreated to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.OrderCreated to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.OrderCreated to entity OrderContext.TableOrder
      }
      on event TableOrder.ItemAdded is {
        send event TableOrder.ItemAdded to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.ItemAdded to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.ItemAdded to entity OrderContext.TableOrder
      }
      on event TableOrder.ItemModified is {
        send event TableOrder.ItemModified to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.ItemModified to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.ItemModified to entity OrderContext.TableOrder
      }
      on event TableOrder.ItemVoided is {
        send event TableOrder.ItemVoided to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.ItemVoided to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.ItemVoided to entity OrderContext.TableOrder
      }
      on event TableOrder.OrderSubmitted is {
        send event TableOrder.OrderSubmitted to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.OrderSubmitted to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.OrderSubmitted to entity OrderContext.TableOrder
      }
      on event TableOrder.ItemPreparing is {
        send event TableOrder.ItemPreparing to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.ItemPreparing to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.ItemPreparing to entity OrderContext.TableOrder
      }
      on event TableOrder.ItemReady is {
        send event TableOrder.ItemReady to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.ItemReady to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.ItemReady to entity OrderContext.TableOrder
      }
      on event TableOrder.ItemServed is {
        send event TableOrder.ItemServed to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.ItemServed to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.ItemServed to entity OrderContext.TableOrder
      }
      on event TableOrder.BillRequested is {
        send event TableOrder.BillRequested to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.BillRequested to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.BillRequested to entity OrderContext.TableOrder
      }
      on event TableOrder.DiscountApplied is {
        send event TableOrder.DiscountApplied to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.DiscountApplied to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.DiscountApplied to entity OrderContext.TableOrder
      }
      on event TableOrder.PaymentProcessed is {
        send event TableOrder.PaymentProcessed to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.PaymentProcessed to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.PaymentProcessed to entity OrderContext.TableOrder
      }
      on event TableOrder.BillSplit is {
        send event TableOrder.BillSplit to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.BillSplit to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.BillSplit to entity OrderContext.TableOrder
      }
      on event TableOrder.OrderClosed is {
        send event TableOrder.OrderClosed to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.OrderClosed to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.OrderClosed to entity OrderContext.TableOrder
      }
      on event TableOrder.OrderCancelled is {
        send event TableOrder.OrderCancelled to outlet TableOrderEventSplitToOrderRepository
        send event TableOrder.OrderCancelled to outlet TableOrderEventSplitToRestaurantAnalytics
        tell event TableOrder.OrderCancelled to entity OrderContext.TableOrder
      }
      on other is {
        error "Unexpected message for processor TableOrderEventSplit"
      }
    } with {
      briefly "TableOrder event fan-out handler"
      described as {
        |Delivers each TableOrder event to all of its consumers.
      }
    }
  } with {
    briefly "TableOrder event fan-out"
    described as {
      |Fans TableOrder events out to the repository and projectors.
    }
  }
  connector 'TableOrderEvent Stream' is from outlet OrderContext.TableOrder.TableOrderEvents2 to inlet OrderContext.TableOrderEventSplit.TableOrderEventSplitIn with {
    briefly "TableOrder events, fanned out to storage and read models"
  }
  connector 'TableOrderEvent Storage' is from outlet OrderContext.TableOrderEventSplit.TableOrderEventSplitToOrderRepository to inlet OrderContext.OrderRepository.OrderRepositoryFromTableOrder with {
    briefly "TableOrder events on their way to storage"
  }
  connector 'RestaurantAnalytics Feed' is from outlet OrderContext.TableOrderEventSplit.TableOrderEventSplitToRestaurantAnalytics to inlet OrderContext.RestaurantAnalytics.RestaurantAnalyticsFromTableOrder with {
    briefly "TableOrder events feeding the RestaurantAnalytics projection"
  }
  connector 'RestaurantAnalytics Storage' is from outlet OrderContext.RestaurantAnalytics.RestaurantAnalyticsOut to inlet OrderContext.OrderRepository.OrderRepositoryFromRestaurantAnalytics with {
    briefly "The RestaurantAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for restaurant orders"
  described as {
    | The OrderContext is the bounded context for
    | table orders and restaurant service operations.
  }
}
