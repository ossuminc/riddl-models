// Restaurant Operations Domain Model
// Restaurant order management and table service
domain RestaurantOperations is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user RestaurantManager is "person managing restaurant" with {
    briefly "Restaurant Manager"
    described as {
      |Person overseeing restaurant operations.
    }
  }
  user Server is "person serving customers" with {
    briefly "Server"
    described as {
      |Wait staff serving tables.
    }
  }
  user Chef is "person preparing food" with {
    briefly "Chef"
    described as {
      |Kitchen staff preparing orders.
    }
  }
  user Host is "person managing seating" with {
    briefly "Host"
    described as {
      |Person managing table assignments.
    }
  }
  epic RestaurantEpic is {
    user Server wants to "to manage table orders" so that "customers are served efficiently"
    case ProcessDineInOrder is {
      user Server wants to "to take and submit a table order" so that "the kitchen can prepare the food"
      step is "Server takes" "order from customers" "at table" with {
        briefly "Take order"
        described as {
          |Record customer order.
        }
      }
      step take input RestaurantOperationsApp.RestaurantOperationsScreen.CreateOrderInput from user Server with {
        briefly "Submit order"
        described as {
          |Send order to kitchen.
        }
      }
      step is "Kitchen receives" "order for preparation" "on display" with {
        briefly "Kitchen receives"
        described as {
          |Order appears in kitchen.
        }
      }
      step is "Server delivers" "food to table" "when ready" with {
        briefly "Deliver food"
        described as {
          |Serve customers.
        }
      }
    } with {
      briefly "Process dine-in order"
      described as {
        |Taking and fulfilling table orders.
      }
    }
  } with {
    briefly "Restaurant management"
    described as {
      | Epic covering table management, order processing,
      | and restaurant service operations.
    }
  }
  include "OrderContext.riddl"
  include "external-contexts.riddl"
  application context RestaurantOperationsApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RestaurantOperations are delivered.
      }
    }
    group RestaurantOperationsScreen is {
      input CreateOrderInput acquires command OrderContext.TableOrder.CreateOrder with {
        briefly "Create order control"
        described as {
          |The control through which a user submits the create order request.
        }
      }
    } with {
      briefly "Restaurant operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTableOrderCommands is type OrderContext.TableOrder.TableOrderCommand
    inlet AppOrderRepositoryResponses is type OrderContext.TableOrder.TableOrderResult    handler RestaurantOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context RestaurantOperationsApp"
      }
    } with {
      briefly "RestaurantOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RestaurantOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TableOrderCommand Stream' is from outlet RestaurantOperationsApp.AppTableOrderCommands to inlet OrderContext.TableOrder.TableOrderCommands with {
    briefly "TableOrder commands from the application"
  }
  persistent connector 'MarketplaceOrderResult Stream' is from outlet OrderContext.OrderRepository.OrderRepositoryResponses to inlet RestaurantOperationsApp.AppOrderRepositoryResponses with {
    briefly "Order query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RestaurantOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Restaurant operations domain"
  described as {
    | The RestaurantOperations domain handles dine-in
    | orders, table management, and kitchen coordination.
  }
}
