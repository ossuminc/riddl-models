// Restaurant Operations Domain Model
// Restaurant order management and table service
domain RestaurantOperations is {
  persistent connector 'TableManagementServiceReply Stream' is from outlet TableManagementService.TableManagementServiceRepliesOut to inlet OrderContext.ToTableManagementService.ToTableManagementServiceReplies with {
    briefly "What TableManagementService answers OrderContext"
  }
  persistent connector 'ReservationServiceReply Stream' is from outlet ReservationService.ReservationServiceRepliesOut to inlet OrderContext.ToReservationService.ToReservationServiceReplies with {
    briefly "What ReservationService answers OrderContext"
  }
  persistent connector 'MenuServiceReply Stream' is from outlet MenuService.MenuServiceRepliesOut to inlet OrderContext.ToMenuService.ToMenuServiceReplies with {
    briefly "What MenuService answers OrderContext"
  }
  persistent connector 'KitchenDisplayServiceEvent Stream' is from outlet KitchenDisplayService.KitchenDisplayServiceEventsOut to inlet OrderContext.FromKitchenDisplayService.FromKitchenDisplayServiceIn with {
    briefly "What KitchenDisplayService tells OrderContext, unasked"
  }
  persistent connector 'MenuServiceEvent Stream' is from outlet MenuService.MenuServiceEventsOut to inlet OrderContext.FromMenuService.FromMenuServiceIn with {
    briefly "What MenuService tells OrderContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet OrderContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells OrderContext, unasked"
  }
  persistent connector 'ReceiptPrintingServiceEvent Stream' is from outlet ReceiptPrintingService.ReceiptPrintingServiceEventsOut to inlet OrderContext.FromReceiptPrintingService.FromReceiptPrintingServiceIn with {
    briefly "What ReceiptPrintingService tells OrderContext, unasked"
  }
  persistent connector 'ReservationServiceEvent Stream' is from outlet ReservationService.ReservationServiceEventsOut to inlet OrderContext.FromReservationService.FromReservationServiceIn with {
    briefly "What ReservationService tells OrderContext, unasked"
  }
  persistent connector 'TableManagementServiceEvent Stream' is from outlet TableManagementService.TableManagementServiceEventsOut to inlet OrderContext.FromTableManagementService.FromTableManagementServiceIn with {
    briefly "What TableManagementService tells OrderContext, unasked"
  }
  persistent connector 'ReceiptPrintingServiceRequest Stream' is from outlet OrderContext.ToReceiptPrintingService.ToReceiptPrintingServiceOut to inlet ReceiptPrintingService.ReceiptPrintingServiceRequests with {
    briefly "What OrderContext asks ReceiptPrintingService to send"
  }
  persistent connector 'KitchenDisplayServiceRequest Stream' is from outlet OrderContext.ToKitchenDisplayService.ToKitchenDisplayServiceOut to inlet KitchenDisplayService.KitchenDisplayServiceRequests with {
    briefly "What OrderContext asks KitchenDisplayService to send"
  }
  persistent connector 'ReservationServiceRequest Stream' is from outlet OrderContext.ToReservationService.ToReservationServiceOut to inlet ReservationService.ReservationServiceRequests with {
    briefly "What OrderContext asks ReservationService to send"
  }
  persistent connector 'MenuServiceRequest Stream' is from outlet OrderContext.ToMenuService.ToMenuServiceOut to inlet MenuService.MenuServiceRequests with {
    briefly "What OrderContext asks MenuService to send"
  }
  persistent connector 'TableManagementServiceRequest Stream' is from outlet OrderContext.ToTableManagementService.ToTableManagementServiceOut to inlet TableManagementService.TableManagementServiceRequests with {
    briefly "What OrderContext asks TableManagementService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet OrderContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What OrderContext asks PaymentProcessingService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user RestaurantManager is "person managing restaurant" with {
    briefly "Restaurant Manager"
    described as {
      |Person overseeing restaurant operations.
    }
  }
  user Server is "person serving customers" with {
    briefly "Server"
    described as {
      |Wait staff serving tables.
    }
  }
  user Chef is "person preparing food" with {
    briefly "Chef"
    described as {
      |Kitchen staff preparing orders.
    }
  }
  user Host is "person managing seating" with {
    briefly "Host"
    described as {
      |Person managing table assignments.
    }
  }
  epic RestaurantEpic is {
    user Server wants to "to manage table orders" so that "customers are served efficiently"
    case ProcessDineInOrder is {
      user Server wants to "to take and submit a table order" so that "the kitchen can prepare the food"
      step is "Server takes" "order from customers" "at table" with {
        briefly "Take order"
        described as {
          |Record customer order.
        }
      }
      step take input RestaurantOperationsApp.RestaurantOperationsScreen.CreateOrderInput from user Server with {
        briefly "Submit order"
        described as {
          |Send order to kitchen.
        }
      }
      step is "Kitchen receives" "order for preparation" "on display" with {
        briefly "Kitchen receives"
        described as {
          |Order appears in kitchen.
        }
      }
      step is "Server delivers" "food to table" "when ready" with {
        briefly "Deliver food"
        described as {
          |Serve customers.
        }
      }
    } with {
      briefly "Process dine-in order"
      described as {
        |Taking and fulfilling table orders.
      }
    }
  } with {
    briefly "Restaurant management"
    described as {
      | Epic covering table management, order processing,
      | and restaurant service operations.
    }
  }
  include "OrderContext.riddl"
  include "external-contexts.riddl"
  application context RestaurantOperationsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in RestaurantOperations are delivered.
      }
    }
    group RestaurantOperationsScreen is {
      input CreateOrderInput acquires command OrderContext.TableOrder.CreateOrder with {
        briefly "Create order control"
        described as {
          |The control through which a user submits the create order request.
        }
      }
    } with {
      briefly "Restaurant operations screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppTableOrderCommands is type OrderContext.TableOrder.TableOrderCommand
    inlet AppOrderRepositoryResponses is result OrderContext.TableOrder.TableOrderResult    handler RestaurantOperationsAppHandler is {
      on other is {
        error "Unexpected message for application context RestaurantOperationsApp"
      }
    } with {
      briefly "RestaurantOperationsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RestaurantOperationsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'TableOrderCommand Stream' is from outlet RestaurantOperationsApp.AppTableOrderCommands to inlet OrderContext.TableOrderCommandStreamIn with {
    briefly "TableOrder commands from the application"
  }
  persistent connector 'MarketplaceOrderResult Stream' is from outlet OrderContext.MarketplaceOrderResultStreamOut to inlet RestaurantOperationsApp.AppOrderRepositoryResponses with {
    briefly "Order query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet RestaurantOperationsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Restaurant operations domain"
  described as {
    | The RestaurantOperations domain handles dine-in
    | orders, table management, and kitchen coordination.
  }
}
