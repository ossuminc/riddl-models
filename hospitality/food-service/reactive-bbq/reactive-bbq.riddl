domain ReactiveBBQ is {
  persistent connector 'OnlineOrderEvent Stream To Reporting' is from outlet OnlineOrdering.OnlineOrderingOnlineOrderToReportingOut to inlet Reporting.FromOnlineOrdering.FromOnlineOrderingIn with {
    briefly "What OnlineOrdering tells Reporting about its onlineorders"
    described as {
      |What OnlineOrdering tells Reporting about its onlineorders.
    }
  }
  persistent connector 'TableOrderEvent Stream To Reporting' is from outlet FrontOfHouse.FrontOfHouseTableOrderToReportingOut to inlet Reporting.FromFrontOfHouseReservations.FromFrontOfHouseReservationsFromTableOrderIn with {
    briefly "What FrontOfHouse tells Reporting about its tableorders"
    described as {
      |What FrontOfHouse tells Reporting about its tableorders.
    }
  }
  persistent connector 'ReservationEvent Stream To Reporting' is from outlet FrontOfHouse.FrontOfHouseReservationToReportingOut to inlet Reporting.FromFrontOfHouseReservations.FromFrontOfHouseReservationsFromReservationIn with {
    briefly "What FrontOfHouse tells Reporting about its reservations"
    described as {
      |What FrontOfHouse tells Reporting about its reservations.
    }
  }
  persistent connector 'OnlineOrderEvent Stream To Delivery' is from outlet OnlineOrdering.OnlineOrderingToDeliveryOut to inlet Delivery.FromOnlineOrdering.FromOnlineOrderingIn with {
    briefly "What OnlineOrdering tells Delivery about its onlineorders"
    described as {
      |What OnlineOrdering tells Delivery about its onlineorders.
    }
  }
  persistent connector 'LoyaltyAccountEvent Stream To Marketing' is from outlet Loyalty.LoyaltyToMarketingOut to inlet Marketing.FromLoyalty.FromLoyaltyIn with {
    briefly "What Loyalty tells Marketing about its loyaltyaccounts"
    described as {
      |What Loyalty tells Marketing about its loyaltyaccounts.
    }
  }
  persistent connector 'CampaignEvent Stream To Loyalty' is from outlet Marketing.MarketingToLoyaltyOut to inlet Loyalty.FromMarketing.FromMarketingIn with {
    briefly "What Marketing tells Loyalty about its campaigns"
    described as {
      |What Marketing tells Loyalty about its campaigns.
    }
  }
  persistent connector 'PurchaseOrderEvent Stream To Inventory' is from outlet SupplyChain.SupplyChainToInventoryOut to inlet Inventory.FromSupplyChain.FromSupplyChainIn with {
    briefly "What SupplyChain tells Inventory about its purchaseorders"
    described as {
      |What SupplyChain tells Inventory about its purchaseorders.
    }
  }
  persistent connector 'KitchenTicketEvent Stream To Inventory' is from outlet Kitchen.KitchenToInventoryOut to inlet Inventory.FromKitchen.FromKitchenIn with {
    briefly "What Kitchen tells Inventory about its kitchentickets"
    described as {
      |What Kitchen tells Inventory about its kitchentickets.
    }
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author of this model"
    described as {
      |Ossum Inc., creators of RIDDL.
    }
  }
  version 1 with {
    briefly "Version of the chain model, bumped when published types change"
    described as {
      |The chain's model version, not the RIDDL language version. A
      |definition's precise version is its versioned ancestors composed
      |root-to-leaf and joined with '.', so this is the leading component
      |for everything beneath it.
      |
      |Bump it when a type another team consumes changes shape. Tools
      |diff a definition's composed version between two revisions of the
      |model to tell a consumer that what they read has moved on.
    }
  }
  // ---- Stakeholder Personas & User Journeys ----
  include "epics/users.riddl"
  include "epics/dine-in-experience.riddl"
  include "epics/online-order-journey.riddl"
  include "epics/kitchen-workflow.riddl"
  include "epics/loyalty-enrollment.riddl"
  // ---- Subdomain Includes ----
  include "restaurant/domain.riddl"
  include "backoffice/domain.riddl"
  include "corporate/domain.riddl"
  // The umbrella domain owns no application of its own -- the three
  // subdomains do -- so its error sink needs a host. Chain-wide errors are
  // deliberately kept separate from any one restaurant's.
  context ChainOperations as sink is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised at the chain level are delivered, as
        |distinct from those raised inside a single subdomain.
      }
    }
  } with {
    briefly "Chain-wide operational concerns"
    described as {
      |The chain as a whole, above any one restaurant, back office or
      |corporate function.
    }
  }
  persistent connector 'MenuReleaseEvent Distribution' is from outlet MenuManagement.MenuReleaseEventsToRestaurants to inlet FrontOfHouse.FromMenuManagementItems.FromMenuManagementItemsIn with {
    briefly "Menu-driven order creation, Corporate to the restaurants"
    described as {
      |Declared here, at the domain both ends descend from, because that is
      |the only scope that can see both. Legal since riddl b57376fa3: a
      |connector may cross a domain boundary when the two domains share an
      |ancestor. `persistent` because it still crosses a context boundary.
    }
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ChainOperations.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term Party is "A group of guests seated together at one table."
  term TicketItem is "An individual item on a kitchen ticket, marked ready when completed."
  briefly "Reactive BBQ restaurant chain"
  described as {
    | A 500+ location BBQ restaurant chain modeled with
    | reactive, event-driven bounded contexts. Addresses
    | peak-hour performance, cascading failure isolation,
    | independent deployability, and unblocks strategic
    | initiatives: loyalty program, electronic menus, and
    | kitchen display screens.
  }
}
