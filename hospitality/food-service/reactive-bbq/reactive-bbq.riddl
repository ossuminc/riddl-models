domain ReactiveBBQ is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author of this model"
    described as {
      |Ossum Inc., creators of RIDDL.
    }
  }
  version 1 with {
    briefly "Version of the chain model, bumped when published types change"
    described as {
      |The chain's model version, not the RIDDL language version. A
      |definition's precise version is its versioned ancestors composed
      |root-to-leaf and joined with '.', so this is the leading component
      |for everything beneath it.
      |
      |Bump it when a type another team consumes changes shape. Tools
      |diff a definition's composed version between two revisions of the
      |model to tell a consumer that what they read has moved on.
    }
  }
  // ---- Stakeholder Personas & User Journeys ----
  include "epics/users.riddl"
  include "epics/dine-in-experience.riddl"
  include "epics/online-order-journey.riddl"
  include "epics/kitchen-workflow.riddl"
  include "epics/loyalty-enrollment.riddl"
  // ---- Subdomain Includes ----
  include "restaurant/domain.riddl"
  include "backoffice/domain.riddl"
  include "corporate/domain.riddl"
  // The umbrella domain owns no application of its own -- the three
  // subdomains do -- so its error sink needs a host. Chain-wide errors are
  // deliberately kept separate from any one restaurant's.
  context ChainOperations as sink is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised at the chain level are delivered, as
        |distinct from those raised inside a single subdomain.
      }
    }
  } with {
    briefly "Chain-wide operational concerns"
    described as {
      |The chain as a whole, above any one restaurant, back office or
      |corporate function.
    }
  }
  persistent connector 'CreateOrder Distribution' is from outlet Corporate.MenuManagement.CreateOrderToFOH to inlet Restaurant.FrontOfHouse.CreateOrderFromCorporate with {
    briefly "Menu-driven order creation, Corporate to the restaurants"
    described as {
      |Declared here, at the domain both ends descend from, because that is
      |the only scope that can see both. Legal since riddl b57376fa3: a
      |connector may cross a domain boundary when the two domains share an
      |ancestor. `persistent` because it still crosses a context boundary.
    }
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ChainOperations.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term Party is "A group of guests seated together at one table."
  term TicketItem is "An individual item on a kitchen ticket, marked ready when completed."
  briefly "Reactive BBQ restaurant chain"
  described as {
    | A 500+ location BBQ restaurant chain modeled with
    | reactive, event-driven bounded contexts. Addresses
    | peak-hour performance, cascading failure isolation,
    | independent deployability, and unblocks strategic
    | initiatives: loyalty program, electronic menus, and
    | kitchen display screens.
  }
}
