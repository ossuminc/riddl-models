// Host user is only used in this epic
user Host is "Restaurant host managing reservations and seating" with {
  briefly "Host"
  described as {
    |Manages walk-ins and reservations. Uses paper backup when systems slow.
  }
}
epic DineInExperience is {
  user Host wants to "to seat guests quickly" so that "tables turn over efficiently during peak hours"
  case ReservationFlow is {
    user Host wants to "to manage a reservation through seating" so that "reserved guests are seated promptly on arrival"
    sequence {
      step focus user Host on group Restaurant.RestaurantApp.RestaurantScreen
      step take input Restaurant.RestaurantApp.RestaurantScreen.MakeReservationInput from user Host
      step for context Restaurant.FrontOfHouse is "checks the book for a table of that size at that time"
      step show output Restaurant.RestaurantApp.RestaurantScreen.ReservationCreatedView to user Host
      step user Host selects input Restaurant.RestaurantApp.RestaurantScreen.ConfirmReservationInput
      step take input Restaurant.RestaurantApp.RestaurantScreen.SeatPartyInput from user Host
    }
  } with {
    briefly "Reservation flow"
    described as {
      |Full reservation lifecycle from request through
      |confirmation and seating.
    }
  }
  case WalkInSeating is {
    user Host wants to "to seat a walk-in party" so that "the table is occupied and orders can begin"
    step focus user Host on group Restaurant.RestaurantApp.RestaurantScreen
    step from user Host "checks table availability on reservation board" to output Restaurant.RestaurantApp.RestaurantScreen.ReservationBoardDisplay
    optional {
      step context Restaurant.FrontOfHouse refuses user Host "every table of that size is seated, so the party waits"
      step is "somehow" "the host reconciles the paper waitlist with the board" "when the floor is busier than the system knows"
    }
    step take input Restaurant.RestaurantApp.RestaurantScreen.SeatPartyInput from user Host
  } with {
    briefly "Walk-in seating"
    described as {
      |Host seats a walk-in party at an available table.
    }
  }
  case OrderingFlow is {
    user Server wants to "to take and submit a table order" so that "the kitchen and bar begin preparation"
    step from user Server "creates order for the table and adds menu items" to input Restaurant.RestaurantApp.RestaurantScreen.CreateOrderInput
    step from user Server "submits the order" to input Restaurant.RestaurantApp.RestaurantScreen.SubmitOrderInput
    parallel {
      step from context Restaurant.FrontOfHouse "splits order into food items for kitchen and drink
        items for bar" to context Restaurant.Kitchen
      step from context Restaurant.FrontOfHouse "routes drink items to bar" to context Restaurant.Bar
    }
  } with {
    briefly "Order submission flow"
    described as {
      |Server takes order, submits it, and it is split
      |and routed to kitchen and bar contexts.
    }
  }
  case PaymentFlow is {
    user Server wants to "to close out a table" so that "the table is freed for the next party"
    step from user Server "requests bill presentation with calculated total" to input Restaurant.RestaurantApp.RestaurantScreen.PresentBillInput
    step from user Server "processes payment through the payment gateway" to input Restaurant.RestaurantApp.RestaurantScreen.ProcessPaymentInput
    optional {
      step from context Restaurant.FrontOfHouse "sends payment event to loyalty context for point
        accrual" to context Restaurant.Loyalty
    }
    step from user Server "closes the order" to input Restaurant.RestaurantApp.RestaurantScreen.CloseOrderInput
  } with {
    briefly "Payment flow"
    described as {
      |Bill presentation, payment processing through the
      |gateway, loyalty point accrual, and order closing.
    }
  }
} with {
  briefly "Dine-in guest experience"
  described as {
    | Covers the full dine-in journey from reservation
    | or walk-in through seating, ordering, payment, and
    | loyalty point accrual.
  }
}
