// External systems used by the BackOffice domain
external context HRSystem as flow is {
  outlet HRToSchedulingOut is type HREvent
  inlet HRToSchedulingSrc is type HREvent  connector 'HRToScheduling Egress' is from outlet HRSystem.HREventSource.EmployeeUpdates to inlet HRSystem.HRToSchedulingSrc  command SyncEmployeeData yields event EmployeeDataSynced is {
    hrEmployeeId: String(1,50) with {
      briefly "Employee ID"
      described as {
        |HR system employee identifier.
      }
    }
    hrEmployeeName: String(1,100) with {
      briefly "Name"
      described as {
        |The employee's name as HR holds it, which is a legal name and may
        |differ from what the rota calls them.
      }
    }
    hrEmployeeRole: String(1,50) with {
      briefly "Role"
      described as {
        |The role HR has them on. The restaurant's own shift roles are finer
        |grained, so this is the coarse job title, not a rota role.
      }
    }
  } with {
    briefly "Sync employee data"
    described as {
      |Sync employee data from the HR system.
    }
  }
  event EmployeeDataSynced is {
    hrEmployeeId: String(1,50) with {
      briefly "Employee ID"
      described as {
        |HR system employee identifier.
      }
    }
    syncedAt: TimeStamp with {
      briefly "Synced at"
      described as {
        |When the sync occurred.
      }
    }
  } with {
    briefly "Employee data synced"
    described as {
      |Emitted when employee data is synced.
    }
  }
  handler HRHandler is {
    on other is {
      do "the remaining members of this inlet's type - rejections and events this context does not act on - change nothing here"
    }
    on syncEmployeeData: command SyncEmployeeData is {
      yield event EmployeeDataSynced(hrEmployeeId = syncEmployeeData.hrEmployeeId, syncedAt = system.now)
      do "synchronize employee record from HR system"
    }
  } with {
    briefly "HR handler"
    described as {
      |Processes employee data synchronization requests
      |through the external HR system.
    }
  }
  type HREvent is HRSystem.EmployeeDataSynced with {
    briefly "HR event alternation"
    described as {
      |Union of HR system events for streaming.
    }
  }
  streamlet HREventSource as source is {
    outlet EmployeeUpdates is type HREvent
    handler HREventEmitter is {
      on other is {
        error "Unexpected message for source HREventSource"
      }
      on employeeDataSynced: event EmployeeDataSynced is {
        send employeeDataSynced to outlet EmployeeUpdates
      }
    } with {
      briefly "HR event emitter"
      described as {
        |Emits employee data sync events into the
        |streaming topology.
      }
    }
  } with {
    briefly "HR event source"
    described as {
      |Emits employee data sync confirmations.
    }
  }
} with {
  briefly "External HR system"
  described as {
    |Human resources management system.
  }
}
external context AccountingSystem as flow is {
  outlet AccountingToReportingOut is type AccountingEvent
  inlet AccountingToReportingSrc is type AccountingEvent  connector 'AccountingToReporting Egress' is from outlet AccountingSystem.AccountingEventSource.PostingResults to inlet AccountingSystem.AccountingToReportingSrc  command PostTransaction yields event TransactionPosted is {
    accountingTransactionId: String(1,100) with {
      briefly "Transaction ID"
      described as {
        |The ledger's own handle for the posting. The restaurant's order and
        |shift ids mean nothing to accounting, so this is what a query back
        |must quote.
      }
    }
    accountCode: String(1,20) with {
      briefly "Account"
      described as {
        |General ledger account code.
      }
    }
    transactionAmount: Decimal(12,2) with {
      briefly "Amount"
      described as {
        |What was posted to the ledger. Reconciled against the day's takings
        |and the figure that has to agree at close.
      }
    }
    transactionDescription: String(1,500) with {
      briefly "Description"
      described as {
        |The narrative on the ledger line, which is all a bookkeeper sees
        |when the posting is read months later.
      }
    }
  } with {
    briefly "Post transaction"
    described as {
      |Post a transaction to the accounting system.
    }
  }
  event TransactionPosted is {
    accountingTransactionId: String(1,100) with {
      briefly "Transaction ID"
      described as {
        |The ledger's handle for the posting, echoed back so a request can be
        |matched to its confirmation.
      }
    }
    postedAt: TimeStamp with {
      briefly "Posted at"
      described as {
        |When the ledger accepted it. May fall in a later accounting period
        |than the trading day it describes, which is why both are kept.
      }
    }
  } with {
    briefly "Transaction posted"
    described as {
      |Emitted when a transaction is posted.
    }
  }
  handler AccountingHandler is {
    on other is {
      do "the remaining members of this inlet's type - rejections and events this context does not act on - change nothing here"
    }
    on postTransaction: command PostTransaction is {
      yield event TransactionPosted(accountingTransactionId = postTransaction.accountingTransactionId, postedAt = system.now)
      do "post transaction to general ledger"
    }
  } with {
    briefly "Accounting handler"
    described as {
      |Processes transaction posting requests through
      |the external accounting system.
    }
  }
  type AccountingEvent is AccountingSystem.TransactionPosted with {
    briefly "Accounting event alternation"
    described as {
      |Union of accounting system events for streaming.
    }
  }
  streamlet AccountingEventSource as source is {
    outlet PostingResults is type AccountingEvent
    handler AccountingEventEmitter is {
      on other is {
        error "Unexpected message for source AccountingEventSource"
      }
      on transactionPosted: event TransactionPosted is {
        send transactionPosted to outlet PostingResults
      }
    } with {
      briefly "Accounting event emitter"
      described as {
        |Emits transaction posting confirmations into the
        |streaming topology.
      }
    }
  } with {
    briefly "Accounting event source"
    described as {
      |Emits transaction posting confirmations.
    }
  }
} with {
  briefly "External accounting system"
  described as {
    |General ledger and accounting system.
  }
}
external context SupplierSystem as flow is {
  outlet SupplierToInventoryOut is type SupplierEvent
  inlet SupplierToInventorySrc is type SupplierEvent  connector 'SupplierToInventory Egress' is from outlet SupplierSystem.SupplierEventSource.StockDeliveries to inlet SupplierSystem.SupplierToInventorySrc  event ShipmentDelivered is {
    inventoryItemId: InventoryItemId with {
      briefly "Item"
      described as {
        |The inventory item delivered.
      }
    }
    deliveredQuantity: Decimal(10,2) with {
      briefly "Quantity"
      described as {
        |How much arrived.
      }
    }
    deliveredUnit: UnitOfMeasure with {
      briefly "Unit"
      described as {
        |The unit the quantity is counted in.
      }
    }
  } with {
    briefly "A supplier delivered stock"
    described as {
      |Records that a supplier delivered goods against an order.
    }
  }
  type SupplierEvent is SupplierSystem.ShipmentDelivered with {
    briefly "Supplier event alternation"
    described as {
      |Union of supplier system events for streaming.
    }
  }
  streamlet SupplierEventSource as source is {
    outlet StockDeliveries is type SupplierEvent
    handler SupplierEventEmitter is {
      on other is {
        error "Unexpected message for source SupplierEventSource"
      }
      on shipmentDelivered: event ShipmentDelivered is {
        send shipmentDelivered to outlet StockDeliveries
      }
    } with {
      briefly "Supplier event emitter"
      described as {
        |Emits supplier delivery confirmations into the streaming
        |topology.
      }
    }
  } with {
    briefly "Supplier event source"
    described as {
      |Emits confirmations that a supplier delivered stock.
    }
  }
} with {
  briefly "External supplier system"
  described as {
    |Supplier and vendor system through which stock is ordered and
    |delivered.
  }
}
