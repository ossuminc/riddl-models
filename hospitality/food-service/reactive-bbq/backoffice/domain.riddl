domain BackOffice is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  user Manager is "Restaurant manager overseeing daily operations" with {
    briefly "Manager"
    described as {
      |Manages scheduling, inventory, and reporting.
    }
  }
  user InventoryClerk is "Staff member managing stock" with {
    briefly "Inventory Clerk"
    described as {
      |Receives shipments, tracks stock levels, and reorders.
    }
  }
  include "SchedulingContext.riddl"
  include "InventoryContext.riddl"
  include "ReportingContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  persistent connector ShiftToReporting is from outlet Scheduling.ShiftToReportingOut to inlet Reporting.ShiftToReportingIn with {
    briefly "Shift to reporting connector"
    described as {
      |Wires shift events to the reporting context for
      |labor reports.
    }
  }
  persistent connector SupplierToInventory is from outlet SupplierSystem.SupplierToInventoryOut to inlet Inventory.SupplierToInventoryIn with {
    briefly "Supplier to inventory connector"
    described as {
      |Carries supplier delivery confirmations to inventory so stock on
      |hand reflects what actually arrived.
    }
  }
  persistent connector HRToScheduling is from outlet HRSystem.HRToSchedulingOut to inlet Scheduling.HRToSchedulingIn with {
    briefly "HR to scheduling connector"
    described as {
      |Wires HR employee updates to the scheduling context.
    }
  }
  persistent connector InventoryToReporting is from outlet Inventory.InventoryToReportingOut to inlet Reporting.InventoryToReportingIn with {
    briefly "Inventory to reporting connector"
    described as {
      |Wires inventory item events to the reporting context
      |for inventory reports.
    }
  }
  persistent connector AccountingToReporting is from outlet AccountingSystem.AccountingToReportingOut to inlet Reporting.AccountingToReportingIn with {
    briefly "Accounting to reporting connector"
    described as {
      |Wires accounting posting confirmations to reporting.
    }
  }
  application context BackOfficeApp as router is {
    outlet AppInventoryItemCommands is type Inventory.InventoryItem.InventoryItemCommand
    outlet AppShiftCommands is type Scheduling.Shift.ShiftCommand
    inlet AppInventoryItemRepositoryResponses is type Inventory.InventoryItem.InventoryItemResult    inlet AppShiftRepositoryResponses is type Scheduling.Shift.ShiftResult    command ShowStockOnHand is  {
      stockFilter: String(,100) with {
        briefly "Filter"
        described as {
          |What the manager typed to narrow the stock list — a name fragment
          |or a category. Empty means show everything.
        }
      }
    } with {
      briefly "Refresh the stock room screen"
      described as {
        |Redraw the stock list from what the screen currently holds. Carries
        |no domain meaning: nothing in the back office changes because
        |someone looked at a screen.
      }
    }
    command ShowRota is  {
      rotaWeek: String(1,10) with {
        briefly "Week"
        described as {
          |Which week the manager is looking at, as the rota labels it.
        }
      }
    } with {
      briefly "Refresh the rota screen"
      described as {
        |Redraw the shift rota for the selected week.
      }
    }
    group StockRoomScreen is {
      form StockFilterEntry acquires command BackOfficeApp.ShowStockOnHand with {
        briefly "Stock filter"
        described as {
          |Where a manager narrows the stock list before reading it.
        }
      }
      form ReceiveStockEntry acquires command Inventory.InventoryItem.ReceiveStock with {
        briefly "Receive stock control"
        described as {
          |Where a manager books a supplier delivery onto a stock line.
        }
      }
      form AdjustStockEntry acquires command Inventory.InventoryItem.AdjustStock with {
        briefly "Adjust stock control"
        described as {
          |Where a manager corrects a count after a stocktake, and says why.
        }
      }
      form SetReorderThresholdEntry acquires command Inventory.InventoryItem.SetReorderThreshold with {
        briefly "Reorder threshold control"
        described as {
          |Where a manager moves the par an item is reordered at.
        }
      }
      table StockOnHandTable displays result Inventory.InventoryItem.InventoryItemResult with {
        briefly "Stock on hand"
        described as {
          |What is on the shelves, a row per stock line. A table rather than
          |a document because a manager scans it for the two lines that are
          |short, not for prose.
        }
      }
      document StockFilterSummary presents command BackOfficeApp.ShowStockOnHand with {
        briefly "Filter in force"
        described as {
          |The filter the table is currently drawn under, shown above it.
          |Without this a manager reads a short list and cannot tell whether
          |stock is missing or merely hidden.
        }
      }
    } with {
      briefly "Stock room screen"
      described as {
        |The screen a manager works the stock room from: what is on hand,
        |and the four things they can do about it.
      }
    }
    group RotaScreen is {
      form RotaWeekEntry acquires command BackOfficeApp.ShowRota with {
        briefly "Week selector"
        described as {
          |Where a manager picks the week the rota shows.
        }
      }
      form CreateShiftEntry acquires command Scheduling.Shift.CreateShift with {
        briefly "Create shift control"
        described as {
          |Where a manager opens a shift for a role and a service period.
        }
      }
      form AssignEmployeeEntry acquires command Scheduling.Shift.AssignEmployee with {
        briefly "Assign employee control"
        described as {
          |Where a manager puts a name against an open shift, which is what
          |turns a schedule into coverage.
        }
      }
      table RotaTable displays result Scheduling.Shift.ShiftResult with {
        briefly "Shift rota"
        described as {
          |The week's shifts, a row per shift. Unfilled rows are the whole
          |point of the screen.
        }
      }
      document RotaWeekSummary presents command BackOfficeApp.ShowRota with {
        briefly "Week in view"
        described as {
          |Which week the rota below is showing. A rota read for the wrong
          |week is worse than no rota.
        }
      }
    } with {
      briefly "Rota screen"
      described as {
        |The screen a manager builds and reads the staffing week from.
      }
    }
    handler BackOfficeAppHandler is {
      on command ShowStockOnHand is {
        put get from input StockFilterEntry to output StockFilterSummary
      }
      on command ShowRota is {
        put get from input RotaWeekEntry to output RotaWeekSummary
      }
      on other is {
        error "Unexpected message for application context BackOfficeApp"
      }
    } with {
      briefly "BackOfficeApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "BackOfficeApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'InventoryItemCommand Stream' is from outlet BackOfficeApp.AppInventoryItemCommands to inlet Inventory.InventoryItemCommandStreamIn with {
    briefly "InventoryItem commands from the application"
    described as {
      |Carries what leaves AppInventoryItemCommands to InventoryItemCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'ShiftCommand Stream' is from outlet BackOfficeApp.AppShiftCommands to inlet Scheduling.ShiftCommandStreamIn with {
    briefly "Shift commands from the application"
    described as {
      |Carries what leaves AppShiftCommands to ShiftCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'InventoryItemResult Stream' is from outlet Inventory.InventoryItemResultStreamOut to inlet BackOfficeApp.AppInventoryItemRepositoryResponses with {
    briefly "InventoryItem query results returned to the application"
    described as {
      |Carries what leaves InventoryItemResultStreamOut to AppInventoryItemRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'ShiftResult Stream' is from outlet Scheduling.ShiftResultStreamOut to inlet BackOfficeApp.AppShiftRepositoryResponses with {
    briefly "Shift query results returned to the application"
    described as {
      |Carries what leaves ShiftResultStreamOut to AppShiftRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  briefly "Back office operations domain"
  described as {
    | Covers staff scheduling, inventory management, and
    | operational reporting. Reporting is isolated in its
    | own context with CQRS projectors so that report
    | generation never degrades peak-hour performance.
  }
}
