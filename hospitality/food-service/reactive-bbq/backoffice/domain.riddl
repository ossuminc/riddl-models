domain BackOffice is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  user Manager is "Restaurant manager overseeing daily operations" with {
    briefly "Manager"
    described as {
      |Manages scheduling, inventory, and reporting.
    }
  }
  user InventoryClerk is "Staff member managing stock" with {
    briefly "Inventory Clerk"
    described as {
      |Receives shipments, tracks stock levels, and reorders.
    }
  }
  include "SchedulingContext.riddl"
  include "InventoryContext.riddl"
  include "ReportingContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  connector ShiftToReporting is from outlet Scheduling.ShiftEventSource.ShiftEvents to inlet Reporting.ShiftEventSink.IncomingShiftEvents with {
    option persistent()
    briefly "Shift to reporting connector"
    described as {
      |Wires shift events to the reporting context for
      |labor reports.
    }
  }
  connector SupplierToInventory is from outlet SupplierSystem.SupplierEventSource.StockDeliveries to inlet Inventory.StockReceiptSink.IncomingStockDeliveries with {
    option persistent()
    briefly "Supplier to inventory connector"
    described as {
      |Carries supplier delivery confirmations to inventory so stock on
      |hand reflects what actually arrived.
    }
  }
  connector HRToScheduling is from outlet HRSystem.HREventSource.EmployeeUpdates to inlet Scheduling.EmployeeUpdateSink.IncomingEmployeeUpdates with {
    option persistent()
    briefly "HR to scheduling connector"
    described as {
      |Wires HR employee updates to the scheduling context.
    }
  }
  connector InventoryToReporting is from outlet Inventory.InventoryItemEventSource.InventoryItemEvents to inlet Reporting.InventoryEventSink.IncomingInventoryEvents with {
    option persistent()
    briefly "Inventory to reporting connector"
    described as {
      |Wires inventory item events to the reporting context
      |for inventory reports.
    }
  }
  connector AccountingToReporting is from outlet AccountingSystem.AccountingEventSource.PostingResults to inlet Reporting.AccountingConfirmSink.IncomingPostingResults with {
    option persistent()
    briefly "Accounting to reporting connector"
    described as {
      |Wires accounting posting confirmations to reporting.
    }
  }
  application context BackOfficeApp as router is {
    outlet AppInventoryItemCommands is type Inventory.InventoryItem.InventoryItemCommand
    outlet AppShiftCommands is type Scheduling.Shift.ShiftCommand
    inlet AppInventoryItemRepositoryResponses is type Inventory.InventoryItem.InventoryItemResult    inlet AppShiftRepositoryResponses is type Scheduling.Shift.ShiftResult    handler BackOfficeAppHandler is {
      on other is {
        error "Unexpected message for application context BackOfficeApp"
      }
    } with {
      briefly "BackOfficeApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "BackOfficeApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'InventoryItemCommand Stream' is from outlet BackOfficeApp.AppInventoryItemCommands to inlet Inventory.InventoryItem.InventoryItemCommands with {
    option persistent()
    briefly "InventoryItem commands from the application"
  }
  connector 'ShiftCommand Stream' is from outlet BackOfficeApp.AppShiftCommands to inlet Scheduling.Shift.ShiftCommands with {
    option persistent()
    briefly "Shift commands from the application"
  }
  connector 'InventoryItemResult Stream' is from outlet Inventory.InventoryItemRepository.InventoryItemRepositoryResponses to inlet BackOfficeApp.AppInventoryItemRepositoryResponses with {
    option persistent()
    briefly "InventoryItem query results returned to the application"
  }
  connector 'ShiftResult Stream' is from outlet Scheduling.ShiftRepository.ShiftRepositoryResponses to inlet BackOfficeApp.AppShiftRepositoryResponses with {
    option persistent()
    briefly "Shift query results returned to the application"
  }
} with {
  briefly "Back office operations domain"
  described as {
    | Covers staff scheduling, inventory management, and
    | operational reporting. Reporting is isolated in its
    | own context with CQRS projectors so that report
    | generation never degrades peak-hour performance.
  }
}
