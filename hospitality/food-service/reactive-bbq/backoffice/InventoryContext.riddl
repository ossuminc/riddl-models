// Inventory bounded context
context Inventory is {
  include "inventory-types.riddl"
  include "InventoryItem.riddl"
  processor StockReceiptSink as sink is {
    inlet IncomingStockDeliveries is type SupplierEvent    handler StockReceiptHandler is {
      on event SupplierSystem.ShipmentDelivered is {
        do "match the delivered quantity to the inventory item it
          replenishes"
        tell command InventoryItem.ReceiveStock to entity Inventory.InventoryItem
      }
      on other is {
        error "Unexpected message for sink StockReceiptSink"
      }
    } with {
      briefly "Stock receipt handler"
      described as {
        |Turns a supplier delivery into a stock receipt against the
        |inventory item it replenishes.
      }
    }
  } with {
    briefly "Stock receipt sink"
    described as {
      |The context boundary for stock arriving from suppliers. Until this
      |existed the only thing driving inventory was an application
      |connector wired straight into the entity, which is an inbound
      |stream that had not been modelled.
    }
  }
  repository InventoryItemRepository is {
    inlet InventoryItemRepositoryFromInventoryItem is type InventoryItemEvent    outlet InventoryItemRepositoryResponses is type InventoryItem.InventoryItemResult
    record StoredInventoryItem is  {
      inventoryItemId: InventoryItemId with {
        briefly "inventoryItemId"
        described as {
          |The inventoryItemId column of the stored inventoryItem row.
        }
      }
      inventoryItemStatus: InventoryItemStatus with {
        briefly "inventoryItemStatus"
        described as {
          |The inventoryItemStatus column of the stored inventoryItem row.
        }
      }
    } with {
      briefly "Stored inventoryItem row"
      described as {
        |The persistence shape of inventoryItem data as this repository stores it.
      }
    }
    schema InventoryItemData is relational
      of items as type StoredInventoryItem
        index on field StoredInventoryItem.inventoryItemId
        index on field StoredInventoryItem.inventoryItemStatus
 with {
      briefly "Inventory item data schema"
      described as {
        |Relational schema for persisting inventory item
        |state with indexes on item identifier and status.
      }
    }
    command PersistStockReceived is  {
      inventoryItemId: InventoryItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist StockReceived"
      described as {
        |Instructs this repository to apply StockReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockConsumed is  {
      inventoryItemId: InventoryItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist StockConsumed"
      described as {
        |Instructs this repository to apply StockConsumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStockAdjusted is  {
      inventoryItemId: InventoryItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist StockAdjusted"
      described as {
        |Instructs this repository to apply StockAdjusted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReorderThresholdSet is  {
      inventoryItemId: InventoryItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReorderThresholdSet"
      described as {
        |Instructs this repository to apply ReorderThresholdSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPurchaseOrderCreated is  {
      inventoryItemId: InventoryItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PurchaseOrderCreated"
      described as {
        |Instructs this repository to apply PurchaseOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler InventoryItemPersistence is {
      on command PersistStockReceived is {
        set field StoredInventoryItem.inventoryItemStatus to "as recorded by StockReceived"
        do "update InventoryItemData.items set currentStockLevel =
          currentStockLevel + receivedQuantity, lastReceivedAt =
          stockReceivedAt where inventoryItemId matches"
      }
      on command PersistStockConsumed is {
        set field StoredInventoryItem.inventoryItemStatus to "as recorded by StockConsumed"
        do "update InventoryItemData.items set currentStockLevel =
          currentStockLevel - consumedQuantity where
          inventoryItemId matches"
      }
      on command PersistStockAdjusted is {
        set field StoredInventoryItem.inventoryItemStatus to "as recorded by StockAdjusted"
        do "update InventoryItemData.items set currentStockLevel =
          currentStockLevel + adjustmentQuantity where
          inventoryItemId matches"
      }
      on command PersistReorderThresholdSet is {
        set field StoredInventoryItem.inventoryItemStatus to "as recorded by ReorderThresholdSet"
        do "update InventoryItemData.items set
          configuredReorderThreshold = reorderThreshold where
          inventoryItemId matches"
      }
      on command PersistPurchaseOrderCreated is {
        set field StoredInventoryItem.inventoryItemStatus to "as recorded by PurchaseOrderCreated"
        do "insert purchase order record with inventoryItemId,
          orderQuantity, orderUnit, preferredSupplier"
      }
    } with {
      briefly "Inventory item persistence"
      described as {
        |Persists inventory item commands.
      }
    }
  } with {
    briefly "Inventory item repository"
    described as {
      |Stores and retrieves inventory item data.
    }
  }
  processor InventoryItemEventSource as source is {
    outlet InventoryItemEvents is type InventoryEvent
    handler InventoryItemEventEmitter is {
      on init is {
        tell command InitializeInventoryItem to entity Inventory.InventoryItem
      }
      on other is {
        error "Unexpected message for source InventoryItemEventSource"
      }
      on event InventoryItem.StockReceived is {
        send event InventoryItem.StockReceived to outlet InventoryItemEvents
      }
      on event InventoryItem.StockConsumed is {
        send event InventoryItem.StockConsumed to outlet InventoryItemEvents
      }
      on event InventoryItem.StockAdjusted is {
        send event InventoryItem.StockAdjusted to outlet InventoryItemEvents
      }
      on event InventoryItem.ReorderThresholdSet is {
        send event InventoryItem.ReorderThresholdSet to outlet InventoryItemEvents
      }
      on event InventoryItem.PurchaseOrderCreated is {
        send event InventoryItem.PurchaseOrderCreated to outlet InventoryItemEvents
      }
    } with {
      briefly "Inventory item event emitter"
      described as {
        |Emits inventory item lifecycle events.
      }
    }
  } with {
    briefly "Inventory item event source"
    described as {
      |Publishes inventory item entity events.
    }
  }
  adaptor FromSupplyChain from context Corporate.SupplyChain is { 
    handler PurchaseOrderEventIntake is {
      on event Corporate.SupplyChain.PurchaseOrder.ShipmentReceived is {
        tell command InventoryItem.ReceiveStock to entity Inventory.InventoryItem
        do "receive stock from delivered purchase order shipment"
      }
      on event Corporate.SupplyChain.PurchaseOrder.OrderShipped is {
        tell command InventoryItem.ReceiveStock to entity Inventory.InventoryItem
        do "prepare for incoming stock from shipped order"
      }
      on other is {
        error "Unexpected message for adaptor FromSupplyChain"
      }
    } with {
      briefly "Purchase order event intake"
      described as {
        |Processes incoming purchase order events for stock
        |receipt notification.
      }
    }
  } with {
    briefly "Purchase order event sink"
    described as {
      |Receives purchase order events from the streaming
      |topology for stock receipt notification.
    }
  }
  adaptor FromKitchen from context Restaurant.Kitchen is { 
    handler KitchenConsumptionIntake is {
      on event Restaurant.Kitchen.KitchenTicket.PreparationStarted is {
        do "look up recipe ingredients for ticket items"
        tell command InventoryItem.ConsumeStock to entity Inventory.InventoryItem
      }
      on event Restaurant.Kitchen.KitchenTicket.TicketApproved is {
        tell command InventoryItem.ConsumeStock to entity Inventory.InventoryItem
        do "finalize stock consumption for approved ticket"
      }
      on other is {
        error "Unexpected message for adaptor FromKitchen"
      }
    } with {
      briefly "Kitchen consumption intake"
      described as {
        |Consumes stock as kitchen prepares items.
      }
    }
  } with {
    briefly "Kitchen adaptor"
    described as {
      | Receives preparation events from the kitchen to
      | automatically track stock consumption.
    }
  }
  connector LinkInventoryItemToInventoryItemRepository is from outlet Inventory.InventoryItem.InventoryItemEvents2 to inlet Inventory.InventoryItemRepository.InventoryItemRepositoryFromInventoryItem with {
    briefly "LinkInventoryItemToInventoryItemRepository"
  }
} with {
  briefly "Inventory context"
  described as {
    | Manages stock levels, receiving, consumption tracking,
    | manual adjustments, and reorder thresholds. Integrates
    | with kitchen context to automatically track consumption
    | as items are prepared.
  }
}
