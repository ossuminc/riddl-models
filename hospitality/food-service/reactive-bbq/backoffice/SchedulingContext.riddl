// Scheduling bounded context
context Scheduling as router is {
  inlet HRToSchedulingIn is type HREvent  outlet HRToSchedulingFwd is type HREvent
  connector 'HRToScheduling Intake' is from outlet Scheduling.HRToSchedulingFwd to inlet Scheduling.HRSystemAdapter.IncomingHRSystemEvents  inlet ShiftCommandStreamIn is type ShiftCommand  outlet ShiftCommandStreamOut is type ShiftCommand
  inlet ShiftToReportingIn is type ShiftEvent  outlet ShiftToReportingOut is type ShiftEvent
  inlet ShiftResultStreamIn is result Shift.ShiftResult  outlet ShiftResultStreamOut is result Shift.ShiftResult
  handler SchedulingBoundary is {
    on createShift: command Shift.CreateShift is {
      forward createShift to outlet Scheduling.ShiftCommandStreamOut
    }
    on assignEmployee: command Shift.AssignEmployee is {
      forward assignEmployee to outlet Scheduling.ShiftCommandStreamOut
    }
    on swapShift: command Shift.SwapShift is {
      forward swapShift to outlet Scheduling.ShiftCommandStreamOut
    }
    on clockIn: command Shift.ClockIn is {
      forward clockIn to outlet Scheduling.ShiftCommandStreamOut
    }
    on clockOut: command Shift.ClockOut is {
      forward clockOut to outlet Scheduling.ShiftCommandStreamOut
    }
    on cancelShift: command Shift.CancelShift is {
      forward cancelShift to outlet Scheduling.ShiftCommandStreamOut
    }
    on shiftCreated: event Shift.ShiftCreated is {
      send shiftCreated to outlet Scheduling.ShiftToReportingOut
    }
    on employeeAssigned: event Shift.EmployeeAssigned is {
      send employeeAssigned to outlet Scheduling.ShiftToReportingOut
    }
    on shiftSwapped: event Shift.ShiftSwapped is {
      send shiftSwapped to outlet Scheduling.ShiftToReportingOut
    }
    on clockedIn: event Shift.ClockedIn is {
      send clockedIn to outlet Scheduling.ShiftToReportingOut
    }
    on clockedOut: event Shift.ClockedOut is {
      send clockedOut to outlet Scheduling.ShiftToReportingOut
    }
    on shiftCancelled: event Shift.ShiftCancelled is {
      send shiftCancelled to outlet Scheduling.ShiftToReportingOut
    }
    on shiftResult: result Shift.ShiftResult is {
      send shiftResult to outlet Scheduling.ShiftResultStreamOut
    }
    on other is {
      error "Unexpected message at the Scheduling boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ShiftCommand Stream Intake' is from outlet Scheduling.ShiftCommandStreamOut to inlet Scheduling.Shift.ShiftCommands  connector 'ShiftToReporting Egress' is from outlet Scheduling.ShiftEventSource.ShiftEvents to inlet Scheduling.ShiftToReportingIn  connector 'ShiftResult Stream Egress' is from outlet Scheduling.ShiftRepository.ShiftRepositoryResponses to inlet Scheduling.ShiftResultStreamIn  include "scheduling-types.riddl"
  include "Shift.riddl"
  type ShiftRepositoryCommand is one of {
    Scheduling.ShiftRepository.PersistShiftCreated or Scheduling.ShiftRepository.PersistEmployeeAssigned or Scheduling.ShiftRepository.PersistShiftSwapped or Scheduling.ShiftRepository.PersistClockedIn or Scheduling.ShiftRepository.PersistClockedOut or Scheduling.ShiftRepository.PersistShiftCancelled
  } with {
    briefly "Anything that writes the ShiftRepository"
    described as {
      |The persistence commands ShiftRepository accepts. Shift events never
      |reach it directly; the projector turns each into one of these. A
      |repository takes commands and queries only.
    }
  }
  repository ShiftRepository as flow is {
    inlet ShiftRepositoryFromShiftProjection is type ShiftRepositoryCommand
    outlet ShiftRepositoryResponses is result Shift.ShiftResult
    record StoredShift is  {
      shiftId: ShiftId with {
        briefly "shiftId"
        described as {
          |The shiftId column of the stored shift row.
        }
      }
      employeeId: EmployeeId with {
        briefly "employeeId"
        described as {
          |The employeeId column of the stored shift row.
        }
      }
      shiftDate: Date with {
        briefly "shiftDate"
        described as {
          |The shiftDate column of the stored shift row.
        }
      }
    } with {
      briefly "Stored shift row"
      described as {
        |The persistence shape of shift data as this repository stores it.
      }
    }
    schema ShiftData is relational
      of shifts as record StoredShift
        index on field StoredShift.shiftId
        index on field StoredShift.shiftDate
        index on field StoredShift.employeeId
 with {
      briefly "Shift data schema"
      described as {
        |Relational schema for persisting shift state with
        |indexes on shift identifier, date, and employee.
      }
    }
    command PersistShiftCreated is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShiftCreated"
      described as {
        |Instructs this repository to apply ShiftCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEmployeeAssigned is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist EmployeeAssigned"
      described as {
        |Instructs this repository to apply EmployeeAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShiftSwapped is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShiftSwapped"
      described as {
        |Instructs this repository to apply ShiftSwapped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClockedIn is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClockedIn"
      described as {
        |Instructs this repository to apply ClockedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClockedOut is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClockedOut"
      described as {
        |Instructs this repository to apply ClockedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShiftCancelled is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShiftCancelled"
      described as {
        |Instructs this repository to apply ShiftCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler ShiftPersistence is {
      on command PersistShiftCreated is {
        do "insert row into ShiftData.shifts with shiftId,
          shiftDate, shiftStart, shiftEnd, shiftRole, and
          shiftStatus = Open"
      }
      on command PersistEmployeeAssigned is {
        do "update ShiftData.shifts set assignedEmployeeId =
          employeeId, assignedEmployeeName = employeeName where
          shiftId matches"
      }
      on command PersistShiftSwapped is {
        do "update ShiftData.shifts set assignedEmployeeId =
          replacementEmployeeId, assignedEmployeeName =
          replacementName where shiftId matches"
      }
      on command PersistClockedIn is {
        do "update ShiftData.shifts set actualClockedInAt =
          clockedInAt where shiftId matches"
      }
      on command PersistClockedOut is {
        do "update ShiftData.shifts set actualClockedOutAt =
          clockedOutAt where shiftId matches"
      }
      on command PersistShiftCancelled is {
        do "update ShiftData.shifts set shiftStatus = Cancelled
          where shiftId matches"
      }
    } with {
      briefly "Shift persistence"
      described as {
        |Persists shift commands.
      }
    }
  } with {
    briefly "Shift repository"
    described as {
      |Stores and retrieves shift data.
    }
  }
  projector ShiftProjection as flow is {
    updates repository Scheduling.ShiftRepository
    inlet ShiftProjectionFromShift is type ShiftEvent
    outlet ShiftProjectionToRepository is type ShiftRepositoryCommand
    handler ShiftProjectionHandler is {
      on shiftCreated: event Shift.ShiftCreated is {
        tell command Scheduling.ShiftRepository.PersistShiftCreated(shiftId = shiftCreated.shiftId) to repository Scheduling.ShiftRepository
      }
      on employeeAssigned: event Shift.EmployeeAssigned is {
        tell command Scheduling.ShiftRepository.PersistEmployeeAssigned(shiftId = employeeAssigned.shiftId) to repository Scheduling.ShiftRepository
      }
      on shiftSwapped: event Shift.ShiftSwapped is {
        tell command Scheduling.ShiftRepository.PersistShiftSwapped(shiftId = shiftSwapped.shiftId) to repository Scheduling.ShiftRepository
      }
      on clockedIn: event Shift.ClockedIn is {
        tell command Scheduling.ShiftRepository.PersistClockedIn(shiftId = clockedIn.shiftId) to repository Scheduling.ShiftRepository
      }
      on clockedOut: event Shift.ClockedOut is {
        tell command Scheduling.ShiftRepository.PersistClockedOut(shiftId = clockedOut.shiftId) to repository Scheduling.ShiftRepository
      }
      on shiftCancelled: event Shift.ShiftCancelled is {
        tell command Scheduling.ShiftRepository.PersistShiftCancelled(shiftId = shiftCancelled.shiftId) to repository Scheduling.ShiftRepository
      }
    } with {
      briefly "Shift projection handler"
      described as {
        |Turns each shift event into the repository command that writes it.
      }
    }
  } with {
    briefly "Shift projection"
    described as {
      |Builds the stored shift view from the entity's events.
    }
  }
  processor ShiftEventSource as source is {
    outlet ShiftEvents is type ShiftEvent
    handler ShiftEventEmitter is {
      on other is {
        error "Unexpected message for source ShiftEventSource"
      }
      on shiftCreated: event Shift.ShiftCreated is {
        send shiftCreated to outlet ShiftEvents
      }
      on employeeAssigned: event Shift.EmployeeAssigned is {
        send employeeAssigned to outlet ShiftEvents
      }
      on shiftSwapped: event Shift.ShiftSwapped is {
        send shiftSwapped to outlet ShiftEvents
      }
      on clockedIn: event Shift.ClockedIn is {
        send clockedIn to outlet ShiftEvents
      }
      on clockedOut: event Shift.ClockedOut is {
        send clockedOut to outlet ShiftEvents
      }
      on shiftCancelled: event Shift.ShiftCancelled is {
        send shiftCancelled to outlet ShiftEvents
      }
    } with {
      briefly "Shift event emitter"
      described as {
        |Emits shift lifecycle events.
      }
    }
  } with {
    briefly "Shift event source"
    described as {
      |Publishes shift entity events.
    }
  }
  adaptor HRSystemAdapter from context HRSystem as flow is { 
    inlet IncomingHRSystemEvents is type HREvent    outlet TranslatedHRSystemEvents is type HREvent
    handler InboundHRSystem is {
      on employeeDataSynced: event HRSystem.EmployeeDataSynced is {
        send employeeDataSynced to outlet TranslatedHRSystemEvents
      }
      on other is {
        error "Unexpected message for adaptor HRSystemAdapter"
      }
    } with {
      briefly "Inbound HRSystem translation"
      described as {
        |Receives HRSystem events and forwards them to Scheduling. This is the
        |seam that keeps the HR system plug-in replaceable: a different
        |provider is absorbed here rather than in EmployeeUpdateSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for HRSystem"
    described as {
      |Stands between the external HRSystem and EmployeeUpdateSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'HREvent Stream' is from outlet Scheduling.HRSystemAdapter.TranslatedHRSystemEvents to inlet Scheduling.EmployeeUpdateSink.IncomingEmployeeUpdates with {
    briefly "HRSystem events, translated, on their way to the sink"
    described as {
      |Carries employee record updates from the anti-corruption layer to the sink that
      |applies them inside Scheduling.
    }
  }
  processor EmployeeUpdateSink as sink is {
    inlet IncomingEmployeeUpdates is type HREvent    handler EmployeeUpdateHandler is {
      on event HRSystem.EmployeeDataSynced is {
        let assignEmployee: type Shift.AssignEmployee = prompt("the assign employee that results from employee data synced")
        tell assignEmployee to entity Scheduling.Shift
        do "update local employee roster with synced data
          from EmployeeDataSynced.hrEmployeeId for shift
          assignment validation"
      }
    } with {
      briefly "Employee update handler"
      described as {
        |Processes employee data sync events to keep the
        |scheduling roster current.
      }
    }
  } with {
    briefly "Employee update sink"
    described as {
      |Receives employee data updates from the external HR
      |system for shift assignment validation.
    }
  }
  connector 'ShiftEvent Feed' is from outlet Scheduling.Shift.ShiftEvents2 to inlet Scheduling.ShiftProjection.ShiftProjectionFromShift  connector 'ShiftProjection Storage' is from outlet Scheduling.ShiftProjection.ShiftProjectionToRepository to inlet Scheduling.ShiftRepository.ShiftRepositoryFromShiftProjection with {
    briefly "Shift events on their way to storage"
    described as {
      |Carries what leaves ShiftEvents2 to ShiftRepositoryFromShift, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  term Coverage is  "Having someone assigned to every role a service period needs. A schedule can be full and still uncovered if the roles are wrong — three servers and no cook is not coverage." 
  term Labor is  "The cost of staffing a service period, read against what that period took. It is the one large cost a restaurant can still change on the day." 
  briefly "Scheduling context"
  described as {
    | Manages staff shift planning, assignment, time
    | tracking, and coverage. Provides the foundation
    | for labor reporting in the Reporting context.
  }
}
