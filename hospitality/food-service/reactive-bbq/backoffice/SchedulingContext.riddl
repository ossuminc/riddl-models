// Scheduling bounded context
context Scheduling is {
  include "scheduling-types.riddl"
  include "Shift.riddl"
  repository ShiftRepository as flow is {
    inlet ShiftRepositoryFromShift is type ShiftEvent    outlet ShiftRepositoryResponses is type Shift.ShiftResult
    record StoredShift is  {
      shiftId: ShiftId with {
        briefly "shiftId"
        described as {
          |The shiftId column of the stored shift row.
        }
      }
      employeeId: EmployeeId with {
        briefly "employeeId"
        described as {
          |The employeeId column of the stored shift row.
        }
      }
      shiftDate: Date with {
        briefly "shiftDate"
        described as {
          |The shiftDate column of the stored shift row.
        }
      }
    } with {
      briefly "Stored shift row"
      described as {
        |The persistence shape of shift data as this repository stores it.
      }
    }
    schema ShiftData is relational
      of shifts as type StoredShift
        index on field StoredShift.shiftId
        index on field StoredShift.shiftDate
        index on field StoredShift.employeeId
 with {
      briefly "Shift data schema"
      described as {
        |Relational schema for persisting shift state with
        |indexes on shift identifier, date, and employee.
      }
    }
    command PersistShiftCreated is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShiftCreated"
      described as {
        |Instructs this repository to apply ShiftCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEmployeeAssigned is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist EmployeeAssigned"
      described as {
        |Instructs this repository to apply EmployeeAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShiftSwapped is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShiftSwapped"
      described as {
        |Instructs this repository to apply ShiftSwapped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClockedIn is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClockedIn"
      described as {
        |Instructs this repository to apply ClockedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistClockedOut is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ClockedOut"
      described as {
        |Instructs this repository to apply ClockedOut to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShiftCancelled is  {
      shiftId: ShiftId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShiftCancelled"
      described as {
        |Instructs this repository to apply ShiftCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler ShiftPersistence is {
      on command PersistShiftCreated is {
        do "insert row into ShiftData.shifts with shiftId,
          shiftDate, shiftStart, shiftEnd, shiftRole, and
          shiftStatus = Open"
      }
      on command PersistEmployeeAssigned is {
        do "update ShiftData.shifts set assignedEmployeeId =
          employeeId, assignedEmployeeName = employeeName where
          shiftId matches"
      }
      on command PersistShiftSwapped is {
        do "update ShiftData.shifts set assignedEmployeeId =
          replacementEmployeeId, assignedEmployeeName =
          replacementName where shiftId matches"
      }
      on command PersistClockedIn is {
        do "update ShiftData.shifts set actualClockedInAt =
          clockedInAt where shiftId matches"
      }
      on command PersistClockedOut is {
        do "update ShiftData.shifts set actualClockedOutAt =
          clockedOutAt where shiftId matches"
      }
      on command PersistShiftCancelled is {
        do "update ShiftData.shifts set shiftStatus = Cancelled
          where shiftId matches"
      }
    } with {
      briefly "Shift persistence"
      described as {
        |Persists shift commands.
      }
    }
  } with {
    briefly "Shift repository"
    described as {
      |Stores and retrieves shift data.
    }
  }
  processor ShiftEventSource as source is {
    outlet ShiftEvents is type ShiftEvent
    handler ShiftEventEmitter is {
      on other is {
        error "Unexpected message for source ShiftEventSource"
      }
      on event Shift.ShiftCreated is {
        send event Shift.ShiftCreated to outlet ShiftEvents
      }
      on event Shift.EmployeeAssigned is {
        send event Shift.EmployeeAssigned to outlet ShiftEvents
      }
      on event Shift.ShiftSwapped is {
        send event Shift.ShiftSwapped to outlet ShiftEvents
      }
      on event Shift.ClockedIn is {
        send event Shift.ClockedIn to outlet ShiftEvents
      }
      on event Shift.ClockedOut is {
        send event Shift.ClockedOut to outlet ShiftEvents
      }
      on event Shift.ShiftCancelled is {
        send event Shift.ShiftCancelled to outlet ShiftEvents
      }
    } with {
      briefly "Shift event emitter"
      described as {
        |Emits shift lifecycle events.
      }
    }
  } with {
    briefly "Shift event source"
    described as {
      |Publishes shift entity events.
    }
  }
  adaptor HRSystemAdapter from context HRSystem as flow is { 
    inlet IncomingHRSystemEvents is type HREvent    outlet TranslatedHRSystemEvents is type HREvent
    handler InboundHRSystem is {
      on event HRSystem.EmployeeDataSynced is {
        send event HRSystem.EmployeeDataSynced to outlet TranslatedHRSystemEvents
      }
      on other is {
        error "Unexpected message for adaptor HRSystemAdapter"
      }
    } with {
      briefly "Inbound HRSystem translation"
      described as {
        |Receives HRSystem events and forwards them to Scheduling. This is the
        |seam that keeps the HR system plug-in replaceable: a different
        |provider is absorbed here rather than in EmployeeUpdateSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for HRSystem"
    described as {
      |Stands between the external HRSystem and EmployeeUpdateSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'HREvent Stream' is from outlet Scheduling.HRSystemAdapter.TranslatedHRSystemEvents to inlet Scheduling.EmployeeUpdateSink.IncomingEmployeeUpdates with {
    briefly "HRSystem events, translated, on their way to the sink"
    described as {
      |Carries employee record updates from the anti-corruption layer to the sink that
      |applies them inside Scheduling.
    }
  }
  processor EmployeeUpdateSink as sink is {
    inlet IncomingEmployeeUpdates is type HREvent    handler EmployeeUpdateHandler is {
      on event HRSystem.EmployeeDataSynced is {
        tell command Shift.AssignEmployee to entity Scheduling.Shift
        do "update local employee roster with synced data
          from EmployeeDataSynced.hrEmployeeId for shift
          assignment validation"
      }
    } with {
      briefly "Employee update handler"
      described as {
        |Processes employee data sync events to keep the
        |scheduling roster current.
      }
    }
  } with {
    briefly "Employee update sink"
    described as {
      |Receives employee data updates from the external HR
      |system for shift assignment validation.
    }
  }
  connector 'ShiftEvent Storage' is from outlet Scheduling.Shift.ShiftEvents2 to inlet Scheduling.ShiftRepository.ShiftRepositoryFromShift with {
    briefly "Shift events on their way to storage"
  }
} with {
  briefly "Scheduling context"
  described as {
    | Manages staff shift planning, assignment, time
    | tracking, and coverage. Provides the foundation
    | for labor reporting in the Reporting context.
  }
}
