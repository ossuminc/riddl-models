// Shift entity for the Scheduling context
event-sourced entity Shift as flow is {
  type ShiftCommand is one of {
    Shift.CreateShift or Shift.AssignEmployee or Shift.SwapShift or Shift.ClockIn or Shift.ClockOut or Shift.CancelShift
  } with {
    briefly "Shift command alternation"
    described as {
      |Commands accepted by the Shift entity.
    }
  }
  inlet ShiftCommands is type ShiftCommand  outlet ShiftEvents2 is type ShiftEvent
  // ---- Commands ----
  command CreateShift yields event ShiftCreated is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |Identifier for the new shift.
      }
    }
    shiftDate: Date with {
      briefly "Date"
      described as {
        |The day being staffed. Held separately from clock times because a
        |late shift crosses midnight and still belongs to the day it started.
      }
    }
    shiftStart: TimeStamp with {
      briefly "Start"
      described as {
        |Shift start time.
      }
    }
    shiftEnd: TimeStamp with {
      briefly "End"
      described as {
        |Shift end time.
      }
    }
    shiftRole: ShiftRole with {
      briefly "Role"
      described as {
        |Role needed for this shift.
      }
    }
  } with {
    briefly "Create shift"
    described as {
      |Create a new shift in the schedule.
    }
  }
  command AssignEmployee yields event EmployeeAssigned is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |Shift to assign.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee ID"
      described as {
        |Employee to assign.
      }
    }
    employeeName: String(1,100) with {
      briefly "Employee name"
      described as {
        |Who is working it, captured on the shift so a printed rota does not
        |need to resolve employee records.
      }
    }
  } with {
    briefly "Assign employee"
    described as {
      |Assign an employee to the shift.
    }
  }
  command SwapShift yields event ShiftSwapped is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |Shift to swap.
      }
    }
    originalEmployeeId: EmployeeId with {
      briefly "Original employee"
      described as {
        |Employee leaving the shift.
      }
    }
    replacementEmployeeId: EmployeeId with {
      briefly "Replacement employee"
      described as {
        |Employee taking over the shift.
      }
    }
    replacementName: String(1,100) with {
      briefly "Replacement name"
      described as {
        |Name of the replacement employee.
      }
    }
  } with {
    briefly "Swap shift"
    described as {
      |Swap one employee for another on a shift.
    }
  }
  command ClockIn yields event ClockedIn is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |Shift to clock in for.
      }
    }
    clockedInAt: TimeStamp with {
      briefly "Clocked in at"
      described as {
        |Actual clock-in time.
      }
    }
  } with {
    briefly "Clock in"
    described as {
      |Record employee clock-in for the shift.
    }
  }
  command ClockOut yields event ClockedOut is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |Shift to clock out of.
      }
    }
    clockedOutAt: TimeStamp with {
      briefly "Clocked out at"
      described as {
        |Actual clock-out time.
      }
    }
  } with {
    briefly "Clock out"
    described as {
      |Record employee clock-out for the shift.
    }
  }
  command CancelShift yields event ShiftCancelled is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |Shift to cancel.
      }
    }
    shiftCancelReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason for cancellation.
      }
    }
  } with {
    briefly "Cancel shift"
    described as {
      |Cancel a scheduled shift.
    }
  }
  // ---- Events ----
  event ShiftCreated is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |The shift just created. Every later event carries the same value, so
        |a shift's whole history can be assembled from the event log.
      }
    }
    shiftDate: Date with {
      briefly "Date"
      described as {
        |The day this shift staffs, which is the day it begins even when it
        |runs past midnight.
      }
    }
    shiftStart: TimeStamp with {
      briefly "Start"
      described as {
        |Start time.
      }
    }
    shiftEnd: TimeStamp with {
      briefly "End"
      described as {
        |End time.
      }
    }
    shiftRole: ShiftRole with {
      briefly "Role"
      described as {
        |What the shift is for — server, line cook, bartender, host. Roles
        |are not interchangeable, so a swap between two of them is refused.
      }
    }
    shiftCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the shift was put on the rota. Notice period runs from here,
        |which is what makes a late-published schedule visible.
      }
    }
  } with {
    briefly "Shift created"
    described as {
      |Emitted when a new shift is created.
    }
  }
  event EmployeeAssigned is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |The shift now staffed. Assignment is what turns an open slot on the
        |rota into somebody's obligation.
      }
    }
    employeeId: EmployeeId with {
      briefly "Employee ID"
      described as {
        |Assigned employee.
      }
    }
    employeeName: String(1,100) with {
      briefly "Employee name"
      described as {
        |Who took the shift, recorded on the event so the rota reads without
        |a lookup.
      }
    }
    employeeAssignedAt: TimeStamp with {
      briefly "Assigned at"
      described as {
        |When the shift was filled. The gap from creation is how long a slot
        |sat open, which is what scheduling pressure looks like.
      }
    }
  } with {
    briefly "Employee assigned"
    described as {
      |Emitted when an employee is assigned to a shift.
    }
  }
  event ShiftSwapped is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |The shift that changed hands. A swap is deliberately one event and
        |not a cancel-plus-assign, so the rota keeps its continuity.
      }
    }
    originalEmployeeId: EmployeeId with {
      briefly "Original employee"
      described as {
        |Employee who left.
      }
    }
    replacementEmployeeId: EmployeeId with {
      briefly "Replacement employee"
      described as {
        |Employee who took over.
      }
    }
    swappedAt: TimeStamp with {
      briefly "Swapped at"
      described as {
        |When the handover was agreed. Close to the shift itself, this is the
        |swap that most often goes uncovered.
      }
    }
  } with {
    briefly "Shift swapped"
    described as {
      |Emitted when a shift swap occurs.
    }
  }
  event ClockedIn is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |The shift being clocked into. Clock-in is against a shift rather
        |than a bare timestamp, which is what makes lateness measurable.
      }
    }
    clockedInAt: TimeStamp with {
      briefly "Clocked in at"
      described as {
        |Clock-in time.
      }
    }
  } with {
    briefly "Clocked in"
    described as {
      |Emitted when an employee clocks in.
    }
  }
  event ClockedOut is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |The shift being clocked out of. Paired with clock-in, this is the
        |hours labour cost is actually computed from.
      }
    }
    clockedOutAt: TimeStamp with {
      briefly "Clocked out at"
      described as {
        |Clock-out time.
      }
    }
  } with {
    briefly "Clocked out"
    described as {
      |Emitted when an employee clocks out.
    }
  }
  event ShiftCancelled is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |The shift that was dropped. Cancellation leaves the slot unstaffed,
        |unlike a swap, so it is what a manager has to react to.
      }
    }
    shiftCancelReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    shiftCancelledAt: TimeStamp with {
      briefly "Cancelled at"
      described as {
        |When the shift was dropped. How close this falls to the shift itself
        |is the difference between an inconvenience and a short-staffed
        |service.
      }
    }
  } with {
    briefly "Shift cancelled"
    described as {
      |Emitted when a shift is cancelled.
    }
  }
  // ---- Queries ----
  query GetShift replies result ShiftResult is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |Shift to retrieve.
      }
    }
  } with {
    briefly "Get shift"
    described as {
      |Query a shift by its identifier.
    }
  }
  result ShiftResult is  {
    shiftId: ShiftId with {
      briefly "Shift addressed"
      described as {
        |Which shift this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    shift: ShiftStateData with {
      briefly "Shift"
      described as {
        |The requested shift data.
      }
    }
  } with {
    briefly "Shift result"
    described as {
      |Result containing the requested shift data.
    }
  }
  // ---- State ----
  record ShiftStateData is  {
    shiftId: ShiftId with {
      briefly "ID"
      described as {
        |The shift this state belongs to. Carried through every state so the
        |record can be rebuilt by replaying the event log.
      }
    }
    shiftDate: Date with {
      briefly "Date"
      described as {
        |The day staffed, held in state so a rota for a date can be read
        |directly.
      }
    }
    shiftStart: TimeStamp with {
      briefly "Start"
      described as {
        |Start time.
      }
    }
    shiftEnd: TimeStamp with {
      briefly "End"
      described as {
        |End time.
      }
    }
    shiftRole: ShiftRole with {
      briefly "Role"
      described as {
        |The role being covered, held in state because cover has to be found
        |within the same role.
      }
    }
    shiftStatus: ShiftStatus with {
      briefly "Status"
      described as {
        |Current shift status.
      }
    }
    assignedEmployeeId: EmployeeId? with {
      briefly "Employee ID"
      described as {
        |Who currently holds the shift. Absent while the slot is still open,
        |which is exactly what an unstaffed rota looks like.
      }
    }
    assignedEmployeeName: String(1,100)? with {
      briefly "Employee name"
      described as {
        |The name to print on the rota, kept beside the id to save a lookup.
      }
    }
    actualClockedInAt: TimeStamp? with {
      briefly "Clocked in at"
      described as {
        |Clock-in time.
      }
    }
    actualClockedOutAt: TimeStamp? with {
      briefly "Clocked out at"
      described as {
        |Clock-out time.
      }
    }
    shiftCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the shift was published, held in state so notice period can be
        |read without replaying the log.
      }
    }
  } with {
    briefly "Shift state data"
    described as {
      |Full state of a shift.
    }
  }
  initial state ActiveShift of record Shift.ShiftStateData is {
    initial handler ActiveShiftInitHandler is {
      on init is {
        let shiftCreated: type ShiftCreated = prompt("the shift created that brings this shift into existence")
        yield shiftCreated
      }
    } with {
      briefly "Active shift init handler"
      described as {
        |Initializes the active shift state with default values.
      }
    }
  } with {
    briefly "Active shift state"
    described as {
      |The primary state of a staff shift from creation
      |through assignment, clock-in/out, swaps, and
      |cancellation.
    }
  }
  initial handler ShiftHandler is {
    on createShift: command CreateShift is {
      yield event ShiftCreated(shiftId = createShift.shiftId, shiftDate = createShift.shiftDate, shiftStart = createShift.shiftStart, shiftEnd = createShift.shiftEnd, shiftRole = createShift.shiftRole, shiftCreatedAt = prompt("current timestamp"))
      send event ShiftCreated(shiftId = createShift.shiftId, shiftDate = createShift.shiftDate, shiftStart = createShift.shiftStart, shiftEnd = createShift.shiftEnd, shiftRole = createShift.shiftRole, shiftCreatedAt = prompt("current timestamp")) to outlet Scheduling.ShiftEventSource.ShiftEvents
      do "ShiftCreated event triggers employee data sync
        via HRSystem streaming topology"
    }
    on assignEmployee: command AssignEmployee is {
      yield event EmployeeAssigned(shiftId = assignEmployee.shiftId, employeeId = assignEmployee.employeeId, employeeName = assignEmployee.employeeName, employeeAssignedAt = prompt("the employee assigned at of this employee assigned"))
      send event EmployeeAssigned(shiftId = assignEmployee.shiftId, employeeId = assignEmployee.employeeId, employeeName = assignEmployee.employeeName, employeeAssignedAt = prompt("the employee assigned at of this employee assigned")) to outlet Scheduling.ShiftEventSource.ShiftEvents
    }
    on swapShift: command SwapShift is {
      yield event ShiftSwapped(shiftId = swapShift.shiftId, originalEmployeeId = swapShift.originalEmployeeId, replacementEmployeeId = swapShift.replacementEmployeeId, swappedAt = prompt("the swapped at of this shift swapped"))
      send event ShiftSwapped(shiftId = swapShift.shiftId, originalEmployeeId = swapShift.originalEmployeeId, replacementEmployeeId = swapShift.replacementEmployeeId, swappedAt = prompt("the swapped at of this shift swapped")) to outlet Scheduling.ShiftEventSource.ShiftEvents
    }
    on clockIn: command ClockIn is {
      yield event ClockedIn(shiftId = clockIn.shiftId, clockedInAt = clockIn.clockedInAt)
      send event ClockedIn(shiftId = clockIn.shiftId, clockedInAt = clockIn.clockedInAt) to outlet Scheduling.ShiftEventSource.ShiftEvents
    }
    on clockOut: command ClockOut is {
      yield event ClockedOut(shiftId = clockOut.shiftId, clockedOutAt = clockOut.clockedOutAt)
      send event ClockedOut(shiftId = clockOut.shiftId, clockedOutAt = clockOut.clockedOutAt) to outlet Scheduling.ShiftEventSource.ShiftEvents
    }
    on cancelShift: command CancelShift is {
      yield event ShiftCancelled(shiftId = cancelShift.shiftId, shiftCancelReason = cancelShift.shiftCancelReason, shiftCancelledAt = prompt("the shift cancelled at of this shift cancelled"))
      send event ShiftCancelled(shiftId = cancelShift.shiftId, shiftCancelReason = cancelShift.shiftCancelReason, shiftCancelledAt = prompt("the shift cancelled at of this shift cancelled")) to outlet Scheduling.ShiftEventSource.ShiftEvents
    }
    on query GetShift is {
      do "look up Shift by GetShift.shiftId"
      let shiftResult: type ShiftResult = prompt("read the shift from the store")
      reply shiftResult
    } with {
      briefly "Get shift query handler"
      described as {
        |Why this exists and what depends on it.
      }
    }
    on shiftCreated: event ShiftCreated is {
      morph entity Scheduling.Shift to state Scheduling.Shift.ActiveShift with record Shift.ShiftStateData(shiftId = shiftCreated.shiftId, shiftDate = shiftCreated.shiftDate, shiftStart = shiftCreated.shiftStart, shiftEnd = shiftCreated.shiftEnd, shiftRole = shiftCreated.shiftRole, shiftCreatedAt = shiftCreated.shiftCreatedAt, shiftStatus = prompt("Open, the status a shift starts in"), assignedEmployeeId = empty, assignedEmployeeName = empty, actualClockedInAt = empty, actualClockedOutAt = empty)
    }
    on event EmployeeAssigned is {
      set state ActiveShift to prompt("apply EmployeeAssigned to the Shift state")
    }
    on event ShiftSwapped is {
      set state ActiveShift to prompt("apply ShiftSwapped to the Shift state")
    }
    on event ClockedIn is {
      set state ActiveShift to prompt("apply ClockedIn to the Shift state")
    }
    on event ClockedOut is {
      set state ActiveShift to prompt("apply ClockedOut to the Shift state")
    }
    on event ShiftCancelled is {
      set state ActiveShift to prompt("apply ShiftCancelled to the Shift state")
    }
  } with {
    briefly "Shift command handler"
    described as {
      |Processes shift lifecycle commands.
    }
  }
} with {
  briefly "Shift entity"
  described as {
    | Manages the lifecycle of a staff shift from creation
    | through assignment, clock-in/out, swaps, and
    | cancellation.
  }
}
