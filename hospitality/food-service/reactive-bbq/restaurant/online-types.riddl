// Online Ordering shared types
type OnlineOrderId is Id(OnlineOrdering.OnlineOrder)  with {
  briefly "Online order identifier"
  described as {
    |Unique identifier for an online order.
  }
}
type CustomerId is UUID with {
  briefly "Customer identifier"
  described as {
    |Unique identifier for the online customer.
  }
}
type FulfillmentType is any of {
  PickupFulfillment,
  DeliveryFulfillment
} with {
  briefly "Fulfillment type"
  described as {
    |Whether the order is for pickup or delivery.
  }
}
// OnlineOrderStatus enum removed — lifecycle phase is now
// modeled by distinct RIDDL states on the OnlineOrder entity:
// Browsing, FulfillmentChosen, Submitted, Paid,
// InPreparation, ReadyForPickup, OutForDelivery, Completed,
// Cancelled
type OnlineOrderEvent is one of {
  OnlineOrdering.OnlineOrder.MenuBrowsed or OnlineOrdering.OnlineOrder.ItemAddedToCart or OnlineOrdering.OnlineOrder.ItemRemovedFromCart or OnlineOrdering.OnlineOrder.FulfillmentSelected or OnlineOrdering.OnlineOrder.OnlineOrderSubmitted or OnlineOrdering.OnlineOrder.OnlinePaymentProcessed or OnlineOrdering.OnlineOrder.OnlineOrderInPreparation or OnlineOrdering.OnlineOrder.OnlineOrderReadyForPickup or OnlineOrdering.OnlineOrder.OnlineOrderOutForDelivery or OnlineOrdering.OnlineOrder.OnlineOrderCompleted or OnlineOrdering.OnlineOrder.OnlineOrderCancelled or OnlineOrdering.OnlineOrder.AddToCartRejected or OnlineOrdering.OnlineOrder.BrowseMenuRejected or OnlineOrdering.OnlineOrder.CancelOnlineOrderRejected or OnlineOrdering.OnlineOrder.CompleteOnlineOrderRejected or OnlineOrdering.OnlineOrder.MarkOnlineInPreparationRejected or OnlineOrdering.OnlineOrder.MarkOutForDeliveryRejected or OnlineOrdering.OnlineOrder.MarkReadyForPickupRejected or OnlineOrdering.OnlineOrder.ProcessOnlinePaymentRejected or OnlineOrdering.OnlineOrder.RemoveFromCartRejected or OnlineOrdering.OnlineOrder.SelectFulfillmentRejected or OnlineOrdering.OnlineOrder.SubmitOnlineOrderRejected
} with {
  briefly "Online order event alternation"
  described as {
    |Union of all online order events for streaming and
    |event-sourced persistence.
  }
}
type CartItem is {
  cartMenuItemId: String(1,50) with {
    briefly "Menu item ID"
    described as {
      |Which menu item the guest put in the cart. Ties the line back to the
      |corporate menu, so a price or availability change is seen at
      |checkout rather than baked into the cart when it was filled.
    }
  }
  cartItemName: String(1,200) with {
    briefly "Item name"
    described as {
      |Display name of the item.
    }
  }
  cartItemPrice: Decimal(8,2) with {
    briefly "Price"
    described as {
      |Unit price.
    }
  }
  cartItemQuantity: Natural with {
    briefly "Quantity"
    described as {
      |Number ordered.
    }
  }
  cartItemNotes: String(1,500)? with {
    briefly "Notes"
    described as {
      |Special instructions.
    }
  }
} with {
  briefly "Cart item"
  described as {
    |An item in the online shopping cart.
  }
}
type DeliveryAddress is {
  streetAddress: String(1,200) with {
    briefly "Street"
    described as {
      |Street and number the courier drives to. Kept as free text because
      |delivery addresses arrive as guests type them, not from a validated
      |address book.
    }
  }
  deliveryCity: String(1,100) with {
    briefly "City"
    described as {
      |The town for the drop. Checked against the restaurant's delivery
      |radius, which is the usual reason an online order is refused.
    }
  }
  deliveryState: String(2,2) with {
    briefly "State"
    described as {
      |Two-letter state code.
    }
  }
  deliveryZipCode: String(5,10) with {
    briefly "ZIP code"
    described as {
      |ZIP or postal code.
    }
  }
  deliveryInstructions: String(1,500)? with {
    briefly "Instructions"
    described as {
      |How to actually complete the drop — gate codes, buzzers, leave at
      |the door. The single field that most often decides whether a
      |delivery succeeds on the first attempt.
    }
  }
} with {
  briefly "Delivery address"
  described as {
    |Address for delivery fulfillment.
  }
}
type OnlinePaymentInfo is {
  onlinePaymentMethod: String(1,50) with {
    briefly "Method"
    described as {
      |Payment method such as credit card or digital wallet.
    }
  }
  onlinePaymentAmount: Decimal(10,2) with {
    briefly "Amount"
    described as {
      |What the guest was charged online. Taken before the kitchen fires,
      |so a cancellation after this point is a refund rather than a
      |withdrawal.
    }
  }
  onlineTransactionRef: String(1,100) with {
    briefly "Transaction reference"
    described as {
      |External payment transaction reference.
    }
  }
} with {
  briefly "Online payment information"
  described as {
    |Payment details for an online order.
  }
}
