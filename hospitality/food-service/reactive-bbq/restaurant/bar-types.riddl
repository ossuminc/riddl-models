// Bar shared types
type DrinkOrderId is Id(Bar.DrinkOrder)  with {
  briefly "Drink order identifier"
  described as {
    |Unique identifier for a drink order.
  }
}
// DrinkOrderStatus enum removed — lifecycle phase is now
// modeled by distinct RIDDL states on the DrinkOrder entity:
// Received, InPreparation, Ready, Delivered, Completed
type DrinkOrderEvent is one of {
  Bar.DrinkOrder.DrinkOrderReceived or Bar.DrinkOrder.DrinkPrepared or Bar.DrinkOrder.DrinkMarkedReady or Bar.DrinkOrder.ServerNotifiedDrinksReady or Bar.DrinkOrder.DrinkOrderCompleted or Bar.DrinkOrder.CompleteDrinkOrderRejected or Bar.DrinkOrder.MarkDrinkReadyRejected or Bar.DrinkOrder.NotifyServerDrinksReadyRejected or Bar.DrinkOrder.PrepareDrinkRejected or Bar.DrinkOrder.ReceiveDrinkOrderRejected
} with {
  briefly "Drink order event alternation"
  described as {
    |Union of all drink order events for streaming and
    |event-sourced persistence.
  }
}
type DrinkItem is {
  drinkName: String(1,200) with {
    briefly "Drink name"
    described as {
      |What the bartender is being asked to pour, as it reads on the menu.
      |Held as text rather than a menu reference because the bar pours
      |off-menu and by request far more often than the kitchen cooks so.
    }
  }
  drinkQuantity: Natural with {
    briefly "Quantity"
    described as {
      |Number to prepare.
    }
  }
  drinkNotes: String(1,500)? with {
    briefly "Notes"
    described as {
      |Special instructions for preparation.
    }
  }
} with {
  briefly "Drink item"
  described as {
    |A single drink in an order.
  }
}
