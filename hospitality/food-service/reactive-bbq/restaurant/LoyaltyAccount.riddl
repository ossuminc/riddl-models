// LoyaltyAccount entity for the Loyalty context
event-sourced entity LoyaltyAccount as flow is {
  type LoyaltyAccountCommand is one of {
    LoyaltyAccount.EnrollCustomer or LoyaltyAccount.AccruePoints or LoyaltyAccount.RedeemPoints or LoyaltyAccount.SuspendAccount or LoyaltyAccount.ReactivateAccount or LoyaltyAccount.CloseAccount
  } with {
    briefly "LoyaltyAccount command alternation"
    described as {
      |Commands accepted by the LoyaltyAccount entity.
    }
  }
  type LoyaltyAccountEvent is one of {
    LoyaltyAccount.CustomerEnrolled or LoyaltyAccount.PointsAccrued or LoyaltyAccount.PointsRedeemed or LoyaltyAccount.AccountSuspended or LoyaltyAccount.AccountReactivated or LoyaltyAccount.AccountClosed or LoyaltyAccount.EnrollCustomerRejected or LoyaltyAccount.AccruePointsRejected or LoyaltyAccount.RedeemPointsRejected or LoyaltyAccount.SuspendAccountRejected or LoyaltyAccount.ReactivateAccountRejected or LoyaltyAccount.CloseAccountRejected
  } with {
    briefly "LoyaltyAccount event alternation"
    described as {
      |Events published by the LoyaltyAccount entity.
    }
  }
  inlet LoyaltyAccountCommands is type LoyaltyAccountCommand  outlet LoyaltyAccountEvents2 is type LoyaltyAccountEvent
  // ---- Commands ----
  command EnrollCustomer yields event CustomerEnrolled is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |Identifier for the new account.
      }
    }
    loyaltyCustomerId: LoyaltyCustomerId with {
      briefly "Customer ID"
      described as {
        |Customer to enroll.
      }
    }
    customerDisplayName: String(1,100) with {
      briefly "Name"
      described as {
        |What staff greet the guest by. A regular's preferred name, not a
        |legal one — loyalty exists so the room can recognise people.
      }
    }
    customerEmail: String(5,254) with {
      briefly "Email"
      described as {
        |Customer email address.
      }
    }
  } with {
    briefly "Enroll customer"
    described as {
      |Enroll a new customer in the loyalty program.
    }
  }
  command AccruePoints yields event PointsAccrued is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |Account to accrue points to.
      }
    }
    accrualPoints: Natural with {
      briefly "Points"
      described as {
        |Number of points to accrue.
      }
    }
    accrualReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Reason for accrual such as purchase.
      }
    }
    accrualOrderRef: String(1,50)? with {
      briefly "Order reference"
      described as {
        |Reference to the originating order.
      }
    }
  } with {
    briefly "Accrue points"
    described as {
      |Add loyalty points to the account.
    }
  }
  command RedeemPoints yields event PointsRedeemed is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |Account to redeem points from.
      }
    }
    redemptionPoints: Natural with {
      briefly "Points"
      described as {
        |Number of points to redeem.
      }
    }
    redemptionReason: String(1,200) with {
      briefly "Reason"
      described as {
        |What the points are being redeemed for.
      }
    }
  } with {
    briefly "Redeem points"
    described as {
      |Redeem loyalty points from the account.
    }
  }
  command SuspendAccount yields event AccountSuspended is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |Account to suspend.
      }
    }
    suspensionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the account is being frozen. Kept because suspension is
        |reversible and whoever reactivates it needs to know what they are
        |undoing — suspected fraud reads very differently from unpaid dues.
      }
    }
  } with {
    briefly "Suspend account"
    described as {
      |Suspend a loyalty account.
    }
  }
  command ReactivateAccount yields event AccountReactivated is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |Account to reactivate.
      }
    }
  } with {
    briefly "Reactivate account"
    described as {
      |Reactivate a suspended loyalty account.
    }
  }
  command CloseAccount yields event AccountClosed is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |Account to close permanently.
      }
    }
    closureReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason for permanent closure.
      }
    }
  } with {
    briefly "Close account"
    described as {
      |Permanently close a loyalty account.
    }
  }
  // ---- Events ----
  event CustomerEnrolled is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account just opened. Every later event carries the same value,
        |so a member's whole history can be assembled from the event log.
      }
    }
    loyaltyCustomerId: LoyaltyCustomerId with {
      briefly "Customer ID"
      described as {
        |The person behind the account, as the restaurant's customer records
        |know them. Distinct from the account so one guest can be recognised
        |across a closure and a later re-enrolment.
      }
    }
    customerDisplayName: String(1,100) with {
      briefly "Name"
      described as {
        |The name captured at enrolment, as the guest gave it.
      }
    }
    customerEmail: String(5,254) with {
      briefly "Email"
      described as {
        |Where statements and reward notices go. The only channel loyalty
        |reliably holds, since a member need never book a table.
      }
    }
    enrolledAt: TimeStamp with {
      term Tier is  "A band a member sits in — earned by spend or tenure — that changes what they earn and what they are offered. A member is always in exactly one." 
      term Tenure is  "How long someone has been a member, counted from enrollment. Distinct from how much they spend: a quiet member of ten years is not a new one." 
      briefly "Enrolled at"
      described as {
        |When the member joined. Tenure is what tier thresholds and
        |anniversary rewards are computed from.
      }
    }
  } with {
    briefly "Customer enrolled"
    described as {
      |Emitted when a customer enrolls in loyalty.
    }
  }
  event PointsAccrued is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account being credited. Accrual arrives from a paid check, so
        |this is the seam where a visit becomes a member's balance.
      }
    }
    accrualPoints: Natural with {
      briefly "Points"
      described as {
        |Points accrued.
      }
    }
    accrualReason: String(1,200) with {
      briefly "Reason"
      described as {
        |Why points were granted — a paid check, a promotion, or a goodwill
        |adjustment. Kept because only some of these are reversible when a
        |payment is later voided.
      }
    }
    newBalance: Natural with {
      briefly "Balance"
      described as {
        |New point balance after accrual.
      }
    }
    accruedAt: TimeStamp with {
      briefly "Accrued at"
      described as {
        |When the credit landed. Points expire on a schedule counted from
        |here, not from when the account was opened.
      }
    }
  } with {
    briefly "Points accrued"
    described as {
      |Emitted when points are added to an account.
    }
  }
  event PointsRedeemed is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account being debited. Redemption is the only event that can
        |fail on insufficient balance, so it is checked against state rather
        |than merely recorded.
      }
    }
    redemptionPoints: Natural with {
      briefly "Points"
      described as {
        |Points redeemed.
      }
    }
    redemptionReason: String(1,200) with {
      briefly "Reason"
      described as {
        |What the points were spent on. Kept so a reward can be traced back
        |if the guest disputes it or the item is returned.
      }
    }
    remainingBalance: Natural with {
      briefly "Balance"
      described as {
        |Remaining point balance after redemption.
      }
    }
    redeemedAt: TimeStamp with {
      briefly "Redeemed at"
      described as {
        |When the balance was drawn down. Ordering matters against accrual:
        |a redemption replayed before its accrual would overdraw.
      }
    }
  } with {
    briefly "Points redeemed"
    described as {
      |Emitted when points are redeemed from an account.
    }
  }
  event AccountSuspended is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account being frozen. Suspension stops accrual and redemption
        |but preserves the balance, which is what distinguishes it from
        |closure.
      }
    }
    suspensionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the freeze was applied, carried forward so reactivation is a
        |judgement someone can actually make.
      }
    }
    suspendedAt: TimeStamp with {
      briefly "Suspended at"
      described as {
        |When the freeze took effect. Points accrued after this instant are
        |the ones that need reversing if the suspension is upheld.
      }
    }
  } with {
    briefly "Account suspended"
    described as {
      |Emitted when a loyalty account is suspended.
    }
  }
  event AccountReactivated is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account being restored. Reactivation returns the balance
        |untouched — the member loses time, not points.
      }
    }
    reactivatedAt: TimeStamp with {
      briefly "Reactivated at"
      described as {
        |When the account came back. The span from suspension measures how
        |long the member was locked out, which support uses to decide
        |goodwill.
      }
    }
  } with {
    briefly "Account reactivated"
    described as {
      |Emitted when a suspended account is reactivated.
    }
  }
  event AccountClosed is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account being closed. Closure is terminal and forfeits the
        |balance, so it is deliberately a separate command from suspension.
      }
    }
    closureReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the account ended — the member asked, or the restaurant acted.
        |The two are treated very differently if the guest later returns.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed at"
      described as {
        |When the account ended. Retention reporting counts closures against
        |this date rather than against the last visit.
      }
    }
  } with {
    briefly "Account closed"
    described as {
      |Emitted when a loyalty account is permanently closed.
    }
  }
  // ---- Rejection Events ----
  event EnrollCustomerRejected is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account that could not be enrolled, typically because this
        |customer already holds one.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the enrollment was rejected.
      }
    }
  } with {
    briefly "Enrollment rejected"
    described as {
      |Emitted when a customer enrollment is rejected.
    }
  }
  event AccruePointsRejected is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account that could not be credited, typically because it is
        |suspended or closed.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the point accrual was rejected.
      }
    }
  } with {
    briefly "Point accrual rejected"
    described as {
      |Emitted when a point accrual is rejected.
    }
  }
  event RedeemPointsRejected is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account that could not be debited — most often an insufficient
        |balance, the one refusal a member sees at the table.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the point redemption was rejected.
      }
    }
  } with {
    briefly "Point redemption rejected"
    described as {
      |Emitted when a point redemption is rejected.
    }
  }
  event SuspendAccountRejected is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account that could not be frozen, typically because it is
        |already suspended or has been closed.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the suspension was rejected.
      }
    }
  } with {
    briefly "Suspension rejected"
    described as {
      |Emitted when an account suspension is rejected.
    }
  }
  event ReactivateAccountRejected is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account that could not be restored, typically because it was
        |never suspended.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the reactivation was rejected.
      }
    }
  } with {
    briefly "Reactivation rejected"
    described as {
      |Emitted when an account reactivation is rejected.
    }
  }
  event CloseAccountRejected is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account that could not be closed, typically because it is
        |closed already.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the closure was rejected.
      }
    }
  } with {
    briefly "Closure rejected"
    described as {
      |Emitted when an account closure is rejected.
    }
  }
  // ---- Queries ----
  query GetLoyaltyAccount replies result LoyaltyAccountResult is {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |Account to retrieve.
      }
    }
  } with {
    briefly "Get loyalty account"
    described as {
      |Query a loyalty account by its identifier.
    }
  }
  result LoyaltyAccountResult is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "LoyaltyAccount addressed"
      described as {
        |Which loyaltyaccount this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    account: LoyaltyAccountData with {
      briefly "Account"
      described as {
        |The requested account data.
      }
    }
  } with {
    briefly "Loyalty account result"
    described as {
      |Result containing the requested loyalty account data.
    }
  }
  // ---- State ----
  record LoyaltyAccountData is  {
    loyaltyAccountId: LoyaltyAccountId with {
      briefly "ID"
      described as {
        |The account this state belongs to. Carried through every lifecycle
        |state so the record can be rebuilt by replaying the event log.
      }
    }
    loyaltyCustomerId: LoyaltyCustomerId with {
      briefly "Customer ID"
      described as {
        |The person the account belongs to, held in state so a member can be
        |looked up by guest rather than only by account.
      }
    }
    customerDisplayName: String(1,100) with {
      briefly "Name"
      described as {
        |The name to greet the member by, kept current as they update it.
      }
    }
    customerEmail: String(5,254) with {
      briefly "Email"
      described as {
        |The member's current contact address, which may differ from the one
        |given at enrolment.
      }
    }
    pointBalance: Natural with {
      briefly "Balance"
      described as {
        |Current point balance.
      }
    }
    lifetimePoints: Natural with {
      briefly "Lifetime points"
      described as {
        |Total points earned since enrollment.
      }
    }
    recentTransactions: PointTransaction+ with {
      briefly "Transactions"
      described as {
        |Recent point transactions.
      }
    }
    enrolledAt: TimeStamp with {
      briefly "Enrolled at"
      described as {
        |When the member joined, held in state because tenure drives tier
        |and must not require replaying the whole log to read.
      }
    }
    closedAt: TimeStamp? with {
      briefly "Closed at"
      described as {
        |When the account was permanently closed.
      }
    }
  } with {
    briefly "Loyalty account state data"
    described as {
      |Full state of a loyalty account. Shared across all
      |lifecycle states as a superset record.
    }
  }
  initial state Active of record LoyaltyAccount.LoyaltyAccountData is {
    initial handler ActiveInitHandler is {
      on init is {
        let customerEnrolled: type CustomerEnrolled = prompt("the customer enrolled that brings this loyalty account into existence")
        yield customerEnrolled
      }
    } with {
      briefly "Active state init handler"
      described as {
        |Initializes the active state with default values.
      }
    }
    invariant SufficientBalance is "LoyaltyAccountData.pointBalance >= 0" with {
      briefly "Balance never goes negative"
      described as {
        |A member cannot spend points they do not hold. Stated on the Active
        |state because it is the only state in which the balance moves —
        |suspension freezes it and closure forfeits it, so neither can break
        |it. Redemption is the one command that can violate it, which is why
        |redemption is also the only one that can be refused on balance.
      }
    }
    handler ActiveHandler is {
      on accruePoints: command AccruePoints is {
        yield event PointsAccrued(loyaltyAccountId = accruePoints.loyaltyAccountId, accrualPoints = accruePoints.accrualPoints, accrualReason = accruePoints.accrualReason, newBalance = prompt("the new balance of this points accrued"), accruedAt = prompt("the accrued at of this points accrued"))
        send event PointsAccrued(loyaltyAccountId = accruePoints.loyaltyAccountId, accrualPoints = accruePoints.accrualPoints, accrualReason = accruePoints.accrualReason, newBalance = prompt("the new balance of this points accrued"), accruedAt = prompt("the accrued at of this points accrued")) to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
      }
      on event PointsAccrued is {
        set field LoyaltyAccount.Active.pointBalance to "LoyaltyAccountData.pointBalance +
          PointsAccrued.accrualPoints"
        set field LoyaltyAccount.Active.lifetimePoints to "LoyaltyAccountData.lifetimePoints +
          PointsAccrued.accrualPoints"
        do "append PointTransaction to LoyaltyAccountData
          .recentTransactions with new transactionId,
          pointsChanged = PointsAccrued.accrualPoints,
          transactionReason = PointsAccrued.accrualReason,
          sourceOrderRef = AccruePoints.accrualOrderRef,
          transactionTimestamp = current timestamp"
      }
      on redeemPoints: command RedeemPoints is {
        require invariant SufficientBalance
        when prompt("LoyaltyAccountData.pointBalance >=
          RedeemPoints.redemptionPoints") then
          yield event PointsRedeemed(loyaltyAccountId = redeemPoints.loyaltyAccountId, redemptionPoints = redeemPoints.redemptionPoints, redemptionReason = redeemPoints.redemptionReason, remainingBalance = prompt("the remaining balance of this points redeemed"), redeemedAt = prompt("the redeemed at of this points redeemed"))
          send event PointsRedeemed(loyaltyAccountId = redeemPoints.loyaltyAccountId, redemptionPoints = redeemPoints.redemptionPoints, redemptionReason = redeemPoints.redemptionReason, remainingBalance = prompt("the remaining balance of this points redeemed"), redeemedAt = prompt("the redeemed at of this points redeemed")) to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        else
          send event RedeemPointsRejected(loyaltyAccountId = redeemPoints.loyaltyAccountId, rejectionReason = "Point balance is less than the points requested for redemption") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        end
      }
      on event PointsRedeemed is {
        set field LoyaltyAccount.Active.pointBalance to "LoyaltyAccountData.pointBalance -
          PointsRedeemed.redemptionPoints"
        do "append PointTransaction to LoyaltyAccountData
          .recentTransactions with new transactionId,
          pointsChanged = negative PointsRedeemed
          .redemptionPoints, transactionReason = PointsRedeemed
          .redemptionReason, transactionTimestamp = current
          timestamp"
      }
      on suspendAccount: command SuspendAccount is {
        yield event AccountSuspended(loyaltyAccountId = suspendAccount.loyaltyAccountId, suspensionReason = suspendAccount.suspensionReason, suspendedAt = prompt("the suspended at of this account suspended"))
        send event AccountSuspended(loyaltyAccountId = suspendAccount.loyaltyAccountId, suspensionReason = suspendAccount.suspensionReason, suspendedAt = prompt("the suspended at of this account suspended")) to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
      }
      on accountSuspended: event AccountSuspended is {
        morph entity Loyalty.LoyaltyAccount to state Loyalty.LoyaltyAccount.Suspended with record LoyaltyAccount.LoyaltyAccountData(loyaltyAccountId = accountSuspended.loyaltyAccountId, loyaltyCustomerId = LoyaltyAccountData.loyaltyCustomerId, customerDisplayName = LoyaltyAccountData.customerDisplayName, customerEmail = LoyaltyAccountData.customerEmail, pointBalance = LoyaltyAccountData.pointBalance, lifetimePoints = LoyaltyAccountData.lifetimePoints, recentTransactions = LoyaltyAccountData.recentTransactions, enrolledAt = LoyaltyAccountData.enrolledAt, closedAt = LoyaltyAccountData.closedAt)
        set state Suspended to "loyaltyAccountId, loyaltyCustomerId, customerDisplayName, customerEmail, pointBalance, lifetimePoints, recentTransactions, enrolledAt = AccountSuspended.suspendedAt, closedAt = none"
      }
      on closeAccount: command CloseAccount is {
        yield event AccountClosed(loyaltyAccountId = closeAccount.loyaltyAccountId, closureReason = closeAccount.closureReason, closedAt = LoyaltyAccountData.closedAt)
        send event AccountClosed(loyaltyAccountId = closeAccount.loyaltyAccountId, closureReason = closeAccount.closureReason, closedAt = LoyaltyAccountData.closedAt) to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
      }
      on accountClosed: event AccountClosed is {
        morph entity Loyalty.LoyaltyAccount to state Loyalty.LoyaltyAccount.Closed with record LoyaltyAccount.LoyaltyAccountData(loyaltyAccountId = accountClosed.loyaltyAccountId, closedAt = accountClosed.closedAt, loyaltyCustomerId = LoyaltyAccountData.loyaltyCustomerId, customerDisplayName = LoyaltyAccountData.customerDisplayName, customerEmail = LoyaltyAccountData.customerEmail, pointBalance = LoyaltyAccountData.pointBalance, lifetimePoints = LoyaltyAccountData.lifetimePoints, recentTransactions = LoyaltyAccountData.recentTransactions, enrolledAt = LoyaltyAccountData.enrolledAt)
        set field LoyaltyAccount.Closed.closedAt to "current timestamp"
        set state LoyaltyAccount.Closed to "loyaltyAccountId, loyaltyCustomerId, customerDisplayName, customerEmail, pointBalance, lifetimePoints, recentTransactions, enrolledAt, closedAt = AccountClosed.closedAt"
      }
      on enrollCustomer: command EnrollCustomer is {
        send event EnrollCustomerRejected(loyaltyAccountId = enrollCustomer.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept EnrollCustomer in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept EnrollCustomer in this state"
      }
      on reactivateAccount: command ReactivateAccount is {
        send event ReactivateAccountRejected(loyaltyAccountId = reactivateAccount.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept ReactivateAccount in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept ReactivateAccount in this state"
      }
    } with {
      briefly "Active state handler"
      described as {
        |Handles commands valid in the Active state.
        |AccruePoints and RedeemPoints operate within
        |Active without state transition. SuspendAccount
        |and CloseAccount transition to other states.
      }
    }
  } with {
    briefly "Active account"
    described as {
      |Account is enrolled and operational. Points can be
      |accrued and redeemed.
    }
  }
  state Suspended of record LoyaltyAccount.LoyaltyAccountData is {
    initial handler SuspendedInitHandler is {
      on init is {
        let accountSuspended: type AccountSuspended = prompt("the account suspended that brings this loyalty into existence")
        yield accountSuspended
      }
    } with {
      briefly "Suspended state init handler"
      described as {
        |Initializes the suspended state from the
        |AccountSuspended event.
      }
    }
    handler SuspendedHandler is {
      on reactivateAccount: command ReactivateAccount is {
        yield event AccountReactivated(loyaltyAccountId = reactivateAccount.loyaltyAccountId, reactivatedAt = prompt("the reactivated at of this account reactivated"))
        send event AccountReactivated(loyaltyAccountId = reactivateAccount.loyaltyAccountId, reactivatedAt = prompt("the reactivated at of this account reactivated")) to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
      }
      on accountReactivated: event AccountReactivated is {
        morph entity Loyalty.LoyaltyAccount to state Loyalty.LoyaltyAccount.Active with record LoyaltyAccount.LoyaltyAccountData(loyaltyAccountId = accountReactivated.loyaltyAccountId, loyaltyCustomerId = LoyaltyAccountData.loyaltyCustomerId, customerDisplayName = LoyaltyAccountData.customerDisplayName, customerEmail = LoyaltyAccountData.customerEmail, pointBalance = LoyaltyAccountData.pointBalance, lifetimePoints = LoyaltyAccountData.lifetimePoints, recentTransactions = LoyaltyAccountData.recentTransactions, enrolledAt = LoyaltyAccountData.enrolledAt, closedAt = LoyaltyAccountData.closedAt)
      }
      on closeAccount: command CloseAccount is {
        yield event AccountClosed(loyaltyAccountId = closeAccount.loyaltyAccountId, closureReason = closeAccount.closureReason, closedAt = LoyaltyAccountData.closedAt)
        send event AccountClosed(loyaltyAccountId = closeAccount.loyaltyAccountId, closureReason = closeAccount.closureReason, closedAt = LoyaltyAccountData.closedAt) to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
      }
      on accountClosed: event AccountClosed is {
        morph entity Loyalty.LoyaltyAccount to state Loyalty.LoyaltyAccount.Closed with record LoyaltyAccount.LoyaltyAccountData(loyaltyAccountId = accountClosed.loyaltyAccountId, closedAt = accountClosed.closedAt, loyaltyCustomerId = LoyaltyAccountData.loyaltyCustomerId, customerDisplayName = LoyaltyAccountData.customerDisplayName, customerEmail = LoyaltyAccountData.customerEmail, pointBalance = LoyaltyAccountData.pointBalance, lifetimePoints = LoyaltyAccountData.lifetimePoints, recentTransactions = LoyaltyAccountData.recentTransactions, enrolledAt = LoyaltyAccountData.enrolledAt)
        set field LoyaltyAccount.Closed.closedAt to "current timestamp"
      }
      on enrollCustomer: command EnrollCustomer is {
        send event EnrollCustomerRejected(loyaltyAccountId = enrollCustomer.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept EnrollCustomer in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept EnrollCustomer in this state"
      }
      on accruePoints: command AccruePoints is {
        send event AccruePointsRejected(loyaltyAccountId = accruePoints.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept AccruePoints in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept AccruePoints in this state"
      }
      on redeemPoints: command RedeemPoints is {
        send event RedeemPointsRejected(loyaltyAccountId = redeemPoints.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept RedeemPoints in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept RedeemPoints in this state"
      }
      on suspendAccount: command SuspendAccount is {
        send event SuspendAccountRejected(loyaltyAccountId = suspendAccount.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept SuspendAccount in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept SuspendAccount in this state"
      }
    } with {
      briefly "Suspended state handler"
      described as {
        |Handles commands valid in the Suspended state.
        |ReactivateAccount returns to Active. CloseAccount
        |permanently closes the account.
      }
    }
  } with {
    briefly "Suspended account"
    described as {
      |Account is temporarily suspended. Points cannot be
      |accrued or redeemed until reactivated.
    }
  }
  state Closed of record LoyaltyAccount.LoyaltyAccountData is {
    initial handler ClosedInitHandler is {
      on init is {
        let accountClosed: type AccountClosed = prompt("the account closed that brings this loyalty into existence")
        yield accountClosed
      }
    } with {
      briefly "Closed state init handler"
      described as {
        |Initializes the closed state from the
        |AccountClosed event.
      }
    }
    handler ClosedHandler is {
      on enrollCustomer: command EnrollCustomer is {
        send event EnrollCustomerRejected(loyaltyAccountId = enrollCustomer.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept EnrollCustomer in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept EnrollCustomer in this state"
      }
      on accruePoints: command AccruePoints is {
        send event AccruePointsRejected(loyaltyAccountId = accruePoints.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept AccruePoints in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept AccruePoints in this state"
      }
      on redeemPoints: command RedeemPoints is {
        send event RedeemPointsRejected(loyaltyAccountId = redeemPoints.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept RedeemPoints in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept RedeemPoints in this state"
      }
      on suspendAccount: command SuspendAccount is {
        send event SuspendAccountRejected(loyaltyAccountId = suspendAccount.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept SuspendAccount in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept SuspendAccount in this state"
      }
      on reactivateAccount: command ReactivateAccount is {
        send event ReactivateAccountRejected(loyaltyAccountId = reactivateAccount.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept ReactivateAccount in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept ReactivateAccount in this state"
      }
      on closeAccount: command CloseAccount is {
        send event CloseAccountRejected(loyaltyAccountId = closeAccount.loyaltyAccountId, rejectionReason = "LoyaltyAccount does not accept CloseAccount in this state") to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
        error "LoyaltyAccount does not accept CloseAccount in this state"
      }
    } with {
      briefly "Closed state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Closed account"
    described as {
      |Account is permanently closed. No further operations
      |are possible.
    }
  }
  handler LoyaltyCreationHandler is {
    on enrollCustomer: command EnrollCustomer is {
      yield event CustomerEnrolled(loyaltyAccountId = enrollCustomer.loyaltyAccountId, loyaltyCustomerId = enrollCustomer.loyaltyCustomerId, customerDisplayName = enrollCustomer.customerDisplayName, customerEmail = enrollCustomer.customerEmail, enrolledAt = LoyaltyAccountData.enrolledAt)
      send event CustomerEnrolled(loyaltyAccountId = enrollCustomer.loyaltyAccountId, loyaltyCustomerId = enrollCustomer.loyaltyCustomerId, customerDisplayName = enrollCustomer.customerDisplayName, customerEmail = enrollCustomer.customerEmail, enrolledAt = LoyaltyAccountData.enrolledAt) to outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents
    }
    on customerEnrolled: event CustomerEnrolled is {
      morph entity Loyalty.LoyaltyAccount to state Loyalty.LoyaltyAccount.Active with record LoyaltyAccount.LoyaltyAccountData(loyaltyAccountId = customerEnrolled.loyaltyAccountId, loyaltyCustomerId = customerEnrolled.loyaltyCustomerId, customerDisplayName = customerEnrolled.customerDisplayName, customerEmail = customerEnrolled.customerEmail, enrolledAt = customerEnrolled.enrolledAt, pointBalance = LoyaltyAccountData.pointBalance, lifetimePoints = LoyaltyAccountData.lifetimePoints, recentTransactions = LoyaltyAccountData.recentTransactions, closedAt = LoyaltyAccountData.closedAt)
      set field LoyaltyAccount.Active.pointBalance to "0"
      set field LoyaltyAccount.Active.lifetimePoints to "0"
      do "CustomerEnrolled event triggers welcome push
        notification via NotificationService streaming
        topology"
      set state LoyaltyAccount.Active to "loyaltyAccountId, loyaltyCustomerId, customerDisplayName, customerEmail, pointBalance = 0, lifetimePoints = 0, recentTransactions = empty, enrolledAt = CustomerEnrolled.enrolledAt, closedAt = none"
    }
    on query GetLoyaltyAccount is {
      do "look up LoyaltyAccount by GetLoyaltyAccount.loyaltyAccountId"
      let loyaltyAccountResult: type LoyaltyAccountResult = prompt("read the loyalty account from the store")
      reply loyaltyAccountResult
    } with {
      briefly "Get loyalty account query handler"
      described as {
        |Why this exists and what depends on it.
      }
    }
  } with {
    briefly "Loyalty creation handler"
    described as {
      |Handles the initial EnrollCustomer command when
      |the entity has no state yet.
    }
  }
} with {
  briefly "Loyalty account entity"
  described as {
    | Manages the lifecycle of a loyalty account from
    | enrollment through point accrual, redemption,
    | suspension, and reactivation. State handlers ensure
    | commands are only valid in appropriate states, and
    | events are persisted before state transitions.
  }
}
