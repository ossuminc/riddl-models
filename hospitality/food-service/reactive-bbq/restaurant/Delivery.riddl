// DeliveryOrder entity for the Delivery context
event-sourced entity DeliveryOrder as flow is {
  type DeliveryOrderCommand is one of {
    DeliveryOrder.CreateDelivery or DeliveryOrder.AssignDriver or DeliveryOrder.DispatchDriver or DeliveryOrder.RecordDeliveryLocation or DeliveryOrder.ConfirmDelivery or DeliveryOrder.RecordDeliveryPayment or DeliveryOrder.ReportDeliveryIssue or DeliveryOrder.FailDelivery
  } with {
    briefly "DeliveryOrder command alternation"
    described as {
      |Commands accepted by the DeliveryOrder entity.
    }
  }
  type DeliveryOrderEvent is one of {
    DeliveryOrder.DeliveryCreated or DeliveryOrder.DriverAssigned or DeliveryOrder.DriverDispatched or DeliveryOrder.DeliveryLocationRecorded or DeliveryOrder.DeliveryConfirmed or DeliveryOrder.DeliveryPaymentRecorded or DeliveryOrder.DeliveryIssueReported or DeliveryOrder.DeliveryMarkedFailed or DeliveryOrder.CreateDeliveryRejected or DeliveryOrder.AssignDriverRejected or DeliveryOrder.DispatchDriverRejected or DeliveryOrder.RecordDeliveryLocationRejected or DeliveryOrder.ConfirmDeliveryRejected or DeliveryOrder.RecordDeliveryPaymentRejected or DeliveryOrder.ReportDeliveryIssueRejected or DeliveryOrder.FailDeliveryRejected
  } with {
    briefly "DeliveryOrder event alternation"
    described as {
      |Events published by the DeliveryOrder entity.
    }
  }
  inlet DeliveryOrderCommands is type DeliveryOrderCommand  outlet DeliveryOrderEvents2 is type DeliveryOrderEvent
  // ---- Commands ----
  command CreateDelivery yields event DeliveryCreated is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Identifier for the new delivery.
      }
    }
    sourceOnlineOrderId: String(1,50) with {
      briefly "Online order ID"
      described as {
        |Originating online order.
      }
    }
    deliveryCustomerName: String(1,100) with {
      briefly "Customer name"
      described as {
        |Who the driver is looking for at the door. Carried on the delivery
        |itself because the driver has no access to customer records from the
        |road.
      }
    }
    deliveryCustomerPhone: String(7,20) with {
      briefly "Customer phone"
      described as {
        |Customer contact phone.
      }
    }
    deliveryDestination: DeliveryAddress with {
      briefly "Destination"
      described as {
        |Delivery destination address.
      }
    }
    requestedDeliveryTime: TimeStamp? with {
      briefly "Requested time"
      described as {
        |Customer-requested delivery time.
      }
    }
  } with {
    briefly "Create delivery"
    described as {
      |Create a new delivery from an online order.
    }
  }
  command AssignDriver yields event DriverAssigned is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery to assign driver to.
      }
    }
    driverId: DriverId with {
      briefly "Driver ID"
      described as {
        |Driver being assigned.
      }
    }
    driverName: String(1,100) with {
      briefly "Driver name"
      described as {
        |Name of the assigned driver.
      }
    }
  } with {
    briefly "Assign driver"
    described as {
      |Assign a delivery driver.
    }
  }
  command DispatchDriver yields event DriverDispatched is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery to dispatch.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched at"
      described as {
        |When the driver was dispatched.
      }
    }
  } with {
    briefly "Dispatch driver"
    described as {
      |Dispatch the assigned driver for delivery.
    }
  }
  command RecordDeliveryLocation yields event DeliveryLocationRecorded is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery to record location for.
      }
    }
    driverLocation: GeoLocation with {
      briefly "Location"
      described as {
        |Current driver GPS location.
      }
    }
  } with {
    briefly "Record delivery location"
    described as {
      |Record the driver's current GPS location.
    }
  }
  command ConfirmDelivery yields event DeliveryConfirmed is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery to confirm.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed at"
      described as {
        |When the delivery was confirmed.
      }
    }
    deliverySignature: String(1,200)? with {
      briefly "Signature"
      described as {
        |Customer signature or confirmation.
      }
    }
  } with {
    briefly "Confirm delivery"
    described as {
      |Confirm the delivery was completed.
    }
  }
  command RecordDeliveryPayment yields event DeliveryPaymentRecorded is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery to record payment for.
      }
    }
    deliveryTip: Decimal(8,2)? with {
      briefly "Tip"
      described as {
        |Driver tip amount.
      }
    }
    deliveryPaidAt: TimeStamp with {
      briefly "Paid at"
      described as {
        |When payment was recorded.
      }
    }
  } with {
    briefly "Record delivery payment"
    described as {
      |Record cash tip or additional payment at delivery.
    }
  }
  command ReportDeliveryIssue yields event DeliveryIssueReported is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery with the issue.
      }
    }
    issueType: DeliveryIssueType with {
      briefly "Issue type"
      described as {
        |What went wrong on the road — wrong address, no answer, traffic,
        |damaged food. Classified rather than free text because dispatch
        |reacts differently to each, and some are the restaurant's fault.
      }
    }
    issueDescription: String(1,1000) with {
      briefly "Description"
      described as {
        |Detailed description of the issue.
      }
    }
    reportedAt: TimeStamp with {
      briefly "Reported at"
      described as {
        |When the issue was reported.
      }
    }
  } with {
    briefly "Report delivery issue"
    described as {
      |Report an issue during delivery.
    }
  }
  command FailDelivery yields event DeliveryMarkedFailed is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery that failed.
      }
    }
    failureReason: String(1,1000) with {
      briefly "Reason"
      described as {
        |Reason for the delivery failure.
      }
    }
    failedAt: TimeStamp with {
      briefly "Failed at"
      described as {
        |When the delivery was marked as failed.
      }
    }
  } with {
    briefly "Fail delivery"
    described as {
      |Mark a delivery as permanently failed, such as when
      |the customer is unavailable after timeout.
    }
  }
  // ---- Events ----
  event DeliveryCreated is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery just created. Every later event carries the same value,
        |so a drop's whole journey can be assembled from the event log.
      }
    }
    sourceOnlineOrderId: String(1,50) with {
      briefly "Online order ID"
      described as {
        |Originating order.
      }
    }
    deliveryDestination: DeliveryAddress with {
      briefly "Destination"
      described as {
        |Delivery address.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the delivery was raised. Time zero for the promise made to the
        |guest, which keeps running while the order waits for a driver.
      }
    }
  } with {
    briefly "Delivery created"
    described as {
      |Emitted when a new delivery is created.
    }
  }
  event DriverAssigned is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery now given to a driver. Assignment is what makes the
        |drop one person's responsibility rather than the dispatch queue's.
      }
    }
    driverId: DriverId with {
      briefly "Driver ID"
      described as {
        |Assigned driver.
      }
    }
    driverName: String(1,100) with {
      briefly "Driver name"
      described as {
        |Who is bringing it, captured on the event so the guest can be told a
        |name without dispatch having to resolve a driver record.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned at"
      described as {
        |When a driver took it. The wait before this is dispatch latency —
        |time the food spends getting cold before anyone is even carrying it.
      }
    }
  } with {
    briefly "Driver assigned"
    described as {
      |Emitted when a driver is assigned to a delivery.
    }
  }
  event DriverDispatched is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery now on the road. Dispatch is distinct from assignment:
        |a driver can hold several drops before actually leaving.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched at"
      described as {
        |When the driver left. The road clock starts here, and it is the only
        |stretch the restaurant cannot influence.
      }
    }
  } with {
    briefly "Driver dispatched"
    described as {
      |Emitted when the driver is dispatched.
    }
  }
  event DeliveryLocationRecorded is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery whose position was reported. Location arrives
        |repeatedly through the trip, so this is the one event that fires
        |many times for one drop.
      }
    }
    driverLocation: GeoLocation with {
      briefly "Location"
      described as {
        |GPS location.
      }
    }
  } with {
    briefly "Delivery location recorded"
    described as {
      |Emitted when a driver location update is recorded.
    }
  }
  event DeliveryConfirmed is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that reached the guest. Confirmation is the driver's
        |word for it and is what ends the road clock.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed at"
      described as {
        |When the food changed hands. The span from creation is the number
        |the guest judges, and the only one they ever see.
      }
    }
  } with {
    briefly "Delivery confirmed"
    described as {
      |Emitted when delivery is confirmed complete.
    }
  }
  event DeliveryPaymentRecorded is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery whose payment was taken at the door — cash or card on
        |the doorstep, which online prepayment does not cover.
      }
    }
    deliveryTip: Decimal(8,2)? with {
      briefly "Tip"
      described as {
        |Tip amount.
      }
    }
    deliveryPaidAt: TimeStamp with {
      briefly "Paid at"
      described as {
        |When recorded.
      }
    }
  } with {
    briefly "Delivery payment recorded"
    described as {
      |Emitted when delivery payment or tip is recorded.
    }
  }
  event DeliveryIssueReported is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that hit trouble. An issue does not end the drop; the
        |driver may still complete it after reporting.
      }
    }
    issueType: DeliveryIssueType with {
      briefly "Issue type"
      described as {
        |What went wrong, classified so dispatch can decide whether to
        |redirect, refund or let the driver carry on.
      }
    }
    issueDescription: String(1,1000) with {
      briefly "Description"
      described as {
        |Issue details.
      }
    }
    reportedAt: TimeStamp with {
      briefly "Reported at"
      described as {
        |When the driver raised it. Held against the dispatch time to show
        |how far into the trip things went wrong.
      }
    }
  } with {
    briefly "Delivery issue reported"
    described as {
      |Emitted when a delivery issue is reported.
    }
  }
  event DeliveryMarkedFailed is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that could not be completed. Failure is terminal, and
        |unlike an issue it leaves food undelivered and paid for.
      }
    }
    failureReason: String(1,1000) with {
      briefly "Reason"
      described as {
        |Why the drop was abandoned. Separates causes the restaurant owes a
        |refund for from ones it does not — nobody home is not a bad cook.
      }
    }
    failedAt: TimeStamp with {
      briefly "Failed at"
      described as {
        |When the driver gave up. Bounds how long a driver is expected to
        |wait, which dispatch policy is written against.
      }
    }
  } with {
    briefly "Delivery marked failed"
    described as {
      |Emitted when a delivery is permanently marked as
      |failed.
    }
  }
  // ---- Rejection Events ----
  event CreateDeliveryRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that could not be created — most often an address
        |outside the restaurant's radius.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the creation was rejected.
      }
    }
  } with {
    briefly "Create delivery rejected"
    described as {
      |Emitted when a CreateDelivery command is rejected.
    }
  }
  event AssignDriverRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that could not be assigned, typically because no driver
        |is free.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the driver assignment was rejected.
      }
    }
  } with {
    briefly "Assign driver rejected"
    described as {
      |Emitted when an AssignDriver command is rejected.
    }
  }
  event DispatchDriverRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that could not be dispatched, typically because no
        |driver has been assigned to it.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the dispatch was rejected.
      }
    }
  } with {
    briefly "Dispatch driver rejected"
    described as {
      |Emitted when a DispatchDriver command is rejected.
    }
  }
  event RecordDeliveryLocationRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery whose location could not be recorded, typically because
        |it is not yet on the road.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the location recording was rejected.
      }
    }
  } with {
    briefly "Record delivery location rejected"
    described as {
      |Emitted when a RecordDeliveryLocation command is
      |rejected.
    }
  }
  event ConfirmDeliveryRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that could not be confirmed, typically because it was
        |already marked failed.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the confirmation was rejected.
      }
    }
  } with {
    briefly "Confirm delivery rejected"
    described as {
      |Emitted when a ConfirmDelivery command is rejected.
    }
  }
  event RecordDeliveryPaymentRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery whose doorstep payment could not be taken, typically
        |because the order was prepaid online.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the payment recording was rejected.
      }
    }
  } with {
    briefly "Record delivery payment rejected"
    described as {
      |Emitted when a RecordDeliveryPayment command is
      |rejected.
    }
  }
  event ReportDeliveryIssueRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery whose issue could not be logged, typically because the
        |drop is already closed.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the issue report was rejected.
      }
    }
  } with {
    briefly "Report delivery issue rejected"
    described as {
      |Emitted when a ReportDeliveryIssue command is
      |rejected.
    }
  }
  event FailDeliveryRejected is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery that could not be failed, typically because it was
        |already confirmed as delivered.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason the failure marking was rejected.
      }
    }
  } with {
    briefly "Fail delivery rejected"
    described as {
      |Emitted when a FailDelivery command is rejected.
    }
  }
  // ---- Query / Result ----
  query GetDeliveryOrder is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |Delivery to retrieve.
      }
    }
  } with {
    briefly "Get delivery order"
    described as {
      |Query a delivery order by its identifier.
    }
  }
  result DeliveryOrderResult is  {
    delivery: DeliveryBase with {
      briefly "Delivery"
      described as {
        |The requested delivery data.
      }
    }
  } with {
    briefly "Delivery order result"
    described as {
      |Result containing the requested delivery order data.
    }
  }
  // ---- State ----
  record DeliveryBase is  {
    deliveryId: DeliveryId with {
      briefly "ID"
      described as {
        |The delivery this state belongs to. Shared by every state record, so
        |a drop can be found whatever stage it has reached.
      }
    }
    sourceOnlineOrderId: String(1,50) with {
      briefly "Online order ID"
      described as {
        |Originating order.
      }
    }
    deliveryCustomerName: String(1,100) with {
      briefly "Customer name"
      described as {
        |Who the driver is delivering to, held in state so it survives into
        |every later stage of the drop.
      }
    }
    deliveryCustomerPhone: String(7,20) with {
      briefly "Customer phone"
      described as {
        |Contact phone.
      }
    }
    deliveryDestination: DeliveryAddress with {
      briefly "Destination"
      described as {
        |Delivery address.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the delivery was raised, held in state so the total elapsed
        |time can be read without replaying the log.
      }
    }
  } with {
    briefly "Delivery base data"
    described as {
      |Common fields shared by all delivery states.
    }
  }
  record PendingData is  {
    base: DeliveryBase with {
      briefly "Base"
      described as {
        |Common delivery fields.
      }
    }
  } with {
    briefly "Pending state data"
    described as {
      |State data for a delivery awaiting driver assignment.
    }
  }
  record DriverAssignedData is  {
    base: DeliveryBase with {
      briefly "Base"
      described as {
        |Common delivery fields.
      }
    }
    assignedDriverId: DriverId with {
      briefly "Driver ID"
      described as {
        |Which driver holds the drop. Present from assignment onward, and the
        |key dispatch uses to find everything one driver is carrying.
      }
    }
    assignedDriverName: String(1,100) with {
      briefly "Driver name"
      described as {
        |The driver's name, kept alongside the id so the guest can be told
        |who is coming without a second lookup.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned at"
      described as {
        |When the driver was assigned.
      }
    }
  } with {
    briefly "Driver assigned state data"
    described as {
      |State data for a delivery with an assigned driver
      |awaiting dispatch.
    }
  }
  record InTransitData is  {
    base: DeliveryBase with {
      briefly "Base"
      described as {
        |Common delivery fields.
      }
    }
    assignedDriverId: DriverId with {
      briefly "Driver ID"
      described as {
        |The driver now on the road with this drop.
      }
    }
    assignedDriverName: String(1,100) with {
      briefly "Driver name"
      described as {
        |The driver's name, carried into transit so live tracking can show it.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched at"
      described as {
        |When this driver left, held in state because the road clock is what
        |live tracking counts up from.
      }
    }
    lastKnownLocation: GeoLocation? with {
      briefly "Last location"
      described as {
        |Last recorded GPS location.
      }
    }
  } with {
    briefly "In transit state data"
    described as {
      |State data for a delivery in transit with GPS
      |tracking of the driver.
    }
  }
  record DeliveredData is  {
    base: DeliveryBase with {
      briefly "Base"
      described as {
        |Common delivery fields.
      }
    }
    assignedDriverId: DriverId with {
      briefly "Driver ID"
      described as {
        |Driver who completed the delivery.
      }
    }
    assignedDriverName: String(1,100) with {
      briefly "Driver name"
      described as {
        |Who completed the drop, retained after delivery so the guest's
        |feedback can be attributed.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed at"
      described as {
        |When the delivery was confirmed.
      }
    }
  } with {
    briefly "Delivered state data"
    described as {
      |State data for a completed delivery.
    }
  }
  record FailedData is  {
    base: DeliveryBase with {
      briefly "Base"
      described as {
        |Common delivery fields.
      }
    }
    failureReason: String(1,1000) with {
      briefly "Reason"
      described as {
        |Reason for delivery failure.
      }
    }
    failedAt: TimeStamp with {
      briefly "Failed at"
      described as {
        |When the delivery failed.
      }
    }
    lastDriverId: DriverId? with {
      briefly "Last driver"
      described as {
        |Last assigned driver before failure.
      }
    }
  } with {
    briefly "Failed state data"
    described as {
      |State data for a failed delivery.
    }
  }
  initial state Pending of record DeliveryOrder.PendingData is {
    initial handler PendingInitHandler is {
      on init is {
        yield event DeliveryCreated
      }
    } with {
      briefly "Pending init handler"
      described as {
        |Initializes the Pending state with default values.
      }
    }
    handler PendingHandler is {
      on command AssignDriver is {
        yield event DriverAssigned
        send event DriverAssigned to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DriverAssigned is {
        morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.DriverAssignedState with record DeliveryOrder.DriverAssignedData
        do "DriverAssigned event triggers push notification to
          driver via NotificationService streaming topology"
        set state DriverAssignedState to "base, assignedDriverId, assignedDriverName, assignedAt"
      }
      on command FailDelivery is {
        yield event DeliveryMarkedFailed
        send event DeliveryMarkedFailed to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DeliveryMarkedFailed is {
        morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.Failed with record DeliveryOrder.FailedData
        set state Failed to "base, failureReason, failedAt, lastDriverId = none"
      }
      on command CreateDelivery is {
        error "DeliveryOrder does not accept CreateDelivery in this state"
        send event CreateDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command DispatchDriver is {
        error "DeliveryOrder does not accept DispatchDriver in this state"
        send event DispatchDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryLocation is {
        error "DeliveryOrder does not accept RecordDeliveryLocation in this state"
        send event RecordDeliveryLocationRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ConfirmDelivery is {
        error "DeliveryOrder does not accept ConfirmDelivery in this state"
        send event ConfirmDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryPayment is {
        error "DeliveryOrder does not accept RecordDeliveryPayment in this state"
        send event RecordDeliveryPaymentRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ReportDeliveryIssue is {
        error "DeliveryOrder does not accept ReportDeliveryIssue in this state"
        send event ReportDeliveryIssueRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
    } with {
      briefly "Pending state handler"
      described as {
        |Handles commands valid in the Pending state.
        |AssignDriver advances the lifecycle. FailDelivery
        |moves to the terminal Failed state.
      }
    }
  } with {
    briefly "Delivery pending"
    described as {
      |Delivery has been created and is awaiting driver
      |assignment. Can also return to this state from
      |InTransit due to vehicle breakdown reassignment.
    }
  }
  state DriverAssignedState of record DeliveryOrder.DriverAssignedData is {
    initial handler DriverAssignedInitHandler is {
      on init is {
        yield event DriverAssigned
      }
    } with {
      briefly "DriverAssigned init handler"
      described as {
        |Initializes the DriverAssigned state with default values.
      }
    }
    handler DriverAssignedHandler is {
      on command DispatchDriver is {
        yield event DriverDispatched
        send event DriverDispatched to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DriverDispatched is {
        morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.InTransit with record DeliveryOrder.InTransitData
        do "DriverDispatched event triggers push notification to
          customer via NotificationService streaming topology"
        set state InTransit to "base, assignedDriverId, assignedDriverName, dispatchedAt, lastKnownLocation = none"
      }
      on command FailDelivery is {
        yield event DeliveryMarkedFailed
        send event DeliveryMarkedFailed to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DeliveryMarkedFailed is {
        morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.Failed with record DeliveryOrder.FailedData
      }
      on command CreateDelivery is {
        error "DeliveryOrder does not accept CreateDelivery in this state"
        send event CreateDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command AssignDriver is {
        error "DeliveryOrder does not accept AssignDriver in this state"
        send event AssignDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryLocation is {
        error "DeliveryOrder does not accept RecordDeliveryLocation in this state"
        send event RecordDeliveryLocationRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ConfirmDelivery is {
        error "DeliveryOrder does not accept ConfirmDelivery in this state"
        send event ConfirmDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryPayment is {
        error "DeliveryOrder does not accept RecordDeliveryPayment in this state"
        send event RecordDeliveryPaymentRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ReportDeliveryIssue is {
        error "DeliveryOrder does not accept ReportDeliveryIssue in this state"
        send event ReportDeliveryIssueRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
    } with {
      briefly "DriverAssigned state handler"
      described as {
        |Handles commands valid in the DriverAssigned state.
        |DispatchDriver advances the lifecycle. FailDelivery
        |moves to the terminal Failed state.
      }
    }
  } with {
    briefly "Driver assigned"
    described as {
      |A driver has been assigned and notified. Awaiting
      |dispatch.
    }
  }
  state InTransit of record DeliveryOrder.InTransitData is {
    initial handler InTransitInitHandler is {
      on init is {
        yield event DriverDispatched
      }
    } with {
      briefly "InTransit init handler"
      described as {
        |Initializes the InTransit state with default values.
      }
    }
    handler InTransitHandler is {
      on command RecordDeliveryLocation is {
        yield event DeliveryLocationRecorded
        send event DeliveryLocationRecorded to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DeliveryLocationRecorded is {
        set field DeliveryOrder.InTransit.lastKnownLocation to "driverLocation from event"
      }
      on command ConfirmDelivery is {
        yield event DeliveryConfirmed
        send event DeliveryConfirmed to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DeliveryConfirmed is {
        morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.Delivered with record DeliveryOrder.DeliveredData
        do "DeliveryConfirmed event triggers push notification
          to customer via NotificationService streaming topology"
        set state DeliveryOrder.Delivered to "base, assignedDriverId, assignedDriverName, confirmedAt"
      }
      on command RecordDeliveryPayment is {
        yield event DeliveryPaymentRecorded
        send event DeliveryPaymentRecorded to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DeliveryPaymentRecorded is {
        do "record tip and payment details"
      }
      on command ReportDeliveryIssue is {
        yield event DeliveryIssueReported
        send event DeliveryIssueReported to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DeliveryIssueReported is {
        match "issueType" {
          case "AddressNotFound" {
            tell command SendPushNotification to entity Restaurant.NotificationService
          }
          case "CustomerUnavailable" {
            tell command SendPushNotification to entity Restaurant.NotificationService
            do "schedule FailDelivery command after 10-minute
              timeout if no customer response"
          }
          case "FoodDamaged" {
            tell command SendPushNotification to entity Restaurant.NotificationService
            do "construct ReceiveTicket replacement order from
              DeliveryBase.sourceOnlineOrderId and send to
              Kitchen.KitchenTicket"
          }
          case "VehicleBreakdown" {
            morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.Pending with record DeliveryOrder.PendingData
            do "query available drivers by GeoLocation proximity
              excluding current driver"
          }
          case "TrafficDelay" {
            tell command SendPushNotification to entity Restaurant.NotificationService
          }
          default {
            tell command SendPushNotification to entity Restaurant.NotificationService
          }
        }
      }
      on command FailDelivery is {
        yield event DeliveryMarkedFailed
        send event DeliveryMarkedFailed to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on event DeliveryMarkedFailed is {
        morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.Failed with record DeliveryOrder.FailedData
      }
      on command CreateDelivery is {
        error "DeliveryOrder does not accept CreateDelivery in this state"
        send event CreateDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command AssignDriver is {
        error "DeliveryOrder does not accept AssignDriver in this state"
        send event AssignDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command DispatchDriver is {
        error "DeliveryOrder does not accept DispatchDriver in this state"
        send event DispatchDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
    } with {
      briefly "InTransit state handler"
      described as {
        |Handles commands valid in the InTransit state.
        |RecordDeliveryLocation updates GPS tracking.
        |ConfirmDelivery completes delivery. ReportDeliveryIssue
        |handles various issue types including VehicleBreakdown
        |which morphs back to Pending for driver reassignment.
        |FailDelivery moves to the terminal Failed state.
      }
    }
  } with {
    briefly "In transit"
    described as {
      |Driver has been dispatched and is en route. GPS
      |location updates are being tracked.
    }
  }
  state Delivered of record DeliveryOrder.DeliveredData is {
    initial handler DeliveredInitHandler is {
      on init is {
        yield event DeliveryConfirmed
      }
    } with {
      briefly "Delivered init handler"
      described as {
        |Initializes the Delivered state with default values.
      }
    }
    handler DeliveredHandler is {
      on command CreateDelivery is {
        error "DeliveryOrder does not accept CreateDelivery in this state"
        send event CreateDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command AssignDriver is {
        error "DeliveryOrder does not accept AssignDriver in this state"
        send event AssignDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command DispatchDriver is {
        error "DeliveryOrder does not accept DispatchDriver in this state"
        send event DispatchDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryLocation is {
        error "DeliveryOrder does not accept RecordDeliveryLocation in this state"
        send event RecordDeliveryLocationRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ConfirmDelivery is {
        error "DeliveryOrder does not accept ConfirmDelivery in this state"
        send event ConfirmDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryPayment is {
        error "DeliveryOrder does not accept RecordDeliveryPayment in this state"
        send event RecordDeliveryPaymentRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ReportDeliveryIssue is {
        error "DeliveryOrder does not accept ReportDeliveryIssue in this state"
        send event ReportDeliveryIssueRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command FailDelivery is {
        error "DeliveryOrder does not accept FailDelivery in this state"
        send event FailDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
    } with {
      briefly "Delivered state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Delivered"
    described as {
      |Delivery has been confirmed complete. Terminal state.
    }
  }
  state Failed of record DeliveryOrder.FailedData is {
    initial handler FailedInitHandler is {
      on init is {
        yield event DeliveryMarkedFailed
      }
    } with {
      briefly "Failed init handler"
      described as {
        |Initializes the Failed state with default values.
      }
    }
    handler FailedHandler is {
      on command CreateDelivery is {
        error "DeliveryOrder does not accept CreateDelivery in this state"
        send event CreateDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command AssignDriver is {
        error "DeliveryOrder does not accept AssignDriver in this state"
        send event AssignDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command DispatchDriver is {
        error "DeliveryOrder does not accept DispatchDriver in this state"
        send event DispatchDriverRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryLocation is {
        error "DeliveryOrder does not accept RecordDeliveryLocation in this state"
        send event RecordDeliveryLocationRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ConfirmDelivery is {
        error "DeliveryOrder does not accept ConfirmDelivery in this state"
        send event ConfirmDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command RecordDeliveryPayment is {
        error "DeliveryOrder does not accept RecordDeliveryPayment in this state"
        send event RecordDeliveryPaymentRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command ReportDeliveryIssue is {
        error "DeliveryOrder does not accept ReportDeliveryIssue in this state"
        send event ReportDeliveryIssueRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
      on command FailDelivery is {
        error "DeliveryOrder does not accept FailDelivery in this state"
        send event FailDeliveryRejected to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      }
    } with {
      briefly "Failed state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Delivery failed"
    described as {
      |Delivery could not be completed. Terminal state.
    }
  }
  handler DeliveryCreationHandler is {
    on command CreateDelivery is {
      yield event DeliveryCreated
      send event DeliveryCreated to outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents
      do "query available drivers by GeoLocation proximity to
        restaurant and select nearest with status = available"
    }
    on event DeliveryCreated is {
      morph entity Delivery.DeliveryOrder to state Delivery.DeliveryOrder.Pending with record DeliveryOrder.PendingData
      set state Pending to "base"
    }
    on query GetDeliveryOrder is {
      do "look up DeliveryOrder by GetDeliveryOrder.deliveryId"
      tell result DeliveryOrderResult to entity Delivery.DeliveryOrder
    } with {
      briefly "Get delivery order query handler"
    }
  } with {
    briefly "Delivery creation handler"
    described as {
      |Handles the initial CreateDelivery command when
      |the entity has no state yet, and the GetDeliveryOrder
      |query for retrieving delivery data.
    }
  }
} with {
  briefly "Delivery entity"
  described as {
    | Manages the lifecycle of a delivery from creation
    | through driver assignment, dispatch, GPS tracking,
    | confirmation, and issue reporting. State handlers
    | ensure commands are only valid in appropriate states,
    | and events are persisted before state transitions.
    | Designed for offline resilience so drivers can cache
    | details and report issues when connectivity resumes.
  }
}
