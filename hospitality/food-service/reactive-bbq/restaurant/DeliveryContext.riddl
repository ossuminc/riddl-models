// Delivery bounded context
context Delivery is {
  include "delivery-types.riddl"
  include "Delivery.riddl"
  processor DeliveryIntake as sink is {
    inlet IncomingDeliveryRequests is type DeliveryEvent    handler DeliveryIntakeHandler is {
      on event OnlineOrder.FulfillmentSelected is {
        do "construct CreateDelivery with new DeliveryId,
          sourceOnlineOrderId = event.onlineOrderId,
          deliveryCustomerName and deliveryCustomerPhone from the
          customer profile, deliveryDestination = event.deliveryAddress,
          requestedDeliveryTime = event.requestedTime"
        tell command DeliveryOrder.CreateDelivery to entity Delivery.DeliveryOrder
      }
      on other is {
        error "Unexpected message for sink DeliveryIntake"
      }
    } with {
      briefly "Delivery intake handler"
      described as {
        |Dispatches inbound delivery requests to the DeliveryOrder entity.
      }
    }
  } with {
    briefly "Delivery intake sink"
    described as {
      |The context boundary for delivery requests arriving from online
      |ordering. Without it the adaptor reached straight into the entity,
      |which hides the boundary inside whichever entity happens to be the
      |first target.
    }
  }
  repository DeliveryRepository is {
    inlet DeliveryRepositoryFromDeliveryOrder is type DeliveryOrderEvent    outlet DeliveryRepositoryResponses is type DeliveryOrder.DeliveryOrderResult
    record StoredDeliveryOrder is  {
      deliveryOrderId: UUID with {
        briefly "deliveryOrderId"
        described as {
          |The deliveryOrderId column of the stored deliveryOrder row.
        }
      }
      deliveryId: DeliveryId with {
        briefly "deliveryId"
        described as {
          |The deliveryId column of the stored deliveryOrder row.
        }
      }
    } with {
      briefly "Stored deliveryOrder row"
      described as {
        |The persistence shape of deliveryOrder data as this repository stores it.
      }
    }
    schema DeliverySchema is relational
      of deliveries as type StoredDeliveryOrder
        index on field StoredDeliveryOrder.deliveryId
 with {
      briefly "Delivery data schema"
      described as {
        |Relational schema for persisting delivery state
        |with index on delivery identifier.
      }
    }
    command PersistDeliveryCreated is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryCreated"
      described as {
        |Instructs this repository to apply DeliveryCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverAssigned is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DriverAssigned"
      described as {
        |Instructs this repository to apply DriverAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverDispatched is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DriverDispatched"
      described as {
        |Instructs this repository to apply DriverDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryLocationRecorded is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryLocationRecorded"
      described as {
        |Instructs this repository to apply DeliveryLocationRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryConfirmed is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryConfirmed"
      described as {
        |Instructs this repository to apply DeliveryConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryPaymentRecorded is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryPaymentRecorded"
      described as {
        |Instructs this repository to apply DeliveryPaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryIssueReported is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryIssueReported"
      described as {
        |Instructs this repository to apply DeliveryIssueReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryMarkedFailed is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryMarkedFailed"
      described as {
        |Instructs this repository to apply DeliveryMarkedFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler DeliveryPersistence is {
      on command PersistDeliveryCreated is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DeliveryCreated"
        do "insert row into DeliverySchema.deliveries with
          deliveryId, sourceOnlineOrderId,
          deliveryCustomerName, deliveryCustomerPhone,
          deliveryDestination, createdAt"
      }
      on command PersistDriverAssigned is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DriverAssigned"
        do "update DeliverySchema.deliveries set
          assignedDriverId = driverId, assignedDriverName =
          driverName where deliveryId matches"
      }
      on command PersistDriverDispatched is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DriverDispatched"
        do "update DeliverySchema.deliveries set
          dispatchedAt = dispatchedAt where deliveryId
          matches"
      }
      on command PersistDeliveryLocationRecorded is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DeliveryLocationRecorded"
        do "update DeliverySchema.deliveries set
          lastKnownLocation = driverLocation where
          deliveryId matches"
      }
      on command PersistDeliveryConfirmed is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DeliveryConfirmed"
        do "update DeliverySchema.deliveries set confirmedAt
          = confirmedAt where deliveryId matches"
      }
      on command PersistDeliveryPaymentRecorded is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DeliveryPaymentRecorded"
        do "update DeliverySchema.deliveries set deliveryTip
          = deliveryTip where deliveryId matches"
      }
      on command PersistDeliveryIssueReported is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DeliveryIssueReported"
        do "update DeliverySchema.deliveries with issueType
          and issueDescription where deliveryId matches"
      }
      on command PersistDeliveryMarkedFailed is {
        set field StoredDeliveryOrder.deliveryId to "as recorded by DeliveryMarkedFailed"
        do "update DeliverySchema.deliveries set
          failureReason = failureReason, failedAt =
          failedAt where deliveryId matches"
      }
    } with {
      briefly "Delivery persistence"
      described as {
        |Persists delivery events to the deliveries table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Delivery repository"
    described as {
      |Stores and retrieves delivery data.
    }
  }
  processor DeliveryOrderEventSource as source is {
    outlet DeliveryOrderEvents is type DeliveryEvent
    handler DeliveryOrderEventEmitter is {
      on init is {
        tell command InitializeDeliveryOrder to entity Delivery.DeliveryOrder
      }
      on other is {
        error "Unexpected message for source DeliveryOrderEventSource"
      }
      on event DeliveryOrder.DeliveryCreated is {
        send event DeliveryOrder.DeliveryCreated to outlet DeliveryOrderEvents
      }
      on event DeliveryOrder.DriverAssigned is {
        send event DeliveryOrder.DriverAssigned to outlet DeliveryOrderEvents
      }
      on event DeliveryOrder.DriverDispatched is {
        send event DeliveryOrder.DriverDispatched to outlet DeliveryOrderEvents
      }
      on event DeliveryOrder.DeliveryConfirmed is {
        send event DeliveryOrder.DeliveryConfirmed to outlet DeliveryOrderEvents
      }
      on event DeliveryOrder.DeliveryMarkedFailed is {
        send event DeliveryOrder.DeliveryMarkedFailed to outlet DeliveryOrderEvents
      }
    } with {
      briefly "Delivery order event emitter"
      described as {
        |Emits delivery lifecycle events.
      }
    }
  } with {
    briefly "Delivery order event source"
    described as {
      |Publishes delivery entity events.
    }
  }
  adaptor FromOnlineOrdering from context Restaurant.OnlineOrdering is { 
    handler OnlineDeliveryIntake is {
      on event Restaurant.OnlineOrdering.OnlineOrder.FulfillmentSelected is {
        when prompt("event.fulfillmentType is DeliveryFulfillment") then
          do "construct CreateDelivery with new DeliveryId,
            sourceOnlineOrderId = event.onlineOrderId,
            deliveryCustomerName from customer profile,
            deliveryCustomerPhone from customer profile,
            deliveryDestination = event.deliveryAddress,
            requestedDeliveryTime = event.requestedTime"
          tell command CreateDelivery to entity Delivery.DeliveryOrder
        end
      }
      on other is {
        error "Unexpected message for adaptor FromOnlineOrdering"
      }
    } with {
      briefly "Online delivery intake"
      described as {
        |Creates deliveries from online orders when delivery
        |fulfillment is selected.
      }
    }
  } with {
    briefly "Online ordering adaptor"
    described as {
      |Receives delivery-fulfillment orders from online ordering.
    }
  }
  connector DeliveryOrderStorage is from outlet Delivery.DeliveryOrder.DeliveryOrderEvents2 to inlet Delivery.DeliveryRepository.DeliveryRepositoryFromDeliveryOrder with {
    briefly "The DeliveryOrder projection on its way to storage"
  }
} with {
  briefly "Delivery context"
  described as {
    | Manages delivery driver dispatch, GPS tracking, and
    | offline-resilient delivery operations. Drivers can
    | cache order details and report issues when connectivity
    | resumes. Decoupled from online ordering via adaptors.
  }
}
