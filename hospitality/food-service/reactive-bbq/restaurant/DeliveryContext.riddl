// Delivery bounded context
context Delivery as router is {
  inlet OnlineToDeliveryIn is type DeliveryEvent
  outlet OnlineToDeliveryOut is type DeliveryEvent
  inlet DeliveryOrderCommandStreamIn is type DeliveryOrderCommand
  outlet DeliveryOrderCommandStreamOut is type DeliveryOrderCommand
  inlet DeliveryToOnlineIn is type DeliveryEvent
  outlet DeliveryToOnlineOut is type DeliveryEvent
  inlet DeliveryOrderResultStreamIn is type DeliveryOrder.DeliveryOrderResult
  outlet DeliveryOrderResultStreamOut is type DeliveryOrder.DeliveryOrderResult
  handler DeliveryBoundary is {
    on deliveryCreated: event DeliveryOrder.DeliveryCreated is {
      send deliveryCreated to outlet Delivery.OnlineToDeliveryOut
      send deliveryCreated to outlet Delivery.DeliveryToOnlineOut
    }
    on driverAssigned: event DeliveryOrder.DriverAssigned is {
      send driverAssigned to outlet Delivery.OnlineToDeliveryOut
      send driverAssigned to outlet Delivery.DeliveryToOnlineOut
    }
    on driverDispatched: event DeliveryOrder.DriverDispatched is {
      send driverDispatched to outlet Delivery.OnlineToDeliveryOut
      send driverDispatched to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryLocationRecorded: event DeliveryOrder.DeliveryLocationRecorded is {
      send deliveryLocationRecorded to outlet Delivery.OnlineToDeliveryOut
      send deliveryLocationRecorded to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryConfirmed: event DeliveryOrder.DeliveryConfirmed is {
      send deliveryConfirmed to outlet Delivery.OnlineToDeliveryOut
      send deliveryConfirmed to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryPaymentRecorded: event DeliveryOrder.DeliveryPaymentRecorded is {
      send deliveryPaymentRecorded to outlet Delivery.OnlineToDeliveryOut
      send deliveryPaymentRecorded to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryIssueReported: event DeliveryOrder.DeliveryIssueReported is {
      send deliveryIssueReported to outlet Delivery.OnlineToDeliveryOut
      send deliveryIssueReported to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryMarkedFailed: event DeliveryOrder.DeliveryMarkedFailed is {
      send deliveryMarkedFailed to outlet Delivery.OnlineToDeliveryOut
      send deliveryMarkedFailed to outlet Delivery.DeliveryToOnlineOut
    }
    on createDelivery: command DeliveryOrder.CreateDelivery is {
      send createDelivery to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on assignDriver: command DeliveryOrder.AssignDriver is {
      send assignDriver to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on dispatchDriver: command DeliveryOrder.DispatchDriver is {
      send dispatchDriver to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on recordDeliveryLocation: command DeliveryOrder.RecordDeliveryLocation is {
      send recordDeliveryLocation to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on confirmDelivery: command DeliveryOrder.ConfirmDelivery is {
      send confirmDelivery to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on recordDeliveryPayment: command DeliveryOrder.RecordDeliveryPayment is {
      send recordDeliveryPayment to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on reportDeliveryIssue: command DeliveryOrder.ReportDeliveryIssue is {
      send reportDeliveryIssue to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on failDelivery: command DeliveryOrder.FailDelivery is {
      send failDelivery to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on deliveryOrderResult: result DeliveryOrder.DeliveryOrderResult is {
      send deliveryOrderResult to outlet Delivery.DeliveryOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the Delivery boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'OnlineToDelivery Intake' is from outlet Delivery.OnlineToDeliveryOut to inlet Delivery.DeliveryIntake.IncomingDeliveryRequests
  connector 'DeliveryOrderCommand Stream Intake' is from outlet Delivery.DeliveryOrderCommandStreamOut to inlet Delivery.DeliveryOrder.DeliveryOrderCommands
  connector 'DeliveryToOnline Egress' is from outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents to inlet Delivery.DeliveryToOnlineIn
  connector 'DeliveryOrderResult Stream Egress' is from outlet Delivery.DeliveryRepository.DeliveryRepositoryResponses to inlet Delivery.DeliveryOrderResultStreamIn
  include "delivery-types.riddl"
  include "Delivery.riddl"
  processor DeliveryIntake as sink is {
    inlet IncomingDeliveryRequests is type DeliveryEvent    handler DeliveryIntakeHandler is {
      on event OnlineOrder.FulfillmentSelected is {
        do "construct CreateDelivery with new DeliveryId,
          sourceOnlineOrderId = event.onlineOrderId,
          deliveryCustomerName and deliveryCustomerPhone from the
          customer profile, deliveryDestination = event.deliveryAddress,
          requestedDeliveryTime = event.requestedTime"
        let createDelivery: type DeliveryOrder.CreateDelivery = prompt("the create delivery that results from fulfillment selected")
        tell createDelivery to entity Delivery.DeliveryOrder
      }
      on other is {
        error "Unexpected message for sink DeliveryIntake"
      }
    } with {
      briefly "Delivery intake handler"
      described as {
        |Dispatches inbound delivery requests to the DeliveryOrder entity.
      }
    }
  } with {
    briefly "Delivery intake sink"
    described as {
      |The context boundary for delivery requests arriving from online
      |ordering. Without it the adaptor reached straight into the entity,
      |which hides the boundary inside whichever entity happens to be the
      |first target.
    }
  }
  repository DeliveryRepository as flow is {
    inlet DeliveryRepositoryFromDeliveryOrder is type DeliveryOrderEvent    outlet DeliveryRepositoryResponses is type DeliveryOrder.DeliveryOrderResult
    record StoredDeliveryOrder is  {
      deliveryOrderId: UUID with {
        briefly "deliveryOrderId"
        described as {
          |The deliveryOrderId column of the stored deliveryOrder row.
        }
      }
      deliveryId: DeliveryId with {
        briefly "deliveryId"
        described as {
          |The deliveryId column of the stored deliveryOrder row.
        }
      }
    } with {
      briefly "Stored deliveryOrder row"
      described as {
        |The persistence shape of deliveryOrder data as this repository stores it.
      }
    }
    schema DeliverySchema is relational
      of deliveries as type StoredDeliveryOrder
        index on field StoredDeliveryOrder.deliveryId
 with {
      briefly "Delivery data schema"
      described as {
        |Relational schema for persisting delivery state
        |with index on delivery identifier.
      }
    }
    command PersistDeliveryCreated is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryCreated"
      described as {
        |Instructs this repository to apply DeliveryCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverAssigned is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DriverAssigned"
      described as {
        |Instructs this repository to apply DriverAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverDispatched is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DriverDispatched"
      described as {
        |Instructs this repository to apply DriverDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryLocationRecorded is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryLocationRecorded"
      described as {
        |Instructs this repository to apply DeliveryLocationRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryConfirmed is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryConfirmed"
      described as {
        |Instructs this repository to apply DeliveryConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryPaymentRecorded is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryPaymentRecorded"
      described as {
        |Instructs this repository to apply DeliveryPaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryIssueReported is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryIssueReported"
      described as {
        |Instructs this repository to apply DeliveryIssueReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryMarkedFailed is  {
      deliveryOrderId: UUID with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DeliveryMarkedFailed"
      described as {
        |Instructs this repository to apply DeliveryMarkedFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler DeliveryPersistence is {
      on command PersistDeliveryCreated is {
        do "insert row into DeliverySchema.deliveries with
          deliveryId, sourceOnlineOrderId,
          deliveryCustomerName, deliveryCustomerPhone,
          deliveryDestination, createdAt"
      }
      on command PersistDriverAssigned is {
        do "update DeliverySchema.deliveries set
          assignedDriverId = driverId, assignedDriverName =
          driverName where deliveryId matches"
      }
      on command PersistDriverDispatched is {
        do "update DeliverySchema.deliveries set
          dispatchedAt = dispatchedAt where deliveryId
          matches"
      }
      on command PersistDeliveryLocationRecorded is {
        do "update DeliverySchema.deliveries set
          lastKnownLocation = driverLocation where
          deliveryId matches"
      }
      on command PersistDeliveryConfirmed is {
        do "update DeliverySchema.deliveries set confirmedAt
          = confirmedAt where deliveryId matches"
      }
      on command PersistDeliveryPaymentRecorded is {
        do "update DeliverySchema.deliveries set deliveryTip
          = deliveryTip where deliveryId matches"
      }
      on command PersistDeliveryIssueReported is {
        do "update DeliverySchema.deliveries with issueType
          and issueDescription where deliveryId matches"
      }
      on command PersistDeliveryMarkedFailed is {
        do "update DeliverySchema.deliveries set
          failureReason = failureReason, failedAt =
          failedAt where deliveryId matches"
      }
    } with {
      briefly "Delivery persistence"
      described as {
        |Persists delivery events to the deliveries table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Delivery repository"
    described as {
      |Stores and retrieves delivery data.
    }
  }
  processor DeliveryOrderEventSource as source is {
    outlet DeliveryOrderEvents is type DeliveryEvent
    handler DeliveryOrderEventEmitter is {
      on other is {
        error "Unexpected message for source DeliveryOrderEventSource"
      }
      on deliveryCreated: event DeliveryOrder.DeliveryCreated is {
        send deliveryCreated to outlet DeliveryOrderEvents
      }
      on driverAssigned: event DeliveryOrder.DriverAssigned is {
        send driverAssigned to outlet DeliveryOrderEvents
      }
      on driverDispatched: event DeliveryOrder.DriverDispatched is {
        send driverDispatched to outlet DeliveryOrderEvents
      }
      on deliveryConfirmed: event DeliveryOrder.DeliveryConfirmed is {
        send deliveryConfirmed to outlet DeliveryOrderEvents
      }
      on deliveryMarkedFailed: event DeliveryOrder.DeliveryMarkedFailed is {
        send deliveryMarkedFailed to outlet DeliveryOrderEvents
      }
    } with {
      briefly "Delivery order event emitter"
      described as {
        |Emits delivery lifecycle events.
      }
    }
  } with {
    briefly "Delivery order event source"
    described as {
      |Publishes delivery entity events.
    }
  }
  adaptor ToNotificationService to context Restaurant.NotificationService is { 
    handler CustomerNotification is {
      on deliveryIssueReported: event DeliveryOrder.DeliveryIssueReported is {
        match "issueType" {
          case "VehicleBreakdown" {
            do "no customer notification: the delivery is reassigned to
              another driver and the customer sees no change"
          }
          default {
            let sendPushNotification: type Restaurant.NotificationService.SendPushNotification = prompt("the push notification telling the customer what happened to their delivery and what to expect next")
            tell sendPushNotification to entity Restaurant.NotificationService
          }
        }
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "Customer notification"
      described as {
        |Translates a delivery issue into a push notification for the
        |customer. Every issue type notifies except a vehicle breakdown,
        |which is resolved by reassigning the delivery and is invisible to
        |the customer.
      }
    }
  } with {
    briefly "Notification service adaptor"
    described as {
      |The outbound boundary to the external notification service. The
      |DeliveryOrder entity records what went wrong; deciding that the
      |customer should hear about it, and saying it in the notification
      |service's language, belongs here rather than inside the aggregate.
    }
  }
  adaptor FromOnlineOrdering from context Restaurant.OnlineOrdering is { 
    handler OnlineDeliveryIntake is {
      on event Restaurant.OnlineOrdering.OnlineOrder.FulfillmentSelected is {
        when prompt("event.fulfillmentType is DeliveryFulfillment") then
          do "construct CreateDelivery with new DeliveryId,
            sourceOnlineOrderId = event.onlineOrderId,
            deliveryCustomerName from customer profile,
            deliveryCustomerPhone from customer profile,
            deliveryDestination = event.deliveryAddress,
            requestedDeliveryTime = event.requestedTime"
          let createDelivery: type CreateDelivery = prompt("the create delivery that results from fulfillment selected")
          tell createDelivery to entity Delivery.DeliveryOrder
        end
      }
      on other is {
        error "Unexpected message for adaptor FromOnlineOrdering"
      }
    } with {
      briefly "Online delivery intake"
      described as {
        |Creates deliveries from online orders when delivery
        |fulfillment is selected.
      }
    }
  } with {
    briefly "Online ordering adaptor"
    described as {
      |Receives delivery-fulfillment orders from online ordering.
    }
  }
  connector 'DeliveryOrder Storage' is from outlet Delivery.DeliveryOrder.DeliveryOrderEvents2 to inlet Delivery.DeliveryRepository.DeliveryRepositoryFromDeliveryOrder with {
    briefly "The DeliveryOrder projection on its way to storage"
  }
} with {
  briefly "Delivery context"
  described as {
    | Manages delivery driver dispatch, GPS tracking, and
    | offline-resilient delivery operations. Drivers can
    | cache order details and report issues when connectivity
    | resumes. Decoupled from online ordering via adaptors.
  }
}
