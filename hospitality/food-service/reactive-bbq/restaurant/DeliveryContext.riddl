// Delivery bounded context
context Delivery as router is {
  connector 'FromOnlineOrdering To Delivery' is from outlet Delivery.FromOnlineOrdering.FromOnlineOrderingToDelivery to inlet Delivery.DeliveryFromFromOnlineOrdering  inlet DeliveryFromFromOnlineOrdering is command CreateDelivery  inlet DeliveryOrderCommandStreamIn is type DeliveryOrderCommand  outlet DeliveryOrderCommandStreamOut is type DeliveryOrderCommand
  inlet DeliveryToOnlineIn is type DeliveryEvent  outlet DeliveryToOnlineOut is type DeliveryEvent
  inlet DeliveryOrderResultStreamIn is result DeliveryOrder.DeliveryOrderResult  outlet DeliveryOrderResultStreamOut is result DeliveryOrder.DeliveryOrderResult
  handler DeliveryBoundary is {
    on deliveryCreated: event DeliveryOrder.DeliveryCreated is {
      send deliveryCreated to outlet Delivery.DeliveryToOnlineOut
    }
    on driverAssigned: event DeliveryOrder.DriverAssigned is {
      send driverAssigned to outlet Delivery.DeliveryToOnlineOut
    }
    on driverDispatched: event DeliveryOrder.DriverDispatched is {
      send driverDispatched to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryLocationRecorded: event DeliveryOrder.DeliveryLocationRecorded is {
      send deliveryLocationRecorded to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryConfirmed: event DeliveryOrder.DeliveryConfirmed is {
      send deliveryConfirmed to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryPaymentRecorded: event DeliveryOrder.DeliveryPaymentRecorded is {
      send deliveryPaymentRecorded to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryIssueReported: event DeliveryOrder.DeliveryIssueReported is {
      send deliveryIssueReported to outlet Delivery.DeliveryToOnlineOut
    }
    on deliveryMarkedFailed: event DeliveryOrder.DeliveryMarkedFailed is {
      send deliveryMarkedFailed to outlet Delivery.DeliveryToOnlineOut
    }
    on createDelivery: command DeliveryOrder.CreateDelivery is {
      forward createDelivery to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on assignDriver: command DeliveryOrder.AssignDriver is {
      forward assignDriver to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on dispatchDriver: command DeliveryOrder.DispatchDriver is {
      forward dispatchDriver to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on recordDeliveryLocation: command DeliveryOrder.RecordDeliveryLocation is {
      forward recordDeliveryLocation to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on confirmDelivery: command DeliveryOrder.ConfirmDelivery is {
      forward confirmDelivery to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on recordDeliveryPayment: command DeliveryOrder.RecordDeliveryPayment is {
      forward recordDeliveryPayment to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on reportDeliveryIssue: command DeliveryOrder.ReportDeliveryIssue is {
      forward reportDeliveryIssue to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on failDelivery: command DeliveryOrder.FailDelivery is {
      forward failDelivery to outlet Delivery.DeliveryOrderCommandStreamOut
    }
    on deliveryOrderResult: result DeliveryOrder.DeliveryOrderResult is {
      send deliveryOrderResult to outlet Delivery.DeliveryOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the Delivery boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'DeliveryProjection Storage' is from outlet Delivery.DeliveryProjection.DeliveryProjectionToRepository to inlet Delivery.DeliveryRepository.DeliveryRepositoryFromDeliveryProjection with {
    briefly "DeliveryProjection commands on their way to DeliveryRepository"
    described as {
      |Carries what leaves Delivery.DeliveryProjection.DeliveryProjectionToRepository to Delivery.DeliveryRepository.DeliveryRepositoryFromDeliveryProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'DeliveryOrderCommand Stream Intake' is from outlet Delivery.DeliveryOrderCommandStreamOut to inlet Delivery.DeliveryOrder.DeliveryOrderCommands  connector 'DeliveryToOnline Egress' is from outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEvents to inlet Delivery.DeliveryToOnlineIn  connector 'DeliveryOrderResult Stream Egress' is from outlet Delivery.DeliveryRepository.DeliveryRepositoryResponses to inlet Delivery.DeliveryOrderResultStreamIn  include "delivery-types.riddl"
  include "Delivery.riddl"
  type DeliveryRepositoryCommand is one of {
    Delivery.DeliveryRepository.PersistDeliveryCreated or Delivery.DeliveryRepository.PersistDriverAssigned or Delivery.DeliveryRepository.PersistDriverDispatched or Delivery.DeliveryRepository.PersistDeliveryLocationRecorded or Delivery.DeliveryRepository.PersistDeliveryConfirmed or Delivery.DeliveryRepository.PersistDeliveryPaymentRecorded or Delivery.DeliveryRepository.PersistDeliveryIssueReported or Delivery.DeliveryRepository.PersistDeliveryMarkedFailed
  } with {
    briefly "Anything that writes the DeliveryRepository"
    described as {
      |The persistence commands DeliveryRepository accepts. Entity events never reach
      |it directly; DeliveryProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository DeliveryRepository as flow is {
    inlet DeliveryRepositoryFromDeliveryProjection is type DeliveryRepositoryCommand    outlet DeliveryRepositoryResponses is result DeliveryOrder.DeliveryOrderResult
    record StoredDeliveryOrder is {
      deliveryOrderId: DeliveryId with {
        briefly "deliveryOrderId"
        described as {
          |The deliveryOrderId column of the stored deliveryOrder row.
        }
      }
      deliveryId: DeliveryId with {
        briefly "deliveryId"
        described as {
          |The deliveryId column of the stored deliveryOrder row.
        }
      }
      sourceOnlineOrderId: String(1,50) with {
        briefly "Source online order id"
        described as {
          |The row's source online order id, as the persisting projector last wrote it.
        }
      }
      deliveryCustomerName: String(1,100) with {
        briefly "Delivery customer name"
        described as {
          |The row's delivery customer name, as the persisting projector last wrote it.
        }
      }
      deliveryCustomerPhone: String(7,20) with {
        briefly "Delivery customer phone"
        described as {
          |The row's delivery customer phone, as the persisting projector last wrote it.
        }
      }
      deliveryDestination: DeliveryAddress with {
        briefly "Delivery destination"
        described as {
          |The row's delivery destination, as the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp with {
        briefly "Created at"
        described as {
          |The row's created at, as the persisting projector last wrote it.
        }
      }
      assignedDriverId: DriverId? with {
        briefly "Assigned driver id"
        described as {
          |The row's assigned driver id, as the persisting projector last wrote it.
        }
      }
      assignedDriverName: String(1,100)? with {
        briefly "Assigned driver name"
        described as {
          |The row's assigned driver name, as the persisting projector last wrote it.
        }
      }
      actualDispatchedAt: TimeStamp? with {
        briefly "Actual dispatched at"
        described as {
          |The row's actual dispatched at, as the persisting projector last wrote it.
        }
      }
      lastKnownLocation: GeoLocation? with {
        briefly "Last known location"
        described as {
          |The row's last known location, as the persisting projector last wrote it.
        }
      }
      actualConfirmedAt: TimeStamp? with {
        briefly "Actual confirmed at"
        described as {
          |The row's actual confirmed at, as the persisting projector last wrote it.
        }
      }
      deliveryTip: Decimal(8,2)? with {
        briefly "Delivery tip"
        described as {
          |The row's delivery tip, as the persisting projector last wrote it.
        }
      }
      actualIssueType: DeliveryIssueType? with {
        briefly "Actual issue type"
        described as {
          |The row's actual issue type, as the persisting projector last wrote it.
        }
      }
      actualIssueDescription: String(1,1000)? with {
        briefly "Actual issue description"
        described as {
          |The row's actual issue description, as the persisting projector last wrote it.
        }
      }
      actualFailureReason: String(1,1000)? with {
        briefly "Actual failure reason"
        described as {
          |The row's actual failure reason, as the persisting projector last wrote it.
        }
      }
      actualFailedAt: TimeStamp? with {
        briefly "Actual failed at"
        described as {
          |The row's actual failed at, as the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored deliveryOrder row"
      described as {
        |The persistence shape of deliveryOrder data as this repository stores it.
      }
    }
    schema DeliverySchema is relational
      of deliveries as record StoredDeliveryOrder
        key on field StoredDeliveryOrder.deliveryOrderId
        index on field StoredDeliveryOrder.deliveryId
 with {
      briefly "Delivery data schema"
      described as {
        |Relational schema for persisting delivery state
        |with index on delivery identifier.
      }
    }
    command PersistDeliveryCreated is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      deliveryId: DeliveryId with {
        briefly "Delivery id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      sourceOnlineOrderId: String(1,50) with {
        briefly "Source online order id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      deliveryCustomerName: String(1,100) with {
        briefly "Delivery customer name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      deliveryCustomerPhone: String(7,20) with {
        briefly "Delivery customer phone"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      deliveryDestination: DeliveryAddress with {
        briefly "Delivery destination"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeliveryCreated"
      described as {
        |Instructs this repository to apply DeliveryCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverAssigned is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      driverId: DriverId with {
        briefly "Driver id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      driverName: String(1,100) with {
        briefly "Driver name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DriverAssigned"
      described as {
        |Instructs this repository to apply DriverAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDriverDispatched is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      dispatchedAt: TimeStamp with {
        briefly "Dispatched at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DriverDispatched"
      described as {
        |Instructs this repository to apply DriverDispatched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryLocationRecorded is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      driverLocation: GeoLocation with {
        briefly "Driver location"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeliveryLocationRecorded"
      described as {
        |Instructs this repository to apply DeliveryLocationRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryConfirmed is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      confirmedAt: TimeStamp with {
        briefly "Confirmed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeliveryConfirmed"
      described as {
        |Instructs this repository to apply DeliveryConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryPaymentRecorded is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      deliveryTip: Decimal(8,2)? with {
        briefly "Delivery tip"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeliveryPaymentRecorded"
      described as {
        |Instructs this repository to apply DeliveryPaymentRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryIssueReported is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      issueType: DeliveryIssueType with {
        briefly "Issue type"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      issueDescription: String(1,1000) with {
        briefly "Issue description"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeliveryIssueReported"
      described as {
        |Instructs this repository to apply DeliveryIssueReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryMarkedFailed is {
      deliveryOrderId: DeliveryId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      failureReason: String(1,1000) with {
        briefly "Failure reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      failedAt: TimeStamp with {
        briefly "Failed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DeliveryMarkedFailed"
      described as {
        |Instructs this repository to apply DeliveryMarkedFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler DeliveryPersistence is {
      on persistDeliveryCreated: command PersistDeliveryCreated is {
        store record StoredDeliveryOrder(deliveryOrderId = persistDeliveryCreated.deliveryOrderId, deliveryId = persistDeliveryCreated.deliveryId, sourceOnlineOrderId = persistDeliveryCreated.sourceOnlineOrderId, deliveryCustomerName = persistDeliveryCreated.deliveryCustomerName, deliveryCustomerPhone = persistDeliveryCreated.deliveryCustomerPhone, deliveryDestination = persistDeliveryCreated.deliveryDestination, createdAt = persistDeliveryCreated.createdAt, actualConfirmedAt = prompt("the actualConfirmedAt of this row"), actualDispatchedAt = prompt("the actualDispatchedAt of this row"), actualFailedAt = prompt("the actualFailedAt of this row"), actualFailureReason = prompt("the actualFailureReason of this row"), actualIssueDescription = prompt("the actualIssueDescription of this row"), actualIssueType = prompt("the actualIssueType of this row"), assignedDriverId = prompt("the assignedDriverId of this row"), assignedDriverName = prompt("the assignedDriverName of this row"), deliveryTip = prompt("the deliveryTip of this row"), lastKnownLocation = prompt("the lastKnownLocation of this row")) in DeliverySchema.deliveries
      }
      on persistDriverAssigned: command PersistDriverAssigned is {
        update DeliverySchema.deliveries set assignedDriverId = persistDriverAssigned.driverId, assignedDriverName = persistDriverAssigned.driverName where deliveryOrderId == persistDriverAssigned.deliveryOrderId
      }
      on persistDriverDispatched: command PersistDriverDispatched is {
        update DeliverySchema.deliveries set actualDispatchedAt = persistDriverDispatched.dispatchedAt where deliveryOrderId == persistDriverDispatched.deliveryOrderId
      }
      on persistDeliveryLocationRecorded: command PersistDeliveryLocationRecorded is {
        update DeliverySchema.deliveries set lastKnownLocation = persistDeliveryLocationRecorded.driverLocation where deliveryOrderId == persistDeliveryLocationRecorded.deliveryOrderId
      }
      on persistDeliveryConfirmed: command PersistDeliveryConfirmed is {
        update DeliverySchema.deliveries set actualConfirmedAt = persistDeliveryConfirmed.confirmedAt where deliveryOrderId == persistDeliveryConfirmed.deliveryOrderId
      }
      on persistDeliveryPaymentRecorded: command PersistDeliveryPaymentRecorded is {
        update DeliverySchema.deliveries set deliveryTip = persistDeliveryPaymentRecorded.deliveryTip where deliveryOrderId == persistDeliveryPaymentRecorded.deliveryOrderId
      }
      on persistDeliveryIssueReported: command PersistDeliveryIssueReported is {
        update DeliverySchema.deliveries set actualIssueType = persistDeliveryIssueReported.issueType, actualIssueDescription = persistDeliveryIssueReported.issueDescription where deliveryOrderId == persistDeliveryIssueReported.deliveryOrderId
      }
      on persistDeliveryMarkedFailed: command PersistDeliveryMarkedFailed is {
        update DeliverySchema.deliveries set actualFailureReason = persistDeliveryMarkedFailed.failureReason, actualFailedAt = persistDeliveryMarkedFailed.failedAt where deliveryOrderId == persistDeliveryMarkedFailed.deliveryOrderId
      }
    } with {
      briefly "Delivery persistence"
      described as {
        |Persists delivery events to the deliveries table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Delivery repository"
    described as {
      |Stores and retrieves delivery data.
    }
  }
  projector DeliveryProjection as flow is {
    updates repository Delivery.DeliveryRepository
    inlet DeliveryProjectionFromDelivery is type DeliveryOrderEvent    outlet DeliveryProjectionToRepository is type DeliveryRepositoryCommand
    handler DeliveryProjectionHandler is {
      on deliveryCreated: event DeliveryOrder.DeliveryCreated is {
        tell command Delivery.DeliveryRepository.PersistDeliveryCreated(deliveryOrderId = deliveryCreated.deliveryId, deliveryId = deliveryCreated.deliveryId, sourceOnlineOrderId = deliveryCreated.sourceOnlineOrderId, deliveryCustomerName = deliveryCreated.deliveryCustomerName, deliveryCustomerPhone = deliveryCreated.deliveryCustomerPhone, deliveryDestination = deliveryCreated.deliveryDestination, createdAt = deliveryCreated.createdAt) to repository Delivery.DeliveryRepository
      }
      on driverAssigned: event DeliveryOrder.DriverAssigned is {
        tell command Delivery.DeliveryRepository.PersistDriverAssigned(deliveryOrderId = driverAssigned.deliveryId, driverId = driverAssigned.driverId, driverName = driverAssigned.driverName) to repository Delivery.DeliveryRepository
      }
      on driverDispatched: event DeliveryOrder.DriverDispatched is {
        tell command Delivery.DeliveryRepository.PersistDriverDispatched(deliveryOrderId = driverDispatched.deliveryId, dispatchedAt = driverDispatched.dispatchedAt) to repository Delivery.DeliveryRepository
      }
      on deliveryLocationRecorded: event DeliveryOrder.DeliveryLocationRecorded is {
        tell command Delivery.DeliveryRepository.PersistDeliveryLocationRecorded(deliveryOrderId = deliveryLocationRecorded.deliveryId, driverLocation = deliveryLocationRecorded.driverLocation) to repository Delivery.DeliveryRepository
      }
      on deliveryConfirmed: event DeliveryOrder.DeliveryConfirmed is {
        tell command Delivery.DeliveryRepository.PersistDeliveryConfirmed(deliveryOrderId = deliveryConfirmed.deliveryId, confirmedAt = deliveryConfirmed.confirmedAt) to repository Delivery.DeliveryRepository
      }
      on deliveryPaymentRecorded: event DeliveryOrder.DeliveryPaymentRecorded is {
        tell command Delivery.DeliveryRepository.PersistDeliveryPaymentRecorded(deliveryOrderId = deliveryPaymentRecorded.deliveryId, deliveryTip = deliveryPaymentRecorded.deliveryTip) to repository Delivery.DeliveryRepository
      }
      on deliveryIssueReported: event DeliveryOrder.DeliveryIssueReported is {
        tell command Delivery.DeliveryRepository.PersistDeliveryIssueReported(deliveryOrderId = deliveryIssueReported.deliveryId, issueType = deliveryIssueReported.issueType, issueDescription = deliveryIssueReported.issueDescription) to repository Delivery.DeliveryRepository
      }
      on deliveryMarkedFailed: event DeliveryOrder.DeliveryMarkedFailed is {
        tell command Delivery.DeliveryRepository.PersistDeliveryMarkedFailed(deliveryOrderId = deliveryMarkedFailed.deliveryId, failureReason = deliveryMarkedFailed.failureReason, failedAt = deliveryMarkedFailed.failedAt) to repository Delivery.DeliveryRepository
      }
      on other is {
        do "nothing else arrives: every member of the inlet alternation has its own clause"
      }
    } with {
      briefly "DeliveryProjection handler"
      described as {
        |Turns each Delivery event into the repository command that writes it.
      }
    }
  } with {
    briefly "Delivery persistence projection"
    described as {
      |Builds the stored Delivery view from the entity's events.
    }
  }
  streamlet DeliveryOrderEventSource as split is {
    outlet DeliveryOrderEventSourceToToNotificationService is type DeliveryOrderEvent
    outlet DeliveryOrderEventSourceToDeliveryProjection is type DeliveryOrderEvent
    inlet DeliveryOrderEventSourceIn is type DeliveryOrderEvent    outlet DeliveryOrderEvents is type DeliveryEvent
    handler DeliveryOrderEventEmitter is {
      on other is {
        error "Unexpected message for source DeliveryOrderEventSource"
      }
      on deliveryCreated: event DeliveryOrder.DeliveryCreated is {
        send deliveryCreated to outlet DeliveryOrderEvents
        send deliveryCreated to outlet DeliveryOrderEventSourceToDeliveryProjection
      }
      on driverAssigned: event DeliveryOrder.DriverAssigned is {
        send driverAssigned to outlet DeliveryOrderEvents
        send driverAssigned to outlet DeliveryOrderEventSourceToDeliveryProjection
      }
      on driverDispatched: event DeliveryOrder.DriverDispatched is {
        send driverDispatched to outlet DeliveryOrderEvents
        send driverDispatched to outlet DeliveryOrderEventSourceToDeliveryProjection
      }
      on deliveryConfirmed: event DeliveryOrder.DeliveryConfirmed is {
        send deliveryConfirmed to outlet DeliveryOrderEvents
        send deliveryConfirmed to outlet DeliveryOrderEventSourceToDeliveryProjection
      }
      on deliveryMarkedFailed: event DeliveryOrder.DeliveryMarkedFailed is {
        send deliveryMarkedFailed to outlet DeliveryOrderEvents
        send deliveryMarkedFailed to outlet DeliveryOrderEventSourceToDeliveryProjection
      }
      on deliveryLocationRecorded: event DeliveryOrder.DeliveryLocationRecorded is {
        send deliveryLocationRecorded to outlet DeliveryOrderEventSourceToDeliveryProjection
      }
      on deliveryPaymentRecorded: event DeliveryOrder.DeliveryPaymentRecorded is {
        send deliveryPaymentRecorded to outlet DeliveryOrderEventSourceToDeliveryProjection
      }
      on deliveryIssueReported: event DeliveryOrder.DeliveryIssueReported is {
        send deliveryIssueReported to outlet DeliveryOrderEventSourceToDeliveryProjection
        send deliveryIssueReported to outlet DeliveryOrderEventSourceToToNotificationService
      }
    } with {
      briefly "Delivery order event emitter"
      described as {
        |Emits delivery lifecycle events.
      }
    }
  } with {
    briefly "Delivery order event source"
    described as {
      |Publishes delivery entity events.
    }
  }
  adaptor ToNotificationService to context Restaurant.NotificationService as flow is { 
    inlet ToNotificationServiceIn is type DeliveryOrderEvent    outlet ToNotificationServiceOut is command ReactiveBBQ.Restaurant.NotificationService.SendPushNotification
    handler CustomerNotification is {
      on deliveryIssueReported: event DeliveryOrder.DeliveryIssueReported is {
        match "issueType" {
          case "VehicleBreakdown" {
            do "no customer notification: the delivery is reassigned to
              another driver and the customer sees no change"
          }
          default {
            let sendPushNotification: type Restaurant.NotificationService.SendPushNotification = prompt("the push notification telling the customer what happened to their delivery and what to expect next")
            tell sendPushNotification to context Restaurant.NotificationService
          }
        }
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "Customer notification"
      described as {
        |Translates a delivery issue into a push notification for the
        |customer. Every issue type notifies except a vehicle breakdown,
        |which is resolved by reassigning the delivery and is invisible to
        |the customer.
      }
    }
  } with {
    briefly "Notification service adaptor"
    described as {
      |The outbound boundary to the external notification service. The
      |DeliveryOrder entity records what went wrong; deciding that the
      |customer should hear about it, and saying it in the notification
      |service's language, belongs here rather than inside the aggregate.
    }
  }
  adaptor FromOnlineOrdering from context Restaurant.OnlineOrdering as flow is { 
    inlet FromOnlineOrderingIn is type OnlineOrdering.OnlineOrderEvent    outlet FromOnlineOrderingToDelivery is command CreateDelivery
    handler OnlineDeliveryIntake is {
      on event Restaurant.OnlineOrdering.OnlineOrder.FulfillmentSelected is {
        when prompt("event.fulfillmentType is DeliveryFulfillment") then
          do "construct CreateDelivery with new DeliveryId,
            sourceOnlineOrderId = event.onlineOrderId,
            deliveryCustomerName from customer profile,
            deliveryCustomerPhone from customer profile,
            deliveryDestination = event.deliveryAddress,
            requestedDeliveryTime = event.requestedTime"
          let createDelivery: type CreateDelivery = prompt("the create delivery that results from fulfillment selected")
          send createDelivery to outlet Delivery.FromOnlineOrdering.FromOnlineOrderingToDelivery
        end
      }
      on other is {
        error "Unexpected message for adaptor FromOnlineOrdering"
      }
    } with {
      briefly "Online delivery intake"
      described as {
        |Creates deliveries from online orders when delivery
        |fulfillment is selected.
      }
    }
  } with {
    briefly "Online ordering adaptor"
    described as {
      |Receives delivery-fulfillment orders from online ordering.
    }
  }
  connector 'ToNotificationService Feed' is from outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEventSourceToToNotificationService to inlet Delivery.ToNotificationService.ToNotificationServiceIn with {
    briefly "The DeliveryOrder events ToNotificationService translates, on their way to it"
    described as {
      |The DeliveryOrder events ToNotificationService translates, on their way to it.
    }
  }
  connector 'DeliveryOrderEvent Stream' is from outlet Delivery.DeliveryOrder.DeliveryOrderEvents2 to inlet Delivery.DeliveryOrderEventSource.DeliveryOrderEventSourceIn with {
    briefly "Every DeliveryOrder event, on its way to the fan-out"
    described as {
      |Every DeliveryOrder event, on its way to the fan-out.
    }
  }
  connector 'DeliveryOrder Storage' is from outlet Delivery.DeliveryOrderEventSource.DeliveryOrderEventSourceToDeliveryProjection to inlet Delivery.DeliveryProjection.DeliveryProjectionFromDelivery with {
    briefly "The DeliveryOrder projection on its way to storage"
    described as {
      |Carries what leaves DeliveryOrderEvents2 to DeliveryRepositoryFromDeliveryOrder, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  briefly "Delivery context"
  described as {
    | Manages delivery driver dispatch, GPS tracking, and
    | offline-resilient delivery operations. Drivers can
    | cache order details and report issues when connectivity
    | resumes. Decoupled from online ordering via adaptors.
  }
}
