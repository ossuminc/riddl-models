// Loyalty shared types
type LoyaltyAccountId is Id(Loyalty.LoyaltyAccount)  with {
  briefly "Loyalty account identifier"
  described as {
    |Unique identifier for a loyalty account.
  }
}
type LoyaltyCustomerId is UUID with {
  briefly "Loyalty customer identifier"
  described as {
    |Unique identifier for the loyalty customer.
  }
}
// LoyaltyAccountStatus enum removed — lifecycle phase is now
// modeled by distinct RIDDL states on the LoyaltyAccount
// entity: Active, Suspended, Closed
type PointTransaction is {
  transactionId: UUID with {
    briefly "Transaction ID"
    described as {
      |Unique identifier for the point transaction.
    }
  }
  pointsChanged: Integer with {
    briefly "Points changed"
    described as {
      |Number of points accrued (positive) or redeemed (negative).
    }
  }
  transactionReason: String(1,200) with {
    briefly "Reason"
    described as {
      |Reason for the point change.
    }
  }
  sourceOrderRef: String(1,50)? with {
    briefly "Source order"
    described as {
      |Reference to the originating order.
    }
  }
  transactionTimestamp: TimeStamp with {
    briefly "Timestamp"
    described as {
      |When the transaction occurred.
    }
  }
} with {
  briefly "Point transaction"
  described as {
    |A single loyalty point accrual or redemption.
  }
}
type LoyaltyEvent is one of {
  LoyaltyAccount.CustomerEnrolled or LoyaltyAccount.PointsAccrued or LoyaltyAccount.PointsRedeemed or LoyaltyAccount.AccountSuspended or LoyaltyAccount.AccountReactivated or LoyaltyAccount.AccountClosed
} with {
  briefly "Loyalty event type"
  described as {
    |Union of all loyalty account entity events.
  }
}
type SpendForPoints is {
  spendAmount: Decimal(10,2) with {
    briefly "Spend"
    described as {
      |The paid check total the member is earning against. Net of tax and
      |tip, because a restaurant does not pay loyalty on money it merely
      |collects for someone else.
    }
  }
} with {
  briefly "Spend to convert"
  described as {
    |Input to PointsForSpend. A named type rather than an inline aggregate
    |because the inline form on `requires` is deprecated, and because naming
    |it lets the accrual adaptors state what they are handing over.
  }
}
type PointsEarned is {
  earnedPoints: Natural with {
    briefly "Points"
    described as {
      |Whole points to credit. Fractions are dropped rather than rounded, so
      |a member is never credited for spend that did not happen.
    }
  }
} with {
  briefly "Points earned"
  described as {
    |Result of PointsForSpend.
  }
}
