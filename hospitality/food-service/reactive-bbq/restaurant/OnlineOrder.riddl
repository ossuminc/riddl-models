        end
      }
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
