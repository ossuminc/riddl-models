// OnlineOrder entity for the OnlineOrdering context
event-sourced entity OnlineOrder as flow is {
  type OnlineOrderCommand is one of {
    OnlineOrder.BrowseMenu or OnlineOrder.AddToCart or OnlineOrder.RemoveFromCart or OnlineOrder.SelectFulfillment or OnlineOrder.SubmitOnlineOrder or OnlineOrder.ProcessOnlinePayment or OnlineOrder.MarkOnlineInPreparation or OnlineOrder.MarkReadyForPickup or OnlineOrder.MarkOutForDelivery or OnlineOrder.CompleteOnlineOrder or OnlineOrder.CancelOnlineOrder
  } with {
    briefly "OnlineOrder command alternation"
    described as {
      |Commands accepted by the OnlineOrder entity.
    }
  }
  inlet OnlineOrderCommands is type OnlineOrderCommand  outlet OnlineOrderEvents is type OnlineOrderEvent
  // ---- Commands ----
  command BrowseMenu yields event MenuBrowsed is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Session/order identifier.
      }
    }
    customerId: CustomerId with {
      briefly "Customer ID"
      described as {
        |Customer browsing the menu.
      }
    }
    browsedAt: TimeStamp with {
      briefly "Browsed at"
      described as {
        |When the menu was browsed.
      }
    }
  } with {
    briefly "Browse menu"
    described as {
      |Customer begins browsing the online menu.
    }
  }
  command AddToCart yields event ItemAddedToCart is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to add item to.
      }
    }
    cartItem: CartItem with {
      briefly "Item"
      described as {
        |Item to add to cart.
      }
    }
  } with {
    briefly "Add to cart"
    described as {
      |Add an item to the online shopping cart.
    }
  }
  command RemoveFromCart yields event ItemRemovedFromCart is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to remove item from.
      }
    }
    removedCartItemId: String(1,50) with {
      briefly "Menu item ID"
      described as {
        |Item to remove from cart.
      }
    }
  } with {
    briefly "Remove from cart"
    described as {
      |Remove an item from the online shopping cart.
    }
  }
  command SelectFulfillment yields event FulfillmentSelected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to set fulfillment for.
      }
    }
    fulfillmentType: FulfillmentType with {
      briefly "Fulfillment"
      described as {
        |Pickup or delivery.
      }
    }
    deliveryAddress: DeliveryAddress? with {
      briefly "Address"
      described as {
        |Delivery address if delivery fulfillment.
      }
    }
    requestedTime: TimeStamp? with {
      briefly "Requested time"
      described as {
        |Requested pickup or delivery time.
      }
    }
  } with {
    briefly "Select fulfillment"
    described as {
      |Choose pickup or delivery fulfillment.
    }
  }
  command SubmitOnlineOrder yields event OnlineOrderSubmitted is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to submit.
      }
    }
    onlineSubmittedAt: TimeStamp with {
      briefly "Submitted at"
      described as {
        |When the order was submitted.
      }
    }
  } with {
    briefly "Submit online order"
    described as {
      |Submit the online order for processing.
    }
  }
  command ProcessOnlinePayment yields event OnlinePaymentProcessed is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to pay for.
      }
    }
    onlinePayment: OnlinePaymentInfo with {
      briefly "Payment"
      described as {
        |Payment details.
      }
    }
  } with {
    briefly "Process online payment"
    described as {
      |Process payment for the online order.
    }
  }
  command MarkOnlineInPreparation yields event OnlineOrderInPreparation is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order being prepared.
      }
    }
  } with {
    briefly "Mark in preparation"
    described as {
      |Mark the order as actively being prepared by the
      |kitchen. Triggered by adaptor from Kitchen context.
    }
  }
  command MarkReadyForPickup yields event OnlineOrderReadyForPickup is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order ready for pickup.
      }
    }
    readyForPickupAt: TimeStamp with {
      briefly "Ready at"
      described as {
        |When the order became ready.
      }
    }
  } with {
    briefly "Mark ready for pickup"
    described as {
      |Mark a pickup order as ready for customer collection.
    }
  }
  command MarkOutForDelivery yields event OnlineOrderOutForDelivery is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order dispatched for delivery.
      }
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched at"
      described as {
        |When the driver was dispatched.
      }
    }
  } with {
    briefly "Mark out for delivery"
    described as {
      |Mark a delivery order as dispatched with the driver.
    }
  }
  command CompleteOnlineOrder yields event OnlineOrderCompleted is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to complete.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the order was completed.
      }
    }
  } with {
    briefly "Complete online order"
    described as {
      |Mark the order as completed after pickup or delivery.
    }
  }
  command CancelOnlineOrder yields event OnlineOrderCancelled is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to cancel.
      }
    }
    cancellationReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the order is being pulled. Kept because a guest cancelling
        |before the kitchen fires costs nothing, while the restaurant
        |cancelling after it does — and reporting must tell them apart.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled at"
      described as {
        |When the cancellation was requested.
      }
    }
  } with {
    briefly "Cancel online order"
    described as {
      |Cancel an online order. Allowed from any state before
      |delivery or pickup completion. If the order has already
      |been paid, cancellation implies a refund.
    }
  }
  // ---- Query/Result ----
  query GetOnlineOrder replies result OnlineOrderResult is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |Order to retrieve.
      }
    }
  } with {
    briefly "Get online order"
    described as {
      |Query an online order by its identifier.
    }
  }
  result OnlineOrderResult is {
    onlineOrderId: OnlineOrderId with {
      briefly "OnlineOrder addressed"
      described as {
        |Which onlineorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    order: OnlineOrderData with {
      briefly "Order"
      described as {
        |The requested online order data.
      }
    }
  } with {
    briefly "Online order result"
    described as {
      |Result containing the requested online order data.
    }
  }
  // ---- Events ----
  event MenuBrowsed is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The session just opened. An online order exists from the moment the
        |guest starts browsing, so every later event carries this same value
        |and the whole journey can be assembled from the log.
      }
    }
    customerId: CustomerId with {
      briefly "Customer ID"
      described as {
        |The account doing the browsing. Known from the start online, unlike
        |a dine-in guest who is anonymous until they pay.
      }
    }
    browsedAt: TimeStamp with {
      briefly "Browsed at"
      described as {
        |When the guest opened the menu. The span from here to submission is
        |the shopping time abandoned-cart reporting works from.
      }
    }
  } with {
    briefly "Menu browsed"
    described as {
      |Emitted when a customer begins browsing.
    }
  }
  event ItemAddedToCart is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The cart the item joined. Items go in one at a time, so the cart
        |grows across the session rather than arriving complete.
      }
    }
    cartItem: CartItem with {
      briefly "Item"
      described as {
        |Added item.
      }
    }
  } with {
    briefly "Item added to cart"
    described as {
      |Emitted when an item is added to the cart.
    }
  }
  event ItemRemovedFromCart is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The cart the item left. Removals before submission cost nothing,
        |which is why the cart is editable right up to it.
      }
    }
    removedCartItemId: String(1,50) with {
      briefly "Menu item ID"
      described as {
        |Removed item.
      }
    }
  } with {
    briefly "Item removed from cart"
    described as {
      |Emitted when an item is removed from the cart.
    }
  }
  event FulfillmentSelected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order whose fulfilment was chosen. Pickup and delivery diverge
        |sharply from here — only one of them needs an address or a courier.
      }
    }
    fulfillmentType: FulfillmentType with {
      briefly "Fulfillment"
      described as {
        |Chosen fulfillment type.
      }
    }
    deliveryAddress: DeliveryAddress? with {
      briefly "Address"
      described as {
        |Delivery address if applicable.
      }
    }
    requestedTime: TimeStamp? with {
      briefly "Requested time"
      described as {
        |When the guest wants the food. Distinguishes an order for now from
        |one scheduled ahead, which the kitchen must not start early.
      }
    }
  } with {
    briefly "Fulfillment selected"
    described as {
      |Emitted when customer selects pickup or delivery.
    }
  }
  event OnlineOrderSubmitted is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order now committed. Submission is the point the cart stops
        |being editable and the restaurant takes it on.
      }
    }
    customerId: CustomerId with {
      briefly "Customer ID"
      described as {
        |Who to hold the order for and, if it is a member, whose balance the
        |spend will later accrue to.
      }
    }
    orderCartItems: CartItem+ with {
      briefly "Items"
      described as {
        |The cart as submitted, frozen at this moment. Food and drink both
        |sit here, and are split apart only when the order is routed.
      }
    }
    fulfillmentType: FulfillmentType with {
      briefly "Fulfillment"
      described as {
        |Pickup or delivery. Decides whether the order ends at the counter
        |or is handed to the Delivery context.
      }
    }
    deliveryAddress: DeliveryAddress? with {
      briefly "Address"
      described as {
        |Delivery address if applicable.
      }
    }
    onlineSubmittedAt: TimeStamp with {
      briefly "Submitted at"
      described as {
        |When the guest committed. Time zero for the promise made back to
        |them, and the baseline every quoted wait is measured from.
      }
    }
  } with {
    briefly "Online order submitted"
    described as {
      |Emitted when the online order is submitted.
    }
  }
  event OnlinePaymentProcessed is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order now paid. Online orders are paid before they are cooked,
        |the reverse of a dine-in check, so this gates the kitchen rather
        |than closing the order.
      }
    }
    onlinePayment: OnlinePaymentInfo with {
      briefly "Payment"
      described as {
        |Payment details.
      }
    }
    onlinePaidAt: TimeStamp with {
      briefly "Paid at"
      described as {
        |When payment was processed.
      }
    }
  } with {
    briefly "Online payment processed"
    described as {
      |Emitted when online payment is processed.
    }
  }
  event OnlineOrderInPreparation is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order the kitchen has begun. From here a cancellation wastes
        |food already committed.
      }
    }
  } with {
    briefly "Online order in preparation"
    described as {
      |Emitted when the kitchen begins preparing the order.
    }
  }
  event OnlineOrderReadyForPickup is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order waiting at the counter. For pickup this is the last thing
        |the restaurant does; the guest's arrival is outside its control.
      }
    }
    readyForPickupAt: TimeStamp with {
      briefly "Ready at"
      described as {
        |When the order became ready.
      }
    }
  } with {
    briefly "Online order ready for pickup"
    described as {
      |Emitted when a pickup order is ready for customer
      |collection.
    }
  }
  event OnlineOrderOutForDelivery is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order now with a courier. Responsibility passes out of the
        |restaurant here, though the guest still holds it responsible.
      }
      term Courier is "Whoever carries an order the last leg to the guest, whether the chain's own driver or a third party. The restaurant's control ends when the courier takes the bag; its reputation does not."
    }
    dispatchedAt: TimeStamp with {
      briefly "Dispatched at"
      described as {
        |When the courier took it. The start of the delivery clock, which
        |runs on the road and not in the restaurant.
      }
    }
  } with {
    briefly "Online order out for delivery"
    described as {
      |Emitted when a delivery order is dispatched.
    }
  }
  event OnlineOrderCompleted is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order now finished. Completion is what releases the spend to
        |loyalty, so it must not fire for an order that was never received.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the guest got the food. The full span from submission is the
        |number the guest actually judges the restaurant on.
      }
    }
  } with {
    briefly "Online order completed"
    described as {
      |Emitted when an online order is completed after
      |pickup or delivery.
    }
  }
  event OnlineOrderCancelled is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order that was pulled. Cancellation is terminal and is the only
        |path that can strand a payment already taken.
      }
    }
    cancellationReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why it was pulled, carried forward so reporting can separate
        |guest-initiated cancellations from restaurant-initiated ones.
      }
    }
    requiresRefund: Boolean with {
      briefly "Requires refund"
      described as {
        |Whether the cancellation requires a refund of
        |previously processed payment.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled at"
      described as {
        |When it was pulled. Compared against payment and preparation, this
        |is what decides whether a refund and food waste are owed.
      }
    }
  } with {
    briefly "Online order cancelled"
    described as {
      |Emitted when an online order is cancelled. If the
      |order was already paid, a refund is triggered.
    }
  }
  // ---- Routing Events ----
  event OnlineTicketRouted is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order whose food went to the kitchen. Online tickets join the
        |same queue as dine-in ones, which is why the kitchen tracks a
        |ticket's source.
      }
    }
    onlineTicketRoutedAt: TimeStamp with {
      briefly "Routed at"
      described as {
        |When the food reached the kitchen. The seam where the cook becomes
        |the kitchen's responsibility rather than online ordering's.
      }
    }
  } with {
    briefly "Online ticket routed"
    described as {
      |Emitted when a submitted online order is routed to the
      |Kitchen context as a kitchen ticket.
    }
  }
  event OnlinePointsAccrualRouted is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order whose spend was sent to loyalty.
      }
    }
    onlinePointsAccrualRoutedAt: TimeStamp with {
      briefly "Routed at"
      described as {
        |When the spend was handed to loyalty. Deliberately after payment, so
        |a cancelled or refunded order never earns points.
      }
    }
  } with {
    briefly "Online points accrual routed"
    described as {
      |Emitted when a completed online order's loyalty points
      |accrual is routed to the Loyalty context.
    }
  }
  // ---- Rejection Events ----
  event BrowseMenuRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The session that could not be opened, typically because the guest is
        |not recognised.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Browse menu rejected"
    described as {
      |Emitted when a BrowseMenu command is rejected.
    }
  }
  event AddToCartRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The cart the item could not join — most often an item pulled from
        |the menu since the guest started browsing.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Add to cart rejected"
    described as {
      |Emitted when an AddToCart command is rejected.
    }
  }
  event RemoveFromCartRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The cart the item could not leave, typically because the order is
        |already submitted and no longer editable.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Remove from cart rejected"
    described as {
      |Emitted when a RemoveFromCart command is rejected.
    }
  }
  event SelectFulfillmentRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order whose fulfilment could not be set — most often a delivery
        |address outside the restaurant's radius.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Select fulfillment rejected"
    described as {
      |Emitted when a SelectFulfillment command is rejected.
    }
  }
  event SubmitOnlineOrderRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order that could not be submitted, typically because the cart is
        |empty or no fulfilment was chosen.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Submit online order rejected"
    described as {
      |Emitted when a SubmitOnlineOrder command is rejected.
    }
  }
  event ProcessOnlinePaymentRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order whose payment failed. The guest keeps an editable cart
        |rather than losing the order outright.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Process online payment rejected"
    described as {
      |Emitted when a ProcessOnlinePayment command is rejected.
    }
  }
  event MarkOnlineInPreparationRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order the kitchen could not start, typically because payment has
        |not cleared.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Mark in preparation rejected"
    described as {
      |Emitted when a MarkOnlineInPreparation command is rejected.
    }
  }
  event MarkReadyForPickupRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order that could not be marked ready, typically because
        |preparation never started.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Mark ready for pickup rejected"
    described as {
      |Emitted when a MarkReadyForPickup command is rejected.
    }
  }
  event MarkOutForDeliveryRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order that could not go out for delivery, typically because it
        |is a pickup order.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Mark out for delivery rejected"
    described as {
      |Emitted when a MarkOutForDelivery command is rejected.
    }
  }
  event CompleteOnlineOrderRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order that could not be completed, typically because it never
        |reached the guest.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Complete online order rejected"
    described as {
      |Emitted when a CompleteOnlineOrder command is rejected.
    }
  }
  event CancelOnlineOrderRejected is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order that could not be cancelled, typically because it is
        |already completed.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Cancel online order rejected"
    described as {
      |Emitted when a CancelOnlineOrder command is rejected.
    }
  }
  // ---- State ----
  record OnlineOrderData is {
    onlineOrderId: OnlineOrderId with {
      briefly "ID"
      described as {
        |The order this state belongs to. Carried through every lifecycle
        |state so the record can be rebuilt by replaying the event log.
      }
    }
    customerId: CustomerId with {
      briefly "Customer ID"
      described as {
        |Who the order is for, held in state so open orders can be listed per
        |guest without replaying the log.
      }
    }
    orderCartItems: CartItem+ with {
      briefly "Items"
      described as {
        |What the guest has chosen so far, editable until submission and
        |frozen after it.
      }
    }
    selectedFulfillment: FulfillmentType? with {
      briefly "Fulfillment"
      described as {
        |Chosen fulfillment type.
      }
    }
    selectedDeliveryAddress: DeliveryAddress? with {
      briefly "Address"
      described as {
        |Delivery address if applicable.
      }
    }
    processedOnlinePayment: OnlinePaymentInfo? with {
      briefly "Payment"
      described as {
        |Payment info when processed.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the session started.
      }
    }
    actualOnlineSubmittedAt: TimeStamp? with {
      briefly "Submitted at"
      described as {
        |When the guest committed, absent while the cart is still open. Its
        |presence is what separates a live cart from a real order.
      }
    }
    completedAt: TimeStamp? with {
      briefly "Completed at"
      described as {
        |When the order was completed.
      }
    }
    cancelledAt: TimeStamp? with {
      briefly "Cancelled at"
      described as {
        |When the order was cancelled.
      }
    }
    cancellationReason: String(1,500)? with {
      briefly "Cancellation reason"
      described as {
        |Reason for cancellation if applicable.
      }
    }
  } with {
    briefly "Online order state data"
    described as {
      |Full state of an online order. Shared across all
      |lifecycle states as a superset record.
    }
  }
  initial state Browsing of record OnlineOrder.OnlineOrderData is {
    initial handler BrowsingInitHandler is {
      on init is {
        let menuBrowsed: type MenuBrowsed = prompt("the menu browsed that brings this online order into existence")
        yield menuBrowsed
      }
    } with {
      briefly "Browsing init handler"
      described as {
        |Initializes the Browsing state with default values.
      }
    }
    handler BrowsingHandler is {
      on addToCart: command AddToCart is {
        yield event ItemAddedToCart(onlineOrderId = addToCart.onlineOrderId, cartItem = addToCart.cartItem)
        send event ItemAddedToCart(onlineOrderId = addToCart.onlineOrderId, cartItem = addToCart.cartItem) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on event ItemAddedToCart is {
        do "append ItemAddedToCart.cartItem to
          OnlineOrderData.orderCartItems"
      }
      on removeFromCart: command RemoveFromCart is {
        yield event ItemRemovedFromCart(onlineOrderId = removeFromCart.onlineOrderId, removedCartItemId = removeFromCart.removedCartItemId)
        send event ItemRemovedFromCart(onlineOrderId = removeFromCart.onlineOrderId, removedCartItemId = removeFromCart.removedCartItemId) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on event ItemRemovedFromCart is {
        do "remove CartItem from OnlineOrderData
          .orderCartItems where cartMenuItemId =
          ItemRemovedFromCart.removedCartItemId"
      }
      on selectFulfillment: command SelectFulfillment is {
        when prompt("fulfillment is DeliveryFulfillment") then
          do "validate SelectFulfillment.deliveryAddress is within
            restaurant service area by ZIP code"
        end
        yield event FulfillmentSelected(onlineOrderId = selectFulfillment.onlineOrderId, fulfillmentType = selectFulfillment.fulfillmentType, deliveryAddress = selectFulfillment.deliveryAddress, requestedTime = selectFulfillment.requestedTime)
        send event FulfillmentSelected(onlineOrderId = selectFulfillment.onlineOrderId, fulfillmentType = selectFulfillment.fulfillmentType, deliveryAddress = selectFulfillment.deliveryAddress, requestedTime = selectFulfillment.requestedTime) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on fulfillmentSelected: event FulfillmentSelected is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.FulfillmentChosen with record OnlineOrder.OnlineOrderData(onlineOrderId = fulfillmentSelected.onlineOrderId, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = fulfillmentSelected.fulfillmentType, selectedDeliveryAddress = fulfillmentSelected.deliveryAddress, processedOnlinePayment = empty, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = empty, completedAt = empty, cancelledAt = empty, cancellationReason = empty)
        when prompt("fulfillment is DeliveryFulfillment") then
          set field OnlineOrder.FulfillmentChosen.selectedDeliveryAddress to prompt("deliveryAddress from event")
        end
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        yield event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled"))
        send event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled")) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderCancelled: event OnlineOrderCancelled is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Cancelled with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderCancelled.onlineOrderId, cancelledAt = onlineOrderCancelled.cancelledAt, cancellationReason = onlineOrderCancelled.cancellationReason, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = empty)
      }
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        error "OnlineOrder does not accept MarkOnlineInPreparation in this state"
      }
      on markReadyForPickup: command MarkReadyForPickup is {
        error "OnlineOrder does not accept MarkReadyForPickup in this state"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        error "OnlineOrder does not accept MarkOutForDelivery in this state"
      }
      on completeOnlineOrder: command CompleteOnlineOrder is {
        error "OnlineOrder does not accept CompleteOnlineOrder in this state"
      }
    } with {
      briefly "Browsing state handler"
      described as {
        |Handles commands valid in the Browsing state.
        |AddToCart and RemoveFromCart modify the cart.
        |SelectFulfillment advances the lifecycle.
        |CancelOnlineOrder moves to Cancelled.
      }
    }
  } with {
    briefly "Browsing menu"
    described as {
      |Customer is browsing the menu and building their
      |cart. Items can be added and removed.
    }
  }
  state FulfillmentChosen of record OnlineOrder.OnlineOrderData is {
    initial handler FulfillmentChosenInitHandler is {
      on init is {
        let fulfillmentSelected: type FulfillmentSelected = prompt("the fulfillment selected that brings this online ordering into existence")
        yield fulfillmentSelected
      }
    } with {
      briefly "FulfillmentChosen init handler"
      described as {
        |Initializes the FulfillmentChosen state from the
        |FulfillmentSelected event.
      }
    }
    handler FulfillmentChosenHandler is {
      on submitOnlineOrder: command SubmitOnlineOrder is {
        yield event OnlineOrderSubmitted(onlineOrderId = submitOnlineOrder.onlineOrderId, onlineSubmittedAt = submitOnlineOrder.onlineSubmittedAt, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, fulfillmentType = prompt("the fulfillment type of this online order submitted"), deliveryAddress = OnlineOrderData.selectedDeliveryAddress)
        send event OnlineOrderSubmitted(onlineOrderId = submitOnlineOrder.onlineOrderId, onlineSubmittedAt = submitOnlineOrder.onlineSubmittedAt, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, fulfillmentType = prompt("the fulfillment type of this online order submitted"), deliveryAddress = OnlineOrderData.selectedDeliveryAddress) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderSubmitted: event OnlineOrderSubmitted is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Submitted with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderSubmitted.onlineOrderId, customerId = onlineOrderSubmitted.customerId, orderCartItems = onlineOrderSubmitted.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = empty, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = onlineOrderSubmitted.onlineSubmittedAt, completedAt = empty, cancelledAt = empty, cancellationReason = empty)
        do "OnlineOrderSubmitted event triggers kitchen ticket
          creation via ToKitchen adaptor"
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        yield event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled"))
        send event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled")) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderCancelled: event OnlineOrderCancelled is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Cancelled with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderCancelled.onlineOrderId, cancelledAt = onlineOrderCancelled.cancelledAt, cancellationReason = onlineOrderCancelled.cancellationReason, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = OnlineOrderData.completedAt)
      }
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        error "OnlineOrder does not accept MarkOnlineInPreparation in this state"
      }
      on markReadyForPickup: command MarkReadyForPickup is {
        error "OnlineOrder does not accept MarkReadyForPickup in this state"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        error "OnlineOrder does not accept MarkOutForDelivery in this state"
      }
      on completeOnlineOrder: command CompleteOnlineOrder is {
        error "OnlineOrder does not accept CompleteOnlineOrder in this state"
      }
    } with {
      briefly "FulfillmentChosen state handler"
      described as {
        |Handles commands valid in the FulfillmentChosen state.
        |SubmitOnlineOrder advances the lifecycle.
        |CancelOnlineOrder moves to Cancelled.
      }
    }
  } with {
    briefly "Fulfillment chosen"
    described as {
      |Customer has selected pickup or delivery fulfillment.
      |Ready for submission.
    }
  }
  state Submitted of record OnlineOrder.OnlineOrderData is {
    initial handler SubmittedInitHandler is {
      on init is {
        let onlineOrderSubmitted: type OnlineOrderSubmitted = prompt("the online order submitted that brings this online ordering into existence")
        yield onlineOrderSubmitted
      }
    } with {
      briefly "Submitted init handler"
      described as {
        |Initializes the Submitted state from the
        |OnlineOrderSubmitted event.
      }
    }
    handler SubmittedHandler is {
      on processOnlinePayment: command ProcessOnlinePayment is {
        yield event OnlinePaymentProcessed(onlineOrderId = processOnlinePayment.onlineOrderId, onlinePayment = processOnlinePayment.onlinePayment, onlinePaidAt = system.now)
        send event OnlinePaymentProcessed(onlineOrderId = processOnlinePayment.onlineOrderId, onlinePayment = processOnlinePayment.onlinePayment, onlinePaidAt = system.now) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlinePaymentProcessed: event OnlinePaymentProcessed is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Paid with record OnlineOrder.OnlineOrderData(onlineOrderId = onlinePaymentProcessed.onlineOrderId, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = onlinePaymentProcessed.onlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = empty, cancelledAt = empty, cancellationReason = empty)
        do "OnlinePaymentProcessed event triggers PaymentGateway
          authorization via streaming topology and Loyalty
          point accrual via ToLoyalty adaptor"
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        yield event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled"))
        send event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled")) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderCancelled: event OnlineOrderCancelled is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Cancelled with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderCancelled.onlineOrderId, cancelledAt = onlineOrderCancelled.cancelledAt, cancellationReason = onlineOrderCancelled.cancellationReason, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = OnlineOrderData.completedAt)
      }
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        error "OnlineOrder does not accept MarkOnlineInPreparation in this state"
      }
      on markReadyForPickup: command MarkReadyForPickup is {
        error "OnlineOrder does not accept MarkReadyForPickup in this state"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        error "OnlineOrder does not accept MarkOutForDelivery in this state"
      }
      on completeOnlineOrder: command CompleteOnlineOrder is {
        error "OnlineOrder does not accept CompleteOnlineOrder in this state"
      }
    } with {
      briefly "Submitted state handler"
      described as {
        |Handles commands valid in the Submitted state.
        |ProcessOnlinePayment advances the lifecycle.
        |CancelOnlineOrder moves to Cancelled.
      }
    }
  } with {
    briefly "Order submitted"
    described as {
      |Order has been submitted for processing. Kitchen
      |ticket creation and delivery routing triggered.
    }
  }
  state Paid of record OnlineOrder.OnlineOrderData is {
    initial handler PaidInitHandler is {
      on init is {
        let onlinePaymentProcessed: type OnlinePaymentProcessed = prompt("the online payment processed that brings this online ordering into existence")
        yield onlinePaymentProcessed
      }
    } with {
      briefly "Paid init handler"
      described as {
        |Initializes the Paid state from the
        |OnlinePaymentProcessed event.
      }
    }
    handler PaidHandler is {
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        yield event OnlineOrderInPreparation(onlineOrderId = markOnlineInPreparation.onlineOrderId)
        send event OnlineOrderInPreparation(onlineOrderId = markOnlineInPreparation.onlineOrderId) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderInPreparation: event OnlineOrderInPreparation is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.InPreparation with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderInPreparation.onlineOrderId, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = empty, cancelledAt = empty, cancellationReason = empty)
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        yield event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled"))
        send event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled")) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderCancelled: event OnlineOrderCancelled is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Cancelled with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderCancelled.onlineOrderId, cancelledAt = onlineOrderCancelled.cancelledAt, cancellationReason = onlineOrderCancelled.cancellationReason, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = OnlineOrderData.completedAt)
        when prompt("OnlineOrderData.processedOnlinePayment is
          not empty") then
          do "trigger refund via PaymentGateway for
            processedOnlinePayment amount"
        end
      }
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
      on markReadyForPickup: command MarkReadyForPickup is {
        error "OnlineOrder does not accept MarkReadyForPickup in this state"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        error "OnlineOrder does not accept MarkOutForDelivery in this state"
      }
      on completeOnlineOrder: command CompleteOnlineOrder is {
        error "OnlineOrder does not accept CompleteOnlineOrder in this state"
      }
    } with {
      briefly "Paid state handler"
      described as {
        |Handles commands valid in the Paid state.
        |MarkOnlineInPreparation advances the lifecycle.
        |CancelOnlineOrder moves to Cancelled with refund.
      }
    }
  } with {
    briefly "Payment complete"
    described as {
      |Payment has been processed. Order is confirmed and
      |awaiting preparation.
    }
  }
  state InPreparation of record OnlineOrder.OnlineOrderData is {
    initial handler InPreparationInitHandler is {
      on init is {
        let onlineOrderInPreparation: type OnlineOrderInPreparation = prompt("the online order in preparation that brings this online ordering into existence")
        yield onlineOrderInPreparation
      }
    } with {
      briefly "InPreparation init handler"
      described as {
        |Initializes the InPreparation state from the
        |OnlineOrderInPreparation event.
      }
    }
    handler InPreparationHandler is {
      on markReadyForPickup: command MarkReadyForPickup is {
        yield event OnlineOrderReadyForPickup(onlineOrderId = markReadyForPickup.onlineOrderId, readyForPickupAt = markReadyForPickup.readyForPickupAt)
        send event OnlineOrderReadyForPickup(onlineOrderId = markReadyForPickup.onlineOrderId, readyForPickupAt = markReadyForPickup.readyForPickupAt) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderReadyForPickup: event OnlineOrderReadyForPickup is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.ReadyForPickup with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderReadyForPickup.onlineOrderId, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = empty, cancelledAt = empty, cancellationReason = empty)
        do "OnlineOrderReadyForPickup triggers push notification
          to customer"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        yield event OnlineOrderOutForDelivery(onlineOrderId = markOutForDelivery.onlineOrderId, dispatchedAt = markOutForDelivery.dispatchedAt)
        send event OnlineOrderOutForDelivery(onlineOrderId = markOutForDelivery.onlineOrderId, dispatchedAt = markOutForDelivery.dispatchedAt) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderOutForDelivery: event OnlineOrderOutForDelivery is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.OutForDelivery with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderOutForDelivery.onlineOrderId, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = empty, cancelledAt = empty, cancellationReason = empty)
        do "OnlineOrderOutForDelivery triggers push notification
          to customer with driver tracking link"
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        yield event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled"))
        send event OnlineOrderCancelled(onlineOrderId = cancelOnlineOrder.onlineOrderId, cancellationReason = cancelOnlineOrder.cancellationReason, cancelledAt = cancelOnlineOrder.cancelledAt, requiresRefund = prompt("the requires refund of this online order cancelled")) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderCancelled: event OnlineOrderCancelled is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Cancelled with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderCancelled.onlineOrderId, cancelledAt = onlineOrderCancelled.cancelledAt, cancellationReason = onlineOrderCancelled.cancellationReason, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, completedAt = OnlineOrderData.completedAt)
        when prompt("OnlineOrderData.processedOnlinePayment is
          not empty") then
          do "trigger refund via PaymentGateway for
            processedOnlinePayment amount"
        end
      }
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        error "OnlineOrder does not accept MarkOnlineInPreparation in this state"
      }
      on completeOnlineOrder: command CompleteOnlineOrder is {
        error "OnlineOrder does not accept CompleteOnlineOrder in this state"
      }
    } with {
      briefly "InPreparation state handler"
      described as {
        |Handles commands valid in the InPreparation state.
        |MarkReadyForPickup or MarkOutForDelivery advance
        |the lifecycle based on fulfillment type.
        |CancelOnlineOrder moves to Cancelled with refund.
      }
    }
  } with {
    briefly "In preparation"
    described as {
      |Kitchen is actively preparing the order items.
    }
  }
