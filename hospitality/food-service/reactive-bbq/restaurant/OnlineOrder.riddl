      }
    }
  } with {
    briefly "Ready for pickup"
    described as {
      |Order is prepared and waiting for customer pickup.
      |Pickup fulfillment only.
    }
  }
  state OutForDelivery of record OnlineOrder.OnlineOrderData is {
    initial handler OutForDeliveryInitHandler is {
      on init is {
        let onlineOrderOutForDelivery: type OnlineOrderOutForDelivery = prompt("the online order out for delivery that brings this online ordering into existence")
        yield onlineOrderOutForDelivery
      }
    } with {
      briefly "OutForDelivery init handler"
      described as {
        |Initializes the OutForDelivery state from the
        |OnlineOrderOutForDelivery event.
      }
    }
    handler OutForDeliveryHandler is {
      on completeOnlineOrder: command CompleteOnlineOrder is {
        yield event OnlineOrderCompleted(onlineOrderId = completeOnlineOrder.onlineOrderId, completedAt = completeOnlineOrder.completedAt)
        send event OnlineOrderCompleted(onlineOrderId = completeOnlineOrder.onlineOrderId, completedAt = completeOnlineOrder.completedAt) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
      }
      on onlineOrderCompleted: event OnlineOrderCompleted is {
        morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Completed with record OnlineOrder.OnlineOrderData(onlineOrderId = onlineOrderCompleted.onlineOrderId, completedAt = onlineOrderCompleted.completedAt, customerId = OnlineOrderData.customerId, orderCartItems = OnlineOrderData.orderCartItems, selectedFulfillment = OnlineOrderData.selectedFulfillment, selectedDeliveryAddress = OnlineOrderData.selectedDeliveryAddress, processedOnlinePayment = OnlineOrderData.processedOnlinePayment, createdAt = OnlineOrderData.createdAt, actualOnlineSubmittedAt = OnlineOrderData.actualOnlineSubmittedAt, cancelledAt = OnlineOrderData.cancelledAt, cancellationReason = OnlineOrderData.cancellationReason)
      }
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        error "OnlineOrder does not accept MarkOnlineInPreparation in this state"
      }
      on markReadyForPickup: command MarkReadyForPickup is {
        error "OnlineOrder does not accept MarkReadyForPickup in this state"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        error "OnlineOrder does not accept MarkOutForDelivery in this state"
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        error "OnlineOrder does not accept CancelOnlineOrder in this state"
      }
    } with {
      briefly "OutForDelivery state handler"
      described as {
        |Handles commands valid in the OutForDelivery state.
        |CompleteOnlineOrder finalizes the lifecycle.
        |Cancellation is not allowed once the driver is
        |dispatched.
      }
    }
  } with {
    briefly "Out for delivery"
    described as {
      |Order has been dispatched with a delivery driver.
      |Delivery fulfillment only.
    }
  }
  state Completed of record OnlineOrder.OnlineOrderData is {
    initial handler CompletedInitHandler is {
      on init is {
        let onlineOrderCompleted: type OnlineOrderCompleted = prompt("the online order completed that brings this online ordering into existence")
        yield onlineOrderCompleted
      }
    } with {
      briefly "Completed init handler"
      described as {
        |Initializes the Completed state from the
        |OnlineOrderCompleted event.
      }
    }
    handler CompletedHandler is {
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        error "OnlineOrder does not accept MarkOnlineInPreparation in this state"
      }
      on markReadyForPickup: command MarkReadyForPickup is {
        error "OnlineOrder does not accept MarkReadyForPickup in this state"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        error "OnlineOrder does not accept MarkOutForDelivery in this state"
      }
      on completeOnlineOrder: command CompleteOnlineOrder is {
        error "OnlineOrder does not accept CompleteOnlineOrder in this state"
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        error "OnlineOrder does not accept CancelOnlineOrder in this state"
      }
    } with {
      briefly "Completed state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Order completed"
    described as {
      |Order has been picked up or delivered. Terminal state.
    }
  }
  state Cancelled of record OnlineOrder.OnlineOrderData is {
    initial handler CancelledInitHandler is {
      on init is {
        let onlineOrderCancelled: type OnlineOrderCancelled = prompt("the online order cancelled that brings this online ordering into existence")
        yield onlineOrderCancelled
      }
    } with {
      briefly "Cancelled init handler"
      described as {
        |Initializes the Cancelled state from the
        |OnlineOrderCancelled event.
      }
    }
    handler CancelledHandler is {
      on browseMenu: command BrowseMenu is {
        error "OnlineOrder does not accept BrowseMenu in this state"
      }
      on addToCart: command AddToCart is {
        error "OnlineOrder does not accept AddToCart in this state"
      }
      on removeFromCart: command RemoveFromCart is {
        error "OnlineOrder does not accept RemoveFromCart in this state"
      }
      on selectFulfillment: command SelectFulfillment is {
        error "OnlineOrder does not accept SelectFulfillment in this state"
      }
      on submitOnlineOrder: command SubmitOnlineOrder is {
        error "OnlineOrder does not accept SubmitOnlineOrder in this state"
      }
      on processOnlinePayment: command ProcessOnlinePayment is {
        error "OnlineOrder does not accept ProcessOnlinePayment in this state"
      }
      on markOnlineInPreparation: command MarkOnlineInPreparation is {
        error "OnlineOrder does not accept MarkOnlineInPreparation in this state"
      }
      on markReadyForPickup: command MarkReadyForPickup is {
        error "OnlineOrder does not accept MarkReadyForPickup in this state"
      }
      on markOutForDelivery: command MarkOutForDelivery is {
        error "OnlineOrder does not accept MarkOutForDelivery in this state"
      }
      on completeOnlineOrder: command CompleteOnlineOrder is {
        error "OnlineOrder does not accept CompleteOnlineOrder in this state"
      }
      on cancelOnlineOrder: command CancelOnlineOrder is {
        error "OnlineOrder does not accept CancelOnlineOrder in this state"
      }
    } with {
      briefly "Cancelled state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Order cancelled"
    described as {
      |Order has been cancelled. If payment was already
      |processed, a refund is triggered. Terminal state.
    }
  }
  handler OnlineOrderCreationHandler is {
    on browseMenu: command BrowseMenu is {
      yield event MenuBrowsed(onlineOrderId = browseMenu.onlineOrderId, customerId = browseMenu.customerId, browsedAt = browseMenu.browsedAt)
      send event MenuBrowsed(onlineOrderId = browseMenu.onlineOrderId, customerId = browseMenu.customerId, browsedAt = browseMenu.browsedAt) to outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents
    }
    on menuBrowsed: event MenuBrowsed is {
      morph entity OnlineOrdering.OnlineOrder to state OnlineOrdering.OnlineOrder.Browsing with record OnlineOrder.OnlineOrderData(onlineOrderId = menuBrowsed.onlineOrderId, customerId = menuBrowsed.customerId, orderCartItems = prompt("the order cart items of this online order data"), selectedFulfillment = empty, selectedDeliveryAddress = empty, processedOnlinePayment = empty, createdAt = system.now, actualOnlineSubmittedAt = empty, completedAt = empty, cancelledAt = empty, cancellationReason = empty)
    }
    on query GetOnlineOrder is {
      do "look up OnlineOrder by GetOnlineOrder.onlineOrderId"
      let onlineOrderResult: type OnlineOrderResult = prompt("read the online order from the store")
      reply onlineOrderResult
    }
    on onlinePointsAccrualRouted: event OnlinePointsAccrualRouted is {
      do "apply OnlinePointsAccrualRouted to the onlineOrder so it can be persisted and replayed"
    }
    on onlineTicketRouted: event OnlineTicketRouted is {
      do "apply OnlineTicketRouted to the onlineOrder so it can be persisted and replayed"
    }
  } with {
    briefly "Online order creation handler"
    described as {
      |Handles the initial BrowseMenu command when
      |the entity has no state yet.
    }
  }
} with {
  briefly "Online order entity"
  described as {
    | Manages the lifecycle of an online order from menu
    | browsing through cart management, fulfillment selection,
    | submission, and payment. State handlers ensure commands
    | are only valid in appropriate states, and events are
    | persisted before state transitions. Cancellation is
    | allowed from any state before delivery dispatch, with
    | automatic refund if payment was processed.
  }
}
