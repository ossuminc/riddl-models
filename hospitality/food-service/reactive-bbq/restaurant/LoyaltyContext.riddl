// Loyalty bounded context
context Loyalty as router is {
  inlet LoyaltyAccountCommandStreamIn is type LoyaltyAccountCommand  outlet LoyaltyAccountCommandStreamOut is type LoyaltyAccountCommand
  inlet LoyaltyAccountResultStreamIn is result LoyaltyAccount.LoyaltyAccountResult  outlet LoyaltyAccountResultStreamOut is result LoyaltyAccount.LoyaltyAccountResult
  handler LoyaltyBoundary is {
    on enrollCustomer: command LoyaltyAccount.EnrollCustomer is {
      forward enrollCustomer to outlet Loyalty.LoyaltyAccountCommandStreamOut
    }
    on accruePoints: command LoyaltyAccount.AccruePoints is {
      forward accruePoints to outlet Loyalty.LoyaltyAccountCommandStreamOut
    }
    on redeemPoints: command LoyaltyAccount.RedeemPoints is {
      forward redeemPoints to outlet Loyalty.LoyaltyAccountCommandStreamOut
    }
    on suspendAccount: command LoyaltyAccount.SuspendAccount is {
      forward suspendAccount to outlet Loyalty.LoyaltyAccountCommandStreamOut
    }
    on reactivateAccount: command LoyaltyAccount.ReactivateAccount is {
      forward reactivateAccount to outlet Loyalty.LoyaltyAccountCommandStreamOut
    }
    on closeAccount: command LoyaltyAccount.CloseAccount is {
      forward closeAccount to outlet Loyalty.LoyaltyAccountCommandStreamOut
    }
    on loyaltyAccountResult: result LoyaltyAccount.LoyaltyAccountResult is {
      send loyaltyAccountResult to outlet Loyalty.LoyaltyAccountResultStreamOut
    }
    on other is {
      error "Unexpected message at the Loyalty boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'LoyaltyAccountProjection Storage' is from outlet Loyalty.LoyaltyAccountProjection.LoyaltyAccountProjectionToRepository to inlet Loyalty.LoyaltyAccountRepository.LoyaltyAccountRepositoryFromLoyaltyAccountProjection with {
    briefly "LoyaltyAccountProjection commands on their way to LoyaltyAccountRepository"
    described as {
      |Carries what leaves Loyalty.LoyaltyAccountProjection.LoyaltyAccountProjectionToRepository to Loyalty.LoyaltyAccountRepository.LoyaltyAccountRepositoryFromLoyaltyAccountProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'LoyaltyAccountCommand Stream Intake' is from outlet Loyalty.LoyaltyAccountCommandStreamOut to inlet Loyalty.LoyaltyAccount.LoyaltyAccountCommands  connector 'LoyaltyAccountResult Stream Egress' is from outlet Loyalty.LoyaltyAccountRepository.LoyaltyAccountRepositoryResponses to inlet Loyalty.LoyaltyAccountResultStreamIn  include "loyalty-types.riddl"
  include "LoyaltyAccount.riddl"
  constant PointsPerDollar: Natural = 10 with {
    briefly "Points earned per dollar of settled spend"
    described as {
      |The earn rate, held here because it is a business-wide decision and
      |not a property of any one account. Stated once so that dine-in,
      |online and delivery accrual cannot drift apart, and so that changing
      |it is one edit rather than a search.
    }
  }
  function PointsForSpend is { 
    requires type SpendForPoints
    returns  type PointsEarned
    return prompt("floor(spendAmount * PointsPerDollar)")
  } with {
    term EarnRate is "How much spend buys one loyalty point. Changing it revalues every future accrual at once, which is why it is stated in one place rather than at each call site."
    term Accrual is "Adding points to an account because a check was paid. Deliberately separate from the payment itself: the money settles first, and only a settled check earns."
    briefly "Points for a spend"
    described as {
      |Converts a paid check total into points at the current earn rate of ten
      |points per dollar. Pure and total: the same spend always yields the same
      |points, with no reference to the account it will be credited to. Held
      |here rather than inline in the handler so that accrual from dine-in,
      |online and delivery cannot drift apart.
    }
  }
  type LoyaltyAccountRepositoryCommand is one of {
    Loyalty.LoyaltyAccountRepository.PersistCustomerEnrolled or Loyalty.LoyaltyAccountRepository.PersistPointsAccrued or Loyalty.LoyaltyAccountRepository.PersistPointsRedeemed or Loyalty.LoyaltyAccountRepository.PersistAccountSuspended or Loyalty.LoyaltyAccountRepository.PersistAccountReactivated or Loyalty.LoyaltyAccountRepository.PersistAccountClosed
  } with {
    briefly "Anything that writes the LoyaltyAccountRepository"
    described as {
      |The persistence commands LoyaltyAccountRepository accepts. Entity events never reach
      |it directly; LoyaltyAccountProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository LoyaltyAccountRepository as flow is {
    inlet LoyaltyAccountRepositoryFromLoyaltyAccountProjection is type LoyaltyAccountRepositoryCommand    outlet LoyaltyAccountRepositoryResponses is result LoyaltyAccount.LoyaltyAccountResult
    record StoredLoyaltyAccount is {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "loyaltyAccountId"
        described as {
          |The loyaltyAccountId column of the stored loyaltyAccount row.
        }
      }
      customerEmail: String(5,254) with {
        briefly "customerEmail"
        described as {
          |The customerEmail column of the stored loyaltyAccount row.
        }
      }
      loyaltyCustomerId: LoyaltyCustomerId with {
        briefly "loyaltyCustomerId"
        described as {
          |The loyaltyCustomerId column of the stored loyaltyAccount row.
        }
      }
    } with {
      briefly "Stored loyaltyAccount row"
      described as {
        |The persistence shape of loyaltyAccount data as this repository stores it.
      }
    }
    schema LoyaltyAccountSchema is relational
      of accounts as record StoredLoyaltyAccount
        index on field StoredLoyaltyAccount.loyaltyAccountId
        index on field StoredLoyaltyAccount.loyaltyCustomerId
        index on field StoredLoyaltyAccount.customerEmail
 with {
      briefly "Loyalty account data schema"
      described as {
        |Relational schema for persisting loyalty account
        |state with indexes on account, customer, and email.
      }
    }
    command PersistCustomerEnrolled is {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist CustomerEnrolled"
      described as {
        |Instructs this repository to apply CustomerEnrolled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPointsAccrued is {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PointsAccrued"
      described as {
        |Instructs this repository to apply PointsAccrued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPointsRedeemed is {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PointsRedeemed"
      described as {
        |Instructs this repository to apply PointsRedeemed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountSuspended is {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist AccountSuspended"
      described as {
        |Instructs this repository to apply AccountSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountReactivated is {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist AccountReactivated"
      described as {
        |Instructs this repository to apply AccountReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountClosed is {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist AccountClosed"
      described as {
        |Instructs this repository to apply AccountClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler LoyaltyAccountPersistence is {
      on command PersistCustomerEnrolled is {
        do "insert row into LoyaltyAccountSchema.accounts with
          loyaltyAccountId, loyaltyCustomerId,
          customerDisplayName, customerEmail, pointBalance
          = 0, lifetimePoints = 0, enrolledAt = current
          timestamp"
      }
      on command PersistPointsAccrued is {
        do "update LoyaltyAccountSchema.accounts set
          pointBalance = pointBalance + accrualPoints,
          lifetimePoints = lifetimePoints + accrualPoints
          where loyaltyAccountId matches"
      }
      on command PersistPointsRedeemed is {
        do "update LoyaltyAccountSchema.accounts set
          pointBalance = pointBalance - redemptionPoints
          where loyaltyAccountId matches"
      }
      on command PersistAccountSuspended is {
        do "update LoyaltyAccountSchema.accounts where
          loyaltyAccountId matches"
      }
      on command PersistAccountReactivated is {
        do "update LoyaltyAccountSchema.accounts where
          loyaltyAccountId matches"
      }
      on command PersistAccountClosed is {
        do "update LoyaltyAccountSchema.accounts set
          closedAt = current timestamp where
          loyaltyAccountId matches"
      }
      on command LogLoyaltyAccountEvent is {
        do "append the loyalty account event to the LoyaltyAccount event log"
      }
    } with {
      briefly "Loyalty account persistence"
      described as {
        |Persists loyalty account events to the accounts table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Loyalty account repository"
    described as {
      |Stores and retrieves loyalty account data.
    }
  }
  projector LoyaltyAccountProjection as flow is {
    updates repository Loyalty.LoyaltyAccountRepository
    inlet LoyaltyAccountProjectionFromLoyaltyAccount is type LoyaltyAccountEvent    outlet LoyaltyAccountProjectionToRepository is type LoyaltyAccountRepositoryCommand
    handler LoyaltyAccountProjectionHandler is {
      on customerEnrolled: event LoyaltyAccount.CustomerEnrolled is {
        tell command Loyalty.LoyaltyAccountRepository.PersistCustomerEnrolled(loyaltyAccountId = customerEnrolled.loyaltyAccountId) to repository Loyalty.LoyaltyAccountRepository
      }
      on pointsAccrued: event LoyaltyAccount.PointsAccrued is {
        tell command Loyalty.LoyaltyAccountRepository.PersistPointsAccrued(loyaltyAccountId = pointsAccrued.loyaltyAccountId) to repository Loyalty.LoyaltyAccountRepository
      }
      on pointsRedeemed: event LoyaltyAccount.PointsRedeemed is {
        tell command Loyalty.LoyaltyAccountRepository.PersistPointsRedeemed(loyaltyAccountId = pointsRedeemed.loyaltyAccountId) to repository Loyalty.LoyaltyAccountRepository
      }
      on accountSuspended: event LoyaltyAccount.AccountSuspended is {
        tell command Loyalty.LoyaltyAccountRepository.PersistAccountSuspended(loyaltyAccountId = accountSuspended.loyaltyAccountId) to repository Loyalty.LoyaltyAccountRepository
      }
      on accountReactivated: event LoyaltyAccount.AccountReactivated is {
        tell command Loyalty.LoyaltyAccountRepository.PersistAccountReactivated(loyaltyAccountId = accountReactivated.loyaltyAccountId) to repository Loyalty.LoyaltyAccountRepository
      }
      on accountClosed: event LoyaltyAccount.AccountClosed is {
        tell command Loyalty.LoyaltyAccountRepository.PersistAccountClosed(loyaltyAccountId = accountClosed.loyaltyAccountId) to repository Loyalty.LoyaltyAccountRepository
      }
      on other is {
        do "not persisted: EnrollCustomerRejected, AccruePointsRejected, RedeemPointsRejected, SuspendAccountRejected and 2 more record no stored state"
      }
    } with {
      briefly "LoyaltyAccountProjection handler"
      described as {
        |Turns each LoyaltyAccount event into the repository command that writes it.
      }
    }
  } with {
    briefly "LoyaltyAccount persistence projection"
    described as {
      |Builds the stored LoyaltyAccount view from the entity's events.
    }
  }
  streamlet LoyaltyAccountEventSource as source is {
    outlet LoyaltyAccountEvents is type LoyaltyEvent
    handler LoyaltyAccountEventEmitter is {
      on other is {
        error "Unexpected message for source LoyaltyAccountEventSource"
      }
      on customerEnrolled: event LoyaltyAccount.CustomerEnrolled is {
        send customerEnrolled to outlet LoyaltyAccountEvents
      }
      on pointsAccrued: event LoyaltyAccount.PointsAccrued is {
        send pointsAccrued to outlet LoyaltyAccountEvents
      }
      on pointsRedeemed: event LoyaltyAccount.PointsRedeemed is {
        send pointsRedeemed to outlet LoyaltyAccountEvents
      }
      on accountSuspended: event LoyaltyAccount.AccountSuspended is {
        send accountSuspended to outlet LoyaltyAccountEvents
      }
      on accountReactivated: event LoyaltyAccount.AccountReactivated is {
        send accountReactivated to outlet LoyaltyAccountEvents
      }
      on accountClosed: event LoyaltyAccount.AccountClosed is {
        send accountClosed to outlet LoyaltyAccountEvents
      }
    } with {
      briefly "Loyalty account event emitter"
      described as {
        |Emits loyalty account lifecycle events.
      }
    }
  } with {
    briefly "Loyalty account event source"
    described as {
      |Publishes loyalty account entity events.
    }
  }
  adaptor FromMarketing from context Corporate.Marketing is { 
    handler CampaignEventIntake is {
      on event Corporate.Marketing.Campaign.CampaignLaunched is {
        let accruePoints: type LoyaltyAccount.AccruePoints = prompt("the accrue points that results from campaign launched")
        tell accruePoints to entity Loyalty.LoyaltyAccount
        do "apply loyalty bonus from launched campaign promotion"
      }
      on event Corporate.Marketing.Campaign.CampaignEnded is {
        let accruePoints: type LoyaltyAccount.AccruePoints = prompt("the accrue points that results from campaign ended")
        tell accruePoints to entity Loyalty.LoyaltyAccount
        do "finalize campaign promotion points for loyalty accounts"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketing"
      }
    } with {
      briefly "Campaign event intake"
      described as {
        |Processes incoming campaign events for promotion
        |distribution to loyalty accounts.
      }
    }
  } with {
    briefly "Campaign event sink"
    described as {
      |Receives campaign events from the streaming topology
      |for promotion distribution to loyalty accounts.
    }
  }
  adaptor FromPayment from context Restaurant.FrontOfHouse is { 
    handler DineInLoyaltyIntake is {
      on event Restaurant.FrontOfHouse.TableOrder.PaymentProcessed is {
        let pointsEarned = call function PointsForSpend(spendAmount = "event.orderPayment.paymentAmount")
        when prompt("loyalty account exists for table association") then
          do "construct AccruePoints with loyaltyAccountId
            looked up by table association, accrualPoints =
            pointsEarned, accrualReason = dine-in purchase,
            accrualOrderRef = event.tableOrderId"
          let accruePoints: type AccruePoints = prompt("the accrue points that results from payment processed")
          tell accruePoints to entity Loyalty.LoyaltyAccount
        end
      }
      on other is {
        error "Unexpected message for adaptor FromPayment"
      }
    } with {
      briefly "Dine-in loyalty intake"
      described as {
        |Accrues points from dine-in payments by calculating
        |points and forwarding to the loyalty account entity.
      }
    }
  } with {
    briefly "Front of house payment adaptor"
    described as {
      |Receives dine-in payment events for loyalty accrual.
    }
  }
  adaptor FromOnlinePayment from context Restaurant.OnlineOrdering is { 
    handler OnlineLoyaltyIntake is {
      on event Restaurant.OnlineOrdering.OnlineOrder.OnlinePaymentProcessed is {
        let pointsEarned = "event.onlinePayment
          .onlinePaymentAmount truncated to integer as
          accrualPoints"
        when prompt("loyalty account exists for event.customerId") then
          do "construct AccruePoints with loyaltyAccountId
            looked up by event.customerId, accrualPoints =
            pointsEarned, accrualReason = online purchase,
            accrualOrderRef = event.onlineOrderId"
          let accruePoints: type AccruePoints = prompt("the accrue points that results from online payment processed")
          tell accruePoints to entity Loyalty.LoyaltyAccount
        end
      }
      on other is {
        error "Unexpected message for adaptor FromOnlinePayment"
      }
    } with {
      briefly "Online loyalty intake"
      described as {
        |Accrues points from online payments by calculating
        |points and forwarding to the loyalty account entity.
      }
    }
  } with {
    briefly "Online payment adaptor"
    described as {
      |Receives online payment events for loyalty accrual.
    }
  }
  // ---- Local event log for loyalty account events ----
  command LogLoyaltyAccountEvent is {
    loggedLoyaltyAccountId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the loyalty account the logged event concerns.
      }
    }
    loggedLoyaltyAccountEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of loyalty account event in one place and must not bind to any
        |single event's shape.
      }
    }
  } with {
    briefly "Log loyalty account event"
    described as {
      |Append a published loyalty account event to this context's event log.
    }
  }
  streamlet LoyaltyAccountEventLog as sink is {
    inlet IncomingLoyaltyAccountLog is type LoyaltyEvent    handler LoyaltyAccountLogIntake is {
      on other is {
        let logLoyaltyAccountEvent: type LogLoyaltyAccountEvent = prompt("the log loyalty account event to issue for this this")
        tell logLoyaltyAccountEvent to repository Loyalty.LoyaltyAccountRepository
        do "append the loyalty account event to the context event log"
      }
    } with {
      briefly "LoyaltyAccount log intake"
      described as {
        |Routes every published loyalty account event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "LoyaltyAccount event log"
    described as {
      |Durable local log of loyalty account events this context publishes.
    }
  }
  connector LoyaltyAccountToLog is from outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents to inlet Loyalty.LoyaltyAccountEventLog.IncomingLoyaltyAccountLog with {
    briefly "LoyaltyAccount event log connector"
    described as {
      |Wires published loyalty account events to the context's event log.
    }
  }
  connector 'LoyaltyAccountEvent Storage' is from outlet Loyalty.LoyaltyAccount.LoyaltyAccountEvents2 to inlet Loyalty.LoyaltyAccountProjection.LoyaltyAccountProjectionFromLoyaltyAccount with {
    briefly "LoyaltyAccount events on their way to storage"
    described as {
      |Carries what leaves LoyaltyAccountEvents2 to LoyaltyAccountRepositoryFromLoyaltyAccount, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  briefly "Loyalty context"
  described as {
    | Manages loyalty program enrollment, point accrual from
    | both dine-in and online purchases, and point redemption.
    | Isolated as its own bounded context so the loyalty
    | program can be developed and rolled out independently
    | without touching any other context.
  }
}
