// Loyalty bounded context
context Loyalty is {
  include "loyalty-types.riddl"
  include "LoyaltyAccount.riddl"
  repository LoyaltyAccountRepository as flow is {
    inlet LoyaltyAccountRepositoryFromLoyaltyAccount is type LoyaltyAccountEvent    outlet LoyaltyAccountRepositoryResponses is type LoyaltyAccount.LoyaltyAccountResult
    record StoredLoyaltyAccount is  {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "loyaltyAccountId"
        described as {
          |The loyaltyAccountId column of the stored loyaltyAccount row.
        }
      }
      customerEmail: String(5,254) with {
        briefly "customerEmail"
        described as {
          |The customerEmail column of the stored loyaltyAccount row.
        }
      }
      loyaltyCustomerId: LoyaltyCustomerId with {
        briefly "loyaltyCustomerId"
        described as {
          |The loyaltyCustomerId column of the stored loyaltyAccount row.
        }
      }
    } with {
      briefly "Stored loyaltyAccount row"
      described as {
        |The persistence shape of loyaltyAccount data as this repository stores it.
      }
    }
    schema LoyaltyAccountSchema is relational
      of accounts as type StoredLoyaltyAccount
        index on field StoredLoyaltyAccount.loyaltyAccountId
        index on field StoredLoyaltyAccount.loyaltyCustomerId
        index on field StoredLoyaltyAccount.customerEmail
 with {
      briefly "Loyalty account data schema"
      described as {
        |Relational schema for persisting loyalty account
        |state with indexes on account, customer, and email.
      }
    }
    command PersistCustomerEnrolled is  {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist CustomerEnrolled"
      described as {
        |Instructs this repository to apply CustomerEnrolled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPointsAccrued is  {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PointsAccrued"
      described as {
        |Instructs this repository to apply PointsAccrued to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPointsRedeemed is  {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PointsRedeemed"
      described as {
        |Instructs this repository to apply PointsRedeemed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountSuspended is  {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist AccountSuspended"
      described as {
        |Instructs this repository to apply AccountSuspended to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountReactivated is  {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist AccountReactivated"
      described as {
        |Instructs this repository to apply AccountReactivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAccountClosed is  {
      loyaltyAccountId: LoyaltyAccountId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist AccountClosed"
      described as {
        |Instructs this repository to apply AccountClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler LoyaltyAccountPersistence is {
      on command PersistCustomerEnrolled is {
        do "insert row into LoyaltyAccountSchema.accounts with
          loyaltyAccountId, loyaltyCustomerId,
          customerDisplayName, customerEmail, pointBalance
          = 0, lifetimePoints = 0, enrolledAt = current
          timestamp"
      }
      on command PersistPointsAccrued is {
        do "update LoyaltyAccountSchema.accounts set
          pointBalance = pointBalance + accrualPoints,
          lifetimePoints = lifetimePoints + accrualPoints
          where loyaltyAccountId matches"
      }
      on command PersistPointsRedeemed is {
        do "update LoyaltyAccountSchema.accounts set
          pointBalance = pointBalance - redemptionPoints
          where loyaltyAccountId matches"
      }
      on command PersistAccountSuspended is {
        do "update LoyaltyAccountSchema.accounts where
          loyaltyAccountId matches"
      }
      on command PersistAccountReactivated is {
        do "update LoyaltyAccountSchema.accounts where
          loyaltyAccountId matches"
      }
      on command PersistAccountClosed is {
        do "update LoyaltyAccountSchema.accounts set
          closedAt = current timestamp where
          loyaltyAccountId matches"
      }
      on command LogLoyaltyAccountEvent is {
        do "append the loyalty account event to the LoyaltyAccount event log"
      }
    } with {
      briefly "Loyalty account persistence"
      described as {
        |Persists loyalty account events to the accounts table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Loyalty account repository"
    described as {
      |Stores and retrieves loyalty account data.
    }
  }
  processor LoyaltyAccountEventSource as source is {
    outlet LoyaltyAccountEvents is type LoyaltyEvent
    handler LoyaltyAccountEventEmitter is {
      on init is {
        tell command InitializeLoyaltyAccount to entity Loyalty.LoyaltyAccount
      }
      on other is {
        error "Unexpected message for source LoyaltyAccountEventSource"
      }
      on event LoyaltyAccount.CustomerEnrolled is {
        send event LoyaltyAccount.CustomerEnrolled to outlet LoyaltyAccountEvents
      }
      on event LoyaltyAccount.PointsAccrued is {
        send event LoyaltyAccount.PointsAccrued to outlet LoyaltyAccountEvents
      }
      on event LoyaltyAccount.PointsRedeemed is {
        send event LoyaltyAccount.PointsRedeemed to outlet LoyaltyAccountEvents
      }
      on event LoyaltyAccount.AccountSuspended is {
        send event LoyaltyAccount.AccountSuspended to outlet LoyaltyAccountEvents
      }
      on event LoyaltyAccount.AccountReactivated is {
        send event LoyaltyAccount.AccountReactivated to outlet LoyaltyAccountEvents
      }
      on event LoyaltyAccount.AccountClosed is {
        send event LoyaltyAccount.AccountClosed to outlet LoyaltyAccountEvents
      }
    } with {
      briefly "Loyalty account event emitter"
      described as {
        |Emits loyalty account lifecycle events.
      }
    }
  } with {
    briefly "Loyalty account event source"
    described as {
      |Publishes loyalty account entity events.
    }
  }
  adaptor FromMarketing from context Corporate.Marketing is { 
    handler CampaignEventIntake is {
      on event Corporate.Marketing.Campaign.CampaignLaunched is {
        tell command LoyaltyAccount.AccruePoints to entity Loyalty.LoyaltyAccount
        do "apply loyalty bonus from launched campaign promotion"
      }
      on event Corporate.Marketing.Campaign.CampaignEnded is {
        tell command LoyaltyAccount.AccruePoints to entity Loyalty.LoyaltyAccount
        do "finalize campaign promotion points for loyalty accounts"
      }
      on other is {
        error "Unexpected message for adaptor FromMarketing"
      }
    } with {
      briefly "Campaign event intake"
      described as {
        |Processes incoming campaign events for promotion
        |distribution to loyalty accounts.
      }
    }
  } with {
    briefly "Campaign event sink"
    described as {
      |Receives campaign events from the streaming topology
      |for promotion distribution to loyalty accounts.
    }
  }
  adaptor FromPayment from context Restaurant.FrontOfHouse is { 
    handler DineInLoyaltyIntake is {
      on event Restaurant.FrontOfHouse.TableOrder.PaymentProcessed is {
        let pointsEarned = "event.orderPayment.paymentAmount
          truncated to integer as accrualPoints"
        when prompt("loyalty account exists for table association") then
          do "construct AccruePoints with loyaltyAccountId
            looked up by table association, accrualPoints =
            pointsEarned, accrualReason = dine-in purchase,
            accrualOrderRef = event.tableOrderId"
          tell command AccruePoints to entity Loyalty.LoyaltyAccount
        end
      }
      on other is {
        error "Unexpected message for adaptor FromPayment"
      }
    } with {
      briefly "Dine-in loyalty intake"
      described as {
        |Accrues points from dine-in payments by calculating
        |points and forwarding to the loyalty account entity.
      }
    }
  } with {
    briefly "Front of house payment adaptor"
    described as {
      |Receives dine-in payment events for loyalty accrual.
    }
  }
  adaptor FromOnlinePayment from context Restaurant.OnlineOrdering is { 
    handler OnlineLoyaltyIntake is {
      on event Restaurant.OnlineOrdering.OnlineOrder.OnlinePaymentProcessed is {
        let pointsEarned = "event.onlinePayment
          .onlinePaymentAmount truncated to integer as
          accrualPoints"
        when prompt("loyalty account exists for event.customerId") then
          do "construct AccruePoints with loyaltyAccountId
            looked up by event.customerId, accrualPoints =
            pointsEarned, accrualReason = online purchase,
            accrualOrderRef = event.onlineOrderId"
          tell command AccruePoints to entity Loyalty.LoyaltyAccount
        end
      }
      on other is {
        error "Unexpected message for adaptor FromOnlinePayment"
      }
    } with {
      briefly "Online loyalty intake"
      described as {
        |Accrues points from online payments by calculating
        |points and forwarding to the loyalty account entity.
      }
    }
  } with {
    briefly "Online payment adaptor"
    described as {
      |Receives online payment events for loyalty accrual.
    }
  }
  // ---- Local event log for loyalty account events ----
  command LogLoyaltyAccountEvent is  {
    loggedLoyaltyAccountId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the loyalty account the logged event concerns.
      }
    }
    loggedLoyaltyAccountEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of loyalty account event in one place and must not bind to any
        |single event's shape.
      }
    }
  } with {
    briefly "Log loyalty account event"
    described as {
      |Append a published loyalty account event to this context's event log.
    }
  }
  processor LoyaltyAccountEventLog as sink is {
    inlet IncomingLoyaltyAccountLog is type LoyaltyEvent    handler LoyaltyAccountLogIntake is {
      on other is {
        tell command LogLoyaltyAccountEvent to repository Loyalty.LoyaltyAccountRepository
        do "append the loyalty account event to the context event log"
      }
    } with {
      briefly "LoyaltyAccount log intake"
      described as {
        |Routes every published loyalty account event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "LoyaltyAccount event log"
    described as {
      |Durable local log of loyalty account events this context publishes.
    }
  }
  connector LoyaltyAccountToLog is from outlet Loyalty.LoyaltyAccountEventSource.LoyaltyAccountEvents to inlet Loyalty.LoyaltyAccountEventLog.IncomingLoyaltyAccountLog with {
    briefly "LoyaltyAccount event log connector"
    described as {
      |Wires published loyalty account events to the context's event log.
    }
  }
  connector 'LoyaltyAccountEvent Storage' is from outlet Loyalty.LoyaltyAccount.LoyaltyAccountEvents2 to inlet Loyalty.LoyaltyAccountRepository.LoyaltyAccountRepositoryFromLoyaltyAccount with {
    briefly "LoyaltyAccount events on their way to storage"
  }
} with {
  briefly "Loyalty context"
  described as {
    | Manages loyalty program enrollment, point accrual from
    | both dine-in and online purchases, and point redemption.
    | Isolated as its own bounded context so the loyalty
    | program can be developed and rolled out independently
    | without touching any other context.
  }
}
