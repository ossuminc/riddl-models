// KitchenTicket entity for the Kitchen context
event-sourced entity KitchenTicket as flow is {
  type KitchenTicketCommand is one of {
    KitchenTicket.ReceiveTicket or KitchenTicket.AssignStation or KitchenTicket.StartPreparation or KitchenTicket.MarkItemReady or KitchenTicket.ApproveTicket or KitchenTicket.NotifyServer
  } with {
    briefly "KitchenTicket command alternation"
    described as {
      |Commands accepted by the KitchenTicket entity.
    }
  }
  inlet KitchenTicketCommands is type KitchenTicketCommand  outlet KitchenTicketEvents2 is type KitchenTicketEvent
  // ---- Commands ----
  command ReceiveTicket yields event TicketReceived is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |Identifier for the new ticket.
      }
    }
    sourceOrderId: String(1,50) with {
      briefly "Source order ID"
      described as {
        |Identifier of the originating order.
      }
    }
    ticketSource: TicketSource with {
      briefly "Source"
      described as {
        |Whether from dine-in or online.
      }
    }
    ticketItems: TicketItem+ with {
      briefly "Items"
      described as {
        |Food items to prepare.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the ticket was received.
      }
    }
  } with {
    briefly "Receive ticket"
    described as {
      |Receive a new kitchen ticket from an order.
    }
  }
  command AssignStation yields event StationAssigned is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |Ticket to assign.
      }
    }
    assignedStation: StationName with {
      briefly "Station"
      described as {
        |Station to assign this ticket to.
      }
    }
  } with {
    briefly "Assign station"
    described as {
      |Assign the ticket to a kitchen station.
    }
  }
  command StartPreparation yields event PreparationStarted is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |Ticket to start preparing.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When preparation began.
      }
    }
  } with {
    briefly "Start preparation"
    described as {
      |Mark the ticket as being prepared.
    }
  }
  command MarkItemReady yields event ItemMarkedReady is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |Ticket containing the item.
      }
    }
    readyMenuItemId: String(1,50) with {
      briefly "Menu item ID"
      described as {
        |Which line item the station finished. A ticket is only ready when
        |every item on it has been marked, so the kitchen reports items one
        |at a time rather than closing the whole ticket at once.
      }
    }
    markedReadyAt: TimeStamp with {
      briefly "Marked at"
      described as {
        |When the item was marked ready.
      }
    }
  } with {
    briefly "Mark item ready"
    described as {
      |Mark an individual item on the ticket as ready.
    }
  }
  command ApproveTicket yields event TicketApproved is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |Ticket to approve.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved at"
      described as {
        |When the ticket was approved.
      }
    }
  } with {
    briefly "Approve ticket"
    described as {
      |Chef approves the completed ticket for serving.
    }
  }
  command NotifyServer yields event ServerNotified is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |Ticket that is ready.
      }
    }
    notifiedAt: TimeStamp with {
      briefly "Notified at"
      described as {
        |When the server was notified.
      }
    }
  } with {
    briefly "Notify server"
    described as {
      |Notify the server that the order is ready.
    }
  }
  // ---- Events ----
  event TicketReceived is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket just opened. Every later event in this ticket's life
        |carries the same value, so a ticket's whole passage through the
        |kitchen can be assembled from the event log.
      }
    }
    sourceOrderId: String(1,50) with {
      briefly "Source order ID"
      described as {
        |Originating order.
      }
    }
    ticketSource: TicketSource with {
      briefly "Source"
      described as {
        |Dine-in or online.
      }
    }
    ticketItems: TicketItem+ with {
      briefly "Items"
      described as {
        |Items to prepare.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the ticket hit the kitchen. This is time zero for the ticket
        |clock, and the baseline every downstream duration is measured from.
      }
    }
  } with {
    briefly "Ticket received"
    described as {
      |Emitted when a new kitchen ticket arrives.
    }
  }
  event StationAssigned is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket now routed to a station. Assignment is what makes a
        |ticket one station's responsibility rather than the kitchen's in
        |general.
      }
    }
    assignedStation: StationName with {
      term Expo is  "The expediting role standing between the kitchen and the floor: sequences tickets across stations so a table's dishes finish together, and approves a ticket before it leaves." 
      briefly "Station"
      described as {
        |Which station owns the cook — grill, fryer or prep. Station load is
        |what the expo balances when tickets stack up.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned at"
      described as {
        |When the station was assigned.
      }
    }
  } with {
    briefly "Station assigned"
    described as {
      |Emitted when a ticket is assigned to a station.
    }
  }
  event PreparationStarted is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket a station has begun cooking. The gap between this and the
        |ticket's arrival is queue time, the first place a slow night shows.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When preparation began.
      }
    }
  } with {
    briefly "Preparation started"
    described as {
      |Emitted when preparation begins on a ticket.
    }
  }
  event ItemMarkedReady is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket the finished item belongs to. Items complete out of
        |order, so this is how partial progress is attributed correctly.
      }
    }
    readyMenuItemId: String(1,50) with {
      briefly "Menu item ID"
      described as {
        |Which item came up. The ticket stays open until every item has been
        |reported, so this, not the ticket, is the unit of progress.
      }
    }
    markedReadyAt: TimeStamp with {
      briefly "Marked at"
      described as {
        |When the item came off the line. Items finishing far apart is the
        |signal that a ticket will go out cold, which is what the expo
        |watches for.
      }
    }
  } with {
    briefly "Item marked ready"
    described as {
      |Emitted when an item on a ticket is ready.
    }
  }
  event TicketApproved is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket the chef has passed. Approval is the kitchen's quality
        |gate — nothing leaves the pass without it.
      }
    }
    approvedAt: TimeStamp with {
      term Pass is  "The counter where finished plates wait to be collected by a server. Time spent at the pass is the costliest kind: the food is made, and only getting colder." 
      briefly "Approved at"
      described as {
        |When the chef released the ticket. From here to server pickup is
        |hold time at the pass, where finished food loses quality fastest.
      }
    }
  } with {
    briefly "Ticket approved"
    described as {
      |Emitted when the chef approves a completed ticket.
    }
  }
  event ServerNotified is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket whose food is up. Notification hands the order back to
        |the floor and ends the kitchen's part in it.
      }
    }
    notifiedAt: TimeStamp with {
      briefly "Notified at"
      described as {
        |When server was notified.
      }
    }
  } with {
    briefly "Server notified"
    described as {
      |Emitted when the server is notified food is ready.
    }
  }
  // ---- Rejection Events ----
  event ReceiveTicketRejected is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket that could not be opened — most often a duplicate, when
        |the same order reaches the kitchen by both dine-in and online.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the receive was rejected.
      }
    }
  } with {
    briefly "Receive ticket rejected"
    described as {
      |Emitted when a receive ticket command is rejected.
    }
  }
  event AssignStationRejected is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket that could not be routed, typically because the station
        |named is not one this kitchen runs.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the station assignment was rejected.
      }
    }
  } with {
    briefly "Assign station rejected"
    described as {
      |Emitted when an assign station command is rejected.
    }
  }
  event StartPreparationRejected is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket that could not be started, typically because no station
        |has taken it yet.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why starting preparation was rejected.
      }
    }
  } with {
    briefly "Start preparation rejected"
    described as {
      |Emitted when a start preparation command is rejected.
    }
  }
  event MarkItemReadyRejected is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket whose item could not be marked, typically because
        |preparation on it never started.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why marking item ready was rejected.
      }
    }
  } with {
    briefly "Mark item ready rejected"
    described as {
      |Emitted when a mark item ready command is rejected.
    }
  }
  event ApproveTicketRejected is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket the chef could not pass, typically because items on it
        |are still outstanding.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the ticket approval was rejected.
      }
    }
  } with {
    briefly "Approve ticket rejected"
    described as {
      |Emitted when an approve ticket command is rejected.
    }
  }
  event NotifyServerRejected is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket the floor could not be called for, typically because the
        |chef has not yet approved it.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the server notification was rejected.
      }
    }
  } with {
    briefly "Notify server rejected"
    described as {
      |Emitted when a notify server command is rejected.
    }
  }
  // ---- Queries ----
  query GetKitchenTicket replies result KitchenTicketResult is {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |Ticket to retrieve.
      }
    }
  } with {
    briefly "Get kitchen ticket"
    described as {
      |Query a kitchen ticket by its identifier.
    }
  }
  result KitchenTicketResult is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "KitchenTicket addressed"
      described as {
        |Which kitchenticket this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    ticket: KitchenTicketData with {
      briefly "Ticket"
      described as {
        |The requested ticket data.
      }
    }
  } with {
    briefly "Kitchen ticket result"
    described as {
      |Result containing the requested kitchen ticket data.
    }
  }
  // ---- State ----
  record KitchenTicketData is  {
    kitchenTicketId: KitchenTicketId with {
      briefly "ID"
      described as {
        |The ticket this state belongs to. Carried through every lifecycle
        |state so the record can be rebuilt by replaying the event log.
      }
    }
    sourceOrderId: String(1,50) with {
      briefly "Source order ID"
      described as {
        |Originating order.
      }
    }
    ticketSource: TicketSource with {
      briefly "Source"
      described as {
        |Dine-in or online.
      }
    }
    ticketItems: TicketItem+ with {
      briefly "Items"
      described as {
        |Everything the kitchen must produce for this order, each carrying
        |its own ready flag. The ticket is done only when all are marked.
      }
    }
    currentStation: StationName? with {
      briefly "Station"
      described as {
        |Assigned station.
      }
    }
    receivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the ticket was received.
      }
    }
    actualPreparationStartedAt: TimeStamp? with {
      briefly "Started at"
      described as {
        |When preparation began.
      }
    }
    ticketApprovedAt: TimeStamp? with {
      briefly "Approved at"
      described as {
        |When the chef passed the ticket, absent until they do. Its presence
        |is what separates food waiting at the pass from food still cooking.
      }
    }
  } with {
    briefly "Kitchen ticket state data"
    described as {
      |Full state of a kitchen ticket. Shared across all
      |lifecycle states as a superset record.
    }
  }
  initial state Received of record KitchenTicket.KitchenTicketData is {
    initial handler ReceivedInitHandler is {
      on init is {
        let ticketReceived: type TicketReceived = prompt("the ticket received that brings this kitchen ticket into existence")
        yield ticketReceived
      }
    } with {
      briefly "Received init handler"
      described as {
        |Initializes the Received state with default values.
      }
    }
    handler ReceivedHandler is {
      on assignStation: command AssignStation is {
        yield event StationAssigned(kitchenTicketId = assignStation.kitchenTicketId, assignedStation = assignStation.assignedStation, assignedAt = prompt("the assigned at of this station assigned"))
        send event StationAssigned(kitchenTicketId = assignStation.kitchenTicketId, assignedStation = assignStation.assignedStation, assignedAt = prompt("the assigned at of this station assigned")) to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
      }
      on stationAssigned: event StationAssigned is {
        morph entity Kitchen.KitchenTicket to state Kitchen.KitchenTicket.Assigned with record KitchenTicket.KitchenTicketData(kitchenTicketId = stationAssigned.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
        set field KitchenTicket.Assigned.currentStation to prompt("assignedStation from event")
        set state Assigned to record KitchenTicketData(kitchenTicketId = stationAssigned.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = empty, ticketApprovedAt = empty)
      }
      on receiveTicket: command ReceiveTicket is {
        send event ReceiveTicketRejected(kitchenTicketId = receiveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ReceiveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ReceiveTicket in this state"
      }
      on startPreparation: command StartPreparation is {
        send event StartPreparationRejected(kitchenTicketId = startPreparation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept StartPreparation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept StartPreparation in this state"
      }
      on markItemReady: command MarkItemReady is {
        send event MarkItemReadyRejected(kitchenTicketId = markItemReady.kitchenTicketId, rejectionReason = "KitchenTicket does not accept MarkItemReady in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept MarkItemReady in this state"
      }
      on approveTicket: command ApproveTicket is {
        send event ApproveTicketRejected(kitchenTicketId = approveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ApproveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ApproveTicket in this state"
      }
      on notifyServer: command NotifyServer is {
        send event NotifyServerRejected(kitchenTicketId = notifyServer.kitchenTicketId, rejectionReason = "KitchenTicket does not accept NotifyServer in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept NotifyServer in this state"
      }
    } with {
      briefly "Received state handler"
      described as {
        |Handles commands valid in the Received state.
        |Only AssignStation advances the lifecycle.
      }
    }
  } with {
    briefly "Ticket received"
    described as {
      |Initial state when a ticket arrives from an order.
      |Awaiting station assignment.
    }
  }
  state Assigned of record KitchenTicket.KitchenTicketData is {
    initial handler AssignedInitHandler is {
      on init is {
        let stationAssigned: type StationAssigned = prompt("the station assigned that brings this kitchen into existence")
        yield stationAssigned
      }
    } with {
      briefly "Assigned init handler"
      described as {
        |Initializes the Assigned state with default values.
      }
    }
    handler AssignedHandler is {
      on startPreparation: command StartPreparation is {
        yield event PreparationStarted(kitchenTicketId = startPreparation.kitchenTicketId, startedAt = startPreparation.startedAt)
        send event PreparationStarted(kitchenTicketId = startPreparation.kitchenTicketId, startedAt = startPreparation.startedAt) to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
      }
      on preparationStarted: event PreparationStarted is {
        morph entity Kitchen.KitchenTicket to state Kitchen.KitchenTicket.InPreparation with record KitchenTicket.KitchenTicketData(kitchenTicketId = preparationStarted.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
        set field KitchenTicket.InPreparation.actualPreparationStartedAt to prompt("startedAt from event")
        set state KitchenTicket.InPreparation to record KitchenTicketData(kitchenTicketId = preparationStarted.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = empty)
      }
      on receiveTicket: command ReceiveTicket is {
        send event ReceiveTicketRejected(kitchenTicketId = receiveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ReceiveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ReceiveTicket in this state"
      }
      on assignStation: command AssignStation is {
        send event AssignStationRejected(kitchenTicketId = assignStation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept AssignStation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept AssignStation in this state"
      }
      on markItemReady: command MarkItemReady is {
        send event MarkItemReadyRejected(kitchenTicketId = markItemReady.kitchenTicketId, rejectionReason = "KitchenTicket does not accept MarkItemReady in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept MarkItemReady in this state"
      }
      on approveTicket: command ApproveTicket is {
        send event ApproveTicketRejected(kitchenTicketId = approveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ApproveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ApproveTicket in this state"
      }
      on notifyServer: command NotifyServer is {
        send event NotifyServerRejected(kitchenTicketId = notifyServer.kitchenTicketId, rejectionReason = "KitchenTicket does not accept NotifyServer in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept NotifyServer in this state"
      }
    } with {
      briefly "Assigned state handler"
      described as {
        |Handles commands valid in the Assigned state.
        |Only StartPreparation advances the lifecycle.
      }
    }
  } with {
    briefly "Station assigned"
    described as {
      |Ticket has been assigned to a kitchen station.
      |Awaiting start of preparation.
    }
  }
  state InPreparation of record KitchenTicket.KitchenTicketData is {
    initial handler InPreparationInitHandler is {
      on init is {
        let preparationStarted: type PreparationStarted = prompt("the preparation started that brings this kitchen into existence")
        yield preparationStarted
      }
    } with {
      briefly "InPreparation init handler"
      described as {
        |Initializes the InPreparation state with default values.
      }
    }
    handler InPreparationHandler is {
      on markItemReady: command MarkItemReady is {
        yield event ItemMarkedReady(kitchenTicketId = markItemReady.kitchenTicketId, readyMenuItemId = markItemReady.readyMenuItemId, markedReadyAt = markItemReady.markedReadyAt)
        send event ItemMarkedReady(kitchenTicketId = markItemReady.kitchenTicketId, readyMenuItemId = markItemReady.readyMenuItemId, markedReadyAt = markItemReady.markedReadyAt) to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
      }
      on itemMarkedReady: event ItemMarkedReady is {
        do "set KitchenTicketData.ticketItems[
          ItemMarkedReady.readyMenuItemId].ticketItemReady
          = true"
        when prompt("all KitchenTicketData.ticketItems have
          ticketItemReady = true") then
          morph entity Kitchen.KitchenTicket to state Kitchen.KitchenTicket.ItemsReady with record KitchenTicket.KitchenTicketData(kitchenTicketId = itemMarkedReady.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
        end
        set state ItemsReady to record KitchenTicketData(kitchenTicketId = itemMarkedReady.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = empty)
      }
      on receiveTicket: command ReceiveTicket is {
        send event ReceiveTicketRejected(kitchenTicketId = receiveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ReceiveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ReceiveTicket in this state"
      }
      on assignStation: command AssignStation is {
        send event AssignStationRejected(kitchenTicketId = assignStation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept AssignStation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept AssignStation in this state"
      }
      on startPreparation: command StartPreparation is {
        send event StartPreparationRejected(kitchenTicketId = startPreparation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept StartPreparation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept StartPreparation in this state"
      }
      on approveTicket: command ApproveTicket is {
        send event ApproveTicketRejected(kitchenTicketId = approveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ApproveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ApproveTicket in this state"
      }
      on notifyServer: command NotifyServer is {
        send event NotifyServerRejected(kitchenTicketId = notifyServer.kitchenTicketId, rejectionReason = "KitchenTicket does not accept NotifyServer in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept NotifyServer in this state"
      }
    } with {
      briefly "InPreparation state handler"
      described as {
        |Handles commands valid in the InPreparation state.
        |MarkItemReady updates individual items and conditionally
        |transitions to ItemsReady when all items are complete.
      }
    }
  } with {
    briefly "In preparation"
    described as {
      |Station is actively preparing the items on this
      |ticket. Individual items are marked ready as they
      |are completed.
    }
  }
  state ItemsReady of record KitchenTicket.KitchenTicketData is {
    initial handler ItemsReadyInitHandler is {
      on init is {
        let itemMarkedReady: type ItemMarkedReady = prompt("the item marked ready that brings this kitchen into existence")
        yield itemMarkedReady
      }
    } with {
      briefly "ItemsReady init handler"
      described as {
        |Initializes the ItemsReady state with default values.
      }
    }
    handler ItemsReadyHandler is {
      on approveTicket: command ApproveTicket is {
        yield event TicketApproved(kitchenTicketId = approveTicket.kitchenTicketId, approvedAt = approveTicket.approvedAt)
        send event TicketApproved(kitchenTicketId = approveTicket.kitchenTicketId, approvedAt = approveTicket.approvedAt) to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
      }
      on ticketApproved: event TicketApproved is {
        morph entity Kitchen.KitchenTicket to state Kitchen.KitchenTicket.Approved with record KitchenTicket.KitchenTicketData(kitchenTicketId = ticketApproved.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
        set field KitchenTicket.Approved.ticketApprovedAt to prompt("approvedAt from event")
        tell command NotifyServer(kitchenTicketId = ticketApproved.kitchenTicketId, notifiedAt = prompt("the notified at of this notify server")) to entity Kitchen.KitchenTicket
        set state Approved to record KitchenTicketData(kitchenTicketId = ticketApproved.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
      }
      on receiveTicket: command ReceiveTicket is {
        send event ReceiveTicketRejected(kitchenTicketId = receiveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ReceiveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ReceiveTicket in this state"
      }
      on assignStation: command AssignStation is {
        send event AssignStationRejected(kitchenTicketId = assignStation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept AssignStation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept AssignStation in this state"
      }
      on startPreparation: command StartPreparation is {
        send event StartPreparationRejected(kitchenTicketId = startPreparation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept StartPreparation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept StartPreparation in this state"
      }
      on markItemReady: command MarkItemReady is {
        send event MarkItemReadyRejected(kitchenTicketId = markItemReady.kitchenTicketId, rejectionReason = "KitchenTicket does not accept MarkItemReady in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept MarkItemReady in this state"
      }
      on notifyServer: command NotifyServer is {
        send event NotifyServerRejected(kitchenTicketId = notifyServer.kitchenTicketId, rejectionReason = "KitchenTicket does not accept NotifyServer in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept NotifyServer in this state"
      }
    } with {
      briefly "ItemsReady state handler"
      described as {
        |Handles commands valid in the ItemsReady state.
        |ApproveTicket advances the lifecycle and auto-triggers
        |server notification.
      }
    }
  } with {
    briefly "All items ready"
    described as {
      |All items on the ticket have been prepared.
      |Awaiting chef quality approval.
    }
  }
  state Approved of record KitchenTicket.KitchenTicketData is {
    initial handler ApprovedInitHandler is {
      on init is {
        let ticketApproved: type TicketApproved = prompt("the ticket approved that brings this kitchen into existence")
        yield ticketApproved
      }
    } with {
      briefly "Approved init handler"
      described as {
        |Initializes the Approved state with default values.
      }
    }
    handler ApprovedHandler is {
      on notifyServer: command NotifyServer is {
        yield event ServerNotified(kitchenTicketId = notifyServer.kitchenTicketId, notifiedAt = notifyServer.notifiedAt)
        send event ServerNotified(kitchenTicketId = notifyServer.kitchenTicketId, notifiedAt = notifyServer.notifiedAt) to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
      }
      on serverNotified: event ServerNotified is {
        morph entity Kitchen.KitchenTicket to state Kitchen.KitchenTicket.ServerNotifiedState with record KitchenTicket.KitchenTicketData(kitchenTicketId = serverNotified.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
        do "ServerNotified event triggers push notification to
          server via NotificationService streaming topology"
        set state ServerNotifiedState to record KitchenTicketData(kitchenTicketId = serverNotified.kitchenTicketId, sourceOrderId = KitchenTicketData.sourceOrderId, ticketSource = KitchenTicketData.ticketSource, ticketItems = KitchenTicketData.ticketItems, currentStation = KitchenTicketData.currentStation, receivedAt = KitchenTicketData.receivedAt, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
      }
      on receiveTicket: command ReceiveTicket is {
        send event ReceiveTicketRejected(kitchenTicketId = receiveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ReceiveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ReceiveTicket in this state"
      }
      on assignStation: command AssignStation is {
        send event AssignStationRejected(kitchenTicketId = assignStation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept AssignStation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept AssignStation in this state"
      }
      on startPreparation: command StartPreparation is {
        send event StartPreparationRejected(kitchenTicketId = startPreparation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept StartPreparation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept StartPreparation in this state"
      }
      on markItemReady: command MarkItemReady is {
        send event MarkItemReadyRejected(kitchenTicketId = markItemReady.kitchenTicketId, rejectionReason = "KitchenTicket does not accept MarkItemReady in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept MarkItemReady in this state"
      }
      on approveTicket: command ApproveTicket is {
        send event ApproveTicketRejected(kitchenTicketId = approveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ApproveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ApproveTicket in this state"
      }
    } with {
      briefly "Approved state handler"
      described as {
        |Handles commands valid in the Approved state.
        |NotifyServer advances to the terminal state.
      }
    }
  } with {
    briefly "Chef approved"
    described as {
      |Chef has approved the completed ticket for serving.
      |Server notification is being sent.
    }
  }
  state ServerNotifiedState of record KitchenTicket.KitchenTicketData is {
    initial handler ServerNotifiedInitHandler is {
      on init is {
        let serverNotified: type ServerNotified = prompt("the server notified that brings this kitchen into existence")
        yield serverNotified
      }
    } with {
      briefly "ServerNotified init handler"
      described as {
        |Initializes the ServerNotifiedState with default values.
      }
    }
    handler ServerNotifiedHandler is {
      on receiveTicket: command ReceiveTicket is {
        send event ReceiveTicketRejected(kitchenTicketId = receiveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ReceiveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ReceiveTicket in this state"
      }
      on assignStation: command AssignStation is {
        send event AssignStationRejected(kitchenTicketId = assignStation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept AssignStation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept AssignStation in this state"
      }
      on startPreparation: command StartPreparation is {
        send event StartPreparationRejected(kitchenTicketId = startPreparation.kitchenTicketId, rejectionReason = "KitchenTicket does not accept StartPreparation in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept StartPreparation in this state"
      }
      on markItemReady: command MarkItemReady is {
        send event MarkItemReadyRejected(kitchenTicketId = markItemReady.kitchenTicketId, rejectionReason = "KitchenTicket does not accept MarkItemReady in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept MarkItemReady in this state"
      }
      on approveTicket: command ApproveTicket is {
        send event ApproveTicketRejected(kitchenTicketId = approveTicket.kitchenTicketId, rejectionReason = "KitchenTicket does not accept ApproveTicket in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept ApproveTicket in this state"
      }
      on notifyServer: command NotifyServer is {
        send event NotifyServerRejected(kitchenTicketId = notifyServer.kitchenTicketId, rejectionReason = "KitchenTicket does not accept NotifyServer in this state") to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
        error "KitchenTicket does not accept NotifyServer in this state"
      }
    } with {
      briefly "ServerNotified state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Server notified"
    described as {
      |Server has been notified that the order is ready
      |for pickup. Terminal state.
    }
  }
  handler KitchenTicketCreationHandler is {
    on receiveTicket: command ReceiveTicket is {
      yield event TicketReceived(kitchenTicketId = receiveTicket.kitchenTicketId, sourceOrderId = receiveTicket.sourceOrderId, ticketSource = receiveTicket.ticketSource, ticketItems = receiveTicket.ticketItems, receivedAt = receiveTicket.receivedAt)
      send event TicketReceived(kitchenTicketId = receiveTicket.kitchenTicketId, sourceOrderId = receiveTicket.sourceOrderId, ticketSource = receiveTicket.ticketSource, ticketItems = receiveTicket.ticketItems, receivedAt = receiveTicket.receivedAt) to outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents
    }
    on ticketReceived: event TicketReceived is {
      morph entity Kitchen.KitchenTicket to state Kitchen.KitchenTicket.Received with record KitchenTicket.KitchenTicketData(kitchenTicketId = ticketReceived.kitchenTicketId, sourceOrderId = ticketReceived.sourceOrderId, ticketSource = ticketReceived.ticketSource, ticketItems = ticketReceived.ticketItems, receivedAt = ticketReceived.receivedAt, currentStation = KitchenTicketData.currentStation, actualPreparationStartedAt = KitchenTicketData.actualPreparationStartedAt, ticketApprovedAt = KitchenTicketData.ticketApprovedAt)
      set state KitchenTicket.Received to record KitchenTicketData(kitchenTicketId = ticketReceived.kitchenTicketId, sourceOrderId = ticketReceived.sourceOrderId, ticketSource = ticketReceived.ticketSource, ticketItems = ticketReceived.ticketItems, receivedAt = ticketReceived.receivedAt, currentStation = empty, actualPreparationStartedAt = empty, ticketApprovedAt = empty)
    }
    on query GetKitchenTicket is {
      do "look up KitchenTicket by GetKitchenTicket.kitchenTicketId"
      let kitchenTicketResult: type KitchenTicketResult = prompt("read the kitchen ticket from the store")
      reply kitchenTicketResult
    }
      on approveTicketRejected: event ApproveTicketRejected is {
      do "apply ApproveTicketRejected to the kitchenTicket so it can be persisted and replayed"
    }
    on assignStationRejected: event AssignStationRejected is {
      do "apply AssignStationRejected to the kitchenTicket so it can be persisted and replayed"
    }
    on markItemReadyRejected: event MarkItemReadyRejected is {
      do "apply MarkItemReadyRejected to the kitchenTicket so it can be persisted and replayed"
    }
    on notifyServerRejected: event NotifyServerRejected is {
      do "apply NotifyServerRejected to the kitchenTicket so it can be persisted and replayed"
    }
    on receiveTicketRejected: event ReceiveTicketRejected is {
      do "apply ReceiveTicketRejected to the kitchenTicket so it can be persisted and replayed"
    }
    on startPreparationRejected: event StartPreparationRejected is {
      do "apply StartPreparationRejected to the kitchenTicket so it can be persisted and replayed"
    }
} with {
    briefly "Kitchen ticket creation handler"
    described as {
      |Handles the initial ReceiveTicket command when
      |the entity has no state yet.
    }
  }
} with {
  briefly "Kitchen ticket entity"
  described as {
    | Manages the lifecycle of a kitchen ticket from
    | receipt through station assignment, preparation,
    | quality approval, and server notification. State
    | handlers ensure commands are only valid in appropriate
    | states, and events are persisted before state
    | transitions for crash recovery safety.
  }
}
