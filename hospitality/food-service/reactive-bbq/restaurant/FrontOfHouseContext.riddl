  }
  connector LinkReservationToReservationEventSplit is {
    from outlet FrontOfHouse.Reservation.ReservationEvents2 to
      inlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitIn
  } with {
    briefly "LinkReservationToReservationEventSplit"
  }
  connector LinkReservationEventSplitToReservationRepository is {
    from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReservationRepository to
      inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservation
  } with {
    briefly "LinkReservationEventSplitToReservationRepository"
  }
  connector LinkReservationEventSplitToReservationBoard is {
    from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReservationBoard to
      inlet FrontOfHouse.ReservationBoard.ReservationBoardFromReservation
  } with {
    briefly "LinkReservationEventSplitToReservationBoard"
  }
  connector LinkTableOrderToTableOrderEventSplit is {
    from outlet FrontOfHouse.TableOrder.TableOrderEvents2 to
      inlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitIn
  } with {
    briefly "LinkTableOrderToTableOrderEventSplit"
  }
  connector LinkTableOrderEventSplitToTableOrderRepository is {
    from outlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitToTableOrderRepository to
      inlet FrontOfHouse.TableOrderRepository.TableOrderRepositoryFromTableOrder
  } with {
    briefly "LinkTableOrderEventSplitToTableOrderRepository"
  }
  connector LinkTableOrderEventSplitToReservationBoard is {
    from outlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitToReservationBoard to
      inlet FrontOfHouse.ReservationBoard.ReservationBoardFromTableOrder
  } with {
    briefly "LinkTableOrderEventSplitToReservationBoard"
  }
  connector LinkReservationBoardToReservationRepository is {
    from outlet FrontOfHouse.ReservationBoard.ReservationBoardOut to
      inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservationBoard
  } with {
    briefly "LinkReservationBoardToReservationRepository"
  }
} with {
  briefly "Front of house context"
  described as {
    | Manages reservations, table seating, dine-in orders,
    | billing, and payment. Communicates with kitchen, bar,
    | and loyalty contexts via adaptors.
  }
}
