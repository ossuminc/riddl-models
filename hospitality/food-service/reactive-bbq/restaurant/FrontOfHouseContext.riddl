// Front of House bounded context
context FrontOfHouse is {
  query GetReservationBoard is  {
    reservationBoardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which ReservationBoard to retrieve.
      }
    }
  } with {
    briefly "Get ReservationBoard"
    described as {
      |Retrieves a ReservationBoard projection.
    }
  }
  result ReservationBoardView is  {
    reservationBoard: ReservationBoardEntry with {
      briefly "ReservationBoard"
      described as {
        |The ReservationBoard data being returned.
      }
    }
  } with {
    briefly "ReservationBoard view"
    described as {
      |Read model view carrying a ReservationBoardEntry.
    }
  }
  include "front-of-house-types.riddl"
  include "Reservation.riddl"
  include "TableOrder.riddl"
  command NotifyDrinkReady is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order with ready drinks.
      }
    }
  } with {
    briefly "Notify drink ready"
    described as {
      |Notify that drinks are ready for a table order.
    }
  }
  command NotifyDrinksServed is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order with served drinks.
      }
    }
  } with {
    briefly "Notify drinks served"
    described as {
      |Notify that drinks have been served.
    }
  }
  command ApplyMenuItemUpdate is  {
    menuItemId: String(1,50) with {
      briefly "ID"
      described as {
        |Updated menu item.
      }
    }
  } with {
    briefly "Apply menu item update"
    described as {
      |Apply a menu item update from corporate.
    }
  }
  command ApplyMenuItemPriceChange is  {
    menuItemId: String(1,50) with {
      briefly "ID"
      described as {
        |Repriced menu item.
      }
    }
  } with {
    briefly "Apply menu item price change"
    described as {
      |Apply a menu item price change from corporate.
    }
  }
  command ApplyMenuRelease is  {
    releaseId: String(1,50) with {
      briefly "ID"
      described as {
        |Menu release to apply.
      }
    }
  } with {
    briefly "Apply menu release"
    described as {
      |Apply a published menu release from corporate.
    }
  }
  command RollbackMenuRelease is  {
    releaseId: String(1,50) with {
      briefly "ID"
      described as {
        |Menu release to roll back.
      }
    }
  } with {
    briefly "Rollback menu release"
    described as {
      |Roll back a menu release from corporate.
    }
  }
  command RecordNotificationAck is  {
    notificationId: String(1,50) with {
      briefly "ID"
      described as {
        |Notification that was acknowledged.
      }
    }
  } with {
    briefly "Record notification ack"
    described as {
      |Record a push notification delivery confirmation.
    }
  }
  repository ReservationRepository as merge is {
    inlet ReservationRepositoryFromReservation is type ReservationEvent    inlet ReservationRepositoryFromReservationBoard is type ReservationEvent    outlet ReservationRepositoryResponses is type ReservationBoardView
    record StoredReservation is  {
      reservationId: ReservationId with {
        briefly "reservationId"
        described as {
          |The reservationId column of the stored reservation row.
        }
      }
      guestName: GuestName with {
        briefly "guestName"
        described as {
          |The guestName column of the stored reservation row.
        }
      }
      reservationTime: TimeStamp with {
        briefly "reservationTime"
        described as {
          |The reservationTime column of the stored reservation row.
        }
      }
    } with {
      briefly "Stored reservation row"
      described as {
        |The persistence shape of reservation data as this repository stores it.
      }
    }
    record StoredTableOrder is  {
      tableOrderId: TableOrderId with {
        briefly "tableOrderId"
        described as {
          |The tableOrderId column of the stored tableOrder row.
        }
      }
      tableNumber: TableNumber with {
        briefly "tableNumber"
        described as {
          |The tableNumber column of the stored tableOrder row.
        }
      }
    } with {
      briefly "Stored tableOrder row"
      described as {
        |The persistence shape of tableOrder data as this repository stores it.
      }
    }
    schema ReservationSchema is relational
      of reservations as type StoredReservation
        index on field StoredReservation.reservationId
        index on field StoredReservation.guestName
        index on field StoredReservation.reservationTime
 with {
      briefly "Reservation data schema"
      described as {
        |Relational schema for persisting reservation state
        |with indexes on identifier, guest name, and time.
      }
    }
    command PersistReservationMade is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReservationMade"
      described as {
        |Instructs this repository to apply ReservationMade to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationConfirmed is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReservationConfirmed"
      described as {
        |Instructs this repository to apply ReservationConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCancelled is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReservationCancelled"
      described as {
        |Instructs this repository to apply ReservationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPartySeated is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PartySeated"
      described as {
        |Instructs this repository to apply PartySeated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVisitCompleted is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist VisitCompleted"
      described as {
        |Instructs this repository to apply VisitCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNoShowMarked is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist NoShowMarked"
      described as {
        |Instructs this repository to apply NoShowMarked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationRescheduled is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReservationRescheduled"
      described as {
        |Instructs this repository to apply ReservationRescheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler ReservationPersistence is {
      on command PersistReservationMade is {
        do "insert row into ReservationSchema.reservations
          with reservationId, guestName, guestPhone,
          partySize, reservationTime"
      }
      on command PersistReservationConfirmed is {
        do "update ReservationSchema.reservations set
          assignedTable = confirmedTable where reservationId
          matches"
      }
      on command PersistReservationCancelled is {
        do "update ReservationSchema.reservations where
          reservationId matches"
      }
      on command PersistPartySeated is {
        do "update ReservationSchema.reservations set
          seatedAt = seatedAt where reservationId matches"
      }
      on command PersistVisitCompleted is {
        do "update ReservationSchema.reservations set
          completedAt = completedAt where reservationId
          matches"
      }
      on command PersistNoShowMarked is {
        do "update ReservationSchema.reservations set
          markedNoShowAt = markedNoShowAt where
          reservationId matches"
      }
      on command PersistReservationRescheduled is {
        do "update ReservationSchema.reservations set
          reservationTime = newReservationTime where
          reservationId matches"
      }
      on command RecordNotificationAck is {
        do "log notification delivery confirmation for
          audit trail"
      }
      on command ApplyMenuRelease is {
        do "apply published menu release to restaurant"
      }
      on command RollbackMenuRelease is {
        do "rollback menu release at restaurant"
      }
      on command LogReservationEvent is {
        do "append the reservation event to the Reservation event log"
      }
      on query GetReservationBoard is {
        do "read the reservation board projection"
        reply result ReservationBoardView
      }
    } with {
      briefly "Reservation persistence"
      described as {
        |Persists reservation events to the reservations table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Reservation repository"
    described as {
      |Stores and retrieves reservation data.
    }
  }
  repository TableOrderRepository as flow is {
    inlet TableOrderRepositoryFromTableOrder is type TableOrderEvent    outlet TableOrderRepositoryResponses is type TableOrder.TableOrderResult
    schema TableOrderSchema is relational
      of orders as type StoredTableOrder
        index on field StoredTableOrder.tableOrderId
        index on field StoredTableOrder.tableNumber
 with {
      briefly "Table order data schema"
      described as {
        |Relational schema for persisting table order state
        |with indexes on order identifier and table number.
      }
    }
    command PersistOrderCreated is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderCreated"
      described as {
        |Instructs this repository to apply OrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAdded is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ItemAdded"
      described as {
        |Instructs this repository to apply ItemAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRemoved is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ItemRemoved"
      described as {
        |Instructs this repository to apply ItemRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderSubmitted is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderSubmitted"
      described as {
        |Instructs this repository to apply OrderSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderMarkedInPreparation is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderMarkedInPreparation"
      described as {
        |Instructs this repository to apply OrderMarkedInPreparation to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderMarkedReadyToServe is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderMarkedReadyToServe"
      described as {
        |Instructs this repository to apply OrderMarkedReadyToServe to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBillPresented is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist BillPresented"
      described as {
        |Instructs this repository to apply BillPresented to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderClosed is  {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderClosed"
      described as {
        |Instructs this repository to apply OrderClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler TableOrderPersistence is {
      on command PersistOrderCreated is {
        do "insert row into TableOrderSchema.orders with
          tableOrderId, tableNumber, serverId"
      }
      on command PersistItemAdded is {
        do "append addedItem OrderLine to orderItems array
          in TableOrderSchema.orders where tableOrderId
          matches"
      }
      on command PersistItemRemoved is {
        do "remove OrderLine with removedMenuItemId from
          orderItems array in TableOrderSchema.orders where
          tableOrderId matches"
      }
      on command PersistOrderSubmitted is {
        do "update TableOrderSchema.orders set
          actualSubmittedAt = submittedAt where tableOrderId
          matches"
      }
      on command PersistOrderMarkedInPreparation is {
        do "update TableOrderSchema.orders where
          tableOrderId matches"
      }
      on command PersistOrderMarkedReadyToServe is {
        do "update TableOrderSchema.orders set readyAt =
          readyAt where tableOrderId matches"
      }
      on command PersistBillPresented is {
        do "update TableOrderSchema.orders set
          presentedBillTotal = billTotal where tableOrderId
          matches"
      }
      on command PersistPaymentProcessed is {
        do "update TableOrderSchema.orders set
          processedPayment = orderPayment where tableOrderId
          matches"
      }
      on command PersistOrderClosed is {
        do "update TableOrderSchema.orders set actualClosedAt
          = closedAt where tableOrderId matches"
      }
      on command NotifyDrinkReady is {
        do "notify server that drinks are ready for table"
      }
      on command NotifyDrinksServed is {
        do "record drink readiness notification acknowledgment"
      }
      on command ApplyMenuItemUpdate is {
        do "update local menu item cache with changes"
      }
      on command ApplyMenuItemPriceChange is {
        do "update local menu pricing from corporate"
      }
      on command LogTableOrderEvent is {
        do "append the table order event to the TableOrder event log"
      }
    } with {
      briefly "Order persistence"
      described as {
        |Persists table order events to the orders table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Table order repository"
    described as {
      |Stores and retrieves table order data.
    }
  }
  projector ReservationBoard as merge is {
    updates repository FrontOfHouse.ReservationRepository
    inlet ReservationBoardFromReservation is type ReservationEvent    inlet ReservationBoardFromTableOrder is type TableOrderEvent    outlet ReservationBoardOut is type ReservationEvent
    record ReservationBoardEntry is  {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The booking this board row stands for. The host stand uses it to
          |pull up the full reservation when a party arrives at the door.
        }
      }
      guestName: GuestName with {
        briefly "Guest"
        described as {
          |The name the booking is held under. This is what the host reads
          |aloud when calling the party, so it is the guest's preferred name
          |rather than a legal one.
        }
      }
      partySize: PartySize with {
        briefly "Party size"
        described as {
          |Number of guests.
        }
      }
      reservationTime: TimeStamp with {
        briefly "Time"
        described as {
          |When the party is expected. The board sorts on this, and it is the
          |clock against which lateness and no-show timeouts are measured.
        }
      }
      reservationDisplayStatus: String(1,30) with {
        briefly "Status"
        described as {
          |Display status derived from entity state name.
        }
      }
      assignedTable: TableNumber? with {
        briefly "Table"
        described as {
          |The table this party has been given, once the host assigns one.
          |Absent while the booking is still waiting, which is how the board
          |distinguishes seated parties from those still to arrive.
        }
      }
    } with {
      briefly "Board entry"
      described as {
        |A single entry on the reservation board.
      }
    }
    handler ReservationBoardHandler is {
      on event Reservation.ReservationMade is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Requested"
        tell command PersistReservationMade to repository FrontOfHouse.ReservationRepository
        do "insert ReservationBoardEntry with reservationId =
          event.reservationId, guestName = event.guestName,
          partySize = event.partySize, reservationTime =
          event.reservationTime, reservationDisplayStatus = Requested,
          assignedTable = none"
      }
      on event Reservation.ReservationConfirmed is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Confirmed"
        tell command PersistReservationConfirmed to repository FrontOfHouse.ReservationRepository
        do "update ReservationBoardEntry set
          reservationDisplayStatus = Confirmed,
          assignedTable = event.confirmedTable
          where reservationId = event.reservationId"
      }
      on event Reservation.ReservationCancelled is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Cancelled"
        tell command PersistReservationCancelled to repository FrontOfHouse.ReservationRepository
        do "delete ReservationBoardEntry where reservationId =
          event.reservationId"
      }
      on event Reservation.PartySeated is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Seated"
        tell command PersistPartySeated to repository FrontOfHouse.ReservationRepository
        do "update ReservationBoardEntry set
          reservationDisplayStatus = Seated,
          assignedTable = event.seatedTable where
          reservationId = event.reservationId"
      }
    } with {
      briefly "Board event handler"
      described as {
        |Projects reservation events onto the real-time board
        |displayed at the host station, replacing the paper
        |backup system.
      }
    }
  } with {
    briefly "Reservation board projector"
    described as {
      | Real-time view of current reservations replacing
      | the host's paper backup system.
    }
  }
  processor OrderEventSource as source is {
    outlet SubmittedOrderEvents is type OrderEvent
    handler OrderEventEmitter is {
      on other is {
        error "Unexpected message for source OrderEventSource"
      }
      on event TableOrder.OrderSubmitted is {
        send event TableOrder.OrderSubmitted to outlet SubmittedOrderEvents
      }
    } with {
      briefly "Order event emitter"
      described as {
        |Emits order submission events to the streaming
        |topology when orders are submitted.
      }
    }
  } with {
    briefly "Order event source"
    described as {
      |Emits order submission events from the TableOrder entity
      |into the streaming topology for kitchen and bar routing.
    }
  }
  processor ReservationEventSource as source is {
    outlet ReservationEvents is type ReservationEvent
    handler ReservationEventEmitter is {
      on other is {
        error "Unexpected message for source ReservationEventSource"
      }
      on event Reservation.ReservationMade is {
        send event Reservation.ReservationMade to outlet ReservationEvents
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEvents
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEvents
      }
      on event Reservation.PartySeated is {
        send event Reservation.PartySeated to outlet ReservationEvents
      }
      on event Reservation.VisitCompleted is {
        send event Reservation.VisitCompleted to outlet ReservationEvents
      }
      on event Reservation.NoShowMarked is {
        send event Reservation.NoShowMarked to outlet ReservationEvents
      }
      on event Reservation.ReservationRescheduled is {
        send event Reservation.ReservationRescheduled to outlet ReservationEvents
      }
    } with {
      briefly "Reservation event emitter"
      described as {
        |Emits reservation lifecycle events into the streaming
        |topology for downstream consumers.
      }
    }
  } with {
    briefly "Reservation event source"
    described as {
      |Publishes reservation entity events for external
      |consumption via the streaming topology.
    }
  }
  processor TableOrderEventSource as source is {
    outlet TableOrderEvents is type OrderEvent
    handler TableOrderEventEmitter is {
      on other is {
        error "Unexpected message for source TableOrderEventSource"
      }
      on event TableOrder.OrderCreated is {
        send event TableOrder.OrderCreated to outlet TableOrderEvents
      }
      on event TableOrder.ItemAdded is {
        send event TableOrder.ItemAdded to outlet TableOrderEvents
      }
      on event TableOrder.OrderSubmitted is {
        send event TableOrder.OrderSubmitted to outlet TableOrderEvents
      }
      on event TableOrder.PaymentProcessed is {
        send event TableOrder.PaymentProcessed to outlet TableOrderEvents
      }
      on event TableOrder.OrderClosed is {
        send event TableOrder.OrderClosed to outlet TableOrderEvents
      }
    } with {
      briefly "Table order event emitter"
      described as {
        |Emits table order lifecycle events into the streaming
        |topology for downstream consumers.
      }
    }
  } with {
    briefly "Table order event source"
    described as {
      |Publishes table order entity events for external
      |consumption via the streaming topology.
    }
  }
  processor OrderSplitter as split is {
    inlet SubmittedOrders is type OrderEvent    outlet FoodOrders is type KitchenTicketEvent
    outlet DrinkOrders is type DrinkOrderEvent
    handler OrderSplitHandler is {
      on event TableOrder.OrderSubmitted is {
        send event TableOrder.OrderSubmitted to outlet FoodOrders
        send event TableOrder.OrderSubmitted to outlet DrinkOrders
      }
    } with {
      briefly "Order split handler"
      described as {
        |Routes food items to the kitchen outlet and drink
        |items to the bar outlet.
      }
    }
  } with {
    briefly "Order splitter streamlet"
    described as {
      |Splits submitted table orders into separate food and
      |drink streams. Food items flow to the kitchen context
      |and drink items flow to the bar context, ensuring
      |ordered processing during peak hours.
    }
  }
  adaptor ToKitchen to context Restaurant.Kitchen is { 
    handler KitchenRouting is {
      on event TableOrder.OrderSubmitted is {
        do "filter OrderSubmitted.orderItems where
          orderLineItem.itemCategory is not drink to produce
          food-only OrderLine list"
        do "map each food OrderLine to TicketItem with
          ticketMenuItemId = orderLineItem.itemCode,
          ticketItemName = orderLineItem.itemName,
          ticketItemQuantity = orderLineQuantity,
          ticketItemNotes = orderLineNotes,
          ticketItemReady = false"
        do "construct ReceiveTicket command with new
          KitchenTicketId, sourceOrderId =
          OrderSubmitted.tableOrderId, ticketSource = DineIn,
          ticketItems = mapped TicketItem list, receivedAt =
          current timestamp"
        tell command ReceiveTicket to entity Kitchen.KitchenTicket
        tell event TableOrder.TicketRouted to entity FrontOfHouse.TableOrder
      }
      on other is {
        error "Unexpected message for adaptor ToKitchen"
      }
    } with {
      briefly "Kitchen routing"
      described as {
        |Routes food items to kitchen context, transforming
        |order lines into kitchen ticket format.
      }
    }
  } with {
    briefly "Kitchen adaptor"
    described as {
      |Sends submitted food orders to the kitchen.
    }
  }
  adaptor ToBar to context Restaurant.Bar is { 
    handler BarRouting is {
      on event TableOrder.OrderSubmitted is {
        do "filter OrderSubmitted.orderItems where
          orderLineItem.itemCategory is drink to produce
          drink-only OrderLine list"
        do "map each drink OrderLine to DrinkItem with
          drinkName = orderLineItem.itemName,
          drinkQuantity = orderLineQuantity,
          drinkNotes = orderLineNotes"
        do "construct ReceiveDrinkOrder command with new
          DrinkOrderId, sourceOrderId =
          OrderSubmitted.tableOrderId, drinkTableNumber =
          OrderSubmitted.tableNumber, drinkItems = mapped
          DrinkItem list, drinkReceivedAt = current timestamp"
        tell command ReceiveDrinkOrder to entity Bar.DrinkOrder
        tell event TableOrder.DrinkOrderRouted to entity FrontOfHouse.TableOrder
      }
      on other is {
        error "Unexpected message for adaptor ToBar"
      }
    } with {
      briefly "Bar routing"
      described as {
        |Routes drink items to bar context, transforming
        |order lines into drink order format.
      }
    }
  } with {
    briefly "Bar adaptor"
    described as {
      |Sends submitted drink orders to the bar.
    }
  }
  adaptor ToLoyalty to context Restaurant.Loyalty is { 
    handler LoyaltyRouting is {
      on event TableOrder.PaymentProcessed is {
        let pointsEarned = "PaymentProcessed.orderPayment.paymentAmount
          truncated to integer as accrualPoints"
        do "construct AccruePoints command with loyaltyAccountId
          looked up by table association, accrualPoints =
          pointsEarned, accrualReason = dine-in purchase,
          accrualOrderRef = PaymentProcessed.tableOrderId"
        tell command AccruePoints to entity Loyalty.LoyaltyAccount
        tell event TableOrder.PointsAccrualRouted to entity FrontOfHouse.TableOrder
      }
      on other is {
        error "Unexpected message for adaptor ToLoyalty"
      }
    } with {
      briefly "Loyalty routing"
      described as {
        |Routes payment events for loyalty accrual, calculating
        |points from payment amounts.
      }
    }
  } with {
    briefly "Loyalty adaptor"
    described as {
      |Sends payment events to the loyalty context.
    }
  }
  adaptor PaymentGatewayAdapter from context PaymentGateway as flow is { 
    inlet IncomingPaymentGatewayEvents is type PaymentGatewayEvent    outlet TranslatedPaymentGatewayEvents is type PaymentGatewayEvent
    handler InboundPaymentGateway is {
      on event PaymentGateway.PaymentAuthorized is {
        send event PaymentGateway.PaymentAuthorized to outlet TranslatedPaymentGatewayEvents
      }
      on event PaymentGateway.PaymentCaptured is {
        send event PaymentGateway.PaymentCaptured to outlet TranslatedPaymentGatewayEvents
      }
      on other is {
        error "Unexpected message for adaptor PaymentGatewayAdapter"
      }
    } with {
      briefly "Inbound PaymentGateway translation"
      described as {
        |Receives PaymentGateway events and forwards them to FrontOfHouse. This is the
        |seam that keeps the payment provider plug-in replaceable: a different
        |provider is absorbed here rather than in PaymentResultSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for PaymentGateway"
    described as {
      |Stands between the external PaymentGateway and PaymentResultSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'PaymentGatewayEvent Stream' is from outlet FrontOfHouse.PaymentGatewayAdapter.TranslatedPaymentGatewayEvents to inlet FrontOfHouse.PaymentResultSink.IncomingPaymentResults with {
    briefly "PaymentGateway events, translated, on their way to the sink"
    described as {
      |Carries authorization and capture results from the anti-corruption layer to the sink that
      |applies them inside FrontOfHouse.
    }
  }
  processor PaymentResultSink as sink is {
    inlet IncomingPaymentResults is type PaymentGatewayEvent    handler PaymentResultHandler is {
      on event PaymentGateway.PaymentAuthorized is {
        tell command TableOrder.ProcessPayment to entity FrontOfHouse.TableOrder
        do "match PaymentAuthorized.paymentGatewayTransactionId
          to pending TableOrder by payment reference and
          trigger payment capture via PaymentGateway
          streaming topology"
      }
      on event PaymentGateway.PaymentCaptured is {
        tell command TableOrder.CloseOrder to entity FrontOfHouse.TableOrder
        do "mark payment as fully settled for the matching
          TableOrder using PaymentCaptured
          .captureTransactionId"
      }
    } with {
      briefly "Payment result handler"
      described as {
        |Processes asynchronous payment gateway responses,
        |capturing authorized payments and confirming
        |settlement back to the originating table order.
      }
    }
  } with {
    briefly "Payment result sink"
    described as {
      |Receives payment authorization and capture results
      |from the external payment gateway for two-phase
      |payment processing.
    }
  }
  adaptor NotificationServiceAdapter from context NotificationService as flow is { 
    inlet IncomingNotificationServiceEvents is type NotificationEvent    outlet TranslatedNotificationServiceEvents is type NotificationEvent
    handler InboundNotificationService is {
      on event NotificationService.PushNotificationSent is {
        send event NotificationService.PushNotificationSent to outlet TranslatedNotificationServiceEvents
      }
      on other is {
        error "Unexpected message for adaptor NotificationServiceAdapter"
      }
    } with {
      briefly "Inbound NotificationService translation"
      described as {
        |Receives NotificationService events and forwards them to FrontOfHouse. This is the
        |seam that keeps the notification provider plug-in replaceable: a different
        |provider is absorbed here rather than in NotificationAckSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for NotificationService"
    described as {
      |Stands between the external NotificationService and NotificationAckSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'NotificationEvent Stream' is from outlet FrontOfHouse.NotificationServiceAdapter.TranslatedNotificationServiceEvents to inlet FrontOfHouse.NotificationAckSink.NotificationAcks with {
    briefly "NotificationService events, translated, on their way to the sink"
    described as {
      |Carries push notification acknowledgements from the anti-corruption layer to the sink that
      |applies them inside FrontOfHouse.
    }
  }
  processor NotificationAckSink as sink is {
    inlet NotificationAcks is type NotificationEvent    handler NotificationAckHandler is {
      on event NotificationService.PushNotificationSent is {
        tell command RecordNotificationAck to repository FrontOfHouse.ReservationRepository
        do "log notification delivery confirmation for
          PushNotificationSent.notificationRecipient at
          PushNotificationSent.sentAt for audit trail"
      }
    } with {
      briefly "Notification acknowledgment handler"
      described as {
        |Logs push notification delivery confirmations
        |for audit trail.
      }
    }
  } with {
    briefly "Notification acknowledgment sink"
    described as {
      |Receives delivery confirmation events from the
      |external push notification service.
    }
  }
  connector SourceToSplitter is from outlet FrontOfHouse.OrderEventSource.SubmittedOrderEvents to inlet FrontOfHouse.OrderSplitter.SubmittedOrders with {
    briefly "Source to splitter connector"
    described as {
      |Wires order events from the source into the order
      |splitter for kitchen and bar routing.
    }
  }
  processor DrinkOrderEventSink as sink is {
    inlet IncomingDrinkOrderEvents is type DrinkOrderEvent    handler DrinkOrderEventIntake is {
      on event Restaurant.Bar.DrinkOrder.DrinkMarkedReady is {
        tell command NotifyDrinkReady to repository FrontOfHouse.TableOrderRepository
        do "notify server that drinks are ready for table"
      }
      on event Restaurant.Bar.DrinkOrder.ServerNotifiedDrinksReady is {
        tell command NotifyDrinksServed to repository FrontOfHouse.TableOrderRepository
        do "record drink readiness notification acknowledgment"
      }
    } with {
      briefly "Drink order event intake"
      described as {
        |Processes incoming drink order events for order
        |readiness notification.
      }
    }
  } with {
    briefly "Drink order event sink"
    described as {
      |Receives drink order events from the bar streaming
      |topology for order readiness notification.
    }
  }
  adaptor FromMenuManagementItems from context Corporate.MenuManagement is { 
    handler MenuItemEventIntake is {
      on event Corporate.MenuManagement.MenuItem.MenuItemUpdated is {
        tell command ApplyMenuItemUpdate to repository FrontOfHouse.TableOrderRepository
        do "update local menu item cache with changes"
      }
      on event Corporate.MenuManagement.MenuItem.PriceSet is {
        tell command ApplyMenuItemPriceChange to repository FrontOfHouse.TableOrderRepository
        do "update local menu pricing from corporate"
      }
      on other is {
        error "Unexpected message for adaptor FromMenuManagementItems"
      }
    } with {
      briefly "Menu item event intake"
      described as {
        |Processes incoming menu item events for local menu
        |updates.
      }
    }
    handler MenuReleaseEventIntake is {
      on event Corporate.MenuManagement.MenuRelease.ReleasePublished is {
        tell command ApplyMenuRelease to repository FrontOfHouse.ReservationRepository
        do "apply published menu release to restaurant"
      }
      on event Corporate.MenuManagement.MenuRelease.ReleaseRolledBack is {
        tell command RollbackMenuRelease to repository FrontOfHouse.ReservationRepository
        do "rollback menu release at restaurant"
      }
      on other is {
        error "Unexpected message for adaptor FromMenuManagementReleases"
      }
    } with {
      briefly "Menu release event intake"
      described as {
        |Processes incoming menu release events for menu
        |distribution.
      }
    }
  } with {
    briefly "Menu item event sink"
    described as {
      |Receives menu item events from the menu management
      |streaming topology for restaurant menu updates.
    }
  }
  // ---- Local event log for reservation events ----
  command LogReservationEvent is  {
    loggedReservationId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the reservation the logged event concerns.
      }
    }
    loggedReservationEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of reservation event in one place and must not bind to any single
        |event's shape.
      }
    }
  } with {
    briefly "Log reservation event"
    described as {
      |Append a published reservation event to this context's event log.
    }
  }
  processor ReservationEventLog as sink is {
    inlet IncomingReservationLog is type ReservationEvent    handler ReservationLogIntake is {
      on other is {
        tell command LogReservationEvent to repository FrontOfHouse.ReservationRepository
        do "append the reservation event to the context event log"
      }
    } with {
      briefly "Reservation log intake"
      described as {
        |Routes every published reservation event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "Reservation event log"
    described as {
      |Durable local log of reservation events this context publishes.
    }
  }
  connector ReservationToLog is from outlet FrontOfHouse.ReservationEventSource.ReservationEvents to inlet FrontOfHouse.ReservationEventLog.IncomingReservationLog with {
    briefly "Reservation event log connector"
    described as {
      |Wires published reservation events to the context's event log.
    }
  }
  // ---- Local event log for table order events ----
  command LogTableOrderEvent is  {
    loggedTableOrderId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the table order the logged event concerns.
      }
    }
    loggedTableOrderEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of table order event in one place and must not bind to any single
        |event's shape.
      }
    }
  } with {
    briefly "Log table order event"
    described as {
      |Append a published table order event to this context's event log.
    }
  }
  processor TableOrderEventLog as sink is {
    inlet IncomingTableOrderLog is type OrderEvent    handler TableOrderLogIntake is {
      on other is {
        tell command LogTableOrderEvent to repository FrontOfHouse.TableOrderRepository
        do "append the table order event to the context event log"
      }
    } with {
      briefly "TableOrder log intake"
      described as {
        |Routes every published table order event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "TableOrder event log"
    described as {
      |Durable local log of table order events this context publishes.
    }
  }
  connector TableOrderToLog is from outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents to inlet FrontOfHouse.TableOrderEventLog.IncomingTableOrderLog with {
    briefly "TableOrder event log connector"
    described as {
      |Wires published table order events to the context's event log.
    }
  }
  processor ReservationEventSplit as split is {
    inlet ReservationEventSplitIn is type ReservationEvent    outlet ReservationEventSplitToReservationRepository is type ReservationEvent
    outlet ReservationEventSplitToReservationBoard is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on event Reservation.ReservationMade is {
        send event Reservation.ReservationMade to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationMade to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.ReservationMade to entity FrontOfHouse.Reservation
      }
      on event Reservation.ReservationConfirmed is {
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationConfirmed to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.ReservationConfirmed to entity FrontOfHouse.Reservation
      }
      on event Reservation.ReservationCancelled is {
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationCancelled to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.ReservationCancelled to entity FrontOfHouse.Reservation
      }
      on event Reservation.PartySeated is {
        send event Reservation.PartySeated to outlet ReservationEventSplitToReservationRepository
        send event Reservation.PartySeated to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.PartySeated to entity FrontOfHouse.Reservation
      }
      on event Reservation.VisitCompleted is {
        send event Reservation.VisitCompleted to outlet ReservationEventSplitToReservationRepository
        send event Reservation.VisitCompleted to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.VisitCompleted to entity FrontOfHouse.Reservation
      }
      on event Reservation.NoShowMarked is {
        send event Reservation.NoShowMarked to outlet ReservationEventSplitToReservationRepository
        send event Reservation.NoShowMarked to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.NoShowMarked to entity FrontOfHouse.Reservation
      }
      on event Reservation.ReservationRescheduled is {
        send event Reservation.ReservationRescheduled to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ReservationRescheduled to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.ReservationRescheduled to entity FrontOfHouse.Reservation
      }
      on event Reservation.MakeReservationRejected is {
        send event Reservation.MakeReservationRejected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.MakeReservationRejected to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.MakeReservationRejected to entity FrontOfHouse.Reservation
      }
      on event Reservation.ConfirmReservationRejected is {
        send event Reservation.ConfirmReservationRejected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.ConfirmReservationRejected to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.ConfirmReservationRejected to entity FrontOfHouse.Reservation
      }
      on event Reservation.CancelReservationRejected is {
        send event Reservation.CancelReservationRejected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.CancelReservationRejected to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.CancelReservationRejected to entity FrontOfHouse.Reservation
      }
      on event Reservation.SeatPartyRejected is {
        send event Reservation.SeatPartyRejected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.SeatPartyRejected to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.SeatPartyRejected to entity FrontOfHouse.Reservation
      }
      on event Reservation.CompleteVisitRejected is {
        send event Reservation.CompleteVisitRejected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.CompleteVisitRejected to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.CompleteVisitRejected to entity FrontOfHouse.Reservation
      }
      on event Reservation.MarkNoShowRejected is {
        send event Reservation.MarkNoShowRejected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.MarkNoShowRejected to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.MarkNoShowRejected to entity FrontOfHouse.Reservation
      }
      on event Reservation.RescheduleReservationRejected is {
        send event Reservation.RescheduleReservationRejected to outlet ReservationEventSplitToReservationRepository
        send event Reservation.RescheduleReservationRejected to outlet ReservationEventSplitToReservationBoard
        tell event Reservation.RescheduleReservationRejected to entity FrontOfHouse.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  processor TableOrderEventSplit as split is {
    inlet TableOrderEventSplitIn is type TableOrderEvent    outlet TableOrderEventSplitToTableOrderRepository is type TableOrderEvent
    outlet TableOrderEventSplitToReservationBoard is type TableOrderEvent
    handler TableOrderEventSplitHandler is {
      on event TableOrder.OrderCreated is {
        send event TableOrder.OrderCreated to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.OrderCreated to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.OrderCreated to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.ItemAdded is {
        send event TableOrder.ItemAdded to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.ItemAdded to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.ItemAdded to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.ItemRemoved is {
        send event TableOrder.ItemRemoved to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.ItemRemoved to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.ItemRemoved to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.OrderSubmitted is {
        send event TableOrder.OrderSubmitted to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.OrderSubmitted to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.OrderSubmitted to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.BillPresented is {
        send event TableOrder.BillPresented to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.BillPresented to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.BillPresented to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.PaymentProcessed is {
        send event TableOrder.PaymentProcessed to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.PaymentProcessed to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.PaymentProcessed to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.OrderClosed is {
        send event TableOrder.OrderClosed to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.OrderClosed to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.OrderClosed to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.OrderMarkedInPreparation is {
        send event TableOrder.OrderMarkedInPreparation to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.OrderMarkedInPreparation to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.OrderMarkedInPreparation to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.OrderMarkedReadyToServe is {
        send event TableOrder.OrderMarkedReadyToServe to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.OrderMarkedReadyToServe to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.OrderMarkedReadyToServe to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.TicketRouted is {
        send event TableOrder.TicketRouted to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.TicketRouted to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.TicketRouted to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.DrinkOrderRouted is {
        send event TableOrder.DrinkOrderRouted to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.DrinkOrderRouted to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.DrinkOrderRouted to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.PointsAccrualRouted is {
        send event TableOrder.PointsAccrualRouted to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.PointsAccrualRouted to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.PointsAccrualRouted to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.CreateOrderRejected is {
        send event TableOrder.CreateOrderRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.CreateOrderRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.CreateOrderRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.AddItemRejected is {
        send event TableOrder.AddItemRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.AddItemRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.AddItemRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.RemoveItemRejected is {
        send event TableOrder.RemoveItemRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.RemoveItemRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.RemoveItemRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.SubmitOrderRejected is {
        send event TableOrder.SubmitOrderRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.SubmitOrderRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.SubmitOrderRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.PresentBillRejected is {
        send event TableOrder.PresentBillRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.PresentBillRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.PresentBillRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.ProcessPaymentRejected is {
        send event TableOrder.ProcessPaymentRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.ProcessPaymentRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.ProcessPaymentRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.CloseOrderRejected is {
        send event TableOrder.CloseOrderRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.CloseOrderRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.CloseOrderRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.MarkOrderInPreparationRejected is {
        send event TableOrder.MarkOrderInPreparationRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.MarkOrderInPreparationRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.MarkOrderInPreparationRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.MarkOrderReadyToServeRejected is {
        send event TableOrder.MarkOrderReadyToServeRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.MarkOrderReadyToServeRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.MarkOrderReadyToServeRejected to entity FrontOfHouse.TableOrder
      }
      on other is {
        error "Unexpected message for processor TableOrderEventSplit"
      }
    } with {
      briefly "TableOrder event fan-out handler"
      described as {
        |Delivers each TableOrder event to all of its consumers.
      }
    }
  } with {
    briefly "TableOrder event fan-out"
    described as {
      |Fans TableOrder events out to the repository and projectors.
    }
  }
  connector 'ReservationEvent Stream' is from outlet FrontOfHouse.Reservation.ReservationEvents2 to inlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitIn with {
    briefly "Reservation events, fanned out to storage and read models"
  }
  connector 'ReservationEvent Storage' is from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReservationRepository to inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservation with {
    briefly "Reservation events on their way to storage"
  }
  connector 'ReservationEvent Feed' is from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReservationBoard to inlet FrontOfHouse.ReservationBoard.ReservationBoardFromReservation with {
    briefly "ReservationEvent feeding the ReservationBoard projection"
  }
  connector 'TableOrderEvent Stream' is from outlet FrontOfHouse.TableOrder.TableOrderEvents2 to inlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitIn with {
    briefly "TableOrder events, fanned out to storage and read models"
  }
  connector 'TableOrderEvent Storage' is from outlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitToTableOrderRepository to inlet FrontOfHouse.TableOrderRepository.TableOrderRepositoryFromTableOrder with {
    briefly "TableOrder events on their way to storage"
  }
  connector 'TableOrderEvent Feed' is from outlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitToReservationBoard to inlet FrontOfHouse.ReservationBoard.ReservationBoardFromTableOrder with {
    briefly "TableOrderEvent feeding the ReservationBoard projection"
  }
  connector 'ReservationBoard Storage' is from outlet FrontOfHouse.ReservationBoard.ReservationBoardOut to inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservationBoard with {
    briefly "The ReservationBoard projection on its way to storage"
  }
} with {
  briefly "Front of house context"
  described as {
    | Manages reservations, table seating, dine-in orders,
    | billing, and payment. Communicates with kitchen, bar,
    | and loyalty contexts via adaptors.
  }
}
