// Front of House bounded context
context FrontOfHouse as router is {
  inlet FrontOfHouseTableOrderToReportingIn is type TableOrderEvent  outlet FrontOfHouseTableOrderToReportingOut is type TableOrderEvent
  connector 'FromFrontOfHouseReservations TableOrder Feed' is from outlet FrontOfHouse.TableOrderEventSource.TableOrderEventSourceToReporting to inlet FrontOfHouse.FrontOfHouseTableOrderToReportingIn with {
    briefly "TableOrder events on their way to Reporting"
    described as {
      |TableOrder events on their way to Reporting.
    }
  }
  inlet FrontOfHouseReservationToReportingIn is type ReservationEvent  outlet FrontOfHouseReservationToReportingOut is type ReservationEvent
  connector 'FromFrontOfHouseReservations Reservation Feed' is from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReporting to inlet FrontOfHouse.FrontOfHouseReservationToReportingIn with {
    briefly "Reservation events on their way to Reporting"
    described as {
      |Reservation events on their way to Reporting.
    }
  }
  outlet FOHOrderSubmittedToKitchen is event TableOrder.OrderSubmitted
  outlet FOHOrderSubmittedToBar is event TableOrder.OrderSubmitted
  outlet FOHPaymentProcessedToLoyalty is event TableOrder.PaymentProcessed
  connector 'TableOrderEventLog To TableOrderRepository' is from outlet FrontOfHouse.TableOrderEventLog.TableOrderEventLogToTableOrderRepository to inlet FrontOfHouse.TableOrderRepository.TableOrderRepositoryFromTableOrderEventLog  connector 'ReservationEventLog To ReservationRepository' is from outlet FrontOfHouse.ReservationEventLog.ReservationEventLogToReservationRepository to inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservationEventLog  connector 'FromMenuManagementItems To FrontOfHouse' is from outlet FrontOfHouse.FromMenuManagementItems.FromMenuManagementItemsToFrontOfHouse to inlet FrontOfHouse.FrontOfHouseFromFromMenuManagementItems  inlet FrontOfHouseFromFromMenuManagementItems is type MenuDistributionCommand  connector 'DrinkOrderEventSink To TableOrderRepository' is from outlet FrontOfHouse.DrinkOrderEventSink.DrinkOrderEventSinkToTableOrderRepository to inlet FrontOfHouse.TableOrderRepository.TableOrderRepositoryFromDrinkOrderEventSink  connector 'NotificationAckSink To ReservationRepository' is from outlet FrontOfHouse.NotificationAckSink.NotificationAckSinkToReservationRepository to inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromNotificationAckSink  connector 'PaymentResultSink To TableOrder' is from outlet FrontOfHouse.PaymentResultSink.PaymentResultSinkToTableOrder to inlet FrontOfHouse.TableOrder.TableOrderFromPaymentResultSink  connector 'TableOrderProjection Storage' is from outlet FrontOfHouse.TableOrderProjection.TableOrderProjectionToRepository to inlet FrontOfHouse.TableOrderRepository.TableOrderRepositoryFromTableOrderProjection with {
    briefly "TableOrderProjection commands on their way to TableOrderRepository"
    described as {
      |Carries what leaves FrontOfHouse.TableOrderProjection.TableOrderProjectionToRepository to FrontOfHouse.TableOrderRepository.TableOrderRepositoryFromTableOrderProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'ReservationProjection Storage' is from outlet FrontOfHouse.ReservationProjection.ReservationProjectionToRepository to inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservationProjection with {
    briefly "ReservationProjection commands on their way to ReservationRepository"
    described as {
      |Carries what leaves FrontOfHouse.ReservationProjection.ReservationProjectionToRepository to FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservationProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  inlet BarToFOHIn is type DrinkOrderEvent  outlet BarToFOHOut is type DrinkOrderEvent
  inlet ReservationCommandStreamIn is type ReservationCommand  outlet ReservationCommandStreamOut is type ReservationCommand
  inlet TableOrderCommandStreamIn is type TableOrderCommand  outlet TableOrderCommandStreamOut is type TableOrderCommand
  inlet ReservationBoardViewStreamIn is result ReservationBoardView  outlet ReservationBoardViewStreamOut is result ReservationBoardView
  inlet TableOrderResultStreamIn is result TableOrder.TableOrderResult  outlet TableOrderResultStreamOut is result TableOrder.TableOrderResult
  handler FrontOfHouseBoundary is {
    on orderClosed: event TableOrder.OrderClosed is {
      send orderClosed to outlet FrontOfHouse.FrontOfHouseTableOrderToReportingOut
    }
    on reservationMade: event Reservation.ReservationMade is {
      send reservationMade to outlet FrontOfHouse.FrontOfHouseReservationToReportingOut
    }
    on reservationCancelled: event Reservation.ReservationCancelled is {
      send reservationCancelled to outlet FrontOfHouse.FrontOfHouseReservationToReportingOut
    }
    on orderSubmitted: event TableOrder.OrderSubmitted is {
      send orderSubmitted to outlet FrontOfHouse.FOHOrderSubmittedToKitchen
      send orderSubmitted to outlet FrontOfHouse.FOHOrderSubmittedToBar
      tell event TableOrder.TicketRouted(tableOrderId = orderSubmitted.tableOrderId, ticketRoutedAt = system.now) to entity FrontOfHouse.TableOrder
      tell event TableOrder.DrinkOrderRouted(tableOrderId = orderSubmitted.tableOrderId, drinkOrderRoutedAt = system.now) to entity FrontOfHouse.TableOrder
    }
    on paymentProcessed: event TableOrder.PaymentProcessed is {
      send paymentProcessed to outlet FrontOfHouse.FOHPaymentProcessedToLoyalty
      send paymentProcessed to outlet FrontOfHouse.FrontOfHouseTableOrderToReportingOut
      tell event TableOrder.PointsAccrualRouted(tableOrderId = paymentProcessed.tableOrderId, pointsAccrualRoutedAt = system.now) to entity FrontOfHouse.TableOrder
    }
    on drinkOrderReceived: event Bar.DrinkOrder.DrinkOrderReceived is {
      send drinkOrderReceived to outlet FrontOfHouse.BarToFOHOut
    }
    on drinkPrepared: event Bar.DrinkOrder.DrinkPrepared is {
      send drinkPrepared to outlet FrontOfHouse.BarToFOHOut
    }
    on drinkMarkedReady: event Bar.DrinkOrder.DrinkMarkedReady is {
      send drinkMarkedReady to outlet FrontOfHouse.BarToFOHOut
    }
    on serverNotifiedDrinksReady: event Bar.DrinkOrder.ServerNotifiedDrinksReady is {
      send serverNotifiedDrinksReady to outlet FrontOfHouse.BarToFOHOut
    }
    on drinkOrderCompleted: event Bar.DrinkOrder.DrinkOrderCompleted is {
      send drinkOrderCompleted to outlet FrontOfHouse.BarToFOHOut
    }
    on makeReservation: command Reservation.MakeReservation is {
      let noShow: type Reservation.MarkNoShow = prompt("a MarkNoShow naming this reservation, to be reconsidered when the booking's grace period runs out rather than sent now")
      send noShow to outlet FrontOfHouse.ReservationCommandStreamOut at makeReservation.noShowAt
      forward makeReservation to outlet FrontOfHouse.ReservationCommandStreamOut
    }
    on confirmReservation: command Reservation.ConfirmReservation is {
      forward confirmReservation to outlet FrontOfHouse.ReservationCommandStreamOut
    }
    on cancelReservation: command Reservation.CancelReservation is {
      forward cancelReservation to outlet FrontOfHouse.ReservationCommandStreamOut
    }
    on seatParty: command Reservation.SeatParty is {
      forward seatParty to outlet FrontOfHouse.ReservationCommandStreamOut
    }
    on completeVisit: command Reservation.CompleteVisit is {
      forward completeVisit to outlet FrontOfHouse.ReservationCommandStreamOut
    }
    on markNoShow: command Reservation.MarkNoShow is {
      forward markNoShow to outlet FrontOfHouse.ReservationCommandStreamOut
    }
    on rescheduleReservation: command Reservation.RescheduleReservation is {
      forward rescheduleReservation to outlet FrontOfHouse.ReservationCommandStreamOut
    }
    on createOrder: command TableOrder.CreateOrder is {
      forward createOrder to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on addItem: command TableOrder.AddItem is {
      forward addItem to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on removeItem: command TableOrder.RemoveItem is {
      forward removeItem to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on submitOrder: command TableOrder.SubmitOrder is {
      forward submitOrder to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on presentBill: command TableOrder.PresentBill is {
      forward presentBill to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on processPayment: command TableOrder.ProcessPayment is {
      forward processPayment to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on closeOrder: command TableOrder.CloseOrder is {
      forward closeOrder to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on markOrderInPreparation: command TableOrder.MarkOrderInPreparation is {
      forward markOrderInPreparation to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on markOrderReadyToServe: command TableOrder.MarkOrderReadyToServe is {
      forward markOrderReadyToServe to outlet FrontOfHouse.TableOrderCommandStreamOut
    }
    on reservationBoardView: result ReservationBoardView is {
      send reservationBoardView to outlet FrontOfHouse.ReservationBoardViewStreamOut
    }
    on tableOrderResult: result TableOrder.TableOrderResult is {
      send tableOrderResult to outlet FrontOfHouse.TableOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the FrontOfHouse boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BarToFOH Intake' is from outlet FrontOfHouse.BarToFOHOut to inlet FrontOfHouse.DrinkOrderEventSink.IncomingDrinkOrderEvents  connector 'ReservationCommand Stream Intake' is from outlet FrontOfHouse.ReservationCommandStreamOut to inlet FrontOfHouse.Reservation.ReservationCommands  connector 'TableOrderCommand Stream Intake' is from outlet FrontOfHouse.TableOrderCommandStreamOut to inlet FrontOfHouse.TableOrder.TableOrderCommands  connector 'ReservationBoardView Stream Egress' is from outlet FrontOfHouse.ReservationRepository.ReservationRepositoryResponses to inlet FrontOfHouse.ReservationBoardViewStreamIn  connector 'TableOrderResult Stream Egress' is from outlet FrontOfHouse.TableOrderRepository.TableOrderRepositoryResponses to inlet FrontOfHouse.TableOrderResultStreamIn  query GetReservationBoard replies result ReservationBoardView is {
    reservationBoardKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which ReservationBoard to retrieve.
      }
    }
  } with {
    briefly "Get ReservationBoard"
    described as {
      |Retrieves a ReservationBoard projection.
    }
  }
  result ReservationBoardView is {
    reservationBoard: ReservationBoardEntry with {
      briefly "ReservationBoard"
      described as {
        |The ReservationBoard data being returned.
      }
    }
  } with {
    briefly "ReservationBoard view"
    described as {
      |Read model view carrying a ReservationBoardEntry.
    }
  }
  include "front-of-house-types.riddl"
  include "Reservation.riddl"
  include "TableOrder.riddl"
  type DrinkServiceNotice is one of {
    NotifyDrinkReady or NotifyDrinksServed
  } with {
    briefly "What the bar tells the table order about drinks"
    described as {
      |A port carries a single type, and this channel carries both drink
      |service notices, so they need a name of their own.
    }
  }
  type MenuDistributionCommand is one of {
    ApplyMenuItemUpdate or ApplyMenuItemPriceChange or ApplyMenuRelease or RollbackMenuRelease
  } with {
    briefly "What Corporate menu management asks the restaurants to apply"
    described as {
      |Item edits, price changes and whole-release apply/rollback all arrive
      |on one channel from the menu-management adaptor.
    }
  }
  command NotifyDrinkReady is {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order with ready drinks.
      }
    }
  } with {
    briefly "Notify drink ready"
    described as {
      |Notify that drinks are ready for a table order.
    }
  }
  command NotifyDrinksServed is {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order with served drinks.
      }
    }
  } with {
    briefly "Notify drinks served"
    described as {
      |Notify that drinks have been served.
    }
  }
  command ApplyMenuItemUpdate is {
    menuItemId: String(1,50) with {
      briefly "ID"
      described as {
        |Updated menu item.
      }
    }
  } with {
    briefly "Apply menu item update"
    described as {
      |Apply a menu item update from corporate.
    }
  }
  command ApplyMenuItemPriceChange is {
    menuItemId: String(1,50) with {
      briefly "ID"
      described as {
        |Repriced menu item.
      }
    }
  } with {
    briefly "Apply menu item price change"
    described as {
      |Apply a menu item price change from corporate.
    }
  }
  command ApplyMenuRelease is {
    releaseId: String(1,50) with {
      briefly "ID"
      described as {
        |Menu release to apply.
      }
    }
  } with {
    briefly "Apply menu release"
    described as {
      |Apply a published menu release from corporate.
    }
  }
  command RollbackMenuRelease is {
    releaseId: String(1,50) with {
      briefly "ID"
      described as {
        |Menu release to roll back.
      }
    }
  } with {
    briefly "Rollback menu release"
    described as {
      |Roll back a menu release from corporate.
    }
  }
  command RecordNotificationAck is {
    notificationId: String(1,50) with {
      briefly "ID"
      described as {
        |Notification that was acknowledged.
      }
    }
  } with {
    briefly "Record notification ack"
    described as {
      |Record a push notification delivery confirmation.
    }
  }
  type ReservationRepositoryCommand is one of {
    FrontOfHouse.ReservationRepository.PersistReservationMade or FrontOfHouse.ReservationRepository.PersistReservationConfirmed or FrontOfHouse.ReservationRepository.PersistReservationCancelled or FrontOfHouse.ReservationRepository.PersistPartySeated or FrontOfHouse.ReservationRepository.PersistNoShowMarked or FrontOfHouse.ReservationRepository.PersistReservationRescheduled
  } with {
    briefly "Anything that writes the ReservationRepository"
    described as {
      |The persistence commands ReservationRepository accepts. Entity events never reach
      |it directly; ReservationProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository ReservationRepository as merge is {
    inlet ReservationRepositoryFromReservationEventLog is command LogReservationEvent    inlet ReservationRepositoryFromNotificationAckSink is command RecordNotificationAck    inlet ReservationRepositoryFromReservationProjection is type ReservationRepositoryCommand    inlet ReservationRepositoryFromReservationBoard is type ReservationRepositoryCommand    outlet ReservationRepositoryResponses is result ReservationBoardView
    record StoredReservation is {
      reservationId: ReservationId with {
        briefly "reservationId"
        described as {
          |The reservationId column of the stored reservation row.
        }
      }
      guestName: GuestName with {
        briefly "guestName"
        described as {
          |The guestName column of the stored reservation row.
        }
      }
      reservationTime: TimeStamp with {
        briefly "reservationTime"
        described as {
          |The reservationTime column of the stored reservation row.
        }
      }
      guestPhone: GuestPhone with {
        briefly "Guest phone"
        described as {
          |The row's guest phone, as the persisting projector last wrote it.
        }
      }
      partySize: PartySize with {
        briefly "Party size"
        described as {
          |The row's party size, as the persisting projector last wrote it.
        }
      }
      assignedTable: TableNumber? with {
        briefly "Assigned table"
        described as {
          |The row's assigned table, as the persisting projector last wrote it.
        }
      }
      actualSeatedAt: TimeStamp? with {
        briefly "Actual seated at"
        described as {
          |The row's actual seated at, as the persisting projector last wrote it.
        }
      }
      actualCompletedAt: TimeStamp? with {
        briefly "Actual completed at"
        described as {
          |The row's actual completed at, as the persisting projector last wrote it.
        }
      }
      actualMarkedNoShowAt: TimeStamp? with {
        briefly "Actual marked no show at"
        described as {
          |The row's actual marked no show at, as the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored reservation row"
      described as {
        |The persistence shape of reservation data as this repository stores it.
      }
    }
    record StoredTableOrder is {
      tableOrderId: TableOrderId with {
        briefly "tableOrderId"
        described as {
          |The tableOrderId column of the stored tableOrder row.
        }
      }
      tableNumber: TableNumber with {
        briefly "tableNumber"
        described as {
          |The tableNumber column of the stored tableOrder row.
        }
      }
      serverId: String(1,50) with {
        briefly "Server id"
        described as {
          |The row's server id, as the persisting projector last wrote it.
        }
      }
      orderItems: OrderLine* with {
        briefly "Order items"
        described as {
          |The row's order items, as the persisting projector last wrote it.
        }
      }
      actualSubmittedAt: TimeStamp? with {
        briefly "Actual submitted at"
        described as {
          |The row's actual submitted at, as the persisting projector last wrote it.
        }
      }
      actualReadyAt: TimeStamp? with {
        briefly "Actual ready at"
        described as {
          |The row's actual ready at, as the persisting projector last wrote it.
        }
      }
      presentedBillTotal: Decimal(10,2)? with {
        briefly "Presented bill total"
        described as {
          |The row's presented bill total, as the persisting projector last wrote it.
        }
      }
      processedPayment: PaymentInfo? with {
        briefly "Processed payment"
        described as {
          |The row's processed payment, as the persisting projector last wrote it.
        }
      }
      actualClosedAt: TimeStamp? with {
        briefly "Actual closed at"
        described as {
          |The row's actual closed at, as the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored tableOrder row"
      described as {
        |The persistence shape of tableOrder data as this repository stores it.
      }
    }
    schema ReservationSchema is relational
      of reservationEvents as record LoggedReservationEvent with history
      of reservations as record StoredReservation
        link reservationEventLogEntry as field LoggedReservationEvent.loggedReservationId to field StoredReservation.reservationId
        key on field StoredReservation.reservationId
        index on field StoredReservation.guestName
        index on field StoredReservation.reservationTime
 with {
      briefly "Reservation data schema"
      described as {
        |Relational schema for persisting reservation state
        |with indexes on identifier, guest name, and time.
      }
    }
    command PersistReservationMade is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      guestName: GuestName with {
        briefly "Guest name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      guestPhone: GuestPhone with {
        briefly "Guest phone"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      partySize: PartySize with {
        briefly "Party size"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      reservationTime: TimeStamp with {
        briefly "Reservation time"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReservationMade"
      described as {
        |Instructs this repository to apply ReservationMade to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationConfirmed is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      confirmedTable: TableNumber with {
        briefly "Confirmed table"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReservationConfirmed"
      described as {
        |Instructs this repository to apply ReservationConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationCancelled is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReservationCancelled"
      described as {
        |Instructs this repository to apply ReservationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPartySeated is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      seatedAt: TimeStamp with {
        briefly "Seated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PartySeated"
      described as {
        |Instructs this repository to apply PartySeated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistVisitCompleted is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      visitSeatedAt: TimeStamp with {
        briefly "Seated at"
        described as {
          |When the party actually sat down. Joined in from the seating event
          |rather than read from the booking, because a table is given when
          |one frees, not at the time the guest asked for.
        }
      }
      visitClosedAt: TimeStamp with {
        briefly "Closed at"
        described as {
          |When the visit ended. Held with the seating time because the pair
          |is what turnover reporting needs, and neither is useful alone.
        }
      }
      completedAt: TimeStamp with {
        briefly "Completed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist VisitCompleted"
      described as {
        |Instructs this repository to apply VisitCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistNoShowMarked is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      markedNoShowAt: TimeStamp with {
        briefly "Marked no show at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist NoShowMarked"
      described as {
        |Instructs this repository to apply NoShowMarked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReservationRescheduled is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      newReservationTime: TimeStamp with {
        briefly "New reservation time"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReservationRescheduled"
      described as {
        |Instructs this repository to apply ReservationRescheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler ReservationPersistence is {
      on persistReservationMade: command PersistReservationMade is {
        store record StoredReservation(reservationId = persistReservationMade.reservationId, guestName = persistReservationMade.guestName, guestPhone = persistReservationMade.guestPhone, partySize = persistReservationMade.partySize, reservationTime = persistReservationMade.reservationTime, actualCompletedAt = prompt("the actualCompletedAt of this row"), actualMarkedNoShowAt = prompt("the actualMarkedNoShowAt of this row"), actualSeatedAt = prompt("the actualSeatedAt of this row"), assignedTable = prompt("the assignedTable of this row")) in ReservationSchema.reservations
      }
      on persistReservationConfirmed: command PersistReservationConfirmed is {
        update ReservationSchema.reservations set assignedTable = persistReservationConfirmed.confirmedTable where reservationId == persistReservationConfirmed.reservationId
      }
      on command PersistReservationCancelled is {
        do "update ReservationSchema.reservations where
          reservationId matches"
      }
      on persistPartySeated: command PersistPartySeated is {
        update ReservationSchema.reservations set actualSeatedAt = persistPartySeated.seatedAt where reservationId == persistPartySeated.reservationId
      }
      on persistVisitCompleted: command PersistVisitCompleted is {
        update ReservationSchema.reservations set actualCompletedAt = persistVisitCompleted.completedAt where reservationId == persistVisitCompleted.reservationId
      }
      on persistNoShowMarked: command PersistNoShowMarked is {
        update ReservationSchema.reservations set actualMarkedNoShowAt = persistNoShowMarked.markedNoShowAt where reservationId == persistNoShowMarked.reservationId
      }
      on persistReservationRescheduled: command PersistReservationRescheduled is {
        update ReservationSchema.reservations set reservationTime = persistReservationRescheduled.newReservationTime where reservationId == persistReservationRescheduled.reservationId
      }
      on command RecordNotificationAck is {
        do "log notification delivery confirmation for
          audit trail"
      }
      on command ApplyMenuRelease is {
        do "apply published menu release to restaurant"
      }
      on command RollbackMenuRelease is {
        do "rollback menu release at restaurant"
      }
      on logReservationEvent: command LogReservationEvent is {
        store record LoggedReservationEvent(loggedReservationId = logReservationEvent.loggedReservationId, loggedReservationEventType = logReservationEvent.loggedReservationEventType, loggedAt = system.now) in ReservationSchema.reservationEvents
      }
      on query GetReservationBoard is {
        let reservationBoardView: type ReservationBoardView = prompt("read the reservation board projection")
        reply reservationBoardView
      }
    } with {
      briefly "Reservation persistence"
      described as {
        |Persists reservation events to the reservations table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Reservation repository"
    described as {
      |Stores and retrieves reservation data.
    }
  }
  projector ReservationProjection as flow is {
    updates repository FrontOfHouse.ReservationRepository
    inlet ReservationProjectionFromReservation is type ReservationEvent    outlet ReservationProjectionToRepository is type ReservationRepositoryCommand
    handler ReservationProjectionHandler is {
      on reservationMade: event FrontOfHouse.Reservation.ReservationMade is {
        tell command FrontOfHouse.ReservationRepository.PersistReservationMade(reservationId = reservationMade.reservationId, guestName = reservationMade.guestName, guestPhone = reservationMade.guestPhone, partySize = reservationMade.partySize, reservationTime = reservationMade.reservationTime) to repository FrontOfHouse.ReservationRepository
      }
      on reservationConfirmed: event FrontOfHouse.Reservation.ReservationConfirmed is {
        tell command FrontOfHouse.ReservationRepository.PersistReservationConfirmed(reservationId = reservationConfirmed.reservationId, confirmedTable = reservationConfirmed.confirmedTable) to repository FrontOfHouse.ReservationRepository
      }
      on reservationCancelled: event FrontOfHouse.Reservation.ReservationCancelled is {
        tell command FrontOfHouse.ReservationRepository.PersistReservationCancelled(reservationId = reservationCancelled.reservationId) to repository FrontOfHouse.ReservationRepository
      }
      on partySeated: event FrontOfHouse.Reservation.PartySeated is {
        tell command FrontOfHouse.ReservationRepository.PersistPartySeated(reservationId = partySeated.reservationId, seatedAt = partySeated.seatedAt) to repository FrontOfHouse.ReservationRepository
      }
      on noShowMarked: event FrontOfHouse.Reservation.NoShowMarked is {
        tell command FrontOfHouse.ReservationRepository.PersistNoShowMarked(reservationId = noShowMarked.reservationId, markedNoShowAt = noShowMarked.markedNoShowAt) to repository FrontOfHouse.ReservationRepository
      }
      on reservationRescheduled: event FrontOfHouse.Reservation.ReservationRescheduled is {
        tell command FrontOfHouse.ReservationRepository.PersistReservationRescheduled(reservationId = reservationRescheduled.reservationId, newReservationTime = reservationRescheduled.newReservationTime) to repository FrontOfHouse.ReservationRepository
      }
      on other is {
        do "not persisted: VisitCompleted records no stored state"
      }
    } with {
      briefly "ReservationProjection handler"
      described as {
        |Turns each Reservation event into the repository command that writes it.
      }
    }
  } with {
    briefly "Reservation persistence projection"
    described as {
      |Builds the stored Reservation view from the entity's events.
    }
  }
  type TableOrderRepositoryCommand is one of {
    FrontOfHouse.TableOrderRepository.PersistOrderCreated or FrontOfHouse.TableOrderRepository.PersistItemAdded or FrontOfHouse.TableOrderRepository.PersistItemRemoved or FrontOfHouse.TableOrderRepository.PersistOrderSubmitted or FrontOfHouse.TableOrderRepository.PersistBillPresented or FrontOfHouse.TableOrderRepository.PersistPaymentProcessed or FrontOfHouse.TableOrderRepository.PersistOrderClosed or FrontOfHouse.TableOrderRepository.PersistOrderMarkedInPreparation or FrontOfHouse.TableOrderRepository.PersistOrderMarkedReadyToServe
  } with {
    briefly "Anything that writes the TableOrderRepository"
    described as {
      |The persistence commands TableOrderRepository accepts. Entity events never reach
      |it directly; TableOrderProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository TableOrderRepository as merge is {
    inlet TableOrderRepositoryFromTableOrderEventLog is command LogTableOrderEvent    inlet TableOrderRepositoryFromDrinkOrderEventSink is type DrinkServiceNotice    inlet TableOrderRepositoryFromTableOrderProjection is type TableOrderRepositoryCommand    outlet TableOrderRepositoryResponses is result TableOrder.TableOrderResult
    schema TableOrderSchema is relational
      of orders as record StoredTableOrder
      of tableOrderEvents as record LoggedTableOrderEvent with history
        link tableOrderEventLogEntry as field LoggedTableOrderEvent.loggedTableOrderId to field StoredTableOrder.tableOrderId
        key on field StoredTableOrder.tableOrderId
        index on field StoredTableOrder.tableNumber
 with {
      briefly "Table order data schema"
      described as {
        |Relational schema for persisting table order state
        |with indexes on order identifier and table number.
      }
    }
    command PersistOrderCreated is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      tableNumber: TableNumber with {
        briefly "Table number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      serverId: String(1,50) with {
        briefly "Server id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderCreated"
      described as {
        |Instructs this repository to apply OrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAdded is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      addedItem: OrderLine with {
        briefly "Added item"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ItemAdded"
      described as {
        |Instructs this repository to apply ItemAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRemoved is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      removedMenuItemId: String(1,50) with {
        briefly "Removed menu item id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ItemRemoved"
      described as {
        |Instructs this repository to apply ItemRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderSubmitted is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      submittedAt: TimeStamp with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderSubmitted"
      described as {
        |Instructs this repository to apply OrderSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderMarkedInPreparation is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderMarkedInPreparation"
      described as {
        |Instructs this repository to apply OrderMarkedInPreparation to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderMarkedReadyToServe is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      readyAt: TimeStamp with {
        briefly "Ready at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderMarkedReadyToServe"
      described as {
        |Instructs this repository to apply OrderMarkedReadyToServe to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBillPresented is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      billTotal: Decimal(10,2) with {
        briefly "Bill total"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist BillPresented"
      described as {
        |Instructs this repository to apply BillPresented to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      orderPayment: PaymentInfo with {
        briefly "Order payment"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderClosed is {
      tableOrderId: TableOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      closedAt: TimeStamp with {
        briefly "Closed at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderClosed"
      described as {
        |Instructs this repository to apply OrderClosed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler TableOrderPersistence is {
      on persistOrderCreated: command PersistOrderCreated is {
        store record StoredTableOrder(tableOrderId = persistOrderCreated.tableOrderId, tableNumber = persistOrderCreated.tableNumber, serverId = persistOrderCreated.serverId, actualClosedAt = prompt("the actualClosedAt of this row"), actualReadyAt = prompt("the actualReadyAt of this row"), actualSubmittedAt = prompt("the actualSubmittedAt of this row"), orderItems = prompt("the orderItems of this row"), presentedBillTotal = prompt("the presentedBillTotal of this row"), processedPayment = prompt("the processedPayment of this row")) in TableOrderSchema.orders
      }
      on command PersistItemAdded is {
        do "append addedItem OrderLine to orderItems array
          in TableOrderSchema.orders where tableOrderId
          matches"
      }
      on command PersistItemRemoved is {
        do "remove OrderLine with removedMenuItemId from
          orderItems array in TableOrderSchema.orders where
          tableOrderId matches"
      }
      on persistOrderSubmitted: command PersistOrderSubmitted is {
        update TableOrderSchema.orders set actualSubmittedAt = persistOrderSubmitted.submittedAt where tableOrderId == persistOrderSubmitted.tableOrderId
      }
      on command PersistOrderMarkedInPreparation is {
        do "update TableOrderSchema.orders where
          tableOrderId matches"
      }
      on persistOrderMarkedReadyToServe: command PersistOrderMarkedReadyToServe is {
        update TableOrderSchema.orders set actualReadyAt = persistOrderMarkedReadyToServe.readyAt where tableOrderId == persistOrderMarkedReadyToServe.tableOrderId
      }
      on persistBillPresented: command PersistBillPresented is {
        update TableOrderSchema.orders set presentedBillTotal = persistBillPresented.billTotal where tableOrderId == persistBillPresented.tableOrderId
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        update TableOrderSchema.orders set processedPayment = persistPaymentProcessed.orderPayment where tableOrderId == persistPaymentProcessed.tableOrderId
      }
      on persistOrderClosed: command PersistOrderClosed is {
        update TableOrderSchema.orders set actualClosedAt = persistOrderClosed.closedAt where tableOrderId == persistOrderClosed.tableOrderId
      }
      on command NotifyDrinkReady is {
        do "notify server that drinks are ready for table"
      }
      on command NotifyDrinksServed is {
        do "record drink readiness notification acknowledgment"
      }
      on command ApplyMenuItemUpdate is {
        do "update local menu item cache with changes"
      }
      on command ApplyMenuItemPriceChange is {
        do "update local menu pricing from corporate"
      }
      on logTableOrderEvent: command LogTableOrderEvent is {
        store record LoggedTableOrderEvent(loggedTableOrderId = logTableOrderEvent.loggedTableOrderId, loggedTableOrderEventType = logTableOrderEvent.loggedTableOrderEventType, loggedAt = system.now) in TableOrderSchema.tableOrderEvents
      }
    } with {
      briefly "Order persistence"
      described as {
        |Persists table order events to the orders table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Table order repository"
    described as {
      |Stores and retrieves table order data.
    }
  }
  projector TableOrderProjection as flow is {
    updates repository FrontOfHouse.TableOrderRepository
    inlet TableOrderProjectionFromTableOrder is type TableOrderEvent    outlet TableOrderProjectionToRepository is type TableOrderRepositoryCommand
    handler TableOrderProjectionHandler is {
      on orderCreated: event TableOrder.OrderCreated is {
        tell command FrontOfHouse.TableOrderRepository.PersistOrderCreated(tableOrderId = orderCreated.tableOrderId, tableNumber = orderCreated.tableNumber, serverId = orderCreated.serverId) to repository FrontOfHouse.TableOrderRepository
      }
      on itemAdded: event TableOrder.ItemAdded is {
        tell command FrontOfHouse.TableOrderRepository.PersistItemAdded(tableOrderId = itemAdded.tableOrderId, addedItem = itemAdded.addedItem) to repository FrontOfHouse.TableOrderRepository
      }
      on itemRemoved: event TableOrder.ItemRemoved is {
        tell command FrontOfHouse.TableOrderRepository.PersistItemRemoved(tableOrderId = itemRemoved.tableOrderId, removedMenuItemId = itemRemoved.removedMenuItemId) to repository FrontOfHouse.TableOrderRepository
      }
      on orderSubmitted: event TableOrder.OrderSubmitted is {
        tell command FrontOfHouse.TableOrderRepository.PersistOrderSubmitted(tableOrderId = orderSubmitted.tableOrderId, submittedAt = orderSubmitted.submittedAt) to repository FrontOfHouse.TableOrderRepository
      }
      on billPresented: event TableOrder.BillPresented is {
        tell command FrontOfHouse.TableOrderRepository.PersistBillPresented(tableOrderId = billPresented.tableOrderId, billTotal = billPresented.billTotal) to repository FrontOfHouse.TableOrderRepository
      }
      on paymentProcessed: event TableOrder.PaymentProcessed is {
        tell command FrontOfHouse.TableOrderRepository.PersistPaymentProcessed(tableOrderId = paymentProcessed.tableOrderId, orderPayment = paymentProcessed.orderPayment) to repository FrontOfHouse.TableOrderRepository
      }
      on orderClosed: event TableOrder.OrderClosed is {
        tell command FrontOfHouse.TableOrderRepository.PersistOrderClosed(tableOrderId = orderClosed.tableOrderId, closedAt = orderClosed.closedAt) to repository FrontOfHouse.TableOrderRepository
      }
      on orderMarkedInPreparation: event TableOrder.OrderMarkedInPreparation is {
        tell command FrontOfHouse.TableOrderRepository.PersistOrderMarkedInPreparation(tableOrderId = orderMarkedInPreparation.tableOrderId) to repository FrontOfHouse.TableOrderRepository
      }
      on orderMarkedReadyToServe: event TableOrder.OrderMarkedReadyToServe is {
        tell command FrontOfHouse.TableOrderRepository.PersistOrderMarkedReadyToServe(tableOrderId = orderMarkedReadyToServe.tableOrderId, readyAt = orderMarkedReadyToServe.readyAt) to repository FrontOfHouse.TableOrderRepository
      }
      on other is {
        do "not persisted: DrinkOrderRouted, PointsAccrualRouted, TicketRouted record no stored state"
      }
    } with {
      briefly "TableOrderProjection handler"
      described as {
        |Turns each TableOrder event into the repository command that writes it.
      }
    }
  } with {
    briefly "TableOrder persistence projection"
    described as {
      |Builds the stored TableOrder view from the entity's events.
    }
  }
  projector ReservationBoard as merge is {
    updates repository FrontOfHouse.ReservationRepository
    correlation VisitDwell by reservationId yields command PersistVisitCompleted is {
      handler CollectVisitSpan is {
        on e: event Reservation.PartySeated is {
          set field visitSeatedAt to e.seatedAt
        }
        on e: event Reservation.VisitCompleted is {
          set field visitClosedAt to e.completedAt
          set field completedAt to e.completedAt
        }
      } with {
        briefly "Fold the two ends of a visit"
        described as {
          |Each arrival fills one end of the span. Neither event alone can
          |complete the write, which is the point: dwell time is not a
          |property either of them carries.
        }
      }
    } times out after "6 hours" {
      do "abandon the join and flag the booking for a manager to close by hand"
    }
 with {
      briefly "Join seating to visit end"
      described as {
        |Table dwell time is the interval between two events that arrive hours
        |apart, so it exists only as a join. Correlating by reservationId is
        |what lets the pair be written as one row.
        |
        |The key is deliberately the booking, not the table: two parties use
        |the same table in one night, and a merged table serves one party
        |under two numbers.
        |
        |**It does not join across the TableOrder stream**, though this
        |projector receives one. A dine-in check carries no reservationId and
        |should not — a walk-in has no booking at all — so the key would be
        |unreachable from half the events. That is a domain fact, not a
        |modelling shortcut.
        |
        |The timeout is 6 hours: longer than any real service, so firing it
        |means the visit was never closed rather than that it ran late.
      }
    }
    inlet ReservationBoardFromReservation is type ReservationEvent    inlet ReservationBoardFromTableOrder is type TableOrderEvent    outlet ReservationBoardOut is type ReservationRepositoryCommand
    record ReservationBoardEntry is {
      reservationId: ReservationId with {
        briefly "ID"
        described as {
          |The booking this board row stands for. The host stand uses it to
          |pull up the full reservation when a party arrives at the door.
        }
      }
      guestName: GuestName with {
        briefly "Guest"
        described as {
          |The name the booking is held under. This is what the host reads
          |aloud when calling the party, so it is the guest's preferred name
          |rather than a legal one.
        }
      }
      partySize: PartySize with {
        briefly "Party size"
        described as {
          |Number of guests.
        }
      }
      reservationTime: TimeStamp with {
        briefly "Time"
        described as {
          |When the party is expected. The board sorts on this, and it is the
          |clock against which lateness and no-show timeouts are measured.
        }
      }
      reservationDisplayStatus: String(1,30) with {
        briefly "Status"
        described as {
          |Display status derived from entity state name.
        }
      }
      assignedTable: TableNumber? with {
        briefly "Table"
        described as {
          |The table this party has been given, once the host assigns one.
          |Absent while the booking is still waiting, which is how the board
          |distinguishes seated parties from those still to arrive.
        }
      }
    } with {
      briefly "Board entry"
      described as {
        |A single entry on the reservation board.
      }
    }
    handler ReservationBoardHandler is {
      on other is {
        do "board rows are built only from the reservation lifecycle events above; rejections and table-order events change no stored row"
      }
      on reservationMade: event Reservation.ReservationMade is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Requested"
        tell command PersistReservationMade(reservationId = reservationMade.reservationId, guestName = reservationMade.guestName, guestPhone = reservationMade.guestPhone, partySize = reservationMade.partySize, reservationTime = reservationMade.reservationTime) to repository FrontOfHouse.ReservationRepository
        do "insert ReservationBoardEntry with reservationId =
          event.reservationId, guestName = event.guestName,
          partySize = event.partySize, reservationTime =
          event.reservationTime, reservationDisplayStatus = Requested,
          assignedTable = none"
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Confirmed"
        tell command PersistReservationConfirmed(reservationId = reservationConfirmed.reservationId, confirmedTable = reservationConfirmed.confirmedTable) to repository FrontOfHouse.ReservationRepository
        do "update ReservationBoardEntry set
          reservationDisplayStatus = Confirmed,
          assignedTable = event.confirmedTable
          where reservationId = event.reservationId"
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Cancelled"
        tell command PersistReservationCancelled(reservationId = reservationCancelled.reservationId) to repository FrontOfHouse.ReservationRepository
        do "delete ReservationBoardEntry where reservationId =
          event.reservationId"
      }
      on partySeated: event Reservation.PartySeated is {
        set field ReservationBoardEntry.reservationDisplayStatus to "Seated"
        tell command PersistPartySeated(reservationId = partySeated.reservationId, seatedAt = partySeated.seatedAt) to repository FrontOfHouse.ReservationRepository
        do "update ReservationBoardEntry set
          reservationDisplayStatus = Seated,
          assignedTable = event.seatedTable where
          reservationId = event.reservationId"
      }
    } with {
      briefly "Board event handler"
      described as {
        |Projects reservation events onto the real-time board
        |displayed at the host station, replacing the paper
        |backup system.
      }
    }
  } with {
    briefly "Reservation board projector"
    described as {
      | Real-time view of current reservations replacing
      | the host's paper backup system.
    }
  }
  streamlet ReservationEventSource as flow is {
    inlet ReservationEventSourceIn is type ReservationEvent    outlet ReservationEvents is type ReservationEvent
    handler ReservationEventEmitter is {
      on other is {
        error "Unexpected message for source ReservationEventSource"
      }
      on reservationMade: event Reservation.ReservationMade is {
        send reservationMade to outlet ReservationEvents
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        send reservationConfirmed to outlet ReservationEvents
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        send reservationCancelled to outlet ReservationEvents
      }
      on partySeated: event Reservation.PartySeated is {
        send partySeated to outlet ReservationEvents
      }
      on visitCompleted: event Reservation.VisitCompleted is {
        send visitCompleted to outlet ReservationEvents
      }
      on noShowMarked: event Reservation.NoShowMarked is {
        send noShowMarked to outlet ReservationEvents
      }
      on reservationRescheduled: event Reservation.ReservationRescheduled is {
        send reservationRescheduled to outlet ReservationEvents
      }
    } with {
      briefly "Reservation event emitter"
      described as {
        |Emits reservation lifecycle events into the streaming
        |topology for downstream consumers.
      }
    }
  } with {
    briefly "Reservation event source"
    described as {
      |Publishes reservation entity events for external
      |consumption via the streaming topology.
    }
  }
  streamlet TableOrderEventSource as split is {
    outlet TableOrderEventSourceToReporting is type TableOrderEvent
    outlet TableOrderEventSourceToToPaymentGateway is type TableOrderEvent
    inlet TableOrderEventSourceIn is type TableOrderEvent    outlet TableOrderEvents is type OrderEvent
    handler TableOrderEventEmitter is {
      on other is {
        error "Unexpected message for source TableOrderEventSource"
      }
      on orderCreated: event TableOrder.OrderCreated is {
        send orderCreated to outlet TableOrderEvents
      }
      on itemAdded: event TableOrder.ItemAdded is {
        send itemAdded to outlet TableOrderEvents
      }
      on orderSubmitted: event TableOrder.OrderSubmitted is {
        send orderSubmitted to outlet TableOrderEvents
        send orderSubmitted to outlet TableOrderEventSourceToReporting
      }
      on paymentProcessed: event TableOrder.PaymentProcessed is {
        send paymentProcessed to outlet TableOrderEvents
        send paymentProcessed to outlet TableOrderEventSourceToToPaymentGateway
        send paymentProcessed to outlet TableOrderEventSourceToReporting
      }
      on orderClosed: event TableOrder.OrderClosed is {
        send orderClosed to outlet TableOrderEvents
        send orderClosed to outlet TableOrderEventSourceToToPaymentGateway
        send orderClosed to outlet TableOrderEventSourceToReporting
      }
    } with {
      briefly "Table order event emitter"
      described as {
        |Emits table order lifecycle events into the streaming
        |topology for downstream consumers.
      }
    }
  } with {
    briefly "Table order event source"
    described as {
      |Publishes table order entity events for external
      |consumption via the streaming topology.
    }
  }
  adaptor ToPaymentGateway to context PaymentGateway as flow is { 
    inlet ToPaymentGatewayIn is type TableOrderEvent    outlet ToPaymentGatewayOut is type PaymentGateway.PaymentGatewayCommand
    handler ToPaymentGatewayHandler is {
      on paymentProcessed: event TableOrder.PaymentProcessed is {
        let notice: type PaymentGateway.AuthorizePayment = prompt("translate the paymentProcessed event into an AuthorizePayment holding the tender the diner has just presented against the check")
        send notice to outlet FrontOfHouse.ToPaymentGateway.ToPaymentGatewayOut
      }
      on orderClosed: event TableOrder.OrderClosed is {
        let notice: type PaymentGateway.CapturePayment = prompt("translate the orderClosed event into a CapturePayment taking the authorized tender now that the check total is final")
        send notice to outlet FrontOfHouse.ToPaymentGateway.ToPaymentGatewayOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentGateway"
      }
    } with {
      briefly "to payment gateway"
      described as {
        |Carries messages to the external PaymentGateway.
      }
    }
  } with {
    briefly "PaymentGateway integration"
    described as {
      |The model's side of the PaymentGateway conversation.
    }
  }
  adaptor PaymentGatewayAdapter from context PaymentGateway as flow is { 
    inlet IncomingPaymentGatewayEvents is type PaymentGatewayEvent    outlet TranslatedPaymentGatewayEvents is type PaymentGatewayEvent
    handler InboundPaymentGateway is {
      on paymentAuthorized: event PaymentGateway.PaymentAuthorized is {
        send paymentAuthorized to outlet TranslatedPaymentGatewayEvents
      }
      on paymentCaptured: event PaymentGateway.PaymentCaptured is {
        send paymentCaptured to outlet TranslatedPaymentGatewayEvents
      }
      on other is {
        error "Unexpected message for adaptor PaymentGatewayAdapter"
      }
    } with {
      briefly "Inbound PaymentGateway translation"
      described as {
        |Receives PaymentGateway events and forwards them to FrontOfHouse. This is the
        |seam that keeps the payment provider plug-in replaceable: a different
        |provider is absorbed here rather than in PaymentResultSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for PaymentGateway"
    described as {
      |Stands between the external PaymentGateway and PaymentResultSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'PaymentGatewayEvent Stream' is from outlet FrontOfHouse.PaymentGatewayAdapter.TranslatedPaymentGatewayEvents to inlet FrontOfHouse.PaymentResultSink.IncomingPaymentResults with {
    briefly "PaymentGateway events, translated, on their way to the sink"
    described as {
      |Carries authorization and capture results from the anti-corruption layer to the sink that
      |applies them inside FrontOfHouse.
    }
  }
  streamlet PaymentResultSink as flow is {
    outlet PaymentResultSinkToTableOrder is type TableOrderCommand
    inlet IncomingPaymentResults is type PaymentGatewayEvent    handler PaymentResultHandler is {
      on event PaymentGateway.PaymentAuthorized is {
        let processPayment: type TableOrder.ProcessPayment = prompt("the process payment that results from payment authorized")
        send processPayment to outlet FrontOfHouse.PaymentResultSink.PaymentResultSinkToTableOrder
        do "match PaymentAuthorized.paymentGatewayTransactionId
          to pending TableOrder by payment reference and
          trigger payment capture via PaymentGateway
          streaming topology"
      }
      on event PaymentGateway.PaymentCaptured is {
        let closeOrder: type TableOrder.CloseOrder = prompt("the close order that results from payment captured")
        send closeOrder to outlet FrontOfHouse.PaymentResultSink.PaymentResultSinkToTableOrder
        do "mark payment as fully settled for the matching
          TableOrder using PaymentCaptured
          .captureTransactionId"
      }
    } with {
      briefly "Payment result handler"
      described as {
        |Processes asynchronous payment gateway responses,
        |capturing authorized payments and confirming
        |settlement back to the originating table order.
      }
    }
  } with {
    briefly "Payment result sink"
    described as {
      |Receives payment authorization and capture results
      |from the external payment gateway for two-phase
      |payment processing.
    }
  }
  adaptor NotificationServiceAdapter from context NotificationService as flow is { 
    inlet IncomingNotificationServiceEvents is type NotificationEvent    outlet TranslatedNotificationServiceEvents is type NotificationEvent
    handler InboundNotificationService is {
      on pushNotificationSent: event NotificationService.PushNotificationSent is {
        send pushNotificationSent to outlet TranslatedNotificationServiceEvents
      }
      on other is {
        error "Unexpected message for adaptor NotificationServiceAdapter"
      }
    } with {
      briefly "Inbound NotificationService translation"
      described as {
        |Receives NotificationService events and forwards them to FrontOfHouse. This is the
        |seam that keeps the notification provider plug-in replaceable: a different
        |provider is absorbed here rather than in NotificationAckSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for NotificationService"
    described as {
      |Stands between the external NotificationService and NotificationAckSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'NotificationEvent Stream' is from outlet FrontOfHouse.NotificationServiceAdapter.TranslatedNotificationServiceEvents to inlet FrontOfHouse.NotificationAckSink.NotificationAcks with {
    briefly "NotificationService events, translated, on their way to the sink"
    described as {
      |Carries push notification acknowledgements from the anti-corruption layer to the sink that
      |applies them inside FrontOfHouse.
    }
  }
  streamlet NotificationAckSink as flow is {
    outlet NotificationAckSinkToReservationRepository is command RecordNotificationAck
    inlet NotificationAcks is type NotificationEvent    handler NotificationAckHandler is {
      on event NotificationService.PushNotificationSent is {
        let recordNotificationAck: type RecordNotificationAck = prompt("the record notification ack that results from push notification sent")
        send recordNotificationAck to outlet FrontOfHouse.NotificationAckSink.NotificationAckSinkToReservationRepository
        do "log notification delivery confirmation for
          PushNotificationSent.notificationRecipient at
          PushNotificationSent.sentAt for audit trail"
      }
    } with {
      briefly "Notification acknowledgment handler"
      described as {
        |Logs push notification delivery confirmations
        |for audit trail.
      }
    }
  } with {
    briefly "Notification acknowledgment sink"
    described as {
      |Receives delivery confirmation events from the
      |external push notification service.
    }
  }
  streamlet DrinkOrderEventSink as flow is {
    outlet DrinkOrderEventSinkToTableOrderRepository is type DrinkServiceNotice
    inlet IncomingDrinkOrderEvents is type DrinkOrderEvent    handler DrinkOrderEventIntake is {
      on other is {
        do "the remaining members of this inlet's type - rejections and events this sink does not act on - change nothing here"
      }
      on event Restaurant.Bar.DrinkOrder.DrinkMarkedReady is {
        let notifyDrinkReady: type NotifyDrinkReady = prompt("the notify drink ready that results from drink marked ready")
        send notifyDrinkReady to outlet FrontOfHouse.DrinkOrderEventSink.DrinkOrderEventSinkToTableOrderRepository
        do "notify server that drinks are ready for table"
      }
      on event Restaurant.Bar.DrinkOrder.ServerNotifiedDrinksReady is {
        let notifyDrinksServed: type NotifyDrinksServed = prompt("the notify drinks served that results from server notified drinks ready")
        send notifyDrinksServed to outlet FrontOfHouse.DrinkOrderEventSink.DrinkOrderEventSinkToTableOrderRepository
        do "record drink readiness notification acknowledgment"
      }
    } with {
      briefly "Drink order event intake"
      described as {
        |Processes incoming drink order events for order
        |readiness notification.
      }
    }
  } with {
    briefly "Drink order event sink"
    described as {
      |Receives drink order events from the bar streaming
      |topology for order readiness notification.
    }
  }
  adaptor FromKitchen from context Restaurant.Kitchen as flow is { 
    inlet FromKitchenIn is event Kitchen.KitchenTicket.PreparationStarted with {
      briefly "Kitchen tickets that have started cooking"
      described as {
        |Where Kitchen's `PreparationStarted` arrives. The adaptor is the
        |boundary for this pair, so the connector lands here and not on one of
        |the context's own inlets.
      }
    }
    outlet FromKitchenToFrontOfHouse is command TableOrder.MarkOrderInPreparation
 with {
      briefly "What FromKitchen tells FrontOfHouse"
      described as {
        |A sender publishes only through its OWN outlet, so the translated
        |command travels this one on its way to the context boundary.
      }
    }
    handler KitchenPreparationIntake is {
      on preparationStarted: event Restaurant.Kitchen.KitchenTicket.PreparationStarted is {
        send command MarkOrderInPreparation(tableOrderId = prompt("the table order whose id is preparationStarted.sourceOrderId")) to outlet FrontOfHouse.FromKitchen.FromKitchenToFrontOfHouse
      }
      on other is {
        error "Unexpected message for adaptor FromKitchen"
      }
    } with {
      briefly "Kitchen preparation intake"
      described as {
        |The kitchen decides when a dine-in order is in preparation, because
        |the kitchen is what starts cooking it. Translating its
        |`PreparationStarted` into the order's own `MarkOrderInPreparation`
        |is what makes the order's `InPreparation` state reachable at all.
      }
    }
  } with {
    briefly "Kitchen adaptor"
    described as {
      |Receives the kitchen's progress on tickets cut from this context's
      |orders, and states it as commands those orders accept.
    }
  }
  connector 'FromKitchen To FrontOfHouse' is from outlet FrontOfHouse.FromKitchen.FromKitchenToFrontOfHouse to inlet FrontOfHouse.FrontOfHouseFromFromKitchen with {
    briefly "MarkOrderInPreparation on its way to the boundary"
    described as {
      |A sender publishes only through its OWN outlet, so the adaptor's
      |translation reaches the context here.
    }
  }
  inlet FrontOfHouseFromFromKitchen is command TableOrder.MarkOrderInPreparation with {
    briefly "What FromKitchen hands this context"
    described as {
      |The context is the port at its own boundary: the adaptor's translation
      |arrives here and the boundary handler forwards it to the order's
      |command stream, which is what makes `InPreparation` reachable.
    }
  }
  adaptor FromMenuManagementItems from context Corporate.MenuManagement as flow is { 
    inlet FromMenuManagementItemsIn is type ReactiveBBQ.Corporate.MenuManagement.MenuDistributionEvent    outlet FromMenuManagementItemsToFrontOfHouse is type MenuDistributionCommand
    handler MenuItemEventIntake is {
      on menuItemUpdated: event Corporate.MenuManagement.MenuItem.MenuItemUpdated is {
        send command ApplyMenuItemUpdate(menuItemId = menuItemUpdated.menuItemId) to outlet FrontOfHouse.FromMenuManagementItems.FromMenuManagementItemsToFrontOfHouse
        do "update local menu item cache with changes"
      }
      on priceSet: event Corporate.MenuManagement.MenuItem.PriceSet is {
        send command ApplyMenuItemPriceChange(menuItemId = priceSet.menuItemId) to outlet FrontOfHouse.FromMenuManagementItems.FromMenuManagementItemsToFrontOfHouse
        do "update local menu pricing from corporate"
      }
      on other is {
        error "Unexpected message for adaptor FromMenuManagementItems"
      }
    } with {
      briefly "Menu item event intake"
      described as {
        |Processes incoming menu item events for local menu
        |updates.
      }
    }
    handler MenuReleaseEventIntake is {
      on event Corporate.MenuManagement.MenuRelease.ReleasePublished is {
        let applyMenuRelease: type ApplyMenuRelease = prompt("the apply menu release that results from release published")
        send applyMenuRelease to outlet FrontOfHouse.FromMenuManagementItems.FromMenuManagementItemsToFrontOfHouse
        do "apply published menu release to restaurant"
      }
      on event Corporate.MenuManagement.MenuRelease.ReleaseRolledBack is {
        let rollbackMenuRelease: type RollbackMenuRelease = prompt("the rollback menu release that results from release rolled back")
        send rollbackMenuRelease to outlet FrontOfHouse.FromMenuManagementItems.FromMenuManagementItemsToFrontOfHouse
        do "rollback menu release at restaurant"
      }
      on other is {
        error "Unexpected message for adaptor FromMenuManagementReleases"
      }
    } with {
      briefly "Menu release event intake"
      described as {
        |Processes incoming menu release events for menu
        |distribution.
      }
    }
  } with {
    briefly "Menu item event sink"
    described as {
      |Receives menu item events from the menu management
      |streaming topology for restaurant menu updates.
    }
  }
  // ---- Local event log for reservation events ----
  record LoggedReservationEvent is {
    loggedReservationId: String(1,50) with {
      briefly "LoggedReservationId"
      described as {
        |As the logged event carried it.
      }
    }
    loggedReservationEventType: String(1,50) with {
      briefly "LoggedReservationEventType"
      described as {
        |As the logged event carried it.
      }
    }
    loggedAt: TimeStamp with {
      briefly "Logged at"
      described as {
        |When the log row was written.
      }
    }
  } with {
    briefly "A logged Reservation event"
    described as {
      |One row of the Reservation event log: which reservation, which event,
      |and when it was recorded. `with history` on the entry keeps every
      |version, which is what a log is.
    }
  }
  command LogReservationEvent is {
    loggedReservationId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the reservation the logged event concerns.
      }
    }
    loggedReservationEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of reservation event in one place and must not bind to any single
        |event's shape.
      }
    }
  } with {
    briefly "Log reservation event"
    described as {
      |Append a published reservation event to this context's event log.
    }
  }
  streamlet ReservationEventLog as flow is {
    outlet ReservationEventLogToReservationRepository is command LogReservationEvent
    inlet IncomingReservationLog is type ReservationEvent    handler ReservationLogIntake is {
      on other as m is {
        send command LogReservationEvent(loggedReservationId = m.reservationId, loggedReservationEventType = m.type) to outlet FrontOfHouse.ReservationEventLog.ReservationEventLogToReservationRepository
      }
    } with {
      briefly "Reservation log intake"
      described as {
        |Routes every published reservation event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "Reservation event log"
    described as {
      |Durable local log of reservation events this context publishes.
    }
  }
  connector ReservationToLog is from outlet FrontOfHouse.ReservationEventSource.ReservationEvents to inlet FrontOfHouse.ReservationEventLog.IncomingReservationLog with {
    briefly "Reservation event log connector"
    described as {
      |Wires published reservation events to the context's event log.
    }
  }
  // ---- Local event log for table order events ----
  record LoggedTableOrderEvent is {
    loggedTableOrderId: String(1,50) with {
      briefly "LoggedTableOrderId"
      described as {
        |As the logged event carried it.
      }
    }
    loggedTableOrderEventType: String(1,50) with {
      briefly "LoggedTableOrderEventType"
      described as {
        |As the logged event carried it.
      }
    }
    loggedAt: TimeStamp with {
      briefly "Logged at"
      described as {
        |When the log row was written.
      }
    }
  } with {
    briefly "A logged TableOrder event"
    described as {
      |One row of the TableOrder event log: which tableorder, which event,
      |and when it was recorded. `with history` on the entry keeps every
      |version, which is what a log is.
    }
  }
  command LogTableOrderEvent is {
    loggedTableOrderId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the table order the logged event concerns.
      }
    }
    loggedTableOrderEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of table order event in one place and must not bind to any single
        |event's shape.
      }
    }
  } with {
    briefly "Log table order event"
    described as {
      |Append a published table order event to this context's event log.
    }
  }
  streamlet TableOrderEventLog as flow is {
    outlet TableOrderEventLogToTableOrderRepository is command LogTableOrderEvent
    inlet IncomingTableOrderLog is type OrderEvent    handler TableOrderLogIntake is {
      on other as m is {
        send command LogTableOrderEvent(loggedTableOrderId = m.tableOrderId, loggedTableOrderEventType = m.type) to outlet FrontOfHouse.TableOrderEventLog.TableOrderEventLogToTableOrderRepository
      }
    } with {
      briefly "TableOrder log intake"
      described as {
        |Routes every published table order event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "TableOrder event log"
    described as {
      |Durable local log of table order events this context publishes.
    }
  }
  connector TableOrderToLog is from outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents to inlet FrontOfHouse.TableOrderEventLog.IncomingTableOrderLog with {
    briefly "TableOrder event log connector"
    described as {
      |Wires published table order events to the context's event log.
    }
  }
  streamlet ReservationEventSplit as split is {
    outlet ReservationEventSplitToReporting is type ReservationEvent
    inlet ReservationEventSplitIn is type ReservationEvent    outlet ReservationEventSplitToReservationEventSource is type ReservationEvent
    outlet ReservationEventSplitToReservationRepository is type ReservationEvent
    outlet ReservationEventSplitToReservationBoard is type ReservationEvent
    handler ReservationEventSplitHandler is {
      on reservationMade: event Reservation.ReservationMade is {
        send reservationMade to outlet ReservationEventSplitToReservationRepository
        send reservationMade to outlet ReservationEventSplitToReservationBoard
        send reservationMade to outlet ReservationEventSplitToReservationEventSource
        send reservationMade to outlet ReservationEventSplitToReporting
        tell reservationMade to entity FrontOfHouse.Reservation
      }
      on reservationConfirmed: event Reservation.ReservationConfirmed is {
        send reservationConfirmed to outlet ReservationEventSplitToReservationRepository
        send reservationConfirmed to outlet ReservationEventSplitToReservationBoard
        send reservationConfirmed to outlet ReservationEventSplitToReservationEventSource
        tell reservationConfirmed to entity FrontOfHouse.Reservation
      }
      on reservationCancelled: event Reservation.ReservationCancelled is {
        send reservationCancelled to outlet ReservationEventSplitToReservationRepository
        send reservationCancelled to outlet ReservationEventSplitToReservationBoard
        send reservationCancelled to outlet ReservationEventSplitToReservationEventSource
        send reservationCancelled to outlet ReservationEventSplitToReporting
        tell reservationCancelled to entity FrontOfHouse.Reservation
      }
      on partySeated: event Reservation.PartySeated is {
        send partySeated to outlet ReservationEventSplitToReservationRepository
        send partySeated to outlet ReservationEventSplitToReservationBoard
        send partySeated to outlet ReservationEventSplitToReservationEventSource
        tell partySeated to entity FrontOfHouse.Reservation
      }
      on visitCompleted: event Reservation.VisitCompleted is {
        send visitCompleted to outlet ReservationEventSplitToReservationRepository
        send visitCompleted to outlet ReservationEventSplitToReservationBoard
        send visitCompleted to outlet ReservationEventSplitToReservationEventSource
        tell visitCompleted to entity FrontOfHouse.Reservation
      }
      on noShowMarked: event Reservation.NoShowMarked is {
        send noShowMarked to outlet ReservationEventSplitToReservationRepository
        send noShowMarked to outlet ReservationEventSplitToReservationBoard
        send noShowMarked to outlet ReservationEventSplitToReservationEventSource
        tell noShowMarked to entity FrontOfHouse.Reservation
      }
      on reservationRescheduled: event Reservation.ReservationRescheduled is {
        send reservationRescheduled to outlet ReservationEventSplitToReservationRepository
        send reservationRescheduled to outlet ReservationEventSplitToReservationBoard
        send reservationRescheduled to outlet ReservationEventSplitToReservationEventSource
        tell reservationRescheduled to entity FrontOfHouse.Reservation
      }
      on other is {
        error "Unexpected message for processor ReservationEventSplit"
      }
    } with {
      briefly "Reservation event fan-out handler"
      described as {
        |Delivers each Reservation event to all of its consumers.
      }
    }
  } with {
    briefly "Reservation event fan-out"
    described as {
      |Fans Reservation events out to the repository and projectors.
    }
  }
  streamlet TableOrderEventSplit as split is {
    inlet TableOrderEventSplitIn is type TableOrderEvent    outlet TableOrderEventSplitToTableOrderEventSource is type TableOrderEvent
    outlet TableOrderEventSplitToTableOrderRepository is type TableOrderEvent
    outlet TableOrderEventSplitToReservationBoard is type TableOrderEvent
    handler TableOrderEventSplitHandler is {
      on orderCreated: event TableOrder.OrderCreated is {
        send orderCreated to outlet TableOrderEventSplitToTableOrderRepository
        send orderCreated to outlet TableOrderEventSplitToReservationBoard
        send orderCreated to outlet TableOrderEventSplitToTableOrderEventSource
        tell orderCreated to entity FrontOfHouse.TableOrder
      }
      on itemAdded: event TableOrder.ItemAdded is {
        send itemAdded to outlet TableOrderEventSplitToTableOrderRepository
        send itemAdded to outlet TableOrderEventSplitToReservationBoard
        send itemAdded to outlet TableOrderEventSplitToTableOrderEventSource
        tell itemAdded to entity FrontOfHouse.TableOrder
      }
      on itemRemoved: event TableOrder.ItemRemoved is {
        send itemRemoved to outlet TableOrderEventSplitToTableOrderRepository
        send itemRemoved to outlet TableOrderEventSplitToReservationBoard
        tell itemRemoved to entity FrontOfHouse.TableOrder
      }
      on orderSubmitted: event TableOrder.OrderSubmitted is {
        send orderSubmitted to outlet TableOrderEventSplitToTableOrderRepository
        send orderSubmitted to outlet TableOrderEventSplitToReservationBoard
        send orderSubmitted to outlet TableOrderEventSplitToTableOrderEventSource
        tell orderSubmitted to entity FrontOfHouse.TableOrder
      }
      on billPresented: event TableOrder.BillPresented is {
        send billPresented to outlet TableOrderEventSplitToTableOrderRepository
        send billPresented to outlet TableOrderEventSplitToReservationBoard
        tell billPresented to entity FrontOfHouse.TableOrder
      }
      on paymentProcessed: event TableOrder.PaymentProcessed is {
        send paymentProcessed to outlet TableOrderEventSplitToTableOrderRepository
        send paymentProcessed to outlet TableOrderEventSplitToReservationBoard
        send paymentProcessed to outlet TableOrderEventSplitToTableOrderEventSource
        tell paymentProcessed to entity FrontOfHouse.TableOrder
      }
      on orderClosed: event TableOrder.OrderClosed is {
        send orderClosed to outlet TableOrderEventSplitToTableOrderRepository
        send orderClosed to outlet TableOrderEventSplitToReservationBoard
        send orderClosed to outlet TableOrderEventSplitToTableOrderEventSource
        tell orderClosed to entity FrontOfHouse.TableOrder
      }
      on orderMarkedInPreparation: event TableOrder.OrderMarkedInPreparation is {
        send orderMarkedInPreparation to outlet TableOrderEventSplitToTableOrderRepository
        send orderMarkedInPreparation to outlet TableOrderEventSplitToReservationBoard
        tell orderMarkedInPreparation to entity FrontOfHouse.TableOrder
      }
      on orderMarkedReadyToServe: event TableOrder.OrderMarkedReadyToServe is {
        send orderMarkedReadyToServe to outlet TableOrderEventSplitToTableOrderRepository
        send orderMarkedReadyToServe to outlet TableOrderEventSplitToReservationBoard
        tell orderMarkedReadyToServe to entity FrontOfHouse.TableOrder
      }
      on ticketRouted: event TableOrder.TicketRouted is {
        send ticketRouted to outlet TableOrderEventSplitToTableOrderRepository
        send ticketRouted to outlet TableOrderEventSplitToReservationBoard
        tell ticketRouted to entity FrontOfHouse.TableOrder
      }
      on drinkOrderRouted: event TableOrder.DrinkOrderRouted is {
        send drinkOrderRouted to outlet TableOrderEventSplitToTableOrderRepository
        send drinkOrderRouted to outlet TableOrderEventSplitToReservationBoard
        tell drinkOrderRouted to entity FrontOfHouse.TableOrder
      }
      on pointsAccrualRouted: event TableOrder.PointsAccrualRouted is {
        send pointsAccrualRouted to outlet TableOrderEventSplitToTableOrderRepository
        send pointsAccrualRouted to outlet TableOrderEventSplitToReservationBoard
        tell pointsAccrualRouted to entity FrontOfHouse.TableOrder
      }
      on other is {
        error "Unexpected message for processor TableOrderEventSplit"
      }
    } with {
      briefly "TableOrder event fan-out handler"
      described as {
        |Delivers each TableOrder event to all of its consumers.
      }
    }
  } with {
    briefly "TableOrder event fan-out"
    described as {
      |Fans TableOrder events out to the repository and projectors.
    }
  }
  connector 'ReservationEventSource Feed' is from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReservationEventSource to inlet FrontOfHouse.ReservationEventSource.ReservationEventSourceIn with {
    briefly "The events the Reservation log keeps, on their way to it"
    described as {
      |The events the Reservation log keeps, on their way to it.
    }
  }
  connector 'ReservationEvent Stream' is from outlet FrontOfHouse.Reservation.ReservationEvents2 to inlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitIn with {
    briefly "Reservation events, fanned out to storage and read models"
    described as {
      |Carries what leaves ReservationEvents2 to ReservationEventSplitIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'ReservationEvent Storage' is from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReservationRepository to inlet FrontOfHouse.ReservationProjection.ReservationProjectionFromReservation with {
    briefly "Reservation events on their way to storage"
    described as {
      |Carries what leaves ReservationEventSplitToReservationRepository to ReservationRepositoryFromReservation, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'ReservationEvent Feed' is from outlet FrontOfHouse.ReservationEventSplit.ReservationEventSplitToReservationBoard to inlet FrontOfHouse.ReservationBoard.ReservationBoardFromReservation with {
    briefly "ReservationEvent feeding the ReservationBoard projection"
    described as {
      |Carries what leaves ReservationEventSplitToReservationBoard to ReservationBoardFromReservation, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'ToPaymentGateway Feed' is from outlet FrontOfHouse.TableOrderEventSource.TableOrderEventSourceToToPaymentGateway to inlet FrontOfHouse.ToPaymentGateway.ToPaymentGatewayIn with {
    briefly "The TableOrder events ToPaymentGateway translates, on their way to it"
    described as {
      |The TableOrder events ToPaymentGateway translates, on their way to it.
    }
  }
  connector 'TableOrderEventSource Feed' is from outlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitToTableOrderEventSource to inlet FrontOfHouse.TableOrderEventSource.TableOrderEventSourceIn with {
    briefly "The events the TableOrder log keeps, on their way to it"
    described as {
      |The events the TableOrder log keeps, on their way to it.
    }
  }
  connector 'TableOrderEvent Stream' is from outlet FrontOfHouse.TableOrder.TableOrderEvents2 to inlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitIn with {
    briefly "TableOrder events, fanned out to storage and read models"
    described as {
      |Carries what leaves TableOrderEvents2 to TableOrderEventSplitIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'TableOrderEvent Storage' is from outlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitToTableOrderRepository to inlet FrontOfHouse.TableOrderProjection.TableOrderProjectionFromTableOrder with {
    briefly "TableOrder events on their way to storage"
    described as {
      |Carries what leaves TableOrderEventSplitToTableOrderRepository to TableOrderRepositoryFromTableOrder, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'TableOrderEvent Feed' is from outlet FrontOfHouse.TableOrderEventSplit.TableOrderEventSplitToReservationBoard to inlet FrontOfHouse.ReservationBoard.ReservationBoardFromTableOrder with {
    briefly "TableOrderEvent feeding the ReservationBoard projection"
    described as {
      |Carries what leaves TableOrderEventSplitToReservationBoard to ReservationBoardFromTableOrder, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'ReservationBoard Storage' is from outlet FrontOfHouse.ReservationBoard.ReservationBoardOut to inlet FrontOfHouse.ReservationRepository.ReservationRepositoryFromReservationBoard with {
    briefly "The ReservationBoard projection on its way to storage"
    described as {
      |Carries what leaves ReservationBoardOut to ReservationRepositoryFromReservationBoard, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  option message_envelope("Riddl.Envelope")
  briefly "Front of house context"
  described as {
    | Manages reservations, table seating, dine-in orders,
    | billing, and payment. Communicates with kitchen, bar,
    | and loyalty contexts via adaptors.
  }
}
