        send event TableOrder.SubmitOrderRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.SubmitOrderRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.PresentBillRejected is {
        send event TableOrder.PresentBillRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.PresentBillRejected to outlet TableOrderEventSplitToReservationBoard
        tell event TableOrder.PresentBillRejected to entity FrontOfHouse.TableOrder
      }
      on event TableOrder.ProcessPaymentRejected is {
        send event TableOrder.ProcessPaymentRejected to outlet TableOrderEventSplitToTableOrderRepository
        send event TableOrder.ProcessPaymentRejected to outlet TableOrderEventSplitToReservationBoard
