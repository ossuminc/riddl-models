// DrinkOrder entity for the Bar context
event-sourced entity DrinkOrder as flow is {
  type DrinkOrderCommand is one of {
    DrinkOrder.ReceiveDrinkOrder or DrinkOrder.PrepareDrink or DrinkOrder.MarkDrinkReady or DrinkOrder.NotifyServerDrinksReady or DrinkOrder.CompleteDrinkOrder
  } with {
    briefly "DrinkOrder command alternation"
    described as {
      |Commands accepted by the DrinkOrder entity.
    }
  }
  inlet DrinkOrderCommands is type DrinkOrderCommand  outlet DrinkOrderEvents2 is type DrinkOrderEvent
  // ---- Commands ----
  command ReceiveDrinkOrder yields event DrinkOrderReceived is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |Identifier for the new drink order.
      }
    }
    sourceOrderId: String(1,50) with {
      briefly "Source order ID"
      described as {
        |Identifier of the originating table order.
      }
    }
    drinkTableNumber: Natural with {
      briefly "Table"
      described as {
        |Table the drinks are for.
      }
    }
    drinkItems: DrinkItem+ with {
      briefly "Drinks"
      described as {
        |Drinks to prepare.
      }
    }
    drinkReceivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the drink order was received.
      }
    }
  } with {
    briefly "Receive drink order"
    described as {
      |Receive a new drink order from a table order.
    }
  }
  command PrepareDrink yields event DrinkPrepared is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |Drink order to prepare.
      }
    }
    drinkPreparationStartedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When preparation began.
      }
    }
  } with {
    briefly "Prepare drink"
    described as {
      |Start preparing the drink order.
    }
  }
  command MarkDrinkReady yields event DrinkMarkedReady is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |Drink order that is ready.
      }
    }
    drinkReadyAt: TimeStamp with {
      briefly "Ready at"
      described as {
        |When the drinks were ready.
      }
    }
  } with {
    briefly "Mark drink ready"
    described as {
      |Mark the drink order as ready for pickup.
    }
  }
  command NotifyServerDrinksReady yields event ServerNotifiedDrinksReady is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |Drink order to notify about.
      }
    }
    serverNotifiedAt: TimeStamp with {
      briefly "Notified at"
      described as {
        |When the floor was called. Drinks start dying the moment they are
        |poured — heads collapse and ice melts — so this is the point from
        |which the order is deteriorating rather than merely waiting.
      }
    }
  } with {
    briefly "Notify server drinks ready"
    described as {
      |Push notification to server that drinks are ready.
    }
  }
  command CompleteDrinkOrder yields event DrinkOrderCompleted is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |Drink order to complete.
      }
    }
    drinkCompletedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the drink order was completed.
      }
    }
  } with {
    briefly "Complete drink order"
    described as {
      |Mark the drink order as delivered and complete.
    }
  }
  // ---- Events ----
  event DrinkOrderReceived is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The bar order just opened. Every later event carries the same value,
        |so a round's whole passage through the bar can be assembled from the
        |event log.
      }
    }
    sourceOrderId: String(1,50) with {
      briefly "Source order ID"
      described as {
        |Originating order.
      }
    }
    drinkTableNumber: Natural with {
      briefly "Table"
      described as {
        |Where the round is going. The bar works by table, not by guest — a
        |server collects a whole table's drinks in one trip.
      }
    }
    drinkItems: DrinkItem+ with {
      briefly "Drinks"
      described as {
        |Drinks ordered.
      }
    }
    drinkReceivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the round reached the bar. Time zero for the bar clock, which
        |runs separately from the kitchen's because drinks and food are made
        |at different speeds.
      }
    }
  } with {
    briefly "Drink order received"
    described as {
      |Emitted when a new drink order arrives at the bar.
    }
  }
  event DrinkPrepared is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round a bartender has begun pouring. Unlike a kitchen ticket a
        |round is usually made in one pass, so preparation and readiness sit
        |close together.
      }
    }
    drinkPreparationStartedAt: TimeStamp with {
      briefly "Started at"
      described as {
        |When preparation began.
      }
    }
  } with {
    briefly "Drink prepared"
    described as {
      |Emitted when drink preparation begins.
    }
  }
  event DrinkMarkedReady is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round now standing on the bar. From here it is the floor's
        |responsiveness, not the bar's, that decides whether it arrives
        |drinkable.
      }
    }
    drinkReadyAt: TimeStamp with {
      briefly "Ready at"
      described as {
        |When drinks were ready.
      }
    }
  } with {
    briefly "Drink marked ready"
    described as {
      |Emitted when drinks are ready for pickup.
    }
  }
  event ServerNotifiedDrinksReady is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round the floor has been called for. Notification is what turns
        |drinks standing on the bar into a server's errand.
      }
    }
    drinkTableNumber: Natural with {
      briefly "Table"
      described as {
        |Table the drinks are for.
      }
    }
    serverNotifiedAt: TimeStamp with {
      briefly "Notified at"
      described as {
        |When the call went out. Measured against the pour, this is the gap
        |the bar can see but cannot close on its own.
      }
    }
  } with {
    briefly "Server notified drinks ready"
    described as {
      | Emitted when the server receives a push notification
      | that drinks are ready, solving the melting-ice problem.
    }
  }
  event DrinkOrderCompleted is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round the server has collected. Completion is the bar's release
        |of it, distinct from the guest ever receiving the drink.
      }
    }
    drinkCompletedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the round left the bar. The span from receipt to here is the
        |bar's own service time, the figure a bar manager staffs against.
      }
    }
  } with {
    briefly "Drink order completed"
    described as {
      |Emitted when drinks are delivered to the table.
    }
  }
  // ---- Rejection Events ----
  event ReceiveDrinkOrderRejected is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round that could not be opened — most often a duplicate, when a
        |server re-fires a round already sent.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the receive command was rejected.
      }
    }
  } with {
    briefly "Receive drink order rejected"
    described as {
      |Emitted when a receive drink order command is rejected.
    }
  }
  event PrepareDrinkRejected is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round that could not be started, typically because it was
        |already poured or has since been cancelled at the table.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the prepare command was rejected.
      }
    }
  } with {
    briefly "Prepare drink rejected"
    described as {
      |Emitted when a prepare drink command is rejected.
    }
  }
  event MarkDrinkReadyRejected is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round that could not be marked ready, typically because pouring
        |on it never started.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the mark ready command was rejected.
      }
    }
  } with {
    briefly "Mark drink ready rejected"
    described as {
      |Emitted when a mark drink ready command is rejected.
    }
  }
  event NotifyServerDrinksReadyRejected is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round the floor could not be called for, typically because the
        |drinks are not yet standing on the bar.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the notify server command was rejected.
      }
    }
  } with {
    briefly "Notify server drinks ready rejected"
    described as {
      |Emitted when a notify server command is rejected.
    }
  }
  event CompleteDrinkOrderRejected is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round that could not be closed, typically because no server has
        |collected it.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the complete command was rejected.
      }
    }
  } with {
    briefly "Complete drink order rejected"
    described as {
      |Emitted when a complete drink order command is rejected.
    }
  }
  // ---- Queries and Results ----
  query GetDrinkOrder is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |Drink order to retrieve.
      }
    }
  } with {
    briefly "Get drink order"
    described as {
      |Query a drink order by its identifier.
    }
  }
  result DrinkOrderResult is  {
    order: DrinkOrderData with {
      briefly "Order"
      described as {
        |The requested drink order data.
      }
    }
  } with {
    briefly "Drink order result"
    described as {
      |Result containing the requested drink order data.
    }
  }
  // ---- State ----
  record DrinkOrderData is  {
    drinkOrderId: DrinkOrderId with {
      briefly "ID"
      described as {
        |The round this state belongs to. Carried through every lifecycle
        |state so the record can be rebuilt by replaying the event log.
      }
    }
    sourceOrderId: String(1,50) with {
      briefly "Source order ID"
      described as {
        |Originating order.
      }
    }
    drinkTableNumber: Natural with {
      briefly "Table"
      described as {
        |The table waiting on this round, held in state because the bar needs
        |it to call the right server, not only to route the original order.
      }
    }
    drinkItems: DrinkItem+ with {
      briefly "Drinks"
      described as {
        |Drinks in the order.
      }
    }
    drinkReceivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the round reached the bar, kept so the age of a drink standing
        |unclaimed can be read straight off the record.
      }
    }
    actualDrinkReadyAt: TimeStamp? with {
      briefly "Ready at"
      described as {
        |When drinks were ready.
      }
    }
    actualDrinkCompletedAt: TimeStamp? with {
      briefly "Completed at"
      described as {
        |When the round was collected, absent until it is. Its absence is
        |what marks a drink still sitting on the bar going flat.
      }
    }
  } with {
    briefly "Drink order state data"
    described as {
      |Full state of a drink order. Shared across all
      |lifecycle states as a superset record.
    }
  }
  initial state Received of record DrinkOrder.DrinkOrderData is {
    initial handler ReceivedInitHandler is {
      on init is {
        yield event DrinkOrderReceived
      }
    } with {
      briefly "Received init handler"
      described as {
        |Initializes the Received state with default values.
      }
    }
    handler ReceivedHandler is {
      on prepareDrink: command PrepareDrink is {
        yield event DrinkPrepared(drinkOrderId = prepareDrink.drinkOrderId, drinkPreparationStartedAt = prepareDrink.drinkPreparationStartedAt)
        send event DrinkPrepared(drinkOrderId = prepareDrink.drinkOrderId, drinkPreparationStartedAt = prepareDrink.drinkPreparationStartedAt) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on drinkPrepared: event DrinkPrepared is {
        morph entity Bar.DrinkOrder to state Bar.DrinkOrder.InPreparation with record DrinkOrder.DrinkOrderData(drinkOrderId = drinkPrepared.drinkOrderId)
        set state DrinkOrder.InPreparation to "drinkOrderId, sourceOrderId, drinkTableNumber, drinkItems, drinkReceivedAt, actualDrinkReadyAt = none, actualDrinkCompletedAt = none"
      }
      on receiveDrinkOrder: command ReceiveDrinkOrder is {
        error "DrinkOrder does not accept ReceiveDrinkOrder in this state"
        send event ReceiveDrinkOrderRejected(drinkOrderId = receiveDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on markDrinkReady: command MarkDrinkReady is {
        error "DrinkOrder does not accept MarkDrinkReady in this state"
        send event MarkDrinkReadyRejected(drinkOrderId = markDrinkReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on notifyServerDrinksReady: command NotifyServerDrinksReady is {
        error "DrinkOrder does not accept NotifyServerDrinksReady in this state"
        send event NotifyServerDrinksReadyRejected(drinkOrderId = notifyServerDrinksReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on completeDrinkOrder: command CompleteDrinkOrder is {
        error "DrinkOrder does not accept CompleteDrinkOrder in this state"
        send event CompleteDrinkOrderRejected(drinkOrderId = completeDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
    } with {
      briefly "Received state handler"
      described as {
        |Handles commands valid in the Received state.
        |Only PrepareDrink advances the lifecycle.
      }
    }
  } with {
    briefly "Drink order received"
    described as {
      |Initial state when a drink order arrives at the bar
      |from a table order submission.
    }
  }
  state InPreparation of record DrinkOrder.DrinkOrderData is {
    initial handler InPreparationInitHandler is {
      on init is {
        yield event DrinkPrepared
      }
    } with {
      briefly "InPreparation init handler"
      described as {
        |Initializes the InPreparation state with default values.
      }
    }
    handler InPreparationHandler is {
      on markDrinkReady: command MarkDrinkReady is {
        yield event DrinkMarkedReady(drinkOrderId = markDrinkReady.drinkOrderId, drinkReadyAt = markDrinkReady.drinkReadyAt)
        send event DrinkMarkedReady(drinkOrderId = markDrinkReady.drinkOrderId, drinkReadyAt = markDrinkReady.drinkReadyAt) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on drinkMarkedReady: event DrinkMarkedReady is {
        morph entity Bar.DrinkOrder to state Bar.DrinkOrder.Ready with record DrinkOrder.DrinkOrderData(drinkOrderId = drinkMarkedReady.drinkOrderId)
        set field DrinkOrder.Ready.actualDrinkReadyAt to "drinkReadyAt from event"
        tell command NotifyServerDrinksReady(drinkOrderId = drinkMarkedReady.drinkOrderId) to entity Bar.DrinkOrder
        set state Ready to "drinkOrderId, sourceOrderId, drinkTableNumber, drinkItems, drinkReceivedAt, actualDrinkReadyAt, actualDrinkCompletedAt = none"
      }
      on receiveDrinkOrder: command ReceiveDrinkOrder is {
        error "DrinkOrder does not accept ReceiveDrinkOrder in this state"
        send event ReceiveDrinkOrderRejected(drinkOrderId = receiveDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on prepareDrink: command PrepareDrink is {
        error "DrinkOrder does not accept PrepareDrink in this state"
        send event PrepareDrinkRejected(drinkOrderId = prepareDrink.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on notifyServerDrinksReady: command NotifyServerDrinksReady is {
        error "DrinkOrder does not accept NotifyServerDrinksReady in this state"
        send event NotifyServerDrinksReadyRejected(drinkOrderId = notifyServerDrinksReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on completeDrinkOrder: command CompleteDrinkOrder is {
        error "DrinkOrder does not accept CompleteDrinkOrder in this state"
        send event CompleteDrinkOrderRejected(drinkOrderId = completeDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
    } with {
      briefly "InPreparation state handler"
      described as {
        |Handles commands valid in the InPreparation state.
        |MarkDrinkReady advances the lifecycle and auto-triggers
        |server notification.
      }
    }
  } with {
    briefly "Drink in preparation"
    described as {
      |Bartender is actively preparing the drinks.
    }
  }
  state Ready of record DrinkOrder.DrinkOrderData is {
    initial handler ReadyInitHandler is {
      on init is {
        yield event DrinkMarkedReady
      }
    } with {
      briefly "Ready init handler"
      described as {
        |Initializes the Ready state with default values.
      }
    }
    handler ReadyHandler is {
      on notifyServerDrinksReady: command NotifyServerDrinksReady is {
        yield event ServerNotifiedDrinksReady(drinkOrderId = notifyServerDrinksReady.drinkOrderId, serverNotifiedAt = notifyServerDrinksReady.serverNotifiedAt)
        send event ServerNotifiedDrinksReady(drinkOrderId = notifyServerDrinksReady.drinkOrderId, serverNotifiedAt = notifyServerDrinksReady.serverNotifiedAt) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on serverNotifiedDrinksReady: event ServerNotifiedDrinksReady is {
        morph entity Bar.DrinkOrder to state Bar.DrinkOrder.Delivered with record DrinkOrder.DrinkOrderData(drinkOrderId = serverNotifiedDrinksReady.drinkOrderId, drinkTableNumber = serverNotifiedDrinksReady.drinkTableNumber)
        do "ServerNotifiedDrinksReady event triggers push
          notification to server via NotificationService
          streaming topology"
        set state DrinkOrder.Delivered to "drinkOrderId, sourceOrderId, drinkTableNumber, drinkItems, drinkReceivedAt, actualDrinkReadyAt, actualDrinkCompletedAt = none"
      }
      on receiveDrinkOrder: command ReceiveDrinkOrder is {
        error "DrinkOrder does not accept ReceiveDrinkOrder in this state"
        send event ReceiveDrinkOrderRejected(drinkOrderId = receiveDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on prepareDrink: command PrepareDrink is {
        error "DrinkOrder does not accept PrepareDrink in this state"
        send event PrepareDrinkRejected(drinkOrderId = prepareDrink.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on markDrinkReady: command MarkDrinkReady is {
        error "DrinkOrder does not accept MarkDrinkReady in this state"
        send event MarkDrinkReadyRejected(drinkOrderId = markDrinkReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on completeDrinkOrder: command CompleteDrinkOrder is {
        error "DrinkOrder does not accept CompleteDrinkOrder in this state"
        send event CompleteDrinkOrderRejected(drinkOrderId = completeDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
    } with {
      briefly "Ready state handler"
      described as {
        |Handles commands valid in the Ready state.
        |NotifyServerDrinksReady advances the lifecycle
        |and triggers a push notification to the server.
      }
    }
  } with {
    briefly "Drinks ready"
    described as {
      |Drinks are prepared and waiting for server pickup.
    }
  }
  state Delivered of record DrinkOrder.DrinkOrderData is {
    initial handler DeliveredInitHandler is {
      on init is {
        yield event ServerNotifiedDrinksReady
      }
    } with {
      briefly "Delivered init handler"
      described as {
        |Initializes the Delivered state with default values.
      }
    }
    handler DeliveredHandler is {
      on completeDrinkOrder: command CompleteDrinkOrder is {
        yield event DrinkOrderCompleted(drinkOrderId = completeDrinkOrder.drinkOrderId, drinkCompletedAt = completeDrinkOrder.drinkCompletedAt)
        send event DrinkOrderCompleted(drinkOrderId = completeDrinkOrder.drinkOrderId, drinkCompletedAt = completeDrinkOrder.drinkCompletedAt) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on drinkOrderCompleted: event DrinkOrderCompleted is {
        morph entity Bar.DrinkOrder to state Bar.DrinkOrder.Completed with record DrinkOrder.DrinkOrderData(drinkOrderId = drinkOrderCompleted.drinkOrderId)
        set field DrinkOrder.Completed.actualDrinkCompletedAt to "drinkCompletedAt from event"
        set state DrinkOrder.Completed to "drinkOrderId, sourceOrderId, drinkTableNumber, drinkItems, drinkReceivedAt, actualDrinkReadyAt, actualDrinkCompletedAt"
      }
      on receiveDrinkOrder: command ReceiveDrinkOrder is {
        error "DrinkOrder does not accept ReceiveDrinkOrder in this state"
        send event ReceiveDrinkOrderRejected(drinkOrderId = receiveDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on prepareDrink: command PrepareDrink is {
        error "DrinkOrder does not accept PrepareDrink in this state"
        send event PrepareDrinkRejected(drinkOrderId = prepareDrink.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on markDrinkReady: command MarkDrinkReady is {
        error "DrinkOrder does not accept MarkDrinkReady in this state"
        send event MarkDrinkReadyRejected(drinkOrderId = markDrinkReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on notifyServerDrinksReady: command NotifyServerDrinksReady is {
        error "DrinkOrder does not accept NotifyServerDrinksReady in this state"
        send event NotifyServerDrinksReadyRejected(drinkOrderId = notifyServerDrinksReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
    } with {
      briefly "Delivered state handler"
      described as {
        |Handles commands valid in the Delivered state.
        |CompleteDrinkOrder finalizes the lifecycle.
      }
    }
  } with {
    briefly "Drinks delivered"
    described as {
      |Server has been notified and drinks are on the way
      |to the table.
    }
  }
  state Completed of record DrinkOrder.DrinkOrderData is {
    initial handler CompletedInitHandler is {
      on init is {
        yield event DrinkOrderCompleted
      }
    } with {
      briefly "Completed init handler"
      described as {
        |Initializes the Completed state with default values.
      }
    }
    handler CompletedHandler is {
      on receiveDrinkOrder: command ReceiveDrinkOrder is {
        error "DrinkOrder does not accept ReceiveDrinkOrder in this state"
        send event ReceiveDrinkOrderRejected(drinkOrderId = receiveDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on prepareDrink: command PrepareDrink is {
        error "DrinkOrder does not accept PrepareDrink in this state"
        send event PrepareDrinkRejected(drinkOrderId = prepareDrink.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on markDrinkReady: command MarkDrinkReady is {
        error "DrinkOrder does not accept MarkDrinkReady in this state"
        send event MarkDrinkReadyRejected(drinkOrderId = markDrinkReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on notifyServerDrinksReady: command NotifyServerDrinksReady is {
        error "DrinkOrder does not accept NotifyServerDrinksReady in this state"
        send event NotifyServerDrinksReadyRejected(drinkOrderId = notifyServerDrinksReady.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
      on completeDrinkOrder: command CompleteDrinkOrder is {
        error "DrinkOrder does not accept CompleteDrinkOrder in this state"
        send event CompleteDrinkOrderRejected(drinkOrderId = completeDrinkOrder.drinkOrderId) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
      }
    } with {
      briefly "Completed state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Drink order completed"
    described as {
      |Drinks have been delivered to the table and the
      |drink order is finalized.
    }
  }
  handler DrinkOrderCreationHandler is {
    on receiveDrinkOrder: command ReceiveDrinkOrder is {
      yield event DrinkOrderReceived(drinkOrderId = receiveDrinkOrder.drinkOrderId, sourceOrderId = receiveDrinkOrder.sourceOrderId, drinkTableNumber = receiveDrinkOrder.drinkTableNumber, drinkItems = receiveDrinkOrder.drinkItems, drinkReceivedAt = receiveDrinkOrder.drinkReceivedAt)
      send event DrinkOrderReceived(drinkOrderId = receiveDrinkOrder.drinkOrderId, sourceOrderId = receiveDrinkOrder.sourceOrderId, drinkTableNumber = receiveDrinkOrder.drinkTableNumber, drinkItems = receiveDrinkOrder.drinkItems, drinkReceivedAt = receiveDrinkOrder.drinkReceivedAt) to outlet Bar.DrinkOrderEventSource.DrinkOrderEvents
    }
    on drinkOrderReceived: event DrinkOrderReceived is {
      morph entity Bar.DrinkOrder to state Bar.DrinkOrder.Received with record DrinkOrder.DrinkOrderData(drinkOrderId = drinkOrderReceived.drinkOrderId, sourceOrderId = drinkOrderReceived.sourceOrderId, drinkTableNumber = drinkOrderReceived.drinkTableNumber, drinkItems = drinkOrderReceived.drinkItems, drinkReceivedAt = drinkOrderReceived.drinkReceivedAt)
      set state DrinkOrder.Received to "drinkOrderId, sourceOrderId, drinkTableNumber, drinkItems, drinkReceivedAt, actualDrinkReadyAt = none, actualDrinkCompletedAt = none"
    }
    on query GetDrinkOrder is {
      do "look up DrinkOrder by GetDrinkOrder.drinkOrderId"
      tell result DrinkOrderResult to entity Bar.DrinkOrder
    }
  } with {
    briefly "Drink order creation handler"
    described as {
      |Handles the initial ReceiveDrinkOrder command when
      |the entity has no state yet, and the GetDrinkOrder
      |query for retrieving drink order data.
    }
  }
} with {
  briefly "Drink order entity"
  described as {
    | Manages the lifecycle of a drink order from receipt
    | through preparation, readiness notification, and
    | delivery to the table. Push notifications solve the
    | bartender-server communication gap. State handlers
    | ensure commands are only valid in appropriate states,
    | and events are persisted before state transitions.
  }
}
