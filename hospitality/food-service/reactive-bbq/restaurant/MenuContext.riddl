// Menu bounded context: the restaurant's own menu, as corporate releases set it
context Menu as router is {
  type RestaurantMenuItemId is Id(Menu.RestaurantMenuItem)  with {
    briefly "Restaurant menu item identifier"
    described as {
      |Identifies this restaurant's listing of one dish. It is minted when the
      |dish first reaches the restaurant's menu, so it is not Corporate's menu
      |item id; the menu repository indexes it by the dish's item code.
    }
  }
  record MenuListing is {
    listedItemCode: String(1,50) with {
      briefly "Item code"
      described as {
        |The code orders name the dish by.
      }
    }
    listedItemName: String(1,200) with {
      briefly "Name"
      described as {
        |The dish's name on this restaurant's menu.
      }
    }
    listedItemCategory: Corporate.MenuManagement.MenuItemCategory with {
      briefly "Category"
      described as {
        |Where on the menu the dish appears.
      }
    }
    listedItemPrice: Decimal(8,2) with {
      briefly "Price"
      described as {
        |What the restaurant charges for the dish.
      }
    }
    listedInRelease: Corporate.MenuManagement.MenuReleaseId with {
      briefly "Release"
      described as {
        |The corporate release this listing came from.
      }
    }
  } with {
    briefly "How a dish is listed"
    described as {
      |One dish as a release listed it on this restaurant's menu.
    }
  }
  command ApplyMenuRelease is {
    releaseId: Corporate.MenuManagement.MenuReleaseId with {
      briefly "Release"
      described as {
        |The published release to apply.
      }
    }
    releaseChanges: Corporate.MenuManagement.ReleasedMenuItem* with {
      briefly "Changes"
      described as {
        |Each dish the release adds, changes or withdraws, with its listing.
      }
    }
  } with {
    briefly "Apply menu release"
    described as {
      |Puts a published corporate release onto this restaurant's menu: each
      |dish it adds is listed, each it changes is relisted, and each it
      |withdraws comes off the menu.
    }
  }
  command RollbackMenuRelease is {
    releaseId: Corporate.MenuManagement.MenuReleaseId with {
      briefly "Release"
      described as {
        |The release to undo.
      }
    }
    rolledBackChanges: Corporate.MenuManagement.ReleasedMenuItem* with {
      briefly "Changes undone"
      described as {
        |The changes the release made, each to be reversed.
      }
    }
  } with {
    briefly "Rollback menu release"
    described as {
      |Undoes a release on this restaurant's menu: a dish it added comes off
      |the menu, and a dish it changed or withdrew gets back the listing it
      |had before.
    }
  }
  type RestaurantMenuRelease is one of {
    Menu.ApplyMenuRelease or Menu.RollbackMenuRelease
  } with {
    briefly "What a corporate release asks of the menu"
    described as {
      |Publication and rollback of a corporate release, as FrontOfHouse
      |forwards them.
    }
  }
  query FindMenuListing replies result MenuListingFound is {
    listingItemCode: String(1,50) with {
      briefly "Item code"
      described as {
        |The code of the dish being looked up.
      }
    }
  } with {
    briefly "Find a dish on the menu"
    described as {
      |Looks a dish up by the code orders name it by. A look-up by code spans
      |the menu rather than addressing one listing, so the menu repository's
      |index answers it.
    }
  }
  result MenuListingFound is {
    foundMenuItemId: RestaurantMenuItemId? with {
      briefly "Listing"
      described as {
        |The restaurant's listing of the dish, if it has ever been on the menu.
      }
    }
    foundListing: MenuListing? with {
      briefly "Listing details"
      described as {
        |How the dish is listed now, if it has ever been on the menu.
      }
    }
    onMenu: Boolean with {
      briefly "On the menu"
      described as {
        |Whether the dish may be ordered now: listed and not withdrawn.
      }
    }
  } with {
    briefly "A dish's place on the menu"
    described as {
      |What the menu says about one item code: whether it can be ordered, and
      |how it is listed.
    }
  }
  inlet MenuReleasesIn is type RestaurantMenuRelease with {
    briefly "Releases forwarded by FrontOfHouse"
    described as {
      |Corporate releases arrive at FrontOfHouse's menu-management adaptor,
      |which hands them to this context.
    }
  }
  inlet MenuLookupsFromFrontOfHouseIn is query FindMenuListing with {
    briefly "Table orders' look-ups"
    described as {
      |FrontOfHouse asks whether a dish is on the menu before adding it to a
      |table order.
    }
  }
  inlet MenuLookupsFromOnlineOrderingIn is query FindMenuListing with {
    briefly "Online carts' look-ups"
    described as {
      |OnlineOrdering asks whether a dish is on the menu before adding it to
      |a cart.
    }
  }
  outlet MenuRepliesToFrontOfHouseOut is result MenuListingFound
 with {
    briefly "Answers to FrontOfHouse"
    described as {
      |The reply leg of FrontOfHouse's look-ups.
    }
  }
  outlet MenuRepliesToOnlineOrderingOut is result MenuListingFound
 with {
    briefly "Answers to OnlineOrdering"
    described as {
      |The reply leg of OnlineOrdering's look-ups.
    }
  }
  outlet MenuItemCommandsOut is type RestaurantMenuItem.RestaurantMenuItemCommand
 with {
    briefly "Listing changes on their way to the dishes"
    described as {
      |What applying or rolling back a release asks of each listing.
    }
  }
  outlet MenuLookupsOut is query FindMenuListing
 with {
    briefly "Look-ups on their way to the index"
    described as {
      |Every look-up of a dish by code goes to the menu repository.
    }
  }
  inlet MenuListingsIn is result MenuListingFound with {
    briefly "The index's answers"
    described as {
      |The menu repository's answers to this context's look-ups.
    }
  }
  inlet RestaurantMenuItemQueriesIn is query RestaurantMenuItem.GetRestaurantMenuItem with {
    briefly "Look-ups of one dish"
    described as {
      |RestaurantApp's look-ups of one listing.
    }
  }
  outlet RestaurantMenuItemQueriesOut is query RestaurantMenuItem.GetRestaurantMenuItem
 with {
    briefly "Look-ups on their way to the dish"
    described as {
      |Each look-up goes to the listing it names.
    }
  }
  inlet RestaurantMenuItemResultIn is result RestaurantMenuItem.RestaurantMenuItemResult with {
    briefly "Listings' answers"
    described as {
      |What a listing answers about itself.
    }
  }
  outlet RestaurantMenuItemResultOut is result RestaurantMenuItem.RestaurantMenuItemResult
 with {
    briefly "Answers to RestaurantApp"
    described as {
      |The reply leg of RestaurantApp's look-ups.
    }
  }
  handler MenuBoundary is {
    on getRestaurantMenuItem: query RestaurantMenuItem.GetRestaurantMenuItem is {
      forward getRestaurantMenuItem to outlet Menu.RestaurantMenuItemQueriesOut
    }
    on restaurantMenuItemResult: result RestaurantMenuItem.RestaurantMenuItemResult is {
      send restaurantMenuItemResult to outlet Menu.RestaurantMenuItemResultOut
    }
    on applyMenuRelease: command Menu.ApplyMenuRelease is {
      foreach change in field Menu.ApplyMenuRelease.releaseChanges {
        let found: type MenuListingFound = ask query Menu.FindMenuListing of repository Menu.MenuRepository
        when change.releasedAction == Corporate.MenuManagement.MenuReleaseAction.WithdrawFromMenu then
          when found.onMenu then
            send command RestaurantMenuItem.WithdrawListing(menuItemId = found.foundMenuItemId, withdrawnInRelease = applyMenuRelease.releaseId) to outlet Menu.MenuItemCommandsOut
          end
        else
          when found.foundMenuItemId == empty then
            let listedDish = create entity Menu.RestaurantMenuItem(firstListing = record Menu.MenuListing(listedItemCode = change.releasedItemCode, listedItemName = change.releasedItemName, listedItemCategory = change.releasedItemCategory, listedItemPrice = change.releasedItemPrice, listedInRelease = applyMenuRelease.releaseId))
            log listedDish
          else
            send command RestaurantMenuItem.ChangeListing(menuItemId = found.foundMenuItemId, newListing = record Menu.MenuListing(listedItemCode = change.releasedItemCode, listedItemName = change.releasedItemName, listedItemCategory = change.releasedItemCategory, listedItemPrice = change.releasedItemPrice, listedInRelease = applyMenuRelease.releaseId)) to outlet Menu.MenuItemCommandsOut
          end
        end
      }
    }
    on rollbackMenuRelease: command Menu.RollbackMenuRelease is {
      foreach change in field Menu.RollbackMenuRelease.rolledBackChanges {
        let found: type MenuListingFound = ask query Menu.FindMenuListing of repository Menu.MenuRepository
        when change.releasedAction == Corporate.MenuManagement.MenuReleaseAction.AddToMenu then
          send command RestaurantMenuItem.WithdrawListing(menuItemId = found.foundMenuItemId, withdrawnInRelease = rollbackMenuRelease.releaseId) to outlet Menu.MenuItemCommandsOut
        else
          send command RestaurantMenuItem.RestorePriorListing(menuItemId = found.foundMenuItemId) to outlet Menu.MenuItemCommandsOut
        end
      }
    }
    on findMenuListing: query Menu.FindMenuListing is {
      let found: type MenuListingFound = ask query Menu.FindMenuListing of repository Menu.MenuRepository
      reply found
    }
    on other is {
      error "Unexpected message at the Menu boundary"
    }
  } with {
    briefly "Menu boundary"
    described as {
      |Applies and rolls back releases dish by dish, and answers whether a
      |dish may be ordered. A dish is found by its code through the menu
      |repository's index, because its listing's id is the restaurant's own.
    }
  }
  event-sourced entity RestaurantMenuItem as router is {
    type RestaurantMenuItemCommand is one of {
      RestaurantMenuItem.ChangeListing or RestaurantMenuItem.WithdrawListing or RestaurantMenuItem.RestorePriorListing
    } with {
      briefly "RestaurantMenuItem command alternation"
      described as {
        |Everything a release, or its rollback, can ask of a listed dish.
      }
    }
    type RestaurantMenuItemEvent is one of {
      RestaurantMenuItem.MenuItemListed or RestaurantMenuItem.ListingChanged or RestaurantMenuItem.ListingWithdrawn or RestaurantMenuItem.PriorListingRestored
    } with {
      briefly "RestaurantMenuItem event alternation"
      described as {
        |Everything that happens to a dish on this restaurant's menu.
      }
    }
    inlet RestaurantMenuItemCommands is type RestaurantMenuItemCommand with {
      briefly "Listing changes"
      described as {
        |What the Menu boundary asks of this dish.
      }
    }
    outlet RestaurantMenuItemEvents is type RestaurantMenuItemEvent
 with {
      briefly "Listing events"
      described as {
        |What happened to this dish, on its way to the menu repository.
      }
    }
    inlet RestaurantMenuItemQueries is query GetRestaurantMenuItem with {
      briefly "Look-ups of this dish"
      described as {
        |A look-up of this one listing, which the entity answers from what it
        |holds.
      }
    }
    outlet RestaurantMenuItemReplies is result RestaurantMenuItemResult
 with {
      briefly "This dish's answers"
      described as {
        |The listing as this entity holds it now.
      }
    }
    query GetRestaurantMenuItem replies result RestaurantMenuItemResult is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The listing to look up.
        }
      }
    } with {
      briefly "Get restaurant menu item"
      described as {
        |Looks up one dish's listing by its id. A single listing answers for
        |itself, from memory, with no trip to the repository.
      }
    }
    result RestaurantMenuItemResult is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The listing looked up.
        }
      }
      itemListing: MenuListing with {
        briefly "Listing"
        described as {
          |How the dish is listed, or was when it came off the menu.
        }
      }
      itemOnMenu: Boolean with {
        briefly "On the menu"
        described as {
          |Whether the dish may be ordered now.
        }
      }
    } with {
      briefly "Restaurant menu item result"
      described as {
        |One dish's listing and whether it is on the menu.
      }
    }
    command ChangeListing yields event ListingChanged is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish to relist.
        }
      }
      newListing: MenuListing with {
        briefly "New listing"
        described as {
          |How the release lists the dish.
        }
      }
    } with {
      briefly "Change listing"
      described as {
        |Lists the dish as a release says, putting it back on the menu if it
        |had been withdrawn.
      }
    }
    command WithdrawListing yields event ListingWithdrawn is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish to take off the menu.
        }
      }
      withdrawnInRelease: Corporate.MenuManagement.MenuReleaseId with {
        briefly "Release"
        described as {
          |The release that withdraws the dish, or whose rollback does.
        }
      }
    } with {
      briefly "Withdraw listing"
      described as {
        |Takes the dish off the menu, so orders may no longer name it.
      }
    }
    command RestorePriorListing yields event PriorListingRestored is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish whose last change is being undone.
        }
      }
    } with {
      briefly "Restore prior listing"
      described as {
        |Undoes the last release's change to the dish: it is listed again as
        |it was before that release.
      }
    }
    event MenuItemListed is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The new listing.
        }
      }
      firstListing: MenuListing with {
        briefly "Listing"
        described as {
          |How the dish was first listed.
        }
      }
    } with {
      briefly "Menu item listed"
      described as {
        |A dish reached this restaurant's menu for the first time.
      }
    }
    event ListingChanged is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish relisted.
        }
      }
      newListing: MenuListing with {
        briefly "New listing"
        described as {
          |How the dish is listed now.
        }
      }
      replacedListing: MenuListing with {
        briefly "Replaced listing"
        described as {
          |How it was listed before, kept so a rollback can restore it.
        }
      }
    } with {
      briefly "Listing changed"
      described as {
        |A release relisted the dish.
      }
    }
    event ListingWithdrawn is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish taken off the menu.
        }
      }
      withdrawnListing: MenuListing with {
        briefly "Withdrawn listing"
        described as {
          |How it was listed when it came off, kept so a rollback can restore
          |it.
        }
      }
      withdrawnInRelease: Corporate.MenuManagement.MenuReleaseId with {
        briefly "Release"
        described as {
          |The release that withdrew it, or whose rollback did.
        }
      }
    } with {
      briefly "Listing withdrawn"
      described as {
        |The dish came off this restaurant's menu.
      }
    }
    event PriorListingRestored is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish restored.
        }
      }
      restoredListing: MenuListing with {
        briefly "Restored listing"
        described as {
          |How the dish is listed again.
        }
      }
    } with {
      briefly "Prior listing restored"
      described as {
        |A rollback put the dish back as it was listed before.
      }
    }
    record MenuItemData is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |This listing's id.
        }
      }
      currentListing: MenuListing with {
        briefly "Listing"
        described as {
          |How the dish is listed; while it is off the menu, how it was listed
          |when it came off.
        }
      }
      priorListing: MenuListing? with {
        briefly "Prior listing"
        described as {
          |How the dish was listed before the last change, which a rollback
          |restores. Empty for a dish no release has changed since it was
          |first listed.
        }
      }
    } with {
      briefly "Menu item data"
      described as {
        |A dish's listing on this restaurant's menu, and the one before it.
      }
    }
    state OnMenu of record RestaurantMenuItem.MenuItemData is {
      initial handler OnMenuHandler is {
        on getRestaurantMenuItem: query GetRestaurantMenuItem is {
          reply result RestaurantMenuItem.RestaurantMenuItemResult(menuItemId = getRestaurantMenuItem.menuItemId, itemListing = MenuItemData.currentListing, itemOnMenu = true)
        }
        on changeListing: command ChangeListing is {
          yield event ListingChanged(menuItemId = changeListing.menuItemId, newListing = changeListing.newListing, replacedListing = MenuItemData.currentListing)
          send event ListingChanged(menuItemId = changeListing.menuItemId, newListing = changeListing.newListing, replacedListing = MenuItemData.currentListing) to outlet Menu.RestaurantMenuItem.RestaurantMenuItemEvents
        }
        on withdrawListing: command WithdrawListing is {
          yield event ListingWithdrawn(menuItemId = withdrawListing.menuItemId, withdrawnListing = MenuItemData.currentListing, withdrawnInRelease = withdrawListing.withdrawnInRelease)
          send event ListingWithdrawn(menuItemId = withdrawListing.menuItemId, withdrawnListing = MenuItemData.currentListing, withdrawnInRelease = withdrawListing.withdrawnInRelease) to outlet Menu.RestaurantMenuItem.RestaurantMenuItemEvents
        }
        on restorePriorListing: command RestorePriorListing is {
          when MenuItemData.priorListing == empty then
            error "this dish has no earlier listing to restore"
          else
            yield event PriorListingRestored(menuItemId = restorePriorListing.menuItemId, restoredListing = MenuItemData.priorListing)
            send event PriorListingRestored(menuItemId = restorePriorListing.menuItemId, restoredListing = MenuItemData.priorListing) to outlet Menu.RestaurantMenuItem.RestaurantMenuItemEvents
          end
        }
        on listingChanged: event ListingChanged is {
          set field RestaurantMenuItem.OnMenu.currentListing to listingChanged.newListing
          set field RestaurantMenuItem.OnMenu.priorListing to listingChanged.replacedListing
        }
        on listingWithdrawn: event ListingWithdrawn is {
          morph entity Menu.RestaurantMenuItem to state Menu.RestaurantMenuItem.OffMenu with record RestaurantMenuItem.MenuItemData(menuItemId = listingWithdrawn.menuItemId, currentListing = listingWithdrawn.withdrawnListing, priorListing = listingWithdrawn.withdrawnListing)
        }
        on priorListingRestored: event PriorListingRestored is {
          set field RestaurantMenuItem.OnMenu.currentListing to priorListingRestored.restoredListing
          set field RestaurantMenuItem.OnMenu.priorListing to empty
        }
      } with {
        briefly "On-menu handler"
        described as {
          |A listed dish can be relisted, withdrawn, or put back as it was.
        }
      }
    } with {
      briefly "On the menu"
      described as {
        |The dish may be ordered.
      }
    }
    state OffMenu of record RestaurantMenuItem.MenuItemData is {
      initial handler OffMenuHandler is {
        on getRestaurantMenuItem: query GetRestaurantMenuItem is {
          reply result RestaurantMenuItem.RestaurantMenuItemResult(menuItemId = getRestaurantMenuItem.menuItemId, itemListing = MenuItemData.currentListing, itemOnMenu = false)
        }
        on changeListing: command ChangeListing is {
          yield event ListingChanged(menuItemId = changeListing.menuItemId, newListing = changeListing.newListing, replacedListing = MenuItemData.currentListing)
          send event ListingChanged(menuItemId = changeListing.menuItemId, newListing = changeListing.newListing, replacedListing = MenuItemData.currentListing) to outlet Menu.RestaurantMenuItem.RestaurantMenuItemEvents
        }
        on withdrawListing: command WithdrawListing is {
          error "this dish is already off the menu"
        }
        on restorePriorListing: command RestorePriorListing is {
          yield event PriorListingRestored(menuItemId = restorePriorListing.menuItemId, restoredListing = MenuItemData.currentListing)
          send event PriorListingRestored(menuItemId = restorePriorListing.menuItemId, restoredListing = MenuItemData.currentListing) to outlet Menu.RestaurantMenuItem.RestaurantMenuItemEvents
        }
        on listingChanged: event ListingChanged is {
          morph entity Menu.RestaurantMenuItem to state Menu.RestaurantMenuItem.OnMenu with record RestaurantMenuItem.MenuItemData(menuItemId = listingChanged.menuItemId, currentListing = listingChanged.newListing, priorListing = listingChanged.replacedListing)
        }
        on priorListingRestored: event PriorListingRestored is {
          morph entity Menu.RestaurantMenuItem to state Menu.RestaurantMenuItem.OnMenu with record RestaurantMenuItem.MenuItemData(menuItemId = priorListingRestored.menuItemId, currentListing = priorListingRestored.restoredListing, priorListing = empty)
        }
      } with {
        briefly "Off-menu handler"
        described as {
          |A withdrawn dish can be listed again by a later release, or put
          |back by the rollback of the release that withdrew it.
        }
      }
    } with {
      briefly "Off the menu"
      described as {
        |The dish was withdrawn; orders may not name it.
      }
    }
    handler MenuItemCreationHandler is {
      on init(firstListing: type MenuListing) is {
        morph entity Menu.RestaurantMenuItem to state Menu.RestaurantMenuItem.OnMenu with record RestaurantMenuItem.MenuItemData(menuItemId = self.id, currentListing = firstListing, priorListing = empty)
        send event MenuItemListed(menuItemId = self.id, firstListing = firstListing) to outlet Menu.RestaurantMenuItem.RestaurantMenuItemEvents
      }
    } with {
      briefly "Menu item creation"
      described as {
        |A dish first reaches the menu already listed.
      }
    }
  } with {
    briefly "A dish on this restaurant's menu"
    described as {
      |One dish as this restaurant lists it, set by the corporate releases
      |applied here. Orders may name only dishes that are on the menu.
    }
  }
  projector MenuListingProjection as flow is {
    updates repository Menu.MenuRepository
    inlet MenuListingProjectionIn is type RestaurantMenuItem.RestaurantMenuItemEvent with {
      briefly "Listing events"
      described as {
        |Every dish's listing events.
      }
    }
    outlet MenuListingProjectionToRepository is type MenuRepository.MenuRepositoryCommand
 with {
      briefly "Index updates"
      described as {
        |What the index must record.
      }
    }
    handler MenuListingProjectionHandler is {
      on menuItemListed: event Menu.RestaurantMenuItem.MenuItemListed is {
        tell command Menu.MenuRepository.PersistMenuItemListed(menuItemId = menuItemListed.menuItemId, firstListing = menuItemListed.firstListing) to repository Menu.MenuRepository
      }
      on listingChanged: event Menu.RestaurantMenuItem.ListingChanged is {
        tell command Menu.MenuRepository.PersistListingChanged(menuItemId = listingChanged.menuItemId, newListing = listingChanged.newListing) to repository Menu.MenuRepository
      }
      on listingWithdrawn: event Menu.RestaurantMenuItem.ListingWithdrawn is {
        tell command Menu.MenuRepository.PersistListingWithdrawn(menuItemId = listingWithdrawn.menuItemId) to repository Menu.MenuRepository
      }
      on priorListingRestored: event Menu.RestaurantMenuItem.PriorListingRestored is {
        tell command Menu.MenuRepository.PersistPriorListingRestored(menuItemId = priorListingRestored.menuItemId, restoredListing = priorListingRestored.restoredListing) to repository Menu.MenuRepository
      }
      on other is {
        error "Unexpected message for projector MenuListingProjection"
      }
    } with {
      briefly "Menu listing projection handler"
      described as {
        |Keeps the index of dishes by code in step with their listings.
      }
    }
  } with {
    briefly "Menu listing projection"
    described as {
      |Projects every dish's listing into the menu repository, where it can
      |be found by code.
    }
  }
  repository MenuRepository as merge is {
    inlet MenuRepositoryFromProjection is type MenuRepositoryCommand with {
      briefly "Index updates"
      described as {
        |The projection's writes.
      }
    }
    inlet MenuRepositoryQueries is query Menu.FindMenuListing with {
      briefly "Look-ups"
      described as {
        |Look-ups of a dish by code.
      }
    }
    outlet MenuRepositoryReplies is result Menu.MenuListingFound
 with {
      briefly "Answers"
      described as {
        |What the index holds for a code.
      }
    }
    record StoredMenuListing is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The restaurant's listing of the dish.
        }
      }
      storedListing: MenuListing with {
        briefly "Listing"
        described as {
          |How the dish is listed.
        }
      }
      storedItemCode: String(1,50) with {
        briefly "Item code"
        described as {
          |The code the dish is found by.
        }
      }
      storedOnMenu: Boolean with {
        briefly "On the menu"
        described as {
          |Whether the dish may be ordered.
        }
      }
    } with {
      briefly "Stored menu listing"
      described as {
        |One dish's row in the index.
      }
    }
    schema MenuListings is relational
      of listings as record StoredMenuListing
        key on field StoredMenuListing.storedItemCode
        index on field StoredMenuListing.menuItemId
 with {
      briefly "Menu listing schema"
      described as {
        |Every dish ever on this restaurant's menu, keyed by its code.
      }
    }
    command PersistMenuItemListed is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The new listing.
        }
      }
      firstListing: MenuListing with {
        briefly "Listing"
        described as {
          |How it was first listed.
        }
      }
    } with {
      briefly "Persist MenuItemListed"
      described as {
        |Records a dish new to the menu.
      }
    }
    command PersistListingChanged is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish relisted.
        }
      }
      newListing: MenuListing with {
        briefly "Listing"
        described as {
          |How it is listed now.
        }
      }
    } with {
      briefly "Persist ListingChanged"
      described as {
        |Records a relisting.
      }
    }
    command PersistListingWithdrawn is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish withdrawn.
        }
      }
    } with {
      briefly "Persist ListingWithdrawn"
      described as {
        |Records that a dish came off the menu.
      }
    }
    command PersistPriorListingRestored is {
      menuItemId: RestaurantMenuItemId with {
        briefly "Listing"
        described as {
          |The dish restored.
        }
      }
      restoredListing: MenuListing with {
        briefly "Listing"
        described as {
          |How it is listed again.
        }
      }
    } with {
      briefly "Persist PriorListingRestored"
      described as {
        |Records a dish put back as it was.
      }
    }
    type MenuRepositoryCommand is one of {
      Menu.MenuRepository.PersistMenuItemListed or Menu.MenuRepository.PersistListingChanged or Menu.MenuRepository.PersistListingWithdrawn or Menu.MenuRepository.PersistPriorListingRestored
    } with {
      briefly "Menu repository commands"
      described as {
        |The writes the projection makes.
      }
    }
    handler MenuPersistence is {
      on persistMenuItemListed: command PersistMenuItemListed is {
        store record StoredMenuListing(menuItemId = persistMenuItemListed.menuItemId, storedListing = persistMenuItemListed.firstListing, storedItemCode = persistMenuItemListed.firstListing.listedItemCode, storedOnMenu = true) in MenuListings.listings
      }
      on persistListingChanged: command PersistListingChanged is {
        update MenuListings.listings set storedListing = persistListingChanged.newListing, storedOnMenu = true where menuItemId == persistListingChanged.menuItemId
      }
      on persistListingWithdrawn: command PersistListingWithdrawn is {
        update MenuListings.listings set storedOnMenu = false where menuItemId == persistListingWithdrawn.menuItemId
      }
      on persistPriorListingRestored: command PersistPriorListingRestored is {
        update MenuListings.listings set storedListing = persistPriorListingRestored.restoredListing, storedOnMenu = true where menuItemId == persistPriorListingRestored.menuItemId
      }
      on findMenuListing: query Menu.FindMenuListing is {
        let found: type MenuListingFound = prompt("the listing stored under findMenuListing.listingItemCode, or none with onMenu false")
        reply found
      }
    } with {
      briefly "Menu persistence"
      described as {
        |Keeps the index and answers look-ups by code.
      }
    }
  } with {
    briefly "Menu repository"
    described as {
      |The index of this restaurant's dishes by item code: how a release and
      |an order find a dish's listing.
    }
  }
  connector 'RestaurantMenuItemCommand Intake' is from outlet Menu.MenuItemCommandsOut to inlet Menu.RestaurantMenuItem.RestaurantMenuItemCommands with {
    briefly "Listing changes on their way to the dishes"
    described as {
      |Joins the boundary to each dish's command stream.
    }
  }
  connector 'RestaurantMenuItemQuery Intake' is from outlet Menu.RestaurantMenuItemQueriesOut to inlet Menu.RestaurantMenuItem.RestaurantMenuItemQueries with {
    briefly "Look-ups of one dish, on their way to it"
    described as {
      |Carries GetRestaurantMenuItem to the listing it names.
    }
  }
  connector 'RestaurantMenuItemResult Egress' is from outlet Menu.RestaurantMenuItem.RestaurantMenuItemReplies to inlet Menu.RestaurantMenuItemResultIn with {
    briefly "Listings' answers on their way out"
    described as {
      |What a listing answers, on its way to the boundary.
    }
  }
  connector 'MenuListingProjection Feed' is from outlet Menu.RestaurantMenuItem.RestaurantMenuItemEvents to inlet Menu.MenuListingProjection.MenuListingProjectionIn with {
    briefly "Listing events on their way to the projection"
    described as {
      |Every dish's listing events feed the index.
    }
  }
  connector 'MenuListingProjection Storage' is from outlet Menu.MenuListingProjection.MenuListingProjectionToRepository to inlet Menu.MenuRepository.MenuRepositoryFromProjection with {
    briefly "Index writes on their way to the repository"
    described as {
      |The projection's writes.
    }
  }
  connector 'MenuLookup Intake' is from outlet Menu.MenuLookupsOut to inlet Menu.MenuRepository.MenuRepositoryQueries with {
    briefly "Look-ups on their way to the index"
    described as {
      |The boundary's look-ups by code.
    }
  }
  connector 'MenuListingFound Egress' is from outlet Menu.MenuRepository.MenuRepositoryReplies to inlet Menu.MenuListingsIn with {
    briefly "The index's answers on their way back"
    described as {
      |The reply leg of the boundary's look-ups.
    }
  }
} with {
  briefly "The restaurant's menu"
  described as {
    |What this restaurant serves, as the corporate releases applied here have
    |set it. Every dish an order names must be on it.
  }
}
