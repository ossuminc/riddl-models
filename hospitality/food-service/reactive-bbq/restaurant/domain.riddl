domain Restaurant is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  include "FrontOfHouseContext.riddl"
  include "KitchenContext.riddl"
  include "BarContext.riddl"
  include "OnlineOrderingContext.riddl"
  include "DeliveryContext.riddl"
  include "LoyaltyContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  persistent connector PaymentGatewayToFOH is from outlet PaymentGateway.PaymentGatewayToFOHOut to inlet FrontOfHouse.PaymentGatewayToFOHIn with {
    briefly "Payment gateway connector"
    described as {
      |Wires payment gateway events to the front of house
      |for two-phase payment processing.
    }
  }
  persistent connector NotificationToFOH is from outlet NotificationService.NotificationToFOHOut to inlet FrontOfHouse.NotificationToFOHIn with {
    briefly "Notification connector"
    described as {
      |Wires notification delivery confirmations to the
      |front of house for audit logging.
    }
  }
  persistent connector BarToFOH is from outlet Bar.BarToFOHOut to inlet FrontOfHouse.BarToFOHIn with {
    briefly "Bar to front of house connector"
    described as {
      |Wires drink order events to the front of house
      |for order readiness notification.
    }
  }
  persistent connector DeliveryToOnline is from outlet Delivery.DeliveryToOnlineOut to inlet OnlineOrdering.DeliveryToOnlineIn with {
    briefly "Delivery to online ordering connector"
    described as {
      |Wires delivery order events to the online ordering
      |context for delivery status updates.
    }
  }
  application context RestaurantApp as router is {
    command ShowReservation is {
      reservationInView: FrontOfHouse.ReservationId with {
        briefly "Reservation"
        described as {
          |Which reservation the host is looking at.
        }
      }
    } with {
      briefly "Refresh the reservation view"
      described as {
        |Redraw the reservation panel for the booking just taken. Carries no
        |domain meaning: reading the book does not change it.
      }
    }
    group RestaurantScreen is {
      input MakeReservationInput acquires command FrontOfHouse.Reservation.MakeReservation with {
        briefly "Make reservation control"
        described as {
          |Where a host takes a reservation request from a guest.
        }
      }
      input ConfirmReservationInput acquires command FrontOfHouse.Reservation.ConfirmReservation with {
        briefly "Confirm reservation control"
        described as {
          |Where a host confirms a reservation and assigns a table.
        }
      }
      input SeatPartyInput acquires command FrontOfHouse.Reservation.SeatParty with {
        briefly "Seat party control"
        described as {
          |Where a host seats an arriving party at a table.
        }
      }
      input CreateOrderInput acquires command FrontOfHouse.TableOrder.CreateOrder with {
        briefly "Create order control"
        described as {
          |Where a server opens a table order and adds menu items.
        }
      }
      input SubmitOrderInput acquires command FrontOfHouse.TableOrder.SubmitOrder with {
        briefly "Submit order control"
        described as {
          |Where a server submits a table order to the kitchen and bar.
        }
      }
      input PresentBillInput acquires command FrontOfHouse.TableOrder.PresentBill with {
        briefly "Present bill control"
        described as {
          |Where a server requests the bill with the calculated total.
        }
      }
      input ProcessPaymentInput acquires command FrontOfHouse.TableOrder.ProcessPayment with {
        briefly "Process payment control"
        described as {
          |Where a server takes payment for a table order.
        }
      }
      input CloseOrderInput acquires command FrontOfHouse.TableOrder.CloseOrder with {
        briefly "Close order control"
        described as {
          |Where a server closes out a completed table order.
        }
      }
      input PickUpOrderInput acquires command FrontOfHouse.TableOrder.MarkOrderReadyToServe with {
        briefly "Order pickup control"
        described as {
          |Where a server collects finished food and marks it ready to serve.
        }
      }
      input AssignStationInput acquires command Kitchen.KitchenTicket.AssignStation with {
        briefly "Assign station control"
        described as {
          |Where a chef assigns ticket items to a cooking station.
        }
      }
      input StartPreparationInput acquires command Kitchen.KitchenTicket.StartPreparation with {
        briefly "Start preparation control"
        described as {
          |Where a cook begins preparation at an assigned station.
        }
      }
      input MarkItemReadyInput acquires command Kitchen.KitchenTicket.MarkItemReady with {
        briefly "Mark item ready control"
        described as {
          |Where a cook marks an individual ticket item complete.
        }
      }
      input ApproveTicketInput acquires command Kitchen.KitchenTicket.ApproveTicket with {
        briefly "Approve ticket control"
        described as {
          |Where a chef approves a completed ticket for service.
        }
      }
      input EnrollCustomerInput acquires command Loyalty.LoyaltyAccount.EnrollCustomer with {
        briefly "Loyalty enrollment control"
        described as {
          |Where a customer supplies name and email to join loyalty.
        }
      }
      input RedeemPointsInput acquires command Loyalty.LoyaltyAccount.RedeemPoints with {
        briefly "Redeem points control"
        described as {
          |Where a customer requests a point redemption.
        }
      }
      input BrowseMenuInput acquires command OnlineOrdering.OnlineOrder.BrowseMenu with {
        briefly "Menu browsing control"
        described as {
          |Where a customer browses the online menu.
        }
      }
      input AddToCartInput acquires command OnlineOrdering.OnlineOrder.AddToCart with {
        briefly "Add to cart control"
        described as {
          |Where a customer adds items with quantities and instructions.
        }
      }
      input SelectFulfillmentInput acquires command OnlineOrdering.OnlineOrder.SelectFulfillment with {
        briefly "Fulfillment selection control"
        described as {
          |Where a customer chooses pickup or delivery.
        }
      }
      input SubmitOnlineOrderInput acquires command OnlineOrdering.OnlineOrder.SubmitOnlineOrder with {
        briefly "Submit online order control"
        described as {
          |Where a customer submits a completed online order.
        }
      }
      input ProcessOnlinePaymentInput acquires command OnlineOrdering.OnlineOrder.ProcessOnlinePayment with {
        briefly "Online payment control"
        described as {
          |Where a customer pays for an online order.
        }
      }
      input DispatchDriverInput acquires command Delivery.DeliveryOrder.DispatchDriver with {
        briefly "Dispatch control"
        described as {
          |Where a driver confirms pickup and is dispatched.
        }
      }
      input RecordDeliveryLocationInput acquires command Delivery.DeliveryOrder.RecordDeliveryLocation with {
        briefly "Location update control"
        described as {
          |Where a driver records GPS position during transit.
        }
      }
      input ConfirmDeliveryInput acquires command Delivery.DeliveryOrder.ConfirmDelivery with {
        briefly "Confirm delivery control"
        described as {
          |Where a driver confirms delivery at the customer location.
        }
      }
      output ReservationCreatedView presents result FrontOfHouse.Reservation.ReservationResult with {
        briefly "Created reservation view"
        described as {
          |Shows the host the reservation created from a request.
        }
      }
      output ReservationBoardDisplay presents result FrontOfHouse.Reservation.ReservationResult with {
        briefly "Reservation board"
        described as {
          |Shows the host table availability across the floor.
        }
      }
      output ServerNotification presents result Kitchen.KitchenTicket.KitchenTicketResult with {
        briefly "Server notification"
        described as {
          |Notifies the assigned server that food is ready.
        }
      }
      output LoyaltyAccountView presents result Loyalty.LoyaltyAccount.LoyaltyAccountResult with {
        briefly "Loyalty account view"
        described as {
          |Shows the customer their newly created loyalty account.
        }
      }
      output PointsBalanceView presents result Loyalty.LoyaltyAccount.LoyaltyAccountResult with {
        briefly "Points balance view"
        described as {
          |Shows the customer their accrued point balance.
        }
      }
      output PointsRedemptionView presents result Loyalty.LoyaltyAccount.LoyaltyAccountResult with {
        briefly "Points redemption view"
        described as {
          |Shows the customer the outcome of a redemption request.
        }
      }
      output DeliveryAddressValidationView presents result OnlineOrdering.OnlineOrder.OnlineOrderResult with {
        briefly "Address validation view"
        described as {
          |Shows the customer whether their delivery address is serviceable.
        }
      }
      output DriverAssignmentView presents result Delivery.DeliveryOrder.DeliveryOrderResult with {
        briefly "Driver assignment view"
        described as {
          |Shows the driver the delivery assigned to them.
        }
      }
    } with {
      briefly "Restaurant screen"
      described as {
        |The screens through which restaurant staff and customers act.
      }
    }
    outlet AppDrinkOrderCommands is type Bar.DrinkOrder.DrinkOrderCommand
    outlet AppDeliveryOrderCommands is type Delivery.DeliveryOrder.DeliveryOrderCommand
    outlet AppReservationCommands is type FrontOfHouse.Reservation.ReservationCommand
    outlet AppTableOrderCommands is type FrontOfHouse.TableOrder.TableOrderCommand
    outlet AppKitchenTicketCommands is type Kitchen.KitchenTicket.KitchenTicketCommand
    outlet AppLoyaltyAccountCommands is type Loyalty.LoyaltyAccount.LoyaltyAccountCommand
    outlet AppOnlineOrderCommands is type OnlineOrdering.OnlineOrder.OnlineOrderCommand
    inlet AppTableOrderRepositoryResponses is result FrontOfHouse.TableOrder.TableOrderResult    inlet AppDrinkOrderRepositoryResponses is result Bar.DrinkOrder.DrinkOrderResult    inlet AppDeliveryRepositoryResponses is result Delivery.DeliveryOrder.DeliveryOrderResult    inlet AppReservationRepositoryResponses is result FrontOfHouse.ReservationBoardView    inlet AppKitchenTicketRepositoryResponses is result Kitchen.KitchenTicket.KitchenTicketResult    inlet AppLoyaltyAccountRepositoryResponses is result Loyalty.LoyaltyAccount.LoyaltyAccountResult    inlet AppOnlineOrderRepositoryResponses is result OnlineOrdering.OnlineOrder.OnlineOrderResult    handler RestaurantAppHandler is {
      on command ShowReservation is {
        put result FrontOfHouse.Reservation.ReservationResult(reservation = "the reservation the host just took, as the book now holds it", reservationId = prompt("the reservation id of this reservation result")) to output ReservationCreatedView
      }
      on other is {
        error "Unexpected message for application context RestaurantApp"
      }
    } with {
      briefly "RestaurantApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RestaurantApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'DrinkOrderCommand Stream' is from outlet RestaurantApp.AppDrinkOrderCommands to inlet Bar.DrinkOrderCommandStreamIn with {
    briefly "DrinkOrder commands from the application"
    described as {
      |Carries what leaves AppDrinkOrderCommands to DrinkOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'DeliveryOrderCommand Stream' is from outlet RestaurantApp.AppDeliveryOrderCommands to inlet Delivery.DeliveryOrderCommandStreamIn with {
    briefly "DeliveryOrder commands from the application"
    described as {
      |Carries what leaves AppDeliveryOrderCommands to DeliveryOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'ReservationCommand Stream' is from outlet RestaurantApp.AppReservationCommands to inlet FrontOfHouse.ReservationCommandStreamIn with {
    briefly "Reservation commands from the application"
    described as {
      |Carries what leaves AppReservationCommands to ReservationCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'TableOrderCommand Stream' is from outlet RestaurantApp.AppTableOrderCommands to inlet FrontOfHouse.TableOrderCommandStreamIn with {
    briefly "TableOrder commands from the application"
    described as {
      |Carries what leaves AppTableOrderCommands to TableOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'KitchenTicketCommand Stream' is from outlet RestaurantApp.AppKitchenTicketCommands to inlet Kitchen.KitchenTicketCommandStreamIn with {
    briefly "KitchenTicket commands from the application"
    described as {
      |Carries what leaves AppKitchenTicketCommands to KitchenTicketCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'LoyaltyAccountCommand Stream' is from outlet RestaurantApp.AppLoyaltyAccountCommands to inlet Loyalty.LoyaltyAccountCommandStreamIn with {
    briefly "LoyaltyAccount commands from the application"
    described as {
      |Carries what leaves AppLoyaltyAccountCommands to LoyaltyAccountCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'OnlineOrderCommand Stream' is from outlet RestaurantApp.AppOnlineOrderCommands to inlet OnlineOrdering.OnlineOrderCommandStreamIn with {
    briefly "OnlineOrder commands from the application"
    described as {
      |Carries what leaves AppOnlineOrderCommands to OnlineOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'DrinkOrderResult Stream' is from outlet Bar.DrinkOrderResultStreamOut to inlet RestaurantApp.AppDrinkOrderRepositoryResponses with {
    briefly "DrinkOrder query results returned to the application"
    described as {
      |Carries what leaves DrinkOrderResultStreamOut to AppDrinkOrderRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'DeliveryOrderResult Stream' is from outlet Delivery.DeliveryOrderResultStreamOut to inlet RestaurantApp.AppDeliveryRepositoryResponses with {
    briefly "Delivery query results returned to the application"
    described as {
      |Carries what leaves DeliveryOrderResultStreamOut to AppDeliveryRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'ReservationBoardView Stream' is from outlet FrontOfHouse.ReservationBoardViewStreamOut to inlet RestaurantApp.AppReservationRepositoryResponses with {
    briefly "Reservation query results returned to the application"
    described as {
      |Carries what leaves ReservationBoardViewStreamOut to AppReservationRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'KitchenTicketResult Stream' is from outlet Kitchen.KitchenTicketResultStreamOut to inlet RestaurantApp.AppKitchenTicketRepositoryResponses with {
    briefly "KitchenTicket query results returned to the application"
    described as {
      |Carries what leaves KitchenTicketResultStreamOut to AppKitchenTicketRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'LoyaltyAccountResult Stream' is from outlet Loyalty.LoyaltyAccountResultStreamOut to inlet RestaurantApp.AppLoyaltyAccountRepositoryResponses with {
    briefly "LoyaltyAccount query results returned to the application"
    described as {
      |Carries what leaves LoyaltyAccountResultStreamOut to AppLoyaltyAccountRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'OnlineOrderResult Stream' is from outlet OnlineOrdering.OnlineOrderResultStreamOut to inlet RestaurantApp.AppOnlineOrderRepositoryResponses with {
    briefly "OnlineOrder query results returned to the application"
    described as {
      |Carries what leaves OnlineOrderResultStreamOut to AppOnlineOrderRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'TableOrderResult Stream' is from outlet FrontOfHouse.TableOrderResultStreamOut to inlet RestaurantApp.AppTableOrderRepositoryResponses with {
    briefly "TableOrder query results returned to the application"
    described as {
      |Carries stored table-order rows back to the restaurant application in
      |answer to its queries, matching every other repository in this domain.
    }
  }
} with {
  briefly "Restaurant operations domain"
  described as {
    | Covers all in-restaurant and customer-facing operations
    | including front-of-house, kitchen, bar, online ordering,
    | delivery, and loyalty program.
  }
}
