domain Restaurant is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  include "FrontOfHouseContext.riddl"
  include "KitchenContext.riddl"
  include "BarContext.riddl"
  include "OnlineOrderingContext.riddl"
  include "DeliveryContext.riddl"
  include "LoyaltyContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  connector PaymentGatewayToFOH is {
    from outlet PaymentGateway.PaymentEventSource.PaymentResults
      to inlet FrontOfHouse.PaymentResultSink.IncomingPaymentResults
  } with {
    option is persistent
    briefly "Payment gateway connector"
    described as {
      |Wires payment gateway events to the front of house
      |for two-phase payment processing.
    }
  }
  connector NotificationToFOH is {
    from outlet
      NotificationService.NotificationEventSource.NotificationResults
      to inlet FrontOfHouse.NotificationAckSink.NotificationAcks
  } with {
    option is persistent
    briefly "Notification connector"
    described as {
      |Wires notification delivery confirmations to the
      |front of house for audit logging.
    }
  }
  connector OrderToKitchen is {
    from outlet FrontOfHouse.OrderSplitter.FoodOrders to
      inlet Kitchen.TicketQueue.IncomingTickets
  } with {
    option is persistent
    briefly "Order to kitchen connector"
    described as {
      |Wires food items from the order splitter to the kitchen
      |ticket queue for ordered processing.
    }
  }
  connector OrderToBar is {
    from outlet FrontOfHouse.OrderSplitter.DrinkOrders to
      inlet Bar.DrinkOrderQueue.IncomingDrinks
  } with {
    option is persistent
    briefly "Order to bar connector"
    described as {
      |Wires drink items from the order splitter to the bar
      |drink order queue for ordered processing.
    }
  }
  connector BarToFOH is {
    from outlet Bar.DrinkOrderEventSource.DrinkOrderEvents to
      inlet
      FrontOfHouse.DrinkOrderEventSink.IncomingDrinkOrderEvents
  } with {
    option is persistent
    briefly "Bar to front of house connector"
    described as {
      |Wires drink order events to the front of house
      |for order readiness notification.
    }
  }
  connector DeliveryToOnline is {
    from outlet
      Delivery.DeliveryOrderEventSource.DeliveryOrderEvents to
      inlet
      OnlineOrdering.DeliveryEventSink.IncomingDeliveryEvents
  } with {
    option is persistent
    briefly "Delivery to online ordering connector"
    described as {
      |Wires delivery order events to the online ordering
      |context for delivery status updates.
    }
  }
  connector OnlineToKitchen is {
    from outlet OnlineOrdering.OnlineOrderPipeline.KitchenOrders to
      inlet Kitchen.TicketQueue.IncomingTickets
  } with {
    option is persistent
    briefly "Online to kitchen connector"
    described as {
      |Wires online orders from the order pipeline to the
      |kitchen ticket queue, merging with dine-in orders for
      |unified kitchen processing.
    }
  }
} with {
  briefly "Restaurant operations domain"
  described as {
    | Covers all in-restaurant and customer-facing operations
    | including front-of-house, kitchen, bar, online ordering,
    | delivery, and loyalty program.
  }
}
