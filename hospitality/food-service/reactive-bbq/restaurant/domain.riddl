domain Restaurant is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  include "FrontOfHouseContext.riddl"
  include "KitchenContext.riddl"
  include "BarContext.riddl"
  include "OnlineOrderingContext.riddl"
  include "DeliveryContext.riddl"
  include "LoyaltyContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  connector PaymentGatewayToFOH is {
    from outlet PaymentGateway.PaymentEventSource.PaymentResults
      to inlet FrontOfHouse.PaymentResultSink.IncomingPaymentResults
  } with {
    option is persistent
    briefly "Payment gateway connector"
    described as {
      |Wires payment gateway events to the front of house
      |for two-phase payment processing.
    }
  }
  connector NotificationToFOH is {
    from outlet
      NotificationService.NotificationEventSource.NotificationResults
      to inlet FrontOfHouse.NotificationAckSink.NotificationAcks
  } with {
    option is persistent
    briefly "Notification connector"
    described as {
      |Wires notification delivery confirmations to the
      |front of house for audit logging.
    }
  }
  connector OrderToKitchen is {
    from outlet FrontOfHouse.OrderSplitter.FoodOrders to
      inlet Kitchen.TicketQueue.IncomingDineInTickets
  } with {
    option is persistent
    briefly "Order to kitchen connector"
    described as {
      |Wires food items from the order splitter to the kitchen
      |ticket queue for ordered processing.
    }
  }
  connector OrderToBar is {
    from outlet FrontOfHouse.OrderSplitter.DrinkOrders to
      inlet Bar.DrinkOrderQueue.IncomingDrinks
  } with {
    option is persistent
    briefly "Order to bar connector"
    described as {
      |Wires drink items from the order splitter to the bar
      |drink order queue for ordered processing.
    }
  }
  connector BarToFOH is {
    from outlet Bar.DrinkOrderEventSource.DrinkOrderEvents to
      inlet
      FrontOfHouse.DrinkOrderEventSink.IncomingDrinkOrderEvents
  } with {
    option is persistent
    briefly "Bar to front of house connector"
    described as {
      |Wires drink order events to the front of house
      |for order readiness notification.
    }
  }
  connector DeliveryToOnline is {
    from outlet
      Delivery.DeliveryOrderEventSource.DeliveryOrderEvents to
      inlet
      OnlineOrdering.DeliveryEventSink.IncomingDeliveryEvents
  } with {
    option is persistent
    briefly "Delivery to online ordering connector"
    described as {
      |Wires delivery order events to the online ordering
      |context for delivery status updates.
    }
  }
  connector OnlineToKitchen is {
    from outlet OnlineOrdering.OnlineOrderPipeline.KitchenOrders to
      inlet Kitchen.TicketQueue.IncomingOnlineTickets
  } with {
    option is persistent
    briefly "Online to kitchen connector"
    described as {
      |Wires online orders from the order pipeline to the
      |kitchen ticket queue, merging with dine-in orders for
      |unified kitchen processing.
    }
  }
  application context RestaurantApp is {
    outlet AppDrinkOrderCommands is type Bar.DrinkOrder.DrinkOrderCommand
    outlet AppDeliveryOrderCommands is type Delivery.DeliveryOrder.DeliveryOrderCommand
    outlet AppReservationCommands is type FrontOfHouse.Reservation.ReservationCommand
    outlet AppTableOrderCommands is type FrontOfHouse.TableOrder.TableOrderCommand
    outlet AppKitchenTicketCommands is type Kitchen.KitchenTicket.KitchenTicketCommand
    outlet AppLoyaltyAccountCommands is type Loyalty.LoyaltyAccount.LoyaltyAccountCommand
    outlet AppOnlineOrderCommands is type OnlineOrdering.OnlineOrder.OnlineOrderCommand
    inlet AppDrinkOrderRepositoryResponses is type Bar.DrinkOrder.DrinkOrderResult
    inlet AppDeliveryRepositoryResponses is type Delivery.DeliveryOrder.DeliveryOrderResult
    inlet AppReservationRepositoryResponses is type FrontOfHouse.ReservationBoardView
    inlet AppKitchenTicketRepositoryResponses is type Kitchen.KitchenTicket.KitchenTicketResult
    inlet AppLoyaltyAccountRepositoryResponses is type Loyalty.LoyaltyAccount.LoyaltyAccountResult
    inlet AppOnlineOrderRepositoryResponses is type OnlineOrdering.OnlineOrder.OnlineOrderResult
    handler RestaurantAppHandler is {
      on other is {
        error "Unexpected message for application context RestaurantApp"
      }
    } with {
      briefly "RestaurantApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RestaurantApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppDrinkOrderCommands is {
    from outlet RestaurantApp.AppDrinkOrderCommands to
      inlet Bar.DrinkOrder.DrinkOrderCommands
  } with {
    option is persistent
    briefly "LinkAppDrinkOrderCommands"
  }
  connector LinkAppDeliveryOrderCommands is {
    from outlet RestaurantApp.AppDeliveryOrderCommands to
      inlet Delivery.DeliveryOrder.DeliveryOrderCommands
  } with {
    option is persistent
    briefly "LinkAppDeliveryOrderCommands"
  }
  connector LinkAppReservationCommands is {
    from outlet RestaurantApp.AppReservationCommands to
      inlet FrontOfHouse.Reservation.ReservationCommands
  } with {
    option is persistent
    briefly "LinkAppReservationCommands"
  }
  connector LinkAppTableOrderCommands is {
    from outlet RestaurantApp.AppTableOrderCommands to
      inlet FrontOfHouse.TableOrder.TableOrderCommands
  } with {
    option is persistent
    briefly "LinkAppTableOrderCommands"
  }
  connector LinkAppKitchenTicketCommands is {
    from outlet RestaurantApp.AppKitchenTicketCommands to
      inlet Kitchen.KitchenTicket.KitchenTicketCommands
  } with {
    option is persistent
    briefly "LinkAppKitchenTicketCommands"
  }
  connector LinkAppLoyaltyAccountCommands is {
    from outlet RestaurantApp.AppLoyaltyAccountCommands to
      inlet Loyalty.LoyaltyAccount.LoyaltyAccountCommands
  } with {
    option is persistent
    briefly "LinkAppLoyaltyAccountCommands"
  }
  connector LinkAppOnlineOrderCommands is {
    from outlet RestaurantApp.AppOnlineOrderCommands to
      inlet OnlineOrdering.OnlineOrder.OnlineOrderCommands
  } with {
    option is persistent
    briefly "LinkAppOnlineOrderCommands"
  }
  connector LinkAppDrinkOrderRepositoryResponses is {
    from outlet Bar.DrinkOrderRepository.DrinkOrderRepositoryResponses to
      inlet RestaurantApp.AppDrinkOrderRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppDrinkOrderRepositoryResponses"
  }
  connector LinkAppDeliveryRepositoryResponses is {
    from outlet Delivery.DeliveryRepository.DeliveryRepositoryResponses to
      inlet RestaurantApp.AppDeliveryRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppDeliveryRepositoryResponses"
  }
  connector LinkAppReservationRepositoryResponses is {
    from outlet FrontOfHouse.ReservationRepository.ReservationRepositoryResponses to
      inlet RestaurantApp.AppReservationRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppReservationRepositoryResponses"
  }
  connector LinkAppKitchenTicketRepositoryResponses is {
    from outlet Kitchen.KitchenTicketRepository.KitchenTicketRepositoryResponses to
      inlet RestaurantApp.AppKitchenTicketRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppKitchenTicketRepositoryResponses"
  }
  connector LinkAppLoyaltyAccountRepositoryResponses is {
    from outlet Loyalty.LoyaltyAccountRepository.LoyaltyAccountRepositoryResponses to
      inlet RestaurantApp.AppLoyaltyAccountRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppLoyaltyAccountRepositoryResponses"
  }
  connector LinkAppOnlineOrderRepositoryResponses is {
    from outlet OnlineOrdering.OnlineOrderRepository.OnlineOrderRepositoryResponses to
      inlet RestaurantApp.AppOnlineOrderRepositoryResponses
  } with {
    option is persistent
    briefly "LinkAppOnlineOrderRepositoryResponses"
  }
} with {
  briefly "Restaurant operations domain"
  described as {
    | Covers all in-restaurant and customer-facing operations
    | including front-of-house, kitchen, bar, online ordering,
    | delivery, and loyalty program.
  }
}
