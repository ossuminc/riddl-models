domain Restaurant is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  include "FrontOfHouseContext.riddl"
  include "MenuContext.riddl"
  include "KitchenContext.riddl"
  include "BarContext.riddl"
  include "OnlineOrderingContext.riddl"
  include "DeliveryContext.riddl"
  include "LoyaltyContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  persistent connector 'PaymentGatewayRequest Stream' is from outlet FrontOfHouse.ToPaymentGateway.ToPaymentGatewayOut to inlet PaymentGateway.PaymentGatewayRequests with {
    briefly "What FrontOfHouse asks PaymentGateway to send"
    described as {
      |Authorization and capture requests on their way to the payment gateway.
      |Persistent because the pipe crosses a context boundary.
    }
  }
  persistent connector PaymentGatewayToFOH is from outlet PaymentGateway.PaymentGatewayToFOHOut to inlet FrontOfHouse.PaymentGatewayAdapter.IncomingPaymentGatewayEvents with {
    briefly "Payment gateway connector"
    described as {
      |Wires payment gateway events to the front of house
      |for two-phase payment processing.
    }
  }
  persistent connector NotificationToFOH is from outlet NotificationService.NotificationToFOHOut to inlet FrontOfHouse.NotificationServiceAdapter.IncomingNotificationServiceEvents with {
    briefly "Notification connector"
    described as {
      |Wires notification delivery confirmations to the
      |front of house for audit logging.
    }
  }
  persistent connector BarToFOH is from outlet Bar.BarToFOHOut to inlet FrontOfHouse.BarToFOHIn with {
    briefly "Bar to front of house connector"
    described as {
      |Wires drink order events to the front of house
      |for order readiness notification.
    }
  }
  persistent connector 'OrderSubmitted Stream To Bar' is from outlet FrontOfHouse.FOHOrderSubmittedToBar to inlet Bar.FromFrontOfHouse.FromFrontOfHouseIn with {
    briefly "Drink orders from front of house to the bar"
    described as {
      |Gives the ToBar adaptor's `tell receiveDrinkOrder to context Bar` a
      |channel. Durable because it crosses a context boundary.
    }
  }
  persistent connector DeliveryToOnline is from outlet Delivery.DeliveryToOnlineOut to inlet OnlineOrdering.DeliveryToOnlineIn with {
    briefly "Delivery to online ordering connector"
    described as {
      |Wires delivery order events to the online ordering
      |context for delivery status updates.
    }
  }
  persistent connector 'SendPushNotification Stream' is from outlet Delivery.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationRequestsIn with {
    briefly "Push notification requests from delivery to the notification service"
    described as {
      |Gives the ToNotificationService adaptor's `tell` a channel. Durable
      |because it crosses a context boundary.
    }
  }
  persistent connector 'PaymentProcessed Stream To Loyalty' is from outlet FrontOfHouse.FOHPaymentProcessedToLoyalty to inlet Loyalty.FromPayment.FromPaymentIn with {
    briefly "Dine-in point accruals from front of house to loyalty"
    described as {
      |Gives the ToLoyalty adaptor's `tell accruePoints to context Loyalty`
      |a channel. Durable because it crosses a context boundary.
    }
  }
  persistent connector 'OnlinePaymentProcessed Stream To Loyalty' is from outlet OnlineOrdering.OnlinePaymentProcessedToLoyalty to inlet Loyalty.FromOnlinePayment.FromOnlinePaymentIn with {
    briefly "Online point accruals from online ordering to loyalty"
    described as {
      |The second leg into loyalty's intake merge, carrying what a paid
      |online order earned.
    }
  }
  persistent connector 'OrderSubmitted Stream To Kitchen' is from outlet FrontOfHouse.FOHOrderSubmittedToKitchen to inlet Kitchen.FromFrontOfHouse.FromFrontOfHouseIn with {
    briefly "Dine-in tickets from front of house to the kitchen"
    described as {
      |Gives the ToKitchen adaptor's `tell receiveTicket to context Kitchen`
      |a channel. Durable because it crosses a context boundary.
    }
  }
  persistent connector 'PreparationStarted Stream To FrontOfHouse' is from outlet Kitchen.KitchenToFrontOfHouseOut to inlet FrontOfHouse.FromKitchen.FromKitchenIn with {
    briefly "What Kitchen tells FrontOfHouse about the orders it is cooking"
    described as {
      |The return leg of 'OrderSubmitted Stream To Kitchen': the ticket that
      |order became has started cooking, which is what puts the order in
      |preparation.
    }
  }
  persistent connector 'OnlineOrderSubmitted Stream To Kitchen' is from outlet OnlineOrdering.OnlineOrderSubmittedToKitchen to inlet Kitchen.FromOnlineOrdering.FromOnlineOrderingIn with {
    briefly "Online tickets from online ordering to the kitchen"
    described as {
      |The second leg into the kitchen's intake merge, carrying the food
      |lines of a submitted online order.
    }
  }
  persistent connector 'KitchenOnlineProgress Stream To OnlineOrdering' is from outlet Kitchen.KitchenToOnlineOrderingOut to inlet OnlineOrdering.FromKitchen.FromKitchenIn with {
    briefly "Online orders' kitchen progress to online ordering"
    described as {
      |Carries preparation started and ticket approved for online tickets.
    }
  }
  persistent connector 'MenuRelease Stream To Menu' is from outlet FrontOfHouse.FOHMenuReleasesOut to inlet Menu.MenuReleasesIn with {
    briefly "Corporate releases from FrontOfHouse to the menu"
    described as {
      |Publication and rollback of a release, as FrontOfHouse forwards them.
    }
  }
  persistent connector 'MenuLookup Stream From FrontOfHouse' is from outlet FrontOfHouse.FOHMenuLookupsOut to inlet Menu.MenuLookupsFromFrontOfHouseIn with {
    briefly "Table orders' menu look-ups"
    described as {
      |Whether a dish may be added to a table order.
    }
  }
  persistent connector 'MenuListingFound Stream To FrontOfHouse' is from outlet Menu.MenuRepliesToFrontOfHouseOut to inlet FrontOfHouse.FOHMenuRepliesIn with {
    briefly "The menu's answers to FrontOfHouse"
    described as {
      |The reply leg of table orders' look-ups.
    }
  }
  persistent connector 'MenuLookup Stream From OnlineOrdering' is from outlet OnlineOrdering.OnlineMenuLookupsOut to inlet Menu.MenuLookupsFromOnlineOrderingIn with {
    briefly "Online carts' menu look-ups"
    described as {
      |Whether a dish may be added to an online cart.
    }
  }
  persistent connector 'MenuListingFound Stream To OnlineOrdering' is from outlet Menu.MenuRepliesToOnlineOrderingOut to inlet OnlineOrdering.OnlineMenuRepliesIn with {
    briefly "The menu's answers to OnlineOrdering"
    described as {
      |The reply leg of online carts' look-ups.
    }
  }
  gateway context CustomerGateway as merge is {
    inlet StorefrontOrdersIn is type OnlineOrdering.OnlineOrderRequest with {
      briefly "Orders from the restaurant's own storefront"
      described as {
        |What a customer sends from the restaurant's own web and mobile
        |ordering screens.
      }
    }
    inlet PartnerOrdersIn is type OnlineOrdering.OnlineOrderRequest with {
      briefly "Orders relayed by a delivery marketplace partner"
      described as {
        |The same order commands, arriving from a third-party marketplace
        |rather than the restaurant's own storefront. A separate inlet
        |because an inlet accepts exactly one connector, and because the two
        |channels are separately trusted and separately rate-limited.
      }
    }
    outlet AdmittedOrdersOut is type OnlineOrdering.OnlineOrderRequest
 with {
      briefly "One admitted order stream"
      described as {
        |Both channels funnelled into one. A gateway merges: past this point
        |nothing downstream needs to know which channel an order came from.
      }
    }
    handler CustomerGatewayBoundary is {
      on browseMenu: command OnlineOrdering.BrowseMenu is {
        forward browseMenu to outlet CustomerGateway.AdmittedOrdersOut
      }
      on addToCart: command OnlineOrdering.OnlineOrder.AddToCart is {
        forward addToCart to outlet CustomerGateway.AdmittedOrdersOut
      }
      on getOnlineOrder: query OnlineOrdering.OnlineOrder.GetOnlineOrder is {
        forward getOnlineOrder to outlet CustomerGateway.AdmittedOrdersOut
      }
      on removeFromCart: command OnlineOrdering.OnlineOrder.RemoveFromCart is {
        forward removeFromCart to outlet CustomerGateway.AdmittedOrdersOut
      }
      on selectFulfillment: command OnlineOrdering.OnlineOrder.SelectFulfillment is {
        forward selectFulfillment to outlet CustomerGateway.AdmittedOrdersOut
      }
      on submitOnlineOrder: command OnlineOrdering.OnlineOrder.SubmitOnlineOrder is {
        forward submitOnlineOrder to outlet CustomerGateway.AdmittedOrdersOut
      }
      on processOnlinePayment: command OnlineOrdering.OnlineOrder.ProcessOnlinePayment is {
        forward processOnlinePayment to outlet CustomerGateway.AdmittedOrdersOut
      }
      on cancelOnlineOrder: command OnlineOrdering.OnlineOrder.CancelOnlineOrder is {
        forward cancelOnlineOrder to outlet CustomerGateway.AdmittedOrdersOut
      }
      on completeOnlineOrder: command OnlineOrdering.OnlineOrder.CompleteOnlineOrder is {
        forward completeOnlineOrder to outlet CustomerGateway.AdmittedOrdersOut
      }
      on other is {
        error "Unexpected message for gateway context CustomerGateway"
      }
    } with {
      briefly "Gateway admission handler"
      described as {
        |Admits what a customer may legitimately ask for. Everything else is
        |refused here: MarkReadyForPickup, MarkOutForDelivery and the rest
        |are staff work and reach the context through RestaurantApp, never
        |from outside the restaurant.
      }
    }
  } with {
    briefly "Public gateway for customer ordering"
    described as {
      |The boundary the restaurant presents to customers who are not on the
      |premises, whether they come through its own storefront or a delivery
      |marketplace. Staff reach the contexts through RestaurantApp instead.
    }
  }
  application context RestaurantApp as router is {
    command ShowReservation is {
      reservationInView: FrontOfHouse.ReservationId with {
        briefly "Reservation"
        described as {
          |Which reservation the host is looking at.
        }
      }
    } with {
      briefly "Refresh the reservation view"
      described as {
        |Redraw the reservation panel for the booking just taken. Carries no
        |domain meaning: reading the book does not change it.
      }
    }
    group RestaurantScreen is {
      input MakeReservationInput acquires command FrontOfHouse.MakeReservation with {
        briefly "Make reservation control"
        described as {
          |Where a host takes a reservation request from a guest.
        }
      }
      input ConfirmReservationInput acquires command FrontOfHouse.Reservation.ConfirmReservation with {
        briefly "Confirm reservation control"
        described as {
          |Where a host confirms a reservation and assigns a table.
        }
      }
      input SeatPartyInput acquires command FrontOfHouse.Reservation.SeatParty with {
        briefly "Seat party control"
        described as {
          |Where a host seats an arriving party at a table.
        }
      }
      input CreateOrderInput acquires command FrontOfHouse.CreateOrder with {
        briefly "Create order control"
        described as {
          |Where a server opens a table order and adds menu items.
        }
      }
      output OrderCreatedView presents event FrontOfHouse.TableOrder.OrderCreated with {
        briefly "The order created answer"
        described as {
          |What CreateOrder brought into being, with the id it was given.
        }
      }
      input SubmitOrderInput acquires command FrontOfHouse.TableOrder.SubmitOrder with {
        briefly "Submit order control"
        described as {
          |Where a server submits a table order to the kitchen and bar.
        }
      }
      input PresentBillInput acquires command FrontOfHouse.TableOrder.PresentBill with {
        briefly "Present bill control"
        described as {
          |Where a server requests the bill with the calculated total.
        }
      }
      input ProcessPaymentInput acquires command FrontOfHouse.TableOrder.ProcessPayment with {
        briefly "Process payment control"
        described as {
          |Where a server takes payment for a table order.
        }
      }
      input CloseOrderInput acquires command FrontOfHouse.TableOrder.CloseOrder with {
        briefly "Close order control"
        described as {
          |Where a server closes out a completed table order.
        }
      }
      input PickUpOrderInput acquires command FrontOfHouse.TableOrder.MarkOrderReadyToServe with {
        briefly "Order pickup control"
        described as {
          |Where a server collects finished food and marks it ready to serve.
        }
      }
      input AssignStationInput acquires command Kitchen.KitchenTicket.AssignStation with {
        briefly "Assign station control"
        described as {
          |Where a chef assigns ticket items to a cooking station.
        }
      }
      input StartPreparationInput acquires command Kitchen.KitchenTicket.StartPreparation with {
        briefly "Start preparation control"
        described as {
          |Where a cook begins preparation at an assigned station.
        }
      }
      input MarkItemReadyInput acquires command Kitchen.KitchenTicket.MarkItemReady with {
        briefly "Mark item ready control"
        described as {
          |Where a cook marks an individual ticket item complete.
        }
      }
      input ApproveTicketInput acquires command Kitchen.KitchenTicket.ApproveTicket with {
        briefly "Approve ticket control"
        described as {
          |Where a chef approves a completed ticket for service.
        }
      }
      input EnrollCustomerInput acquires command Loyalty.EnrollCustomer with {
        briefly "Loyalty enrollment control"
        described as {
          |Where a customer supplies name and email to join loyalty.
        }
      }
      output CustomerEnrolledView presents event Loyalty.LoyaltyAccount.CustomerEnrolled with {
        briefly "The customer enrolled answer"
        described as {
          |What EnrollCustomer brought into being, with the id it was given.
        }
      }
      input RedeemPointsInput acquires command Loyalty.LoyaltyAccount.RedeemPoints with {
        briefly "Redeem points control"
        described as {
          |Where a customer requests a point redemption.
        }
      }
      input BrowseMenuInput acquires command OnlineOrdering.BrowseMenu with {
        briefly "Menu browsing control"
        described as {
          |Where a customer browses the online menu.
        }
      }
      output MenuBrowsedView presents event OnlineOrdering.OnlineOrder.MenuBrowsed with {
        briefly "The menu browsed answer"
        described as {
          |What BrowseMenu brought into being, with the id it was given.
        }
      }
      input AddToCartInput acquires command OnlineOrdering.OnlineOrder.AddToCart with {
        briefly "Add to cart control"
        described as {
          |Where a customer adds items with quantities and instructions.
        }
      }
      input SelectFulfillmentInput acquires command OnlineOrdering.OnlineOrder.SelectFulfillment with {
        briefly "Fulfillment selection control"
        described as {
          |Where a customer chooses pickup or delivery.
        }
      }
      input SubmitOnlineOrderInput acquires command OnlineOrdering.OnlineOrder.SubmitOnlineOrder with {
        briefly "Submit online order control"
        described as {
          |Where a customer submits a completed online order.
        }
      }
      input ProcessOnlinePaymentInput acquires command OnlineOrdering.OnlineOrder.ProcessOnlinePayment with {
        briefly "Online payment control"
        described as {
          |Where a customer pays for an online order.
        }
      }
      input DispatchDriverInput acquires command Delivery.DeliveryOrder.DispatchDriver with {
        briefly "Dispatch control"
        described as {
          |Where a driver confirms pickup and is dispatched.
        }
      }
      input RecordDeliveryLocationInput acquires command Delivery.DeliveryOrder.RecordDeliveryLocation with {
        briefly "Location update control"
        described as {
          |Where a driver records GPS position during transit.
        }
      }
      input ConfirmDeliveryInput acquires command Delivery.DeliveryOrder.ConfirmDelivery with {
        briefly "Confirm delivery control"
        described as {
          |Where a driver confirms delivery at the customer location.
        }
      }
      input CancelReservationInput acquires command FrontOfHouse.Reservation.CancelReservation with {
        briefly "Cancel reservation control"
        described as {
          |Where a host cancels a booking at the guest's request.
        }
      }
      input RescheduleReservationInput acquires command FrontOfHouse.Reservation.RescheduleReservation with {
        briefly "Reschedule reservation control"
        described as {
          |Where a host moves a booking to another time at the guest's request.
        }
      }
      input CompleteVisitInput acquires command FrontOfHouse.Reservation.CompleteVisit with {
        briefly "Complete visit control"
        described as {
          |Where a host closes a seated party's visit once the table is cleared.
        }
      }
      input ReservationSelector acquires command RestaurantApp.ShowReservation with {
        briefly "Reservation selector"
        described as {
          |Where a host picks the booking to look at.
        }
      }
      input AddItemInput acquires command FrontOfHouse.TableOrder.AddItem with {
        briefly "Add item control"
        described as {
          |Where a server adds a dish to an order still in draft.
        }
      }
      input RemoveItemInput acquires command FrontOfHouse.TableOrder.RemoveItem with {
        briefly "Remove item control"
        described as {
          |Where a server takes a dish off an order still in draft.
        }
      }
      input MarkDrinkReadyInput acquires command Bar.DrinkOrder.MarkDrinkReady with {
        briefly "Mark drink ready control"
        described as {
          |Where a bartender marks a drink in the order as poured.
        }
      }
      input CompleteDrinkOrderInput acquires command Bar.DrinkOrder.CompleteDrinkOrder with {
        briefly "Complete drink order control"
        described as {
          |Where a bartender closes a drink order once it has gone to the table.
        }
      }
      input RemoveFromCartInput acquires command OnlineOrdering.OnlineOrder.RemoveFromCart with {
        briefly "Remove from cart control"
        described as {
          |Where a customer takes a dish out of their cart.
        }
      }
      input CancelOnlineOrderInput acquires command OnlineOrdering.OnlineOrder.CancelOnlineOrder with {
        briefly "Cancel online order control"
        described as {
          |Where a customer abandons an online order before it is cooked.
        }
      }
      input RecordDeliveryPaymentInput acquires command Delivery.DeliveryOrder.RecordDeliveryPayment with {
        briefly "Record delivery payment control"
        described as {
          |Where a driver records payment taken at the door.
        }
      }
      input ReportDeliveryIssueInput acquires command Delivery.DeliveryOrder.ReportDeliveryIssue with {
        briefly "Report delivery issue control"
        described as {
          |Where a driver reports a problem on the way, such as a wrong address.
        }
      }
      input SuspendAccountInput acquires command Loyalty.LoyaltyAccount.SuspendAccount with {
        briefly "Suspend loyalty account control"
        described as {
          |Where a manager freezes a loyalty account, for example while abuse is looked into.
        }
      }
      input ReactivateAccountInput acquires command Loyalty.LoyaltyAccount.ReactivateAccount with {
        briefly "Reactivate loyalty account control"
        described as {
          |Where a manager lifts a suspension from a loyalty account.
        }
      }
      input CloseLoyaltyAccountInput acquires command Loyalty.LoyaltyAccount.CloseAccount with {
        briefly "Close loyalty account control"
        described as {
          |Where a manager closes a loyalty account at the member's request.
        }
      }
      input UpdateStationRoutingInput acquires command Kitchen.UpdateStationRouting with {
        briefly "Station routing control"
        described as {
          |Where the kitchen manager sets which station cooks each menu category.
        }
      }
      input GetDrinkOrderInput acquires query Bar.DrinkOrder.GetDrinkOrder with {
        briefly "Look up drink order control"
        described as {
          |Where a server or bartender looks up one drink order to see where it stands.
        }
      }
      input GetTableOrderInput acquires query FrontOfHouse.TableOrder.GetTableOrder with {
        briefly "Look up table order control"
        described as {
          |Where a server opens one table's order to see what is on it and where it stands.
        }
      }
      input GetKitchenTicketInput acquires query Kitchen.KitchenTicket.GetKitchenTicket with {
        briefly "Look up kitchen ticket control"
        described as {
          |Where the expo opens one ticket to see its items and station.
        }
      }
      input GetLoyaltyAccountInput acquires query Loyalty.LoyaltyAccount.GetLoyaltyAccount with {
        briefly "Look up loyalty account control"
        described as {
          |Where staff open one member's account to see points and standing.
        }
      }
      input GetOnlineOrderInput acquires query OnlineOrdering.OnlineOrder.GetOnlineOrder with {
        briefly "Look up online order control"
        described as {
          |Where a customer checks on their own online order.
        }
      }
      input GetDeliveryOrderInput acquires query Delivery.DeliveryOrder.GetDeliveryOrder with {
        briefly "Look up delivery control"
        described as {
          |Where staff open one delivery to see its driver and progress.
        }
      }
      input GetReservationInput acquires query FrontOfHouse.Reservation.GetReservation with {
        briefly "Look up reservation control"
        described as {
          |Where a host opens one booking to see the party, the time and where it stands.
        }
      }
      input GetReservationBoardInput acquires query FrontOfHouse.GetReservationBoard with {
        briefly "Reservation board control"
        described as {
          |Where a host pulls up the whole night's bookings.
        }
      }
      input CompleteOnlineOrderInput acquires command OnlineOrdering.OnlineOrder.CompleteOnlineOrder with {
        briefly "Complete online order control"
        described as {
          |Counter staff hand a pickup order to the customer. The kitchen
          |completes it when the server is notified; this is the hand-over
          |recorded at the counter when that is where it happens.
        }
      }
      input GetRestaurantMenuItemInput acquires query Menu.RestaurantMenuItem.GetRestaurantMenuItem with {
        briefly "Look up menu item control"
        described as {
          |Where staff check how one dish is listed on this restaurant's menu,
          |and whether it can be ordered.
        }
      }
      output ReservationCreatedView presents result FrontOfHouse.Reservation.ReservationResult with {
        briefly "Created reservation view"
        described as {
          |Shows the host the reservation created from a request.
        }
      }
      output ReservationBoardDisplay presents result FrontOfHouse.Reservation.ReservationResult with {
        briefly "Reservation board"
        described as {
          |Shows the host table availability across the floor.
        }
      }
      output ServerNotification presents result Kitchen.KitchenTicket.KitchenTicketResult with {
        briefly "Server notification"
        described as {
          |Notifies the assigned server that food is ready.
        }
      }
      output LoyaltyAccountView presents result Loyalty.LoyaltyAccount.LoyaltyAccountResult with {
        briefly "Loyalty account view"
        described as {
          |Shows the customer their newly created loyalty account.
        }
      }
      output PointsBalanceView presents result Loyalty.LoyaltyAccount.LoyaltyAccountResult with {
        briefly "Points balance view"
        described as {
          |Shows the customer their accrued point balance.
        }
      }
      output PointsRedemptionView presents result Loyalty.LoyaltyAccount.LoyaltyAccountResult with {
        briefly "Points redemption view"
        described as {
          |Shows the customer the outcome of a redemption request.
        }
      }
      output DeliveryAddressValidationView presents result OnlineOrdering.OnlineOrder.OnlineOrderResult with {
        briefly "Address validation view"
        described as {
          |Shows the customer whether their delivery address is serviceable.
        }
      }
      output DriverAssignmentView presents result Delivery.DeliveryOrder.DeliveryOrderResult with {
        briefly "Driver assignment view"
        described as {
          |Shows the driver the delivery assigned to them.
        }
      }
    } with {
      briefly "Restaurant screen"
      described as {
        |The screens through which restaurant staff and customers act.
      }
    }
    outlet AppDrinkOrderCommands is type Bar.DrinkOrderRequest
    outlet AppDeliveryOrderCommands is type Delivery.DeliveryOrderRequest
    outlet AppReservationCommands is type FrontOfHouse.ReservationRequest
    outlet AppTableOrderCommands is type FrontOfHouse.TableOrderRequest
    outlet AppKitchenTicketCommands is type Kitchen.KitchenRequest
    outlet AppMenuQueries is query Menu.RestaurantMenuItem.GetRestaurantMenuItem
    inlet AppMenuItemResults is result Menu.RestaurantMenuItem.RestaurantMenuItemResult
    outlet AppLoyaltyAccountCommands is type Loyalty.LoyaltyAccountRequest
    outlet AppOnlineOrderCommands is type OnlineOrdering.OnlineOrderRequest
    outlet AppPartnerOrderCommands is type OnlineOrdering.OnlineOrderRequest
    inlet AppTableOrderRepositoryResponses is result FrontOfHouse.TableOrder.TableOrderResult
    inlet AppReservationResults is result FrontOfHouse.Reservation.ReservationResult
    inlet AppDrinkOrderRepositoryResponses is result Bar.DrinkOrder.DrinkOrderResult
    inlet AppDeliveryRepositoryResponses is result Delivery.DeliveryOrder.DeliveryOrderResult
    inlet AppReservationRepositoryResponses is result FrontOfHouse.ReservationBoardView
    inlet AppKitchenTicketRepositoryResponses is result Kitchen.KitchenTicket.KitchenTicketResult
    inlet AppLoyaltyAccountRepositoryResponses is result Loyalty.LoyaltyAccount.LoyaltyAccountResult
    inlet AppOnlineOrderRepositoryResponses is result OnlineOrdering.OnlineOrder.OnlineOrderResult
    inlet AppOrderCreatedAnswer is event FrontOfHouse.TableOrder.OrderCreated
    inlet AppMenuBrowsedAnswer is event OnlineOrdering.OnlineOrder.MenuBrowsed
    inlet AppCustomerEnrolledAnswer is event Loyalty.LoyaltyAccount.CustomerEnrolled
    handler RestaurantAppHandler is {
      on customerEnrolled: event Loyalty.LoyaltyAccount.CustomerEnrolled is {
        put customerEnrolled to output RestaurantApp.RestaurantScreen.CustomerEnrolledView
      }
      on menuBrowsed: event OnlineOrdering.OnlineOrder.MenuBrowsed is {
        put menuBrowsed to output RestaurantApp.RestaurantScreen.MenuBrowsedView
      }
      on orderCreated: event FrontOfHouse.TableOrder.OrderCreated is {
        put orderCreated to output RestaurantApp.RestaurantScreen.OrderCreatedView
      }
      on command ShowReservation is {
        put result FrontOfHouse.Reservation.ReservationResult(reservation = prompt("the reservation the host just took, as the book now holds it"), reservationId = prompt("the reservation id of this reservation result")) to output ReservationCreatedView
      }
      on other is {
        error "Unexpected message for application context RestaurantApp"
      }
    } with {
      briefly "RestaurantApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "RestaurantApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CustomerEnrolled Answer' is from outlet Loyalty.CustomerEnrolledAnswerOut to inlet RestaurantApp.AppCustomerEnrolledAnswer with {
    briefly "The customer enrolled answer, back to the screen that issued EnrollCustomer"
    described as {
      |Carries CustomerEnrolled, and with it the id the new instance was given,
      |to the application whose screen issued the command.
    }
  }
  persistent connector 'OrderCreated Answer' is from outlet FrontOfHouse.OrderCreatedAnswerOut to inlet RestaurantApp.AppOrderCreatedAnswer with {
    briefly "The order created answer, back to the screen that issued CreateOrder"
    described as {
      |Carries OrderCreated, and with it the id the new instance was given,
      |to the application whose screen issued the command.
    }
  }
  persistent connector 'MenuBrowsed Answer' is from outlet OnlineOrdering.MenuBrowsedAnswerOut to inlet RestaurantApp.AppMenuBrowsedAnswer with {
    briefly "The menu browsed answer, back to the screen that issued BrowseMenu"
    described as {
      |Carries MenuBrowsed, and with it the id the new instance was given,
      |to the application whose screen issued the command.
    }
  }
  persistent connector 'DrinkOrderCommand Stream' is from outlet RestaurantApp.AppDrinkOrderCommands to inlet Bar.DrinkOrderCommandStreamIn with {
    briefly "DrinkOrder commands from the application"
    described as {
      |Carries what leaves AppDrinkOrderCommands to DrinkOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'DeliveryOrderCommand Stream' is from outlet RestaurantApp.AppDeliveryOrderCommands to inlet Delivery.DeliveryOrderCommandStreamIn with {
    briefly "DeliveryOrder commands from the application"
    described as {
      |Carries what leaves AppDeliveryOrderCommands to DeliveryOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'ReservationCommand Stream' is from outlet RestaurantApp.AppReservationCommands to inlet FrontOfHouse.ReservationCommandStreamIn with {
    briefly "Reservation commands from the application"
    described as {
      |Carries what leaves AppReservationCommands to ReservationCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'TableOrderCommand Stream' is from outlet RestaurantApp.AppTableOrderCommands to inlet FrontOfHouse.TableOrderCommandStreamIn with {
    briefly "TableOrder commands from the application"
    described as {
      |Carries what leaves AppTableOrderCommands to TableOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'KitchenTicketCommand Stream' is from outlet RestaurantApp.AppKitchenTicketCommands to inlet Kitchen.KitchenTicketCommandStreamIn with {
    briefly "KitchenTicket commands from the application"
    described as {
      |Carries what leaves AppKitchenTicketCommands to KitchenTicketCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'LoyaltyAccountCommand Stream' is from outlet RestaurantApp.AppLoyaltyAccountCommands to inlet Loyalty.LoyaltyAccountCommandStreamIn with {
    briefly "LoyaltyAccount commands from the application"
    described as {
      |Carries what leaves AppLoyaltyAccountCommands to LoyaltyAccountCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'OnlineOrderCommand Storefront Intake' is from outlet RestaurantApp.AppOnlineOrderCommands to inlet CustomerGateway.StorefrontOrdersIn with {
    briefly "Storefront orders from the application to the gateway"
    described as {
      |Customer order traffic no longer reaches OnlineOrdering directly; it
      |is admitted at the gateway first.
    }
  }
  persistent connector 'OnlineOrderCommand Partner Intake' is from outlet RestaurantApp.AppPartnerOrderCommands to inlet CustomerGateway.PartnerOrdersIn with {
    briefly "Marketplace orders from the application to the gateway"
    described as {
      |The gateway's second inbound channel, which is what makes it a merge.
    }
  }
  persistent connector 'OnlineOrderCommand Stream' is from outlet CustomerGateway.AdmittedOrdersOut to inlet OnlineOrdering.OnlineOrderCommandStreamIn with {
    briefly "Admitted OnlineOrder commands on their way to be acted on"
    described as {
      |Carries what leaves AdmittedOrdersOut to OnlineOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'DrinkOrderResult Stream' is from outlet Bar.DrinkOrderResultStreamOut to inlet RestaurantApp.AppDrinkOrderRepositoryResponses with {
    briefly "DrinkOrder query results returned to the application"
    described as {
      |Carries what leaves DrinkOrderResultStreamOut to AppDrinkOrderRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'DeliveryOrderResult Stream' is from outlet Delivery.DeliveryOrderResultStreamOut to inlet RestaurantApp.AppDeliveryRepositoryResponses with {
    briefly "Delivery query results returned to the application"
    described as {
      |Carries what leaves DeliveryOrderResultStreamOut to AppDeliveryRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'ReservationBoardView Stream' is from outlet FrontOfHouse.ReservationBoardViewStreamOut to inlet RestaurantApp.AppReservationRepositoryResponses with {
    briefly "Reservation query results returned to the application"
    described as {
      |Carries what leaves ReservationBoardViewStreamOut to AppReservationRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'KitchenTicketResult Stream' is from outlet Kitchen.KitchenTicketResultStreamOut to inlet RestaurantApp.AppKitchenTicketRepositoryResponses with {
    briefly "KitchenTicket query results returned to the application"
    described as {
      |Carries what leaves KitchenTicketResultStreamOut to AppKitchenTicketRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'LoyaltyAccountResult Stream' is from outlet Loyalty.LoyaltyAccountResultStreamOut to inlet RestaurantApp.AppLoyaltyAccountRepositoryResponses with {
    briefly "LoyaltyAccount query results returned to the application"
    described as {
      |Carries what leaves LoyaltyAccountResultStreamOut to AppLoyaltyAccountRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'OnlineOrderResult Stream' is from outlet OnlineOrdering.OnlineOrderResultStreamOut to inlet RestaurantApp.AppOnlineOrderRepositoryResponses with {
    briefly "OnlineOrder query results returned to the application"
    described as {
      |Carries what leaves OnlineOrderResultStreamOut to AppOnlineOrderRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'ReservationResult Stream' is from outlet FrontOfHouse.ReservationResultStreamOut to inlet RestaurantApp.AppReservationResults with {
    briefly "A reservation's answers to the restaurant's screens"
    described as {
      |Carries ReservationResult from Front of House to the host's screen.
    }
  }
  persistent connector 'RestaurantMenuItemQuery Stream' is from outlet RestaurantApp.AppMenuQueries to inlet Menu.RestaurantMenuItemQueriesIn with {
    briefly "Look-ups of one dish from the application"
    described as {
      |Where staff check how one dish is listed.
    }
  }
  persistent connector 'RestaurantMenuItemResult Stream' is from outlet Menu.RestaurantMenuItemResultOut to inlet RestaurantApp.AppMenuItemResults with {
    briefly "A dish's listing returned to the application"
    described as {
      |The answer to a look-up of one dish.
    }
  }
  persistent connector 'TableOrderResult Stream' is from outlet FrontOfHouse.TableOrderResultStreamOut to inlet RestaurantApp.AppTableOrderRepositoryResponses with {
    briefly "TableOrder query results returned to the application"
    described as {
      |Carries stored table-order rows back to the restaurant application in
      |answer to its queries, matching every other repository in this domain.
    }
  }
} with {
  briefly "Restaurant operations domain"
  described as {
    | Covers all in-restaurant and customer-facing operations
    | including front-of-house, kitchen, bar, online ordering,
    | delivery, and loyalty program.
  }
}
