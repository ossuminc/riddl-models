// External systems used by the Restaurant domain
external context PaymentGateway as flow is {
  inlet PaymentGatewayToFOHIn is type PaymentGatewayEvent  outlet PaymentGatewayToFOHOut is type PaymentGatewayEvent
  handler PaymentGatewayBoundary is {
    on paymentAuthorized: event PaymentGateway.PaymentAuthorized is {
      send paymentAuthorized to outlet PaymentGateway.PaymentGatewayToFOHOut
    }
    on paymentCaptured: event PaymentGateway.PaymentCaptured is {
      send paymentCaptured to outlet PaymentGateway.PaymentGatewayToFOHOut
    }
    on other is {
      error "Unexpected message at the PaymentGateway boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  persistent connector 'PaymentGatewayToFOH Egress' is from outlet PaymentGateway.PaymentEventSource.PaymentResults to inlet PaymentGateway.PaymentGatewayToFOHIn  command AuthorizePayment is  {
    paymentGatewayTransactionId: String(1,100) with {
      briefly "Transaction ID"
      described as {
        |External transaction identifier.
      }
    }
    authorizeAmount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |What the gateway is asked to hold against the card. An
        |authorization reserves funds without taking them.
      }
    }
    authorizeMethod: String(1,50) with {
      briefly "Method"
      described as {
        |Payment method.
      }
    }
  } with {
    briefly "Authorize payment"
    described as {
      |Authorize a payment through the gateway.
    }
  }
  event PaymentAuthorized is  {
    paymentGatewayTransactionId: String(1,100) with {
      briefly "Transaction ID"
      described as {
        |External transaction identifier.
      }
    }
    authorizedAmount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |What the gateway actually held, which may be less than requested if
        |the card's limit did not cover it.
      }
    }
    authorizationCode: String(1,50) with {
      briefly "Authorization code"
      described as {
        |Gateway authorization code.
      }
    }
  } with {
    briefly "Payment authorized"
    described as {
      |Emitted when payment is authorized.
    }
  }
  command CapturePayment is  {
    captureTransactionId: String(1,100) with {
      briefly "Transaction ID"
      described as {
        |The gateway's handle for an earlier authorization. Capture must name
        |the hold it is settling; the restaurant's own order id means nothing
        |to the gateway.
      }
    }
    captureAmount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |What to actually take. May be below the authorized figure when a
        |line is removed after the card was held.
      }
    }
  } with {
    briefly "Capture payment"
    described as {
      |Capture an authorized payment.
    }
  }
  event PaymentCaptured is  {
    captureTransactionId: String(1,100) with {
      briefly "Transaction ID"
      described as {
        |Captured transaction.
      }
    }
    capturedAmount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |What the gateway settled. The figure that reaches the restaurant's
        |account, and what sales reporting reconciles against.
      }
    }
  } with {
    briefly "Payment captured"
    described as {
      |Emitted when payment is captured.
    }
  }
  handler PaymentHandler is {
    on authorizePayment: command AuthorizePayment is {
      yield event PaymentAuthorized(paymentGatewayTransactionId = authorizePayment.paymentGatewayTransactionId, authorizedAmount = prompt("the authorized amount of this payment authorized"), authorizationCode = prompt("the authorization code of this payment authorized"))
      do "submit authorization request to payment processor"
    }
    on capturePayment: command CapturePayment is {
      yield event PaymentCaptured(captureTransactionId = capturePayment.captureTransactionId, capturedAmount = prompt("the captured amount of this payment captured"))
      do "submit capture request to payment processor"
    }
  } with {
    briefly "Payment handler"
    described as {
      |Processes payment authorization and capture requests
      |through the external payment gateway.
    }
  }
  type PaymentGatewayEvent is one of {
    PaymentGateway.PaymentAuthorized or PaymentGateway.PaymentCaptured
  } with {
    briefly "Payment gateway event alternation"
    described as {
      |Union of all payment gateway events for streaming.
    }
  }
  processor PaymentEventSource as source is {
    outlet PaymentResults is type PaymentGatewayEvent
    handler PaymentEventEmitter is {
      on other is {
        error "Unexpected message for source PaymentEventSource"
      }
      on paymentAuthorized: event PaymentAuthorized is {
        send paymentAuthorized to outlet PaymentResults
      }
      on paymentCaptured: event PaymentCaptured is {
        send paymentCaptured to outlet PaymentResults
      }
    } with {
      briefly "Payment event emitter"
      described as {
        |Emits payment gateway response events into the
        |streaming topology.
      }
    }
  } with {
    briefly "Payment event source"
    described as {
      |Emits payment authorization and capture results from
      |the external payment gateway.
    }
  }
} with {
  briefly "External payment gateway"
  described as {
    |Third-party payment processing service.
  }
}
external context NotificationService as flow is {
  outlet NotificationToFOHOut is type NotificationEvent
  inlet NotificationToFOHSrc is type NotificationEvent  persistent connector 'NotificationToFOH Egress' is from outlet NotificationService.NotificationEventSource.NotificationResults to inlet NotificationService.NotificationToFOHSrc  command SendPushNotification is  {
    notificationRecipient: String(1,100) with {
      briefly "Recipient"
      described as {
        |Who to notify, in the notification service's own terms — a device or
        |subscription handle, not a customer the restaurant would recognise.
      }
    }
    notificationTitle: String(1,200) with {
      briefly "Title"
      described as {
        |The headline the guest sees on their lock screen, which is usually
        |all of the message they read.
      }
    }
    notificationBody: String(1,1000) with {
      briefly "Body"
      described as {
        |Notification body text.
      }
    }
  } with {
    briefly "Send push notification"
    described as {
      |Send a push notification to a device.
    }
  }
  event PushNotificationSent is  {
    notificationRecipient: String(1,100) with {
      briefly "Recipient"
      described as {
        |Who the service delivered to, echoed back so a send can be matched
        |to its request.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent at"
      described as {
        |When the notification was sent.
      }
    }
  } with {
    briefly "Push notification sent"
    described as {
      |Emitted when a push notification is delivered.
    }
  }
  handler NotificationHandler is {
    on sendPushNotification: command SendPushNotification is {
      yield event PushNotificationSent(notificationRecipient = sendPushNotification.notificationRecipient, sentAt = prompt("the sent at of this push notification sent"))
      do "dispatch push notification to recipient device"
    }
  } with {
    briefly "Notification handler"
    described as {
      |Processes push notification dispatch requests
      |through the external notification service.
    }
  }
  type NotificationEvent is NotificationService.PushNotificationSent with {
    briefly "Notification event alternation"
    described as {
      |Union of notification service events for streaming.
    }
  }
  processor NotificationEventSource as source is {
    outlet NotificationResults is type NotificationEvent
    handler NotificationEventEmitter is {
      on other is {
        error "Unexpected message for source NotificationEventSource"
      }
      on pushNotificationSent: event PushNotificationSent is {
        send pushNotificationSent to outlet NotificationResults
      }
    } with {
      briefly "Notification event emitter"
      described as {
        |Emits notification delivery confirmations into
        |the streaming topology.
      }
    }
  } with {
    briefly "Notification event source"
    described as {
      |Emits push notification delivery confirmations.
    }
  }
} with {
  briefly "External notification service"
  described as {
    |Push notification delivery service for mobile devices.
  }
}
