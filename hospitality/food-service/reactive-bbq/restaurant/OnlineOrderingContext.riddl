// Online Ordering bounded context
context OnlineOrdering as router is {
  inlet DeliveryToOnlineIn is type DeliveryEvent  outlet DeliveryToOnlineOut is type DeliveryEvent
  inlet OnlineOrderCommandStreamIn is type OnlineOrderCommand  outlet OnlineOrderCommandStreamOut is type OnlineOrderCommand
  inlet OnlineOrderResultStreamIn is result OnlineOrder.OnlineOrderResult  outlet OnlineOrderResultStreamOut is result OnlineOrder.OnlineOrderResult
  handler OnlineOrderingBoundary is {
    on deliveryCreated: event DeliveryOrder.DeliveryCreated is {
      send deliveryCreated to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on driverAssigned: event DeliveryOrder.DriverAssigned is {
      send driverAssigned to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on driverDispatched: event DeliveryOrder.DriverDispatched is {
      send driverDispatched to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on deliveryLocationRecorded: event DeliveryOrder.DeliveryLocationRecorded is {
      send deliveryLocationRecorded to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on deliveryConfirmed: event DeliveryOrder.DeliveryConfirmed is {
      send deliveryConfirmed to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on deliveryPaymentRecorded: event DeliveryOrder.DeliveryPaymentRecorded is {
      send deliveryPaymentRecorded to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on deliveryIssueReported: event DeliveryOrder.DeliveryIssueReported is {
      send deliveryIssueReported to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on deliveryMarkedFailed: event DeliveryOrder.DeliveryMarkedFailed is {
      send deliveryMarkedFailed to outlet OnlineOrdering.DeliveryToOnlineOut
    }
    on browseMenu: command OnlineOrder.BrowseMenu is {
      forward browseMenu to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on addToCart: command OnlineOrder.AddToCart is {
      forward addToCart to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on removeFromCart: command OnlineOrder.RemoveFromCart is {
      forward removeFromCart to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on selectFulfillment: command OnlineOrder.SelectFulfillment is {
      forward selectFulfillment to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on submitOnlineOrder: command OnlineOrder.SubmitOnlineOrder is {
      forward submitOnlineOrder to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on processOnlinePayment: command OnlineOrder.ProcessOnlinePayment is {
      forward processOnlinePayment to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on markOnlineInPreparation: command OnlineOrder.MarkOnlineInPreparation is {
      forward markOnlineInPreparation to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on markReadyForPickup: command OnlineOrder.MarkReadyForPickup is {
      forward markReadyForPickup to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on markOutForDelivery: command OnlineOrder.MarkOutForDelivery is {
      forward markOutForDelivery to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on completeOnlineOrder: command OnlineOrder.CompleteOnlineOrder is {
      forward completeOnlineOrder to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on cancelOnlineOrder: command OnlineOrder.CancelOnlineOrder is {
      forward cancelOnlineOrder to outlet OnlineOrdering.OnlineOrderCommandStreamOut
    }
    on onlineOrderResult: result OnlineOrder.OnlineOrderResult is {
      send onlineOrderResult to outlet OnlineOrdering.OnlineOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the OnlineOrdering boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'OnlineOrderProjection Storage' is from outlet OnlineOrdering.OnlineOrderProjection.OnlineOrderProjectionToRepository to inlet OnlineOrdering.OnlineOrderRepository.OnlineOrderRepositoryFromOnlineOrderProjection with {
    briefly "OnlineOrderProjection commands on their way to OnlineOrderRepository"
    described as {
      |Carries what leaves OnlineOrdering.OnlineOrderProjection.OnlineOrderProjectionToRepository to OnlineOrdering.OnlineOrderRepository.OnlineOrderRepositoryFromOnlineOrderProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'DeliveryToOnline Intake' is from outlet OnlineOrdering.DeliveryToOnlineOut to inlet OnlineOrdering.DeliveryEventSink.IncomingDeliveryEvents  connector 'OnlineOrderCommand Stream Intake' is from outlet OnlineOrdering.OnlineOrderCommandStreamOut to inlet OnlineOrdering.OnlineOrder.OnlineOrderCommands  connector 'OnlineOrderResult Stream Egress' is from outlet OnlineOrdering.OnlineOrderRepository.OnlineOrderRepositoryResponses to inlet OnlineOrdering.OnlineOrderResultStreamIn  include "online-types.riddl"
  include "OnlineOrder.riddl"
  type OnlineOrderRepositoryCommand is one of {
    OnlineOrdering.OnlineOrderRepository.PersistMenuBrowsed or OnlineOrdering.OnlineOrderRepository.PersistItemAddedToCart or OnlineOrdering.OnlineOrderRepository.PersistItemRemovedFromCart or OnlineOrdering.OnlineOrderRepository.PersistFulfillmentSelected or OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderSubmitted or OnlineOrdering.OnlineOrderRepository.PersistOnlinePaymentProcessed or OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderInPreparation or OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderReadyForPickup or OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderOutForDelivery or OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderCompleted or OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderCancelled
  } with {
    briefly "Anything that writes the OnlineOrderRepository"
    described as {
      |The persistence commands OnlineOrderRepository accepts. Entity events never reach
      |it directly; OnlineOrderProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository OnlineOrderRepository as flow is {
    inlet OnlineOrderRepositoryFromOnlineOrderProjection is type OnlineOrderRepositoryCommand    outlet OnlineOrderRepositoryResponses is result OnlineOrder.OnlineOrderResult
    record StoredOnlineOrder is  {
      onlineOrderId: OnlineOrderId with {
        briefly "onlineOrderId"
        described as {
          |The onlineOrderId column of the stored onlineOrder row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored onlineOrder row.
        }
      }
    } with {
      briefly "Stored onlineOrder row"
      described as {
        |The persistence shape of onlineOrder data as this repository stores it.
      }
    }
    schema OnlineOrderSchema is relational
      of onlineOrders as record StoredOnlineOrder
        index on field StoredOnlineOrder.onlineOrderId
        index on field StoredOnlineOrder.customerId
 with {
      briefly "Online order data schema"
      described as {
        |Relational schema for persisting online order state
        |with indexes on order and customer.
      }
    }
    command PersistMenuBrowsed is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist MenuBrowsed"
      described as {
        |Instructs this repository to apply MenuBrowsed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAddedToCart is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ItemAddedToCart"
      described as {
        |Instructs this repository to apply ItemAddedToCart to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRemovedFromCart is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ItemRemovedFromCart"
      described as {
        |Instructs this repository to apply ItemRemovedFromCart to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFulfillmentSelected is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist FulfillmentSelected"
      described as {
        |Instructs this repository to apply FulfillmentSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderSubmitted is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderSubmitted"
      described as {
        |Instructs this repository to apply OnlineOrderSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlinePaymentProcessed is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlinePaymentProcessed"
      described as {
        |Instructs this repository to apply OnlinePaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderInPreparation is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderInPreparation"
      described as {
        |Instructs this repository to apply OnlineOrderInPreparation to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderReadyForPickup is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderReadyForPickup"
      described as {
        |Instructs this repository to apply OnlineOrderReadyForPickup to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderOutForDelivery is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderOutForDelivery"
      described as {
        |Instructs this repository to apply OnlineOrderOutForDelivery to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderCompleted is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderCompleted"
      described as {
        |Instructs this repository to apply OnlineOrderCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderCancelled is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderCancelled"
      described as {
        |Instructs this repository to apply OnlineOrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler OnlineOrderPersistence is {
      on command PersistMenuBrowsed is {
        do "insert row into OnlineOrderSchema.onlineOrders
          with onlineOrderId, customerId, createdAt =
          browsedAt"
      }
      on command PersistItemAddedToCart is {
        do "append cartItem to orderCartItems array in
          OnlineOrderSchema.onlineOrders where onlineOrderId
          matches"
      }
      on command PersistItemRemovedFromCart is {
        do "remove CartItem with removedCartItemId from
          orderCartItems array in OnlineOrderSchema
          .onlineOrders where onlineOrderId matches"
      }
      on command PersistFulfillmentSelected is {
        do "update OnlineOrderSchema.onlineOrders set
          selectedFulfillment = fulfillmentType,
          selectedDeliveryAddress = deliveryAddress where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderSubmitted is {
        do "update OnlineOrderSchema.onlineOrders set
          actualOnlineSubmittedAt = onlineSubmittedAt where
          onlineOrderId matches"
      }
      on command PersistOnlinePaymentProcessed is {
        do "update OnlineOrderSchema.onlineOrders set
          processedOnlinePayment = onlinePayment where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderInPreparation is {
        do "update OnlineOrderSchema.onlineOrders where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderReadyForPickup is {
        do "update OnlineOrderSchema.onlineOrders where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderOutForDelivery is {
        do "update OnlineOrderSchema.onlineOrders where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderCompleted is {
        do "update OnlineOrderSchema.onlineOrders set
          completedAt = completedAt where onlineOrderId
          matches"
      }
      on command PersistOnlineOrderCancelled is {
        do "update OnlineOrderSchema.onlineOrders set
          cancelledAt = cancelledAt, cancellationReason =
          cancellationReason where onlineOrderId matches"
      }
    } with {
      briefly "Online order persistence"
      described as {
        |Persists online order events to the onlineOrders table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Online order repository"
    described as {
      |Stores and retrieves online order data.
    }
  }
  projector OnlineOrderProjection as flow is {
    updates repository OnlineOrdering.OnlineOrderRepository
    inlet OnlineOrderProjectionFromOnlineOrder is type OnlineOrderEvent    outlet OnlineOrderProjectionToRepository is type OnlineOrderRepositoryCommand
    handler OnlineOrderProjectionHandler is {
      on menuBrowsed: event OnlineOrdering.OnlineOrder.MenuBrowsed is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistMenuBrowsed(onlineOrderId = menuBrowsed.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on itemAddedToCart: event OnlineOrdering.OnlineOrder.ItemAddedToCart is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistItemAddedToCart(onlineOrderId = itemAddedToCart.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on itemRemovedFromCart: event OnlineOrdering.OnlineOrder.ItemRemovedFromCart is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistItemRemovedFromCart(onlineOrderId = itemRemovedFromCart.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on fulfillmentSelected: event OnlineOrdering.OnlineOrder.FulfillmentSelected is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistFulfillmentSelected(onlineOrderId = fulfillmentSelected.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on onlineOrderSubmitted: event OnlineOrdering.OnlineOrder.OnlineOrderSubmitted is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderSubmitted(onlineOrderId = onlineOrderSubmitted.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on onlinePaymentProcessed: event OnlineOrdering.OnlineOrder.OnlinePaymentProcessed is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistOnlinePaymentProcessed(onlineOrderId = onlinePaymentProcessed.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on onlineOrderInPreparation: event OnlineOrdering.OnlineOrder.OnlineOrderInPreparation is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderInPreparation(onlineOrderId = onlineOrderInPreparation.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on onlineOrderReadyForPickup: event OnlineOrdering.OnlineOrder.OnlineOrderReadyForPickup is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderReadyForPickup(onlineOrderId = onlineOrderReadyForPickup.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on onlineOrderOutForDelivery: event OnlineOrdering.OnlineOrder.OnlineOrderOutForDelivery is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderOutForDelivery(onlineOrderId = onlineOrderOutForDelivery.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on onlineOrderCompleted: event OnlineOrdering.OnlineOrder.OnlineOrderCompleted is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderCompleted(onlineOrderId = onlineOrderCompleted.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on onlineOrderCancelled: event OnlineOrdering.OnlineOrder.OnlineOrderCancelled is {
        tell command OnlineOrdering.OnlineOrderRepository.PersistOnlineOrderCancelled(onlineOrderId = onlineOrderCancelled.onlineOrderId) to repository OnlineOrdering.OnlineOrderRepository
      }
      on other is {
        do "not persisted: AddToCartRejected, BrowseMenuRejected, CancelOnlineOrderRejected, CompleteOnlineOrderRejected and 7 more record no stored state"
      }
    } with {
      briefly "OnlineOrderProjection handler"
      described as {
        |Turns each OnlineOrder event into the repository command that writes it.
      }
    }
  } with {
    briefly "OnlineOrder persistence projection"
    described as {
      |Builds the stored OnlineOrder view from the entity's events.
    }
  }
  saga OnlineOrderCheckout is {
    step StepSubmitOrder is  {
      do "Close the cart and commit the order the guest assembled"
      let submitOnlineOrder: type SubmitOnlineOrder = prompt("the submit online order that results from persist online order cancelled")
      tell submitOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
    reverted by {
      do "Release the order so the cart is not left stranded as committed"
      let cancelOnlineOrder: type CancelOnlineOrder = prompt("the cancel online order that results from persist online order cancelled")
      tell cancelOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
 with {
      briefly "Commit the cart"
      described as {
        |The first irreversible step from the guest's side: after it the cart
        |can no longer be edited. Compensating means cancelling outright,
        |because there is no state between "submitted" and "never happened".
      }
    }
    step StepTakePayment is  {
      do "Charge the card before any food is committed to"
      let processOnlinePayment: type ProcessOnlinePayment = prompt("the process online payment that results from persist online order cancelled")
      tell processOnlinePayment to entity OnlineOrdering.OnlineOrder
    }
    reverted by {
      do "Cancel the order, which is what releases the authorization"
      let cancelOnlineOrder: type CancelOnlineOrder = prompt("the cancel online order that results from persist online order cancelled")
      tell cancelOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
 with {
      briefly "Take payment"
      described as {
        |Online orders are paid before they are cooked, the reverse of a
        |dine-in check. That ordering is what makes this saga worth having:
        |payment can fail after the order is committed, and something has to
        |put the order back.
      }
    }
    step StepStartPreparation is  {
      do "Release the paid order to the kitchen"
      let markOnlineInPreparation: type MarkOnlineInPreparation = prompt("the mark online in preparation that results from persist online order cancelled")
      tell markOnlineInPreparation to entity OnlineOrdering.OnlineOrder
    }
    reverted by {
      do "Cancel the order; food already started is waste the restaurant eats"
      let cancelOnlineOrder: type CancelOnlineOrder = prompt("the cancel online order that results from persist online order cancelled")
      tell cancelOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
 with {
      briefly "Start preparation"
      described as {
        |The last step, and the only one whose compensation costs real money —
        |reverting after the kitchen has fired wastes food already cooked.
        |That asymmetry is why payment is taken first.
      }
    }
  } with {
    briefly "Online order checkout"
    described as {
      |Commit, pay, and release to the kitchen, with each step able to put the
      |order back if a later one fails.
      |
      |Every step tells a command to this context's OWN aggregate. Calling the
      |payment gateway is deliberately NOT a step's `tell`: that is an
      |external system reached through an adaptor, and naming it here would
      |cross a context boundary and bypass the anti-corruption layer.
    }
  }
  command LogOnlineOrderEvent is  {
    loggedOnlineOrderId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the online order the logged event concerns.
      }
    }
  } with {
    briefly "Log online order event"
    described as {
      |Append a published online order event to this context's event log.
    }
  }
  processor OnlineOrderEventLog as sink is {
    inlet IncomingOnlineOrderLog is type OnlineOrderEvent    handler OnlineOrderLogIntake is {
      on other is {
        let logOnlineOrderEvent: type LogOnlineOrderEvent = prompt("the online order event to append to this context's log")
        tell logOnlineOrderEvent to repository OnlineOrdering.OnlineOrderRepository
        do "append the online order event to the context event log"
      }
    } with {
      briefly "OnlineOrder log intake"
      described as {
        |Routes every published online order event into the context's own
        |durable event log.
      }
    }
  } with {
    briefly "OnlineOrder event log"
    described as {
      |Durable local log of the online order events this context publishes.
      |It replaces the raw event stream that used to carry these to the
      |kitchen and delivery contexts, which the adaptors already translate.
    }
  }
  connector OnlineOrderToLog is from outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents to inlet OnlineOrdering.OnlineOrderEventLog.IncomingOnlineOrderLog with {
    briefly "OnlineOrder event log connector"
    described as {
      |Wires published online order events to the context's event log.
    }
  }
  processor OnlineOrderEventSource as source is {
    outlet SubmittedOnlineOrderEvents is type OnlineOrderEvent
    handler OnlineOrderEventEmitter is {
      on other is {
        error "Unexpected message for source OnlineOrderEventSource"
      }
      on onlineOrderSubmitted: event OnlineOrder.OnlineOrderSubmitted is {
        send onlineOrderSubmitted to outlet SubmittedOnlineOrderEvents
      }
    } with {
      briefly "Online order event emitter"
      described as {
        |Emits online order submission events into the
        |streaming topology for kitchen routing.
      }
    }
  } with {
    briefly "Online order event source"
    described as {
      |Emits online order submission events from the
      |OnlineOrder entity into the streaming topology for
      |kitchen routing.
    }
  }
  adaptor ToKitchen to context Restaurant.Kitchen is { 
    handler OnlineKitchenRouting is {
      on onlineOrderSubmitted: event OnlineOrder.OnlineOrderSubmitted is {
        do "map each OnlineOrderSubmitted.orderCartItems CartItem
          to TicketItem with ticketMenuItemId = cartMenuItemId,
          ticketItemName = cartItemName, ticketItemQuantity =
          cartItemQuantity, ticketItemNotes = cartItemNotes,
          ticketItemReady = false"
        do "construct ReceiveTicket with new KitchenTicketId,
          sourceOrderId = event.onlineOrderId, ticketSource =
          Online, ticketItems = mapped list, receivedAt =
          current timestamp"
        let receiveTicket: type ReceiveTicket = prompt("the receive ticket that results from online order submitted")
        tell receiveTicket to entity Kitchen.KitchenTicket
        tell event OnlineOrder.OnlineTicketRouted(onlineOrderId = onlineOrderSubmitted.onlineOrderId, onlineTicketRoutedAt = prompt("the online ticket routed at of this online ticket routed")) to entity OnlineOrdering.OnlineOrder
      }
      on other is {
        error "Unexpected message for adaptor ToKitchen"
      }
    } with {
      briefly "Kitchen routing"
      described as {
        |Routes online orders to the kitchen.
      }
    }
  } with {
    briefly "Kitchen adaptor"
    described as {
      |Sends submitted online orders to kitchen.
    }
  }
  adaptor ToLoyalty to context Restaurant.Loyalty is { 
    handler OnlineLoyaltyRouting is {
      on onlinePaymentProcessed: event OnlineOrder.OnlinePaymentProcessed is {
        let pointsEarned = "OnlinePaymentProcessed.onlinePayment
          .onlinePaymentAmount truncated to integer as
          accrualPoints"
        do "construct AccruePoints with loyaltyAccountId looked
          up by event.customerId, accrualPoints = pointsEarned,
          accrualReason = online purchase, accrualOrderRef =
          OnlinePaymentProcessed.onlineOrderId"
        let accruePoints: type AccruePoints = prompt("the accrue points that results from online payment processed")
        tell accruePoints to entity Loyalty.LoyaltyAccount
        tell event OnlineOrder.OnlinePointsAccrualRouted(onlineOrderId = onlinePaymentProcessed.onlineOrderId, onlinePointsAccrualRoutedAt = prompt("the online points accrual routed at of this online points accrual routed")) to entity OnlineOrdering.OnlineOrder
      }
      on other is {
        error "Unexpected message for adaptor ToLoyalty"
      }
    } with {
      briefly "Loyalty routing"
      described as {
        |Routes payment events for loyalty accrual.
      }
    }
  } with {
    briefly "Loyalty adaptor"
    described as {
      |Sends online payment events to loyalty context.
    }
  }
  processor DeliveryEventSink as sink is {
    inlet IncomingDeliveryEvents is type DeliveryEvent    handler DeliveryEventIntake is {
      on other is {
        do "the remaining members of this inlet's type - rejections and events this sink does not act on - change nothing here"
      }
      on driverDispatched: event Restaurant.Delivery.DeliveryOrder.DriverDispatched is {
        tell command OnlineOrder.MarkOutForDelivery(dispatchedAt = driverDispatched.dispatchedAt, onlineOrderId = prompt("the online order id of this mark out for delivery")) to entity OnlineOrdering.OnlineOrder
        do "update online order status to out for delivery"
      }
      on event Restaurant.Delivery.DeliveryOrder.DeliveryConfirmed is {
        let completeOnlineOrder: type OnlineOrder.CompleteOnlineOrder = prompt("the complete online order that results from delivery confirmed")
        tell completeOnlineOrder to entity OnlineOrdering.OnlineOrder
        do "complete online order upon delivery confirmation"
      }
      on event Restaurant.Delivery.DeliveryOrder.DeliveryMarkedFailed is {
        let cancelOnlineOrder: type OnlineOrder.CancelOnlineOrder = prompt("the cancel online order that results from delivery marked failed")
        tell cancelOnlineOrder to entity OnlineOrdering.OnlineOrder
        do "cancel online order upon delivery failure"
      }
    } with {
      briefly "Delivery event intake"
      described as {
        |Processes incoming delivery events for delivery
        |status updates on online orders.
      }
    }
  } with {
    briefly "Delivery event sink"
    described as {
      |Receives delivery events from the streaming topology
      |for delivery status updates to online orders.
    }
  }
  connector 'OnlineOrderEvent Storage' is from outlet OnlineOrdering.OnlineOrder.OnlineOrderEvents to inlet OnlineOrdering.OnlineOrderProjection.OnlineOrderProjectionFromOnlineOrder with {
    briefly "OnlineOrder events on their way to storage"
    described as {
      |Carries what leaves OnlineOrderEvents to OnlineOrderRepositoryFromOnlineOrder, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  briefly "Online ordering context"
  described as {
    | Manages the online ordering experience including menu
    | browsing, cart management, fulfillment selection, and
    | checkout. Decoupled from delivery context so electronic
    | menus can be developed independently. Communicates with
    | kitchen, delivery, and loyalty via adaptors.
  }
}
