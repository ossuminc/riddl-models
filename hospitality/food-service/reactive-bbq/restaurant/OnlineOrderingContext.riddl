// Online Ordering bounded context
context OnlineOrdering is {
  include "online-types.riddl"
  include "OnlineOrder.riddl"
  repository OnlineOrderRepository as flow is {
    inlet OnlineOrderRepositoryFromOnlineOrder is type OnlineOrderEvent    outlet OnlineOrderRepositoryResponses is type OnlineOrder.OnlineOrderResult
    record StoredOnlineOrder is  {
      onlineOrderId: OnlineOrderId with {
        briefly "onlineOrderId"
        described as {
          |The onlineOrderId column of the stored onlineOrder row.
        }
      }
      customerId: CustomerId with {
        briefly "customerId"
        described as {
          |The customerId column of the stored onlineOrder row.
        }
      }
    } with {
      briefly "Stored onlineOrder row"
      described as {
        |The persistence shape of onlineOrder data as this repository stores it.
      }
    }
    schema OnlineOrderSchema is relational
      of onlineOrders as type StoredOnlineOrder
        index on field StoredOnlineOrder.onlineOrderId
        index on field StoredOnlineOrder.customerId
 with {
      briefly "Online order data schema"
      described as {
        |Relational schema for persisting online order state
        |with indexes on order and customer.
      }
    }
    command PersistMenuBrowsed is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist MenuBrowsed"
      described as {
        |Instructs this repository to apply MenuBrowsed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAddedToCart is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ItemAddedToCart"
      described as {
        |Instructs this repository to apply ItemAddedToCart to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRemovedFromCart is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ItemRemovedFromCart"
      described as {
        |Instructs this repository to apply ItemRemovedFromCart to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFulfillmentSelected is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist FulfillmentSelected"
      described as {
        |Instructs this repository to apply FulfillmentSelected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderSubmitted is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderSubmitted"
      described as {
        |Instructs this repository to apply OnlineOrderSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlinePaymentProcessed is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlinePaymentProcessed"
      described as {
        |Instructs this repository to apply OnlinePaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderInPreparation is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderInPreparation"
      described as {
        |Instructs this repository to apply OnlineOrderInPreparation to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderReadyForPickup is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderReadyForPickup"
      described as {
        |Instructs this repository to apply OnlineOrderReadyForPickup to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderOutForDelivery is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderOutForDelivery"
      described as {
        |Instructs this repository to apply OnlineOrderOutForDelivery to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderCompleted is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderCompleted"
      described as {
        |Instructs this repository to apply OnlineOrderCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOnlineOrderCancelled is  {
      onlineOrderId: OnlineOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OnlineOrderCancelled"
      described as {
        |Instructs this repository to apply OnlineOrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler OnlineOrderPersistence is {
      on command PersistMenuBrowsed is {
        do "insert row into OnlineOrderSchema.onlineOrders
          with onlineOrderId, customerId, createdAt =
          browsedAt"
      }
      on command PersistItemAddedToCart is {
        do "append cartItem to orderCartItems array in
          OnlineOrderSchema.onlineOrders where onlineOrderId
          matches"
      }
      on command PersistItemRemovedFromCart is {
        do "remove CartItem with removedCartItemId from
          orderCartItems array in OnlineOrderSchema
          .onlineOrders where onlineOrderId matches"
      }
      on command PersistFulfillmentSelected is {
        do "update OnlineOrderSchema.onlineOrders set
          selectedFulfillment = fulfillmentType,
          selectedDeliveryAddress = deliveryAddress where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderSubmitted is {
        do "update OnlineOrderSchema.onlineOrders set
          actualOnlineSubmittedAt = onlineSubmittedAt where
          onlineOrderId matches"
      }
      on command PersistOnlinePaymentProcessed is {
        do "update OnlineOrderSchema.onlineOrders set
          processedOnlinePayment = onlinePayment where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderInPreparation is {
        do "update OnlineOrderSchema.onlineOrders where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderReadyForPickup is {
        do "update OnlineOrderSchema.onlineOrders where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderOutForDelivery is {
        do "update OnlineOrderSchema.onlineOrders where
          onlineOrderId matches"
      }
      on command PersistOnlineOrderCompleted is {
        do "update OnlineOrderSchema.onlineOrders set
          completedAt = completedAt where onlineOrderId
          matches"
      }
      on command PersistOnlineOrderCancelled is {
        do "update OnlineOrderSchema.onlineOrders set
          cancelledAt = cancelledAt, cancellationReason =
          cancellationReason where onlineOrderId matches"
      }
    } with {
      briefly "Online order persistence"
      described as {
        |Persists online order events to the onlineOrders table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Online order repository"
    described as {
      |Stores and retrieves online order data.
    }
  }
  saga OnlineOrderCheckout is {
    step StepSubmitOrder is  {
      do "Close the cart and commit the order the guest assembled"
      tell command SubmitOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
    reverted by {
      do "Release the order so the cart is not left stranded as committed"
      tell command CancelOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
 with {
      briefly "Commit the cart"
      described as {
        |The first irreversible step from the guest's side: after it the cart
        |can no longer be edited. Compensating means cancelling outright,
        |because there is no state between "submitted" and "never happened".
      }
    }
    step StepTakePayment is  {
      do "Charge the card before any food is committed to"
      tell command ProcessOnlinePayment to entity OnlineOrdering.OnlineOrder
    }
    reverted by {
      do "Cancel the order, which is what releases the authorization"
      tell command CancelOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
 with {
      briefly "Take payment"
      described as {
        |Online orders are paid before they are cooked, the reverse of a
        |dine-in check. That ordering is what makes this saga worth having:
        |payment can fail after the order is committed, and something has to
        |put the order back.
      }
    }
    step StepStartPreparation is  {
      do "Release the paid order to the kitchen"
      tell command MarkOnlineInPreparation to entity OnlineOrdering.OnlineOrder
    }
    reverted by {
      do "Cancel the order; food already started is waste the restaurant eats"
      tell command CancelOnlineOrder to entity OnlineOrdering.OnlineOrder
    }
 with {
      briefly "Start preparation"
      described as {
        |The last step, and the only one whose compensation costs real money —
        |reverting after the kitchen has fired wastes food already cooked.
        |That asymmetry is why payment is taken first.
      }
    }
  } with {
    briefly "Online order checkout"
    described as {
      |Commit, pay, and release to the kitchen, with each step able to put the
      |order back if a later one fails.
      |
      |Every step tells a command to this context's OWN aggregate. Calling the
      |payment gateway is deliberately NOT a step's `tell`: that is an
      |external system reached through an adaptor, and naming it here would
      |cross a context boundary and bypass the anti-corruption layer.
    }
  }
  processor OnlineOrderEventSource as source is {
    outlet SubmittedOnlineOrderEvents is type OnlineOrderEvent
    handler OnlineOrderEventEmitter is {
      on other is {
        error "Unexpected message for source OnlineOrderEventSource"
      }
      on onlineOrderSubmitted: event OnlineOrder.OnlineOrderSubmitted is {
        send onlineOrderSubmitted to outlet SubmittedOnlineOrderEvents
      }
    } with {
      briefly "Online order event emitter"
      described as {
        |Emits online order submission events into the
        |streaming topology for kitchen routing.
      }
    }
  } with {
    briefly "Online order event source"
    described as {
      |Emits online order submission events from the
      |OnlineOrder entity into the streaming topology for
      |kitchen routing.
    }
  }
  processor OnlineOrderPipeline as split is {
    inlet SubmittedOnlineOrders is type OnlineOrderEvent    outlet KitchenOrders is type KitchenTicketEvent
    outlet DeliveryFulfillments is type DeliveryEvent
    handler OnlineOrderPipelineHandler is {
      on onlineOrderSubmitted: event OnlineOrder.OnlineOrderSubmitted is {
        do "convert online order cart items to kitchen ticket
          format and forward to kitchen queue"
        send onlineOrderSubmitted to outlet KitchenOrders
      }
      on fulfillmentSelected: event OnlineOrder.FulfillmentSelected is {
        send fulfillmentSelected to outlet DeliveryFulfillments
        tell event OnlineOrder.DeliveryRouted to entity OnlineOrdering.OnlineOrder
      }
    } with {
      briefly "Online order pipeline handler"
      described as {
        |Converts online orders to kitchen tickets and
        |merges with dine-in orders for unified processing.
      }
    }
  } with {
    briefly "Online order pipeline"
    described as {
      |Processes submitted online orders in FIFO order,
      |converting cart items to kitchen tickets. Ensures
      |online orders are queued fairly alongside dine-in
      |orders during peak hours.
    }
  }
  adaptor ToKitchen to context Restaurant.Kitchen is { 
    handler OnlineKitchenRouting is {
      on event OnlineOrder.OnlineOrderSubmitted is {
        do "map each OnlineOrderSubmitted.orderCartItems CartItem
          to TicketItem with ticketMenuItemId = cartMenuItemId,
          ticketItemName = cartItemName, ticketItemQuantity =
          cartItemQuantity, ticketItemNotes = cartItemNotes,
          ticketItemReady = false"
        do "construct ReceiveTicket with new KitchenTicketId,
          sourceOrderId = event.onlineOrderId, ticketSource =
          Online, ticketItems = mapped list, receivedAt =
          current timestamp"
        tell command ReceiveTicket to entity Kitchen.KitchenTicket
        tell event OnlineOrder.OnlineTicketRouted to entity OnlineOrdering.OnlineOrder
      }
      on other is {
        error "Unexpected message for adaptor ToKitchen"
      }
    } with {
      briefly "Kitchen routing"
      described as {
        |Routes online orders to the kitchen.
      }
    }
  } with {
    briefly "Kitchen adaptor"
    described as {
      |Sends submitted online orders to kitchen.
    }
  }
  adaptor ToLoyalty to context Restaurant.Loyalty is { 
    handler OnlineLoyaltyRouting is {
      on event OnlineOrder.OnlinePaymentProcessed is {
        let pointsEarned = "OnlinePaymentProcessed.onlinePayment
          .onlinePaymentAmount truncated to integer as
          accrualPoints"
        do "construct AccruePoints with loyaltyAccountId looked
          up by event.customerId, accrualPoints = pointsEarned,
          accrualReason = online purchase, accrualOrderRef =
          OnlinePaymentProcessed.onlineOrderId"
        tell command AccruePoints to entity Loyalty.LoyaltyAccount
        tell event OnlineOrder.OnlinePointsAccrualRouted to entity OnlineOrdering.OnlineOrder
      }
      on other is {
        error "Unexpected message for adaptor ToLoyalty"
      }
    } with {
      briefly "Loyalty routing"
      described as {
        |Routes payment events for loyalty accrual.
      }
    }
  } with {
    briefly "Loyalty adaptor"
    described as {
      |Sends online payment events to loyalty context.
    }
  }
  processor DeliveryEventSink as sink is {
    inlet IncomingDeliveryEvents is type DeliveryEvent    handler DeliveryEventIntake is {
      on event Restaurant.Delivery.DeliveryOrder.DriverDispatched is {
        tell command OnlineOrder.MarkOutForDelivery to entity OnlineOrdering.OnlineOrder
        do "update online order status to out for delivery"
      }
      on event Restaurant.Delivery.DeliveryOrder.DeliveryConfirmed is {
        tell command OnlineOrder.CompleteOnlineOrder to entity OnlineOrdering.OnlineOrder
        do "complete online order upon delivery confirmation"
      }
      on event Restaurant.Delivery.DeliveryOrder.DeliveryMarkedFailed is {
        tell command OnlineOrder.CancelOnlineOrder to entity OnlineOrdering.OnlineOrder
        do "cancel online order upon delivery failure"
      }
    } with {
      briefly "Delivery event intake"
      described as {
        |Processes incoming delivery events for delivery
        |status updates on online orders.
      }
    }
  } with {
    briefly "Delivery event sink"
    described as {
      |Receives delivery events from the streaming topology
      |for delivery status updates to online orders.
    }
  }
  connector OnlineSourceToPipeline is from outlet OnlineOrdering.OnlineOrderEventSource.SubmittedOnlineOrderEvents to inlet OnlineOrdering.OnlineOrderPipeline.SubmittedOnlineOrders with {
    briefly "Source to pipeline connector"
    described as {
      |Wires online order events from the source into the
      |order pipeline for kitchen routing.
    }
  }
  connector 'OnlineOrderEvent Storage' is from outlet OnlineOrdering.OnlineOrder.OnlineOrderEvents to inlet OnlineOrdering.OnlineOrderRepository.OnlineOrderRepositoryFromOnlineOrder with {
    briefly "OnlineOrder events on their way to storage"
  }
} with {
  briefly "Online ordering context"
  described as {
    | Manages the online ordering experience including menu
    | browsing, cart management, fulfillment selection, and
    | checkout. Decoupled from delivery context so electronic
    | menus can be developed independently. Communicates with
    | kitchen, delivery, and loyalty via adaptors.
  }
}
