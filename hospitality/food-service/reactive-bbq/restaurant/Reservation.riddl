// Reservation entity for the Front of House context
event-sourced entity Reservation as flow is {
  type ReservationCommand is one of {
    Reservation.MakeReservation or Reservation.ConfirmReservation or Reservation.CancelReservation or Reservation.SeatParty or Reservation.CompleteVisit or Reservation.MarkNoShow or Reservation.RescheduleReservation
  } with {
    briefly "Reservation command alternation"
    described as {
      |Commands accepted by the Reservation entity.
    }
  }
  inlet ReservationCommands is type ReservationCommand  outlet ReservationEvents2 is type ReservationEvent
  // ---- Commands ----
  command MakeReservation yields event ReservationMade is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Identifier for the new reservation.
      }
    }
    guestName: GuestName with {
      term WalkIn is  "A party arriving with no booking, seated against whatever capacity the reservation book has not committed. The restaurant knows nothing about them beyond what it is told at the door." 
      briefly "Guest"
      described as {
        |The name the booking is held under, used to call the party when
        |their table is ready. Not a customer account name -- walk-in and
        |phone bookings have no account at all.
      }
    }
    guestPhone: GuestPhone with {
      briefly "Phone"
      described as {
        |Contact phone for the guest.
      }
    }
    partySize: PartySize with {
      briefly "Party size"
      described as {
        |Number of guests.
      }
    }
    reservationTime: TimeStamp with {
      briefly "Time"
      described as {
        |Requested reservation date and time.
      }
    }
  } with {
    briefly "Make reservation"
    described as {
      |Request a new reservation.
    }
  }
  command ConfirmReservation yields event ReservationConfirmed is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Reservation to confirm.
      }
    }
    confirmedTable: TableNumber with {
      briefly "Table"
      described as {
        |Table assigned for this reservation.
      }
    }
  } with {
    briefly "Confirm reservation"
    described as {
      |Confirm a pending reservation with a table assignment.
    }
  }
  command CancelReservation yields event ReservationCancelled is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Reservation to cancel.
      }
    }
    cancellationReason: String(1,500)? with {
      briefly "Reason"
      described as {
        |Why the booking ended early. Distinguishes a guest cancelling from
        |the restaurant cancelling (a closure, an overbooking), which
        |decides whether the table is released for walk-ins immediately.
      }
    }
  } with {
    briefly "Cancel reservation"
    described as {
      |Cancel an existing reservation.
    }
  }
  command SeatParty yields event PartySeated is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Reservation for the party being seated.
      }
    }
    seatedTable: TableNumber with {
      briefly "Table"
      described as {
        |Table where the party is seated.
      }
    }
    seatedAt: TimeStamp with {
      briefly "Seated at"
      described as {
        |Time the party was seated.
      }
    }
  } with {
    briefly "Seat party"
    described as {
      |Mark a reservation as seated at a table.
    }
  }
  command CompleteVisit yields event VisitCompleted is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Reservation to complete.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the visit was completed.
      }
    }
  } with {
    briefly "Complete visit"
    described as {
      |Mark the reservation as completed after the party
      |has finished dining.
    }
  }
  command MarkNoShow yields event NoShowMarked is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Reservation to mark as no-show.
      }
    }
    markedNoShowAt: TimeStamp with {
      briefly "Marked at"
      described as {
        |When the no-show was recorded.
      }
    }
  } with {
    term NoShow is  "A confirmed booking whose party never arrives. The table is held past the reservation time, then released — so a no-show costs a turn that a cancellation would not have." 
    term Turn is  "One full cycle of a table from seating a party to closing its check. How many turns a table completes in a service period bounds what the room can take, whatever its seat count." 
    briefly "Mark no-show"
    described as {
      |Mark a confirmed reservation as a no-show when
      |the party does not arrive.
    }
  }
  command RescheduleReservation yields event ReservationRescheduled is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Reservation to reschedule.
      }
    }
    newReservationTime: TimeStamp with {
      briefly "New time"
      described as {
        |New requested reservation date and time.
      }
    }
  } with {
    briefly "Reschedule reservation"
    described as {
      |Reschedule a confirmed reservation to a new time.
      |Returns the reservation to the Requested state
      |with the updated time.
    }
  }
  // ---- Events ----
  event ReservationMade is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking just created. Every later event in this reservation's
        |life carries the same value, so the whole visit can be assembled
        |from the event log.
      }
    }
    guestName: GuestName with {
      briefly "Guest"
      described as {
        |The name the booking is held under, as given when it was made.
      }
    }
    guestPhone: GuestPhone with {
      briefly "Phone"
      described as {
        |How to reach the party if the table runs late or the booking must
        |be moved. The only contact the restaurant holds for a walk-in.
      }
    }
    partySize: PartySize with {
      briefly "Party size"
      described as {
        |Number of guests.
      }
    }
    reservationTime: TimeStamp with {
      briefly "Time"
      described as {
        |Reservation date and time.
      }
    }
    madeAt: TimeStamp with {
      briefly "Made at"
      described as {
        |When the reservation was made.
      }
    }
  } with {
    briefly "Reservation made"
    described as {
      |Emitted when a new reservation is requested.
    }
  }
  event ReservationConfirmed is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking now confirmed. Confirmation is what moves a request
        |into the seatable set the host stand works from.
      }
    }
    confirmedTable: TableNumber with {
      briefly "Table"
      described as {
        |Assigned table.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed at"
      described as {
        |When the reservation was confirmed.
      }
    }
  } with {
    briefly "Reservation confirmed"
    described as {
      |Emitted when a reservation is confirmed.
    }
  }
  event ReservationCancelled is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking that was cancelled.
      }
    }
    cancellationReason: String(1,500)? with {
      briefly "Reason"
      described as {
        |Why it was cancelled, carried forward so reporting can separate
        |guest-initiated cancellations from restaurant-initiated ones.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled at"
      described as {
        |When the reservation was cancelled.
      }
    }
  } with {
    briefly "Reservation cancelled"
    described as {
      |Emitted when a reservation is cancelled.
    }
  }
  event PartySeated is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking whose party has now been seated. Seating starts the
        |table's dwell clock, which turnover reporting measures.
      }
    }
    seatedTable: TableNumber with {
      briefly "Table"
      described as {
        |Table where party was seated.
      }
    }
    seatedAt: TimeStamp with {
      briefly "Seated at"
      described as {
        |When the party was seated.
      }
    }
  } with {
    briefly "Party seated"
    described as {
      |Emitted when a party is seated at their table.
    }
  }
  event VisitCompleted is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking whose visit has ended. Completion frees the table and
        |closes the dwell measurement started at seating.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the visit was completed.
      }
    }
  } with {
    briefly "Visit completed"
    described as {
      |Emitted when the party finishes dining and the
      |reservation is complete.
    }
  }
  event NoShowMarked is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking whose party never arrived. No-shows are counted
        |separately from cancellations because they cost the restaurant a
        |table that was held empty.
      }
    }
    markedNoShowAt: TimeStamp with {
      briefly "Marked at"
      described as {
        |When the no-show was recorded.
      }
    }
  } with {
    briefly "No-show marked"
    described as {
      |Emitted when a confirmed reservation is marked as a
      |no-show.
    }
  }
  event ReservationRescheduled is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking that was moved.
      }
    }
    previousTime: TimeStamp with {
      briefly "Previous time"
      described as {
        |The original reservation time.
      }
    }
    newReservationTime: TimeStamp with {
      briefly "New time"
      described as {
        |The time the party is now expected. Replaces the original time as
        |the clock for lateness, and re-sorts the reservation board.
      }
    }
    rescheduledAt: TimeStamp with {
      briefly "Rescheduled at"
      described as {
        |When the reschedule occurred.
      }
    }
  } with {
    briefly "Reservation rescheduled"
    described as {
      |Emitted when a reservation is rescheduled to a new
      |time. The reservation returns to the Requested state.
    }
  }
  // ---- Rejection Events ----
  event MakeReservationRejected is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking the request would have created. Present so a caller
        |can correlate the refusal with what it asked for.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Make reservation rejected"
    described as {
      |Emitted when a MakeReservation command is rejected.
    }
  }
  event ConfirmReservationRejected is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking that could not be confirmed.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Confirm reservation rejected"
    described as {
      |Emitted when a ConfirmReservation command is rejected.
    }
  }
  event CancelReservationRejected is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking that could not be cancelled -- typically because the
        |visit had already started.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Cancel reservation rejected"
    described as {
      |Emitted when a CancelReservation command is rejected.
    }
  }
  event SeatPartyRejected is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking that could not be seated, usually because no table of
        |the right size was free.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Seat party rejected"
    described as {
      |Emitted when a SeatParty command is rejected.
    }
  }
  event CompleteVisitRejected is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking whose visit could not be completed.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Complete visit rejected"
    described as {
      |Emitted when a CompleteVisit command is rejected.
    }
  }
  event MarkNoShowRejected is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking that could not be marked a no-show, typically because
        |the party had in fact been seated.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Mark no-show rejected"
    described as {
      |Emitted when a MarkNoShow command is rejected.
    }
  }
  event RescheduleReservationRejected is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking that could not be moved.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the command was rejected.
      }
    }
  } with {
    briefly "Reschedule reservation rejected"
    described as {
      |Emitted when a RescheduleReservation command is rejected.
    }
  }
  // ---- Query/Result ----
  query GetReservation is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |Reservation to retrieve.
      }
    }
  } with {
    briefly "Get reservation"
    described as {
      |Query a reservation by its identifier.
    }
  }
  result ReservationResult is  {
    reservation: ReservationBase with {
      briefly "Reservation"
      described as {
        |The requested reservation data.
      }
    }
  } with {
    briefly "Reservation result"
    described as {
      |Result containing the requested reservation data.
    }
  }
  // ---- State ----
  record ReservationBase is  {
    reservationId: ReservationId with {
      briefly "ID"
      described as {
        |The booking these fields describe. Shared by every reservation
        |state record so the identity survives each transition.
      }
    }
    guestName: GuestName with {
      briefly "Guest"
      described as {
        |The name the booking is held under.
      }
    }
    guestPhone: GuestPhone with {
      briefly "Phone"
      described as {
        |How to reach the party about this booking.
      }
    }
    partySize: PartySize with {
      briefly "Party size"
      described as {
        |Number of guests.
      }
    }
    reservationTime: TimeStamp with {
      briefly "Time"
      described as {
        |Reservation date and time.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the reservation was created.
      }
    }
  } with {
    briefly "Reservation base data"
    described as {
      |Common fields shared by all reservation states.
    }
  }
  record RequestedData is  {
    base: ReservationBase with {
      briefly "Base"
      described as {
        |Common reservation fields.
      }
    }
  } with {
    briefly "Requested state data"
    described as {
      |State data for a newly requested reservation
      |awaiting confirmation.
    }
  }
  record ConfirmedData is  {
    base: ReservationBase with {
      briefly "Base"
      described as {
        |Common reservation fields.
      }
    }
    assignedTable: TableNumber with {
      briefly "Table"
      described as {
        |Table assigned for this reservation.
      }
    }
    confirmedAt: TimeStamp with {
      briefly "Confirmed at"
      described as {
        |When the reservation was confirmed.
      }
    }
  } with {
    briefly "Confirmed state data"
    described as {
      |State data for a confirmed reservation with table
      |assignment, awaiting the party arrival.
    }
  }
  record SeatedData is  {
    base: ReservationBase with {
      briefly "Base"
      described as {
        |Common reservation fields.
      }
    }
    assignedTable: TableNumber with {
      briefly "Table"
      described as {
        |Table where the party is seated.
      }
    }
    seatedAt: TimeStamp with {
      briefly "Seated at"
      described as {
        |When the party was seated.
      }
    }
  } with {
    briefly "Seated state data"
    described as {
      |State data for a reservation where the party has
      |been seated at their table.
    }
  }
  record CompletedData is  {
    base: ReservationBase with {
      briefly "Base"
      described as {
        |Common reservation fields.
      }
    }
    assignedTable: TableNumber with {
      briefly "Table"
      described as {
        |Table where the party dined.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the visit was completed.
      }
    }
  } with {
    briefly "Completed state data"
    described as {
      |State data for a completed reservation where the
      |party has finished dining.
    }
  }
  record CancelledData is  {
    base: ReservationBase with {
      briefly "Base"
      described as {
        |Common reservation fields.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled at"
      described as {
        |When the reservation was cancelled.
      }
    }
    cancellationReason: String(1,500)? with {
      briefly "Reason"
      described as {
        |Why the booking ended early, retained on the cancelled state so
        |the reason survives for reporting after the table is released.
      }
    }
  } with {
    briefly "Cancelled state data"
    described as {
      |State data for a cancelled reservation.
    }
  }
  record NoShowData is  {
    base: ReservationBase with {
      briefly "Base"
      described as {
        |Common reservation fields.
      }
    }
    markedNoShowAt: TimeStamp with {
      briefly "Marked at"
      described as {
        |When the no-show was recorded.
      }
    }
  } with {
    briefly "No-show state data"
    described as {
      |State data for a reservation where the party did
      |not arrive.
    }
  }
  initial state Requested of record Reservation.RequestedData is {
    initial handler RequestedInitHandler is {
      on init is {
        yield event ReservationMade
      }
    } with {
      briefly "Requested init handler"
      described as {
        |Initializes the Requested state from the
        |ReservationMade event.
      }
    }
    handler RequestedHandler is {
      on confirmReservation: command ConfirmReservation is {
        yield event ReservationConfirmed(reservationId = confirmReservation.reservationId, confirmedTable = confirmReservation.confirmedTable)
        send event ReservationConfirmed(reservationId = confirmReservation.reservationId, confirmedTable = confirmReservation.confirmedTable) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on event ReservationConfirmed is {
        morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.Confirmed with record Reservation.ConfirmedData
        set state Confirmed to "base from prior state, assignedTable = ReservationConfirmed.confirmedTable, confirmedAt = ReservationConfirmed.confirmedAt"
      }
      on cancelReservation: command CancelReservation is {
        yield event ReservationCancelled(reservationId = cancelReservation.reservationId, cancellationReason = cancelReservation.cancellationReason)
        send event ReservationCancelled(reservationId = cancelReservation.reservationId, cancellationReason = cancelReservation.cancellationReason) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on event ReservationCancelled is {
        morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.Cancelled with record Reservation.CancelledData
        set state Reservation.Cancelled to "base from prior state, cancelledAt = ReservationCancelled.cancelledAt, cancellationReason = ReservationCancelled.cancellationReason"
      }
      on makeReservation: command MakeReservation is {
        error "Reservation does not accept MakeReservation in this state"
        send event MakeReservationRejected(reservationId = makeReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on seatParty: command SeatParty is {
        error "Reservation does not accept SeatParty in this state"
        send event SeatPartyRejected(reservationId = seatParty.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on completeVisit: command CompleteVisit is {
        error "Reservation does not accept CompleteVisit in this state"
        send event CompleteVisitRejected(reservationId = completeVisit.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on markNoShow: command MarkNoShow is {
        error "Reservation does not accept MarkNoShow in this state"
        send event MarkNoShowRejected(reservationId = markNoShow.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on rescheduleReservation: command RescheduleReservation is {
        error "Reservation does not accept RescheduleReservation in this state"
        send event RescheduleReservationRejected(reservationId = rescheduleReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
    } with {
      briefly "Requested state handler"
      described as {
        |Handles commands valid in the Requested state.
        |ConfirmReservation and CancelReservation advance
        |the lifecycle.
      }
    }
  } with {
    briefly "Reservation requested"
    described as {
      |Initial state after a reservation is made.
      |Awaiting confirmation with table assignment.
    }
  }
  state Confirmed of record Reservation.ConfirmedData is {
    initial handler ConfirmedInitHandler is {
      on init is {
        yield event ReservationConfirmed
      }
    } with {
      briefly "Confirmed init handler"
      described as {
        |Initializes the Confirmed state from the
        |ReservationConfirmed event.
      }
    }
    handler ConfirmedHandler is {
      on seatParty: command SeatParty is {
        yield event PartySeated(reservationId = seatParty.reservationId, seatedTable = seatParty.seatedTable, seatedAt = seatParty.seatedAt)
        send event PartySeated(reservationId = seatParty.reservationId, seatedTable = seatParty.seatedTable, seatedAt = seatParty.seatedAt) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on event PartySeated is {
        morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.Seated with record Reservation.SeatedData
        do "construct CreateOrder with new TableOrderId,
          tableNumber = PartySeated.seatedTable, serverId from
          host assignment"
        tell command CreateOrder to entity FrontOfHouse.TableOrder
        set state Seated to "base from prior state, assignedTable from prior state, seatedAt = PartySeated.seatedAt"
      }
      on cancelReservation: command CancelReservation is {
        yield event ReservationCancelled(reservationId = cancelReservation.reservationId, cancellationReason = cancelReservation.cancellationReason)
        send event ReservationCancelled(reservationId = cancelReservation.reservationId, cancellationReason = cancelReservation.cancellationReason) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on event ReservationCancelled is {
        morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.Cancelled with record Reservation.CancelledData
      }
      on markNoShow: command MarkNoShow is {
        yield event NoShowMarked(reservationId = markNoShow.reservationId, markedNoShowAt = markNoShow.markedNoShowAt)
        send event NoShowMarked(reservationId = markNoShow.reservationId, markedNoShowAt = markNoShow.markedNoShowAt) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on event NoShowMarked is {
        morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.NoShow with record Reservation.NoShowData
        set state NoShow to "base from prior state, markedNoShowAt = NoShowMarked.markedNoShowAt"
      }
      on rescheduleReservation: command RescheduleReservation is {
        yield event ReservationRescheduled(reservationId = rescheduleReservation.reservationId, newReservationTime = rescheduleReservation.newReservationTime)
        send event ReservationRescheduled(reservationId = rescheduleReservation.reservationId, newReservationTime = rescheduleReservation.newReservationTime) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on event ReservationRescheduled is {
        morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.Requested with record Reservation.RequestedData
        set field Reservation.Requested.base to "copy base with reservationTime =
          ReservationRescheduled.newReservationTime"
      }
      on makeReservation: command MakeReservation is {
        error "Reservation does not accept MakeReservation in this state"
        send event MakeReservationRejected(reservationId = makeReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on confirmReservation: command ConfirmReservation is {
        error "Reservation does not accept ConfirmReservation in this state"
        send event ConfirmReservationRejected(reservationId = confirmReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on completeVisit: command CompleteVisit is {
        error "Reservation does not accept CompleteVisit in this state"
        send event CompleteVisitRejected(reservationId = completeVisit.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
    } with {
      briefly "Confirmed state handler"
      described as {
        |Handles commands valid in the Confirmed state.
        |SeatParty, CancelReservation, MarkNoShow, and
        |RescheduleReservation are all valid transitions.
      }
    }
  } with {
    briefly "Reservation confirmed"
    described as {
      |Reservation has been confirmed with a table
      |assignment. Awaiting the party's arrival.
    }
  }
  state Seated of record Reservation.SeatedData is {
    initial handler SeatedInitHandler is {
      on init is {
        yield event PartySeated
      }
    } with {
      briefly "Seated init handler"
      described as {
        |Initializes the Seated state from the
        |PartySeated event.
      }
    }
    handler SeatedHandler is {
      on completeVisit: command CompleteVisit is {
        yield event VisitCompleted(reservationId = completeVisit.reservationId, completedAt = completeVisit.completedAt)
        send event VisitCompleted(reservationId = completeVisit.reservationId, completedAt = completeVisit.completedAt) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on event VisitCompleted is {
        morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.Completed with record Reservation.CompletedData
        set state Reservation.Completed to "base from prior state, assignedTable from prior state, completedAt = VisitCompleted.completedAt"
      }
      on makeReservation: command MakeReservation is {
        error "Reservation does not accept MakeReservation in this state"
        send event MakeReservationRejected(reservationId = makeReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on confirmReservation: command ConfirmReservation is {
        error "Reservation does not accept ConfirmReservation in this state"
        send event ConfirmReservationRejected(reservationId = confirmReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on cancelReservation: command CancelReservation is {
        error "Reservation does not accept CancelReservation in this state"
        send event CancelReservationRejected(reservationId = cancelReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on seatParty: command SeatParty is {
        error "Reservation does not accept SeatParty in this state"
        send event SeatPartyRejected(reservationId = seatParty.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on markNoShow: command MarkNoShow is {
        error "Reservation does not accept MarkNoShow in this state"
        send event MarkNoShowRejected(reservationId = markNoShow.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on rescheduleReservation: command RescheduleReservation is {
        error "Reservation does not accept RescheduleReservation in this state"
        send event RescheduleReservationRejected(reservationId = rescheduleReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
    } with {
      briefly "Seated state handler"
      described as {
        |Handles commands valid in the Seated state.
        |Only CompleteVisit advances the lifecycle.
      }
    }
  } with {
    briefly "Party seated"
    described as {
      |Party has arrived and been seated at their table.
      |A table order has been created.
    }
  }
  state Completed of record Reservation.CompletedData is {
    initial handler CompletedInitHandler is {
      on init is {
        yield event VisitCompleted
      }
    } with {
      briefly "Completed init handler"
      described as {
        |Initializes the Completed state from the
        |VisitCompleted event.
      }
    }
    handler CompletedHandler is {
      on makeReservation: command MakeReservation is {
        error "Reservation does not accept MakeReservation in this state"
        send event MakeReservationRejected(reservationId = makeReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on confirmReservation: command ConfirmReservation is {
        error "Reservation does not accept ConfirmReservation in this state"
        send event ConfirmReservationRejected(reservationId = confirmReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on cancelReservation: command CancelReservation is {
        error "Reservation does not accept CancelReservation in this state"
        send event CancelReservationRejected(reservationId = cancelReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on seatParty: command SeatParty is {
        error "Reservation does not accept SeatParty in this state"
        send event SeatPartyRejected(reservationId = seatParty.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on completeVisit: command CompleteVisit is {
        error "Reservation does not accept CompleteVisit in this state"
        send event CompleteVisitRejected(reservationId = completeVisit.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on markNoShow: command MarkNoShow is {
        error "Reservation does not accept MarkNoShow in this state"
        send event MarkNoShowRejected(reservationId = markNoShow.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on rescheduleReservation: command RescheduleReservation is {
        error "Reservation does not accept RescheduleReservation in this state"
        send event RescheduleReservationRejected(reservationId = rescheduleReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
    } with {
      briefly "Completed state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Visit completed"
    described as {
      |Party has finished dining. Terminal state.
    }
  }
  state Cancelled of record Reservation.CancelledData is {
    initial handler CancelledInitHandler is {
      on init is {
        yield event ReservationCancelled
      }
    } with {
      briefly "Cancelled init handler"
      described as {
        |Initializes the Cancelled state from the
        |ReservationCancelled event.
      }
    }
    handler CancelledHandler is {
      on makeReservation: command MakeReservation is {
        error "Reservation does not accept MakeReservation in this state"
        send event MakeReservationRejected(reservationId = makeReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on confirmReservation: command ConfirmReservation is {
        error "Reservation does not accept ConfirmReservation in this state"
        send event ConfirmReservationRejected(reservationId = confirmReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on cancelReservation: command CancelReservation is {
        error "Reservation does not accept CancelReservation in this state"
        send event CancelReservationRejected(reservationId = cancelReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on seatParty: command SeatParty is {
        error "Reservation does not accept SeatParty in this state"
        send event SeatPartyRejected(reservationId = seatParty.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on completeVisit: command CompleteVisit is {
        error "Reservation does not accept CompleteVisit in this state"
        send event CompleteVisitRejected(reservationId = completeVisit.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on markNoShow: command MarkNoShow is {
        error "Reservation does not accept MarkNoShow in this state"
        send event MarkNoShowRejected(reservationId = markNoShow.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on rescheduleReservation: command RescheduleReservation is {
        error "Reservation does not accept RescheduleReservation in this state"
        send event RescheduleReservationRejected(reservationId = rescheduleReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
    } with {
      briefly "Cancelled state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Reservation cancelled"
    described as {
      |Reservation has been cancelled. Terminal state.
    }
  }
  state NoShow of record Reservation.NoShowData is {
    initial handler NoShowInitHandler is {
      on init is {
        yield event NoShowMarked
      }
    } with {
      briefly "NoShow init handler"
      described as {
        |Initializes the NoShow state from the
        |NoShowMarked event.
      }
    }
    handler NoShowHandler is {
      on makeReservation: command MakeReservation is {
        error "Reservation does not accept MakeReservation in this state"
        send event MakeReservationRejected(reservationId = makeReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on confirmReservation: command ConfirmReservation is {
        error "Reservation does not accept ConfirmReservation in this state"
        send event ConfirmReservationRejected(reservationId = confirmReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on cancelReservation: command CancelReservation is {
        error "Reservation does not accept CancelReservation in this state"
        send event CancelReservationRejected(reservationId = cancelReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on seatParty: command SeatParty is {
        error "Reservation does not accept SeatParty in this state"
        send event SeatPartyRejected(reservationId = seatParty.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on completeVisit: command CompleteVisit is {
        error "Reservation does not accept CompleteVisit in this state"
        send event CompleteVisitRejected(reservationId = completeVisit.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on markNoShow: command MarkNoShow is {
        error "Reservation does not accept MarkNoShow in this state"
        send event MarkNoShowRejected(reservationId = markNoShow.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
      on rescheduleReservation: command RescheduleReservation is {
        error "Reservation does not accept RescheduleReservation in this state"
        send event RescheduleReservationRejected(reservationId = rescheduleReservation.reservationId) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
      }
    } with {
      briefly "NoShow state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "No-show"
    described as {
      |Party did not arrive for their confirmed
      |reservation. Terminal state.
    }
  }
  handler ReservationCreationHandler is {
    on makeReservation: command MakeReservation is {
      do "validate MakeReservation.partySize is between 1 and 20"
      do "validate MakeReservation.reservationTime is in the
        future and within the 30-day booking window"
      do "query ReservationRepository for conflicting
        reservations at MakeReservation.reservationTime with
        sufficient table capacity for MakeReservation.partySize"
      yield event ReservationMade(reservationId = makeReservation.reservationId, guestName = makeReservation.guestName, guestPhone = makeReservation.guestPhone, partySize = makeReservation.partySize, reservationTime = makeReservation.reservationTime)
      send event ReservationMade(reservationId = makeReservation.reservationId, guestName = makeReservation.guestName, guestPhone = makeReservation.guestPhone, partySize = makeReservation.partySize, reservationTime = makeReservation.reservationTime) to outlet FrontOfHouse.ReservationEventSource.ReservationEvents
    }
    on event ReservationMade is {
      morph entity FrontOfHouse.Reservation to state FrontOfHouse.Reservation.Requested with record Reservation.RequestedData
      set state Requested to "base = ReservationBase(ReservationMade.reservationId, ReservationMade.guestName, ReservationMade.guestPhone, ReservationMade.partySize, ReservationMade.reservationTime, ReservationMade.madeAt)"
    }
    on query GetReservation is {
      do "look up Reservation by GetReservation.reservationId"
      tell result ReservationResult to entity FrontOfHouse.Reservation
    }
  } with {
    briefly "Reservation creation handler"
    described as {
      |Handles the initial MakeReservation command when
      |the entity has no state yet. Validates party size,
      |reservation time, and table availability.
    }
  }
} with {
  briefly "Reservation entity"
  described as {
    | Manages the lifecycle of a restaurant reservation
    | from request through confirmation, seating, or
    | cancellation. State handlers ensure commands are
    | only valid in appropriate states, and events are
    | persisted before state transitions.
  }
}
