// Kitchen shared types
type KitchenTicketId is Id(Kitchen.KitchenTicket)  with {
  briefly "Kitchen ticket identifier"
  described as {
    |Unique identifier for a kitchen ticket.
  }
}
type StationName is String(1,50) with {
  briefly "Station name"
  described as {
    |Name of the kitchen station such as grill, fryer, prep.
  }
}
type StationRouting is mapping from String to StationName with {
  briefly "Menu category to station"
  described as {
    |Which station cooks each menu category. A mapping and not a field on
    |the item, because the same dish moves between stations as a kitchen is
    |relaid or a station goes down — the routing is a property of THIS
    |kitchen on THIS night, not of the dish.
    |
    |Keyed on the corporate menu category rather than the item, so a new
    |item on an existing category is routed without anyone touching it.
  }
}
type DietaryFlags is set of String with {
  briefly "Dietary flags"
  described as {
    |Allergens and dietary restrictions attached to a ticket line — nuts,
    |shellfish, gluten, vegan.
    |
    |A SET, not a list: order is meaningless and a repeat carries no extra
    |warning. Saying "no nuts" twice is not twice as urgent, and a cook
    |scanning a ticket must see each flag exactly once.
  }
}
// TicketStatus enum removed — lifecycle phase is now modeled
// by distinct RIDDL states on the KitchenTicket entity:
// Received, Assigned, InPreparation, ItemsReady, Approved,
// ServerNotified
type TicketSource is any of {
  DineIn,
  Online
} with {
  briefly "Ticket source"
  described as {
    |Whether the ticket originated from dine-in or online.
  }
}
type KitchenTicketEvent is one of {
  Kitchen.KitchenTicket.TicketReceived or Kitchen.KitchenTicket.StationAssigned or Kitchen.KitchenTicket.PreparationStarted or Kitchen.KitchenTicket.ItemMarkedReady or Kitchen.KitchenTicket.TicketApproved or Kitchen.KitchenTicket.ServerNotified
} with {
  briefly "Kitchen ticket event alternation"
  described as {
    |Union of all kitchen ticket events for streaming and
    |event-sourced persistence.
  }
}
type TicketItem is {
  ticketMenuItemId: String(1,50) with {
    briefly "Menu item ID"
    described as {
      |Which menu item this line calls for. Ties the ticket back to the
      |corporate menu so the recipe, and the station that owns it, can be
      |looked up rather than restated on every ticket.
    }
  }
  ticketItemName: String(1,200) with {
    briefly "Item name"
    described as {
      |Name of the item to prepare.
    }
  }
  ticketItemQuantity: Natural with {
    briefly "Quantity"
    described as {
      |Number to prepare.
    }
  }
  ticketItemNotes: String(1,500)? with {
    briefly "Notes"
    described as {
      |Special preparation instructions.
    }
  }
  ticketItemReady: Boolean with {
    briefly "Ready"
    described as {
      |Whether this item has been marked ready.
    }
  }
  ticketItemDietary: DietaryFlags with {
    briefly "Dietary flags"
    described as {
      |Allergens and restrictions for this line. Carried per item, not per
      |ticket, because one table's order routinely mixes a nut allergy with
      |diners who have none, and a cook works the line in front of them.
    }
  }
} with {
  briefly "Ticket item"
  described as {
    |A single item on a kitchen ticket.
  }
}
