// Bar bounded context
context Bar as router is {
  inlet OrderToBarIn is type DrinkOrderEvent
  outlet OrderToBarOut is type DrinkOrderEvent
  inlet DrinkOrderCommandStreamIn is type DrinkOrderCommand
  outlet DrinkOrderCommandStreamOut is type DrinkOrderCommand
  inlet BarToFOHIn is type DrinkOrderEvent
  outlet BarToFOHOut is type DrinkOrderEvent
  inlet DrinkOrderResultStreamIn is type DrinkOrder.DrinkOrderResult
  outlet DrinkOrderResultStreamOut is type DrinkOrder.DrinkOrderResult
  handler BarBoundary is {
    on drinkOrderReceived: event Bar.DrinkOrder.DrinkOrderReceived is {
      send drinkOrderReceived to outlet Bar.OrderToBarOut
      send drinkOrderReceived to outlet Bar.BarToFOHOut
    }
    on drinkPrepared: event Bar.DrinkOrder.DrinkPrepared is {
      send drinkPrepared to outlet Bar.OrderToBarOut
      send drinkPrepared to outlet Bar.BarToFOHOut
    }
    on drinkMarkedReady: event Bar.DrinkOrder.DrinkMarkedReady is {
      send drinkMarkedReady to outlet Bar.OrderToBarOut
      send drinkMarkedReady to outlet Bar.BarToFOHOut
    }
    on serverNotifiedDrinksReady: event Bar.DrinkOrder.ServerNotifiedDrinksReady is {
      send serverNotifiedDrinksReady to outlet Bar.OrderToBarOut
      send serverNotifiedDrinksReady to outlet Bar.BarToFOHOut
    }
    on drinkOrderCompleted: event Bar.DrinkOrder.DrinkOrderCompleted is {
      send drinkOrderCompleted to outlet Bar.OrderToBarOut
      send drinkOrderCompleted to outlet Bar.BarToFOHOut
    }
    on receiveDrinkOrder: command DrinkOrder.ReceiveDrinkOrder is {
      send receiveDrinkOrder to outlet Bar.DrinkOrderCommandStreamOut
    }
    on prepareDrink: command DrinkOrder.PrepareDrink is {
      send prepareDrink to outlet Bar.DrinkOrderCommandStreamOut
    }
    on markDrinkReady: command DrinkOrder.MarkDrinkReady is {
      send markDrinkReady to outlet Bar.DrinkOrderCommandStreamOut
    }
    on notifyServerDrinksReady: command DrinkOrder.NotifyServerDrinksReady is {
      send notifyServerDrinksReady to outlet Bar.DrinkOrderCommandStreamOut
    }
    on completeDrinkOrder: command DrinkOrder.CompleteDrinkOrder is {
      send completeDrinkOrder to outlet Bar.DrinkOrderCommandStreamOut
    }
    on drinkOrderResult: result DrinkOrder.DrinkOrderResult is {
      send drinkOrderResult to outlet Bar.DrinkOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the Bar boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'OrderToBar Intake' is from outlet Bar.OrderToBarOut to inlet Bar.DrinkOrderQueue.IncomingDrinks
  connector 'DrinkOrderCommand Stream Intake' is from outlet Bar.DrinkOrderCommandStreamOut to inlet Bar.DrinkOrder.DrinkOrderCommands
  connector 'BarToFOH Egress' is from outlet Bar.DrinkOrderEventSource.DrinkOrderEvents to inlet Bar.BarToFOHIn
  connector 'DrinkOrderResult Stream Egress' is from outlet Bar.DrinkOrderRepository.DrinkOrderRepositoryResponses to inlet Bar.DrinkOrderResultStreamIn
  include "bar-types.riddl"
  include "DrinkOrder.riddl"
  repository DrinkOrderRepository as flow is {
    inlet DrinkOrderRepositoryFromDrinkOrder is type DrinkOrderEvent    outlet DrinkOrderRepositoryResponses is type DrinkOrder.DrinkOrderResult
    record StoredDrinkOrder is  {
      drinkOrderId: DrinkOrderId with {
        briefly "drinkOrderId"
        described as {
          |The drinkOrderId column of the stored drinkOrder row.
        }
      }
    } with {
      briefly "Stored drinkOrder row"
      described as {
        |The persistence shape of drinkOrder data as this repository stores it.
      }
    }
    schema DrinkOrderSchema is relational
      of drinkOrders as type StoredDrinkOrder
        index on field StoredDrinkOrder.drinkOrderId
 with {
      briefly "Drink order data schema"
      described as {
        |Relational schema for persisting drink order state
        |with index on order identifier.
      }
    }
    command PersistDrinkOrderReceived is  {
      drinkOrderId: DrinkOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DrinkOrderReceived"
      described as {
        |Instructs this repository to apply DrinkOrderReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDrinkPrepared is  {
      drinkOrderId: DrinkOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DrinkPrepared"
      described as {
        |Instructs this repository to apply DrinkPrepared to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDrinkMarkedReady is  {
      drinkOrderId: DrinkOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DrinkMarkedReady"
      described as {
        |Instructs this repository to apply DrinkMarkedReady to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServerNotifiedDrinksReady is  {
      drinkOrderId: DrinkOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ServerNotifiedDrinksReady"
      described as {
        |Instructs this repository to apply ServerNotifiedDrinksReady to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDrinkOrderCompleted is  {
      drinkOrderId: DrinkOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist DrinkOrderCompleted"
      described as {
        |Instructs this repository to apply DrinkOrderCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler DrinkOrderPersistence is {
      on command PersistDrinkOrderReceived is {
        do "insert row into DrinkOrderSchema.drinkOrders with
          drinkOrderId, sourceOrderId, drinkTableNumber,
          drinkItems, drinkReceivedAt"
      }
      on command PersistDrinkPrepared is {
        do "update DrinkOrderSchema.drinkOrders where
          drinkOrderId matches"
      }
      on command PersistDrinkMarkedReady is {
        do "update DrinkOrderSchema.drinkOrders set
          actualDrinkReadyAt = drinkReadyAt where
          drinkOrderId matches"
      }
      on command PersistServerNotifiedDrinksReady is {
        do "update DrinkOrderSchema.drinkOrders where
          drinkOrderId matches"
      }
      on command PersistDrinkOrderCompleted is {
        do "update DrinkOrderSchema.drinkOrders set
          actualDrinkCompletedAt = drinkCompletedAt where
          drinkOrderId matches"
      }
    } with {
      briefly "Drink order persistence"
      described as {
        |Persists drink order events to the drinkOrders table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Drink order repository"
    described as {
      |Stores and retrieves drink order data.
    }
  }
  processor DrinkOrderEventSource as source is {
    outlet DrinkOrderEvents is type DrinkOrderEvent
    handler DrinkOrderEventEmitter is {
      on other is {
        error "Unexpected message for source DrinkOrderEventSource"
      }
      on drinkOrderReceived: event DrinkOrder.DrinkOrderReceived is {
        send drinkOrderReceived to outlet DrinkOrderEvents
      }
      on drinkPrepared: event DrinkOrder.DrinkPrepared is {
        send drinkPrepared to outlet DrinkOrderEvents
      }
      on drinkMarkedReady: event DrinkOrder.DrinkMarkedReady is {
        send drinkMarkedReady to outlet DrinkOrderEvents
      }
      on serverNotifiedDrinksReady: event DrinkOrder.ServerNotifiedDrinksReady is {
        send serverNotifiedDrinksReady to outlet DrinkOrderEvents
      }
      on drinkOrderCompleted: event DrinkOrder.DrinkOrderCompleted is {
        send drinkOrderCompleted to outlet DrinkOrderEvents
      }
    } with {
      briefly "Drink order event emitter"
      described as {
        |Emits drink order lifecycle events.
      }
    }
  } with {
    briefly "Drink order event source"
    described as {
      |Publishes drink order entity events.
    }
  }
  processor DrinkOrderQueue as sink is {
    inlet IncomingDrinks is type DrinkOrderEvent    handler DrinkQueueHandler is {
      on drinkOrderReceived: event DrinkOrder.DrinkOrderReceived is {
        do "enqueue drink order for bartender preparation
          in FIFO sequence"
        tell command DrinkOrder.PrepareDrink(drinkOrderId = drinkOrderReceived.drinkOrderId, drinkPreparationStartedAt = prompt("the drink preparation started at of this prepare drink")) to entity Bar.DrinkOrder
      }
    } with {
      briefly "Drink queue handler"
      described as {
        |Enqueues incoming drink orders for preparation
        |in FIFO order with backpressure during peak hours.
      }
    }
  } with {
    briefly "Drink order queue"
    described as {
      |Receives incoming drink orders in FIFO order, ensuring
      |drinks are prepared in the sequence received. Provides
      |backpressure during peak bar hours.
    }
  }
  adaptor FromFrontOfHouse from context Restaurant.FrontOfHouse is { 
    handler DrinkIntake is {
      on event Restaurant.FrontOfHouse.TableOrder.OrderSubmitted is {
        do "filter event.orderItems where
          orderLineItem.itemCategory is drink"
        when prompt("filtered drink items list is not empty") then
          do "map each drink OrderLine to DrinkItem with
            drinkName = orderLineItem.itemName,
            drinkQuantity = orderLineQuantity,
            drinkNotes = orderLineNotes"
          do "construct ReceiveDrinkOrder with new DrinkOrderId,
            sourceOrderId = event.tableOrderId,
            drinkTableNumber = event.tableNumber,
            drinkItems = mapped list, drinkReceivedAt =
            current timestamp"
          let receiveDrinkOrder: type ReceiveDrinkOrder = prompt("the receive drink order that results from order submitted")
          tell receiveDrinkOrder to entity Bar.DrinkOrder
        end
      }
      on other is {
        error "Unexpected message for adaptor FromFrontOfHouse"
      }
    } with {
      briefly "Drink intake"
      described as {
        |Extracts drink items from table orders and creates
        |bar drink orders with table number for notification.
      }
    }
  } with {
    briefly "Front of house adaptor"
    described as {
      |Receives drink portions of submitted table orders.
    }
  }
  connector 'DrinkOrderEvent Storage' is from outlet Bar.DrinkOrder.DrinkOrderEvents2 to inlet Bar.DrinkOrderRepository.DrinkOrderRepositoryFromDrinkOrder with {
    briefly "DrinkOrder events on their way to storage"
  }
} with {
  briefly "Bar context"
  described as {
    | Manages drink order preparation and server notification.
    | Push notifications when drinks are ready solve the
    | melting-ice problem caused by communication gaps
    | between bartenders and servers.
  }
}
