// Kitchen bounded context
context Kitchen is {
  include "kitchen-types.riddl"
  include "KitchenTicket.riddl"
  repository KitchenTicketRepository is {
    inlet KitchenTicketRepositoryFromKitchenTicket is type KitchenTicketEvent    inlet KitchenTicketRepositoryFromKitchenDisplay is type KitchenTicketEvent    outlet KitchenTicketRepositoryResponses is type KitchenTicket.KitchenTicketResult
    record StoredKitchenTicket is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "kitchenTicketId"
        described as {
          |The kitchenTicketId column of the stored kitchenTicket row.
        }
      }
      currentStation: StationName? with {
        briefly "currentStation"
        described as {
          |The currentStation column of the stored kitchenTicket row.
        }
      }
    } with {
      briefly "Stored kitchenTicket row"
      described as {
        |The persistence shape of kitchenTicket data as this repository stores it.
      }
    }
    schema KitchenTicketSchema is relational
      of tickets as type StoredKitchenTicket
        index on field StoredKitchenTicket.kitchenTicketId
        index on field StoredKitchenTicket.currentStation
 with {
      briefly "Kitchen ticket data schema"
      described as {
        |Relational schema for persisting kitchen ticket
        |state with indexes on ticket and station.
      }
    }
    command PersistTicketReceived is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist TicketReceived"
      described as {
        |Instructs this repository to apply TicketReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStationAssigned is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist StationAssigned"
      described as {
        |Instructs this repository to apply StationAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPreparationStarted is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist PreparationStarted"
      described as {
        |Instructs this repository to apply PreparationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemMarkedReady is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ItemMarkedReady"
      described as {
        |Instructs this repository to apply ItemMarkedReady to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketApproved is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist TicketApproved"
      described as {
        |Instructs this repository to apply TicketApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServerNotified is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ServerNotified"
      described as {
        |Instructs this repository to apply ServerNotified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler KitchenTicketPersistence is {
      on command PersistTicketReceived is {
        set field StoredKitchenTicket.currentStation to "as recorded by TicketReceived"
        do "insert row into KitchenTicketSchema.tickets with
          kitchenTicketId, sourceOrderId, ticketSource,
          ticketItems, receivedAt"
      }
      on command PersistStationAssigned is {
        set field StoredKitchenTicket.currentStation to "as recorded by StationAssigned"
        do "update KitchenTicketSchema.tickets set
          currentStation = assignedStation where
          kitchenTicketId matches"
      }
      on command PersistPreparationStarted is {
        set field StoredKitchenTicket.currentStation to "as recorded by PreparationStarted"
        do "update KitchenTicketSchema.tickets set
          actualPreparationStartedAt = startedAt where
          kitchenTicketId matches"
      }
      on command PersistItemMarkedReady is {
        set field StoredKitchenTicket.currentStation to "as recorded by ItemMarkedReady"
        do "update KitchenTicketSchema.tickets set
          ticketItems[readyMenuItemId].ticketItemReady = true
          where kitchenTicketId matches"
      }
      on command PersistTicketApproved is {
        set field StoredKitchenTicket.currentStation to "as recorded by TicketApproved"
        do "update KitchenTicketSchema.tickets set
          ticketApprovedAt = approvedAt where
          kitchenTicketId matches"
      }
      on command PersistServerNotified is {
        set field StoredKitchenTicket.currentStation to "as recorded by ServerNotified"
        do "update KitchenTicketSchema.tickets where
          kitchenTicketId matches"
      }
      on command LogKitchenTicketEvent is {
        do "append the kitchen ticket event to the KitchenTicket event log"
      }
    } with {
      briefly "Kitchen ticket persistence"
      described as {
        |Persists kitchen ticket events to the tickets table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Kitchen ticket repository"
    described as {
      |Stores and retrieves kitchen ticket data.
    }
  }
  projector KitchenDisplay is {
    updates repository Kitchen.KitchenTicketRepository
    inlet KitchenDisplayFromKitchenTicket is type KitchenTicketEvent    outlet KitchenDisplayOut is type KitchenTicketEvent
    record KitchenDisplayEntry is  {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |Ticket identifier.
        }
      }
      ticketSource: TicketSource with {
        briefly "Source"
        described as {
          |Dine-in or online.
        }
      }
      ticketItems: TicketItem+ with {
        briefly "Items"
        described as {
          |Items on the ticket.
        }
      }
      ticketDisplayStatus: String(1,30) with {
        briefly "Status"
        described as {
          |Display status derived from entity state name.
        }
      }
      displayStation: StationName? with {
        briefly "Station"
        described as {
          |Assigned station.
        }
      }
      receivedAt: TimeStamp with {
        briefly "Received at"
        described as {
          |When received.
        }
      }
    } with {
      briefly "Display entry"
      described as {
        |A single entry on the kitchen display.
      }
    }
    handler KitchenDisplayHandler is {
      on event KitchenTicket.TicketReceived is {
        let entry: type KitchenDisplayEntry = "new KitchenDisplayEntry from event"
        tell event KitchenTicket.TicketReceived to repository Kitchen.KitchenTicketRepository
        do "insert KitchenDisplayEntry with kitchenTicketId =
          event.kitchenTicketId, ticketSource =
          event.ticketSource, ticketItems = event.ticketItems,
          ticketDisplayStatus = Received, displayStation = none,
          receivedAt = event.receivedAt"
        set field KitchenDisplayEntry.ticketDisplayStatus to "Received"
      }
      on event KitchenTicket.StationAssigned is {
        tell event KitchenTicket.StationAssigned to repository Kitchen.KitchenTicketRepository
        do "update KitchenDisplayEntry set displayStation =
          event.assignedStation, ticketDisplayStatus = Assigned
          where kitchenTicketId = event.kitchenTicketId"
        set field KitchenDisplayEntry.ticketDisplayStatus to "Assigned"
      }
      on event KitchenTicket.PreparationStarted is {
        tell event KitchenTicket.PreparationStarted to repository Kitchen.KitchenTicketRepository
        do "update KitchenDisplayEntry set ticketDisplayStatus =
          InPreparation where kitchenTicketId =
          event.kitchenTicketId"
        set field KitchenDisplayEntry.ticketDisplayStatus to "InPreparation"
      }
      on event KitchenTicket.ItemMarkedReady is {
        tell event KitchenTicket.ItemMarkedReady to repository Kitchen.KitchenTicketRepository
        do "update KitchenDisplayEntry set
          ticketItems[event.readyMenuItemId].ticketItemReady
          = true where kitchenTicketId =
          event.kitchenTicketId"
        set field KitchenDisplayEntry.ticketDisplayStatus to "ItemReady"
      }
      on event KitchenTicket.TicketApproved is {
        tell event KitchenTicket.TicketApproved to repository Kitchen.KitchenTicketRepository
        do "update KitchenDisplayEntry set ticketDisplayStatus =
          Approved where kitchenTicketId =
          event.kitchenTicketId"
        set field KitchenDisplayEntry.ticketDisplayStatus to "Approved"
      }
      on event KitchenTicket.ServerNotified is {
        tell event KitchenTicket.ServerNotified to repository Kitchen.KitchenTicketRepository
        do "delete KitchenDisplayEntry where kitchenTicketId =
          event.kitchenTicketId"
        set field KitchenDisplayEntry.ticketDisplayStatus to "ServerNotified"
      }
    } with {
      briefly "Kitchen display handler"
      described as {
        |Projects ticket events onto the real-time kitchen
        |display screen, replacing handwritten tickets and
        |preventing order loss during peak hours.
      }
    }
  } with {
    briefly "Kitchen display projector"
    described as {
      | Real-time kitchen display screen showing active
      | tickets, station assignments, and preparation status.
      | Replaces handwritten tickets and prevents order loss.
    }
  }
  processor KitchenTicketEventSource as source is {
    outlet KitchenTicketEvents is type KitchenTicketEvent
    handler KitchenTicketEventEmitter is {
      on init is {
        tell command InitializeKitchenTicket to entity Kitchen.KitchenTicket
      }
      on other is {
        error "Unexpected message for source KitchenTicketEventSource"
      }
      on event KitchenTicket.TicketReceived is {
        send event KitchenTicket.TicketReceived to outlet KitchenTicketEvents
      }
      on event KitchenTicket.StationAssigned is {
        send event KitchenTicket.StationAssigned to outlet KitchenTicketEvents
      }
      on event KitchenTicket.PreparationStarted is {
        send event KitchenTicket.PreparationStarted to outlet KitchenTicketEvents
      }
      on event KitchenTicket.TicketApproved is {
        send event KitchenTicket.TicketApproved to outlet KitchenTicketEvents
      }
      on event KitchenTicket.ServerNotified is {
        send event KitchenTicket.ServerNotified to outlet KitchenTicketEvents
      }
    } with {
      briefly "Kitchen ticket event emitter"
      described as {
        |Emits kitchen ticket lifecycle events into the
        |streaming topology.
      }
    }
  } with {
    briefly "Kitchen ticket event source"
    described as {
      |Publishes kitchen ticket entity events for external
      |consumption.
    }
  }
  processor TicketQueue as merge is {
    inlet IncomingDineInTickets is type KitchenTicketEvent    inlet IncomingOnlineTickets is type KitchenTicketEvent    outlet DisplayTickets is type KitchenTicketEvent
    handler TicketQueueHandler is {
      on event KitchenTicket.TicketReceived is {
        send event KitchenTicket.TicketReceived to outlet DisplayTickets
      }
    } with {
      briefly "Ticket queue handler"
      described as {
        |Forwards incoming tickets to the display in FIFO
        |order with backpressure during peak hours.
      }
    }
  } with {
    briefly "Kitchen ticket queue"
    described as {
      |Processes incoming kitchen tickets in FIFO order,
      |ensuring tickets are handled in the sequence received.
      |Prevents ticket loss during peak hours by providing
      |backpressure when the kitchen is at capacity.
    }
  }
  processor TicketDisplaySink as sink is {
    inlet DisplayedTickets is type KitchenTicketEvent    handler TicketDisplayHandler is {
      on event KitchenTicket.TicketReceived is {
        tell event KitchenTicket.TicketReceived to entity Kitchen.KitchenTicket
        do "render ticket on kitchen display screen"
      }
    } with {
      briefly "Ticket display handler"
      described as {
        |Renders received ticket events on the kitchen
        |display screen for staff visibility.
      }
    }
  } with {
    briefly "Ticket display sink"
    described as {
      |Consumes processed kitchen ticket events from the
      |ticket queue and renders them on the kitchen display
      |screen for staff visibility.
    }
  }
  connector QueueToDisplay is from outlet Kitchen.TicketQueue.DisplayTickets to inlet Kitchen.TicketDisplaySink.DisplayedTickets with {
    briefly "Queue to display connector"
    described as {
      |Wires processed tickets from the queue to the display
      |sink for rendering on the kitchen screen.
    }
  }
  adaptor FromFrontOfHouse from context Restaurant.FrontOfHouse is { 
    handler FrontOfHouseIntake is {
      on event Restaurant.FrontOfHouse.TableOrder.OrderSubmitted is {
        do "filter event.orderItems where
          orderLineItem.itemCategory is not drink"
        do "map each food OrderLine to TicketItem with
          ticketMenuItemId = orderLineItem.itemCode,
          ticketItemName = orderLineItem.itemName,
          ticketItemQuantity = orderLineQuantity,
          ticketItemNotes = orderLineNotes,
          ticketItemReady = false"
        do "construct ReceiveTicket with new KitchenTicketId,
          sourceOrderId = event.tableOrderId, ticketSource =
          DineIn, ticketItems = mapped list, receivedAt =
          current timestamp"
        tell command ReceiveTicket to entity Kitchen.KitchenTicket
      }
      on other is {
        error "Unexpected message for adaptor FromFrontOfHouse"
      }
    } with {
      briefly "FOH intake"
      described as {
        |Converts dine-in orders to kitchen tickets with
        |DineIn source marker for display routing.
      }
    }
  } with {
    briefly "Front of house adaptor"
    described as {
      |Receives submitted dine-in orders and converts them
      |to kitchen tickets.
    }
  }
  adaptor FromOnlineOrdering from context Restaurant.OnlineOrdering is { 
    handler OnlineIntake is {
      on event Restaurant.OnlineOrdering.OnlineOrder.OnlineOrderSubmitted is {
        do "map each event.orderCartItems CartItem to TicketItem
          with ticketMenuItemId = cartMenuItemId, ticketItemName
          = cartItemName, ticketItemQuantity = cartItemQuantity,
          ticketItemNotes = cartItemNotes, ticketItemReady =
          false"
        do "construct ReceiveTicket with new KitchenTicketId,
          sourceOrderId = event.onlineOrderId, ticketSource =
          Online, ticketItems = mapped list, receivedAt =
          current timestamp"
        tell command ReceiveTicket to entity Kitchen.KitchenTicket
      }
      on other is {
        error "Unexpected message for adaptor FromOnlineOrdering"
      }
    } with {
      briefly "Online intake"
      described as {
        |Converts online orders to kitchen tickets with Online
        |source marker for fulfillment routing.
      }
    }
  } with {
    briefly "Online ordering adaptor"
    described as {
      |Receives submitted online orders and converts them
      |to kitchen tickets.
    }
  }
  // ---- Local event log for kitchen ticket events ----
  command LogKitchenTicketEvent is  {
    loggedKitchenTicketId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the kitchen ticket the logged event concerns.
      }
    }
    loggedKitchenTicketEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |Which kitchen ticket event was logged.
      }
    }
  } with {
    briefly "Log kitchen ticket event"
    described as {
      |Append a published kitchen ticket event to this context's event log.
    }
  }
  processor KitchenTicketEventLog as sink is {
    inlet IncomingKitchenTicketLog is type KitchenTicketEvent    handler KitchenTicketLogIntake is {
      on other is {
        tell command LogKitchenTicketEvent to repository Kitchen.KitchenTicketRepository
        do "append the kitchen ticket event to the context event log"
      }
    } with {
      briefly "KitchenTicket log intake"
      described as {
        |Routes every published kitchen ticket event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "KitchenTicket event log"
    described as {
      |Durable local log of kitchen ticket events this context publishes.
    }
  }
  connector KitchenTicketToLog is from outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents to inlet Kitchen.KitchenTicketEventLog.IncomingKitchenTicketLog with {
    briefly "KitchenTicket event log connector"
    described as {
      |Wires published kitchen ticket events to the context's event log.
    }
  }
  processor KitchenTicketEventSplit is {
    inlet KitchenTicketEventSplitIn is type KitchenTicketEvent    outlet KitchenTicketEventSplitToKitchenTicketRepository is type KitchenTicketEvent
    outlet KitchenTicketEventSplitToKitchenDisplay is type KitchenTicketEvent
    handler KitchenTicketEventSplitHandler is {
      on event KitchenTicket.TicketReceived is {
        send event KitchenTicket.TicketReceived to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.TicketReceived to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.TicketReceived to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.StationAssigned is {
        send event KitchenTicket.StationAssigned to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.StationAssigned to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.StationAssigned to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.PreparationStarted is {
        send event KitchenTicket.PreparationStarted to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.PreparationStarted to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.PreparationStarted to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.ItemMarkedReady is {
        send event KitchenTicket.ItemMarkedReady to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.ItemMarkedReady to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.ItemMarkedReady to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.TicketApproved is {
        send event KitchenTicket.TicketApproved to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.TicketApproved to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.TicketApproved to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.ServerNotified is {
        send event KitchenTicket.ServerNotified to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.ServerNotified to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.ServerNotified to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.ReceiveTicketRejected is {
        send event KitchenTicket.ReceiveTicketRejected to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.ReceiveTicketRejected to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.ReceiveTicketRejected to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.AssignStationRejected is {
        send event KitchenTicket.AssignStationRejected to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.AssignStationRejected to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.AssignStationRejected to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.StartPreparationRejected is {
        send event KitchenTicket.StartPreparationRejected to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.StartPreparationRejected to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.StartPreparationRejected to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.MarkItemReadyRejected is {
        send event KitchenTicket.MarkItemReadyRejected to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.MarkItemReadyRejected to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.MarkItemReadyRejected to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.ApproveTicketRejected is {
        send event KitchenTicket.ApproveTicketRejected to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.ApproveTicketRejected to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.ApproveTicketRejected to entity Kitchen.KitchenTicket
      }
      on event KitchenTicket.NotifyServerRejected is {
        send event KitchenTicket.NotifyServerRejected to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send event KitchenTicket.NotifyServerRejected to outlet KitchenTicketEventSplitToKitchenDisplay
        tell event KitchenTicket.NotifyServerRejected to entity Kitchen.KitchenTicket
      }
      on other is {
        error "Unexpected message for processor KitchenTicketEventSplit"
      }
    } with {
      briefly "KitchenTicket event fan-out handler"
      described as {
        |Delivers each KitchenTicket event to all of its consumers.
      }
    }
  } with {
    briefly "KitchenTicket event fan-out"
    described as {
      |Fans KitchenTicket events out to the repository and projectors.
    }
  }
  connector KitchenTicketEventStream is from outlet Kitchen.KitchenTicket.KitchenTicketEvents2 to inlet Kitchen.KitchenTicketEventSplit.KitchenTicketEventSplitIn with {
    briefly "KitchenTicket events, fanned out to storage and read models"
  }
  connector KitchenTicketEventStorage is from outlet Kitchen.KitchenTicketEventSplit.KitchenTicketEventSplitToKitchenTicketRepository to inlet Kitchen.KitchenTicketRepository.KitchenTicketRepositoryFromKitchenTicket with {
    briefly "KitchenTicket events on their way to storage"
  }
  connector KitchenDisplayFeed is from outlet Kitchen.KitchenTicketEventSplit.KitchenTicketEventSplitToKitchenDisplay to inlet Kitchen.KitchenDisplay.KitchenDisplayFromKitchenTicket with {
    briefly "KitchenTicket events feeding the KitchenDisplay projection"
  }
  connector KitchenDisplayStorage is from outlet Kitchen.KitchenDisplay.KitchenDisplayOut to inlet Kitchen.KitchenTicketRepository.KitchenTicketRepositoryFromKitchenDisplay with {
    briefly "The KitchenDisplay projection on its way to storage"
  }
} with {
  briefly "Kitchen context"
  described as {
    | Manages kitchen ticket queue, station assignments,
    | preparation tracking, and quality control. Provides
    | the kitchen display screen that replaces handwritten
    | tickets and prevents order loss during peak hours.
  }
}
