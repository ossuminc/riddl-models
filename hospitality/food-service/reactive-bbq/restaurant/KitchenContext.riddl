// Kitchen bounded context
context Kitchen as router is {
  inlet KitchenToInventoryIn is type KitchenTicketEvent  outlet KitchenToInventoryOut is type KitchenTicketEvent
  connector 'FromKitchen Feed' is from outlet Kitchen.KitchenTicketEventSource.KitchenTicketEventSourceToInventory to inlet Kitchen.KitchenToInventoryIn with {
    briefly "KitchenTicket events on their way to Inventory"
    described as {
      |KitchenTicket events on their way to Inventory.
    }
  }
  connector 'KitchenTicketEventLog To KitchenTicketRepository' is from outlet Kitchen.KitchenTicketEventLog.KitchenTicketEventLogToKitchenTicketRepository to inlet Kitchen.KitchenTicketRepository.KitchenTicketRepositoryFromKitchenTicketEventLog  connector 'FromOnlineOrdering To Kitchen' is from outlet Kitchen.FromOnlineOrdering.FromOnlineOrderingToKitchen to inlet Kitchen.KitchenFromFromOnlineOrdering  inlet KitchenFromFromOnlineOrdering is command ReceiveTicket  connector 'FromFrontOfHouse To Kitchen' is from outlet Kitchen.FromFrontOfHouse.FromFrontOfHouseToKitchen to inlet Kitchen.KitchenFromFromFrontOfHouse  inlet KitchenFromFromFrontOfHouse is command ReceiveTicket  inlet KitchenTicketCommandStreamIn is type KitchenTicketCommand  outlet KitchenTicketCommandStreamOut is type KitchenTicketCommand
  inlet KitchenTicketResultStreamIn is result KitchenTicket.KitchenTicketResult  outlet KitchenTicketResultStreamOut is result KitchenTicket.KitchenTicketResult
  outlet TicketIntakeOut is command KitchenTicket.ReceiveTicket
 with {
    briefly "Externally originated tickets on their way to the intake merge"
    described as {
      |Both source contexts converge here: KitchenBoundary handles
      |ReceiveTicket from either inlet and forwards it to this one outlet.
    }
  }
  outlet KitchenToFrontOfHouseOut is event KitchenTicket.PreparationStarted
 with {
    briefly "What Kitchen tells FrontOfHouse about the orders it is cooking"
    described as {
      |A dine-in order is in preparation when the kitchen starts cooking its
      |ticket, and the kitchen is the only party that knows. FrontOfHouse
      |learns it here, through its own `FromKitchen` adaptor.
    }
  }
  handler KitchenBoundary is {
    on preparationStarted: event KitchenTicket.PreparationStarted is {
      send preparationStarted to outlet Kitchen.KitchenToInventoryOut
      send preparationStarted to outlet Kitchen.KitchenToFrontOfHouseOut
    }
    on ticketApproved: event KitchenTicket.TicketApproved is {
      send ticketApproved to outlet Kitchen.KitchenToInventoryOut
    }
    on receiveTicket: command KitchenTicket.ReceiveTicket is {
      forward receiveTicket to outlet Kitchen.TicketIntakeOut
    }
    on assignStation: command KitchenTicket.AssignStation is {
      forward assignStation to outlet Kitchen.KitchenTicketCommandStreamOut
    }
    on startPreparation: command KitchenTicket.StartPreparation is {
      forward startPreparation to outlet Kitchen.KitchenTicketCommandStreamOut
    }
    on markItemReady: command KitchenTicket.MarkItemReady is {
      forward markItemReady to outlet Kitchen.KitchenTicketCommandStreamOut
    }
    on approveTicket: command KitchenTicket.ApproveTicket is {
      forward approveTicket to outlet Kitchen.KitchenTicketCommandStreamOut
    }
    on notifyServer: command KitchenTicket.NotifyServer is {
      forward notifyServer to outlet Kitchen.KitchenTicketCommandStreamOut
    }
    on kitchenTicketResult: result KitchenTicket.KitchenTicketResult is {
      send kitchenTicketResult to outlet Kitchen.KitchenTicketResultStreamOut
    }
    on other is {
      error "Unexpected message at the Kitchen boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'KitchenTicketProjection Storage' is from outlet Kitchen.KitchenTicketProjection.KitchenTicketProjectionToRepository to inlet Kitchen.KitchenTicketRepository.KitchenTicketRepositoryFromKitchenTicketProjection with {
    briefly "KitchenTicketProjection commands on their way to KitchenTicketRepository"
    described as {
      |Carries what leaves Kitchen.KitchenTicketProjection.KitchenTicketProjectionToRepository to Kitchen.KitchenTicketRepository.KitchenTicketRepositoryFromKitchenTicketProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'KitchenTicketCommand Stream Intake' is from outlet Kitchen.KitchenTicketCommandStreamOut to inlet Kitchen.KitchenTicketIntake.IntakeAppCommands  connector 'KitchenTicket External Intake' is from outlet Kitchen.TicketIntakeOut to inlet Kitchen.KitchenTicketIntake.IntakeExternalTickets with {
    briefly "Externally originated tickets on their way into the intake merge"
    described as {
      |The second leg of the merge: what the two order-taking contexts sent.
    }
  }
  connector 'KitchenTicketCommand Merged Intake' is from outlet Kitchen.KitchenTicketIntake.IntakeMergedCommands to inlet Kitchen.KitchenTicket.KitchenTicketCommands with {
    briefly "The joined command stream reaching the KitchenTicket entity"
    described as {
      |One stream out of the merge, so the entity has a single command source
      |however a command reached the kitchen.
    }
  }
  connector 'KitchenTicketResult Stream Egress' is from outlet Kitchen.KitchenTicketRepository.KitchenTicketRepositoryResponses to inlet Kitchen.KitchenTicketResultStreamIn  include "kitchen-types.riddl"
  include "KitchenTicket.riddl"
  type KitchenTicketRepositoryCommand is one of {
    Kitchen.KitchenTicketRepository.PersistTicketReceived or Kitchen.KitchenTicketRepository.PersistStationAssigned or Kitchen.KitchenTicketRepository.PersistPreparationStarted or Kitchen.KitchenTicketRepository.PersistItemMarkedReady or Kitchen.KitchenTicketRepository.PersistTicketApproved or Kitchen.KitchenTicketRepository.PersistServerNotified or Kitchen.KitchenTicketRepository.PostKitchenDisplayEntry or Kitchen.KitchenTicketRepository.AssignKitchenDisplayStation or Kitchen.KitchenTicketRepository.SetKitchenDisplayStatus or Kitchen.KitchenTicketRepository.MarkKitchenDisplayLineReady or Kitchen.KitchenTicketRepository.ClearKitchenDisplayEntry
  } with {
    briefly "Anything that writes the KitchenTicketRepository"
    described as {
      |The persistence commands KitchenTicketRepository accepts. Entity events never reach
      |it directly; KitchenTicketProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository KitchenTicketRepository as merge is {
    inlet KitchenTicketRepositoryFromKitchenTicketEventLog is command LogKitchenTicketEvent    inlet KitchenTicketRepositoryFromKitchenTicketProjection is type KitchenTicketRepositoryCommand    inlet KitchenTicketRepositoryFromKitchenDisplay is type KitchenTicketRepositoryCommand    outlet KitchenTicketRepositoryResponses is result KitchenTicket.KitchenTicketResult
    record StoredKitchenTicket is {
      kitchenTicketId: KitchenTicketId with {
        briefly "kitchenTicketId"
        described as {
          |The kitchenTicketId column of the stored kitchenTicket row.
        }
      }
      currentStation: StationName? with {
        briefly "currentStation"
        described as {
          |The currentStation column of the stored kitchenTicket row.
        }
      }
      sourceOrderId: String(1,50) with {
        briefly "Source order id"
        described as {
          |The row's source order id, as the persisting projector last wrote it.
        }
      }
      ticketSource: TicketSource with {
        briefly "Ticket source"
        described as {
          |The row's ticket source, as the persisting projector last wrote it.
        }
      }
      ticketItems: TicketItem+ with {
        briefly "Ticket items"
        described as {
          |The row's ticket items, as the persisting projector last wrote it.
        }
      }
      receivedAt: TimeStamp with {
        briefly "Received at"
        described as {
          |The row's received at, as the persisting projector last wrote it.
        }
      }
      actualPreparationStartedAt: TimeStamp? with {
        briefly "Actual preparation started at"
        described as {
          |The row's actual preparation started at, as the persisting projector last wrote it.
        }
      }
      ticketApprovedAt: TimeStamp? with {
        briefly "Ticket approved at"
        described as {
          |The row's ticket approved at, as the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored kitchenTicket row"
      described as {
        |The persistence shape of kitchenTicket data as this repository stores it.
      }
    }
    record KitchenDisplayEntry is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The ticket this display row stands for. The expo reads the board by
          |ticket, so this is what a cook calls out when asking about an order.
        }
      }
      ticketSource: TicketSource with {
        briefly "Source"
        described as {
          |Dine-in or online.
        }
      }
      ticketDisplayStatus: String(1,30) with {
        briefly "Status"
        described as {
          |Where the ticket is on the line: Received, Assigned, InPreparation,
          |ItemReady or Approved.
        }
      }
      displayStation: StationName? with {
        briefly "Station"
        described as {
          |Assigned station, empty until one is assigned.
        }
      }
      receivedAt: TimeStamp with {
        briefly "Received at"
        described as {
          |When the ticket hit the kitchen. The board sorts on this, so the
          |oldest ticket sits at the top and nothing ages out of sight.
        }
      }
    } with {
      briefly "Display entry"
      described as {
        |One active ticket on the kitchen display. The row is cleared when the
        |server is notified, so the board shows only work still on the line;
        |the tickets table keeps the history.
      }
    }
    record KitchenDisplayLine is {
      kitchenTicketId: KitchenTicketId with {
        briefly "Ticket"
        described as {
          |The ticket this line is shown under.
        }
      }
      ticketMenuItemId: String(1,50) with {
        briefly "Menu item"
        described as {
          |The dish, which with the ticket identifies the line.
        }
      }
      ticketItemName: String(1,200) with {
        briefly "Dish"
        described as {
          |What the cook reads on the board.
        }
      }
      ticketItemQuantity: Natural with {
        briefly "Quantity"
        described as {
          |How many to plate.
        }
      }
      ticketItemNotes: String(1,500)? with {
        briefly "Notes"
        described as {
          |Modifications the guest asked for.
        }
      }
      ticketItemReady: Boolean with {
        briefly "Ready"
        described as {
          |Set when the cook marks the dish ready. A cook works the unmarked
          |lines.
        }
      }
    } with {
      briefly "Display line"
      described as {
        |One dish under a ticket on the kitchen display, a row of its own so
        |marking it ready is an update rather than an edit inside the entry.
      }
    }
    schema KitchenTicketSchema is relational
      of displayBoard as record KitchenDisplayEntry
      of displayLines as record KitchenDisplayLine
      of kitchenTicketEvents as record LoggedKitchenTicketEvent with history
      of tickets as record StoredKitchenTicket
        link kitchenTicketEventLogEntry as field LoggedKitchenTicketEvent.loggedKitchenTicketId to field StoredKitchenTicket.kitchenTicketId
        key on field StoredKitchenTicket.kitchenTicketId
        index on field StoredKitchenTicket.currentStation
        index on field KitchenDisplayEntry.kitchenTicketId
        index on field KitchenDisplayLine.kitchenTicketId
 with {
      briefly "Kitchen ticket data schema"
      described as {
        |Relational schema for persisting kitchen ticket
        |state with indexes on ticket and station.
      }
    }
    command PersistTicketReceived is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      sourceOrderId: String(1,50) with {
        briefly "Source order id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      ticketSource: TicketSource with {
        briefly "Ticket source"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      ticketItems: TicketItem+ with {
        briefly "Ticket items"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      receivedAt: TimeStamp with {
        briefly "Received at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketReceived"
      described as {
        |Instructs this repository to apply TicketReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistStationAssigned is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      assignedStation: StationName with {
        briefly "Assigned station"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist StationAssigned"
      described as {
        |Instructs this repository to apply StationAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPreparationStarted is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      startedAt: TimeStamp with {
        briefly "Started at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PreparationStarted"
      described as {
        |Instructs this repository to apply PreparationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemMarkedReady is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      readyMenuItemId: String(1,50) with {
        briefly "Ready menu item id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ItemMarkedReady"
      described as {
        |Instructs this repository to apply ItemMarkedReady to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTicketApproved is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      approvedAt: TimeStamp with {
        briefly "Approved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist TicketApproved"
      described as {
        |Instructs this repository to apply TicketApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistServerNotified is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ServerNotified"
      described as {
        |Instructs this repository to apply ServerNotified to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PostKitchenDisplayEntry is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The ticket whose display row this writes.
        }
      }
      ticketSource: TicketSource with {
        briefly "Source"
        described as {
          |Dine-in or online.
        }
      }
      ticketItems: TicketItem+ with {
        briefly "Items"
        described as {
          |The dishes to show under the ticket.
        }
      }
      receivedAt: TimeStamp with {
        briefly "Received at"
        described as {
          |When the ticket hit the kitchen.
        }
      }
    } with {
      briefly "Post a ticket to the display"
      described as {
        |Puts a newly received ticket and each of its dishes on the kitchen display.
      }
    }
    command AssignKitchenDisplayStation is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The ticket whose display row this writes.
        }
      }
      assignedStation: StationName with {
        briefly "Station"
        described as {
          |The station now cooking the ticket.
        }
      }
    } with {
      briefly "Show the assigned station"
      described as {
        |Records on the display which station the ticket went to.
      }
    }
    command SetKitchenDisplayStatus is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The ticket whose display row this writes.
        }
      }
      ticketDisplayStatus: String(1,30) with {
        briefly "Status"
        described as {
          |The status to show.
        }
      }
    } with {
      briefly "Show the ticket status"
      described as {
        |Records on the display where the ticket is on the line.
      }
    }
    command MarkKitchenDisplayLineReady is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The ticket whose display row this writes.
        }
      }
      readyMenuItemId: String(1,50) with {
        briefly "Dish"
        described as {
          |The dish the cook marked ready.
        }
      }
    } with {
      briefly "Mark a dish ready on the display"
      described as {
        |Marks one dish under a ticket ready on the display.
      }
    }
    command ClearKitchenDisplayEntry is {
      kitchenTicketId: KitchenTicketId with {
        briefly "ID"
        described as {
          |The ticket whose display row this writes.
        }
      }
    } with {
      briefly "Take a ticket off the display"
      described as {
        |Removes a finished ticket and its dishes from the display.
      }
    }
    handler KitchenTicketPersistence is {
      on postKitchenDisplayEntry: command PostKitchenDisplayEntry is {
        store record KitchenDisplayEntry(kitchenTicketId = postKitchenDisplayEntry.kitchenTicketId, ticketSource = postKitchenDisplayEntry.ticketSource, ticketDisplayStatus = "Received", displayStation = empty, receivedAt = postKitchenDisplayEntry.receivedAt) in KitchenTicketSchema.displayBoard
        foreach postedItem in field PostKitchenDisplayEntry.ticketItems {
          store record KitchenDisplayLine(kitchenTicketId = postKitchenDisplayEntry.kitchenTicketId, ticketMenuItemId = postedItem.ticketMenuItemId, ticketItemName = postedItem.ticketItemName, ticketItemQuantity = postedItem.ticketItemQuantity, ticketItemNotes = postedItem.ticketItemNotes, ticketItemReady = postedItem.ticketItemReady) in KitchenTicketSchema.displayLines
        }
      }
      on assignKitchenDisplayStation: command AssignKitchenDisplayStation is {
        update KitchenTicketSchema.displayBoard set displayStation = assignKitchenDisplayStation.assignedStation, ticketDisplayStatus = "Assigned" where kitchenTicketId == assignKitchenDisplayStation.kitchenTicketId
      }
      on setKitchenDisplayStatus: command SetKitchenDisplayStatus is {
        update KitchenTicketSchema.displayBoard set ticketDisplayStatus = setKitchenDisplayStatus.ticketDisplayStatus where kitchenTicketId == setKitchenDisplayStatus.kitchenTicketId
      }
      on markKitchenDisplayLineReady: command MarkKitchenDisplayLineReady is {
        update KitchenTicketSchema.displayLines set ticketItemReady = true where kitchenTicketId == markKitchenDisplayLineReady.kitchenTicketId and ticketMenuItemId == markKitchenDisplayLineReady.readyMenuItemId
        update KitchenTicketSchema.displayBoard set ticketDisplayStatus = "ItemReady" where kitchenTicketId == markKitchenDisplayLineReady.kitchenTicketId
      }
      on clearKitchenDisplayEntry: command ClearKitchenDisplayEntry is {
        delete from KitchenTicketSchema.displayLines where kitchenTicketId == clearKitchenDisplayEntry.kitchenTicketId
        delete from KitchenTicketSchema.displayBoard where kitchenTicketId == clearKitchenDisplayEntry.kitchenTicketId
      }
      on persistTicketReceived: command PersistTicketReceived is {
        store record StoredKitchenTicket(kitchenTicketId = persistTicketReceived.kitchenTicketId, sourceOrderId = persistTicketReceived.sourceOrderId, ticketSource = persistTicketReceived.ticketSource, ticketItems = persistTicketReceived.ticketItems, receivedAt = persistTicketReceived.receivedAt, actualPreparationStartedAt = empty, currentStation = empty, ticketApprovedAt = empty) in KitchenTicketSchema.tickets
      }
      on persistStationAssigned: command PersistStationAssigned is {
        update KitchenTicketSchema.tickets set currentStation = persistStationAssigned.assignedStation where kitchenTicketId == persistStationAssigned.kitchenTicketId
      }
      on persistPreparationStarted: command PersistPreparationStarted is {
        update KitchenTicketSchema.tickets set actualPreparationStartedAt = persistPreparationStarted.startedAt where kitchenTicketId == persistPreparationStarted.kitchenTicketId
      }
      on command PersistItemMarkedReady is {
        do "update KitchenTicketSchema.tickets set
          ticketItems[readyMenuItemId].ticketItemReady = true
          where kitchenTicketId matches"
      }
      on persistTicketApproved: command PersistTicketApproved is {
        update KitchenTicketSchema.tickets set ticketApprovedAt = persistTicketApproved.approvedAt where kitchenTicketId == persistTicketApproved.kitchenTicketId
      }
      on command PersistServerNotified is {
        do "update KitchenTicketSchema.tickets where
          kitchenTicketId matches"
      }
      on logKitchenTicketEvent: command LogKitchenTicketEvent is {
        store record LoggedKitchenTicketEvent(loggedKitchenTicketId = logKitchenTicketEvent.loggedKitchenTicketId, loggedKitchenTicketEventType = logKitchenTicketEvent.loggedKitchenTicketEventType, loggedAt = system.now) in KitchenTicketSchema.kitchenTicketEvents
      }
      on command UpdateStationRouting is {
        foreach menuCategory, routedStation in field UpdateStationRouting.newRouting {
          do "record that menuCategory is cooked at routedStation, replacing
            whatever this kitchen had before"
        }
      }
    } with {
      briefly "Kitchen ticket persistence"
      described as {
        |Persists kitchen ticket events to the tickets table
        |and updates the current state projection.
      }
    }
  } with {
    briefly "Kitchen ticket repository"
    described as {
      |Stores and retrieves kitchen ticket data.
    }
  }
  projector KitchenTicketProjection as flow is {
    updates repository Kitchen.KitchenTicketRepository
    inlet KitchenTicketProjectionFromKitchenTicket is type KitchenTicketEvent    outlet KitchenTicketProjectionToRepository is type KitchenTicketRepositoryCommand
    handler KitchenTicketProjectionHandler is {
      on ticketReceived: event Kitchen.KitchenTicket.TicketReceived is {
        tell command Kitchen.KitchenTicketRepository.PersistTicketReceived(kitchenTicketId = ticketReceived.kitchenTicketId, sourceOrderId = ticketReceived.sourceOrderId, ticketSource = ticketReceived.ticketSource, ticketItems = ticketReceived.ticketItems, receivedAt = ticketReceived.receivedAt) to repository Kitchen.KitchenTicketRepository
      }
      on stationAssigned: event Kitchen.KitchenTicket.StationAssigned is {
        tell command Kitchen.KitchenTicketRepository.PersistStationAssigned(kitchenTicketId = stationAssigned.kitchenTicketId, assignedStation = stationAssigned.assignedStation) to repository Kitchen.KitchenTicketRepository
      }
      on preparationStarted: event Kitchen.KitchenTicket.PreparationStarted is {
        tell command Kitchen.KitchenTicketRepository.PersistPreparationStarted(kitchenTicketId = preparationStarted.kitchenTicketId, startedAt = preparationStarted.startedAt) to repository Kitchen.KitchenTicketRepository
      }
      on itemMarkedReady: event Kitchen.KitchenTicket.ItemMarkedReady is {
        tell command Kitchen.KitchenTicketRepository.PersistItemMarkedReady(kitchenTicketId = itemMarkedReady.kitchenTicketId, readyMenuItemId = itemMarkedReady.readyMenuItemId) to repository Kitchen.KitchenTicketRepository
      }
      on ticketApproved: event Kitchen.KitchenTicket.TicketApproved is {
        tell command Kitchen.KitchenTicketRepository.PersistTicketApproved(kitchenTicketId = ticketApproved.kitchenTicketId, approvedAt = ticketApproved.approvedAt) to repository Kitchen.KitchenTicketRepository
      }
      on serverNotified: event Kitchen.KitchenTicket.ServerNotified is {
        tell command Kitchen.KitchenTicketRepository.PersistServerNotified(kitchenTicketId = serverNotified.kitchenTicketId) to repository Kitchen.KitchenTicketRepository
      }
      on other as m is {
        log m
      }
    } with {
      briefly "KitchenTicketProjection handler"
      described as {
        |Turns each KitchenTicket event into the repository command that writes it.
      }
    }
  } with {
    briefly "KitchenTicket persistence projection"
    described as {
      |Builds the stored KitchenTicket view from the entity's events.
    }
  }
  projector KitchenDisplay as flow is {
    updates repository Kitchen.KitchenTicketRepository
    inlet KitchenDisplayFromKitchenTicket is type KitchenTicketEvent    outlet KitchenDisplayOut is type KitchenTicketRepositoryCommand
    handler KitchenDisplayHandler is {
      on other as m is {
        log m
      }
      on ticketReceived: event KitchenTicket.TicketReceived is {
        tell command Kitchen.KitchenTicketRepository.PostKitchenDisplayEntry(kitchenTicketId = ticketReceived.kitchenTicketId, ticketSource = ticketReceived.ticketSource, ticketItems = ticketReceived.ticketItems, receivedAt = ticketReceived.receivedAt) to repository Kitchen.KitchenTicketRepository
        foreach ticketLine in field TicketReceived.ticketItems {
          do "route ticketLine to the station that owns its menu item, so a
            ticket spanning grill and fryer appears on both boards"
        }
      }
      on stationAssigned: event KitchenTicket.StationAssigned is {
        tell command Kitchen.KitchenTicketRepository.AssignKitchenDisplayStation(kitchenTicketId = stationAssigned.kitchenTicketId, assignedStation = stationAssigned.assignedStation) to repository Kitchen.KitchenTicketRepository
      }
      on preparationStarted: event KitchenTicket.PreparationStarted is {
        tell command Kitchen.KitchenTicketRepository.SetKitchenDisplayStatus(kitchenTicketId = preparationStarted.kitchenTicketId, ticketDisplayStatus = "InPreparation") to repository Kitchen.KitchenTicketRepository
      }
      on itemMarkedReady: event KitchenTicket.ItemMarkedReady is {
        tell command Kitchen.KitchenTicketRepository.MarkKitchenDisplayLineReady(kitchenTicketId = itemMarkedReady.kitchenTicketId, readyMenuItemId = itemMarkedReady.readyMenuItemId) to repository Kitchen.KitchenTicketRepository
      }
      on ticketApproved: event KitchenTicket.TicketApproved is {
        tell command Kitchen.KitchenTicketRepository.SetKitchenDisplayStatus(kitchenTicketId = ticketApproved.kitchenTicketId, ticketDisplayStatus = "Approved") to repository Kitchen.KitchenTicketRepository
      }
      on serverNotified: event KitchenTicket.ServerNotified is {
        tell command Kitchen.KitchenTicketRepository.ClearKitchenDisplayEntry(kitchenTicketId = serverNotified.kitchenTicketId) to repository Kitchen.KitchenTicketRepository
      }
    } with {
      briefly "Kitchen display handler"
      described as {
        |Projects ticket events onto the real-time kitchen
        |display screen, replacing handwritten tickets and
        |preventing order loss during peak hours.
      }
    }
  } with {
    briefly "Kitchen display projector"
    described as {
      | Real-time kitchen display screen showing active
      | tickets, station assignments, and preparation status.
      | Replaces handwritten tickets and prevents order loss.
    }
  }
  streamlet KitchenTicketEventSource as split is {
    outlet KitchenTicketEventSourceToInventory is type KitchenTicketEvent
    inlet KitchenTicketEventSourceIn is type KitchenTicketEvent    outlet KitchenTicketEventsToQueue is type KitchenTicketEvent
    outlet KitchenTicketEvents is type KitchenTicketEvent
    handler KitchenTicketEventEmitter is {
      on other is {
        error "Unexpected message for source KitchenTicketEventSource"
      }
      on ticketReceived: event KitchenTicket.TicketReceived is {
        send ticketReceived to outlet KitchenTicketEvents
        send ticketReceived to outlet KitchenTicketEventsToQueue
      }
      on stationAssigned: event KitchenTicket.StationAssigned is {
        send stationAssigned to outlet KitchenTicketEvents
        send stationAssigned to outlet KitchenTicketEventsToQueue
      }
      on preparationStarted: event KitchenTicket.PreparationStarted is {
        send preparationStarted to outlet KitchenTicketEvents
        send preparationStarted to outlet KitchenTicketEventsToQueue
        send preparationStarted to outlet KitchenTicketEventSourceToInventory
      }
      on ticketApproved: event KitchenTicket.TicketApproved is {
        send ticketApproved to outlet KitchenTicketEvents
        send ticketApproved to outlet KitchenTicketEventsToQueue
        send ticketApproved to outlet KitchenTicketEventSourceToInventory
      }
      on serverNotified: event KitchenTicket.ServerNotified is {
        send serverNotified to outlet KitchenTicketEvents
        send serverNotified to outlet KitchenTicketEventsToQueue
      }
    } with {
      briefly "Kitchen ticket event emitter"
      described as {
        |Emits kitchen ticket lifecycle events into the
        |streaming topology.
      }
    }
  } with {
    briefly "Kitchen ticket event source"
    described as {
      |Publishes kitchen ticket entity events for external
      |consumption.
    }
  }
  streamlet TicketQueue as flow is {
    inlet IncomingTickets is type KitchenTicketEvent    outlet DisplayTickets is type KitchenTicketEvent
    handler TicketQueueHandler is {
      on other as m is {
        log m
      }
      on ticketReceived: event KitchenTicket.TicketReceived is {
        send ticketReceived to outlet DisplayTickets
      }
    } with {
      briefly "Ticket queue handler"
      described as {
        |Forwards incoming tickets to the display in FIFO
        |order with backpressure during peak hours.
      }
    }
  } with {
    briefly "Kitchen ticket queue"
    described as {
      |Processes incoming kitchen tickets in FIFO order,
      |ensuring tickets are handled in the sequence received.
      |Prevents ticket loss during peak hours by providing
      |backpressure when the kitchen is at capacity.
    }
  }
  streamlet TicketDisplaySink as sink is {
    inlet DisplayedTickets is type KitchenTicketEvent    handler TicketDisplayHandler is {
      on other as m is {
        log m
      }
      on ticketReceived: event KitchenTicket.TicketReceived is {
        log ticketReceived
        do "render ticket on kitchen display screen"
      }
    } with {
      briefly "Ticket display handler"
      described as {
        |Renders received ticket events on the kitchen
        |display screen for staff visibility.
      }
    }
  } with {
    briefly "Ticket display sink"
    described as {
      |Consumes processed kitchen ticket events from the
      |ticket queue and renders them on the kitchen display
      |screen for staff visibility.
      |
      |A display receives; it does not send. It used to hand
      |`TicketReceived` back to the KitchenTicket entity that yielded it,
      |which is a message the entity had already processed - a monitor
      |cannot tell the kitchen anything. Should it ever answer a query
      |("which tickets are on screen"), it gains an outlet carrying that
      |RESULT and stops being a sink; it does not regain this one.
    }
  }
  connector QueueToDisplay is from outlet Kitchen.TicketQueue.DisplayTickets to inlet Kitchen.TicketDisplaySink.DisplayedTickets with {
    briefly "Queue to display connector"
    described as {
      |Wires processed tickets from the queue to the display
      |sink for rendering on the kitchen screen.
    }
  }
  adaptor FromFrontOfHouse from context Restaurant.FrontOfHouse as flow is { 
    inlet FromFrontOfHouseIn is event ReactiveBBQ.Restaurant.FrontOfHouse.TableOrder.OrderSubmitted    outlet FromFrontOfHouseToKitchen is command ReceiveTicket
    handler FrontOfHouseIntake is {
      on event Restaurant.FrontOfHouse.TableOrder.OrderSubmitted is {
        do "filter event.orderItems where
          orderLineItem.itemCategory is not drink"
        do "map each food OrderLine to TicketItem with
          ticketMenuItemId = orderLineItem.itemCode,
          ticketItemName = orderLineItem.itemName,
          ticketItemQuantity = orderLineQuantity,
          ticketItemNotes = orderLineNotes,
          ticketItemReady = false"
        do "construct ReceiveTicket with new KitchenTicketId,
          sourceOrderId = event.tableOrderId, ticketSource =
          DineIn, ticketItems = mapped list, receivedAt =
          current timestamp"
        let receiveTicket: type ReceiveTicket = prompt("the receive ticket that results from order submitted")
        send receiveTicket to outlet Kitchen.FromFrontOfHouse.FromFrontOfHouseToKitchen
      }
      on other is {
        error "Unexpected message for adaptor FromFrontOfHouse"
      }
    } with {
      briefly "FOH intake"
      described as {
        |Converts dine-in orders to kitchen tickets with
        |DineIn source marker for display routing.
      }
    }
  } with {
    briefly "Front of house adaptor"
    described as {
      |Receives submitted dine-in orders and converts them
      |to kitchen tickets.
    }
  }
  adaptor FromOnlineOrdering from context Restaurant.OnlineOrdering as flow is { 
    inlet FromOnlineOrderingIn is event ReactiveBBQ.Restaurant.OnlineOrdering.OnlineOrder.OnlineOrderSubmitted    outlet FromOnlineOrderingToKitchen is command ReceiveTicket
    handler OnlineIntake is {
      on event Restaurant.OnlineOrdering.OnlineOrder.OnlineOrderSubmitted is {
        do "map each event.orderCartItems CartItem to TicketItem
          with ticketMenuItemId = cartMenuItemId, ticketItemName
          = cartItemName, ticketItemQuantity = cartItemQuantity,
          ticketItemNotes = cartItemNotes, ticketItemReady =
          false"
        do "construct ReceiveTicket with new KitchenTicketId,
          sourceOrderId = event.onlineOrderId, ticketSource =
          Online, ticketItems = mapped list, receivedAt =
          current timestamp"
        let receiveTicket: type ReceiveTicket = prompt("the receive ticket that results from online order submitted")
        send receiveTicket to outlet Kitchen.FromOnlineOrdering.FromOnlineOrderingToKitchen
      }
      on other is {
        error "Unexpected message for adaptor FromOnlineOrdering"
      }
    } with {
      briefly "Online intake"
      described as {
        |Converts online orders to kitchen tickets with Online
        |source marker for fulfillment routing.
      }
    }
  } with {
    briefly "Online ordering adaptor"
    described as {
      |Receives submitted online orders and converts them
      |to kitchen tickets.
    }
  }
  command UpdateStationRouting is {
    newRouting: StationRouting with {
      briefly "Routing table"
      described as {
        |The whole category-to-station table, replaced wholesale rather than
        |patched. A kitchen relaid mid-service is re-planned as one decision,
        |and applying half a routing would send a table's food to two
        |stations that are no longer both open.
      }
    }
  } with {
    briefly "Update station routing"
    described as {
      |Re-point menu categories at stations, as when a station goes down or
      |the line is relaid for a service.
    }
  }
  // ---- Local event log for kitchen ticket events ----
  record LoggedKitchenTicketEvent is {
    loggedKitchenTicketId: String(1,50) with {
      briefly "LoggedKitchenTicketId"
      described as {
        |As the logged event carried it.
      }
    }
    loggedKitchenTicketEventType: String(1,50) with {
      briefly "LoggedKitchenTicketEventType"
      described as {
        |As the logged event carried it.
      }
    }
    loggedAt: TimeStamp with {
      briefly "Logged at"
      described as {
        |When the log row was written.
      }
    }
  } with {
    briefly "A logged KitchenTicket event"
    described as {
      |One row of the KitchenTicket event log: which kitchenticket, which event,
      |and when it was recorded. `with history` on the entry keeps every
      |version, which is what a log is.
    }
  }
  command LogKitchenTicketEvent is {
    loggedKitchenTicketId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the kitchen ticket the logged event concerns.
      }
    }
    loggedKitchenTicketEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of kitchen ticket event in one place and must not bind to any single
        |event's shape.
      }
    }
  } with {
    briefly "Log kitchen ticket event"
    described as {
      |Append a published kitchen ticket event to this context's event log.
    }
  }
  streamlet KitchenTicketEventLog as flow is {
    outlet KitchenTicketEventLogToKitchenTicketRepository is command LogKitchenTicketEvent
    inlet IncomingKitchenTicketLog is type KitchenTicketEvent    handler KitchenTicketLogIntake is {
      on other as m is {
        send command LogKitchenTicketEvent(loggedKitchenTicketId = m.kitchenTicketId, loggedKitchenTicketEventType = m.type) to outlet Kitchen.KitchenTicketEventLog.KitchenTicketEventLogToKitchenTicketRepository
      }
    } with {
      briefly "KitchenTicket log intake"
      described as {
        |Routes every published kitchen ticket event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "KitchenTicket event log"
    described as {
      |Durable local log of kitchen ticket events this context publishes.
    }
  }
  connector KitchenTicketToLog is from outlet Kitchen.KitchenTicketEventSource.KitchenTicketEvents to inlet Kitchen.KitchenTicketEventLog.IncomingKitchenTicketLog with {
    briefly "KitchenTicket event log connector"
    described as {
      |Wires published kitchen ticket events to the context's event log.
    }
  }
  streamlet KitchenTicketIntake as merge is {
    inlet IntakeAppCommands is type KitchenTicketCommand with {
      briefly "Staff commands originated by the application"
      described as {
        |What RestaurantApp sends: station assignment, preparation, item
        |readiness, approval, server notification.
      }
    }
    inlet IntakeExternalTickets is command KitchenTicket.ReceiveTicket with {
      briefly "Tickets originated by the order-taking contexts"
      described as {
        |What FrontOfHouse and OnlineOrdering send. A ticket enters the
        |kitchen this way; it is never typed at a terminal in the kitchen.
      }
    }
    outlet IntakeMergedCommands is type KitchenTicketCommand
 with {
      briefly "The two streams as one"
      described as {
        |Everything the KitchenTicket entity is asked to do, in one stream.
      }
    }
    handler KitchenTicketIntakeHandler is {
      on receiveTicket: command KitchenTicket.ReceiveTicket is {
        send receiveTicket to outlet Kitchen.KitchenTicketIntake.IntakeMergedCommands
      }
      on assignStation: command KitchenTicket.AssignStation is {
        send assignStation to outlet Kitchen.KitchenTicketIntake.IntakeMergedCommands
      }
      on startPreparation: command KitchenTicket.StartPreparation is {
        send startPreparation to outlet Kitchen.KitchenTicketIntake.IntakeMergedCommands
      }
      on markItemReady: command KitchenTicket.MarkItemReady is {
        send markItemReady to outlet Kitchen.KitchenTicketIntake.IntakeMergedCommands
      }
      on approveTicket: command KitchenTicket.ApproveTicket is {
        send approveTicket to outlet Kitchen.KitchenTicketIntake.IntakeMergedCommands
      }
      on notifyServer: command KitchenTicket.NotifyServer is {
        send notifyServer to outlet Kitchen.KitchenTicketIntake.IntakeMergedCommands
      }
      on other is {
        error "Unexpected message for streamlet KitchenTicketIntake"
      }
    } with {
      briefly "Kitchen ticket intake handler"
      described as {
        |One clause per concrete command: an alternation binding is a value,
        |not a message, so a single generic clause could not be sent onward.
      }
    }
  } with {
    briefly "Kitchen ticket intake merge"
    described as {
      |Joins the two ways work reaches the kitchen -- staff acting in the
      |application, and tickets arriving from front of house and online
      |ordering -- so the entity sees one ordered command stream.
    }
  }
  streamlet KitchenTicketEventSplit as split is {
    inlet KitchenTicketEventSplitIn is type KitchenTicketEvent    outlet KitchenTicketEventSplitToKitchenTicketEventSource is type KitchenTicketEvent
    outlet KitchenTicketEventSplitToKitchenTicketRepository is type KitchenTicketEvent
    outlet KitchenTicketEventSplitToKitchenDisplay is type KitchenTicketEvent
    handler KitchenTicketEventSplitHandler is {
      on ticketReceived: event KitchenTicket.TicketReceived is {
        send ticketReceived to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send ticketReceived to outlet KitchenTicketEventSplitToKitchenDisplay
        send ticketReceived to outlet KitchenTicketEventSplitToKitchenTicketEventSource
      }
      on stationAssigned: event KitchenTicket.StationAssigned is {
        send stationAssigned to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send stationAssigned to outlet KitchenTicketEventSplitToKitchenDisplay
        send stationAssigned to outlet KitchenTicketEventSplitToKitchenTicketEventSource
      }
      on preparationStarted: event KitchenTicket.PreparationStarted is {
        send preparationStarted to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send preparationStarted to outlet KitchenTicketEventSplitToKitchenDisplay
        send preparationStarted to outlet KitchenTicketEventSplitToKitchenTicketEventSource
      }
      on itemMarkedReady: event KitchenTicket.ItemMarkedReady is {
        send itemMarkedReady to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send itemMarkedReady to outlet KitchenTicketEventSplitToKitchenDisplay
      }
      on ticketApproved: event KitchenTicket.TicketApproved is {
        send ticketApproved to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send ticketApproved to outlet KitchenTicketEventSplitToKitchenDisplay
        send ticketApproved to outlet KitchenTicketEventSplitToKitchenTicketEventSource
      }
      on serverNotified: event KitchenTicket.ServerNotified is {
        send serverNotified to outlet KitchenTicketEventSplitToKitchenTicketRepository
        send serverNotified to outlet KitchenTicketEventSplitToKitchenDisplay
        send serverNotified to outlet KitchenTicketEventSplitToKitchenTicketEventSource
      }
      on other is {
        error "Unexpected message for processor KitchenTicketEventSplit"
      }
    } with {
      briefly "KitchenTicket event fan-out handler"
      described as {
        |Delivers each KitchenTicket event to all of its consumers.
      }
    }
  } with {
    briefly "KitchenTicket event fan-out"
    described as {
      |Fans KitchenTicket events out to the repository and projectors.
    }
  }
  connector 'KitchenTicketEventSource Feed' is from outlet Kitchen.KitchenTicketEventSplit.KitchenTicketEventSplitToKitchenTicketEventSource to inlet Kitchen.KitchenTicketEventSource.KitchenTicketEventSourceIn with {
    briefly "The events the KitchenTicket log keeps, on their way to it"
    described as {
      |The events the KitchenTicket log keeps, on their way to it.
    }
  }
  connector 'KitchenTicketEvent Stream' is from outlet Kitchen.KitchenTicket.KitchenTicketEvents2 to inlet Kitchen.KitchenTicketEventSplit.KitchenTicketEventSplitIn with {
    briefly "KitchenTicket events, fanned out to storage and read models"
    described as {
      |Carries what leaves KitchenTicketEvents2 to KitchenTicketEventSplitIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'KitchenTicketEvent Storage' is from outlet Kitchen.KitchenTicketEventSplit.KitchenTicketEventSplitToKitchenTicketRepository to inlet Kitchen.KitchenTicketProjection.KitchenTicketProjectionFromKitchenTicket with {
    briefly "KitchenTicket events on their way to storage"
    described as {
      |Carries what leaves KitchenTicketEventSplitToKitchenTicketRepository to KitchenTicketRepositoryFromKitchenTicket, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'KitchenDisplay Feed' is from outlet Kitchen.KitchenTicketEventSplit.KitchenTicketEventSplitToKitchenDisplay to inlet Kitchen.KitchenDisplay.KitchenDisplayFromKitchenTicket with {
    briefly "KitchenTicket events feeding the KitchenDisplay projection"
    described as {
      |Carries what leaves KitchenTicketEventSplitToKitchenDisplay to KitchenDisplayFromKitchenTicket, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'KitchenDisplay Storage' is from outlet Kitchen.KitchenDisplay.KitchenDisplayOut to inlet Kitchen.KitchenTicketRepository.KitchenTicketRepositoryFromKitchenDisplay with {
    briefly "The KitchenDisplay projection on its way to storage"
    described as {
      |Carries what leaves KitchenDisplayOut to KitchenTicketRepositoryFromKitchenDisplay, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'KitchenTicketEvent Queue Feed' is from outlet Kitchen.KitchenTicketEventSource.KitchenTicketEventsToQueue to inlet Kitchen.TicketQueue.IncomingTickets with {
    briefly "This context's own events to its queue"
    described as {
      |The queue works on events this context publishes, not on the raw events
      |another context happened to forward.
    }
  }
} with {
  option message_envelope("Riddl.Envelope")
  briefly "Kitchen context"
  described as {
    | Manages kitchen ticket queue, station assignments,
    | preparation tracking, and quality control. Provides
    | the kitchen display screen that replaces handwritten
    | tickets and prevents order loss during peak hours.
  }
}
