// Front of House shared types
type ReservationId is Id(FrontOfHouse.Reservation)  with {
  briefly "Reservation identifier"
  described as {
    |Unique identifier for a reservation.
  }
}
type TableOrderId is Id(FrontOfHouse.TableOrder)  with {
  briefly "Table order identifier"
  described as {
    |Unique identifier for a dine-in table order.
  }
}
type TableNumber is Natural with {
  briefly "Table number"
  described as {
    |Physical table number in the restaurant.
  }
}
type PartySize is range(1,20)  with {
  briefly "Party size"
  described as {
    |Number of guests in the party. Bounded rather than a bare Natural
    |because both ends are real: a booking for nobody is a mistake, and a
    |party above twenty is a private-event enquiry the host stand cannot
    |seat from the book.
  }
}
type GuestName is String(1,100) with {
  briefly "Guest name"
  described as {
    |Name of the guest for the reservation.
  }
}
type GuestPhone is Pattern("^\\+?[0-9][0-9 ()./-]{5,18}[0-9]$") with {
  briefly "Guest phone"
  described as {
    |Contact phone number for the guest. Shaped rather than merely
    |length-bounded because a phone taken down by a host over a noisy room
    |is the field most often mistyped, and it is the only way to reach a
    |walk-in booking when the table runs late.
    |
    |Deliberately permissive about separators — guests give numbers with
    |spaces, dashes, dots and brackets — while still requiring it to begin
    |and end with a digit and to allow a leading `+` for international
    |callers.
  }
}
// ReservationStatus enum removed — lifecycle phase is now
// modeled by distinct RIDDL states on the Reservation entity:
// Requested, Confirmed, Seated, Completed, Cancelled, NoShow
// OrderStatus enum removed — lifecycle phase is now modeled
// by distinct RIDDL states on the TableOrder entity: Draft,
// Submitted, InPreparation, ReadyToServe, BillPresented,
// PaymentComplete, Closed
type PaymentMethod is any of {
  Cash,
  CreditCard,
  DebitCard,
  MobilePayment,
  GiftCard
} with {
  briefly "Payment method"
  described as {
    |Method used to pay for the order.
  }
}
type MenuItemInfo is {
  itemCode: String(1,50) with {
    briefly "Item code"
    described as {
      |Identifier code for the menu item.
    }
  }
  itemName: String(1,200) with {
    briefly "Item name"
    described as {
      |Display name of the menu item.
    }
  }
  itemPrice: Decimal(8,2) with {
    briefly "Price"
    described as {
      |Price of the menu item.
    }
  }
  itemCategory: String(1,50) with {
    briefly "Category"
    described as {
      |Category such as appetizer, entree, drink, dessert.
    }
  }
} with {
  briefly "Menu item"
  described as {
    |An item from the restaurant menu.
  }
}
type OrderLine is {
  orderLineItem: MenuItemInfo with {
    briefly "Item"
    described as {
      |The menu item ordered.
    }
  }
  orderLineQuantity: Natural with {
    briefly "Quantity"
    described as {
      |Number of this item ordered.
    }
  }
  orderLineNotes: String(1,500)? with {
    briefly "Notes"
    described as {
      |Special instructions for this item.
    }
  }
} with {
  briefly "Order line"
  described as {
    |A single line item in an order.
  }
}
type ReservationEvent is one of {
  FrontOfHouse.Reservation.ReservationMade or FrontOfHouse.Reservation.ReservationConfirmed or FrontOfHouse.Reservation.ReservationCancelled or FrontOfHouse.Reservation.PartySeated or FrontOfHouse.Reservation.VisitCompleted or FrontOfHouse.Reservation.NoShowMarked or FrontOfHouse.Reservation.ReservationRescheduled or FrontOfHouse.Reservation.CancelReservationRejected or FrontOfHouse.Reservation.CompleteVisitRejected or FrontOfHouse.Reservation.ConfirmReservationRejected or FrontOfHouse.Reservation.MakeReservationRejected or FrontOfHouse.Reservation.MarkNoShowRejected or FrontOfHouse.Reservation.RescheduleReservationRejected or FrontOfHouse.Reservation.SeatPartyRejected
} with {
  briefly "Reservation event alternation"
  described as {
    |Union of all reservation events for streaming and
    |event-sourced persistence.
  }
}
type OrderEvent is one of {
  FrontOfHouse.TableOrder.OrderCreated or FrontOfHouse.TableOrder.ItemAdded or FrontOfHouse.TableOrder.ItemRemoved or FrontOfHouse.TableOrder.OrderSubmitted or FrontOfHouse.TableOrder.OrderMarkedInPreparation or FrontOfHouse.TableOrder.OrderMarkedReadyToServe or FrontOfHouse.TableOrder.BillPresented or FrontOfHouse.TableOrder.PaymentProcessed or FrontOfHouse.TableOrder.OrderClosed or FrontOfHouse.TableOrder.AddItemRejected or FrontOfHouse.TableOrder.CloseOrderRejected or FrontOfHouse.TableOrder.CreateOrderRejected or FrontOfHouse.TableOrder.MarkOrderInPreparationRejected or FrontOfHouse.TableOrder.MarkOrderReadyToServeRejected or FrontOfHouse.TableOrder.PresentBillRejected or FrontOfHouse.TableOrder.ProcessPaymentRejected or FrontOfHouse.TableOrder.RemoveItemRejected or FrontOfHouse.TableOrder.SubmitOrderRejected
} with {
  briefly "Order event alternation"
  described as {
    |Union of all table order events for streaming and
    |event-sourced persistence.
  }
}
type PaymentInfo is {
  paymentMethod: PaymentMethod with {
    briefly "Method"
    described as {
      |Payment method used.
    }
  }
  paymentAmount: Decimal(10,2) with {
    briefly "Amount"
    described as {
      |Amount paid.
    }
  }
  tipAmount: Decimal(8,2)? with {
    briefly "Tip"
    described as {
      |Tip amount if applicable.
    }
  }
  transactionRef: String(1,100)? with {
    briefly "Transaction reference"
    described as {
      |External payment transaction reference.
    }
  }
} with {
  briefly "Payment information"
  described as {
    |Payment details for an order.
  }
}
