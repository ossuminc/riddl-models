// TableOrder entity for the Front of House context
event-sourced entity TableOrder as flow is {
  type TableOrderCommand is one of {
    TableOrder.CreateOrder or TableOrder.AddItem or TableOrder.RemoveItem or TableOrder.SubmitOrder or TableOrder.PresentBill or TableOrder.ProcessPayment or TableOrder.CloseOrder or TableOrder.MarkOrderInPreparation or TableOrder.MarkOrderReadyToServe
  } with {
    briefly "TableOrder command alternation"
    described as {
      |Commands accepted by the TableOrder entity.
    }
  }
  type TableOrderEvent is one of {
    TableOrder.OrderCreated or TableOrder.ItemAdded or TableOrder.ItemRemoved or TableOrder.OrderSubmitted or TableOrder.BillPresented or TableOrder.PaymentProcessed or TableOrder.OrderClosed or TableOrder.OrderMarkedInPreparation or TableOrder.OrderMarkedReadyToServe or TableOrder.TicketRouted or TableOrder.DrinkOrderRouted or TableOrder.PointsAccrualRouted or TableOrder.CreateOrderRejected or TableOrder.AddItemRejected or TableOrder.RemoveItemRejected or TableOrder.SubmitOrderRejected or TableOrder.PresentBillRejected or TableOrder.ProcessPaymentRejected or TableOrder.CloseOrderRejected or TableOrder.MarkOrderInPreparationRejected or TableOrder.MarkOrderReadyToServeRejected
  } with {
    briefly "TableOrder event alternation"
    described as {
      |Events published by the TableOrder entity.
    }
  }
  inlet TableOrderCommands is type TableOrderCommand  outlet TableOrderEvents2 is type TableOrderEvent
  // ---- Commands ----
  command CreateOrder yields event OrderCreated is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Identifier for the new order.
      }
    }
    tableNumber: TableNumber with {
      briefly "Table"
      described as {
        |Table this order belongs to.
      }
    }
    serverId: String(1,50) with {
      briefly "Server ID"
      described as {
        |Identifier of the assigned server.
      }
    }
  } with {
    briefly "Create order"
    described as {
      |Create a new table order.
    }
  }
  command AddItem yields event ItemAdded is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order to add item to.
      }
    }
    addedItem: OrderLine with {
      briefly "Item"
      described as {
        |Line item to add.
      }
    }
  } with {
    briefly "Add item"
    described as {
      |Add a menu item to the order.
    }
  }
  command RemoveItem yields event ItemRemoved is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order to remove item from.
      }
    }
    removedMenuItemId: String(1,50) with {
      briefly "Menu item ID"
      described as {
        |Identifier of the menu item to remove.
      }
    }
  } with {
    briefly "Remove item"
    described as {
      |Remove a menu item from the order.
    }
  }
  command SubmitOrder yields event OrderSubmitted is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order to submit.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted at"
      described as {
        |When the order was submitted.
      }
    }
  } with {
    briefly "Submit order"
    described as {
      |Submit the order to kitchen and bar.
    }
  }
  command PresentBill yields event BillPresented is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order to present bill for.
      }
    }
    billTotal: Decimal(10,2) with {
      briefly "Total"
      described as {
        |Calculated bill total.
      }
    }
  } with {
    briefly "Present bill"
    described as {
      |Present the bill to the table.
    }
  }
  command ProcessPayment yields event PaymentProcessed is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order to process payment for.
      }
    }
    orderPayment: PaymentInfo with {
      briefly "Payment"
      described as {
        |Payment details.
      }
    }
  } with {
    briefly "Process payment"
    described as {
      |Process payment for the order.
    }
  }
  command CloseOrder yields event OrderClosed is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order to close.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed at"
      described as {
        |When the order was closed.
      }
    }
  } with {
    briefly "Close order"
    described as {
      |Close the order after payment.
    }
  }
  command MarkOrderInPreparation yields event OrderMarkedInPreparation is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order being prepared.
      }
    }
  } with {
    briefly "Mark order in preparation"
    described as {
      |Mark the order as actively being prepared by
      |kitchen and bar. Triggered by adaptor from Kitchen
      |context.
    }
  }
  command MarkOrderReadyToServe yields event OrderMarkedReadyToServe is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order that is ready.
      }
    }
    readyAt: TimeStamp with {
      briefly "Ready at"
      described as {
        |When all items became ready.
      }
    }
  } with {
    briefly "Mark order ready to serve"
    described as {
      |Mark the order as ready for serving. Triggered by
      |adaptor from Kitchen and Bar contexts when all items
      |are complete.
    }
  }
  // ---- Events ----
  event OrderCreated is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order just opened for this table. Every later event in the
        |order's life carries it, so the whole check can be assembled from
        |the event log.
      }
    }
    tableNumber: TableNumber with {
      briefly "Table"
      described as {
        |The table on the floor plan this order belongs to. This is the
        |number servers and the host stand say out loud, not a database
        |key -- two tables may be merged for a large party and still be
        |called by one number.
      }
    }
    serverId: String(1,50) with {
      briefly "Server ID"
      described as {
        |Assigned server.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the order was created.
      }
    }
  } with {
    briefly "Order created"
    described as {
      |Emitted when a new table order is created.
    }
  }
  event ItemAdded is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order the item was added to.
      }
    }
    addedItem: OrderLine with {
      briefly "Item"
      described as {
        |The line just added, with its own modifiers and course. Items are
        |added one at a time as the party orders, so the check grows through
        |the visit rather than arriving complete.
      }
    }
  } with {
    briefly "Item added"
    described as {
      |Emitted when an item is added to the order.
    }
  }
  event ItemRemoved is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order the item was removed from.
      }
    }
    removedMenuItemId: String(1,50) with {
      briefly "Menu item ID"
      described as {
        |The menu item taken off the check. Removal before the kitchen
        |fires it costs nothing; after, it becomes waste the kitchen has
        |already cooked.
      }
    }
  } with {
    briefly "Item removed"
    described as {
      |Emitted when an item is removed from the order.
    }
  }
  event OrderSubmitted is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order now sent to the kitchen and bar. Submission is the point
        |after which items cannot be removed without waste.
      }
    }
    orderItems: OrderLine+ with {
      briefly "Items"
      described as {
        |All items in the submitted order.
      }
    }
    tableNumber: TableNumber with {
      briefly "Table"
      described as {
        |The table this order is served at, carried so the kitchen ticket
        |and drink order know where the food and drinks are going.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted at"
      described as {
        |When the order was submitted.
      }
    }
  } with {
    briefly "Order submitted"
    described as {
      |Emitted when the order is submitted to kitchen and bar.
    }
  }
  event BillPresented is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order whose bill has been presented. The guest now has the
        |check in hand and the table is waiting on payment.
      }
    }
    billTotal: Decimal(10,2) with {
      briefly "Total"
      described as {
        |Bill total amount.
      }
    }
    presentedAt: TimeStamp with {
      briefly "Presented at"
      described as {
        |When the bill was presented.
      }
    }
  } with {
    briefly "Bill presented"
    described as {
      |Emitted when the bill is presented to the table.
    }
  }
  event PaymentProcessed is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order that has been paid. Payment does not close the table --
        |guests often linger after settling.
      }
    }
    orderPayment: PaymentInfo with {
      briefly "Payment"
      described as {
        |Payment details.
      }
    }
    processedAt: TimeStamp with {
      briefly "Processed at"
      described as {
        |When payment was processed.
      }
    }
  } with {
    briefly "Payment processed"
    described as {
      |Emitted when payment is successfully processed.
    }
  }
  event OrderClosed is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order now closed. Closing releases the table for the next
        |party and finalises the check for reporting.
      }
    }
    closedAt: TimeStamp with {
      briefly "Closed at"
      described as {
        |When the order was closed.
      }
    }
  } with {
    briefly "Order closed"
    described as {
      |Emitted when the order is closed after payment.
    }
  }
  event OrderMarkedInPreparation is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order the kitchen has started cooking.
      }
    }
  } with {
    briefly "Order in preparation"
    described as {
      |Emitted when the kitchen or bar begins preparing
      |the order.
    }
  }
  event OrderMarkedReadyToServe is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order whose food is ready for a server to run to the table.
      }
    }
    readyAt: TimeStamp with {
      briefly "Ready at"
      described as {
        |When all items were ready.
      }
    }
  } with {
    briefly "Order ready to serve"
    described as {
      |Emitted when all items for the order are ready
      |for serving.
    }
  }
  // ---- Routing Events ----
  event TicketRouted is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order whose food items were routed to the kitchen as a ticket.
      }
    }
    ticketRoutedAt: TimeStamp with {
      briefly "Routed at"
      described as {
        |When the food reached the kitchen. The kitchen's own clock starts
        |here, so this is the seam where responsibility for the cook passes
        |out of the dining room.
      }
    }
  } with {
    briefly "Ticket routed"
    described as {
      |Emitted when the food items of a submitted order are
      |routed to the Kitchen context as a kitchen ticket.
    }
  }
  event DrinkOrderRouted is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order whose drink items were routed to the bar. Drinks are
        |routed separately because the bar and kitchen work at different
        |speeds and the server collects from both.
      }
    }
    drinkOrderRoutedAt: TimeStamp with {
      briefly "Routed at"
      described as {
        |When the drinks reached the bar. Compared against the kitchen's
        |routing time, this is what tells a server whether drinks will land
        |before the food or long after it.
      }
    }
  } with {
    briefly "Drink order routed"
    described as {
      |Emitted when the drink items of a submitted order are
      |routed to the Bar context as a drink order.
    }
  }
  event PointsAccrualRouted is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order whose spend was sent to loyalty for point accrual.
      }
    }
    pointsAccrualRoutedAt: TimeStamp with {
      term Void is  "To cancel a check or a line on it before money changes hands, as when an order is rung up in error. Nothing was paid, so nothing is owed and nothing is earned." 
      term Comp is  "To give a check, or part of one, away deliberately — a manager's apology or a promotion. The food was served and costed, but no revenue is taken against it." 
      briefly "Routed at"
      described as {
        |When the spend was handed to loyalty. Accrual is deliberately after
        |payment, so a voided or comped check never earns points.
      }
    }
  } with {
    briefly "Points accrual routed"
    described as {
      |Emitted when a closed order's loyalty points accrual is
      |routed to the Loyalty context.
    }
  }
  // ---- Rejection Events ----
  event CreateOrderRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order the request would have opened.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the create order command was rejected.
      }
    }
  } with {
    briefly "Create order rejected"
    described as {
      |Emitted when a CreateOrder command is rejected.
    }
  }
  event AddItemRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order the item could not be added to, typically because the
        |check was already submitted.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the add item command was rejected.
      }
    }
  } with {
    briefly "Add item rejected"
    described as {
      |Emitted when an AddItem command is rejected.
    }
  }
  event RemoveItemRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order the item could not be removed from.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the remove item command was rejected.
      }
    }
  } with {
    briefly "Remove item rejected"
    described as {
      |Emitted when a RemoveItem command is rejected.
    }
  }
  event SubmitOrderRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order that could not be submitted, usually because it was
        |empty or already sent.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the submit order command was rejected.
      }
    }
  } with {
    briefly "Submit order rejected"
    described as {
      |Emitted when a SubmitOrder command is rejected.
    }
  }
  event PresentBillRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order whose bill could not be presented.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the present bill command was rejected.
      }
    }
  } with {
    briefly "Present bill rejected"
    described as {
      |Emitted when a PresentBill command is rejected.
    }
  }
  event ProcessPaymentRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order whose payment was refused.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the process payment command was rejected.
      }
    }
  } with {
    briefly "Process payment rejected"
    described as {
      |Emitted when a ProcessPayment command is rejected.
    }
  }
  event CloseOrderRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order that could not be closed, typically because payment was
        |still outstanding.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the close order command was rejected.
      }
    }
  } with {
    briefly "Close order rejected"
    described as {
      |Emitted when a CloseOrder command is rejected.
    }
  }
  event MarkOrderInPreparationRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order that could not be marked in preparation.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the mark in preparation command was rejected.
      }
    }
  } with {
    briefly "Mark in preparation rejected"
    described as {
      |Emitted when a MarkOrderInPreparation command is
      |rejected.
    }
  }
  event MarkOrderReadyToServeRejected is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order that could not be marked ready to serve.
      }
    }
    rejectionReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the mark ready to serve command was rejected.
      }
    }
  } with {
    briefly "Mark ready to serve rejected"
    described as {
      |Emitted when a MarkOrderReadyToServe command is
      |rejected.
    }
  }
  // ---- Query / Result ----
  query GetTableOrder is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |Order to retrieve.
      }
    }
  } with {
    briefly "Get table order"
    described as {
      |Query a table order by its identifier.
    }
  }
  result TableOrderResult is  {
    tableOrderId: TableOrderId with {
      briefly "TableOrder addressed"
      described as {
        |Which tableorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    order: TableOrderData with {
      briefly "Order"
      described as {
        |The requested table order data.
      }
    }
  } with {
    briefly "Table order result"
    described as {
      |Result containing the requested table order data.
    }
  }
  // ---- State ----
  record TableOrderData is  {
    tableOrderId: TableOrderId with {
      briefly "ID"
      described as {
        |The order these fields describe. Shared by every table-order state
        |record so identity survives each transition.
      }
    }
    tableNumber: TableNumber with {
      briefly "Table"
      described as {
        |The table on the floor plan this order is served at.
      }
    }
    serverId: String(1,50) with {
      briefly "Server ID"
      described as {
        |Assigned server.
      }
    }
    orderItems: OrderLine+ with {
      briefly "Items"
      described as {
        |Everything the party has ordered so far, food and drink together.
        |The check is one list even though it is routed to two places.
      }
    }
    presentedBillTotal: Decimal(10,2)? with {
      briefly "Total"
      described as {
        |What the guest was actually shown, frozen at presentation. Held
        |separately from the running total so a later addition cannot
        |silently change the figure the party agreed to pay.
      }
    }
    processedPayment: PaymentInfo? with {
      briefly "Payment"
      described as {
        |Payment info when processed.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the order was created.
      }
    }
    actualSubmittedAt: TimeStamp? with {
      briefly "Submitted at"
      described as {
        |When the order was submitted.
      }
    }
    readyAt: TimeStamp? with {
      briefly "Ready at"
      described as {
        |When all items were ready to serve.
      }
    }
    actualClosedAt: TimeStamp? with {
      briefly "Closed at"
      described as {
        |When the order was closed.
      }
    }
  } with {
    briefly "Table order state data"
    described as {
      |Full state of a table order. Shared across all
      |lifecycle states as a superset record.
    }
  }
  initial state Draft of record TableOrder.TableOrderData is {
    initial handler DraftHandler is {
      on init is {
        let orderCreated: type OrderCreated = prompt("the order created that brings this table order into existence")
        yield orderCreated
      }
      on addItem: command AddItem is {
        yield event ItemAdded(tableOrderId = addItem.tableOrderId, addedItem = addItem.addedItem)
        send event ItemAdded(tableOrderId = addItem.tableOrderId, addedItem = addItem.addedItem) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on event ItemAdded is {
        do "append ItemAdded.addedItem to
          TableOrderData.orderItems"
      }
      on removeItem: command RemoveItem is {
        yield event ItemRemoved(tableOrderId = removeItem.tableOrderId, removedMenuItemId = removeItem.removedMenuItemId)
        send event ItemRemoved(tableOrderId = removeItem.tableOrderId, removedMenuItemId = removeItem.removedMenuItemId) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on event ItemRemoved is {
        do "remove OrderLine from TableOrderData.orderItems
          where orderLineItem.itemCode = ItemRemoved
          .removedMenuItemId"
      }
      on submitOrder: command SubmitOrder is {
        yield event OrderSubmitted(tableOrderId = submitOrder.tableOrderId, submittedAt = submitOrder.submittedAt, orderItems = TableOrderData.orderItems, tableNumber = TableOrderData.tableNumber)
        send event OrderSubmitted(tableOrderId = submitOrder.tableOrderId, submittedAt = submitOrder.submittedAt, orderItems = TableOrderData.orderItems, tableNumber = TableOrderData.tableNumber) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on orderSubmitted: event OrderSubmitted is {
        morph entity FrontOfHouse.TableOrder to state FrontOfHouse.TableOrder.Submitted with record TableOrder.TableOrderData(tableOrderId = orderSubmitted.tableOrderId, tableNumber = orderSubmitted.tableNumber, orderItems = orderSubmitted.orderItems, serverId = TableOrderData.serverId, presentedBillTotal = TableOrderData.presentedBillTotal, processedPayment = TableOrderData.processedPayment, createdAt = TableOrderData.createdAt, actualSubmittedAt = TableOrderData.actualSubmittedAt, readyAt = TableOrderData.readyAt, actualClosedAt = TableOrderData.actualClosedAt)
        set field TableOrder.Submitted.actualSubmittedAt to "submittedAt from event"
        set state TableOrder.Submitted to "tableOrderId, tableNumber,
          serverId, orderItems, presentedBillTotal = none,
          processedPayment = none, createdAt,
          actualSubmittedAt = populated,
          readyAt = none, actualClosedAt = none"
      }
      on createOrder: command CreateOrder is {
        error "TableOrder does not accept CreateOrder in this state"
        send event CreateOrderRejected(tableOrderId = createOrder.tableOrderId, rejectionReason = "TableOrder does not accept CreateOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderInPreparation: command MarkOrderInPreparation is {
        error "TableOrder does not accept MarkOrderInPreparation in this state"
        send event MarkOrderInPreparationRejected(tableOrderId = markOrderInPreparation.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderInPreparation in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderReadyToServe: command MarkOrderReadyToServe is {
        error "TableOrder does not accept MarkOrderReadyToServe in this state"
        send event MarkOrderReadyToServeRejected(tableOrderId = markOrderReadyToServe.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderReadyToServe in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on presentBill: command PresentBill is {
        error "TableOrder does not accept PresentBill in this state"
        send event PresentBillRejected(tableOrderId = presentBill.tableOrderId, rejectionReason = "TableOrder does not accept PresentBill in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on processPayment: command ProcessPayment is {
        error "TableOrder does not accept ProcessPayment in this state"
        send event ProcessPaymentRejected(tableOrderId = processPayment.tableOrderId, rejectionReason = "TableOrder does not accept ProcessPayment in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on closeOrder: command CloseOrder is {
        error "TableOrder does not accept CloseOrder in this state"
        send event CloseOrderRejected(tableOrderId = closeOrder.tableOrderId, rejectionReason = "TableOrder does not accept CloseOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
    } with {
      briefly "Draft state handler"
      described as {
        |Handles commands valid in the Draft state.
        |AddItem and RemoveItem modify the order. SubmitOrder
        |freezes items and routes to kitchen and bar.
      }
    }
  } with {
    briefly "Draft order"
    described as {
      |Order is being composed. Items can be added or
      |removed before submission.
    }
  }
  state Submitted of record TableOrder.TableOrderData is {
    initial handler SubmittedHandler is {
      on init is {
        let orderSubmitted: type OrderSubmitted = prompt("the order submitted that brings this front of house into existence")
        yield orderSubmitted
      }
      on markOrderInPreparation: command MarkOrderInPreparation is {
        yield event OrderMarkedInPreparation(tableOrderId = markOrderInPreparation.tableOrderId)
        send event OrderMarkedInPreparation(tableOrderId = markOrderInPreparation.tableOrderId) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on orderMarkedInPreparation: event OrderMarkedInPreparation is {
        morph entity FrontOfHouse.TableOrder to state FrontOfHouse.TableOrder.InPreparation with record TableOrder.TableOrderData(tableOrderId = orderMarkedInPreparation.tableOrderId, tableNumber = TableOrderData.tableNumber, serverId = TableOrderData.serverId, orderItems = TableOrderData.orderItems, presentedBillTotal = TableOrderData.presentedBillTotal, processedPayment = TableOrderData.processedPayment, createdAt = TableOrderData.createdAt, actualSubmittedAt = TableOrderData.actualSubmittedAt, readyAt = TableOrderData.readyAt, actualClosedAt = TableOrderData.actualClosedAt)
        set state TableOrder.InPreparation to "tableOrderId, tableNumber,
          serverId, orderItems, presentedBillTotal = none,
          processedPayment = none, createdAt,
          actualSubmittedAt = populated,
          readyAt = none, actualClosedAt = none"
      }
      on createOrder: command CreateOrder is {
        error "TableOrder does not accept CreateOrder in this state"
        send event CreateOrderRejected(tableOrderId = createOrder.tableOrderId, rejectionReason = "TableOrder does not accept CreateOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on addItem: command AddItem is {
        error "TableOrder does not accept AddItem in this state"
        send event AddItemRejected(tableOrderId = addItem.tableOrderId, rejectionReason = "TableOrder does not accept AddItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on removeItem: command RemoveItem is {
        error "TableOrder does not accept RemoveItem in this state"
        send event RemoveItemRejected(tableOrderId = removeItem.tableOrderId, rejectionReason = "TableOrder does not accept RemoveItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on submitOrder: command SubmitOrder is {
        error "TableOrder does not accept SubmitOrder in this state"
        send event SubmitOrderRejected(tableOrderId = submitOrder.tableOrderId, rejectionReason = "TableOrder does not accept SubmitOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderReadyToServe: command MarkOrderReadyToServe is {
        error "TableOrder does not accept MarkOrderReadyToServe in this state"
        send event MarkOrderReadyToServeRejected(tableOrderId = markOrderReadyToServe.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderReadyToServe in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on presentBill: command PresentBill is {
        error "TableOrder does not accept PresentBill in this state"
        send event PresentBillRejected(tableOrderId = presentBill.tableOrderId, rejectionReason = "TableOrder does not accept PresentBill in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on processPayment: command ProcessPayment is {
        error "TableOrder does not accept ProcessPayment in this state"
        send event ProcessPaymentRejected(tableOrderId = processPayment.tableOrderId, rejectionReason = "TableOrder does not accept ProcessPayment in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on closeOrder: command CloseOrder is {
        error "TableOrder does not accept CloseOrder in this state"
        send event CloseOrderRejected(tableOrderId = closeOrder.tableOrderId, rejectionReason = "TableOrder does not accept CloseOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
    } with {
      briefly "Submitted state handler"
      described as {
        |Handles commands valid in the Submitted state.
        |Only MarkOrderInPreparation advances the lifecycle.
      }
    }
  } with {
    briefly "Order submitted"
    described as {
      |Order has been submitted to kitchen and bar for
      |preparation. Items are frozen.
    }
  }
  state InPreparation of record TableOrder.TableOrderData is {
    initial handler InPreparationHandler is {
      on init is {
        let orderMarkedInPreparation: type OrderMarkedInPreparation = prompt("the order marked in preparation that brings this front of house into existence")
        yield orderMarkedInPreparation
      }
      on markOrderReadyToServe: command MarkOrderReadyToServe is {
        yield event OrderMarkedReadyToServe(tableOrderId = markOrderReadyToServe.tableOrderId, readyAt = markOrderReadyToServe.readyAt)
        send event OrderMarkedReadyToServe(tableOrderId = markOrderReadyToServe.tableOrderId, readyAt = markOrderReadyToServe.readyAt) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on orderMarkedReadyToServe: event OrderMarkedReadyToServe is {
        morph entity FrontOfHouse.TableOrder to state FrontOfHouse.TableOrder.ReadyToServe with record TableOrder.TableOrderData(tableOrderId = orderMarkedReadyToServe.tableOrderId, readyAt = orderMarkedReadyToServe.readyAt, tableNumber = TableOrderData.tableNumber, serverId = TableOrderData.serverId, orderItems = TableOrderData.orderItems, presentedBillTotal = TableOrderData.presentedBillTotal, processedPayment = TableOrderData.processedPayment, createdAt = TableOrderData.createdAt, actualSubmittedAt = TableOrderData.actualSubmittedAt, actualClosedAt = TableOrderData.actualClosedAt)
        set field TableOrder.ReadyToServe.readyAt to "readyAt from event"
        set state ReadyToServe to "tableOrderId, tableNumber,
          serverId, orderItems, presentedBillTotal = none,
          processedPayment = none, createdAt,
          actualSubmittedAt = populated,
          readyAt = populated, actualClosedAt = none"
      }
      on createOrder: command CreateOrder is {
        error "TableOrder does not accept CreateOrder in this state"
        send event CreateOrderRejected(tableOrderId = createOrder.tableOrderId, rejectionReason = "TableOrder does not accept CreateOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on addItem: command AddItem is {
        error "TableOrder does not accept AddItem in this state"
        send event AddItemRejected(tableOrderId = addItem.tableOrderId, rejectionReason = "TableOrder does not accept AddItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on removeItem: command RemoveItem is {
        error "TableOrder does not accept RemoveItem in this state"
        send event RemoveItemRejected(tableOrderId = removeItem.tableOrderId, rejectionReason = "TableOrder does not accept RemoveItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on submitOrder: command SubmitOrder is {
        error "TableOrder does not accept SubmitOrder in this state"
        send event SubmitOrderRejected(tableOrderId = submitOrder.tableOrderId, rejectionReason = "TableOrder does not accept SubmitOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderInPreparation: command MarkOrderInPreparation is {
        error "TableOrder does not accept MarkOrderInPreparation in this state"
        send event MarkOrderInPreparationRejected(tableOrderId = markOrderInPreparation.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderInPreparation in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on presentBill: command PresentBill is {
        error "TableOrder does not accept PresentBill in this state"
        send event PresentBillRejected(tableOrderId = presentBill.tableOrderId, rejectionReason = "TableOrder does not accept PresentBill in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on processPayment: command ProcessPayment is {
        error "TableOrder does not accept ProcessPayment in this state"
        send event ProcessPaymentRejected(tableOrderId = processPayment.tableOrderId, rejectionReason = "TableOrder does not accept ProcessPayment in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on closeOrder: command CloseOrder is {
        error "TableOrder does not accept CloseOrder in this state"
        send event CloseOrderRejected(tableOrderId = closeOrder.tableOrderId, rejectionReason = "TableOrder does not accept CloseOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
    } with {
      briefly "InPreparation state handler"
      described as {
        |Handles commands valid in the InPreparation state.
        |Only MarkOrderReadyToServe advances the lifecycle.
      }
    }
  } with {
    briefly "In preparation"
    described as {
      |Kitchen and bar are actively preparing the items.
    }
  }
  state ReadyToServe of record TableOrder.TableOrderData is {
    initial handler ReadyToServeHandler is {
      on init is {
        let orderMarkedReadyToServe: type OrderMarkedReadyToServe = prompt("the order marked ready to serve that brings this front of house into existence")
        yield orderMarkedReadyToServe
      }
      on presentBill: command PresentBill is {
        yield event BillPresented(tableOrderId = presentBill.tableOrderId, billTotal = presentBill.billTotal, presentedAt = prompt("the presented at of this bill presented"))
        send event BillPresented(tableOrderId = presentBill.tableOrderId, billTotal = presentBill.billTotal, presentedAt = prompt("the presented at of this bill presented")) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on billPresented: event BillPresented is {
        morph entity FrontOfHouse.TableOrder to state FrontOfHouse.TableOrder.BillPresentedState with record TableOrder.TableOrderData(tableOrderId = billPresented.tableOrderId, tableNumber = TableOrderData.tableNumber, serverId = TableOrderData.serverId, orderItems = TableOrderData.orderItems, presentedBillTotal = TableOrderData.presentedBillTotal, processedPayment = TableOrderData.processedPayment, createdAt = TableOrderData.createdAt, actualSubmittedAt = TableOrderData.actualSubmittedAt, readyAt = TableOrderData.readyAt, actualClosedAt = TableOrderData.actualClosedAt)
        do "sum TableOrderData.orderItems applying
          orderLineItem.itemPrice * orderLineQuantity for each
          OrderLine to compute presentedBillTotal"
        set field TableOrder.BillPresentedState.presentedBillTotal to "computed presentedBillTotal"
        set state BillPresentedState to "tableOrderId,
          tableNumber, serverId, orderItems,
          presentedBillTotal = populated,
          processedPayment = none, createdAt,
          actualSubmittedAt = populated,
          readyAt = populated, actualClosedAt = none"
      }
      on createOrder: command CreateOrder is {
        error "TableOrder does not accept CreateOrder in this state"
        send event CreateOrderRejected(tableOrderId = createOrder.tableOrderId, rejectionReason = "TableOrder does not accept CreateOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on addItem: command AddItem is {
        error "TableOrder does not accept AddItem in this state"
        send event AddItemRejected(tableOrderId = addItem.tableOrderId, rejectionReason = "TableOrder does not accept AddItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on removeItem: command RemoveItem is {
        error "TableOrder does not accept RemoveItem in this state"
        send event RemoveItemRejected(tableOrderId = removeItem.tableOrderId, rejectionReason = "TableOrder does not accept RemoveItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on submitOrder: command SubmitOrder is {
        error "TableOrder does not accept SubmitOrder in this state"
        send event SubmitOrderRejected(tableOrderId = submitOrder.tableOrderId, rejectionReason = "TableOrder does not accept SubmitOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderInPreparation: command MarkOrderInPreparation is {
        error "TableOrder does not accept MarkOrderInPreparation in this state"
        send event MarkOrderInPreparationRejected(tableOrderId = markOrderInPreparation.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderInPreparation in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderReadyToServe: command MarkOrderReadyToServe is {
        error "TableOrder does not accept MarkOrderReadyToServe in this state"
        send event MarkOrderReadyToServeRejected(tableOrderId = markOrderReadyToServe.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderReadyToServe in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on processPayment: command ProcessPayment is {
        error "TableOrder does not accept ProcessPayment in this state"
        send event ProcessPaymentRejected(tableOrderId = processPayment.tableOrderId, rejectionReason = "TableOrder does not accept ProcessPayment in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on closeOrder: command CloseOrder is {
        error "TableOrder does not accept CloseOrder in this state"
        send event CloseOrderRejected(tableOrderId = closeOrder.tableOrderId, rejectionReason = "TableOrder does not accept CloseOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
    } with {
      briefly "ReadyToServe state handler"
      described as {
        |Handles commands valid in the ReadyToServe state.
        |Only PresentBill advances the lifecycle.
      }
    }
  } with {
    briefly "Ready to serve"
    described as {
      |All items are ready and waiting for the server to
      |deliver them to the table.
    }
  }
  state BillPresentedState of record TableOrder.TableOrderData is {
    initial handler BillPresentedHandler is {
      on init is {
        let billPresented: type BillPresented = prompt("the bill presented that brings this front of house into existence")
        yield billPresented
      }
      on processPayment: command ProcessPayment is {
        yield event PaymentProcessed(tableOrderId = processPayment.tableOrderId, orderPayment = processPayment.orderPayment, processedAt = prompt("the processed at of this payment processed"))
        send event PaymentProcessed(tableOrderId = processPayment.tableOrderId, orderPayment = processPayment.orderPayment, processedAt = prompt("the processed at of this payment processed")) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on paymentProcessed: event PaymentProcessed is {
        morph entity FrontOfHouse.TableOrder to state FrontOfHouse.TableOrder.PaymentComplete with record TableOrder.TableOrderData(tableOrderId = paymentProcessed.tableOrderId, tableNumber = TableOrderData.tableNumber, serverId = TableOrderData.serverId, orderItems = TableOrderData.orderItems, presentedBillTotal = TableOrderData.presentedBillTotal, processedPayment = TableOrderData.processedPayment, createdAt = TableOrderData.createdAt, actualSubmittedAt = TableOrderData.actualSubmittedAt, readyAt = TableOrderData.readyAt, actualClosedAt = TableOrderData.actualClosedAt)
        set field TableOrder.PaymentComplete.processedPayment to "payment info from event"
        do "PaymentProcessed event triggers PaymentGateway
          authorization via streaming topology and Loyalty
          point accrual via ToLoyalty adaptor"
        set state PaymentComplete to "tableOrderId,
          tableNumber, serverId, orderItems,
          presentedBillTotal = populated,
          processedPayment = populated, createdAt,
          actualSubmittedAt = populated,
          readyAt = populated, actualClosedAt = none"
      }
      on createOrder: command CreateOrder is {
        error "TableOrder does not accept CreateOrder in this state"
        send event CreateOrderRejected(tableOrderId = createOrder.tableOrderId, rejectionReason = "TableOrder does not accept CreateOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on addItem: command AddItem is {
        error "TableOrder does not accept AddItem in this state"
        send event AddItemRejected(tableOrderId = addItem.tableOrderId, rejectionReason = "TableOrder does not accept AddItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on removeItem: command RemoveItem is {
        error "TableOrder does not accept RemoveItem in this state"
        send event RemoveItemRejected(tableOrderId = removeItem.tableOrderId, rejectionReason = "TableOrder does not accept RemoveItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on submitOrder: command SubmitOrder is {
        error "TableOrder does not accept SubmitOrder in this state"
        send event SubmitOrderRejected(tableOrderId = submitOrder.tableOrderId, rejectionReason = "TableOrder does not accept SubmitOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderInPreparation: command MarkOrderInPreparation is {
        error "TableOrder does not accept MarkOrderInPreparation in this state"
        send event MarkOrderInPreparationRejected(tableOrderId = markOrderInPreparation.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderInPreparation in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderReadyToServe: command MarkOrderReadyToServe is {
        error "TableOrder does not accept MarkOrderReadyToServe in this state"
        send event MarkOrderReadyToServeRejected(tableOrderId = markOrderReadyToServe.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderReadyToServe in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on presentBill: command PresentBill is {
        error "TableOrder does not accept PresentBill in this state"
        send event PresentBillRejected(tableOrderId = presentBill.tableOrderId, rejectionReason = "TableOrder does not accept PresentBill in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on closeOrder: command CloseOrder is {
        error "TableOrder does not accept CloseOrder in this state"
        send event CloseOrderRejected(tableOrderId = closeOrder.tableOrderId, rejectionReason = "TableOrder does not accept CloseOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
    } with {
      briefly "BillPresented state handler"
      described as {
        |Handles commands valid in the BillPresented state.
        |Only ProcessPayment advances the lifecycle.
      }
    }
  } with {
    briefly "Bill presented"
    described as {
      |Bill has been calculated and presented to the table.
      |Awaiting payment.
    }
  }
  state PaymentComplete of record TableOrder.TableOrderData is {
    initial handler PaymentCompleteHandler is {
      on init is {
        let paymentProcessed: type PaymentProcessed = prompt("the payment processed that brings this front of house into existence")
        yield paymentProcessed
      }
      on closeOrder: command CloseOrder is {
        yield event OrderClosed(tableOrderId = closeOrder.tableOrderId, closedAt = closeOrder.closedAt)
        send event OrderClosed(tableOrderId = closeOrder.tableOrderId, closedAt = closeOrder.closedAt) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on orderClosed: event OrderClosed is {
        morph entity FrontOfHouse.TableOrder to state FrontOfHouse.TableOrder.Closed with record TableOrder.TableOrderData(tableOrderId = orderClosed.tableOrderId, tableNumber = TableOrderData.tableNumber, serverId = TableOrderData.serverId, orderItems = TableOrderData.orderItems, presentedBillTotal = TableOrderData.presentedBillTotal, processedPayment = TableOrderData.processedPayment, createdAt = TableOrderData.createdAt, actualSubmittedAt = TableOrderData.actualSubmittedAt, readyAt = TableOrderData.readyAt, actualClosedAt = TableOrderData.actualClosedAt)
        set field TableOrder.Closed.actualClosedAt to "closedAt from event"
        do "OrderClosed event triggers accounting transaction
          posting via streaming topology"
        terminate self.id
        set state TableOrder.Closed to "tableOrderId, tableNumber,
          serverId, orderItems,
          presentedBillTotal = populated,
          processedPayment = populated, createdAt,
          actualSubmittedAt = populated,
          readyAt = populated,
          actualClosedAt = populated"
      }
      on createOrder: command CreateOrder is {
        error "TableOrder does not accept CreateOrder in this state"
        send event CreateOrderRejected(tableOrderId = createOrder.tableOrderId, rejectionReason = "TableOrder does not accept CreateOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on addItem: command AddItem is {
        error "TableOrder does not accept AddItem in this state"
        send event AddItemRejected(tableOrderId = addItem.tableOrderId, rejectionReason = "TableOrder does not accept AddItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on removeItem: command RemoveItem is {
        error "TableOrder does not accept RemoveItem in this state"
        send event RemoveItemRejected(tableOrderId = removeItem.tableOrderId, rejectionReason = "TableOrder does not accept RemoveItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on submitOrder: command SubmitOrder is {
        error "TableOrder does not accept SubmitOrder in this state"
        send event SubmitOrderRejected(tableOrderId = submitOrder.tableOrderId, rejectionReason = "TableOrder does not accept SubmitOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderInPreparation: command MarkOrderInPreparation is {
        error "TableOrder does not accept MarkOrderInPreparation in this state"
        send event MarkOrderInPreparationRejected(tableOrderId = markOrderInPreparation.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderInPreparation in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderReadyToServe: command MarkOrderReadyToServe is {
        error "TableOrder does not accept MarkOrderReadyToServe in this state"
        send event MarkOrderReadyToServeRejected(tableOrderId = markOrderReadyToServe.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderReadyToServe in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on presentBill: command PresentBill is {
        error "TableOrder does not accept PresentBill in this state"
        send event PresentBillRejected(tableOrderId = presentBill.tableOrderId, rejectionReason = "TableOrder does not accept PresentBill in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on processPayment: command ProcessPayment is {
        error "TableOrder does not accept ProcessPayment in this state"
        send event ProcessPaymentRejected(tableOrderId = processPayment.tableOrderId, rejectionReason = "TableOrder does not accept ProcessPayment in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
    } with {
      briefly "PaymentComplete state handler"
      described as {
        |Handles commands valid in the PaymentComplete state.
        |Only CloseOrder advances the lifecycle.
      }
    }
  } with {
    briefly "Payment complete"
    described as {
      |Payment has been processed through the payment
      |gateway. Awaiting order closure.
    }
  }
  state Closed of record TableOrder.TableOrderData is {
    initial handler ClosedHandler is {
      on init is {
        let orderClosed: type OrderClosed = prompt("the order closed that brings this front of house into existence")
        yield orderClosed
      }
      on createOrder: command CreateOrder is {
        error "TableOrder does not accept CreateOrder in this state"
        send event CreateOrderRejected(tableOrderId = createOrder.tableOrderId, rejectionReason = "TableOrder does not accept CreateOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on addItem: command AddItem is {
        error "TableOrder does not accept AddItem in this state"
        send event AddItemRejected(tableOrderId = addItem.tableOrderId, rejectionReason = "TableOrder does not accept AddItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on removeItem: command RemoveItem is {
        error "TableOrder does not accept RemoveItem in this state"
        send event RemoveItemRejected(tableOrderId = removeItem.tableOrderId, rejectionReason = "TableOrder does not accept RemoveItem in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on submitOrder: command SubmitOrder is {
        error "TableOrder does not accept SubmitOrder in this state"
        send event SubmitOrderRejected(tableOrderId = submitOrder.tableOrderId, rejectionReason = "TableOrder does not accept SubmitOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderInPreparation: command MarkOrderInPreparation is {
        error "TableOrder does not accept MarkOrderInPreparation in this state"
        send event MarkOrderInPreparationRejected(tableOrderId = markOrderInPreparation.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderInPreparation in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on markOrderReadyToServe: command MarkOrderReadyToServe is {
        error "TableOrder does not accept MarkOrderReadyToServe in this state"
        send event MarkOrderReadyToServeRejected(tableOrderId = markOrderReadyToServe.tableOrderId, rejectionReason = "TableOrder does not accept MarkOrderReadyToServe in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on presentBill: command PresentBill is {
        error "TableOrder does not accept PresentBill in this state"
        send event PresentBillRejected(tableOrderId = presentBill.tableOrderId, rejectionReason = "TableOrder does not accept PresentBill in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on processPayment: command ProcessPayment is {
        error "TableOrder does not accept ProcessPayment in this state"
        send event ProcessPaymentRejected(tableOrderId = processPayment.tableOrderId, rejectionReason = "TableOrder does not accept ProcessPayment in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
      on closeOrder: command CloseOrder is {
        error "TableOrder does not accept CloseOrder in this state"
        send event CloseOrderRejected(tableOrderId = closeOrder.tableOrderId, rejectionReason = "TableOrder does not accept CloseOrder in this state") to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
      }
    } with {
      briefly "Closed state handler"
      described as {
        |Terminal state. All commands are rejected.
      }
    }
  } with {
    briefly "Order closed"
    described as {
      |Order has been finalized after payment. Terminal
      |state.
    }
  }
  handler TableOrderCreationHandler is {
    on createOrder: command CreateOrder is {
      yield event OrderCreated(tableOrderId = createOrder.tableOrderId, tableNumber = createOrder.tableNumber, serverId = createOrder.serverId, createdAt = TableOrderData.createdAt)
      send event OrderCreated(tableOrderId = createOrder.tableOrderId, tableNumber = createOrder.tableNumber, serverId = createOrder.serverId, createdAt = TableOrderData.createdAt) to outlet FrontOfHouse.TableOrderEventSource.TableOrderEvents
    }
    on orderCreated: event OrderCreated is {
      morph entity FrontOfHouse.TableOrder to state FrontOfHouse.TableOrder.Draft with record TableOrder.TableOrderData(tableOrderId = orderCreated.tableOrderId, tableNumber = orderCreated.tableNumber, serverId = orderCreated.serverId, createdAt = orderCreated.createdAt, orderItems = TableOrderData.orderItems, presentedBillTotal = TableOrderData.presentedBillTotal, processedPayment = TableOrderData.processedPayment, actualSubmittedAt = TableOrderData.actualSubmittedAt, readyAt = TableOrderData.readyAt, actualClosedAt = TableOrderData.actualClosedAt)
      set state TableOrder.Draft to "tableOrderId, tableNumber,
          serverId, orderItems = empty,
          presentedBillTotal = none,
          processedPayment = none,
          createdAt = OrderCreated.createdAt,
          actualSubmittedAt = none, readyAt = none,
          actualClosedAt = none"
    }
    on query GetTableOrder is {
      do "look up TableOrder by GetTableOrder.tableOrderId"
      let tableOrderResult: type TableOrderResult = prompt("read the table order from the store")
      tell tableOrderResult to entity FrontOfHouse.TableOrder
    }
  } with {
    briefly "Table order creation handler"
    described as {
      |Handles the initial CreateOrder command when
      |the entity has no state yet.
    }
  }
} with {
  briefly "Table order entity"
  described as {
    | Manages the full lifecycle of a dine-in table order
    | from creation through item management, submission
    | to kitchen and bar, billing, payment, and closing.
    | State handlers ensure commands are only valid in
    | appropriate states, and events are persisted before
    | state transitions.
  }
}
