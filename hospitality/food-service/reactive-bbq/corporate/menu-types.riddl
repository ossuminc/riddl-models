// Menu Management shared types
type MenuItemId is Id(MenuManagement.MenuItem)  with {
  briefly "Menu item identifier"
  described as {
    |Unique identifier for a corporate menu item.
  }
}
type MenuReleaseId is Id(MenuManagement.MenuRelease)  with {
  briefly "Menu release identifier"
  described as {
    |Unique identifier for a menu release.
  }
}
type MenuItemCategory is any of {
  Appetizer,
  Entree,
  Side,
  Dessert,
  Beverage,
  Special
} with {
  briefly "Menu item category"
  described as {
    |Category of the menu item.
  }
}
type MenuReleaseAction is any of {
  AddToMenu,
  ChangeOnMenu,
  WithdrawFromMenu
} with {
  briefly "What a release does to one dish"
  described as {
    |A release is a set of changes to the restaurants' menu. Each entry adds
    |a dish the restaurants do not yet serve, changes how one they serve is
    |listed, or withdraws one from their menus.
  }
}
type ReleasedMenuItem is {
  releasedItemCode: String(1,50) with {
    briefly "Item code"
    described as {
      |The code the restaurants order this dish by: what a table order line
      |carries as its item code and an online cart line as its menu item id.
    }
  }
  releasedItemName: String(1,200) with {
    briefly "Name"
    described as {
      |The dish's name as the restaurants list it.
    }
  }
  releasedItemCategory: MenuItemCategory with {
    briefly "Category"
    described as {
      |Where on the menu the dish appears.
    }
  }
  releasedItemPrice: Decimal(8,2) with {
    briefly "Price"
    described as {
      |The price the restaurants charge for the dish.
    }
  }
  releasedAction: MenuReleaseAction with {
    briefly "Action"
    described as {
      |Whether this entry adds the dish, changes its listing, or withdraws it.
    }
  }
} with {
  briefly "One dish's entry in a menu release"
  described as {
    |The dish as the menu desk put it into the release: its code, name,
    |category and price, and what the release does with it. The details are
    |taken when the desk adds the dish, so the release carries the listing it
    |was signed off with rather than whatever the corporate menu item says
    |later; adding the dish again replaces its entry.
  }
}
type MenuItemLifecycle is any of {
  DraftLifecycle,
  ActiveLifecycle,
  Seasonal,
  Retired
} with {
  briefly "Menu item lifecycle"
  described as {
    |Current lifecycle stage of a menu item.
  }
}
type MenuReleaseStatus is any of {
  ReleaseDraftStatus,
  ReleaseFinalizedStatus,
  ReleasePublishedStatus,
  ReleaseRolledBackStatus
} with {
  briefly "Menu release status"
  described as {
    |Current status of a menu release.
  }
}
type RecipeInfo is {
  recipeInstructions: String(1,5000) with {
    briefly "Instructions"
    described as {
      |Preparation instructions.
    }
  }
  recipeIngredients: String(1,200)+ with {
    briefly "Ingredients"
    described as {
      |List of ingredients.
    }
  }
  prepTime: Duration with {
    briefly "Prep time"
    described as {
      |Preparation time.
    }
  }
  cookTime: Duration with {
    briefly "Cook time"
    described as {
      |Cooking time.
    }
  }
  servings: Natural with {
    briefly "Servings"
    described as {
      |Number of servings.
    }
  }
} with {
  briefly "Recipe information"
  described as {
    |Recipe details for a menu item.
  }
}
type PriceInfo is {
  basePrice: Decimal(8,2) with {
    briefly "Base price"
    described as {
      |Standard menu price.
    }
  }
  costToMake: Decimal(8,2) with {
    briefly "Cost"
    described as {
      |Cost to prepare the item.
    }
  }
  marginPercent: Decimal(5,2) with {
    briefly "Margin"
    described as {
      |Profit margin percentage.
    }
  }
} with {
  briefly "Price information"
  described as {
    |Pricing and cost details for a menu item.
  }
}
type MenuItemEvent is one of {
  MenuItem.MenuItemCreated or MenuItem.MenuItemUpdated or MenuItem.PriceSet or MenuItem.MenuItemRetired or MenuItem.PhotoShootCompletionRecorded
} with {
  briefly "Menu item event type"
  described as {
    |Union of all menu item entity events.
  }
}
type MenuDistributionEvent is one of {
  MenuRelease.ReleasePublished or MenuRelease.ReleaseRolledBack
} with {
  briefly "The menu release events distributed to the restaurants"
  described as {
    |Only publication and rollback cross to FrontOfHouse; the earlier
    |lifecycle events are Corporate's own business. A port carries one type,
    |so the channel needs a name for exactly what it admits.
  }
}
type MenuReleaseEvent is one of {
  MenuRelease.MenuReleaseCreated or MenuRelease.ItemAddedToRelease or MenuRelease.ReleaseFinalized or MenuRelease.ReleasePublished or MenuRelease.ReleaseRolledBack or MenuRelease.PrintCompletionRecorded or MenuRelease.MenuDistributed
} with {
  briefly "Menu release event type"
  described as {
    |Union of all menu release entity events.
  }
}
