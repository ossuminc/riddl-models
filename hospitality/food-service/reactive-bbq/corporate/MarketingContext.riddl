// Marketing bounded context
context Marketing is {
  include "marketing-types.riddl"
  include "Campaign.riddl"
  command RecordLoyaltyActivity yields event Campaign.LoyaltyActivityRecorded is  {
    customerId: String(1,50) with {
      briefly "Customer"
      described as {
        |Customer.
      }
    }
    eventType: String(1,30) with {
      briefly "Type"
      described as {
        |Activity type: enrolled or points-accrued.
      }
    }
  } with {
    briefly "Record loyalty activity"
    described as {
      |Record loyalty activity for campaign targeting.
    }
  }
  repository CampaignRepository is {
    inlet CampaignRepositoryFromCampaign is type CampaignEvent    outlet CampaignRepositoryResponses is type Campaign.CampaignResult
    record StoredCampaign is  {
      campaignId: CampaignId with {
        briefly "campaignId"
        described as {
          |The campaignId column of the stored campaign row.
        }
      }
      campaignStatus: CampaignStatus with {
        briefly "campaignStatus"
        described as {
          |The campaignStatus column of the stored campaign row.
        }
      }
    } with {
      briefly "Stored campaign row"
      described as {
        |The persistence shape of campaign data as this repository stores it.
      }
    }
    schema CampaignData is relational
      of campaigns as type StoredCampaign
        index on field StoredCampaign.campaignId
        index on field StoredCampaign.campaignStatus
 with {
      briefly "Campaign data schema"
      described as {
        |Relational schema for persisting campaign state
        |with indexes on campaign identifier and status.
      }
    }
    command PersistCampaignCreated is  {
      campaignId: CampaignId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist CampaignCreated"
      described as {
        |Instructs this repository to apply CampaignCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignScheduled is  {
      campaignId: CampaignId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist CampaignScheduled"
      described as {
        |Instructs this repository to apply CampaignScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignLaunched is  {
      campaignId: CampaignId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist CampaignLaunched"
      described as {
        |Instructs this repository to apply CampaignLaunched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignPaused is  {
      campaignId: CampaignId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist CampaignPaused"
      described as {
        |Instructs this repository to apply CampaignPaused to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignEnded is  {
      campaignId: CampaignId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist CampaignEnded"
      described as {
        |Instructs this repository to apply CampaignEnded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler CampaignPersistence is {
      on command PersistCampaignCreated is {
        set field StoredCampaign.campaignStatus to "as recorded by CampaignCreated"
        do "insert row into CampaignData.campaigns with
          campaignId, campaignName, campaignDescription,
          campaignChannels, campaignPromotion, and
          campaignStatus = Draft"
      }
      on command PersistCampaignScheduled is {
        set field StoredCampaign.campaignStatus to "as recorded by CampaignScheduled"
        do "update CampaignData.campaigns set
          scheduledStartDate = campaignStartDate,
          scheduledEndDate = campaignEndDate,
          campaignStatus = Scheduled where campaignId matches"
      }
      on command PersistCampaignLaunched is {
        set field StoredCampaign.campaignStatus to "as recorded by CampaignLaunched"
        do "update CampaignData.campaigns set campaignStatus =
          Live, actualLaunchedAt = launchedAt where campaignId
          matches"
      }
      on command PersistCampaignPaused is {
        set field StoredCampaign.campaignStatus to "as recorded by CampaignPaused"
        do "update CampaignData.campaigns set campaignStatus =
          Paused where campaignId matches"
      }
      on command PersistCampaignEnded is {
        set field StoredCampaign.campaignStatus to "as recorded by CampaignEnded"
        do "update CampaignData.campaigns set campaignStatus =
          Ended where campaignId matches"
      }
      on command LogCampaignEvent is {
        do "append the campaign event to the Campaign event log"
      }
    } with {
      briefly "Campaign persistence"
      described as {
        |Persists campaign commands.
      }
    }
  } with {
    briefly "Campaign repository"
    described as {
      |Stores and retrieves campaign data.
    }
  }
  processor CampaignEventSource as source is {
    outlet CampaignEvents is type CampaignEvent
    handler CampaignEventEmitter is {
      on init is {
        tell command InitializeCampaign to entity Marketing.Campaign
      }
      on other is {
        error "Unexpected message for source CampaignEventSource"
      }
      on event Campaign.CampaignCreated is {
        send event Campaign.CampaignCreated to outlet CampaignEvents
      }
      on event Campaign.CampaignScheduled is {
        send event Campaign.CampaignScheduled to outlet CampaignEvents
      }
      on event Campaign.CampaignLaunched is {
        send event Campaign.CampaignLaunched to outlet CampaignEvents
      }
      on event Campaign.CampaignPaused is {
        send event Campaign.CampaignPaused to outlet CampaignEvents
      }
      on event Campaign.CampaignEnded is {
        send event Campaign.CampaignEnded to outlet CampaignEvents
      }
    } with {
      briefly "Campaign event emitter"
      described as {
        |Emits campaign lifecycle events.
      }
    }
  } with {
    briefly "Campaign event source"
    described as {
      |Publishes campaign entity events.
    }
  }
  adaptor FromLoyalty from context Restaurant.Loyalty is { 
    handler LoyaltyEventIntake is {
      on event Restaurant.Loyalty.LoyaltyAccount.PointsAccrued is {
        tell command RecordLoyaltyActivity to entity Marketing.Campaign
        do "evaluate loyalty activity for campaign targeting"
      }
      on event Restaurant.Loyalty.LoyaltyAccount.CustomerEnrolled is {
        tell command RecordLoyaltyActivity to entity Marketing.Campaign
        do "target new loyalty member for welcome campaign"
      }
      on other is {
        error "Unexpected message for adaptor FromLoyalty"
      }
    } with {
      briefly "Loyalty event intake"
      described as {
        |Processes incoming loyalty events for campaign
        |targeting.
      }
    }
  } with {
    briefly "Loyalty event sink"
    described as {
      |Receives loyalty events from the streaming topology
      |for marketing campaign targeting.
    }
  }
  // ---- Local event log for campaign events ----
  command LogCampaignEvent is  {
    loggedCampaignId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the campaign the logged event concerns.
      }
    }
    loggedCampaignEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |Which campaign event was logged.
      }
    }
  } with {
    briefly "Log campaign event"
    described as {
      |Append a published campaign event to this context's event log.
    }
  }
  processor CampaignEventLog as sink is {
    inlet IncomingCampaignLog is type CampaignEvent    handler CampaignLogIntake is {
      on other is {
        tell command LogCampaignEvent to repository Marketing.CampaignRepository
        do "append the campaign event to the context event log"
      }
    } with {
      briefly "Campaign log intake"
      described as {
        |Routes every published campaign event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "Campaign event log"
    described as {
      |Durable local log of campaign events this context publishes.
    }
  }
  connector CampaignToLog is from outlet Marketing.CampaignEventSource.CampaignEvents to inlet Marketing.CampaignEventLog.IncomingCampaignLog with {
    briefly "Campaign event log connector"
    described as {
      |Wires published campaign events to the context's event log.
    }
  }
  connector LinkCampaignToCampaignRepository is from outlet Marketing.Campaign.CampaignEvents2 to inlet Marketing.CampaignRepository.CampaignRepositoryFromCampaign with {
    briefly "LinkCampaignToCampaignRepository"
  }
} with {
  briefly "Marketing context"
  described as {
    | Manages marketing campaigns, promotions, and
    | advertising across multiple channels. Integrates
    | with the loyalty context for loyalty-bonus
    | promotions.
  }
}
