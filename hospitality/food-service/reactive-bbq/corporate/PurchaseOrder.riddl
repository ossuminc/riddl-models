// PurchaseOrder entity for the SupplyChain context
event-sourced entity PurchaseOrder as flow is {
  type PurchaseOrderCommand is one of {
    PurchaseOrder.CreateBulkOrder or PurchaseOrder.ApproveOrder or PurchaseOrder.ShipOrder or PurchaseOrder.ReceiveShipment or PurchaseOrder.ReportIssue
  } with {
    briefly "PurchaseOrder command alternation"
    described as {
      |Commands accepted by the PurchaseOrder entity.
    }
  }
  inlet PurchaseOrderCommands is type PurchaseOrderCommand  outlet PurchaseOrderEvents2 is type PurchaseOrderEvent
  // ---- Commands ----
  command CreateBulkOrder yields event BulkOrderCreated is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |Identifier for the new order.
      }
    }
    vendorId: VendorId with {
      briefly "Vendor ID"
      described as {
        |Vendor to order from.
      }
    }
    vendorName: String(1,200) with {
      briefly "Vendor name"
      described as {
        |Who the order is with, captured on the order so it reads without
        |resolving a vendor record.
      }
    }
    poLineItems: OrderLineItem+ with {
      briefly "Line items"
      described as {
        |Items being ordered.
      }
    }
    requestedDeliveryDate: Date with {
      briefly "Delivery date"
      described as {
        |When the goods are wanted. What the restaurant plans its menu
        |around, and not necessarily what the vendor commits to.
      }
    }
  } with {
    briefly "Create bulk order"
    described as {
      |Create a new bulk purchase order.
    }
  }
  command ApproveOrder yields event OrderApproved is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |Order to approve.
      }
    }
    approverId: String(1,50) with {
      briefly "Approver"
      described as {
        |Who signed it off. Purchase orders commit money, so approval is
        |attributable to a person rather than to the system.
      }
    }
    poApprovedAt: TimeStamp with {
      briefly "Approved at"
      described as {
        |When it was signed off. The gap from creation is how long spending
        |waits on a manager, which is what delays deliveries.
      }
    }
  } with {
    briefly "Approve order"
    described as {
      |Approve a purchase order for fulfillment.
    }
  }
  command ShipOrder yields event OrderShipped is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |Order that shipped.
      }
    }
    trackingNumber: String(1,100)? with {
      briefly "Tracking number"
      described as {
        |Shipment tracking number.
      }
    }
    estimatedArrival: Date with {
      briefly "ETA"
      described as {
        |Estimated arrival date.
      }
    }
  } with {
    briefly "Ship order"
    described as {
      |Record that the order has shipped.
    }
  }
  command ReceiveShipment yields event ShipmentReceived is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |Order received.
      }
    }
    shipmentReceivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the goods arrived. Reconciled against the requested date to
        |judge whether a vendor is reliable.
      }
    }
    receivedInFull: Boolean with {
      briefly "In full"
      described as {
        |Whether the full order was received.
      }
    }
    shipmentNotes: String(1,1000)? with {
      briefly "Notes"
      described as {
        |Notes about the shipment condition.
      }
    }
  } with {
    briefly "Receive shipment"
    described as {
      |Record receipt of the shipment.
    }
  }
  command ReportIssue yields event IssueReported is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |Order with the issue.
      }
    }
    poIssueDescription: String(1,1000) with {
      briefly "Issue"
      described as {
        |What was wrong with the delivery — short, damaged, substituted, or
        |late. Free text because vendor disputes are argued in words.
      }
    }
    poReportedAt: TimeStamp with {
      briefly "Reported at"
      described as {
        |When the issue was reported.
      }
    }
  } with {
    briefly "Report issue"
    described as {
      |Report a problem with the order.
    }
  }
  // ---- Events ----
  event BulkOrderCreated is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |The order just raised. Every later event carries the same value, so
        |an order's whole life can be assembled from the event log.
      }
    }
    vendorId: VendorId with {
      briefly "Vendor ID"
      described as {
        |Who is being bought from, as the vendor records know them.
      }
    }
    vendorName: String(1,200) with {
      briefly "Vendor name"
      described as {
        |The vendor's name, kept beside the id so the order reads on its own.
      }
    }
    poLineItems: OrderLineItem+ with {
      briefly "Line items"
      described as {
        |Ordered items.
      }
    }
    poCreatedAt: TimeStamp with {
      term LeadTime is  "The delay between committing to something and having it — an order raised and stock on the shelf, a menu change approved and plates leaving the pass. Planning is mostly the business of covering it." 
      briefly "Created at"
      described as {
        |When the order was raised, from which lead time is counted.
      }
    }
    requestedDeliveryDate: Date with {
      briefly "Delivery date"
      described as {
        |When the goods are wanted. What the restaurant plans its menu
        |around, and not necessarily what the vendor commits to.
      }
    }
  } with {
    briefly "Bulk order created"
    described as {
      |Emitted when a bulk purchase order is created.
    }
  }
  event OrderApproved is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |The order now approved. Approval is what commits the money and lets
        |the order be sent.
      }
    }
    approverId: String(1,50) with {
      briefly "Approver"
      described as {
        |Who signed it off, retained because spend has to be attributable.
      }
    }
    poApprovedAt: TimeStamp with {
      briefly "Approved at"
      described as {
        |When it was signed off.
      }
    }
  } with {
    briefly "Order approved"
    described as {
      |Emitted when a purchase order is approved.
    }
  }
  event OrderShipped is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |The order the vendor has shipped. Reported by the vendor, so it is
        |the first event the restaurant does not control.
      }
    }
    trackingNumber: String(1,100)? with {
      briefly "Tracking number"
      described as {
        |The carrier's reference for the shipment, which is all the
        |restaurant has to chase a late delivery with.
      }
    }
    estimatedArrival: Date with {
      briefly "ETA"
      described as {
        |Estimated arrival.
      }
    }
    poShippedAt: TimeStamp with {
      briefly "Shipped at"
      described as {
        |When it left the vendor. Read against the requested date, this is
        |the earliest warning that a delivery will miss.
      }
    }
  } with {
    briefly "Order shipped"
    described as {
      |Emitted when a purchase order ships.
    }
  }
  event ShipmentReceived is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |The order now delivered. Receipt is what turns a commitment into
        |stock on the shelves.
      }
    }
    receivedInFull: Boolean with {
      briefly "In full"
      described as {
        |Whether everything ordered arrived. Partial deliveries are common
        |enough that they are recorded rather than treated as failures.
      }
    }
    shipmentReceivedAt: TimeStamp with {
      briefly "Received at"
      described as {
        |When the goods landed on the dock.
      }
    }
  } with {
    briefly "Shipment received"
    described as {
      |Emitted when a shipment is received.
    }
  }
  event IssueReported is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |The order with a problem. An issue does not close the order; it
        |usually opens a credit or a redelivery.
      }
    }
    poIssueDescription: String(1,1000) with {
      briefly "Issue"
      described as {
        |What was wrong, in the words the vendor will be challenged with.
      }
    }
    poReportedAt: TimeStamp with {
      briefly "Reported at"
      described as {
        |When the problem was raised. Vendors limit how long after delivery a
        |claim can be made, so this is what a credit depends on.
      }
    }
  } with {
    briefly "Issue reported"
    described as {
      |Emitted when an issue is reported with an order.
    }
  }
  // ---- Queries ----
  query GetPurchaseOrder replies result PurchaseOrderResult is {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |Order to retrieve.
      }
    }
  } with {
    briefly "Get purchase order"
    described as {
      |Query a purchase order by its identifier.
    }
  }
  result PurchaseOrderResult is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "PurchaseOrder addressed"
      described as {
        |Which purchaseorder this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    order: PurchaseOrderStateData with {
      briefly "Order"
      described as {
        |The requested purchase order data.
      }
    }
  } with {
    briefly "Purchase order result"
    described as {
      |Result containing the requested purchase order data.
    }
  }
  // ---- State ----
  record PurchaseOrderStateData is  {
    purchaseOrderId: PurchaseOrderId with {
      briefly "ID"
      described as {
        |The order this state belongs to. Carried through every state so the
        |record can be rebuilt by replaying the event log.
      }
    }
    vendorId: VendorId with {
      briefly "Vendor ID"
      described as {
        |Who the order is with, held in state so open orders can be listed
        |per vendor.
      }
    }
    vendorName: String(1,200) with {
      briefly "Vendor name"
      described as {
        |The vendor's name, held beside the id to save a lookup.
      }
    }
    poLineItems: OrderLineItem+ with {
      briefly "Line items"
      described as {
        |Ordered items.
      }
    }
    purchaseOrderStatus: PurchaseOrderStatus with {
      briefly "Status"
      described as {
        |Current order status.
      }
    }
    requestedDeliveryDate: Date with {
      briefly "Delivery date"
      described as {
        |When the goods are wanted, held in state because it is what an
        |overdue order is judged against.
      }
    }
    trackingNumber: String(1,100)? with {
      briefly "Tracking number"
      described as {
        |Shipment tracking.
      }
    }
    poCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the order was raised, held in state so age reads without
        |replaying the log.
      }
    }
    actualPoApprovedAt: TimeStamp? with {
      briefly "Approved at"
      described as {
        |When it was signed off, absent until it is. Its absence is what
        |marks an order still waiting on a manager.
      }
    }
    actualShipmentReceivedAt: TimeStamp? with {
      briefly "Received at"
      described as {
        |When the goods landed, absent until they do. Its absence is what
        |makes an order outstanding.
      }
    }
  } with {
    briefly "Purchase order state data"
    described as {
      |Full state of a purchase order.
    }
  }
  initial state ActivePurchaseOrder of record PurchaseOrder.PurchaseOrderStateData is {
    initial handler ActivePurchaseOrderInitHandler is {
      on init is {
        let bulkOrderCreated: type BulkOrderCreated = prompt("the bulk order created that brings this purchase order into existence")
        yield bulkOrderCreated
      }
    } with {
      briefly "Active purchase order init handler"
      described as {
        |Initializes the active purchase order state with
        |default values.
      }
    }
  } with {
    briefly "Active purchase order state"
    described as {
      |The primary state of a bulk purchase order from
      |creation through approval, shipping, receipt, and
      |issue reporting.
    }
  }
  initial handler PurchaseOrderHandler is {
    on createBulkOrder: command CreateBulkOrder is {
      yield event BulkOrderCreated(purchaseOrderId = createBulkOrder.purchaseOrderId, vendorId = createBulkOrder.vendorId, vendorName = createBulkOrder.vendorName, poLineItems = createBulkOrder.poLineItems, poCreatedAt = prompt("current timestamp"), requestedDeliveryDate = createBulkOrder.requestedDeliveryDate)
      send event BulkOrderCreated(purchaseOrderId = createBulkOrder.purchaseOrderId, vendorId = createBulkOrder.vendorId, vendorName = createBulkOrder.vendorName, poLineItems = createBulkOrder.poLineItems, poCreatedAt = prompt("current timestamp"), requestedDeliveryDate = createBulkOrder.requestedDeliveryDate) to outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEvents
    }
    on approveOrder: command ApproveOrder is {
      yield event OrderApproved(purchaseOrderId = approveOrder.purchaseOrderId, approverId = approveOrder.approverId, poApprovedAt = approveOrder.poApprovedAt)
      send event OrderApproved(purchaseOrderId = approveOrder.purchaseOrderId, approverId = approveOrder.approverId, poApprovedAt = approveOrder.poApprovedAt) to outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEvents
    }
    on shipOrder: command ShipOrder is {
      yield event OrderShipped(purchaseOrderId = shipOrder.purchaseOrderId, trackingNumber = shipOrder.trackingNumber, estimatedArrival = shipOrder.estimatedArrival, poShippedAt = prompt("the po shipped at of this order shipped"))
      send event OrderShipped(purchaseOrderId = shipOrder.purchaseOrderId, trackingNumber = shipOrder.trackingNumber, estimatedArrival = shipOrder.estimatedArrival, poShippedAt = prompt("the po shipped at of this order shipped")) to outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEvents
    }
    on receiveShipment: command ReceiveShipment is {
      yield event ShipmentReceived(purchaseOrderId = receiveShipment.purchaseOrderId, receivedInFull = receiveShipment.receivedInFull, shipmentReceivedAt = receiveShipment.shipmentReceivedAt)
      send event ShipmentReceived(purchaseOrderId = receiveShipment.purchaseOrderId, receivedInFull = receiveShipment.receivedInFull, shipmentReceivedAt = receiveShipment.shipmentReceivedAt) to outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEvents
    }
    on reportIssue: command ReportIssue is {
      yield event IssueReported(purchaseOrderId = reportIssue.purchaseOrderId, poIssueDescription = reportIssue.poIssueDescription, poReportedAt = reportIssue.poReportedAt)
      send event IssueReported(purchaseOrderId = reportIssue.purchaseOrderId, poIssueDescription = reportIssue.poIssueDescription, poReportedAt = reportIssue.poReportedAt) to outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEvents
    }
    on query GetPurchaseOrder is {
      do "look up PurchaseOrder by GetPurchaseOrder.purchaseOrderId"
      let purchaseOrderResult: type PurchaseOrderResult = prompt("read the purchase order from the store")
      reply purchaseOrderResult
    }
    on bulkOrderCreated: event BulkOrderCreated is {
      morph entity SupplyChain.PurchaseOrder to state SupplyChain.PurchaseOrder.ActivePurchaseOrder with record PurchaseOrder.PurchaseOrderStateData(purchaseOrderId = bulkOrderCreated.purchaseOrderId, vendorId = bulkOrderCreated.vendorId, vendorName = bulkOrderCreated.vendorName, poLineItems = bulkOrderCreated.poLineItems, poCreatedAt = bulkOrderCreated.poCreatedAt, purchaseOrderStatus = prompt("PendingApproval, the status a bulk order starts in"), requestedDeliveryDate = bulkOrderCreated.requestedDeliveryDate, trackingNumber = empty, actualPoApprovedAt = empty, actualShipmentReceivedAt = empty)
    }
    on event OrderApproved is {
      set state ActivePurchaseOrder to prompt("apply OrderApproved to the PurchaseOrder state")
    }
    on event OrderShipped is {
      set state ActivePurchaseOrder to prompt("apply OrderShipped to the PurchaseOrder state")
    }
    on event ShipmentReceived is {
      set state ActivePurchaseOrder to prompt("apply ShipmentReceived to the PurchaseOrder state")
    }
    on event IssueReported is {
      set state ActivePurchaseOrder to prompt("apply IssueReported to the PurchaseOrder state")
    }
  } with {
    briefly "Purchase order command handler"
    described as {
      |Processes purchase order lifecycle commands.
    }
  }
} with {
  briefly "Purchase order entity"
  described as {
    | Manages the lifecycle of a bulk purchase order from
    | creation through approval, shipping, receipt, and
    | issue reporting.
  }
}
