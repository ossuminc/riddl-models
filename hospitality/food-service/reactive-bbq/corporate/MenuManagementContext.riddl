// Menu Management bounded context
context MenuManagement is {
  include "menu-types.riddl"
  include "MenuItem.riddl"
  include "MenuRelease.riddl"
  command RecordPrintCompletion is  {
    printJobId: String(1,50) with {
      briefly "ID"
      described as {
        |Print job.
      }
    }
  } with {
    briefly "Record print completion"
    described as {
      |Record menu print job completion.
    }
  }
  command RecordPhotoShootCompletion is  {
    shootId: String(1,50) with {
      briefly "ID"
      described as {
        |Photo shoot.
      }
    }
  } with {
    briefly "Record photo shoot completion"
    described as {
      |Record menu photo shoot completion.
    }
  }
  repository MenuItemRepository is {
    inlet MenuItemRepositoryFromMenuItem is type MenuItemEvent    outlet MenuItemRepositoryResponses is type MenuItem.MenuItemResult
    record StoredMenuItem is  {
      menuItemId: MenuItemId with {
        briefly "menuItemId"
        described as {
          |The menuItemId column of the stored menuItem row.
        }
      }
      menuItemCategory: MenuItemCategory with {
        briefly "menuItemCategory"
        described as {
          |The menuItemCategory column of the stored menuItem row.
        }
      }
      menuItemLifecycle: MenuItemLifecycle with {
        briefly "menuItemLifecycle"
        described as {
          |The menuItemLifecycle column of the stored menuItem row.
        }
      }
    } with {
      briefly "Stored menuItem row"
      described as {
        |The persistence shape of menuItem data as this repository stores it.
      }
    }
    record StoredMenuRelease is  {
      menuReleaseId: MenuReleaseId with {
        briefly "menuReleaseId"
        described as {
          |The menuReleaseId column of the stored menuRelease row.
        }
      }
      menuReleaseStatus: MenuReleaseStatus with {
        briefly "menuReleaseStatus"
        described as {
          |The menuReleaseStatus column of the stored menuRelease row.
        }
      }
    } with {
      briefly "Stored menuRelease row"
      described as {
        |The persistence shape of menuRelease data as this repository stores it.
      }
    }
    schema MenuItemData is relational
      of menuItems as type StoredMenuItem
        index on field StoredMenuItem.menuItemId
        index on field StoredMenuItem.menuItemCategory
        index on field StoredMenuItem.menuItemLifecycle
 with {
      briefly "Menu item data schema"
      described as {
        |Relational schema for persisting menu item state
        |with indexes on item, category, and lifecycle.
      }
    }
    handler MenuItemPersistence is {
      on command MenuItem.CreateMenuItem is {
        yield event MenuItem.MenuItemCreated
        do "insert row into MenuItemData.menuItems with
          menuItemId, menuItemName, menuItemCategory,
          menuItemDescription, recipe, pricing, and
          menuItemLifecycle = DraftLifecycle"
      }
      on command MenuItem.UpdateMenuItem is {
        yield event MenuItem.MenuItemUpdated
        do "update MenuItemData.menuItems set updatedName,
          updatedDescription, updatedRecipe where menuItemId
          matches"
      }
      on command MenuItem.SetPrice is {
        yield event MenuItem.PriceSet
        do "update MenuItemData.menuItems set pricing =
          updatedPricing where menuItemId matches"
      }
      on command MenuItem.RetireMenuItem is {
        yield event MenuItem.MenuItemRetired
        do "update MenuItemData.menuItems set menuItemLifecycle
          = Retired where menuItemId matches"
      }
      on command RecordPhotoShootCompletion is {
        yield event MenuItem.PhotoShootCompletionRecorded
        do "update menu item images from completed photo shoot"
      }
      on command LogMenuItemEvent is {
        do "append the menu item event to the MenuItem event log"
      }
    } with {
      briefly "Menu item persistence"
      described as {
        |Persists menu item commands.
      }
    }
  } with {
    briefly "Menu item repository"
    described as {
      |Stores and retrieves menu item data.
    }
  }
  repository MenuReleaseRepository is {
    inlet MenuReleaseRepositoryFromMenuRelease is type MenuReleaseEvent    schema MenuReleaseData is relational
      of releases as type StoredMenuRelease
        index on field StoredMenuRelease.menuReleaseId
        index on field StoredMenuRelease.menuReleaseStatus
 with {
      briefly "Menu release data schema"
      described as {
        |Relational schema for persisting menu release state
        |with indexes on release identifier and status.
      }
    }
    handler MenuReleasePersistence is {
      on command MenuRelease.CreateMenuRelease is {
        yield event MenuRelease.MenuReleaseCreated
        do "insert row into MenuReleaseData.releases with
          menuReleaseId, releaseName, releaseDescription,
          effectiveDate, and menuReleaseStatus = Draft"
      }
      on command MenuRelease.AddItemToRelease is {
        yield event MenuRelease.ItemAddedToRelease
        do "append releaseMenuItemId to releaseItems in
          MenuReleaseData.releases where menuReleaseId matches"
      }
      on command MenuRelease.FinalizeRelease is {
        yield event MenuRelease.ReleaseFinalized
        do "update MenuReleaseData.releases set
          menuReleaseStatus = Finalized where menuReleaseId
          matches"
      }
      on command MenuRelease.PublishRelease is {
        yield event MenuRelease.ReleasePublished
        do "update MenuReleaseData.releases set
          menuReleaseStatus = Published, actualPublishedAt =
          publishedAt where menuReleaseId matches"
      }
      on command MenuRelease.RollbackRelease is {
        yield event MenuRelease.ReleaseRolledBack
        do "update MenuReleaseData.releases set
          menuReleaseStatus = RolledBack where menuReleaseId
          matches"
      }
      on command RecordPrintCompletion is {
        yield event MenuRelease.PrintCompletionRecorded
        do "log print job completion for menu release"
      }
      on command LogMenuReleaseEvent is {
        do "append the menu release event to the MenuRelease event log"
      }
    } with {
      briefly "Menu release persistence"
      described as {
        |Persists menu release commands.
      }
    }
  } with {
    briefly "Menu release repository"
    described as {
      |Stores and retrieves menu release data.
    }
  }
  processor MenuItemEventSource as source is {
    outlet MenuItemEvents is type MenuItemEvent
    handler MenuItemEventEmitter is {
      on init is {
        tell command InitializeMenuItem to entity MenuManagement.MenuItem
      }
      on other is {
        error "Unexpected message for source MenuItemEventSource"
      }
      on event MenuItem.MenuItemCreated is {
        send event MenuItem.MenuItemCreated to outlet MenuItemEvents
      }
      on event MenuItem.MenuItemUpdated is {
        send event MenuItem.MenuItemUpdated to outlet MenuItemEvents
      }
      on event MenuItem.PriceSet is {
        send event MenuItem.PriceSet to outlet MenuItemEvents
      }
      on event MenuItem.MenuItemRetired is {
        send event MenuItem.MenuItemRetired to outlet MenuItemEvents
      }
    } with {
      briefly "Menu item event emitter"
      described as {
        |Emits menu item lifecycle events.
      }
    }
  } with {
    briefly "Menu item event source"
    described as {
      |Publishes menu item entity events.
    }
  }
  processor MenuReleaseEventSource as source is {
    outlet MenuReleaseEvents is type MenuReleaseEvent
    handler MenuReleaseEventEmitter is {
      on init is {
        tell command InitializeMenuRelease to entity MenuManagement.MenuRelease
      }
      on other is {
        error "Unexpected message for source MenuReleaseEventSource"
      }
      on event MenuRelease.MenuReleaseCreated is {
        send event MenuRelease.MenuReleaseCreated to outlet MenuReleaseEvents
      }
      on event MenuRelease.ReleasePublished is {
        send event MenuRelease.ReleasePublished to outlet MenuReleaseEvents
      }
      on event MenuRelease.ReleaseRolledBack is {
        send event MenuRelease.ReleaseRolledBack to outlet MenuReleaseEvents
      }
    } with {
      briefly "Menu release event emitter"
      described as {
        |Emits menu release lifecycle events.
      }
    }
  } with {
    briefly "Menu release event source"
    described as {
      |Publishes menu release entity events.
    }
  }
  processor PrintConfirmSink as sink is {
    inlet IncomingPrintResults is type PrintingEvent    handler PrintConfirmHandler is {
      on event PrintingService.MenusPrinted is {
        tell command RecordPrintCompletion to repository MenuManagement.MenuReleaseRepository
        do "log print job completion for
          MenusPrinted.printJobId completed at
          MenusPrinted.printedAt"
      }
    } with {
      briefly "Print confirmation handler"
      described as {
        |Processes print job completion confirmations.
      }
    }
  } with {
    briefly "Print confirmation sink"
    described as {
      |Receives print completion events from the external
      |printing service.
    }
  }
  processor PhotoConfirmSink as sink is {
    inlet IncomingShootResults is type PhotographyEvent    handler PhotoConfirmHandler is {
      on event PhotographyService.PhotoShootCompleted is {
        tell command RecordPhotoShootCompletion to repository MenuManagement.MenuItemRepository
        do "update menu item images from completed photo
          shoot PhotoShootCompleted.shootId completed at
          PhotoShootCompleted.completedAt"
      }
    } with {
      briefly "Photo confirmation handler"
      described as {
        |Processes photo shoot completions and updates
        |menu item images.
      }
    }
  } with {
    briefly "Photo confirmation sink"
    described as {
      |Receives photo shoot completion events from the
      |external photography service.
    }
  }
  adaptor ToRestaurants to context Restaurant.FrontOfHouse is { 
    handler MenuDistribution is {
      on command Restaurant.FrontOfHouse.TableOrder.CreateOrder is {
        do "distribute published menu updates to restaurant
          locations"
        tell command Restaurant.FrontOfHouse.TableOrder.CreateOrder to entity Restaurant.FrontOfHouse.TableOrder
        tell event MenuRelease.MenuDistributed to entity MenuManagement.MenuRelease
      }
      on other is {
        error "Unexpected message for adaptor ToRestaurants"
      }
    } with {
      briefly "Menu distribution"
      described as {
        |Distributes menu updates to restaurants.
      }
    }
  } with {
    briefly "Restaurant menu adaptor"
    described as {
      | Distributes published menu releases atomically
      | to all restaurant locations.
    }
  }
  // ---- Local event log for menu item events ----
  command LogMenuItemEvent is  {
    loggedMenuItemId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the menu item the logged event concerns.
      }
    }
    loggedMenuItemEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |Which menu item event was logged.
      }
    }
  } with {
    briefly "Log menu item event"
    described as {
      |Append a published menu item event to this context's event log.
    }
  }
  processor MenuItemEventLog as sink is {
    inlet IncomingMenuItemLog is type MenuItemEvent    handler MenuItemLogIntake is {
      on other is {
        tell command LogMenuItemEvent to repository MenuManagement.MenuItemRepository
        do "append the menu item event to the context event log"
      }
    } with {
      briefly "MenuItem log intake"
      described as {
        |Routes every published menu item event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "MenuItem event log"
    described as {
      |Durable local log of menu item events this context publishes.
    }
  }
  connector MenuItemToLog is from outlet MenuManagement.MenuItemEventSource.MenuItemEvents to inlet MenuManagement.MenuItemEventLog.IncomingMenuItemLog with {
    briefly "MenuItem event log connector"
    described as {
      |Wires published menu item events to the context's event log.
    }
  }
  // ---- Local event log for menu release events ----
  command LogMenuReleaseEvent is  {
    loggedMenuReleaseId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the menu release the logged event concerns.
      }
    }
    loggedMenuReleaseEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |Which menu release event was logged.
      }
    }
  } with {
    briefly "Log menu release event"
    described as {
      |Append a published menu release event to this context's event log.
    }
  }
  processor MenuReleaseEventLog as sink is {
    inlet IncomingMenuReleaseLog is type MenuReleaseEvent    handler MenuReleaseLogIntake is {
      on other is {
        tell command LogMenuReleaseEvent to repository MenuManagement.MenuReleaseRepository
        do "append the menu release event to the context event log"
      }
    } with {
      briefly "MenuRelease log intake"
      described as {
        |Routes every published menu release event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "MenuRelease event log"
    described as {
      |Durable local log of menu release events this context publishes.
    }
  }
  connector MenuReleaseToLog is from outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEvents to inlet MenuManagement.MenuReleaseEventLog.IncomingMenuReleaseLog with {
    briefly "MenuRelease event log connector"
    described as {
      |Wires published menu release events to the context's event log.
    }
  }
  connector LinkMenuItemToMenuItemRepository is from outlet MenuManagement.MenuItem.MenuItemEvents2 to inlet MenuManagement.MenuItemRepository.MenuItemRepositoryFromMenuItem with {
    briefly "LinkMenuItemToMenuItemRepository"
  }
  connector LinkMenuReleaseToMenuReleaseRepository is from outlet MenuManagement.MenuRelease.MenuReleaseEvents2 to inlet MenuManagement.MenuReleaseRepository.MenuReleaseRepositoryFromMenuRelease with {
    briefly "LinkMenuReleaseToMenuReleaseRepository"
  }
} with {
  briefly "Menu management context"
  described as {
    | Manages the corporate menu lifecycle including recipe
    | development, pricing, and atomic menu distribution
    | to all 500+ locations via the MenuRelease entity.
    | Addresses the Head Chef's monthly coordination
    | bottleneck by enabling versioned, atomic menu updates.
  }
}
