// Menu Management bounded context
context MenuManagement as router is {
  outlet MenuReleaseEventsToRestaurants is type MenuDistributionEvent
  connector 'MenuReleaseEventLog To MenuReleaseRepository' is from outlet MenuManagement.MenuReleaseEventLog.MenuReleaseEventLogToMenuReleaseRepository to inlet MenuManagement.MenuReleaseRepository.MenuReleaseRepositoryFromMenuReleaseEventLog  connector 'MenuItemEventLog To MenuItemRepository' is from outlet MenuManagement.MenuItemEventLog.MenuItemEventLogToMenuItemRepository to inlet MenuManagement.MenuItemRepository.MenuItemRepositoryFromMenuItemEventLog  connector 'PhotoConfirmSink To MenuItemRepository' is from outlet MenuManagement.PhotoConfirmSink.PhotoConfirmSinkToMenuItemRepository to inlet MenuManagement.MenuItemRepository.MenuItemRepositoryFromPhotoConfirmSink  connector 'PrintConfirmSink To MenuReleaseRepository' is from outlet MenuManagement.PrintConfirmSink.PrintConfirmSinkToMenuReleaseRepository to inlet MenuManagement.MenuReleaseRepository.MenuReleaseRepositoryFromPrintConfirmSink  connector 'MenuReleaseProjection Storage' is from outlet MenuManagement.MenuReleaseProjection.MenuReleaseProjectionToRepository to inlet MenuManagement.MenuReleaseRepository.MenuReleaseRepositoryFromMenuReleaseProjection with {
    briefly "MenuReleaseProjection commands on their way to MenuReleaseRepository"
    described as {
      |Carries what leaves MenuManagement.MenuReleaseProjection.MenuReleaseProjectionToRepository to MenuManagement.MenuReleaseRepository.MenuReleaseRepositoryFromMenuReleaseProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'MenuItemProjection Storage' is from outlet MenuManagement.MenuItemProjection.MenuItemProjectionToRepository to inlet MenuManagement.MenuItemRepository.MenuItemRepositoryFromMenuItemProjection with {
    briefly "MenuItemProjection commands on their way to MenuItemRepository"
    described as {
      |Carries what leaves MenuManagement.MenuItemProjection.MenuItemProjectionToRepository to MenuManagement.MenuItemRepository.MenuItemRepositoryFromMenuItemProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  inlet MenuItemCommandStreamIn is type MenuItemCommand  outlet MenuItemCommandStreamOut is type MenuItemCommand
  inlet MenuReleaseCommandStreamIn is type MenuReleaseCommand  outlet MenuReleaseCommandStreamOut is type MenuReleaseCommand
  inlet MenuItemResultStreamIn is result MenuItem.MenuItemResult  outlet MenuItemResultStreamOut is result MenuItem.MenuItemResult
  inlet MenuReleaseResultStreamIn is result MenuRelease.MenuReleaseResult  outlet MenuReleaseResultStreamOut is result MenuRelease.MenuReleaseResult
  handler MenuManagementBoundary is {
    on releasePublished: event MenuRelease.ReleasePublished is {
      send releasePublished to outlet MenuManagement.MenuReleaseEventsToRestaurants
      tell event MenuRelease.MenuDistributed(menuReleaseId = releasePublished.menuReleaseId, menuDistributedAt = system.now) to entity MenuManagement.MenuRelease
    }
    on releaseRolledBack: event MenuRelease.ReleaseRolledBack is {
      send releaseRolledBack to outlet MenuManagement.MenuReleaseEventsToRestaurants
    }
    on createMenuItem: command MenuItem.CreateMenuItem is {
      forward createMenuItem to outlet MenuManagement.MenuItemCommandStreamOut
    }
    on updateMenuItem: command MenuItem.UpdateMenuItem is {
      forward updateMenuItem to outlet MenuManagement.MenuItemCommandStreamOut
    }
    on setPrice: command MenuItem.SetPrice is {
      forward setPrice to outlet MenuManagement.MenuItemCommandStreamOut
    }
    on retireMenuItem: command MenuItem.RetireMenuItem is {
      forward retireMenuItem to outlet MenuManagement.MenuItemCommandStreamOut
    }
    on createMenuRelease: command MenuRelease.CreateMenuRelease is {
      forward createMenuRelease to outlet MenuManagement.MenuReleaseCommandStreamOut
    }
    on addItemToRelease: command MenuRelease.AddItemToRelease is {
      forward addItemToRelease to outlet MenuManagement.MenuReleaseCommandStreamOut
    }
    on finalizeRelease: command MenuRelease.FinalizeRelease is {
      forward finalizeRelease to outlet MenuManagement.MenuReleaseCommandStreamOut
    }
    on publishRelease: command MenuRelease.PublishRelease is {
      forward publishRelease to outlet MenuManagement.MenuReleaseCommandStreamOut
    }
    on rollbackRelease: command MenuRelease.RollbackRelease is {
      forward rollbackRelease to outlet MenuManagement.MenuReleaseCommandStreamOut
    }
    on menuItemResult: result MenuItem.MenuItemResult is {
      send menuItemResult to outlet MenuManagement.MenuItemResultStreamOut
    }
    on menuReleaseResult: result MenuRelease.MenuReleaseResult is {
      send menuReleaseResult to outlet MenuManagement.MenuReleaseResultStreamOut
    }
    on other is {
      error "Unexpected message at the MenuManagement boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MenuItemCommand Stream Intake' is from outlet MenuManagement.MenuItemCommandStreamOut to inlet MenuManagement.MenuItem.MenuItemCommands  connector 'MenuReleaseCommand Stream Intake' is from outlet MenuManagement.MenuReleaseCommandStreamOut to inlet MenuManagement.MenuRelease.MenuReleaseCommands  connector 'MenuItemResult Stream Egress' is from outlet MenuManagement.MenuItemRepository.MenuItemRepositoryResponses to inlet MenuManagement.MenuItemResultStreamIn  connector 'MenuReleaseResult Stream Egress' is from outlet MenuManagement.MenuReleaseRepository.MenuReleaseRepositoryResponses to inlet MenuManagement.MenuReleaseResultStreamIn  include "menu-types.riddl"
  include "MenuItem.riddl"
  include "MenuRelease.riddl"
  command RecordPrintCompletion is {
    printJobId: String(1,50) with {
      briefly "ID"
      described as {
        |The print run this concerns, in the print vendor's own terms. Menus
        |are physical, so a release is not finished when the data changes.
      }
    }
  } with {
    briefly "Record print completion"
    described as {
      |Record menu print job completion.
    }
  }
  command RecordPhotoShootCompletion is {
    shootId: String(1,50) with {
      briefly "ID"
      described as {
        |Photo shoot.
      }
    }
  } with {
    briefly "Record photo shoot completion"
    described as {
      |Record menu photo shoot completion.
    }
  }
  type MenuItemRepositoryCommand is one of {
    MenuManagement.MenuItemRepository.PersistMenuItemCreated or MenuManagement.MenuItemRepository.PersistMenuItemUpdated or MenuManagement.MenuItemRepository.PersistPriceSet or MenuManagement.MenuItemRepository.PersistMenuItemRetired
  } with {
    briefly "Anything that writes the MenuItemRepository"
    described as {
      |The persistence commands MenuItemRepository accepts. Entity events never reach
      |it directly; MenuItemProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository MenuItemRepository as merge is {
    inlet MenuItemRepositoryFromMenuItemEventLog is command LogMenuItemEvent    inlet MenuItemRepositoryFromPhotoConfirmSink is command RecordPhotoShootCompletion    inlet MenuItemRepositoryFromMenuItemProjection is type MenuItemRepositoryCommand    outlet MenuItemRepositoryResponses is result MenuItem.MenuItemResult
    record StoredMenuItem is {
      menuItemId: MenuItemId with {
        briefly "menuItemId"
        described as {
          |The menuItemId column of the stored menuItem row.
        }
      }
      menuItemCategory: MenuItemCategory with {
        briefly "menuItemCategory"
        described as {
          |The menuItemCategory column of the stored menuItem row.
        }
      }
      menuItemLifecycle: MenuItemLifecycle with {
        briefly "menuItemLifecycle"
        described as {
          |The menuItemLifecycle column of the stored menuItem row.
        }
      }
      menuItemName: String(1,200) with {
        briefly "Menu item name"
        described as {
          |The row's menu item name, as the persisting projector last wrote it.
        }
      }
      menuItemDescription: String(1,1000) with {
        briefly "Menu item description"
        described as {
          |The row's menu item description, as the persisting projector last wrote it.
        }
      }
      recipe: RecipeInfo with {
        briefly "Recipe"
        described as {
          |The row's recipe, as the persisting projector last wrote it.
        }
      }
      pricing: PriceInfo with {
        briefly "Pricing"
        described as {
          |The row's pricing, as the persisting projector last wrote it.
        }
      }
      updatedName: String(1,200)? with {
        briefly "Updated name"
        described as {
          |The row's updated name, as the persisting projector last wrote it.
        }
      }
      updatedDescription: String(1,1000)? with {
        briefly "Updated description"
        described as {
          |The row's updated description, as the persisting projector last wrote it.
        }
      }
      updatedRecipe: RecipeInfo? with {
        briefly "Updated recipe"
        described as {
          |The row's updated recipe, as the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored menuItem row"
      described as {
        |The persistence shape of menuItem data as this repository stores it.
      }
    }
    record StoredMenuRelease is {
      menuReleaseId: MenuReleaseId with {
        briefly "menuReleaseId"
        described as {
          |The menuReleaseId column of the stored menuRelease row.
        }
      }
      menuReleaseStatus: MenuReleaseStatus with {
        briefly "menuReleaseStatus"
        described as {
          |The menuReleaseStatus column of the stored menuRelease row.
        }
      }
      releaseName: String(1,200) with {
        briefly "Release name"
        described as {
          |The row's release name, as the persisting projector last wrote it.
        }
      }
      releaseDescription: String(1,1000) with {
        briefly "Release description"
        described as {
          |The row's release description, as the persisting projector last wrote it.
        }
      }
      effectiveDate: Date with {
        briefly "Effective date"
        described as {
          |The row's effective date, as the persisting projector last wrote it.
        }
      }
      releaseItems: MenuItemId* with {
        briefly "Release items"
        described as {
          |The row's release items, as the persisting projector last wrote it.
        }
      }
      actualPublishedAt: TimeStamp? with {
        briefly "Actual published at"
        described as {
          |The row's actual published at, as the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored menuRelease row"
      described as {
        |The persistence shape of menuRelease data as this repository stores it.
      }
    }
    schema MenuItemData is relational
      of menuItemEvents as record LoggedMenuItemEvent with history
      of menuItems as record StoredMenuItem
        link menuItemEventLogEntry as field LoggedMenuItemEvent.loggedMenuItemId to field StoredMenuItem.menuItemId
        key on field StoredMenuItem.menuItemId
        index on field StoredMenuItem.menuItemCategory
        index on field StoredMenuItem.menuItemLifecycle
 with {
      briefly "Menu item data schema"
      described as {
        |Relational schema for persisting menu item state
        |with indexes on item, category, and lifecycle.
      }
    }
    command PersistMenuItemCreated is {
      menuItemId: MenuItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      menuItemName: String(1,200) with {
        briefly "Menu item name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      menuItemCategory: MenuItemCategory with {
        briefly "Menu item category"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      menuItemDescription: String(1,1000) with {
        briefly "Menu item description"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      recipe: RecipeInfo with {
        briefly "Recipe"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      pricing: PriceInfo with {
        briefly "Pricing"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MenuItemCreated"
      described as {
        |Instructs this repository to apply MenuItemCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMenuItemUpdated is {
      menuItemId: MenuItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      updatedName: String(1,200)? with {
        briefly "Updated name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedDescription: String(1,1000)? with {
        briefly "Updated description"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedRecipe: RecipeInfo? with {
        briefly "Updated recipe"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MenuItemUpdated"
      described as {
        |Instructs this repository to apply MenuItemUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPriceSet is {
      menuItemId: MenuItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      updatedPricing: PriceInfo with {
        briefly "Updated pricing"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PriceSet"
      described as {
        |Instructs this repository to apply PriceSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMenuItemRetired is {
      menuItemId: MenuItemId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist MenuItemRetired"
      described as {
        |Instructs this repository to apply MenuItemRetired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler MenuItemPersistence is {
      on persistMenuItemCreated: command PersistMenuItemCreated is {
        store record StoredMenuItem(menuItemId = persistMenuItemCreated.menuItemId, menuItemName = persistMenuItemCreated.menuItemName, menuItemCategory = persistMenuItemCreated.menuItemCategory, menuItemDescription = persistMenuItemCreated.menuItemDescription, recipe = persistMenuItemCreated.recipe, pricing = persistMenuItemCreated.pricing, menuItemLifecycle = prompt("the menuItemLifecycle of this row"), updatedDescription = prompt("the updatedDescription of this row"), updatedName = prompt("the updatedName of this row"), updatedRecipe = prompt("the updatedRecipe of this row")) in MenuItemData.menuItems
      }
      on persistMenuItemUpdated: command PersistMenuItemUpdated is {
        update MenuItemData.menuItems set updatedName = persistMenuItemUpdated.updatedName, updatedDescription = persistMenuItemUpdated.updatedDescription, updatedRecipe = persistMenuItemUpdated.updatedRecipe where menuItemId == persistMenuItemUpdated.menuItemId
      }
      on persistPriceSet: command PersistPriceSet is {
        update MenuItemData.menuItems set pricing = persistPriceSet.updatedPricing where menuItemId == persistPriceSet.menuItemId
      }
      on command PersistMenuItemRetired is {
        do "update MenuItemData.menuItems set menuItemLifecycle
          = Retired where menuItemId matches"
      }
      on recordPhotoShootCompletion: command RecordPhotoShootCompletion is {
        tell event MenuItem.PhotoShootCompletionRecorded(shootId = recordPhotoShootCompletion.shootId, menuItemId = prompt("the menu item id of this photo shoot completion recorded"), photoShootRecordedAt = system.now) to entity MenuManagement.MenuItem
        do "update menu item images from completed photo shoot"
      }
      on logMenuItemEvent: command LogMenuItemEvent is {
        store record LoggedMenuItemEvent(loggedMenuItemId = logMenuItemEvent.loggedMenuItemId, loggedMenuItemEventType = logMenuItemEvent.loggedMenuItemEventType, loggedAt = system.now) in MenuItemData.menuItemEvents
      }
    } with {
      briefly "Menu item persistence"
      described as {
        |Persists menu item commands.
      }
    }
  } with {
    briefly "Menu item repository"
    described as {
      |Stores and retrieves menu item data.
    }
  }
  projector MenuItemProjection as flow is {
    updates repository MenuManagement.MenuItemRepository
    inlet MenuItemProjectionFromMenuItem is type MenuItemEvent    outlet MenuItemProjectionToRepository is type MenuItemRepositoryCommand
    handler MenuItemProjectionHandler is {
      on menuItemCreated: event MenuItem.MenuItemCreated is {
        tell command MenuManagement.MenuItemRepository.PersistMenuItemCreated(menuItemId = menuItemCreated.menuItemId, menuItemName = menuItemCreated.menuItemName, menuItemCategory = menuItemCreated.menuItemCategory, menuItemDescription = menuItemCreated.menuItemDescription, recipe = menuItemCreated.recipe, pricing = menuItemCreated.pricing) to repository MenuManagement.MenuItemRepository
      }
      on menuItemUpdated: event MenuItem.MenuItemUpdated is {
        tell command MenuManagement.MenuItemRepository.PersistMenuItemUpdated(menuItemId = menuItemUpdated.menuItemId, updatedName = menuItemUpdated.updatedName, updatedDescription = menuItemUpdated.updatedDescription, updatedRecipe = menuItemUpdated.updatedRecipe) to repository MenuManagement.MenuItemRepository
      }
      on priceSet: event MenuItem.PriceSet is {
        tell command MenuManagement.MenuItemRepository.PersistPriceSet(menuItemId = priceSet.menuItemId, updatedPricing = priceSet.updatedPricing) to repository MenuManagement.MenuItemRepository
      }
      on menuItemRetired: event MenuItem.MenuItemRetired is {
        tell command MenuManagement.MenuItemRepository.PersistMenuItemRetired(menuItemId = menuItemRetired.menuItemId) to repository MenuManagement.MenuItemRepository
      }
    } with {
      briefly "MenuItemProjection handler"
      described as {
        |Turns each MenuItem event into the repository command that writes it.
      }
    }
  } with {
    briefly "MenuItem persistence projection"
    described as {
      |Builds the stored MenuItem view from the entity's events.
    }
  }
  type MenuReleaseRepositoryCommand is one of {
    MenuManagement.MenuReleaseRepository.PersistMenuReleaseCreated or MenuManagement.MenuReleaseRepository.PersistItemAddedToRelease or MenuManagement.MenuReleaseRepository.PersistReleaseFinalized or MenuManagement.MenuReleaseRepository.PersistReleasePublished or MenuManagement.MenuReleaseRepository.PersistReleaseRolledBack
  } with {
    briefly "Anything that writes the MenuReleaseRepository"
    described as {
      |The persistence commands MenuReleaseRepository accepts. Entity events never reach
      |it directly; MenuReleaseProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository MenuReleaseRepository as merge is {
    inlet MenuReleaseRepositoryFromMenuReleaseEventLog is command LogMenuReleaseEvent    inlet MenuReleaseRepositoryFromPrintConfirmSink is command RecordPrintCompletion    inlet MenuReleaseRepositoryFromMenuReleaseProjection is type MenuReleaseRepositoryCommand    outlet MenuReleaseRepositoryResponses is result MenuRelease.MenuReleaseResult
    schema MenuReleaseData is relational
      of menuReleaseEvents as record LoggedMenuReleaseEvent with history
      of releases as record StoredMenuRelease
        link menuReleaseEventLogEntry as field LoggedMenuReleaseEvent.loggedMenuReleaseId to field StoredMenuRelease.menuReleaseId
        key on field StoredMenuRelease.menuReleaseId
        index on field StoredMenuRelease.menuReleaseStatus
 with {
      briefly "Menu release data schema"
      described as {
        |Relational schema for persisting menu release state
        |with indexes on release identifier and status.
      }
    }
    command PersistMenuReleaseCreated is {
      menuReleaseId: MenuReleaseId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      releaseName: String(1,200) with {
        briefly "Release name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      releaseDescription: String(1,1000) with {
        briefly "Release description"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      effectiveDate: Date with {
        briefly "Effective date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MenuReleaseCreated"
      described as {
        |Instructs this repository to apply MenuReleaseCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemAddedToRelease is {
      menuReleaseId: MenuReleaseId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      releaseMenuItemId: MenuItemId with {
        briefly "Release menu item id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ItemAddedToRelease"
      described as {
        |Instructs this repository to apply ItemAddedToRelease to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReleaseFinalized is {
      menuReleaseId: MenuReleaseId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReleaseFinalized"
      described as {
        |Instructs this repository to apply ReleaseFinalized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReleasePublished is {
      menuReleaseId: MenuReleaseId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      publishedAt: TimeStamp with {
        briefly "Published at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReleasePublished"
      described as {
        |Instructs this repository to apply ReleasePublished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReleaseRolledBack is {
      menuReleaseId: MenuReleaseId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ReleaseRolledBack"
      described as {
        |Instructs this repository to apply ReleaseRolledBack to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler MenuReleasePersistence is {
      on persistMenuReleaseCreated: command PersistMenuReleaseCreated is {
        store record StoredMenuRelease(menuReleaseId = persistMenuReleaseCreated.menuReleaseId, releaseName = persistMenuReleaseCreated.releaseName, releaseDescription = persistMenuReleaseCreated.releaseDescription, effectiveDate = persistMenuReleaseCreated.effectiveDate, actualPublishedAt = prompt("the actualPublishedAt of this row"), menuReleaseStatus = prompt("the menuReleaseStatus of this row"), releaseItems = prompt("the releaseItems of this row")) in MenuReleaseData.releases
      }
      on command PersistItemAddedToRelease is {
        do "append releaseMenuItemId to releaseItems in
          MenuReleaseData.releases where menuReleaseId matches"
      }
      on command PersistReleaseFinalized is {
        do "update MenuReleaseData.releases set
          menuReleaseStatus = Finalized where menuReleaseId
          matches"
      }
      on persistReleasePublished: command PersistReleasePublished is {
        update MenuReleaseData.releases set actualPublishedAt = persistReleasePublished.publishedAt where menuReleaseId == persistReleasePublished.menuReleaseId
      }
      on command PersistReleaseRolledBack is {
        do "update MenuReleaseData.releases set
          menuReleaseStatus = RolledBack where menuReleaseId
          matches"
      }
      on recordPrintCompletion: command RecordPrintCompletion is {
        tell event MenuRelease.PrintCompletionRecorded(printJobId = recordPrintCompletion.printJobId, menuReleaseId = prompt("the menu release id of this print completion recorded"), printRecordedAt = system.now) to entity MenuManagement.MenuRelease
        do "log print job completion for menu release"
      }
      on logMenuReleaseEvent: command LogMenuReleaseEvent is {
        store record LoggedMenuReleaseEvent(loggedMenuReleaseId = logMenuReleaseEvent.loggedMenuReleaseId, loggedMenuReleaseEventType = logMenuReleaseEvent.loggedMenuReleaseEventType, loggedAt = system.now) in MenuReleaseData.menuReleaseEvents
      }
    } with {
      briefly "Menu release persistence"
      described as {
        |Persists menu release commands.
      }
    }
  } with {
    briefly "Menu release repository"
    described as {
      |Stores and retrieves menu release data.
    }
  }
  projector MenuReleaseProjection as flow is {
    updates repository MenuManagement.MenuReleaseRepository
    inlet MenuReleaseProjectionFromMenuRelease is type MenuReleaseEvent    outlet MenuReleaseProjectionToRepository is type MenuReleaseRepositoryCommand
    handler MenuReleaseProjectionHandler is {
      on menuReleaseCreated: event MenuRelease.MenuReleaseCreated is {
        tell command MenuManagement.MenuReleaseRepository.PersistMenuReleaseCreated(menuReleaseId = menuReleaseCreated.menuReleaseId, releaseName = menuReleaseCreated.releaseName, releaseDescription = menuReleaseCreated.releaseDescription, effectiveDate = menuReleaseCreated.effectiveDate) to repository MenuManagement.MenuReleaseRepository
      }
      on itemAddedToRelease: event MenuRelease.ItemAddedToRelease is {
        tell command MenuManagement.MenuReleaseRepository.PersistItemAddedToRelease(menuReleaseId = itemAddedToRelease.menuReleaseId, releaseMenuItemId = itemAddedToRelease.releaseMenuItemId) to repository MenuManagement.MenuReleaseRepository
      }
      on releaseFinalized: event MenuRelease.ReleaseFinalized is {
        tell command MenuManagement.MenuReleaseRepository.PersistReleaseFinalized(menuReleaseId = releaseFinalized.menuReleaseId) to repository MenuManagement.MenuReleaseRepository
      }
      on releasePublished: event MenuRelease.ReleasePublished is {
        tell command MenuManagement.MenuReleaseRepository.PersistReleasePublished(menuReleaseId = releasePublished.menuReleaseId, publishedAt = releasePublished.publishedAt) to repository MenuManagement.MenuReleaseRepository
      }
      on releaseRolledBack: event MenuRelease.ReleaseRolledBack is {
        tell command MenuManagement.MenuReleaseRepository.PersistReleaseRolledBack(menuReleaseId = releaseRolledBack.menuReleaseId) to repository MenuManagement.MenuReleaseRepository
      }
    } with {
      briefly "MenuReleaseProjection handler"
      described as {
        |Turns each MenuRelease event into the repository command that writes it.
      }
    }
  } with {
    briefly "MenuRelease persistence projection"
    described as {
      |Builds the stored MenuRelease view from the entity's events.
    }
  }
  streamlet MenuItemEventSource as split is {
    outlet MenuItemEventSourceToToPhotographyService is type MenuItemEvent
    outlet MenuItemEventSourceToMenuItemProjection is type MenuItemEvent
    inlet MenuItemEventSourceIn is type MenuItemEvent    outlet MenuItemEvents is type MenuItemEvent
    handler MenuItemEventEmitter is {
      on other is {
        error "Unexpected message for source MenuItemEventSource"
      }
      on menuItemCreated: event MenuItem.MenuItemCreated is {
        send menuItemCreated to outlet MenuItemEvents
        send menuItemCreated to outlet MenuItemEventSourceToMenuItemProjection
        send menuItemCreated to outlet MenuItemEventSourceToToPhotographyService
      }
      on menuItemUpdated: event MenuItem.MenuItemUpdated is {
        send menuItemUpdated to outlet MenuItemEvents
        send menuItemUpdated to outlet MenuItemEventSourceToMenuItemProjection
      }
      on priceSet: event MenuItem.PriceSet is {
        send priceSet to outlet MenuItemEvents
        send priceSet to outlet MenuItemEventSourceToMenuItemProjection
      }
      on menuItemRetired: event MenuItem.MenuItemRetired is {
        send menuItemRetired to outlet MenuItemEvents
        send menuItemRetired to outlet MenuItemEventSourceToMenuItemProjection
      }
    } with {
      briefly "Menu item event emitter"
      described as {
        |Emits menu item lifecycle events.
      }
    }
  } with {
    briefly "Menu item event source"
    described as {
      |Publishes menu item entity events.
    }
  }
  streamlet MenuReleaseEventSource as split is {
    outlet MenuReleaseEventSourceToToPrintingService is type MenuReleaseEvent
    outlet MenuReleaseEventSourceToMenuReleaseProjection is type MenuReleaseEvent
    inlet MenuReleaseEventSourceIn is type MenuReleaseEvent    outlet MenuReleaseEvents is type MenuReleaseEvent
    handler MenuReleaseEventEmitter is {
      on other is {
        error "Unexpected message for source MenuReleaseEventSource"
      }
      on menuReleaseCreated: event MenuRelease.MenuReleaseCreated is {
        send menuReleaseCreated to outlet MenuReleaseEvents
        send menuReleaseCreated to outlet MenuReleaseEventSourceToMenuReleaseProjection
      }
      on releasePublished: event MenuRelease.ReleasePublished is {
        send releasePublished to outlet MenuReleaseEvents
        send releasePublished to outlet MenuReleaseEventSourceToMenuReleaseProjection
      }
      on releaseRolledBack: event MenuRelease.ReleaseRolledBack is {
        send releaseRolledBack to outlet MenuReleaseEvents
        send releaseRolledBack to outlet MenuReleaseEventSourceToMenuReleaseProjection
      }
      on itemAddedToRelease: event MenuRelease.ItemAddedToRelease is {
        send itemAddedToRelease to outlet MenuReleaseEventSourceToMenuReleaseProjection
      }
      on releaseFinalized: event MenuRelease.ReleaseFinalized is {
        send releaseFinalized to outlet MenuReleaseEventSourceToMenuReleaseProjection
        send releaseFinalized to outlet MenuReleaseEventSourceToToPrintingService
      }
    } with {
      briefly "Menu release event emitter"
      described as {
        |Emits menu release lifecycle events.
      }
    }
  } with {
    briefly "Menu release event source"
    described as {
      |Publishes menu release entity events.
    }
  }
  adaptor ToPrintingService to context PrintingService as flow is { 
    inlet ToPrintingServiceIn is type MenuReleaseEvent    outlet ToPrintingServiceOut is command ReactiveBBQ.Corporate.PrintingService.PrintMenus
    handler OutboundPrintingService is {
      on releaseFinalized: event MenuRelease.ReleaseFinalized is {
        let item0: type PrintingService.PrintMenus = prompt("translate the releaseFinalized event into a PrintMenus, a finalised release being exactly what there is to print")
        tell item0 to context PrintingService
      }
      on other is {
        error "Unexpected message for adaptor ToPrintingService"
      }
    } with {
      briefly "Outbound PrintingService translation"
      described as {
        |The other half of the print conversation. PrintingServiceAdapter
        |brings confirmations back; this sends the job that earns one.
      }
    }
  } with {
    briefly "Anti-corruption layer to PrintingService"
    described as {
      |Stands between MenuRelease and the print vendor so the release never
      |names the vendor's wire types directly.
    }
  }
  adaptor PrintingServiceAdapter from context PrintingService as flow is { 
    inlet IncomingPrintingServiceEvents is type PrintingEvent    outlet TranslatedPrintingServiceEvents is type PrintingEvent
    handler InboundPrintingService is {
      on menusPrinted: event PrintingService.MenusPrinted is {
        send menusPrinted to outlet TranslatedPrintingServiceEvents
      }
      on other is {
        error "Unexpected message for adaptor PrintingServiceAdapter"
      }
    } with {
      briefly "Inbound PrintingService translation"
      described as {
        |Receives PrintingService events and forwards them to MenuManagement. This is the
        |seam that keeps the print vendor plug-in replaceable: a different
        |provider is absorbed here rather than in PrintConfirmSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for PrintingService"
    described as {
      |Stands between the external PrintingService and PrintConfirmSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'PrintingEvent Stream' is from outlet MenuManagement.PrintingServiceAdapter.TranslatedPrintingServiceEvents to inlet MenuManagement.PrintConfirmSink.IncomingPrintResults with {
    briefly "PrintingService events, translated, on their way to the sink"
    described as {
      |Carries print run confirmations from the anti-corruption layer to the sink that
      |applies them inside MenuManagement.
    }
  }
  streamlet PrintConfirmSink as flow is {
    outlet PrintConfirmSinkToMenuReleaseRepository is command RecordPrintCompletion
    inlet IncomingPrintResults is type PrintingEvent    handler PrintConfirmHandler is {
      on menusPrinted: event PrintingService.MenusPrinted is {
        send command RecordPrintCompletion(printJobId = menusPrinted.printJobId) to outlet MenuManagement.PrintConfirmSink.PrintConfirmSinkToMenuReleaseRepository
        do "log print job completion for
          MenusPrinted.printJobId completed at
          MenusPrinted.printedAt"
      }
    } with {
      briefly "Print confirmation handler"
      described as {
        |Processes print job completion confirmations.
      }
    }
  } with {
    briefly "Print confirmation sink"
    described as {
      |Receives print completion events from the external
      |printing service.
    }
  }
  adaptor ToPhotographyService to context PhotographyService as flow is { 
    inlet ToPhotographyServiceIn is type MenuItemEvent    outlet ToPhotographyServiceOut is command ReactiveBBQ.Corporate.PhotographyService.SchedulePhotoShoot
    handler OutboundPhotographyService is {
      on menuItemCreated: event MenuItem.MenuItemCreated is {
        let item0: type PhotographyService.SchedulePhotoShoot = prompt("translate the menuItemCreated event into a SchedulePhotoShoot, a new dish having no photograph until one is taken")
        tell item0 to context PhotographyService
      }
      on other is {
        error "Unexpected message for adaptor ToPhotographyService"
      }
    } with {
      briefly "Outbound PhotographyService translation"
      described as {
        |The other half of the photography conversation.
      }
    }
  } with {
    briefly "Anti-corruption layer to PhotographyService"
    described as {
      |Stands between MenuItem and the studio.
    }
  }
  adaptor PhotographyServiceAdapter from context PhotographyService as flow is { 
    inlet IncomingPhotographyServiceEvents is type PhotographyEvent    outlet TranslatedPhotographyServiceEvents is type PhotographyEvent
    handler InboundPhotographyService is {
      on photoShootCompleted: event PhotographyService.PhotoShootCompleted is {
        send photoShootCompleted to outlet TranslatedPhotographyServiceEvents
      }
      on other is {
        error "Unexpected message for adaptor PhotographyServiceAdapter"
      }
    } with {
      briefly "Inbound PhotographyService translation"
      described as {
        |Receives PhotographyService events and forwards them to MenuManagement. This is the
        |seam that keeps the photography vendor plug-in replaceable: a different
        |provider is absorbed here rather than in PhotoConfirmSink.
      }
    }
  } with {
    briefly "Anti-corruption layer for PhotographyService"
    described as {
      |Stands between the external PhotographyService and PhotoConfirmSink so the sink never names
      |the provider's wire types directly.
    }
  }
  connector 'PhotographyEvent Stream' is from outlet MenuManagement.PhotographyServiceAdapter.TranslatedPhotographyServiceEvents to inlet MenuManagement.PhotoConfirmSink.IncomingShootResults with {
    briefly "PhotographyService events, translated, on their way to the sink"
    described as {
      |Carries photo shoot completions from the anti-corruption layer to the sink that
      |applies them inside MenuManagement.
    }
  }
  streamlet PhotoConfirmSink as flow is {
    outlet PhotoConfirmSinkToMenuItemRepository is command RecordPhotoShootCompletion
    inlet IncomingShootResults is type PhotographyEvent    handler PhotoConfirmHandler is {
      on photoShootCompleted: event PhotographyService.PhotoShootCompleted is {
        send command RecordPhotoShootCompletion(shootId = photoShootCompleted.shootId) to outlet MenuManagement.PhotoConfirmSink.PhotoConfirmSinkToMenuItemRepository
        do "update menu item images from completed photo
          shoot PhotoShootCompleted.shootId completed at
          PhotoShootCompleted.completedAt"
      }
    } with {
      briefly "Photo confirmation handler"
      described as {
        |Processes photo shoot completions and updates
        |menu item images.
      }
    }
  } with {
    briefly "Photo confirmation sink"
    described as {
      |Receives photo shoot completion events from the
      |external photography service.
    }
  }
  // ---- Local event log for menu item events ----
  record LoggedMenuItemEvent is {
    loggedMenuItemId: String(1,50) with {
      briefly "LoggedMenuItemId"
      described as {
        |As the logged event carried it.
      }
    }
    loggedMenuItemEventType: String(1,50) with {
      briefly "LoggedMenuItemEventType"
      described as {
        |As the logged event carried it.
      }
    }
    loggedAt: TimeStamp with {
      briefly "Logged at"
      described as {
        |When the log row was written.
      }
    }
  } with {
    briefly "A logged MenuItem event"
    described as {
      |One row of the MenuItem event log: which menuitem, which event,
      |and when it was recorded. `with history` on the entry keeps every
      |version, which is what a log is.
    }
  }
  command LogMenuItemEvent is {
    loggedMenuItemId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the menu item the logged event concerns.
      }
    }
    loggedMenuItemEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of menu item event in one place and must not bind to any single
        |event's shape.
      }
    }
  } with {
    briefly "Log menu item event"
    described as {
      |Append a published menu item event to this context's event log.
    }
  }
  streamlet MenuItemEventLog as flow is {
    outlet MenuItemEventLogToMenuItemRepository is command LogMenuItemEvent
    inlet IncomingMenuItemLog is type MenuItemEvent    handler MenuItemLogIntake is {
      on other as m is {
        send command LogMenuItemEvent(loggedMenuItemId = m.menuItemId, loggedMenuItemEventType = m.type) to outlet MenuManagement.MenuItemEventLog.MenuItemEventLogToMenuItemRepository
      }
    } with {
      briefly "MenuItem log intake"
      described as {
        |Routes every published menu item event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "MenuItem event log"
    described as {
      |Durable local log of menu item events this context publishes.
    }
  }
  connector MenuItemToLog is from outlet MenuManagement.MenuItemEventSource.MenuItemEvents to inlet MenuManagement.MenuItemEventLog.IncomingMenuItemLog with {
    briefly "MenuItem event log connector"
    described as {
      |Wires published menu item events to the context's event log.
    }
  }
  // ---- Local event log for menu release events ----
  record LoggedMenuReleaseEvent is {
    loggedMenuReleaseId: String(1,50) with {
      briefly "LoggedMenuReleaseId"
      described as {
        |As the logged event carried it.
      }
    }
    loggedMenuReleaseEventType: String(1,50) with {
      briefly "LoggedMenuReleaseEventType"
      described as {
        |As the logged event carried it.
      }
    }
    loggedAt: TimeStamp with {
      briefly "Logged at"
      described as {
        |When the log row was written.
      }
    }
  } with {
    briefly "A logged MenuRelease event"
    described as {
      |One row of the MenuRelease event log: which menurelease, which event,
      |and when it was recorded. `with history` on the entry keeps every
      |version, which is what a log is.
    }
  }
  command LogMenuReleaseEvent is {
    loggedMenuReleaseId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the menu release the logged event concerns.
      }
    }
    loggedMenuReleaseEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of menu release event in one place and must not bind to any single
        |event's shape.
      }
    }
  } with {
    briefly "Log menu release event"
    described as {
      |Append a published menu release event to this context's event log.
    }
  }
  streamlet MenuReleaseEventLog as flow is {
    outlet MenuReleaseEventLogToMenuReleaseRepository is command LogMenuReleaseEvent
    inlet IncomingMenuReleaseLog is type MenuReleaseEvent    handler MenuReleaseLogIntake is {
      on other as m is {
        send command LogMenuReleaseEvent(loggedMenuReleaseId = m.menuReleaseId, loggedMenuReleaseEventType = m.type) to outlet MenuManagement.MenuReleaseEventLog.MenuReleaseEventLogToMenuReleaseRepository
      }
    } with {
      briefly "MenuRelease log intake"
      described as {
        |Routes every published menu release event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "MenuRelease event log"
    described as {
      |Durable local log of menu release events this context publishes.
    }
  }
  connector MenuReleaseToLog is from outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEvents to inlet MenuManagement.MenuReleaseEventLog.IncomingMenuReleaseLog with {
    briefly "MenuRelease event log connector"
    described as {
      |Wires published menu release events to the context's event log.
    }
  }
  connector 'ToPhotographyService Feed' is from outlet MenuManagement.MenuItemEventSource.MenuItemEventSourceToToPhotographyService to inlet MenuManagement.ToPhotographyService.ToPhotographyServiceIn with {
    briefly "The MenuItem events ToPhotographyService translates, on their way to it"
    described as {
      |The MenuItem events ToPhotographyService translates, on their way to it.
    }
  }
  connector 'MenuItemEvent Stream' is from outlet MenuManagement.MenuItem.MenuItemEvents2 to inlet MenuManagement.MenuItemEventSource.MenuItemEventSourceIn with {
    briefly "Every MenuItem event, on its way to the fan-out"
    described as {
      |Every MenuItem event, on its way to the fan-out.
    }
  }
  connector 'MenuItemEvent Storage' is from outlet MenuManagement.MenuItemEventSource.MenuItemEventSourceToMenuItemProjection to inlet MenuManagement.MenuItemProjection.MenuItemProjectionFromMenuItem with {
    briefly "MenuItem events on their way to storage"
    described as {
      |Carries what leaves MenuItemEvents2 to MenuItemRepositoryFromMenuItem, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'ToPrintingService Feed' is from outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEventSourceToToPrintingService to inlet MenuManagement.ToPrintingService.ToPrintingServiceIn with {
    briefly "The MenuRelease events ToPrintingService translates, on their way to it"
    described as {
      |The MenuRelease events ToPrintingService translates, on their way to it.
    }
  }
  connector 'MenuReleaseEvent Stream' is from outlet MenuManagement.MenuRelease.MenuReleaseEvents2 to inlet MenuManagement.MenuReleaseEventSource.MenuReleaseEventSourceIn with {
    briefly "Every MenuRelease event, on its way to the fan-out"
    described as {
      |Every MenuRelease event, on its way to the fan-out.
    }
  }
  connector 'MenuReleaseEvent Storage' is from outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEventSourceToMenuReleaseProjection to inlet MenuManagement.MenuReleaseProjection.MenuReleaseProjectionFromMenuRelease with {
    briefly "MenuRelease events on their way to storage"
    described as {
      |Carries what leaves MenuReleaseEvents2 to MenuReleaseRepositoryFromMenuRelease, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  option message_envelope("Riddl.Envelope")
  briefly "Menu management context"
  described as {
    | Manages the corporate menu lifecycle including recipe
    | development, pricing, and atomic menu distribution
    | to all 500+ locations via the MenuRelease entity.
    | Addresses the Head Chef's monthly coordination
    | bottleneck by enabling versioned, atomic menu updates.
  }
}
