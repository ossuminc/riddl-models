// Campaign entity for the Marketing context
event-sourced entity Campaign as flow is {
  type CampaignCommand is one of {
    Campaign.CreateCampaign or Campaign.ScheduleCampaign or Campaign.LaunchCampaign or Campaign.PauseCampaign or Campaign.EndCampaign
  } with {
    briefly "Campaign command alternation"
    described as {
      |Commands accepted by the Campaign entity.
    }
  }
  inlet CampaignCommands is type CampaignCommand  outlet CampaignEvents2 is type CampaignEvent
  // ---- Commands ----
  command CreateCampaign yields event CampaignCreated is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |Identifier for the new campaign.
      }
    }
    campaignName: String(1,200) with {
      briefly "Name"
      described as {
        |What the campaign is called internally. Marketing runs several at
        |once, so this is how staff tell them apart on a report.
      }
    }
    campaignDescription: String(1,2000) with {
      briefly "Description"
      described as {
        |Campaign description and goals.
      }
    }
    campaignChannels: CampaignChannel+ with {
      briefly "Channels"
      described as {
        |Marketing channels for the campaign.
      }
    }
    campaignPromotion: CampaignPromotion? with {
      briefly "Promotion"
      described as {
        |Promotional offer if applicable.
      }
    }
  } with {
    briefly "Create campaign"
    described as {
      |Create a new marketing campaign.
    }
  }
  command ScheduleCampaign yields event CampaignScheduled is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |Campaign to schedule.
      }
    }
    campaignStartDate: Date with {
      briefly "Start date"
      described as {
        |When the campaign should begin running. Scheduled ahead, so it is
        |distinct from when it actually launched.
      }
    }
    campaignEndDate: Date with {
      briefly "End date"
      described as {
        |When it should stop. A campaign left running past its window keeps
        |honouring promotions the business no longer intends.
      }
    }
  } with {
    briefly "Schedule campaign"
    described as {
      |Schedule the campaign for a date range.
    }
  }
  command LaunchCampaign yields event CampaignLaunched is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |Campaign to launch.
      }
    }
    launchedAt: TimeStamp with {
      briefly "Launched at"
      described as {
        |When the campaign was launched.
      }
    }
  } with {
    briefly "Launch campaign"
    described as {
      |Launch the campaign to make it live.
    }
  }
  command PauseCampaign yields event CampaignPaused is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |Campaign to pause.
      }
    }
    pauseReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason for pausing.
      }
    }
  } with {
    briefly "Pause campaign"
    described as {
      |Temporarily pause a live campaign.
    }
  }
  command EndCampaign yields event CampaignEnded is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |Campaign to end.
      }
    }
    endedAt: TimeStamp with {
      briefly "Ended at"
      described as {
        |When the campaign ended.
      }
    }
  } with {
    briefly "End campaign"
    described as {
      |End the campaign.
    }
  }
  // ---- Events ----
  event CampaignCreated is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |The campaign just created. Every later event carries the same value,
        |so a campaign's whole life can be assembled from the event log.
      }
    }
    campaignName: String(1,200) with {
      briefly "Name"
      described as {
        |The name given at creation.
      }
    }
    campaignChannels: CampaignChannel+ with {
      briefly "Channels"
      described as {
        |Marketing channels.
      }
    }
    campaignCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the campaign was drafted. Lead time to launch is what tells
        |marketing whether campaigns are being planned or improvised.
      }
    }
  } with {
    briefly "Campaign created"
    described as {
      |Emitted when a new campaign is created.
    }
  }
  event CampaignScheduled is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |The campaign now given a window. Scheduling is separate from launch
        |so a campaign can be prepared well before it runs.
      }
    }
    campaignStartDate: Date with {
      briefly "Start date"
      described as {
        |When the campaign is set to begin.
      }
    }
    campaignEndDate: Date with {
      briefly "End date"
      described as {
        |When it is set to stop, which bounds the promotion's cost.
      }
    }
    campaignScheduledAt: TimeStamp with {
      briefly "Scheduled at"
      described as {
        |When the window was fixed. Changes close to the start date are the
        |ones that catch restaurants unprepared for the traffic.
      }
    }
  } with {
    briefly "Campaign scheduled"
    described as {
      |Emitted when a campaign is scheduled.
    }
  }
  event CampaignLaunched is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |The campaign now live. Launch is what makes the promotion redeemable
        |in restaurants, so it cannot be undone, only paused.
      }
    }
    launchedAt: TimeStamp with {
      briefly "Launched at"
      described as {
        |When it actually went live, which may differ from the scheduled
        |start. The gap between the two is what post-mortems examine.
      }
    }
  } with {
    briefly "Campaign launched"
    described as {
      |Emitted when a campaign goes live.
    }
  }
  event CampaignPaused is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |The campaign being halted. A pause stops redemption without ending
        |the campaign, so it can resume within its window.
      }
    }
    pauseReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why it was halted — overspend, a supply problem, or a mistake in the
        |offer. Kept because whoever resumes it needs to know what changed.
      }
    }
    pausedAt: TimeStamp with {
      briefly "Paused at"
      described as {
        |When redemption stopped. Spend accrued up to here is committed
        |whatever happens next.
      }
    }
  } with {
    briefly "Campaign paused"
    described as {
      |Emitted when a live campaign is paused.
    }
  }
  event CampaignEnded is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |The campaign now finished. Ending is terminal, unlike a pause.
      }
    }
    endedAt: TimeStamp with {
      briefly "Ended at"
      described as {
        |When the campaign closed. Redemptions after this are refused, which
        |is what guests notice when a promotion expires.
      }
    }
  } with {
    briefly "Campaign ended"
    described as {
      |Emitted when a campaign ends.
    }
  }
  event LoyaltyActivityRecorded is  {
    customerId: String(1,50) with {
      briefly "Customer"
      described as {
        |Customer recorded.
      }
    }
  } with {
    briefly "Loyalty activity recorded"
    described as {
      |Emitted when loyalty activity is recorded for campaign.
    }
  }
  // ---- Queries and Results ----
  query GetCampaign is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |Campaign to retrieve.
      }
    }
  } with {
    briefly "Get campaign"
    described as {
      |Query a campaign by its identifier.
    }
  }
  result CampaignResult is  {
    campaign: CampaignStateData with {
      briefly "Campaign"
      described as {
        |The requested campaign data.
      }
    }
  } with {
    briefly "Campaign result"
    described as {
      |Result containing the requested campaign data.
    }
  }
  // ---- State ----
  record CampaignStateData is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |The campaign this state belongs to. Carried through every state so
        |the record can be rebuilt by replaying the event log.
      }
    }
    campaignName: String(1,200) with {
      briefly "Name"
      described as {
        |The campaign's name, held in state so listings read without a
        |lookup.
      }
    }
    campaignDescription: String(1,2000) with {
      briefly "Description"
      described as {
        |What the campaign offers and to whom, in the words marketing would
        |brief a restaurant with.
      }
    }
    campaignChannels: CampaignChannel+ with {
      briefly "Channels"
      described as {
        |Marketing channels.
      }
    }
    campaignPromotion: CampaignPromotion? with {
      briefly "Promotion"
      described as {
        |Promotional offer.
      }
    }
    campaignStatus: CampaignStatus with {
      briefly "Status"
      described as {
        |Current campaign status.
      }
    }
    scheduledStartDate: Date? with {
      briefly "Start date"
      described as {
        |When it was meant to begin, kept alongside the actual launch so the
        |two can be compared.
      }
    }
    scheduledEndDate: Date? with {
      briefly "End date"
      described as {
        |When it is meant to stop, held in state because expiry is checked
        |against it on every redemption.
      }
    }
    campaignCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the campaign was drafted, held in state so lead time reads
        |without replaying the log.
      }
    }
    actualLaunchedAt: TimeStamp? with {
      briefly "Launched at"
      described as {
        |When it actually went live, absent until it does. Its absence is
        |what distinguishes a scheduled campaign from a running one.
      }
    }
  } with {
    briefly "Campaign state data"
    described as {
      |Full state of a marketing campaign.
    }
  }
  initial state ActiveCampaign of record Campaign.CampaignStateData is {
    initial handler ActiveCampaignInitHandler is {
      on init is {
        yield event CampaignCreated
      }
    } with {
      briefly "Active campaign init handler"
      described as {
        |Initializes the active campaign state with default values.
      }
    }
  } with {
    briefly "Active campaign state"
    described as {
      |The primary state of a marketing campaign from
      |creation through scheduling, launch, pause, and
      |completion.
    }
  }
  initial handler CampaignHandler is {
    on createCampaign: command CreateCampaign is {
      yield event CampaignCreated(campaignId = createCampaign.campaignId, campaignName = createCampaign.campaignName, campaignChannels = createCampaign.campaignChannels)
      send event CampaignCreated(campaignId = createCampaign.campaignId, campaignName = createCampaign.campaignName, campaignChannels = createCampaign.campaignChannels) to outlet Marketing.CampaignEventSource.CampaignEvents
    }
    on scheduleCampaign: command ScheduleCampaign is {
      yield event CampaignScheduled(campaignId = scheduleCampaign.campaignId, campaignStartDate = scheduleCampaign.campaignStartDate, campaignEndDate = scheduleCampaign.campaignEndDate)
      send event CampaignScheduled(campaignId = scheduleCampaign.campaignId, campaignStartDate = scheduleCampaign.campaignStartDate, campaignEndDate = scheduleCampaign.campaignEndDate) to outlet Marketing.CampaignEventSource.CampaignEvents
    }
    on launchCampaign: command LaunchCampaign is {
      yield event CampaignLaunched(campaignId = launchCampaign.campaignId, launchedAt = launchCampaign.launchedAt)
      send event CampaignLaunched(campaignId = launchCampaign.campaignId, launchedAt = launchCampaign.launchedAt) to outlet Marketing.CampaignEventSource.CampaignEvents
    }
    on pauseCampaign: command PauseCampaign is {
      yield event CampaignPaused(campaignId = pauseCampaign.campaignId, pauseReason = pauseCampaign.pauseReason)
      send event CampaignPaused(campaignId = pauseCampaign.campaignId, pauseReason = pauseCampaign.pauseReason) to outlet Marketing.CampaignEventSource.CampaignEvents
    }
    on endCampaign: command EndCampaign is {
      yield event CampaignEnded(campaignId = endCampaign.campaignId, endedAt = endCampaign.endedAt)
      send event CampaignEnded(campaignId = endCampaign.campaignId, endedAt = endCampaign.endedAt) to outlet Marketing.CampaignEventSource.CampaignEvents
    }
    on query GetCampaign is {
      do "look up Campaign by GetCampaign.campaignId"
      tell result CampaignResult to entity Marketing.Campaign
    }
    on recordLoyaltyActivity: command Marketing.RecordLoyaltyActivity is {
      yield event LoyaltyActivityRecorded(customerId = recordLoyaltyActivity.customerId)
      do "evaluate loyalty activity for campaign targeting"
    }
    on campaignCreated: event CampaignCreated is {
      morph entity Marketing.Campaign to state Marketing.Campaign.ActiveCampaign with record Campaign.CampaignStateData(campaignId = campaignCreated.campaignId, campaignName = campaignCreated.campaignName, campaignChannels = campaignCreated.campaignChannels, campaignCreatedAt = campaignCreated.campaignCreatedAt)
      set state ActiveCampaign to "campaignId, campaignName, campaignDescription, campaignChannels, campaignPromotion, campaignStatus = Draft, scheduledStartDate = none, scheduledEndDate = none, campaignCreatedAt = current timestamp, actualLaunchedAt = none"
    }
    on event CampaignScheduled is {
      set state ActiveCampaign to "apply CampaignScheduled to the Campaign state"
    }
    on event CampaignLaunched is {
      set state ActiveCampaign to "apply CampaignLaunched to the Campaign state"
    }
    on event CampaignPaused is {
      set state ActiveCampaign to "apply CampaignPaused to the Campaign state"
    }
    on event CampaignEnded is {
      set state ActiveCampaign to "apply CampaignEnded to the Campaign state"
    }
    on event LoyaltyActivityRecorded is {
      set state ActiveCampaign to "apply LoyaltyActivityRecorded to the Campaign state"
    }
  } with {
    briefly "Campaign command handler"
    described as {
      |Processes campaign lifecycle commands.
    }
  }
} with {
  briefly "Campaign entity"
  described as {
    | Manages the lifecycle of a marketing campaign from
    | creation through scheduling, launch, pause, and
    | completion.
  }
}
