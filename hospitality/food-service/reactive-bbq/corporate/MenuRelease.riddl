// MenuRelease entity for the MenuManagement context
event-sourced entity MenuRelease as flow is {
  type MenuReleaseCommand is one of {
    MenuRelease.CreateMenuRelease or MenuRelease.AddItemToRelease or MenuRelease.FinalizeRelease or MenuRelease.PublishRelease or MenuRelease.RollbackRelease
  } with {
    briefly "MenuRelease command alternation"
    described as {
      |Commands accepted by the MenuRelease entity.
    }
  }
  inlet MenuReleaseCommands is type MenuReleaseCommand  outlet MenuReleaseEvents2 is type MenuReleaseEvent
  // ---- Commands ----
  command CreateMenuRelease yields event MenuReleaseCreated is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |Identifier for the new release.
      }
    }
    releaseName: String(1,200) with {
      briefly "Name"
      described as {
        |Name of this menu release.
      }
    }
    releaseDescription: String(1,1000) with {
      briefly "Description"
      described as {
        |Description of changes in this release.
      }
    }
    effectiveDate: Date with {
      briefly "Effective date"
      described as {
        |When the release should take effect.
      }
    }
  } with {
    briefly "Create menu release"
    described as {
      |Create a new menu release for atomic distribution.
    }
  }
  command AddItemToRelease yields event ItemAddedToRelease is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |Release to add item to.
      }
    }
    releaseMenuItemId: MenuItemId with {
      briefly "Menu item ID"
      described as {
        |Menu item to include in the release.
      }
    }
    releaseAction: String(1,50) with {
      briefly "Action"
      described as {
        |Action: add, update, remove, or price-change.
      }
    }
  } with {
    briefly "Add item to release"
    described as {
      |Add a menu item to the release.
    }
  }
  command FinalizeRelease yields event ReleaseFinalized is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |Release to finalize.
      }
    }
    finalizedAt: TimeStamp with {
      briefly "Finalized at"
      described as {
        |When the release was finalized.
      }
    }
  } with {
    briefly "Finalize release"
    described as {
      |Lock the release for review before publishing.
    }
  }
  command PublishRelease yields event ReleasePublished is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |Release to publish.
      }
    }
    publishedAt: TimeStamp with {
      briefly "Published at"
      described as {
        |When the release was published.
      }
    }
  } with {
    briefly "Publish release"
    described as {
      |Publish the release to all restaurant locations atomically.
    }
  }
  command RollbackRelease yields event ReleaseRolledBack is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |Release to roll back.
      }
    }
    rollbackReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why the release was pulled — a pricing error, an item that cannot be
        |sourced, a printing mistake. Kept because a rollback is expensive
        |and the cause decides who fixes it.
      }
    }
    rolledBackAt: TimeStamp with {
      briefly "Rolled back at"
      described as {
        |When the release was rolled back.
      }
    }
  } with {
    briefly "Rollback release"
    described as {
      |Roll back a published release.
    }
  }
  // ---- Events ----
  event MenuReleaseCreated is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release just created. Every later event carries the same value,
        |so a release's whole life can be assembled from the event log.
      }
    }
    releaseName: String(1,200) with {
      briefly "Name"
      described as {
        |What the release is called — usually a season or a date. How staff
        |refer to which menu is current.
      }
    }
    effectiveDate: Date with {
      briefly "Effective date"
      described as {
        |The day the new menu starts being served. Chosen ahead so printing
        |and training can be scheduled against it.
      }
    }
    releaseCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When work on the release started. The span to publication is the
        |real lead time of a menu change.
      }
    }
    releaseDescription: String(1,1000) with {
      briefly "Description"
      described as {
        |Description of changes in this release.
      }
    }
  } with {
    briefly "Menu release created"
    described as {
      |Emitted when a new menu release is created.
    }
  }
  event ItemAddedToRelease is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release an item was added to. A release gathers many item
        |changes so restaurants see one coordinated menu, not a drip.
      }
    }
    releaseMenuItemId: MenuItemId with {
      briefly "Menu item ID"
      described as {
        |Added item.
      }
    }
    releaseAction: String(1,50) with {
      briefly "Action"
      described as {
        |Action for this item.
      }
    }
  } with {
    briefly "Item added to release"
    described as {
      |Emitted when an item is added to a release.
    }
  }
  event ReleaseFinalized is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release being closed to further changes. Finalisation is what
        |lets printing begin, since the content can no longer move.
      }
    }
    itemCount: Natural with {
      briefly "Item count"
      described as {
        |Number of items in the release.
      }
    }
    finalizedAt: TimeStamp with {
      briefly "Finalized at"
      described as {
        |When the content was frozen. Everything downstream — print, photo,
        |training — is scheduled from here.
      }
    }
  } with {
    briefly "Release finalized"
    described as {
      |Emitted when a release is finalized for review.
    }
  }
  event ReleasePublished is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release now in force. Publication is what makes the new menu the
        |one restaurants serve from.
      }
    }
    releaseName: String(1,200) with {
      briefly "Name"
      described as {
        |The name of the release now live.
      }
    }
    effectiveDate: Date with {
      briefly "Effective date"
      described as {
        |The day it starts being served, which may be later than publication
        |so restaurants get notice.
      }
    }
    publishedAt: TimeStamp with {
      briefly "Published at"
      described as {
        |When it was released to restaurants, as distinct from the day it
        |takes effect.
      }
    }
  } with {
    briefly "Release published"
    described as {
      | Emitted when a menu release is published to all
      | locations. This is the atomic distribution event
      | that updates menus chain-wide simultaneously.
    }
  }
  event ReleaseRolledBack is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release being withdrawn. Rollback restores the previous menu,
        |which is only possible because releases are versioned rather than
        |edited in place.
      }
    }
    rollbackReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Why it was withdrawn, carried forward because a rollback is
        |conspicuous and will be asked about.
      }
    }
    rolledBackAt: TimeStamp with {
      briefly "Rolled back at"
      described as {
        |When the previous menu was restored. How long the bad release was
        |live bounds how many orders were taken against it.
      }
    }
  } with {
    briefly "Release rolled back"
    described as {
      |Emitted when a published release is rolled back.
    }
  }
  event PrintCompletionRecorded is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release whose menus are being printed.
      }
    }
    printJobId: String(1,50) with {
      briefly "ID"
      described as {
        |The printer's handle for the run, kept so its progress can be
        |chased — physical menus are usually the long pole in a release.
      }
    }
    printRecordedAt: TimeStamp with {
      briefly "Recorded at"
      described as {
        |When the print job completion was recorded.
      }
    }
  } with {
    briefly "Print completion recorded"
    described as {
      |Emitted when a menu print job completion is recorded.
    }
  }
  event MenuDistributed is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release whose change was refused.
      }
    }
    menuDistributedAt: TimeStamp with {
      briefly "Distributed at"
      described as {
        |When the release was distributed to restaurants.
      }
    }
  } with {
    briefly "Menu distributed"
    described as {
      |Emitted when a published menu release is distributed to
      |restaurant locations.
    }
  }
  // ---- Queries ----
  query GetMenuRelease replies result MenuReleaseResult is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |Release to retrieve.
      }
    }
  } with {
    briefly "Get menu release"
    described as {
      |Query a menu release by its identifier.
    }
  }
  result MenuReleaseResult is  {
    menuReleaseId: MenuReleaseId with {
      briefly "MenuRelease addressed"
      described as {
        |Which menurelease this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    release: MenuReleaseStateData with {
      briefly "Release"
      described as {
        |The requested menu release data.
      }
    }
  } with {
    briefly "Menu release result"
    described as {
      |Result containing the requested menu release data.
    }
  }
  // ---- State ----
  record MenuReleaseStateData is  {
    menuReleaseId: MenuReleaseId with {
      briefly "ID"
      described as {
        |The release this state belongs to. Carried through every state so
        |the record can be rebuilt by replaying the event log.
      }
    }
    releaseName: String(1,200) with {
      briefly "Name"
      described as {
        |The release's name, held in state so restaurants can name the menu
        |they are serving.
      }
    }
    releaseDescription: String(1,1000) with {
      briefly "Description"
      described as {
        |What changed in this release and why, in the words a restaurant
        |manager would be briefed with.
      }
    }
    effectiveDate: Date with {
      briefly "Effective date"
      described as {
        |The day it starts being served, held in state because every order
        |is priced against whichever release is effective.
      }
    }
    menuReleaseStatus: MenuReleaseStatus with {
      briefly "Status"
      described as {
        |Current release status.
      }
    }
    releaseItems: MenuItemId+ with {
      briefly "Items"
      described as {
        |Menu items in this release.
      }
    }
    releaseCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When work started, held in state so lead time reads without
        |replaying the log.
      }
    }
    actualPublishedAt: TimeStamp? with {
      briefly "Published at"
      described as {
        |When it went out, absent until it does. Its absence is what marks a
        |release still being drafted.
      }
    }
  } with {
    briefly "Menu release state data"
    described as {
      |Full state of a menu release.
    }
  }
  initial state ActiveRelease of record MenuRelease.MenuReleaseStateData is {
    initial handler ActiveReleaseInitHandler is {
      on init is {
        let menuReleaseCreated: type MenuReleaseCreated = prompt("the menu release created that brings this menu release into existence")
        yield menuReleaseCreated
      }
    } with {
      briefly "Active release init handler"
      described as {
        |Initializes the active release state with default values.
      }
    }
  } with {
    briefly "Active release state"
    described as {
      |The primary state of a menu release from creation
      |through item addition, finalization, publishing, and
      |optional rollback.
    }
  }
  initial handler MenuReleaseHandler is {
    on createMenuRelease: command CreateMenuRelease is {
      yield event MenuReleaseCreated(menuReleaseId = createMenuRelease.menuReleaseId, releaseName = createMenuRelease.releaseName, effectiveDate = createMenuRelease.effectiveDate, releaseCreatedAt = prompt("current timestamp"), releaseDescription = createMenuRelease.releaseDescription)
      send event MenuReleaseCreated(menuReleaseId = createMenuRelease.menuReleaseId, releaseName = createMenuRelease.releaseName, effectiveDate = createMenuRelease.effectiveDate, releaseCreatedAt = prompt("current timestamp"), releaseDescription = createMenuRelease.releaseDescription) to outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEvents
    }
    on addItemToRelease: command AddItemToRelease is {
      yield event ItemAddedToRelease(menuReleaseId = addItemToRelease.menuReleaseId, releaseMenuItemId = addItemToRelease.releaseMenuItemId, releaseAction = addItemToRelease.releaseAction)
      send event ItemAddedToRelease(menuReleaseId = addItemToRelease.menuReleaseId, releaseMenuItemId = addItemToRelease.releaseMenuItemId, releaseAction = addItemToRelease.releaseAction) to outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEvents
    }
    on finalizeRelease: command FinalizeRelease is {
      yield event ReleaseFinalized(menuReleaseId = finalizeRelease.menuReleaseId, finalizedAt = finalizeRelease.finalizedAt, itemCount = prompt("the item count of this release finalized"))
      send event ReleaseFinalized(menuReleaseId = finalizeRelease.menuReleaseId, finalizedAt = finalizeRelease.finalizedAt, itemCount = prompt("the item count of this release finalized")) to outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEvents
    }
    on publishRelease: command PublishRelease is {
      yield event ReleasePublished(menuReleaseId = publishRelease.menuReleaseId, publishedAt = publishRelease.publishedAt, releaseName = MenuReleaseStateData.releaseName, effectiveDate = MenuReleaseStateData.effectiveDate)
      send event ReleasePublished(menuReleaseId = publishRelease.menuReleaseId, publishedAt = publishRelease.publishedAt, releaseName = MenuReleaseStateData.releaseName, effectiveDate = MenuReleaseStateData.effectiveDate) to outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEvents
      do "ReleasePublished event triggers menu printing via
        PrintingService streaming topology"
    }
    on rollbackRelease: command RollbackRelease is {
      yield event ReleaseRolledBack(menuReleaseId = rollbackRelease.menuReleaseId, rollbackReason = rollbackRelease.rollbackReason, rolledBackAt = rollbackRelease.rolledBackAt)
      send event ReleaseRolledBack(menuReleaseId = rollbackRelease.menuReleaseId, rollbackReason = rollbackRelease.rollbackReason, rolledBackAt = rollbackRelease.rolledBackAt) to outlet MenuManagement.MenuReleaseEventSource.MenuReleaseEvents
    }
    on query GetMenuRelease is {
      do "look up MenuRelease by GetMenuRelease.menuReleaseId"
      let menuReleaseResult: type MenuReleaseResult = prompt("read the menu release from the store")
      reply menuReleaseResult
    }
    on menuReleaseCreated: event MenuReleaseCreated is {
      morph entity MenuManagement.MenuRelease to state MenuManagement.MenuRelease.ActiveRelease with record MenuRelease.MenuReleaseStateData(menuReleaseId = menuReleaseCreated.menuReleaseId, releaseName = menuReleaseCreated.releaseName, effectiveDate = menuReleaseCreated.effectiveDate, releaseCreatedAt = menuReleaseCreated.releaseCreatedAt, releaseDescription = menuReleaseCreated.releaseDescription, menuReleaseStatus = Draft, releaseItems = prompt("the release items of this menu release state data"), actualPublishedAt = empty)
    }
    on event ItemAddedToRelease is {
      set state ActiveRelease to prompt("apply ItemAddedToRelease to the MenuRelease state")
    }
    on event ReleaseFinalized is {
      set state ActiveRelease to prompt("apply ReleaseFinalized to the MenuRelease state")
    }
    on event ReleasePublished is {
      set state ActiveRelease to prompt("apply ReleasePublished to the MenuRelease state")
    }
    on event ReleaseRolledBack is {
      set state ActiveRelease to prompt("apply ReleaseRolledBack to the MenuRelease state")
    }
    on menuDistributed: event MenuDistributed is {
      do "apply MenuDistributed to the menuRelease so it can be persisted and replayed"
    }
    on printCompletionRecorded: event PrintCompletionRecorded is {
      do "apply PrintCompletionRecorded to the menuRelease so it can be persisted and replayed"
    }
  } with {
    briefly "Menu release command handler"
    described as {
      |Processes menu release lifecycle commands.
    }
  }
} with {
  briefly "Menu release entity"
  described as {
    | Manages the lifecycle of a menu release from creation
    | through item addition, finalization, publishing, and
    | optional rollback. Publishing distributes menu updates
    | atomically to all 500+ restaurant locations, solving
    | the Head Chef's monthly coordination bottleneck.
  }
}
