domain Corporate is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  user CorporateHeadChef is "Head Chef managing recipes and menus" with {
    briefly "Corporate Head Chef"
    described as {
      |Develops recipes and coordinates monthly menu updates.
    }
  }
  user ProcurementManager is "Manager handling vendor relationships" with {
    briefly "Procurement Manager"
    described as {
      |Manages bulk ordering and supply chain operations.
    }
  }
  user MarketingManager is "Manager running promotions and campaigns" with {
    briefly "Marketing Manager"
    described as {
      |Creates and manages marketing campaigns.
    }
  }
  include "MenuManagementContext.riddl"
  include "SupplyChainContext.riddl"
  include "MarketingContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  connector PrintingToMenu is from outlet PrintingService.PrintingEventSource.PrintResults to inlet MenuManagement.PrintConfirmSink.IncomingPrintResults with {
    option persistent()
    briefly "Printing to menu connector"
    described as {
      |Wires printing completion events to menu management.
    }
  }
  connector PhotographyToMenu is from outlet PhotographyService.PhotographyEventSource.ShootResults to inlet MenuManagement.PhotoConfirmSink.IncomingShootResults with {
    option persistent()
    briefly "Photography to menu connector"
    described as {
      |Wires photo shoot completions to menu management.
    }
  }
  application context CorporateApp is {
    outlet AppCampaignCommands is type Marketing.Campaign.CampaignCommand
    outlet AppMenuItemCommands is type MenuManagement.MenuItem.MenuItemCommand
    outlet AppMenuReleaseCommands is type MenuManagement.MenuRelease.MenuReleaseCommand
    outlet AppPurchaseOrderCommands is type SupplyChain.PurchaseOrder.PurchaseOrderCommand
    inlet AppCampaignRepositoryResponses is type Marketing.Campaign.CampaignResult    inlet AppMenuItemRepositoryResponses is type MenuManagement.MenuItem.MenuItemResult    inlet AppPurchaseOrderRepositoryResponses is type SupplyChain.PurchaseOrder.PurchaseOrderResult    handler CorporateAppHandler is {
      on other is {
        error "Unexpected message for application context CorporateApp"
      }
    } with {
      briefly "CorporateApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CorporateApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector CampaignCommandStream is from outlet CorporateApp.AppCampaignCommands to inlet Marketing.Campaign.CampaignCommands with {
    option persistent()
    briefly "Campaign commands from the application"
  }
  connector MenuItemCommandStream is from outlet CorporateApp.AppMenuItemCommands to inlet MenuManagement.MenuItem.MenuItemCommands with {
    option persistent()
    briefly "MenuItem commands from the application"
  }
  connector MenuReleaseCommandStream is from outlet CorporateApp.AppMenuReleaseCommands to inlet MenuManagement.MenuRelease.MenuReleaseCommands with {
    option persistent()
    briefly "MenuRelease commands from the application"
  }
  connector PurchaseOrderCommandStream is from outlet CorporateApp.AppPurchaseOrderCommands to inlet SupplyChain.PurchaseOrder.PurchaseOrderCommands with {
    option persistent()
    briefly "PurchaseOrder commands from the application"
  }
  connector CampaignQueryResults is from outlet Marketing.CampaignRepository.CampaignRepositoryResponses to inlet CorporateApp.AppCampaignRepositoryResponses with {
    option persistent()
    briefly "Campaign query results returned to the application"
  }
  connector MenuItemQueryResults is from outlet MenuManagement.MenuItemRepository.MenuItemRepositoryResponses to inlet CorporateApp.AppMenuItemRepositoryResponses with {
    option persistent()
    briefly "MenuItem query results returned to the application"
  }
  connector PurchaseOrderQueryResults is from outlet SupplyChain.PurchaseOrderRepository.PurchaseOrderRepositoryResponses to inlet CorporateApp.AppPurchaseOrderRepositoryResponses with {
    option persistent()
    briefly "PurchaseOrder query results returned to the application"
  }
} with {
  briefly "Corporate operations domain"
  described as {
    | Covers corporate-level functions including menu
    | management with atomic distribution to all locations,
    | supply chain and vendor management, and marketing
    | campaigns and promotions.
  }
}
