domain Corporate is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  user CorporateHeadChef is "Head Chef managing recipes and menus" with {
    briefly "Corporate Head Chef"
    described as {
      |Develops recipes and coordinates monthly menu updates.
    }
  }
  user ProcurementManager is "Manager handling vendor relationships" with {
    briefly "Procurement Manager"
    described as {
      |Manages bulk ordering and supply chain operations.
    }
  }
  user MarketingManager is "Manager running promotions and campaigns" with {
    briefly "Marketing Manager"
    described as {
      |Creates and manages marketing campaigns.
    }
  }
  include "MenuManagementContext.riddl"
  include "SupplyChainContext.riddl"
  include "MarketingContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  persistent connector PrintingToMenu is from outlet PrintingService.PrintingToMenuOut to inlet MenuManagement.PrintingToMenuIn with {
    briefly "Printing to menu connector"
    described as {
      |Wires printing completion events to menu management.
    }
  }
  persistent connector PhotographyToMenu is from outlet PhotographyService.PhotographyToMenuOut to inlet MenuManagement.PhotographyToMenuIn with {
    briefly "Photography to menu connector"
    described as {
      |Wires photo shoot completions to menu management.
    }
  }
  application context CorporateApp as router is {
    outlet AppCampaignCommands is type Marketing.Campaign.CampaignCommand
    outlet AppMenuItemCommands is type MenuManagement.MenuItem.MenuItemCommand
    outlet AppMenuReleaseCommands is type MenuManagement.MenuRelease.MenuReleaseCommand
    outlet AppPurchaseOrderCommands is type SupplyChain.PurchaseOrder.PurchaseOrderCommand
    inlet AppCampaignRepositoryResponses is type Marketing.Campaign.CampaignResult    inlet AppMenuItemRepositoryResponses is type MenuManagement.MenuItem.MenuItemResult    inlet AppMenuReleaseRepositoryResponses is type MenuManagement.MenuRelease.MenuReleaseResult    inlet AppPurchaseOrderRepositoryResponses is type SupplyChain.PurchaseOrder.PurchaseOrderResult    command ShowReleaseUnderEdit is  {
      releaseUnderEdit: MenuManagement.MenuReleaseId with {
        briefly "Release"
        described as {
          |Which release the desk is working on. Everything on the screen is
          |scoped to it, so it is worth showing rather than remembering.
        }
      }
    } with {
      briefly "Refresh the menu desk screen"
      described as {
        |Redraw the menu desk for the release currently open. Carries no
        |domain meaning: opening a release changes nothing about it.
      }
    }
    command ShowCampaignUnderEdit is  {
      campaignUnderEdit: Marketing.CampaignId with {
        briefly "Campaign"
        described as {
          |Which campaign the desk is working on.
        }
      }
    } with {
      briefly "Refresh the campaign screen"
      described as {
        |Redraw the campaign screen for the campaign currently open.
      }
    }
    group MenuDeskScreen is {
      form ReleaseSelector acquires command CorporateApp.ShowReleaseUnderEdit with {
        briefly "Release selector"
        described as {
          |Where menu staff pick the release they are building.
        }
      }
      form CreateMenuItemEntry acquires command MenuManagement.MenuItem.CreateMenuItem with {
        briefly "Create menu item control"
        described as {
          |Where a menu manager drafts a new dish, with its recipe and
          |category.
        }
      }
      form SetPriceEntry acquires command MenuManagement.MenuItem.SetPrice with {
        briefly "Set price control"
        described as {
          |Where a menu manager prices a dish. Separate from editing it
          |because price moves on its own schedule.
        }
      }
      form PublishReleaseEntry acquires command MenuManagement.MenuRelease.PublishRelease with {
        briefly "Publish release control"
        described as {
          |Where a menu manager pushes a finalized release to the estate.
          |The one control on this screen every restaurant feels.
        }
      }
      table MenuItemTable displays result MenuManagement.MenuItem.MenuItemResult with {
        briefly "Menu items"
        described as {
          |The dishes in the release under edit, a row per item.
        }
      }
      document ReleaseUnderEditSummary presents command CorporateApp.ShowReleaseUnderEdit with {
        briefly "Release in view"
        described as {
          |Which release everything below belongs to. Editing the wrong
          |release is the mistake this screen exists to prevent.
        }
      }
    } with {
      briefly "Menu desk screen"
      described as {
        |The screen corporate menu staff build and publish a menu release
        |from.
      }
    }
    group CampaignScreen is {
      form CampaignSelector acquires command CorporateApp.ShowCampaignUnderEdit with {
        briefly "Campaign selector"
        described as {
          |Where marketing picks the campaign to work on.
        }
      }
      form CreateCampaignEntry acquires command Marketing.Campaign.CreateCampaign with {
        briefly "Create campaign control"
        described as {
          |Where marketing drafts a campaign, its channels and its promotion.
        }
      }
      form LaunchCampaignEntry acquires command Marketing.Campaign.LaunchCampaign with {
        briefly "Launch campaign control"
        described as {
          |Where marketing puts a scheduled campaign live.
        }
      }
      table CampaignTable displays result Marketing.Campaign.CampaignResult with {
        briefly "Campaigns"
        described as {
          |Campaigns and their status, a row each. Marketing runs several at
          |once, which is why this is a list and not a page.
        }
      }
      document CampaignUnderEditSummary presents command CorporateApp.ShowCampaignUnderEdit with {
        briefly "Campaign in view"
        described as {
          |Which campaign the controls below act on.
        }
      }
    } with {
      briefly "Campaign screen"
      described as {
        |The screen marketing plans, launches and watches a campaign from.
      }
    }
    handler CorporateAppHandler is {
      on command ShowReleaseUnderEdit is {
        put get from input ReleaseSelector to output ReleaseUnderEditSummary
      }
      on command ShowCampaignUnderEdit is {
        put get from input CampaignSelector to output CampaignUnderEditSummary
      }
      on other is {
        error "Unexpected message for application context CorporateApp"
      }
    } with {
      briefly "CorporateApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CorporateApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CampaignCommand Stream' is from outlet CorporateApp.AppCampaignCommands to inlet Marketing.CampaignCommandStreamIn with {
    briefly "Campaign commands from the application"
  }
  persistent connector 'MenuItemCommand Stream' is from outlet CorporateApp.AppMenuItemCommands to inlet MenuManagement.MenuItemCommandStreamIn with {
    briefly "MenuItem commands from the application"
  }
  persistent connector 'MenuReleaseCommand Stream' is from outlet CorporateApp.AppMenuReleaseCommands to inlet MenuManagement.MenuReleaseCommandStreamIn with {
    briefly "MenuRelease commands from the application"
  }
  persistent connector 'PurchaseOrderCommand Stream' is from outlet CorporateApp.AppPurchaseOrderCommands to inlet SupplyChain.PurchaseOrderCommandStreamIn with {
    briefly "PurchaseOrder commands from the application"
  }
  persistent connector 'CampaignResult Stream' is from outlet Marketing.CampaignResultStreamOut to inlet CorporateApp.AppCampaignRepositoryResponses with {
    briefly "Campaign query results returned to the application"
  }
  persistent connector 'MenuItemResult Stream' is from outlet MenuManagement.MenuItemResultStreamOut to inlet CorporateApp.AppMenuItemRepositoryResponses with {
    briefly "MenuItem query results returned to the application"
  }
  persistent connector 'PurchaseOrderResult Stream' is from outlet SupplyChain.PurchaseOrderResultStreamOut to inlet CorporateApp.AppPurchaseOrderRepositoryResponses with {
    briefly "PurchaseOrder query results returned to the application"
  }
  persistent connector 'MenuReleaseResult Stream' is from outlet MenuManagement.MenuReleaseResultStreamOut to inlet CorporateApp.AppMenuReleaseRepositoryResponses with {
    briefly "MenuRelease query results returned to the application"
    described as {
      |Carries stored menu-release rows back to the corporate application in
      |answer to its queries, the same way every other repository here replies.
    }
  }
} with {
  briefly "Corporate operations domain"
  described as {
    | Covers corporate-level functions including menu
    | management with atomic distribution to all locations,
    | supply chain and vendor management, and marketing
    | campaigns and promotions.
  }
}
