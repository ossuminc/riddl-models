domain Corporate is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "info@ossuminc.com"
  } with {
    briefly "Author"
    described as {
      |Ossum Inc.
    }
  }
  user CorporateHeadChef is "Head Chef managing recipes and menus" with {
    briefly "Corporate Head Chef"
    described as {
      |Develops recipes and coordinates monthly menu updates.
    }
  }
  user ProcurementManager is "Manager handling vendor relationships" with {
    briefly "Procurement Manager"
    described as {
      |Manages bulk ordering and supply chain operations.
    }
  }
  user MarketingManager is "Manager running promotions and campaigns" with {
    briefly "Marketing Manager"
    described as {
      |Creates and manages marketing campaigns.
    }
  }
  include "MenuManagementContext.riddl"
  include "SupplyChainContext.riddl"
  include "MarketingContext.riddl"
  include "external-contexts.riddl"
  // ---- Cross-context connectors (domain-scoped per RIDDL 2.0) ----
  persistent connector MenuToPrinting is from outlet MenuManagement.ToPrintingService.ToPrintingServiceOut to inlet PrintingService.PrintingRequestsIn with {
    briefly "Menu to printing connector"
    described as {
      |Wires print jobs to the printing service. The return leg is
      |PrintingToMenu below.
    }
  }
  persistent connector MenuToPhotography is from outlet MenuManagement.ToPhotographyService.ToPhotographyServiceOut to inlet PhotographyService.PhotographyRequestsIn with {
    briefly "Menu to photography connector"
    described as {
      |Wires photo shoot requests to the studio. The return leg is
      |PhotographyToMenu below.
    }
  }
  persistent connector PrintingToMenu is from outlet PrintingService.PrintingToMenuOut to inlet MenuManagement.PrintingServiceAdapter.IncomingPrintingServiceEvents with {
    briefly "Printing to menu connector"
    described as {
      |Wires printing completion events to menu management.
    }
  }
  persistent connector PhotographyToMenu is from outlet PhotographyService.PhotographyToMenuOut to inlet MenuManagement.PhotographyServiceAdapter.IncomingPhotographyServiceEvents with {
    briefly "Photography to menu connector"
    described as {
      |Wires photo shoot completions to menu management.
    }
  }
  application context CorporateApp as router is {
    outlet AppCampaignCommands is type Marketing.CampaignRequest
    outlet AppMenuItemCommands is type MenuManagement.MenuItemRequest
    outlet AppMenuReleaseCommands is type MenuManagement.MenuReleaseRequest
    outlet AppPurchaseOrderCommands is type SupplyChain.PurchaseOrderRequest
    inlet AppCampaignRepositoryResponses is result Marketing.Campaign.CampaignResult
    inlet AppMenuItemRepositoryResponses is result MenuManagement.MenuItem.MenuItemResult
    inlet AppMenuReleaseRepositoryResponses is result MenuManagement.MenuRelease.MenuReleaseResult
    inlet AppPurchaseOrderRepositoryResponses is result SupplyChain.PurchaseOrder.PurchaseOrderResult
    command ShowReleaseUnderEdit is {
      releaseUnderEdit: MenuManagement.MenuReleaseId with {
        briefly "Release"
        described as {
          |Which release the desk is working on. Everything on the screen is
          |scoped to it, so it is worth showing rather than remembering.
        }
      }
    } with {
      briefly "Refresh the menu desk screen"
      described as {
        |Redraw the menu desk for the release currently open. Carries no
        |domain meaning: opening a release changes nothing about it.
      }
    }
    command ShowCampaignUnderEdit is {
      campaignUnderEdit: Marketing.CampaignId with {
        briefly "Campaign"
        described as {
          |Which campaign the desk is working on.
        }
      }
    } with {
      briefly "Refresh the campaign screen"
      described as {
        |Redraw the campaign screen for the campaign currently open.
      }
    }
    group MenuDeskScreen is {
      form ReleaseSelector acquires command CorporateApp.ShowReleaseUnderEdit with {
        briefly "Release selector"
        described as {
          |Where menu staff pick the release they are building.
        }
      }
      form CreateMenuItemEntry acquires command MenuManagement.CreateMenuItem with {
        briefly "Create menu item control"
        described as {
          |Where a menu manager drafts a new dish, with its recipe and
          |category.
        }
      }
      output MenuItemCreatedView presents event MenuManagement.MenuItem.MenuItemCreated with {
        briefly "The menu item created answer"
        described as {
          |What CreateMenuItem brought into being, with the id it was given.
        }
      }
      form SetPriceEntry acquires command MenuManagement.MenuItem.SetPrice with {
        briefly "Set price control"
        described as {
          |Where a menu manager prices a dish. Separate from editing it
          |because price moves on its own schedule.
        }
      }
      form PublishReleaseEntry acquires command MenuManagement.MenuRelease.PublishRelease with {
        briefly "Publish release control"
        described as {
          |Where a menu manager pushes a finalized release to the estate.
          |The one control on this screen every restaurant feels.
        }
      }
      form UpdateMenuItemEntry acquires command MenuManagement.MenuItem.UpdateMenuItem with {
        briefly "Update menu item control"
        described as {
          |Where a menu manager edits a dish's description, recipe or category.
        }
      }
      form RetireMenuItemEntry acquires command MenuManagement.MenuItem.RetireMenuItem with {
        briefly "Retire menu item control"
        described as {
          |Where a menu manager takes a dish off the menu for good.
        }
      }
      form CreateMenuReleaseEntry acquires command MenuManagement.CreateMenuRelease with {
        briefly "Create menu release control"
        described as {
          |Where a menu manager starts a new release of the menu.
        }
      }
      output MenuReleaseCreatedView presents event MenuManagement.MenuRelease.MenuReleaseCreated with {
        briefly "The menu release created answer"
        described as {
          |What CreateMenuRelease brought into being, with the id it was given.
        }
      }
      form AddItemToReleaseEntry acquires command MenuManagement.MenuRelease.AddItemToRelease with {
        briefly "Add item to release control"
        described as {
          |Where a menu manager puts a dish into the release under edit.
        }
      }
      form FinalizeReleaseEntry acquires command MenuManagement.MenuRelease.FinalizeRelease with {
        briefly "Finalize release control"
        described as {
          |Where a menu manager freezes a release's contents ahead of publishing.
        }
      }
      form RollbackReleaseEntry acquires command MenuManagement.MenuRelease.RollbackRelease with {
        briefly "Roll back release control"
        described as {
          |Where a menu manager withdraws a published release from the estate.
        }
      }
      form GetMenuItemEntry acquires query MenuManagement.MenuItem.GetMenuItem with {
        briefly "Look up menu item control"
        described as {
          |Where a menu manager opens one dish.
        }
      }
      form GetMenuReleaseEntry acquires query MenuManagement.MenuRelease.GetMenuRelease with {
        briefly "Look up menu release control"
        described as {
          |Where a menu manager opens one release to see its dishes and status.
        }
      }
      table MenuItemTable displays result MenuManagement.MenuItem.MenuItemResult with {
        briefly "Menu items"
        described as {
          |The dishes in the release under edit, a row per item.
        }
      }
      document ReleaseUnderEditSummary presents command CorporateApp.ShowReleaseUnderEdit with {
        briefly "Release in view"
        described as {
          |Which release everything below belongs to. Editing the wrong
          |release is the mistake this screen exists to prevent.
        }
      }
    } with {
      briefly "Menu desk screen"
      described as {
        |The screen corporate menu staff build and publish a menu release
        |from.
      }
    }
    group CampaignScreen is {
      form CampaignSelector acquires command CorporateApp.ShowCampaignUnderEdit with {
        briefly "Campaign selector"
        described as {
          |Where marketing picks the campaign to work on.
        }
      }
      form CreateCampaignEntry acquires command Marketing.CreateCampaign with {
        briefly "Create campaign control"
        described as {
          |Where marketing drafts a campaign, its channels and its promotion.
        }
      }
      output CampaignCreatedView presents event Marketing.Campaign.CampaignCreated with {
        briefly "The campaign created answer"
        described as {
          |What CreateCampaign brought into being, with the id it was given.
        }
      }
      form LaunchCampaignEntry acquires command Marketing.Campaign.LaunchCampaign with {
        briefly "Launch campaign control"
        described as {
          |Where marketing puts a scheduled campaign live.
        }
      }
      form ScheduleCampaignEntry acquires command Marketing.Campaign.ScheduleCampaign with {
        briefly "Schedule campaign control"
        described as {
          |Where marketing sets when a drafted campaign runs.
        }
      }
      form PauseCampaignEntry acquires command Marketing.Campaign.PauseCampaign with {
        briefly "Pause campaign control"
        described as {
          |Where marketing halts a live campaign without ending it.
        }
      }
      form EndCampaignEntry acquires command Marketing.Campaign.EndCampaign with {
        briefly "End campaign control"
        described as {
          |Where marketing ends a campaign early.
        }
      }
      form GetCampaignEntry acquires query Marketing.Campaign.GetCampaign with {
        briefly "Look up campaign control"
        described as {
          |Where marketing opens one campaign.
        }
      }
      table CampaignTable displays result Marketing.Campaign.CampaignResult with {
        briefly "Campaigns"
        described as {
          |Campaigns and their status, a row each. Marketing runs several at
          |once, which is why this is a list and not a page.
        }
      }
      document CampaignUnderEditSummary presents command CorporateApp.ShowCampaignUnderEdit with {
        briefly "Campaign in view"
        described as {
          |Which campaign the controls below act on.
        }
      }
    } with {
      briefly "Campaign screen"
      described as {
        |The screen marketing plans, launches and watches a campaign from.
      }
    }
    group PurchasingScreen is {
      form CreateBulkOrderEntry acquires command SupplyChain.CreateBulkOrder with {
        briefly "Create bulk order control"
        described as {
          |Where corporate purchasing raises a bulk order with a vendor for
          |the whole estate.
        }
      }
      output BulkOrderCreatedView presents event SupplyChain.PurchaseOrder.BulkOrderCreated with {
        briefly "The bulk order created answer"
        described as {
          |What CreateBulkOrder brought into being, with the id it was given.
        }
      }
      form ApproveOrderEntry acquires command SupplyChain.PurchaseOrder.ApproveOrder with {
        briefly "Approve bulk order control"
        described as {
          |Where a purchasing lead approves a bulk order before it goes to the vendor.
        }
      }
      form ShipOrderEntry acquires command SupplyChain.PurchaseOrder.ShipOrder with {
        briefly "Record shipment control"
        described as {
          |Where purchasing records the vendor's notice that the order has shipped.
        }
      }
      form ReceiveShipmentEntry acquires command SupplyChain.PurchaseOrder.ReceiveShipment with {
        briefly "Receive shipment control"
        described as {
          |Where purchasing records that the shipment arrived.
        }
      }
      form ReportIssueEntry acquires command SupplyChain.PurchaseOrder.ReportIssue with {
        briefly "Report shipment issue control"
        described as {
          |Where purchasing records a short, damaged or late shipment.
        }
      }
      form GetPurchaseOrderEntry acquires query SupplyChain.PurchaseOrder.GetPurchaseOrder with {
        briefly "Look up bulk order control"
        described as {
          |Where purchasing opens one bulk order to see where it stands.
        }
      }
    } with {
      briefly "Purchasing screen"
      described as {
        |The screen corporate purchasing raises, approves and tracks bulk
        |orders from.
      }
    }
    inlet AppMenuReleaseCreatedAnswer is event MenuManagement.MenuRelease.MenuReleaseCreated
    inlet AppCampaignCreatedAnswer is event Marketing.Campaign.CampaignCreated
    inlet AppMenuItemCreatedAnswer is event MenuManagement.MenuItem.MenuItemCreated
    inlet AppBulkOrderCreatedAnswer is event SupplyChain.PurchaseOrder.BulkOrderCreated
    handler CorporateAppHandler is {
      on menuReleaseCreated: event MenuManagement.MenuRelease.MenuReleaseCreated is {
        put menuReleaseCreated to output CorporateApp.MenuDeskScreen.MenuReleaseCreatedView
      }
      on campaignCreated: event Marketing.Campaign.CampaignCreated is {
        put campaignCreated to output CorporateApp.CampaignScreen.CampaignCreatedView
      }
      on bulkOrderCreated: event SupplyChain.PurchaseOrder.BulkOrderCreated is {
        put bulkOrderCreated to output CorporateApp.PurchasingScreen.BulkOrderCreatedView
      }
      on menuItemCreated: event MenuManagement.MenuItem.MenuItemCreated is {
        put menuItemCreated to output CorporateApp.MenuDeskScreen.MenuItemCreatedView
      }
      on command ShowReleaseUnderEdit is {
        put get from input ReleaseSelector to output ReleaseUnderEditSummary
      }
      on command ShowCampaignUnderEdit is {
        put get from input CampaignSelector to output CampaignUnderEditSummary
      }
      on other is {
        error "Unexpected message for application context CorporateApp"
      }
    } with {
      briefly "CorporateApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CorporateApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MenuItemCreated Answer' is from outlet MenuManagement.MenuItemCreatedAnswerOut to inlet CorporateApp.AppMenuItemCreatedAnswer with {
    briefly "The menu item created answer, back to the screen that issued CreateMenuItem"
  }
  persistent connector 'BulkOrderCreated Answer' is from outlet SupplyChain.BulkOrderCreatedAnswerOut to inlet CorporateApp.AppBulkOrderCreatedAnswer with {
    briefly "The bulk order created answer, back to the screen that issued CreateBulkOrder"
  }
  persistent connector 'MenuReleaseCreated Answer' is from outlet MenuManagement.MenuReleaseCreatedAnswerOut to inlet CorporateApp.AppMenuReleaseCreatedAnswer with {
    briefly "The menu release created answer, back to the screen that issued CreateMenuRelease"
  }
  persistent connector 'CampaignCreated Answer' is from outlet Marketing.CampaignCreatedAnswerOut to inlet CorporateApp.AppCampaignCreatedAnswer with {
    briefly "The campaign created answer, back to the screen that issued CreateCampaign"
  }
  persistent connector 'CampaignCommand Stream' is from outlet CorporateApp.AppCampaignCommands to inlet Marketing.CampaignCommandStreamIn with {
    briefly "Campaign commands from the application"
    described as {
      |Carries what leaves AppCampaignCommands to CampaignCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'MenuItemCommand Stream' is from outlet CorporateApp.AppMenuItemCommands to inlet MenuManagement.MenuItemCommandStreamIn with {
    briefly "MenuItem commands from the application"
    described as {
      |Carries what leaves AppMenuItemCommands to MenuItemCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'MenuReleaseCommand Stream' is from outlet CorporateApp.AppMenuReleaseCommands to inlet MenuManagement.MenuReleaseCommandStreamIn with {
    briefly "MenuRelease commands from the application"
    described as {
      |Carries what leaves AppMenuReleaseCommands to MenuReleaseCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'PurchaseOrderCommand Stream' is from outlet CorporateApp.AppPurchaseOrderCommands to inlet SupplyChain.PurchaseOrderCommandStreamIn with {
    briefly "PurchaseOrder commands from the application"
    described as {
      |Carries what leaves AppPurchaseOrderCommands to PurchaseOrderCommandStreamIn, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'CampaignResult Stream' is from outlet Marketing.CampaignResultStreamOut to inlet CorporateApp.AppCampaignRepositoryResponses with {
    briefly "Campaign query results returned to the application"
    described as {
      |Carries what leaves CampaignResultStreamOut to AppCampaignRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'MenuItemResult Stream' is from outlet MenuManagement.MenuItemResultStreamOut to inlet CorporateApp.AppMenuItemRepositoryResponses with {
    briefly "MenuItem query results returned to the application"
    described as {
      |Carries what leaves MenuItemResultStreamOut to AppMenuItemRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'PurchaseOrderResult Stream' is from outlet SupplyChain.PurchaseOrderResultStreamOut to inlet CorporateApp.AppPurchaseOrderRepositoryResponses with {
    briefly "PurchaseOrder query results returned to the application"
    described as {
      |Carries what leaves PurchaseOrderResultStreamOut to AppPurchaseOrderRepositoryResponses, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  persistent connector 'MenuReleaseResult Stream' is from outlet MenuManagement.MenuReleaseResultStreamOut to inlet CorporateApp.AppMenuReleaseRepositoryResponses with {
    briefly "MenuRelease query results returned to the application"
    described as {
      |Carries stored menu-release rows back to the corporate application in
      |answer to its queries, the same way every other repository here replies.
    }
  }
} with {
  briefly "Corporate operations domain"
  described as {
    | Covers corporate-level functions including menu
    | management with atomic distribution to all locations,
    | supply chain and vendor management, and marketing
    | campaigns and promotions.
  }
}
