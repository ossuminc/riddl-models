// Supply Chain bounded context
context SupplyChain as router is {
  inlet SupplyChainToInventoryIn is type PurchaseOrderEvent  outlet SupplyChainToInventoryOut is type PurchaseOrderEvent
  connector 'FromSupplyChain Feed' is from outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEventSourceToInventory to inlet SupplyChain.SupplyChainToInventoryIn with {
    briefly "PurchaseOrder events on their way to Inventory"
    described as {
      |PurchaseOrder events on their way to Inventory.
    }
  }
  connector 'PurchaseOrderEventLog To PurchaseOrderRepository' is from outlet SupplyChain.PurchaseOrderEventLog.PurchaseOrderEventLogToPurchaseOrderRepository to inlet SupplyChain.PurchaseOrderRepository.PurchaseOrderRepositoryFromPurchaseOrderEventLog  inlet PurchaseOrderCommandStreamIn is type PurchaseOrderCommand  outlet PurchaseOrderCommandStreamOut is type PurchaseOrderCommand
  inlet PurchaseOrderResultStreamIn is result PurchaseOrder.PurchaseOrderResult  outlet PurchaseOrderResultStreamOut is result PurchaseOrder.PurchaseOrderResult
  handler SupplyChainBoundary is {
    on shipmentReceived: event PurchaseOrder.ShipmentReceived is {
      send shipmentReceived to outlet SupplyChain.SupplyChainToInventoryOut
    }
    on orderShipped: event PurchaseOrder.OrderShipped is {
      send orderShipped to outlet SupplyChain.SupplyChainToInventoryOut
    }
    on createBulkOrder: command PurchaseOrder.CreateBulkOrder is {
      forward createBulkOrder to outlet SupplyChain.PurchaseOrderCommandStreamOut
    }
    on approveOrder: command PurchaseOrder.ApproveOrder is {
      forward approveOrder to outlet SupplyChain.PurchaseOrderCommandStreamOut
    }
    on shipOrder: command PurchaseOrder.ShipOrder is {
      forward shipOrder to outlet SupplyChain.PurchaseOrderCommandStreamOut
    }
    on receiveShipment: command PurchaseOrder.ReceiveShipment is {
      forward receiveShipment to outlet SupplyChain.PurchaseOrderCommandStreamOut
    }
    on reportIssue: command PurchaseOrder.ReportIssue is {
      forward reportIssue to outlet SupplyChain.PurchaseOrderCommandStreamOut
    }
    on purchaseOrderResult: result PurchaseOrder.PurchaseOrderResult is {
      send purchaseOrderResult to outlet SupplyChain.PurchaseOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the SupplyChain boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PurchaseOrderProjection Storage' is from outlet SupplyChain.PurchaseOrderProjection.PurchaseOrderProjectionToRepository to inlet SupplyChain.PurchaseOrderRepository.PurchaseOrderRepositoryFromPurchaseOrderProjection with {
    briefly "PurchaseOrderProjection commands on their way to PurchaseOrderRepository"
    described as {
      |Carries what leaves SupplyChain.PurchaseOrderProjection.PurchaseOrderProjectionToRepository to SupplyChain.PurchaseOrderRepository.PurchaseOrderRepositoryFromPurchaseOrderProjection, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
  connector 'PurchaseOrderCommand Stream Intake' is from outlet SupplyChain.PurchaseOrderCommandStreamOut to inlet SupplyChain.PurchaseOrder.PurchaseOrderCommands  connector 'PurchaseOrderResult Stream Egress' is from outlet SupplyChain.PurchaseOrderRepository.PurchaseOrderRepositoryResponses to inlet SupplyChain.PurchaseOrderResultStreamIn  include "supply-chain-types.riddl"
  include "PurchaseOrder.riddl"
  type PurchaseOrderRepositoryCommand is one of {
    SupplyChain.PurchaseOrderRepository.PersistBulkOrderCreated or SupplyChain.PurchaseOrderRepository.PersistOrderApproved or SupplyChain.PurchaseOrderRepository.PersistOrderShipped or SupplyChain.PurchaseOrderRepository.PersistShipmentReceived or SupplyChain.PurchaseOrderRepository.PersistIssueReported
  } with {
    briefly "Anything that writes the PurchaseOrderRepository"
    described as {
      |The persistence commands PurchaseOrderRepository accepts. Entity events never reach
      |it directly; PurchaseOrderProjection turns each into one of these. A repository
      |takes commands and queries only.
    }
  }
  repository PurchaseOrderRepository as merge is {
    inlet PurchaseOrderRepositoryFromPurchaseOrderEventLog is command LogPurchaseOrderEvent    inlet PurchaseOrderRepositoryFromPurchaseOrderProjection is type PurchaseOrderRepositoryCommand    outlet PurchaseOrderRepositoryResponses is result PurchaseOrder.PurchaseOrderResult
    record StoredPurchaseOrder is {
      purchaseOrderId: PurchaseOrderId with {
        briefly "purchaseOrderId"
        described as {
          |The purchaseOrderId column of the stored purchaseOrder row.
        }
      }
      purchaseOrderStatus: PurchaseOrderStatus with {
        briefly "purchaseOrderStatus"
        described as {
          |The purchaseOrderStatus column of the stored purchaseOrder row.
        }
      }
      vendorId: VendorId with {
        briefly "vendorId"
        described as {
          |The vendorId column of the stored purchaseOrder row.
        }
      }
      vendorName: String(1,200) with {
        briefly "Vendor name"
        described as {
          |The row's vendor name, as the persisting projector last wrote it.
        }
      }
      poLineItems: OrderLineItem+ with {
        briefly "Po line items"
        described as {
          |The row's po line items, as the persisting projector last wrote it.
        }
      }
      requestedDeliveryDate: Date with {
        briefly "Requested delivery date"
        described as {
          |The row's requested delivery date, as the persisting projector last wrote it.
        }
      }
      actualPoApprovedAt: TimeStamp? with {
        briefly "Actual po approved at"
        described as {
          |The row's actual po approved at, as the persisting projector last wrote it.
        }
      }
      trackingNumber: String(1,100)? with {
        briefly "Tracking number"
        described as {
          |The row's tracking number, as the persisting projector last wrote it.
        }
      }
      actualShipmentReceivedAt: TimeStamp? with {
        briefly "Actual shipment received at"
        described as {
          |The row's actual shipment received at, as the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored purchaseOrder row"
      described as {
        |The persistence shape of purchaseOrder data as this repository stores it.
      }
    }
    schema PurchaseOrderData is relational
      of purchaseOrderEvents as record LoggedPurchaseOrderEvent with history
      of purchaseOrders as record StoredPurchaseOrder
        link purchaseOrderEventLogEntry as field LoggedPurchaseOrderEvent.loggedPurchaseOrderId to field StoredPurchaseOrder.purchaseOrderId
        key on field StoredPurchaseOrder.purchaseOrderId
        index on field StoredPurchaseOrder.vendorId
        index on field StoredPurchaseOrder.purchaseOrderStatus
 with {
      briefly "Purchase order data schema"
      described as {
        |Relational schema for persisting purchase order
        |state with indexes on order, vendor, and status.
      }
    }
    command PersistBulkOrderCreated is {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      vendorId: VendorId with {
        briefly "Vendor id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      vendorName: String(1,200) with {
        briefly "Vendor name"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      poLineItems: OrderLineItem+ with {
        briefly "Po line items"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      requestedDeliveryDate: Date with {
        briefly "Requested delivery date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist BulkOrderCreated"
      described as {
        |Instructs this repository to apply BulkOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderApproved is {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      poApprovedAt: TimeStamp with {
        briefly "Po approved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderApproved"
      described as {
        |Instructs this repository to apply OrderApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderShipped is {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      trackingNumber: String(1,100)? with {
        briefly "Tracking number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist OrderShipped"
      described as {
        |Instructs this repository to apply OrderShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentReceived is {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
      shipmentReceivedAt: TimeStamp with {
        briefly "Shipment received at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ShipmentReceived"
      described as {
        |Instructs this repository to apply ShipmentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIssueReported is {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IssueReported"
      described as {
        |Instructs this repository to apply IssueReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler PurchaseOrderPersistence is {
      on persistBulkOrderCreated: command PersistBulkOrderCreated is {
        store record StoredPurchaseOrder(purchaseOrderId = persistBulkOrderCreated.purchaseOrderId, vendorId = persistBulkOrderCreated.vendorId, vendorName = persistBulkOrderCreated.vendorName, poLineItems = persistBulkOrderCreated.poLineItems, requestedDeliveryDate = persistBulkOrderCreated.requestedDeliveryDate, actualPoApprovedAt = empty, actualShipmentReceivedAt = empty, purchaseOrderStatus = PurchaseOrderStatus.PoDraft, trackingNumber = empty) in PurchaseOrderData.purchaseOrders
      }
      on persistOrderApproved: command PersistOrderApproved is {
        update PurchaseOrderData.purchaseOrders set actualPoApprovedAt = persistOrderApproved.poApprovedAt where purchaseOrderId == persistOrderApproved.purchaseOrderId
      }
      on persistOrderShipped: command PersistOrderShipped is {
        update PurchaseOrderData.purchaseOrders set trackingNumber = persistOrderShipped.trackingNumber where purchaseOrderId == persistOrderShipped.purchaseOrderId
      }
      on persistShipmentReceived: command PersistShipmentReceived is {
        update PurchaseOrderData.purchaseOrders set actualShipmentReceivedAt = persistShipmentReceived.shipmentReceivedAt where purchaseOrderId == persistShipmentReceived.purchaseOrderId
      }
      on command PersistIssueReported is {
        do "append issue record to PurchaseOrderData
          .purchaseOrders where purchaseOrderId matches"
      }
      on logPurchaseOrderEvent: command LogPurchaseOrderEvent is {
        store record LoggedPurchaseOrderEvent(loggedPurchaseOrderId = logPurchaseOrderEvent.loggedPurchaseOrderId, loggedPurchaseOrderEventType = logPurchaseOrderEvent.loggedPurchaseOrderEventType, loggedAt = system.now) in PurchaseOrderData.purchaseOrderEvents
      }
    } with {
      briefly "Purchase order persistence"
      described as {
        |Persists purchase order commands.
      }
    }
  } with {
    briefly "Purchase order repository"
    described as {
      |Stores and retrieves purchase order data.
    }
  }
  projector PurchaseOrderProjection as flow is {
    updates repository SupplyChain.PurchaseOrderRepository
    inlet PurchaseOrderProjectionFromPurchaseOrder is type PurchaseOrderEvent    outlet PurchaseOrderProjectionToRepository is type PurchaseOrderRepositoryCommand
    handler PurchaseOrderProjectionHandler is {
      on bulkOrderCreated: event PurchaseOrder.BulkOrderCreated is {
        tell command SupplyChain.PurchaseOrderRepository.PersistBulkOrderCreated(purchaseOrderId = bulkOrderCreated.purchaseOrderId, vendorId = bulkOrderCreated.vendorId, vendorName = bulkOrderCreated.vendorName, poLineItems = bulkOrderCreated.poLineItems, requestedDeliveryDate = bulkOrderCreated.requestedDeliveryDate) to repository SupplyChain.PurchaseOrderRepository
      }
      on orderApproved: event PurchaseOrder.OrderApproved is {
        tell command SupplyChain.PurchaseOrderRepository.PersistOrderApproved(purchaseOrderId = orderApproved.purchaseOrderId, poApprovedAt = orderApproved.poApprovedAt) to repository SupplyChain.PurchaseOrderRepository
      }
      on orderShipped: event PurchaseOrder.OrderShipped is {
        tell command SupplyChain.PurchaseOrderRepository.PersistOrderShipped(purchaseOrderId = orderShipped.purchaseOrderId, trackingNumber = orderShipped.trackingNumber) to repository SupplyChain.PurchaseOrderRepository
      }
      on shipmentReceived: event PurchaseOrder.ShipmentReceived is {
        tell command SupplyChain.PurchaseOrderRepository.PersistShipmentReceived(purchaseOrderId = shipmentReceived.purchaseOrderId, shipmentReceivedAt = shipmentReceived.shipmentReceivedAt) to repository SupplyChain.PurchaseOrderRepository
      }
      on issueReported: event PurchaseOrder.IssueReported is {
        tell command SupplyChain.PurchaseOrderRepository.PersistIssueReported(purchaseOrderId = issueReported.purchaseOrderId) to repository SupplyChain.PurchaseOrderRepository
      }
    } with {
      briefly "PurchaseOrderProjection handler"
      described as {
        |Turns each PurchaseOrder event into the repository command that writes it.
      }
    }
  } with {
    briefly "PurchaseOrder persistence projection"
    described as {
      |Builds the stored PurchaseOrder view from the entity's events.
    }
  }
  streamlet PurchaseOrderEventSource as split is {
    outlet PurchaseOrderEventSourceToInventory is type PurchaseOrderEvent
    outlet PurchaseOrderEventSourceToPurchaseOrderProjection is type PurchaseOrderEvent
    inlet PurchaseOrderEventSourceIn is type PurchaseOrderEvent    outlet PurchaseOrderEvents is type PurchaseOrderEvent
    handler PurchaseOrderEventEmitter is {
      on other is {
        error "Unexpected message for source PurchaseOrderEventSource"
      }
      on bulkOrderCreated: event PurchaseOrder.BulkOrderCreated is {
        send bulkOrderCreated to outlet PurchaseOrderEvents
        send bulkOrderCreated to outlet PurchaseOrderEventSourceToPurchaseOrderProjection
      }
      on orderApproved: event PurchaseOrder.OrderApproved is {
        send orderApproved to outlet PurchaseOrderEvents
        send orderApproved to outlet PurchaseOrderEventSourceToPurchaseOrderProjection
      }
      on orderShipped: event PurchaseOrder.OrderShipped is {
        send orderShipped to outlet PurchaseOrderEvents
        send orderShipped to outlet PurchaseOrderEventSourceToPurchaseOrderProjection
        send orderShipped to outlet PurchaseOrderEventSourceToInventory
      }
      on shipmentReceived: event PurchaseOrder.ShipmentReceived is {
        send shipmentReceived to outlet PurchaseOrderEvents
        send shipmentReceived to outlet PurchaseOrderEventSourceToPurchaseOrderProjection
        send shipmentReceived to outlet PurchaseOrderEventSourceToInventory
      }
      on issueReported: event PurchaseOrder.IssueReported is {
        send issueReported to outlet PurchaseOrderEventSourceToPurchaseOrderProjection
      }
    } with {
      briefly "Purchase order event emitter"
      described as {
        |Emits purchase order lifecycle events.
      }
    }
  } with {
    briefly "Purchase order event source"
    described as {
      |Publishes purchase order entity events.
    }
  }
  // ---- Local event log for purchase order events ----
  record LoggedPurchaseOrderEvent is {
    loggedPurchaseOrderId: String(1,50) with {
      briefly "LoggedPurchaseOrderId"
      described as {
        |As the logged event carried it.
      }
    }
    loggedPurchaseOrderEventType: String(1,50) with {
      briefly "LoggedPurchaseOrderEventType"
      described as {
        |As the logged event carried it.
      }
    }
    loggedAt: TimeStamp with {
      briefly "Logged at"
      described as {
        |When the log row was written.
      }
    }
  } with {
    briefly "A logged PurchaseOrder event"
    described as {
      |One row of the PurchaseOrder event log: which purchaseorder, which event,
      |and when it was recorded. `with history` on the entry keeps every
      |version, which is what a log is.
    }
  }
  command LogPurchaseOrderEvent is {
    loggedPurchaseOrderId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the purchase order the logged event concerns.
      }
    }
    loggedPurchaseOrderEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |The event's name, recorded as text because the log keeps every kind
        |of purchase order event in one place and must not bind to any
        |single event's shape.
      }
    }
  } with {
    briefly "Log purchase order event"
    described as {
      |Append a published purchase order event to this context's event log.
    }
  }
  streamlet PurchaseOrderEventLog as flow is {
    outlet PurchaseOrderEventLogToPurchaseOrderRepository is command LogPurchaseOrderEvent
    inlet IncomingPurchaseOrderLog is type PurchaseOrderEvent    handler PurchaseOrderLogIntake is {
      on other as m is {
        send command LogPurchaseOrderEvent(loggedPurchaseOrderId = m.purchaseOrderId, loggedPurchaseOrderEventType = m.type) to outlet SupplyChain.PurchaseOrderEventLog.PurchaseOrderEventLogToPurchaseOrderRepository
      }
    } with {
      briefly "PurchaseOrder log intake"
      described as {
        |Routes every published purchase order event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "PurchaseOrder event log"
    described as {
      |Durable local log of purchase order events this context publishes.
    }
  }
  connector PurchaseOrderToLog is from outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEvents to inlet SupplyChain.PurchaseOrderEventLog.IncomingPurchaseOrderLog with {
    briefly "PurchaseOrder event log connector"
    described as {
      |Wires published purchase order events to the context's event log.
    }
  }
  connector 'PurchaseOrderEvent Stream' is from outlet SupplyChain.PurchaseOrder.PurchaseOrderEvents2 to inlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEventSourceIn with {
    briefly "Every PurchaseOrder event, on its way to the fan-out"
    described as {
      |Every PurchaseOrder event, on its way to the fan-out.
    }
  }
  connector 'PurchaseOrderEvent Storage' is from outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEventSourceToPurchaseOrderProjection to inlet SupplyChain.PurchaseOrderProjection.PurchaseOrderProjectionFromPurchaseOrder with {
    briefly "PurchaseOrder events on their way to storage"
    described as {
      |Carries what leaves PurchaseOrderEvents2 to PurchaseOrderRepositoryFromPurchaseOrder, which is where it is acted on.
      |The pipe states the route; the endpoints state who owns each end.
    }
  }
} with {
  option message_envelope("Riddl.Envelope")
  briefly "Supply chain context"
  described as {
    | Manages vendor relationships and bulk ordering for
    | the restaurant chain. Coordinates with the inventory
    | context to ensure adequate stock across locations.
  }
}
