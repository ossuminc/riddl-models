// Supply Chain bounded context
context SupplyChain is {
  include "supply-chain-types.riddl"
  include "PurchaseOrder.riddl"
  repository PurchaseOrderRepository is {
    inlet PurchaseOrderRepositoryFromPurchaseOrder is type PurchaseOrderEvent    outlet PurchaseOrderRepositoryResponses is type PurchaseOrder.PurchaseOrderResult
    record StoredPurchaseOrder is  {
      purchaseOrderId: PurchaseOrderId with {
        briefly "purchaseOrderId"
        described as {
          |The purchaseOrderId column of the stored purchaseOrder row.
        }
      }
      purchaseOrderStatus: PurchaseOrderStatus with {
        briefly "purchaseOrderStatus"
        described as {
          |The purchaseOrderStatus column of the stored purchaseOrder row.
        }
      }
      vendorId: VendorId with {
        briefly "vendorId"
        described as {
          |The vendorId column of the stored purchaseOrder row.
        }
      }
    } with {
      briefly "Stored purchaseOrder row"
      described as {
        |The persistence shape of purchaseOrder data as this repository stores it.
      }
    }
    schema PurchaseOrderData is relational
      of purchaseOrders as type StoredPurchaseOrder
        index on field StoredPurchaseOrder.purchaseOrderId
        index on field StoredPurchaseOrder.vendorId
        index on field StoredPurchaseOrder.purchaseOrderStatus
 with {
      briefly "Purchase order data schema"
      described as {
        |Relational schema for persisting purchase order
        |state with indexes on order, vendor, and status.
      }
    }
    command PersistBulkOrderCreated is  {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist BulkOrderCreated"
      described as {
        |Instructs this repository to apply BulkOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderApproved is  {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderApproved"
      described as {
        |Instructs this repository to apply OrderApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderShipped is  {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist OrderShipped"
      described as {
        |Instructs this repository to apply OrderShipped to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistShipmentReceived is  {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist ShipmentReceived"
      described as {
        |Instructs this repository to apply ShipmentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIssueReported is  {
      purchaseOrderId: PurchaseOrderId with {
        briefly "ID"
        described as {
          |The stored row to update.
        }
      }
    } with {
      briefly "Persist IssueReported"
      described as {
        |Instructs this repository to apply IssueReported to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    handler PurchaseOrderPersistence is {
      on command PersistBulkOrderCreated is {
        set field StoredPurchaseOrder.purchaseOrderStatus to "as recorded by BulkOrderCreated"
        do "insert row into PurchaseOrderData.purchaseOrders
          with purchaseOrderId, vendorId, vendorName,
          poLineItems, requestedDeliveryDate, and
          purchaseOrderStatus = PendingApproval"
      }
      on command PersistOrderApproved is {
        set field StoredPurchaseOrder.purchaseOrderStatus to "as recorded by OrderApproved"
        do "update PurchaseOrderData.purchaseOrders set
          purchaseOrderStatus = Approved, actualPoApprovedAt =
          poApprovedAt where purchaseOrderId matches"
      }
      on command PersistOrderShipped is {
        set field StoredPurchaseOrder.purchaseOrderStatus to "as recorded by OrderShipped"
        do "update PurchaseOrderData.purchaseOrders set
          purchaseOrderStatus = Shipped, trackingNumber =
          trackingNumber where purchaseOrderId matches"
      }
      on command PersistShipmentReceived is {
        set field StoredPurchaseOrder.purchaseOrderStatus to "as recorded by ShipmentReceived"
        do "update PurchaseOrderData.purchaseOrders set
          purchaseOrderStatus = Received,
          actualShipmentReceivedAt = shipmentReceivedAt where
          purchaseOrderId matches"
      }
      on command PersistIssueReported is {
        set field StoredPurchaseOrder.purchaseOrderStatus to "as recorded by IssueReported"
        do "append issue record to PurchaseOrderData
          .purchaseOrders where purchaseOrderId matches"
      }
      on command LogPurchaseOrderEvent is {
        do "append the purchase order event to the PurchaseOrder event log"
      }
    } with {
      briefly "Purchase order persistence"
      described as {
        |Persists purchase order commands.
      }
    }
  } with {
    briefly "Purchase order repository"
    described as {
      |Stores and retrieves purchase order data.
    }
  }
  processor PurchaseOrderEventSource as source is {
    outlet PurchaseOrderEvents is type PurchaseOrderEvent
    handler PurchaseOrderEventEmitter is {
      on init is {
        tell command InitializePurchaseOrder to entity SupplyChain.PurchaseOrder
      }
      on other is {
        error "Unexpected message for source PurchaseOrderEventSource"
      }
      on event PurchaseOrder.BulkOrderCreated is {
        send event PurchaseOrder.BulkOrderCreated to outlet PurchaseOrderEvents
      }
      on event PurchaseOrder.OrderApproved is {
        send event PurchaseOrder.OrderApproved to outlet PurchaseOrderEvents
      }
      on event PurchaseOrder.OrderShipped is {
        send event PurchaseOrder.OrderShipped to outlet PurchaseOrderEvents
      }
      on event PurchaseOrder.ShipmentReceived is {
        send event PurchaseOrder.ShipmentReceived to outlet PurchaseOrderEvents
      }
    } with {
      briefly "Purchase order event emitter"
      described as {
        |Emits purchase order lifecycle events.
      }
    }
  } with {
    briefly "Purchase order event source"
    described as {
      |Publishes purchase order entity events.
    }
  }
  // ---- Local event log for purchase order events ----
  command LogPurchaseOrderEvent is  {
    loggedPurchaseOrderId: String(1,50) with {
      briefly "ID"
      described as {
        |Identifier of the purchase order the logged event concerns.
      }
    }
    loggedPurchaseOrderEventType: String(1,50) with {
      briefly "Event type"
      described as {
        |Which purchase order event was logged.
      }
    }
  } with {
    briefly "Log purchase order event"
    described as {
      |Append a published purchase order event to this context's event log.
    }
  }
  processor PurchaseOrderEventLog as sink is {
    inlet IncomingPurchaseOrderLog is type PurchaseOrderEvent    handler PurchaseOrderLogIntake is {
      on other is {
        tell command LogPurchaseOrderEvent to repository SupplyChain.PurchaseOrderRepository
        do "append the purchase order event to the context event log"
      }
    } with {
      briefly "PurchaseOrder log intake"
      described as {
        |Routes every published purchase order event into the context's
        |own durable event log.
      }
    }
  } with {
    briefly "PurchaseOrder event log"
    described as {
      |Durable local log of purchase order events this context publishes.
    }
  }
  connector PurchaseOrderToLog is from outlet SupplyChain.PurchaseOrderEventSource.PurchaseOrderEvents to inlet SupplyChain.PurchaseOrderEventLog.IncomingPurchaseOrderLog with {
    briefly "PurchaseOrder event log connector"
    described as {
      |Wires published purchase order events to the context's event log.
    }
  }
  connector PurchaseOrderEventStorage is from outlet SupplyChain.PurchaseOrder.PurchaseOrderEvents2 to inlet SupplyChain.PurchaseOrderRepository.PurchaseOrderRepositoryFromPurchaseOrder with {
    briefly "PurchaseOrder events on their way to storage"
  }
} with {
  briefly "Supply chain context"
  described as {
    | Manages vendor relationships and bulk ordering for
    | the restaurant chain. Coordinates with the inventory
    | context to ensure adequate stock across locations.
  }
}
