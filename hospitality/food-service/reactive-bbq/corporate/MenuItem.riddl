// MenuItem entity for the MenuManagement context
event-sourced entity MenuItem as flow is {
  type MenuItemCommand is one of {
    MenuItem.CreateMenuItem or MenuItem.UpdateMenuItem or MenuItem.SetPrice or MenuItem.RetireMenuItem
  } with {
    briefly "MenuItem command alternation"
    described as {
      |Commands accepted by the MenuItem entity.
    }
  }
  inlet MenuItemCommands is type MenuItemCommand  outlet MenuItemEvents2 is type MenuItemEvent
  // ---- Commands ----
  command CreateMenuItem yields event MenuItemCreated is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |Identifier for the new menu item.
      }
    }
    menuItemName: String(1,200) with {
      briefly "Name"
      described as {
        |Display name of the menu item.
      }
    }
    menuItemCategory: MenuItemCategory with {
      briefly "Category"
      described as {
        |Where the item sits on the menu — starters, mains, sides, desserts.
        |Drives both the printed layout and which station will cook it.
      }
    }
    menuItemDescription: String(1,1000) with {
      briefly "Description"
      described as {
        |Customer-facing description.
      }
    }
    recipe: RecipeInfo with {
      briefly "Recipe"
      described as {
        |Recipe details.
      }
    }
    pricing: PriceInfo with {
      briefly "Pricing"
      described as {
        |Price and cost information.
      }
    }
  } with {
    briefly "Create menu item"
    described as {
      |Create a new menu item with recipe and pricing.
    }
  }
  command UpdateMenuItem yields event MenuItemUpdated is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |Item to update.
      }
    }
    updatedName: String(1,200)? with {
      briefly "Name"
      described as {
        |The item's new name. Renaming a live item is deliberate and visible:
        |it changes printed menus and every restaurant's screens.
      }
    }
    updatedDescription: String(1,1000)? with {
      briefly "Description"
      described as {
        |The new menu copy, which is what a guest reads to decide. Also the
        |text servers are trained from.
      }
    }
    updatedRecipe: RecipeInfo? with {
      briefly "Recipe"
      described as {
        |The new preparation. Changing it changes theoretical stock usage, so
        |inventory variance shifts the moment this takes effect.
      }
    }
  } with {
    briefly "Update menu item"
    described as {
      |Update menu item details.
    }
  }
  command SetPrice yields event PriceSet is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |Item to set price for.
      }
    }
    updatedPricing: PriceInfo with {
      briefly "Pricing"
      described as {
        |New pricing details.
      }
    }
    effectiveDate: Date with {
      briefly "Effective date"
      described as {
        |When the new price takes effect.
      }
    }
  } with {
    briefly "Set price"
    described as {
      |Set new pricing for a menu item.
    }
  }
  command RetireMenuItem yields event MenuItemRetired is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |Item to retire.
      }
    }
    retiredReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Reason for retirement.
      }
    }
  } with {
    briefly "Retire menu item"
    described as {
      |Retire a menu item from active use.
    }
  }
  // ---- Events ----
  event MenuItemCreated is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |The menu item just created. Every later event carries the same
        |value, so an item's whole history can be assembled from the log.
      }
    }
    menuItemName: String(1,200) with {
      briefly "Name"
      described as {
        |What the item is called on the menu, as guests will read it.
      }
    }
    menuItemCategory: MenuItemCategory with {
      briefly "Category"
      described as {
        |Which part of the menu it belongs to.
      }
    }
    menuItemCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the item was added to the catalogue. Distinct from when it
        |first appeared on a menu, which happens at a release.
      }
    }
  } with {
    briefly "Menu item created"
    described as {
      |Emitted when a new menu item is created.
    }
  }
  event MenuItemUpdated is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |The item being revised. Revisions accumulate against the item rather
        |than creating a new one, so its history stays in one place.
      }
    }
    menuItemUpdatedAt: TimeStamp with {
      briefly "Updated at"
      described as {
        |When the revision was made. What reaches restaurants is still gated
        |by the next release, not by this.
      }
    }
  } with {
    briefly "Menu item updated"
    described as {
      |Emitted when a menu item is updated.
    }
  }
  event PriceSet is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |The item being repriced. Price moves independently of the item's
        |description, which is why it is its own command.
      }
    }
    updatedPricing: PriceInfo with {
      briefly "Pricing"
      described as {
        |New pricing.
      }
    }
    effectiveDate: Date with {
      briefly "Effective date"
      described as {
        |When the new price starts applying. Dated ahead so a rise can be
        |loaded before it is charged.
      }
    }
    priceSetAt: TimeStamp with {
      briefly "Set at"
      described as {
        |When the decision was recorded, as opposed to when it takes effect.
        |Both are kept so a price can be audited against who knew what when.
      }
    }
  } with {
    briefly "Price set"
    described as {
      |Emitted when menu item pricing is changed.
    }
  }
  event MenuItemRetired is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |The item being withdrawn. Retirement keeps the item's history rather
        |than deleting it, since past orders still reference it.
      }
    }
    retiredReason: String(1,500) with {
      briefly "Reason"
      described as {
        |Retirement reason.
      }
    }
    retiredAt: TimeStamp with {
      briefly "Retired at"
      described as {
        |When the item left the catalogue. Orders before this remain valid,
        |which is why the record is retained.
      }
    }
  } with {
    briefly "Menu item retired"
    described as {
      |Emitted when a menu item is retired.
    }
  }
  event PhotoShootCompletionRecorded is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |The item whose change was refused.
      }
    }
    shootId: String(1,50) with {
      briefly "ID"
      described as {
        |Photo shoot.
      }
    }
    photoShootRecordedAt: TimeStamp with {
      briefly "Recorded at"
      described as {
        |When the photo shoot completion was recorded.
      }
    }
  } with {
    briefly "Photo shoot completion recorded"
    described as {
      |Emitted when a completed photo shoot updates menu item images.
    }
  }
  // ---- Queries and Results ----
  query GetMenuItem replies result MenuItemResult is {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |Item to retrieve.
      }
    }
  } with {
    briefly "Get menu item"
    described as {
      |Query a menu item by its identifier.
    }
  }
  result MenuItemResult is  {
    menuItemId: MenuItemId with {
      briefly "MenuItem addressed"
      described as {
        |Which menuitem this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    item: MenuItemStateData with {
      briefly "Item"
      described as {
        |The requested menu item data.
      }
    }
  } with {
    briefly "Menu item result"
    described as {
      |Result containing the requested menu item data.
    }
  }
  // ---- State ----
  record MenuItemStateData is  {
    menuItemId: MenuItemId with {
      briefly "ID"
      described as {
        |The item this state belongs to. Carried through every state so the
        |record can be rebuilt by replaying the event log.
      }
    }
    menuItemName: String(1,200) with {
      briefly "Name"
      described as {
        |The item's current name, held in state so the catalogue lists
        |without a lookup.
      }
    }
    menuItemCategory: MenuItemCategory with {
      briefly "Category"
      described as {
        |The item's current section of the menu, held in state because the
        |printed layout is built from it.
      }
    }
    menuItemDescription: String(1,1000) with {
      briefly "Description"
      described as {
        |Customer-facing description.
      }
    }
    recipe: RecipeInfo with {
      briefly "Recipe"
      described as {
        |Recipe details.
      }
    }
    pricing: PriceInfo with {
      briefly "Pricing"
      described as {
        |Current pricing.
      }
    }
    menuItemLifecycle: MenuItemLifecycle with {
      briefly "Lifecycle"
      described as {
        |Current lifecycle stage.
      }
    }
    menuItemCreatedAt: TimeStamp with {
      briefly "Created at"
      described as {
        |When the item entered the catalogue, held in state so its age reads
        |without replaying the log.
      }
    }
  } with {
    briefly "Menu item state data"
    described as {
      |Full state of a menu item.
    }
  }
  initial state ActiveMenuItem of record MenuItem.MenuItemStateData is {
    initial handler ActiveMenuItemInitHandler is {
      on init is {
        let menuItemCreated: type MenuItemCreated = prompt("the menu item created that brings this menu item into existence")
        yield menuItemCreated
      }
    } with {
      briefly "Active menu item init handler"
      described as {
        |Initializes the active menu item state with default values.
      }
    }
  } with {
    briefly "Active menu item state"
    described as {
      |The primary state of a corporate menu item from
      |creation through recipe updates, pricing changes,
      |and retirement.
    }
  }
  initial handler MenuItemHandler is {
    on createMenuItem: command CreateMenuItem is {
      yield event MenuItemCreated(menuItemId = createMenuItem.menuItemId, menuItemName = createMenuItem.menuItemName, menuItemCategory = createMenuItem.menuItemCategory, menuItemCreatedAt = MenuItemStateData.menuItemCreatedAt)
      send event MenuItemCreated(menuItemId = createMenuItem.menuItemId, menuItemName = createMenuItem.menuItemName, menuItemCategory = createMenuItem.menuItemCategory, menuItemCreatedAt = MenuItemStateData.menuItemCreatedAt) to outlet MenuManagement.MenuItemEventSource.MenuItemEvents
      do "MenuItemCreated event triggers photo shoot
        scheduling via PhotographyService streaming topology"
    }
    on updateMenuItem: command UpdateMenuItem is {
      yield event MenuItemUpdated(menuItemId = updateMenuItem.menuItemId, menuItemUpdatedAt = prompt("the menu item updated at of this menu item updated"))
      send event MenuItemUpdated(menuItemId = updateMenuItem.menuItemId, menuItemUpdatedAt = prompt("the menu item updated at of this menu item updated")) to outlet MenuManagement.MenuItemEventSource.MenuItemEvents
    }
    on setPrice: command SetPrice is {
      yield event PriceSet(menuItemId = setPrice.menuItemId, updatedPricing = setPrice.updatedPricing, effectiveDate = setPrice.effectiveDate, priceSetAt = prompt("the price set at of this price set"))
      send event PriceSet(menuItemId = setPrice.menuItemId, updatedPricing = setPrice.updatedPricing, effectiveDate = setPrice.effectiveDate, priceSetAt = prompt("the price set at of this price set")) to outlet MenuManagement.MenuItemEventSource.MenuItemEvents
    }
    on retireMenuItem: command RetireMenuItem is {
      yield event MenuItemRetired(menuItemId = retireMenuItem.menuItemId, retiredReason = retireMenuItem.retiredReason, retiredAt = prompt("the retired at of this menu item retired"))
      send event MenuItemRetired(menuItemId = retireMenuItem.menuItemId, retiredReason = retireMenuItem.retiredReason, retiredAt = prompt("the retired at of this menu item retired")) to outlet MenuManagement.MenuItemEventSource.MenuItemEvents
    }
    on query GetMenuItem is {
      do "look up MenuItem by GetMenuItem.menuItemId"
      let menuItemResult: type MenuItemResult = prompt("read the menu item from the store")
      reply menuItemResult
    }
    on menuItemCreated: event MenuItemCreated is {
      morph entity MenuManagement.MenuItem to state MenuManagement.MenuItem.ActiveMenuItem with record MenuItem.MenuItemStateData(menuItemId = menuItemCreated.menuItemId, menuItemName = menuItemCreated.menuItemName, menuItemCategory = menuItemCreated.menuItemCategory, menuItemCreatedAt = menuItemCreated.menuItemCreatedAt, menuItemDescription = MenuItemStateData.menuItemDescription, recipe = MenuItemStateData.recipe, pricing = MenuItemStateData.pricing, menuItemLifecycle = DraftLifecycle)
    }
    on event MenuItemUpdated is {
      set state ActiveMenuItem to prompt("apply MenuItemUpdated to the MenuItem state")
    }
    on event PriceSet is {
      set state ActiveMenuItem to prompt("apply PriceSet to the MenuItem state")
    }
    on event MenuItemRetired is {
      set state ActiveMenuItem to prompt("apply MenuItemRetired to the MenuItem state")
    }
      on photoShootCompletionRecorded: event PhotoShootCompletionRecorded is {
      do "apply PhotoShootCompletionRecorded to the menuItem so it can be persisted and replayed"
    }
} with {
    briefly "Menu item command handler"
    described as {
      |Processes menu item lifecycle commands.
    }
  }
} with {
  briefly "Menu item entity"
  described as {
    | Manages the lifecycle of a corporate menu item
    | from creation through recipe updates, pricing
    | changes, and retirement.
  }
}
