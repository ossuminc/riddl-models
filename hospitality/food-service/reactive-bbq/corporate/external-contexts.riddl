// External systems used by the Corporate domain
external context PrintingService as flow is {
  inlet PrintingRequestsIn is command PrintMenus with {
    briefly "What MenuManagement asks the printer to do"
    described as {
      |Its own inlet: an inlet accepts exactly one connector, and the egress
      |one already carries results the other way.
    }
  }
  outlet PrintingToMenuOut is type PrintingEvent
  command PrintMenus yields event MenusPrinted is {
    printJobId: String(1,100) with {
      briefly "Print job ID"
      described as {
        |The printer's handle for the run. Corporate's own release id means
        |nothing to the vendor, so this is what a status query must quote.
      }
    }
    menuVersion: String(1,50) with {
      briefly "Menu version"
      described as {
        |Version of the menu to print.
      }
    }
    printQuantity: Natural with {
      briefly "Quantity"
      described as {
        |Number of copies to print.
      }
    }
  } with {
    briefly "Print menus"
    described as {
      |Submit a menu printing job.
    }
  }
  event MenusPrinted is {
    printJobId: String(1,100) with {
      briefly "Print job ID"
      described as {
        |The printer's handle, echoed back so a run can be matched to the
        |release that ordered it.
      }
    }
    printedAt: TimeStamp with {
      briefly "Printed at"
      described as {
        |When printing completed.
      }
    }
  } with {
    briefly "Menus printed"
    described as {
      |Emitted when menu printing is complete.
    }
  }
  handler PrintingHandler is {
    on other is {
      do "the remaining members of this inlet's type - rejections and events this context does not act on - change nothing here"
    }
    on printMenus: command PrintMenus is {
      yield event MenusPrinted(printJobId = printMenus.printJobId, printedAt = system.now)
      do "submit menu print job to printing service"
    }
  } with {
    briefly "Printing handler"
    described as {
      |Processes menu printing requests through the
      |external printing service.
    }
  }
  type PrintingEvent is PrintingService.MenusPrinted with {
    briefly "Printing event alternation"
    described as {
      |Union of printing service events for streaming.
    }
  }
} with {
  briefly "External printing service"
  described as {
    |Third-party printing service for physical menus.
  }
}
external context PhotographyService as flow is {
  inlet PhotographyRequestsIn is command SchedulePhotoShoot with {
    briefly "What MenuManagement asks the photographer to do"
    described as {
      |Its own inlet, for the same reason as the printer's.
    }
  }
  outlet PhotographyToMenuOut is type PhotographyEvent
  command SchedulePhotoShoot yields event PhotoShootCompleted is {
    shootId: String(1,100) with {
      briefly "Shoot ID"
      described as {
        |Identifier for the photo shoot.
      }
    }
    shootDate: Date with {
      briefly "Date"
      described as {
        |Scheduled date for the shoot.
      }
    }
    menuItemsToPhotograph: String(1,50)+ with {
      briefly "Items"
      described as {
        |Menu item IDs to photograph.
      }
    }
  } with {
    briefly "Schedule photo shoot"
    described as {
      |Schedule a food photography session.
    }
  }
  event PhotoShootCompleted is {
    shootId: String(1,100) with {
      briefly "Shoot ID"
      described as {
        |The photographer's handle for a shoot. Menu photography is
        |commissioned per release, and lead times on it are what usually
        |decide a publication date.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed at"
      described as {
        |When the shoot was completed.
      }
    }
  } with {
    briefly "Photo shoot completed"
    described as {
      |Emitted when a photo shoot is complete.
    }
  }
  handler PhotographyHandler is {
    on other is {
      do "the remaining members of this inlet's type - rejections and events this context does not act on - change nothing here"
    }
    on schedulePhotoShoot: command SchedulePhotoShoot is {
      yield event PhotoShootCompleted(shootId = schedulePhotoShoot.shootId, completedAt = prompt("the completed at of this photo shoot completed"))
      do "schedule food photography session"
    }
  } with {
    briefly "Photography handler"
    described as {
      |Processes photo shoot scheduling requests through
      |the external photography service.
    }
  }
  type PhotographyEvent is PhotographyService.PhotoShootCompleted with {
    briefly "Photography event alternation"
    described as {
      |Union of photography service events for streaming.
    }
  }
} with {
  briefly "External photography service"
  described as {
    |Food photography service for menu images.
  }
}
