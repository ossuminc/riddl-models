// Venue Management - Venue Context
context VenueContext as router is {
  inlet VenueContextFromCateringService is command Booking.SetCatering with {
    briefly "What FromCateringService makes of that service's news"
  }
  connector 'FromCateringService Intake' is from outlet VenueContext.FromCateringService.FromCateringServiceToVenueContext to inlet VenueContext.VenueContextFromCateringService with {
    briefly "What FromCateringService makes of that news, on its way in"
  }
  inlet VenueContextFromResourceInventoryService is command Booking.AddResource with {
    briefly "What FromResourceInventoryService makes of that service's news"
  }
  connector 'FromResourceInventoryService Intake' is from outlet VenueContext.FromResourceInventoryService.FromResourceInventoryServiceToVenueContext to inlet VenueContext.VenueContextFromResourceInventoryService with {
    briefly "What FromResourceInventoryService makes of that news, on its way in"
  }
  inlet VenueContextFromSpaceAvailabilityService is command Booking.ConfirmBooking with {
    briefly "What FromSpaceAvailabilityService makes of that service's news"
  }
  connector 'FromSpaceAvailabilityService Intake' is from outlet VenueContext.FromSpaceAvailabilityService.FromSpaceAvailabilityServiceToVenueContext to inlet VenueContext.VenueContextFromSpaceAvailabilityService with {
    briefly "What FromSpaceAvailabilityService makes of that news, on its way in"
  }
  inlet BookingCommandStreamIn is type BookingCommand  outlet BookingCommandStreamOut is type BookingCommand
  inlet BookingResultStreamIn is result Booking.BookingResult  outlet BookingResultStreamOut is result Booking.BookingResult
  handler VenueContextBoundary is {
    on createBooking: command Booking.CreateBooking is {
      send createBooking to outlet VenueContext.BookingCommandStreamOut
    }
    on addResource: command Booking.AddResource is {
      send addResource to outlet VenueContext.BookingCommandStreamOut
    }
    on removeResource: command Booking.RemoveResource is {
      send removeResource to outlet VenueContext.BookingCommandStreamOut
    }
    on setCatering: command Booking.SetCatering is {
      send setCatering to outlet VenueContext.BookingCommandStreamOut
    }
    on updateEventDetails: command Booking.UpdateEventDetails is {
      send updateEventDetails to outlet VenueContext.BookingCommandStreamOut
    }
    on changeBookingPeriod: command Booking.ChangeBookingPeriod is {
      send changeBookingPeriod to outlet VenueContext.BookingCommandStreamOut
    }
    on confirmBooking: command Booking.ConfirmBooking is {
      send confirmBooking to outlet VenueContext.BookingCommandStreamOut
    }
    on recordDeposit: command Booking.RecordDeposit is {
      send recordDeposit to outlet VenueContext.BookingCommandStreamOut
    }
    on processFinalPayment: command Booking.ProcessFinalPayment is {
      send processFinalPayment to outlet VenueContext.BookingCommandStreamOut
    }
    on startEvent: command Booking.StartEvent is {
      send startEvent to outlet VenueContext.BookingCommandStreamOut
    }
    on completeEvent: command Booking.CompleteEvent is {
      send completeEvent to outlet VenueContext.BookingCommandStreamOut
    }
    on cancelBooking: command Booking.CancelBooking is {
      send cancelBooking to outlet VenueContext.BookingCommandStreamOut
    }
    on bookingResult: result Booking.BookingResult is {
      send bookingResult to outlet VenueContext.BookingResultStreamOut
    }
    on other is {
      error "Unexpected message at the VenueContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BookingCommand Stream Intake' is from outlet VenueContext.BookingCommandStreamOut to inlet VenueContext.Booking.BookingCommands  connector 'BookingResult Stream Egress' is from outlet VenueContext.BookingRepository.BookingRepositoryResponses to inlet VenueContext.BookingResultStreamIn  adaptor FromCateringService from context CateringService as flow is { 
    inlet FromCateringServiceIn is type CateringService.CateringServiceEvent    outlet FromCateringServiceToVenueContext is command Booking.SetCatering
    handler FromCateringServiceHandler is {
      on cateringBooked: event CateringService.CateringBooked is {
        let item0: type Booking.SetCatering = prompt("translate the cateringBooked event into a SetCatering, catering actually booked is what the booking's catering record holds")
        send item0 to outlet VenueContext.FromCateringService.FromCateringServiceToVenueContext
      }
      on cateringCancelled: event CateringService.CateringCancelled is {
        do "the catering is off; the booking recorded cancelling it"
      }
      on other is {
        error "Unexpected message for adaptor FromCateringService"
      }
    } with {
      briefly "from catering service"
      described as {
        |Carries messages from the external CateringService.
      }
    }
  } with {
    briefly "CateringService integration"
    described as {
      |The model's side of the CateringService conversation.
    }
  }
  adaptor ToCateringService to context CateringService as merge is { 
    inlet ToCateringServiceIn is type BookingEvent    inlet ToCateringServiceReplies is result CateringService.CateringPackages    outlet ToCateringServiceOut is type CateringService.CateringServiceCommand
    handler ToCateringServiceHandler is {
      on cateringSet: event Booking.CateringSet is {
        let askAnswer: type CateringService.CateringPackages = ask query CateringService.GetCateringPackages of context CateringService
        do "choosing catering needing what the caterer actually offers"
        let item0: type CateringService.BookCatering = prompt("translate the cateringSet event into a BookCatering, the catering choice being what commits the kitchen")
        send item0 to outlet VenueContext.ToCateringService.ToCateringServiceOut
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        let item0: type CateringService.CancelCatering = prompt("translate the bookingCancelled event into a CancelCatering, cancellation releasing it")
        send item0 to outlet VenueContext.ToCateringService.ToCateringServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCateringService"
      }
    } with {
      briefly "to catering service"
      described as {
        |Carries messages to the external CateringService.
      }
    }
  } with {
    briefly "CateringService integration"
    described as {
      |The model's side of the CateringService conversation.
    }
  }
  adaptor FromFacilitiesManagementService from context FacilitiesManagementService is { 
    inlet FromFacilitiesManagementServiceIn is type FacilitiesManagementService.FacilitiesManagementServiceEvent    handler FromFacilitiesManagementServiceHandler is {
      on setupScheduled: event FacilitiesManagementService.SetupScheduled is {
        do "setup is scheduled; the event starts when the booking says so"
      }
      on teardownScheduled: event FacilitiesManagementService.TeardownScheduled is {
        do "teardown is scheduled; the event completes on its own terms"
      }
      on other is {
        error "Unexpected message for adaptor FromFacilitiesManagementService"
      }
    } with {
      briefly "from facilities management service"
      described as {
        |Carries messages from the external FacilitiesManagementService.
      }
    }
  } with {
    briefly "FacilitiesManagementService integration"
    described as {
      |The model's side of the FacilitiesManagementService conversation.
    }
  }
  adaptor ToFacilitiesManagementService to context FacilitiesManagementService as flow is { 
    inlet ToFacilitiesManagementServiceIn is type BookingEvent    outlet ToFacilitiesManagementServiceOut is type FacilitiesManagementService.FacilitiesManagementServiceCommand
    handler ToFacilitiesManagementServiceHandler is {
      on bookingConfirmed: event Booking.BookingConfirmed is {
        let item0: type FacilitiesManagementService.ScheduleSetup = prompt("translate the bookingConfirmed event into a ScheduleSetup, confirmation being when the room must be made ready")
        send item0 to outlet VenueContext.ToFacilitiesManagementService.ToFacilitiesManagementServiceOut
      }
      on eventCompleted: event Booking.EventCompleted is {
        let item0: type FacilitiesManagementService.ScheduleTeardown = prompt("translate the eventCompleted event into a ScheduleTeardown, and the event ending being when it must be cleared")
        send item0 to outlet VenueContext.ToFacilitiesManagementService.ToFacilitiesManagementServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToFacilitiesManagementService"
      }
    } with {
      briefly "to facilities management service"
      described as {
        |Carries messages to the external FacilitiesManagementService.
      }
    }
  } with {
    briefly "FacilitiesManagementService integration"
    described as {
      |The model's side of the FacilitiesManagementService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type BookingEvent    outlet ToNotificationOut is type NotificationService.NotificationCommand
    handler ToNotificationServiceHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        let ack: type NotificationService.SendBookingAcknowledgement = prompt("translate the bookingCreated event into a SendBookingAcknowledgement that tells the customer we have their request, not that the venue is committed")
        send ack to outlet VenueContext.ToNotificationService.ToNotificationOut
      }
      on bookingConfirmed: event Booking.BookingConfirmed is {
        let confirmed: type NotificationService.SendBookingConfirmation = prompt("translate the bookingConfirmed event into a SendBookingConfirmation telling the customer the venue is committed and the space is held")
        send confirmed to outlet VenueContext.ToNotificationService.ToNotificationOut
        let reminder: type NotificationService.SendEventReminder = prompt("translate the bookingConfirmed event into a SendEventReminder carrying the start of the confirmed period, so the service can raise it before the customer's event — carrying remindAt, the instant it should go out, which is why this send is scheduled rather than immediate")
        send reminder to outlet VenueContext.ToNotificationService.ToNotificationOut at reminder.remindAt
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    inlet FromPaymentProcessingServiceIn is type PaymentProcessingService.PaymentProcessingServiceEvent    handler FromPaymentProcessingServiceHandler is {
      on paymentFailed: event PaymentProcessingService.PaymentFailed is {
        do "an unpaid booking stays unconfirmed; the client is asked again"
      }
      on paymentProcessed: event PaymentProcessingService.PaymentProcessed is {
        do "the payment has cleared; the deposit or final payment was recorded here"
      }
      on refundProcessed: event PaymentProcessingService.RefundProcessed is {
        do "the refund has gone; cancelling was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService as flow is { 
    inlet ToPaymentProcessingServiceIn is type BookingEvent    outlet ToPaymentProcessingServiceOut is type PaymentProcessingService.PaymentProcessingServiceCommand
    handler ToPaymentProcessingServiceHandler is {
      on depositRecorded: event DepositRecorded is {
        let notice: type PaymentProcessingService.ProcessPayment = prompt("translate the depositRecorded event into a ProcessPayment taking the deposit that holds the space")
        send notice to outlet VenueContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on finalPaymentProcessed: event FinalPaymentProcessed is {
        let notice: type PaymentProcessingService.ProcessPayment = prompt("translate the finalPaymentProcessed event into a ProcessPayment taking the balance now that the booking is due")
        send notice to outlet VenueContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on bookingCancelled: event BookingCancelled is {
        let notice: type PaymentProcessingService.ProcessRefund = prompt("translate the bookingCancelled event into a ProcessRefund returning whatever the cancellation terms leave owing to the customer")
        send notice to outlet VenueContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPricingService to context PricingService as merge is { 
    inlet ToPricingServiceIn is type BookingEvent    inlet ToPricingServiceReplies is result PricingService.BookingPrice    outlet ToPricingServiceOut is query PricingService.CalculateBookingPrice
    handler ToPricingServiceHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        let askAnswer: type PricingService.BookingPrice = ask query PricingService.CalculateBookingPrice of context PricingService
        do "a new booking needing a price for the space and the hours"
      }
      on other is {
        error "Unexpected message for adaptor ToPricingService"
      }
    } with {
      briefly "to pricing service"
      described as {
        |Carries messages to the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromResourceInventoryService from context ResourceInventoryService as flow is { 
    inlet FromResourceInventoryServiceIn is type ResourceInventoryService.ResourceInventoryServiceEvent    outlet FromResourceInventoryServiceToVenueContext is command Booking.AddResource
    handler FromResourceInventoryServiceHandler is {
      on resourcesReleased: event ResourceInventoryService.ResourcesReleased is {
        do "resources are given back; removing them was recorded here"
      }
      on resourcesReserved: event ResourceInventoryService.ResourcesReserved is {
        let item0: type Booking.AddResource = prompt("translate the resourcesReserved event into a AddResource, a resource actually held is what the booking can claim")
        send item0 to outlet VenueContext.FromResourceInventoryService.FromResourceInventoryServiceToVenueContext
      }
      on other is {
        error "Unexpected message for adaptor FromResourceInventoryService"
      }
    } with {
      briefly "from resource inventory service"
      described as {
        |Carries messages from the external ResourceInventoryService.
      }
    }
  } with {
    briefly "ResourceInventoryService integration"
    described as {
      |The model's side of the ResourceInventoryService conversation.
    }
  }
  adaptor ToResourceInventoryService to context ResourceInventoryService as merge is { 
    inlet ToResourceInventoryServiceIn is type BookingEvent    inlet ToResourceInventoryServiceReplies is result ResourceInventoryService.AvailableResources    outlet ToResourceInventoryServiceOut is type ResourceInventoryService.ResourceInventoryServiceCommand
    handler ToResourceInventoryServiceHandler is {
      on bookingConfirmed: event Booking.BookingConfirmed is {
        let claim: type ResourceInventoryService.ReserveResources = prompt("translate the bookingConfirmed event into a ReserveResources claiming the equipment and staff the confirmed booking commits to")
        send claim to outlet VenueContext.ToResourceInventoryService.ToResourceInventoryServiceOut
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        let release: type ResourceInventoryService.ReleaseResources = prompt("translate the bookingCancelled event into a ReleaseResources giving the claim back")
        send release to outlet VenueContext.ToResourceInventoryService.ToResourceInventoryServiceOut
      }
      on bookingCreated: event Booking.BookingCreated is {
        let askAnswer: type ResourceInventoryService.AvailableResources = ask query ResourceInventoryService.GetAvailableResources of context ResourceInventoryService
        do "a booking needing to know what the venue can supply"
      }
      on other is {
        error "Unexpected message for adaptor ToResourceInventoryService"
      }
    } with {
      briefly "to resource inventory service"
      described as {
        |Carries messages to the external ResourceInventoryService.
      }
    }
  } with {
    briefly "ResourceInventoryService integration"
    described as {
      |The model's side of the ResourceInventoryService conversation.
    }
  }
  adaptor FromSpaceAvailabilityService from context SpaceAvailabilityService as flow is { 
    inlet FromSpaceAvailabilityServiceIn is type SpaceAvailabilityService.SpaceAvailabilityServiceEvent    outlet FromSpaceAvailabilityServiceToVenueContext is command Booking.ConfirmBooking
    handler FromSpaceAvailabilityServiceHandler is {
      on spaceReleased: event SpaceAvailabilityService.SpaceReleased is {
        do "the space is released; cancelling was recorded here"
      }
      on spaceReserved: event SpaceAvailabilityService.SpaceReserved is {
        let item0: type Booking.ConfirmBooking = prompt("translate the spaceReserved event into a ConfirmBooking, a booking without the space actually held is not confirmed")
        send item0 to outlet VenueContext.FromSpaceAvailabilityService.FromSpaceAvailabilityServiceToVenueContext
      }
      on other is {
        error "Unexpected message for adaptor FromSpaceAvailabilityService"
      }
    } with {
      briefly "from space availability service"
      described as {
        |Carries messages from the external SpaceAvailabilityService.
      }
    }
  } with {
    briefly "SpaceAvailabilityService integration"
    described as {
      |The model's side of the SpaceAvailabilityService conversation.
    }
  }
  adaptor ToSpaceAvailabilityService to context SpaceAvailabilityService as merge is { 
    inlet ToSpaceAvailabilityServiceIn is type BookingEvent    inlet ToSpaceAvailabilityServiceReplies is type SpaceAvailabilityService.SpaceAvailabilityServiceReply    outlet ToSpaceAvailabilityServiceOut is type SpaceAvailabilityService.SpaceAvailabilityServiceCommand
    handler ToSpaceAvailabilityServiceHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        let askAnswer: type SpaceAvailabilityService.AvailableSpaces = ask query SpaceAvailabilityService.SearchAvailableSpaces of context SpaceAvailabilityService
        do "and what else is free if it is not"
        let askAnswer: type SpaceAvailabilityService.SpaceAvailability = ask query SpaceAvailabilityService.CheckSpaceAvailability of context SpaceAvailabilityService
        do "and whether the space it wants is free"
        let item0: type SpaceAvailabilityService.ReserveSpace = prompt("translate the bookingCreated event into a ReserveSpace, the booking being what claims the room")
        send item0 to outlet VenueContext.ToSpaceAvailabilityService.ToSpaceAvailabilityServiceOut
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        let item0: type SpaceAvailabilityService.ReleaseSpace = prompt("translate the bookingCancelled event into a ReleaseSpace, cancellation freeing it")
        send item0 to outlet VenueContext.ToSpaceAvailabilityService.ToSpaceAvailabilityServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToSpaceAvailabilityService"
      }
    } with {
      briefly "to space availability service"
      described as {
        |Carries messages to the external SpaceAvailabilityService.
      }
    }
  } with {
    briefly "SpaceAvailabilityService integration"
    described as {
      |The model's side of the SpaceAvailabilityService conversation.
    }
  }
  include "types.riddl"
  include "Booking.riddl"
  // Repository for booking persistence
  type BookingRepositoryCommand is one of {
    VenueContext.BookingRepository.PersistBookingCancelled or VenueContext.BookingRepository.PersistBookingConfirmed or VenueContext.BookingRepository.PersistBookingCreated or VenueContext.BookingRepository.PersistBookingPeriodChanged or VenueContext.BookingRepository.PersistCateringSet or VenueContext.BookingRepository.PersistDepositRecorded or VenueContext.BookingRepository.PersistEventCompleted or VenueContext.BookingRepository.PersistEventDetailsUpdated or VenueContext.BookingRepository.PersistEventStarted or VenueContext.BookingRepository.PersistFinalPaymentProcessed or VenueContext.BookingRepository.PersistResourceAdded or VenueContext.BookingRepository.PersistResourceRemoved
  } with {
    briefly "Anything that writes BookingRepository"
    described as {
      |The persistence commands BookingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository BookingRepository as flow is {
    inlet BookingRepositoryFromVenueAnalytics is type BookingRepositoryCommand    command PersistBookingPeriodChanged is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingPeriodChanged applies to.
        }
      }
    } with {
      briefly "Persist BookingPeriodChanged"
      described as {
        |Instructs this repository to apply BookingPeriodChanged to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCateringSet is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row CateringSet applies to.
        }
      }
    } with {
      briefly "Persist CateringSet"
      described as {
        |Instructs this repository to apply CateringSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDepositRecorded is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row DepositRecorded applies to.
        }
      }
    } with {
      briefly "Persist DepositRecorded"
      described as {
        |Instructs this repository to apply DepositRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEventDetailsUpdated is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row EventDetailsUpdated applies to.
        }
      }
    } with {
      briefly "Persist EventDetailsUpdated"
      described as {
        |Instructs this repository to apply EventDetailsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEventStarted is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row EventStarted applies to.
        }
      }
    } with {
      briefly "Persist EventStarted"
      described as {
        |Instructs this repository to apply EventStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistResourceAdded is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResourceAdded applies to.
        }
      }
    } with {
      briefly "Persist ResourceAdded"
      described as {
        |Instructs this repository to apply ResourceAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistResourceRemoved is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResourceRemoved applies to.
        }
      }
    } with {
      briefly "Persist ResourceRemoved"
      described as {
        |Instructs this repository to apply ResourceRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingCancelled is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCancelled applies to.
        }
      }
    } with {
      briefly "Persist BookingCancelled"
      described as {
        |Instructs this repository to apply BookingCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingConfirmed is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingConfirmed applies to.
        }
      }
    } with {
      briefly "Persist BookingConfirmed"
      described as {
        |Instructs this repository to apply BookingConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingCreated is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCreated applies to.
        }
      }
    } with {
      briefly "Persist BookingCreated"
      described as {
        |Instructs this repository to apply BookingCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEventCompleted is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row EventCompleted applies to.
        }
      }
    } with {
      briefly "Persist EventCompleted"
      described as {
        |Instructs this repository to apply EventCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinalPaymentProcessed is {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinalPaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist FinalPaymentProcessed"
      described as {
        |Instructs this repository to apply FinalPaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet BookingRepositoryResponses is result Booking.BookingResult
    record StoredBooking is {
      bookingId: BookingId with {
        briefly "bookingId"
        described as {
          |The bookingId column of the stored booking row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored booking row.
        }
      }
      space: SpaceInfo with {
        briefly "space"
        described as {
          |The space column of the stored booking row.
        }
      }
      venue: VenueInfo with {
        briefly "venue"
        described as {
          |The venue column of the stored booking row.
        }
      }
    } with {
      briefly "Stored booking row"
      described as {
        |The persistence shape of booking data as this repository stores it.
      }
    }
    schema BookingData is relational
      of bookings as record StoredBooking
        index on field StoredBooking.bookingId
        index on field StoredBooking.venue.venueId
        index on field StoredBooking.space.spaceId
        index on field StoredBooking.customer.customerId
 with {
      briefly "Booking data schema"
      described as {
        |The relational schema holding booking data for the BookingRepository.
      }
    }
    handler BookingPersistence is {
      on persistBookingPeriodChanged: command PersistBookingPeriodChanged is {
        do "apply BookingPeriodChanged to the stored row"
      }
      on persistCateringSet: command PersistCateringSet is {
        do "apply CateringSet to the stored row"
      }
      on persistDepositRecorded: command PersistDepositRecorded is {
        do "apply DepositRecorded to the stored row"
      }
      on persistEventDetailsUpdated: command PersistEventDetailsUpdated is {
        do "apply EventDetailsUpdated to the stored row"
      }
      on persistEventStarted: command PersistEventStarted is {
        do "apply EventStarted to the stored row"
      }
      on persistResourceAdded: command PersistResourceAdded is {
        do "apply ResourceAdded to the stored row"
      }
      on persistResourceRemoved: command PersistResourceRemoved is {
        do "apply ResourceRemoved to the stored row"
      }
      on persistBookingCancelled: command PersistBookingCancelled is {
        do "apply BookingCancelled to the stored row"
      }
      on persistBookingConfirmed: command PersistBookingConfirmed is {
        do "apply BookingConfirmed to the stored row"
      }
      on persistBookingCreated: command PersistBookingCreated is {
        do "apply BookingCreated to the stored row"
      }
      on persistEventCompleted: command PersistEventCompleted is {
        do "apply EventCompleted to the stored row"
      }
      on persistFinalPaymentProcessed: command PersistFinalPaymentProcessed is {
        do "apply FinalPaymentProcessed to the stored row"
      }
      on query GetVenueStats is {
        let venueStatsView: type VenueStatsView = prompt("read the venue stats projection")
        reply venueStatsView
      }
    } with {
      briefly "Persists booking commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Booking data persistence"
    described as {
      | The BookingRepository provides persistent storage for
      | venue bookings and related data.
    }
  }
  // Projector for venue analytics
  query GetVenueStats replies result VenueStatsView is {
    venueStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which venue stats to retrieve.
      }
    }
  } with {
    briefly "Get venue stats"
    described as {
      |Retrieves the venue stats projection.
    }
  }
  result VenueStatsView is {
    venueStats: VenueAnalytics.VenueStats with {
      briefly "Venue stats"
      described as {
        |The venue stats being returned.
      }
    }
  } with {
    briefly "Venue stats view"
    described as {
      |Read model view carrying the venue stats projection.
    }
  }
  projector VenueAnalytics as flow is {
    updates repository VenueContext.BookingRepository
    outlet VenueAnalyticsToRepository is type BookingRepositoryCommand
    inlet VenueAnalyticsFromBooking is type BookingEvent    record VenueStats is {
      totalBookings: Natural with {
        briefly "Total"
        described as {
          |Total bookings.
        }
      }
      confirmedBookings: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed bookings.
        }
      }
      completedEvents: Natural with {
        briefly "Completed"
        described as {
          |Completed events.
        }
      }
      cancelledBookings: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled bookings.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageBookingValue: Decimal(10,2) with {
        briefly "ABV"
        described as {
          |Average booking value.
        }
      }
      spaceUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Space utilization rate.
        }
      }
    } with {
      briefly "Venue statistics"
      described as {
        |Venue booking metrics.
      }
    }
    handler AnalyticsHandler is {
      on bookingPeriodChanged: event Booking.BookingPeriodChanged is {
        tell command VenueContext.BookingRepository.PersistBookingPeriodChanged(bookingId = bookingPeriodChanged.bookingId) to repository VenueContext.BookingRepository
        do "apply BookingPeriodChanged to the VenueAnalytics projection"
      }
      on cateringSet: event Booking.CateringSet is {
        tell command VenueContext.BookingRepository.PersistCateringSet(bookingId = cateringSet.bookingId) to repository VenueContext.BookingRepository
        do "apply CateringSet to the VenueAnalytics projection"
      }
      on depositRecorded: event Booking.DepositRecorded is {
        tell command VenueContext.BookingRepository.PersistDepositRecorded(bookingId = depositRecorded.bookingId) to repository VenueContext.BookingRepository
        do "apply DepositRecorded to the VenueAnalytics projection"
      }
      on eventDetailsUpdated: event Booking.EventDetailsUpdated is {
        tell command VenueContext.BookingRepository.PersistEventDetailsUpdated(bookingId = eventDetailsUpdated.bookingId) to repository VenueContext.BookingRepository
        do "apply EventDetailsUpdated to the VenueAnalytics projection"
      }
      on eventStarted: event Booking.EventStarted is {
        tell command VenueContext.BookingRepository.PersistEventStarted(bookingId = eventStarted.bookingId) to repository VenueContext.BookingRepository
        do "apply EventStarted to the VenueAnalytics projection"
      }
      on resourceAdded: event Booking.ResourceAdded is {
        tell command VenueContext.BookingRepository.PersistResourceAdded(bookingId = resourceAdded.bookingId) to repository VenueContext.BookingRepository
        do "apply ResourceAdded to the VenueAnalytics projection"
      }
      on resourceRemoved: event Booking.ResourceRemoved is {
        tell command VenueContext.BookingRepository.PersistResourceRemoved(bookingId = resourceRemoved.bookingId) to repository VenueContext.BookingRepository
        do "apply ResourceRemoved to the VenueAnalytics projection"
      }
      on bookingCreated: event Booking.BookingCreated is {
        tell command VenueContext.BookingRepository.PersistBookingCreated(bookingId = bookingCreated.bookingId) to repository VenueContext.BookingRepository
        do "Update booking counts"
      }
      on bookingConfirmed: event Booking.BookingConfirmed is {
        tell command VenueContext.BookingRepository.PersistBookingConfirmed(bookingId = bookingConfirmed.bookingId) to repository VenueContext.BookingRepository
        do "Update confirmed counts"
      }
      on finalPaymentProcessed: event Booking.FinalPaymentProcessed is {
        tell command VenueContext.BookingRepository.PersistFinalPaymentProcessed(bookingId = finalPaymentProcessed.bookingId) to repository VenueContext.BookingRepository
        do "Update revenue metrics"
      }
      on eventCompleted: event Booking.EventCompleted is {
        tell command VenueContext.BookingRepository.PersistEventCompleted(bookingId = eventCompleted.bookingId) to repository VenueContext.BookingRepository
        do "Update completion metrics"
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        tell command VenueContext.BookingRepository.PersistBookingCancelled(bookingId = bookingCancelled.bookingId) to repository VenueContext.BookingRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains venue analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Venue analytics projections"
    described as {
      |Maintains venue booking analytics data.
    }
  }
  // ---- Event publication for Booking ----
  type BookingEvent is one of {
    VenueContext.Booking.BookingCreated or VenueContext.Booking.ResourceAdded or VenueContext.Booking.ResourceRemoved or VenueContext.Booking.CateringSet or VenueContext.Booking.EventDetailsUpdated or VenueContext.Booking.BookingPeriodChanged or VenueContext.Booking.BookingConfirmed or VenueContext.Booking.DepositRecorded or VenueContext.Booking.FinalPaymentProcessed or VenueContext.Booking.EventStarted or VenueContext.Booking.EventCompleted or VenueContext.Booking.BookingCancelled
  } with {
    briefly "Booking event alternation"
    described as {
      |Union of all Booking events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet BookingEventSplit as split is {
    outlet BookingEventSplitToToSpaceAvailabilityService is type BookingEvent
    outlet BookingEventSplitToToResourceInventoryService is type BookingEvent
    outlet BookingEventSplitToToPricingService is type BookingEvent
    outlet BookingEventSplitToToPaymentProcessingService is type BookingEvent
    outlet BookingEventSplitToToNotificationService is type BookingEvent
    outlet BookingEventSplitToToFacilitiesManagementService is type BookingEvent
    outlet BookingEventSplitToToCateringService is type BookingEvent
    inlet BookingEventSplitIn is type BookingEvent    outlet BookingEventSplitToVenueAnalytics is type BookingEvent
    handler BookingEventSplitHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        send bookingCreated to outlet BookingEventSplitToVenueAnalytics
        send bookingCreated to outlet BookingEventSplitToToSpaceAvailabilityService
        send bookingCreated to outlet BookingEventSplitToToResourceInventoryService
        send bookingCreated to outlet BookingEventSplitToToPricingService
        send bookingCreated to outlet BookingEventSplitToToNotificationService
        tell bookingCreated to entity VenueContext.Booking
      }
      on resourceAdded: event Booking.ResourceAdded is {
        send resourceAdded to outlet BookingEventSplitToVenueAnalytics
        tell resourceAdded to entity VenueContext.Booking
      }
      on resourceRemoved: event Booking.ResourceRemoved is {
        send resourceRemoved to outlet BookingEventSplitToVenueAnalytics
        tell resourceRemoved to entity VenueContext.Booking
      }
      on cateringSet: event Booking.CateringSet is {
        send cateringSet to outlet BookingEventSplitToVenueAnalytics
        send cateringSet to outlet BookingEventSplitToToCateringService
        tell cateringSet to entity VenueContext.Booking
      }
      on eventDetailsUpdated: event Booking.EventDetailsUpdated is {
        send eventDetailsUpdated to outlet BookingEventSplitToVenueAnalytics
        tell eventDetailsUpdated to entity VenueContext.Booking
      }
      on bookingPeriodChanged: event Booking.BookingPeriodChanged is {
        send bookingPeriodChanged to outlet BookingEventSplitToVenueAnalytics
        tell bookingPeriodChanged to entity VenueContext.Booking
      }
      on bookingConfirmed: event Booking.BookingConfirmed is {
        send bookingConfirmed to outlet BookingEventSplitToVenueAnalytics
        send bookingConfirmed to outlet BookingEventSplitToToResourceInventoryService
        send bookingConfirmed to outlet BookingEventSplitToToNotificationService
        send bookingConfirmed to outlet BookingEventSplitToToFacilitiesManagementService
        tell bookingConfirmed to entity VenueContext.Booking
      }
      on depositRecorded: event Booking.DepositRecorded is {
        send depositRecorded to outlet BookingEventSplitToVenueAnalytics
        send depositRecorded to outlet BookingEventSplitToToPaymentProcessingService
        tell depositRecorded to entity VenueContext.Booking
      }
      on finalPaymentProcessed: event Booking.FinalPaymentProcessed is {
        send finalPaymentProcessed to outlet BookingEventSplitToVenueAnalytics
        send finalPaymentProcessed to outlet BookingEventSplitToToPaymentProcessingService
        tell finalPaymentProcessed to entity VenueContext.Booking
      }
      on eventStarted: event Booking.EventStarted is {
        send eventStarted to outlet BookingEventSplitToVenueAnalytics
        tell eventStarted to entity VenueContext.Booking
      }
      on eventCompleted: event Booking.EventCompleted is {
        send eventCompleted to outlet BookingEventSplitToVenueAnalytics
        send eventCompleted to outlet BookingEventSplitToToFacilitiesManagementService
        tell eventCompleted to entity VenueContext.Booking
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        send bookingCancelled to outlet BookingEventSplitToVenueAnalytics
        send bookingCancelled to outlet BookingEventSplitToToSpaceAvailabilityService
        send bookingCancelled to outlet BookingEventSplitToToResourceInventoryService
        send bookingCancelled to outlet BookingEventSplitToToPaymentProcessingService
        send bookingCancelled to outlet BookingEventSplitToToCateringService
        tell bookingCancelled to entity VenueContext.Booking
      }
      on other is {
        error "Unexpected message for processor BookingEventSplit"
      }
    } with {
      briefly "Booking event fan-out handler"
      described as {
        |Delivers each Booking event to all of its consumers.
      }
    }
  } with {
    briefly "Booking event fan-out"
    described as {
      |Fans Booking events out to the repository and projectors.
    }
  }
  connector 'ToSpaceAvailabilityService Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToToSpaceAvailabilityService to inlet VenueContext.ToSpaceAvailabilityService.ToSpaceAvailabilityServiceIn with {
    briefly "The Booking events ToSpaceAvailabilityService translates, on their way to it"
  }
  connector 'ToResourceInventoryService Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToToResourceInventoryService to inlet VenueContext.ToResourceInventoryService.ToResourceInventoryServiceIn with {
    briefly "The Booking events ToResourceInventoryService translates, on their way to it"
  }
  connector 'ToPricingService Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToToPricingService to inlet VenueContext.ToPricingService.ToPricingServiceIn with {
    briefly "The Booking events ToPricingService translates, on their way to it"
  }
  connector 'ToPaymentProcessingService Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToToPaymentProcessingService to inlet VenueContext.ToPaymentProcessingService.ToPaymentProcessingServiceIn with {
    briefly "The Booking events ToPaymentProcessingService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToToNotificationService to inlet VenueContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Booking events ToNotificationService translates, on their way to it"
  }
  connector 'ToFacilitiesManagementService Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToToFacilitiesManagementService to inlet VenueContext.ToFacilitiesManagementService.ToFacilitiesManagementServiceIn with {
    briefly "The Booking events ToFacilitiesManagementService translates, on their way to it"
  }
  connector 'ToCateringService Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToToCateringService to inlet VenueContext.ToCateringService.ToCateringServiceIn with {
    briefly "The Booking events ToCateringService translates, on their way to it"
  }
  connector 'BookingEvent Stream' is from outlet VenueContext.Booking.BookingEvents2 to inlet VenueContext.BookingEventSplit.BookingEventSplitIn with {
    briefly "Booking events, fanned out to storage and read models"
  }
  connector 'VenueAnalytics Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToVenueAnalytics to inlet VenueContext.VenueAnalytics.VenueAnalyticsFromBooking with {
    briefly "Booking events feeding the VenueAnalytics projection"
  }
  connector 'VenueAnalytics Storage' is from outlet VenueContext.VenueAnalytics.VenueAnalyticsToRepository to inlet VenueContext.BookingRepository.BookingRepositoryFromVenueAnalytics with {
    briefly "VenueAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for venue management"
  described as {
    | The VenueContext is the bounded context for
    | venue booking and space management.
  }
}
