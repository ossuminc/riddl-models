// Venue Management - Venue Context
context VenueContext as router is {
  inlet BookingCommandStreamIn is type BookingCommand  outlet BookingCommandStreamOut is type BookingCommand
  inlet BookingResultStreamIn is type Booking.BookingResult  outlet BookingResultStreamOut is type Booking.BookingResult
  handler VenueContextBoundary is {
    on createBooking: command Booking.CreateBooking is {
      send createBooking to outlet VenueContext.BookingCommandStreamOut
    }
    on addResource: command Booking.AddResource is {
      send addResource to outlet VenueContext.BookingCommandStreamOut
    }
    on removeResource: command Booking.RemoveResource is {
      send removeResource to outlet VenueContext.BookingCommandStreamOut
    }
    on setCatering: command Booking.SetCatering is {
      send setCatering to outlet VenueContext.BookingCommandStreamOut
    }
    on updateEventDetails: command Booking.UpdateEventDetails is {
      send updateEventDetails to outlet VenueContext.BookingCommandStreamOut
    }
    on changeBookingPeriod: command Booking.ChangeBookingPeriod is {
      send changeBookingPeriod to outlet VenueContext.BookingCommandStreamOut
    }
    on confirmBooking: command Booking.ConfirmBooking is {
      send confirmBooking to outlet VenueContext.BookingCommandStreamOut
    }
    on recordDeposit: command Booking.RecordDeposit is {
      send recordDeposit to outlet VenueContext.BookingCommandStreamOut
    }
    on processFinalPayment: command Booking.ProcessFinalPayment is {
      send processFinalPayment to outlet VenueContext.BookingCommandStreamOut
    }
    on startEvent: command Booking.StartEvent is {
      send startEvent to outlet VenueContext.BookingCommandStreamOut
    }
    on completeEvent: command Booking.CompleteEvent is {
      send completeEvent to outlet VenueContext.BookingCommandStreamOut
    }
    on cancelBooking: command Booking.CancelBooking is {
      send cancelBooking to outlet VenueContext.BookingCommandStreamOut
    }
    on bookingResult: result Booking.BookingResult is {
      send bookingResult to outlet VenueContext.BookingResultStreamOut
    }
    on other is {
      error "Unexpected message at the VenueContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'BookingCommand Stream Intake' is from outlet VenueContext.BookingCommandStreamOut to inlet VenueContext.Booking.BookingCommands  connector 'BookingResult Stream Egress' is from outlet VenueContext.BookingRepository.BookingRepositoryResponses to inlet VenueContext.BookingResultStreamIn  adaptor FromCateringService from context CateringService is { 
    handler FromCateringServiceHandler is {
      on event CateringService.CateringBooked is {
        do "the model receives catering booked"
      }
      on event CateringService.CateringCancelled is {
        do "the model receives catering cancelled"
      }
      on result CateringService.CateringPackages is {
        do "the model receives catering packages"
      }
      on other is {
        error "Unexpected message for adaptor FromCateringService"
      }
    } with {
      briefly "from catering service"
      described as {
        |Carries messages from the external CateringService.
      }
    }
  } with {
    briefly "CateringService integration"
    described as {
      |The model's side of the CateringService conversation.
    }
  }
  adaptor ToCateringService to context CateringService is { 
    handler ToCateringServiceHandler is {
      on command CateringService.BookCatering is {
        do "the model sends book catering"
      }
      on command CateringService.CancelCatering is {
        do "the model sends cancel catering"
      }
      on query CateringService.GetCateringPackages is {
        do "the model sends get catering packages"
      }
      on other is {
        error "Unexpected message for adaptor ToCateringService"
      }
    } with {
      briefly "to catering service"
      described as {
        |Carries messages to the external CateringService.
      }
    }
  } with {
    briefly "CateringService integration"
    described as {
      |The model's side of the CateringService conversation.
    }
  }
  adaptor FromFacilitiesManagementService from context FacilitiesManagementService is { 
    handler FromFacilitiesManagementServiceHandler is {
      on event FacilitiesManagementService.SetupScheduled is {
        do "the model receives setup scheduled"
      }
      on event FacilitiesManagementService.TeardownScheduled is {
        do "the model receives teardown scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromFacilitiesManagementService"
      }
    } with {
      briefly "from facilities management service"
      described as {
        |Carries messages from the external FacilitiesManagementService.
      }
    }
  } with {
    briefly "FacilitiesManagementService integration"
    described as {
      |The model's side of the FacilitiesManagementService conversation.
    }
  }
  adaptor ToFacilitiesManagementService to context FacilitiesManagementService is { 
    handler ToFacilitiesManagementServiceHandler is {
      on command FacilitiesManagementService.ScheduleSetup is {
        do "the model sends schedule setup"
      }
      on command FacilitiesManagementService.ScheduleTeardown is {
        do "the model sends schedule teardown"
      }
      on other is {
        error "Unexpected message for adaptor ToFacilitiesManagementService"
      }
    } with {
      briefly "to facilities management service"
      described as {
        |Carries messages to the external FacilitiesManagementService.
      }
    }
  } with {
    briefly "FacilitiesManagementService integration"
    described as {
      |The model's side of the FacilitiesManagementService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.ConfirmationSent is {
        do "the model receives confirmation sent"
      }
      on event NotificationService.ReminderSent is {
        do "the model receives reminder sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendBookingConfirmation is {
        do "the model sends send booking confirmation"
      }
      on command NotificationService.SendEventReminder is {
        do "the model sends send event reminder"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentProcessed is {
        do "the model receives payment processed"
      }
      on event PaymentProcessingService.RefundProcessed is {
        do "the model receives refund processed"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessPayment is {
        do "the model sends process payment"
      }
      on command PaymentProcessingService.ProcessRefund is {
        do "the model sends process refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromPricingService from context PricingService is { 
    handler FromPricingServiceHandler is {
      on result PricingService.BookingPrice is {
        do "the model receives booking price"
      }
      on other is {
        error "Unexpected message for adaptor FromPricingService"
      }
    } with {
      briefly "from pricing service"
      described as {
        |Carries messages from the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor ToPricingService to context PricingService is { 
    handler ToPricingServiceHandler is {
      on query PricingService.CalculateBookingPrice is {
        do "the model sends calculate booking price"
      }
      on other is {
        error "Unexpected message for adaptor ToPricingService"
      }
    } with {
      briefly "to pricing service"
      described as {
        |Carries messages to the external PricingService.
      }
    }
  } with {
    briefly "PricingService integration"
    described as {
      |The model's side of the PricingService conversation.
    }
  }
  adaptor FromResourceInventoryService from context ResourceInventoryService is { 
    handler FromResourceInventoryServiceHandler is {
      on result ResourceInventoryService.AvailableResources is {
        do "the model receives available resources"
      }
      on event ResourceInventoryService.ResourcesReleased is {
        do "the model receives resources released"
      }
      on event ResourceInventoryService.ResourcesReserved is {
        do "the model receives resources reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromResourceInventoryService"
      }
    } with {
      briefly "from resource inventory service"
      described as {
        |Carries messages from the external ResourceInventoryService.
      }
    }
  } with {
    briefly "ResourceInventoryService integration"
    described as {
      |The model's side of the ResourceInventoryService conversation.
    }
  }
  adaptor ToResourceInventoryService to context ResourceInventoryService is { 
    handler ToResourceInventoryServiceHandler is {
      on query ResourceInventoryService.GetAvailableResources is {
        do "the model sends get available resources"
      }
      on command ResourceInventoryService.ReleaseResources is {
        do "the model sends release resources"
      }
      on command ResourceInventoryService.ReserveResources is {
        do "the model sends reserve resources"
      }
      on other is {
        error "Unexpected message for adaptor ToResourceInventoryService"
      }
    } with {
      briefly "to resource inventory service"
      described as {
        |Carries messages to the external ResourceInventoryService.
      }
    }
  } with {
    briefly "ResourceInventoryService integration"
    described as {
      |The model's side of the ResourceInventoryService conversation.
    }
  }
  adaptor FromSpaceAvailabilityService from context SpaceAvailabilityService is { 
    handler FromSpaceAvailabilityServiceHandler is {
      on result SpaceAvailabilityService.AvailableSpaces is {
        do "the model receives available spaces"
      }
      on result SpaceAvailabilityService.SpaceAvailability is {
        do "the model receives space availability"
      }
      on event SpaceAvailabilityService.SpaceReleased is {
        do "the model receives space released"
      }
      on event SpaceAvailabilityService.SpaceReserved is {
        do "the model receives space reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromSpaceAvailabilityService"
      }
    } with {
      briefly "from space availability service"
      described as {
        |Carries messages from the external SpaceAvailabilityService.
      }
    }
  } with {
    briefly "SpaceAvailabilityService integration"
    described as {
      |The model's side of the SpaceAvailabilityService conversation.
    }
  }
  adaptor ToSpaceAvailabilityService to context SpaceAvailabilityService is { 
    handler ToSpaceAvailabilityServiceHandler is {
      on query SpaceAvailabilityService.CheckSpaceAvailability is {
        do "the model sends check space availability"
      }
      on command SpaceAvailabilityService.ReleaseSpace is {
        do "the model sends release space"
      }
      on command SpaceAvailabilityService.ReserveSpace is {
        do "the model sends reserve space"
      }
      on query SpaceAvailabilityService.SearchAvailableSpaces is {
        do "the model sends search available spaces"
      }
      on other is {
        error "Unexpected message for adaptor ToSpaceAvailabilityService"
      }
    } with {
      briefly "to space availability service"
      described as {
        |Carries messages to the external SpaceAvailabilityService.
      }
    }
  } with {
    briefly "SpaceAvailabilityService integration"
    described as {
      |The model's side of the SpaceAvailabilityService conversation.
    }
  }
  include "types.riddl"
  include "Booking.riddl"
  // Repository for booking persistence
  repository BookingRepository as merge is {
    command PersistBookingCancelled is  {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCancelled applies to.
        }
      }
    } with {
      briefly "Persist BookingCancelled"
      described as {
        |Instructs this repository to apply BookingCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingConfirmed is  {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingConfirmed applies to.
        }
      }
    } with {
      briefly "Persist BookingConfirmed"
      described as {
        |Instructs this repository to apply BookingConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBookingCreated is  {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row BookingCreated applies to.
        }
      }
    } with {
      briefly "Persist BookingCreated"
      described as {
        |Instructs this repository to apply BookingCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEventCompleted is  {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row EventCompleted applies to.
        }
      }
    } with {
      briefly "Persist EventCompleted"
      described as {
        |Instructs this repository to apply EventCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFinalPaymentProcessed is  {
      bookingId: BookingId with {
        briefly "Row addressed"
        described as {
          |Which stored row FinalPaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist FinalPaymentProcessed"
      described as {
        |Instructs this repository to apply FinalPaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet BookingRepositoryFromBooking is type BookingEvent    inlet BookingRepositoryFromVenueAnalytics is type BookingEvent    outlet BookingRepositoryResponses is type Booking.BookingResult
    record StoredBooking is  {
      bookingId: BookingId with {
        briefly "bookingId"
        described as {
          |The bookingId column of the stored booking row.
        }
      }
      customer: CustomerInfo with {
        briefly "customer"
        described as {
          |The customer column of the stored booking row.
        }
      }
      space: SpaceInfo with {
        briefly "space"
        described as {
          |The space column of the stored booking row.
        }
      }
      venue: VenueInfo with {
        briefly "venue"
        described as {
          |The venue column of the stored booking row.
        }
      }
    } with {
      briefly "Stored booking row"
      described as {
        |The persistence shape of booking data as this repository stores it.
      }
    }
    schema BookingData is relational
      of bookings as type StoredBooking
        index on field StoredBooking.bookingId
        index on field StoredBooking.venue.venueId
        index on field StoredBooking.space.spaceId
        index on field StoredBooking.customer.customerId
 with {
      briefly "Booking data schema"
      described as {
        |The relational schema holding booking data for the BookingRepository.
      }
    }
    handler BookingPersistence is {
      on persistBookingCancelled: command PersistBookingCancelled is {
        do "apply BookingCancelled to the stored row"
      }
      on persistBookingConfirmed: command PersistBookingConfirmed is {
        do "apply BookingConfirmed to the stored row"
      }
      on persistBookingCreated: command PersistBookingCreated is {
        do "apply BookingCreated to the stored row"
      }
      on persistEventCompleted: command PersistEventCompleted is {
        do "apply EventCompleted to the stored row"
      }
      on persistFinalPaymentProcessed: command PersistFinalPaymentProcessed is {
        do "apply FinalPaymentProcessed to the stored row"
      }
      on query GetVenueStats is {
        let venueStatsView: type VenueStatsView = prompt("read the venue stats projection")
        reply venueStatsView
      }
      on createBooking: command Booking.CreateBooking is {
        tell event Booking.BookingCreated(bookingId = createBooking.bookingId, venue = createBooking.venue, space = createBooking.space, customer = createBooking.customer, period = createBooking.period, eventDetails = createBooking.eventDetails) to entity VenueContext.Booking
        do "Store new booking"
      }
      on addResource: command Booking.AddResource is {
        tell event Booking.ResourceAdded(bookingId = addResource.bookingId, resource = addResource.resource) to entity VenueContext.Booking
        do "Add resource to booking"
      }
      on removeResource: command Booking.RemoveResource is {
        tell event Booking.ResourceRemoved(bookingId = removeResource.bookingId, resourceId = removeResource.resourceId) to entity VenueContext.Booking
        do "Remove resource from booking"
      }
      on command Booking.SetCatering is {
        do "Store catering selection"
      }
      on updateEventDetails: command Booking.UpdateEventDetails is {
        tell event Booking.EventDetailsUpdated(bookingId = updateEventDetails.bookingId, eventDetails = updateEventDetails.eventDetails) to entity VenueContext.Booking
        do "Update event details"
      }
      on command Booking.ChangeBookingPeriod is {
        do "Update booking period"
      }
      on confirmBooking: command Booking.ConfirmBooking is {
        tell event Booking.BookingConfirmed(bookingId = confirmBooking.bookingId, confirmedBy = confirmBooking.confirmedBy) to entity VenueContext.Booking
        do "Update to confirmed"
      }
      on recordDeposit: command Booking.RecordDeposit is {
        tell event Booking.DepositRecorded(bookingId = recordDeposit.bookingId, amount = recordDeposit.amount, transactionId = recordDeposit.transactionId) to entity VenueContext.Booking
        do "Store deposit payment"
      }
      on processFinalPayment: command Booking.ProcessFinalPayment is {
        tell event Booking.FinalPaymentProcessed(bookingId = processFinalPayment.bookingId, amount = processFinalPayment.amount, transactionId = processFinalPayment.transactionId) to entity VenueContext.Booking
        do "Store final payment"
      }
      on startEvent: command Booking.StartEvent is {
        tell event Booking.EventStarted(bookingId = startEvent.bookingId, startedAt = startEvent.startedAt) to entity VenueContext.Booking
        do "Update to in progress"
      }
      on completeEvent: command Booking.CompleteEvent is {
        tell event Booking.EventCompleted(bookingId = completeEvent.bookingId, completedAt = completeEvent.completedAt, notes = completeEvent.notes) to entity VenueContext.Booking
        do "Update to completed"
      }
      on cancelBooking: command Booking.CancelBooking is {
        tell event Booking.BookingCancelled(bookingId = cancelBooking.bookingId, reason = cancelBooking.reason, cancelledBy = cancelBooking.cancelledBy) to entity VenueContext.Booking
        do "Update to cancelled"
      }
    } with {
      briefly "Persists booking commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Booking data persistence"
    described as {
      | The BookingRepository provides persistent storage for
      | venue bookings and related data.
    }
  }
  // Projector for venue analytics
  query GetVenueStats is  {
    venueStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which venue stats to retrieve.
      }
    }
  } with {
    briefly "Get venue stats"
    described as {
      |Retrieves the venue stats projection.
    }
  }
  result VenueStatsView is  {
    venueStats: VenueAnalytics.VenueStats with {
      briefly "Venue stats"
      described as {
        |The venue stats being returned.
      }
    }
  } with {
    briefly "Venue stats view"
    described as {
      |Read model view carrying the venue stats projection.
    }
  }
  projector VenueAnalytics as flow is {
    updates repository VenueContext.BookingRepository
    inlet VenueAnalyticsFromBooking is type BookingEvent    outlet VenueAnalyticsOut is type BookingEvent
    record VenueStats is  {
      totalBookings: Natural with {
        briefly "Total"
        described as {
          |Total bookings.
        }
      }
      confirmedBookings: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed bookings.
        }
      }
      completedEvents: Natural with {
        briefly "Completed"
        described as {
          |Completed events.
        }
      }
      cancelledBookings: Natural with {
        briefly "Cancelled"
        described as {
          |Cancelled bookings.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageBookingValue: Decimal(10,2) with {
        briefly "ABV"
        described as {
          |Average booking value.
        }
      }
      spaceUtilization: Decimal(5,2) with {
        briefly "Utilization"
        described as {
          |Space utilization rate.
        }
      }
    } with {
      briefly "Venue statistics"
      described as {
        |Venue booking metrics.
      }
    }
    handler AnalyticsHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        tell command VenueContext.BookingRepository.PersistBookingCreated(bookingId = bookingCreated.bookingId) to repository VenueContext.BookingRepository
        do "Update booking counts"
      }
      on bookingConfirmed: event Booking.BookingConfirmed is {
        tell command VenueContext.BookingRepository.PersistBookingConfirmed(bookingId = bookingConfirmed.bookingId) to repository VenueContext.BookingRepository
        do "Update confirmed counts"
      }
      on finalPaymentProcessed: event Booking.FinalPaymentProcessed is {
        tell command VenueContext.BookingRepository.PersistFinalPaymentProcessed(bookingId = finalPaymentProcessed.bookingId) to repository VenueContext.BookingRepository
        do "Update revenue metrics"
      }
      on eventCompleted: event Booking.EventCompleted is {
        tell command VenueContext.BookingRepository.PersistEventCompleted(bookingId = eventCompleted.bookingId) to repository VenueContext.BookingRepository
        do "Update completion metrics"
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        tell command VenueContext.BookingRepository.PersistBookingCancelled(bookingId = bookingCancelled.bookingId) to repository VenueContext.BookingRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains venue analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Venue analytics projections"
    described as {
      |Maintains venue booking analytics data.
    }
  }
  // ---- Event publication for Booking ----
  type BookingEvent is one of {
    VenueContext.Booking.BookingCreated or VenueContext.Booking.ResourceAdded or VenueContext.Booking.ResourceRemoved or VenueContext.Booking.CateringSet or VenueContext.Booking.EventDetailsUpdated or VenueContext.Booking.BookingPeriodChanged or VenueContext.Booking.BookingConfirmed or VenueContext.Booking.DepositRecorded or VenueContext.Booking.FinalPaymentProcessed or VenueContext.Booking.EventStarted or VenueContext.Booking.EventCompleted or VenueContext.Booking.BookingCancelled
  } with {
    briefly "Booking event alternation"
    described as {
      |Union of all Booking events, for streaming and event-sourced
      |persistence.
    }
  }
  processor BookingEventSource as source is {
    outlet BookingEvents is type BookingEvent
    handler BookingSourceHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        send bookingCreated to outlet BookingEvents
      }
      on resourceAdded: event Booking.ResourceAdded is {
        send resourceAdded to outlet BookingEvents
      }
      on resourceRemoved: event Booking.ResourceRemoved is {
        send resourceRemoved to outlet BookingEvents
      }
      on cateringSet: event Booking.CateringSet is {
        send cateringSet to outlet BookingEvents
      }
      on eventDetailsUpdated: event Booking.EventDetailsUpdated is {
        send eventDetailsUpdated to outlet BookingEvents
      }
      on bookingPeriodChanged: event Booking.BookingPeriodChanged is {
        send bookingPeriodChanged to outlet BookingEvents
      }
      on bookingConfirmed: event Booking.BookingConfirmed is {
        send bookingConfirmed to outlet BookingEvents
      }
      on depositRecorded: event Booking.DepositRecorded is {
        send depositRecorded to outlet BookingEvents
      }
      on finalPaymentProcessed: event Booking.FinalPaymentProcessed is {
        send finalPaymentProcessed to outlet BookingEvents
      }
      on eventStarted: event Booking.EventStarted is {
        send eventStarted to outlet BookingEvents
      }
      on eventCompleted: event Booking.EventCompleted is {
        send eventCompleted to outlet BookingEvents
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        send bookingCancelled to outlet BookingEvents
      }
      on other is {
        error "Unexpected message for source BookingEventSource"
      }
    } with {
      briefly "Booking source handler"
      described as {
        |Publishes Booking events onto the outlet.
      }
    }
  } with {
    briefly "Booking event source"
    described as {
      |Publishes Booking entity events into the streaming topology.
    }
  }
  processor BookingEventSink as sink is {
    inlet BookingInlet is type BookingEvent    handler BookingSinkHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        tell bookingCreated to repository VenueContext.BookingRepository
      }
      on resourceAdded: event Booking.ResourceAdded is {
        tell resourceAdded to repository VenueContext.BookingRepository
      }
      on resourceRemoved: event Booking.ResourceRemoved is {
        tell resourceRemoved to repository VenueContext.BookingRepository
      }
      on cateringSet: event Booking.CateringSet is {
        tell cateringSet to repository VenueContext.BookingRepository
      }
      on eventDetailsUpdated: event Booking.EventDetailsUpdated is {
        tell eventDetailsUpdated to repository VenueContext.BookingRepository
      }
      on bookingPeriodChanged: event Booking.BookingPeriodChanged is {
        tell bookingPeriodChanged to repository VenueContext.BookingRepository
      }
      on bookingConfirmed: event Booking.BookingConfirmed is {
        tell bookingConfirmed to repository VenueContext.BookingRepository
      }
      on depositRecorded: event Booking.DepositRecorded is {
        tell depositRecorded to repository VenueContext.BookingRepository
      }
      on finalPaymentProcessed: event Booking.FinalPaymentProcessed is {
        tell finalPaymentProcessed to repository VenueContext.BookingRepository
      }
      on eventStarted: event Booking.EventStarted is {
        tell eventStarted to repository VenueContext.BookingRepository
      }
      on eventCompleted: event Booking.EventCompleted is {
        tell eventCompleted to repository VenueContext.BookingRepository
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        tell bookingCancelled to repository VenueContext.BookingRepository
      }
      on other is {
        error "Unexpected message for sink BookingEventSink"
      }
    } with {
      briefly "Booking sink handler"
      described as {
        |Persists Booking events via the repository.
      }
    }
  } with {
    briefly "Booking event sink"
    described as {
      |Receives Booking events for persistence.
    }
  }
  connector BookingEventFlow is from outlet VenueContext.BookingEventSource.BookingEvents to inlet VenueContext.BookingEventSink.BookingInlet with {
    briefly "Booking event flow"
    described as {
      |Connects the Booking source to its sink.
    }
  }
  processor BookingEventSplit as split is {
    inlet BookingEventSplitIn is type BookingEvent    outlet BookingEventSplitToBookingRepository is type BookingEvent
    outlet BookingEventSplitToVenueAnalytics is type BookingEvent
    handler BookingEventSplitHandler is {
      on bookingCreated: event Booking.BookingCreated is {
        send bookingCreated to outlet BookingEventSplitToBookingRepository
        send bookingCreated to outlet BookingEventSplitToVenueAnalytics
        tell bookingCreated to entity VenueContext.Booking
      }
      on resourceAdded: event Booking.ResourceAdded is {
        send resourceAdded to outlet BookingEventSplitToBookingRepository
        send resourceAdded to outlet BookingEventSplitToVenueAnalytics
        tell resourceAdded to entity VenueContext.Booking
      }
      on resourceRemoved: event Booking.ResourceRemoved is {
        send resourceRemoved to outlet BookingEventSplitToBookingRepository
        send resourceRemoved to outlet BookingEventSplitToVenueAnalytics
        tell resourceRemoved to entity VenueContext.Booking
      }
      on cateringSet: event Booking.CateringSet is {
        send cateringSet to outlet BookingEventSplitToBookingRepository
        send cateringSet to outlet BookingEventSplitToVenueAnalytics
        tell cateringSet to entity VenueContext.Booking
      }
      on eventDetailsUpdated: event Booking.EventDetailsUpdated is {
        send eventDetailsUpdated to outlet BookingEventSplitToBookingRepository
        send eventDetailsUpdated to outlet BookingEventSplitToVenueAnalytics
        tell eventDetailsUpdated to entity VenueContext.Booking
      }
      on bookingPeriodChanged: event Booking.BookingPeriodChanged is {
        send bookingPeriodChanged to outlet BookingEventSplitToBookingRepository
        send bookingPeriodChanged to outlet BookingEventSplitToVenueAnalytics
        tell bookingPeriodChanged to entity VenueContext.Booking
      }
      on bookingConfirmed: event Booking.BookingConfirmed is {
        send bookingConfirmed to outlet BookingEventSplitToBookingRepository
        send bookingConfirmed to outlet BookingEventSplitToVenueAnalytics
        tell bookingConfirmed to entity VenueContext.Booking
      }
      on depositRecorded: event Booking.DepositRecorded is {
        send depositRecorded to outlet BookingEventSplitToBookingRepository
        send depositRecorded to outlet BookingEventSplitToVenueAnalytics
        tell depositRecorded to entity VenueContext.Booking
      }
      on finalPaymentProcessed: event Booking.FinalPaymentProcessed is {
        send finalPaymentProcessed to outlet BookingEventSplitToBookingRepository
        send finalPaymentProcessed to outlet BookingEventSplitToVenueAnalytics
        tell finalPaymentProcessed to entity VenueContext.Booking
      }
      on eventStarted: event Booking.EventStarted is {
        send eventStarted to outlet BookingEventSplitToBookingRepository
        send eventStarted to outlet BookingEventSplitToVenueAnalytics
        tell eventStarted to entity VenueContext.Booking
      }
      on eventCompleted: event Booking.EventCompleted is {
        send eventCompleted to outlet BookingEventSplitToBookingRepository
        send eventCompleted to outlet BookingEventSplitToVenueAnalytics
        tell eventCompleted to entity VenueContext.Booking
      }
      on bookingCancelled: event Booking.BookingCancelled is {
        send bookingCancelled to outlet BookingEventSplitToBookingRepository
        send bookingCancelled to outlet BookingEventSplitToVenueAnalytics
        tell bookingCancelled to entity VenueContext.Booking
      }
      on other is {
        error "Unexpected message for processor BookingEventSplit"
      }
    } with {
      briefly "Booking event fan-out handler"
      described as {
        |Delivers each Booking event to all of its consumers.
      }
    }
  } with {
    briefly "Booking event fan-out"
    described as {
      |Fans Booking events out to the repository and projectors.
    }
  }
  connector 'BookingEvent Stream' is from outlet VenueContext.Booking.BookingEvents2 to inlet VenueContext.BookingEventSplit.BookingEventSplitIn with {
    briefly "Booking events, fanned out to storage and read models"
  }
  connector 'BookingEvent Storage' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToBookingRepository to inlet VenueContext.BookingRepository.BookingRepositoryFromBooking with {
    briefly "Booking events on their way to storage"
  }
  connector 'VenueAnalytics Feed' is from outlet VenueContext.BookingEventSplit.BookingEventSplitToVenueAnalytics to inlet VenueContext.VenueAnalytics.VenueAnalyticsFromBooking with {
    briefly "Booking events feeding the VenueAnalytics projection"
  }
  connector 'VenueAnalytics Storage' is from outlet VenueContext.VenueAnalytics.VenueAnalyticsOut to inlet VenueContext.BookingRepository.BookingRepositoryFromVenueAnalytics with {
    briefly "The VenueAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for venue management"
  described as {
    | The VenueContext is the bounded context for
    | venue booking and space management.
  }
}
