// Venue Management - External Contexts
// Space Availability Service
external context SpaceAvailabilityService as flow is {
  type SpaceAvailabilityServiceEvent is one of {
    SpaceReserved or SpaceReleased
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet SpaceAvailabilityServiceEventsOut is type SpaceAvailabilityServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type SpaceAvailabilityServiceCommand is one of {
    ReserveSpace or ReleaseSpace or CheckSpaceAvailability or SearchAvailableSpaces
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet SpaceAvailabilityServiceRequests is type SpaceAvailabilityServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler SpaceAvailabilityServiceBoundary is {
    on query SearchAvailableSpaces is {
      let askAnswer: type AvailableSpaces = prompt("look up what SearchAvailableSpaces asks for")
      reply askAnswer
    }
    on query CheckSpaceAvailability is {
      let askAnswer: type SpaceAvailability = prompt("look up what CheckSpaceAvailability asks for")
      reply askAnswer
    }
    on command ReserveSpace is {
      let spaceReserved: type SpaceReserved = prompt("the space reserved this produces")
      send spaceReserved to outlet SpaceAvailabilityService.SpaceAvailabilityServiceEventsOut
      do "deliver it to the recipient"
    }
    on command ReleaseSpace is {
      let spaceReleased: type SpaceReleased = prompt("the space released this produces")
      send spaceReleased to outlet SpaceAvailabilityService.SpaceAvailabilityServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context SpaceAvailabilityService"
    }
  } with {
    briefly "SpaceAvailabilityService boundary"
  }
  query SearchAvailableSpaces replies result AvailableSpaces is {
    filterVenueId: VenueId? with {
      briefly "Venue"
      described as {
        |Venue filter.
      }
    }
    filterSpaceType: SpaceType? with {
      briefly "Type"
      described as {
        |Space type filter.
      }
    }
    startDateTime: TimeStamp with {
      briefly "Start"
      described as {
        |Start time.
      }
    }
    endDateTime: TimeStamp with {
      briefly "End"
      described as {
        |End time.
      }
    }
    minCapacity: Natural with {
      briefly "Capacity"
      described as {
        |Minimum capacity.
      }
    }
  } with {
    briefly "Search available spaces"
    described as {
      |Searches for available spaces.
    }
  }
  result AvailableSpaces is {
    spaces: SpaceInfo+ with {
      briefly "Spaces"
      described as {
        |Available spaces.
      }
    }
  } with {
    briefly "Available spaces"
    described as {
      |List of available spaces.
    }
  }
  query CheckSpaceAvailability replies result SpaceAvailability is {
    spaceId: SpaceId with {
      briefly "Space"
      described as {
        |Space ID.
      }
    }
    startDateTime: TimeStamp with {
      briefly "Start"
      described as {
        |Start time.
      }
    }
    endDateTime: TimeStamp with {
      briefly "End"
      described as {
        |End time.
      }
    }
  } with {
    briefly "Check availability"
    described as {
      |Checks specific space availability.
    }
  }
  result SpaceAvailability is {
    available: Boolean with {
      briefly "Available"
      described as {
        |Whether available.
      }
    }
    conflictingBookings: BookingId* with {
      briefly "Conflicts"
      described as {
        |Conflicting bookings.
      }
    }
  } with {
    briefly "Space availability"
    described as {
      |Availability check result.
    }
  }
  command ReserveSpace is {
    spaceId: SpaceId with {
      briefly "Space"
      described as {
        |Space ID.
      }
    }
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    period: BookingPeriod with {
      briefly "Period"
      described as {
        |Reservation period.
      }
    }
  } with {
    briefly "Reserve space"
    described as {
      |Reserves space for booking.
    }
  }
  event SpaceReserved is {
    spaceId: SpaceId with {
      briefly "Space"
      described as {
        |Space ID.
      }
    }
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    reservedAt: TimeStamp with {
      briefly "Reserved"
      described as {
        |Reservation time.
      }
    }
  } with {
    briefly "Space reserved"
    described as {
      |Emitted when space is reserved.
    }
  }
  command ReleaseSpace is {
    spaceId: SpaceId with {
      briefly "Space"
      described as {
        |Space ID.
      }
    }
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
  } with {
    briefly "Release space"
    described as {
      |Releases space reservation.
    }
  }
  event SpaceReleased is {
    spaceId: SpaceId with {
      briefly "Space"
      described as {
        |Space ID.
      }
    }
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    releasedAt: TimeStamp with {
      briefly "Released"
      described as {
        |Release time.
      }
    }
  } with {
    briefly "Space released"
    described as {
      |Emitted when space is released.
    }
  }
} with {
  briefly "External space availability"
  described as {
    |External availability service.
  }
}
// Resource Inventory Service
external context ResourceInventoryService as flow is {
  type ResourceInventoryServiceEvent is one of {
    ResourcesReserved or ResourcesReleased
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet ResourceInventoryServiceEventsOut is type ResourceInventoryServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type ResourceInventoryServiceCommand is one of {
    ReleaseResources or ReserveResources or GetAvailableResources
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet ResourceInventoryServiceRequests is type ResourceInventoryServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler ResourceInventoryServiceBoundary is {
    on query GetAvailableResources is {
      let askAnswer: type AvailableResources = prompt("look up what GetAvailableResources asks for")
      reply askAnswer
    }
    on command ReleaseResources is {
      let resourcesReleased: type ResourcesReleased = prompt("the resources released this produces")
      send resourcesReleased to outlet ResourceInventoryService.ResourceInventoryServiceEventsOut
      do "deliver it to the recipient"
    }
    on command ReserveResources is {
      let resourcesReserved: type ResourcesReserved = prompt("the resources reserved this produces")
      send resourcesReserved to outlet ResourceInventoryService.ResourceInventoryServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context ResourceInventoryService"
    }
  } with {
    briefly "ResourceInventoryService boundary"
  }
  query GetAvailableResources replies result AvailableResources is {
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Venue ID.
      }
    }
    resourceType: String(1,50)? with {
      briefly "Type"
      described as {
        |Resource type.
      }
    }
    dateTime: TimeStamp with {
      briefly "Date"
      described as {
        |Availability date.
      }
    }
  } with {
    briefly "Get available resources"
    described as {
      |Retrieves available resources.
    }
  }
  result AvailableResources is {
    resources: ResourceItem+ with {
      briefly "Resources"
      described as {
        |Available resources.
      }
    }
  } with {
    briefly "Available resources"
    described as {
      |List of available resources.
    }
  }
  command ReserveResources is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    resources: ResourceItem+ with {
      briefly "Resources"
      described as {
        |Resources to reserve.
      }
    }
    period: BookingPeriod with {
      briefly "Period"
      described as {
        |Reservation period.
      }
    }
  } with {
    briefly "Reserve resources"
    described as {
      |Reserves resources for booking.
    }
  }
  event ResourcesReserved is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    resourceCount: Natural with {
      briefly "Count"
      described as {
        |Resources reserved.
      }
    }
    reservedAt: TimeStamp with {
      briefly "Reserved"
      described as {
        |Reservation time.
      }
    }
  } with {
    briefly "Resources reserved"
    described as {
      |Emitted when resources are reserved.
    }
  }
  command ReleaseResources is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
  } with {
    briefly "Release resources"
    described as {
      |Releases reserved resources.
    }
  }
  event ResourcesReleased is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    releasedAt: TimeStamp with {
      briefly "Released"
      described as {
        |Release time.
      }
    }
  } with {
    briefly "Resources released"
    described as {
      |Emitted when resources are released.
    }
  }
} with {
  briefly "External resource inventory"
  described as {
    |External resource management service.
  }
}
// Catering Service
external context CateringService as flow is {
  type CateringServiceEvent is one of {
    CateringBooked or CateringCancelled
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet CateringServiceEventsOut is type CateringServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type CateringServiceCommand is one of {
    BookCatering or CancelCatering or GetCateringPackages
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet CateringServiceRequests is type CateringServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler CateringServiceBoundary is {
    on query GetCateringPackages is {
      let askAnswer: type CateringPackages = prompt("look up what GetCateringPackages asks for")
      reply askAnswer
    }
    on command BookCatering is {
      let cateringBooked: type CateringBooked = prompt("the catering booked this produces")
      send cateringBooked to outlet CateringService.CateringServiceEventsOut
      do "deliver it to the recipient"
    }
    on command CancelCatering is {
      let cateringCancelled: type CateringCancelled = prompt("the catering cancelled this produces")
      send cateringCancelled to outlet CateringService.CateringServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CateringService"
    }
  } with {
    briefly "CateringService boundary"
  }
  query GetCateringPackages replies result CateringPackages is {
    venueId: VenueId with {
      briefly "Venue"
      described as {
        |Venue ID.
      }
    }
    filterEventType: EventType? with {
      briefly "Event type"
      described as {
        |Event type filter.
      }
    }
  } with {
    briefly "Get catering packages"
    described as {
      |Retrieves available packages.
    }
  }
  result CateringPackages is {
    packages: CateringSelection+ with {
      briefly "Packages"
      described as {
        |Available packages.
      }
    }
  } with {
    briefly "Catering packages"
    described as {
      |List of catering options.
    }
  }
  command BookCatering is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    catering: CateringSelection with {
      briefly "Catering"
      described as {
        |Catering selection.
      }
    }
    eventDate: Date with {
      briefly "Date"
      described as {
        |Event date.
      }
    }
  } with {
    briefly "Book catering"
    described as {
      |Books catering for event.
    }
  }
  event CateringBooked is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    totalAmount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Catering amount.
      }
    }
    bookedAt: TimeStamp with {
      briefly "Booked"
      described as {
        |Booking time.
      }
    }
  } with {
    briefly "Catering booked"
    described as {
      |Emitted when catering is booked.
    }
  }
  command CancelCatering is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
  } with {
    briefly "Cancel catering"
    described as {
      |Cancels catering booking.
    }
  }
  event CateringCancelled is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Catering cancelled"
    described as {
      |Emitted when catering is cancelled.
    }
  }
} with {
  briefly "External catering service"
  described as {
    |External catering management.
  }
}
// Pricing Service
external context PricingService as sink is {
  inlet PricingServiceRequests is query CalculateBookingPrice with {
    briefly "What this context asks the service to send"
  }
  handler PricingServiceBoundary is {
    on query CalculateBookingPrice is {
      let askAnswer: type BookingPrice = prompt("look up what CalculateBookingPrice asks for")
      reply askAnswer
    }
    on other is {
      error "Unexpected message for external context PricingService"
    }
  } with {
    briefly "PricingService boundary"
  }
  query CalculateBookingPrice replies result BookingPrice is {
    space: SpaceInfo with {
      briefly "Space"
      described as {
        |Space info.
      }
    }
    period: BookingPeriod with {
      briefly "Period"
      described as {
        |Booking period.
      }
    }
    estimateResources: ResourceItem* with {
      briefly "Resources"
      described as {
        |Resources.
      }
    }
    estimateCatering: CateringSelection? with {
      briefly "Catering"
      described as {
        |Catering.
      }
    }
  } with {
    briefly "Calculate price"
    described as {
      |Calculates booking price.
    }
  }
  result BookingPrice is {
    pricing: BookingPricing with {
      briefly "Pricing"
      described as {
        |Pricing details.
      }
    }
  } with {
    briefly "Booking price"
    described as {
      |Calculated pricing.
    }
  }
} with {
  briefly "External pricing service"
  described as {
    |External pricing calculation.
  }
}
// Payment Processing Service
external context PaymentProcessingService as flow is {
  type PaymentProcessingServiceEvent is one of {
    PaymentProcessed or PaymentFailed or RefundProcessed
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet PaymentProcessingServiceEventsOut is type PaymentProcessingServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type PaymentProcessingServiceCommand is one of {
    ProcessPayment or ProcessRefund
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet PaymentProcessingServiceRequests is type PaymentProcessingServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler PaymentProcessingServiceBoundary is {
    on command ProcessPayment is {
      let paymentProcessed: type PaymentProcessed = prompt("the payment processed this produces")
      send paymentProcessed to outlet PaymentProcessingService.PaymentProcessingServiceEventsOut
      do "deliver it to the recipient"
    }
    on command ProcessRefund is {
      let refundProcessed: type RefundProcessed = prompt("the refund processed this produces")
      send refundProcessed to outlet PaymentProcessingService.PaymentProcessingServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context PaymentProcessingService"
    }
  } with {
    briefly "PaymentProcessingService boundary"
  }
  command ProcessPayment is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Payment amount.
      }
    }
    paymentMethod: String(1,50) with {
      briefly "Method"
      described as {
        |Payment method.
      }
    }
    paymentToken: String(1,200) with {
      briefly "Token"
      described as {
        |Payment token.
      }
    }
  } with {
    briefly "Process payment"
    described as {
      |Processes payment.
    }
  }
  event PaymentProcessed is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    transactionId: String(1,100) with {
      briefly "Transaction"
      described as {
        |Transaction ID.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Amount processed.
      }
    }
    processedAt: TimeStamp with {
      briefly "Processed"
      described as {
        |Process time.
      }
    }
  } with {
    briefly "Payment processed"
    described as {
      |Emitted when payment succeeds.
    }
  }
  event PaymentFailed is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    errorCode: String(1,50) with {
      briefly "Error"
      described as {
        |Error code.
      }
    }
    errorMessage: String(1,500) with {
      briefly "Message"
      described as {
        |Error message.
      }
    }
    failedAt: TimeStamp with {
      briefly "Failed"
      described as {
        |Failure time.
      }
    }
  } with {
    briefly "Payment failed"
    described as {
      |Emitted when payment fails.
    }
  }
  command ProcessRefund is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Refund amount.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Refund reason.
      }
    }
  } with {
    briefly "Process refund"
    described as {
      |Processes refund.
    }
  }
  event RefundProcessed is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    refundId: String(1,100) with {
      briefly "Refund"
      described as {
        |Refund ID.
      }
    }
    amount: Decimal(10,2) with {
      briefly "Amount"
      described as {
        |Refund amount.
      }
    }
    processedAt: TimeStamp with {
      briefly "Processed"
      described as {
        |Process time.
      }
    }
  } with {
    briefly "Refund processed"
    described as {
      |Emitted when refund is processed.
    }
  }
} with {
  briefly "External payment processing"
  described as {
    |External payment service.
  }
}
// Notification Service
external context NotificationService as sink is {
  type NotificationCommand is one of {
    SendBookingAcknowledgement or SendBookingConfirmation or SendEventReminder
  } with {
    briefly "Everything this service can be asked to send"
    described as {
      |A port carries one type, so the channel into this service needs a name
      |for the whole request set.
    }
  }
  inlet NotificationRequests is type NotificationCommand with {
    briefly "Everything the restaurant asks this service to send"
  }
  handler NotificationServiceBoundary is {
    on command SendBookingAcknowledgement is {
      do "send the acknowledgement to the customer"
    }
    on command SendBookingConfirmation is {
      do "send the confirmation to the customer"
    }
    on command SendEventReminder is {
      do "send the reminder to the customer"
    }
    on other is {
      error "Unexpected message for external context NotificationService"
    }
  } with {
    briefly "Notification service boundary"
    described as {
      |What the external service accepts.
    }
  }
  command SendBookingAcknowledgement is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking the request was raised against.
      }
    }
    customerEmail: String(5,254) with {
      briefly "Recipient"
      described as {
        |Where to send the acknowledgement.
      }
    }
  } with {
    briefly "Acknowledge that a booking request was received"
    described as {
      |Sent as soon as the request arrives, before the venue has committed.
      |It says "we have your request", not "your booking is confirmed", and
      |may still be followed by a rejection.
    }
  }
  command SendBookingConfirmation is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    customerEmail: String(5,254) with {
      briefly "Email"
      described as {
        |Customer email.
      }
    }
    bookingDetails: String(1,5000) with {
      briefly "Details"
      described as {
        |Booking details.
      }
    }
  } with {
    briefly "Send confirmation"
    described as {
      |Sends booking confirmation.
    }
  }
  event ConfirmationSent is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Confirmation sent"
    described as {
      |Emitted when confirmation is sent.
    }
  }
  command SendEventReminder is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    customerEmail: String(5,254) with {
      briefly "Email"
      described as {
        |Customer email.
      }
    }
    eventStart: TimeStamp with {
      briefly "Starts"
      described as {
        |When the event begins. The deadline the reminder is scheduled
        |against.
      }
    }
    remindAt: TimeStamp with {
      briefly "Send at"
      described as {
        |The instant this reminder should go out. Carried explicitly because it
        |is `remindDaysBefore` before `eventStart` and the language has no
        |arithmetic to compute it: a fill must work it out from the two fields
        |beside it.
      }
    }
    remindDaysBefore: Natural with {
      briefly "Lead time"
      described as {
        |How many days before the event the reminder is wanted. A lead time,
        |not a countdown: the venue states the policy when it hands over the
        |deadline, and the service works out the send date from it.
      }
    }
  } with {
    briefly "Send reminder"
    described as {
      |Sends event reminder.
    }
  }
  event ReminderSent is {
    bookingId: BookingId with {
      briefly "Booking"
      described as {
        |Booking ID.
      }
    }
    sentAt: TimeStamp with {
      briefly "Sent"
      described as {
        |Send time.
      }
    }
  } with {
    briefly "Reminder sent"
    described as {
      |Emitted when reminder is sent.
    }
  }
} with {
  briefly "External notifications"
  described as {
    |External notification service.
  }
}
// Facilities Management Service
external context FacilitiesManagementService as flow is {
  type FacilitiesManagementServiceEvent is one of {
    SetupScheduled or TeardownScheduled
  } with {
    briefly "Everything this service tells the model, unasked"
  }
  outlet FacilitiesManagementServiceEventsOut is type FacilitiesManagementServiceEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type FacilitiesManagementServiceCommand is one of {
    ScheduleSetup or ScheduleTeardown
  } with {
    briefly "Everything this service can be asked to send"
  }
  inlet FacilitiesManagementServiceRequests is type FacilitiesManagementServiceCommand with {
    briefly "What this context asks the service to send"
  }
  handler FacilitiesManagementServiceBoundary is {
    on command ScheduleSetup is {
      let setupScheduled: type SetupScheduled = prompt("the setup scheduled this produces")
      send setupScheduled to outlet FacilitiesManagementService.FacilitiesManagementServiceEventsOut
      do "deliver it to the recipient"
    }
    on command ScheduleTeardown is {
      let teardownScheduled: type TeardownScheduled = prompt("the teardown scheduled this produces")
      send teardownScheduled to outlet FacilitiesManagementService.FacilitiesManagementServiceEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context FacilitiesManagementService"
    }
  } with {
