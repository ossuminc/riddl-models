// Venue Management Domain Model
// Event venue booking and facility management
domain VenueManagement is {
  persistent connector 'SpaceAvailabilityServiceReply Stream' is from outlet SpaceAvailabilityService.SpaceAvailabilityServiceRepliesOut to inlet VenueContext.ToSpaceAvailabilityService.ToSpaceAvailabilityServiceReplies with {
    briefly "What SpaceAvailabilityService answers VenueContext"
  }
  persistent connector 'ResourceInventoryServiceReply Stream' is from outlet ResourceInventoryService.ResourceInventoryServiceRepliesOut to inlet VenueContext.ToResourceInventoryService.ToResourceInventoryServiceReplies with {
    briefly "What ResourceInventoryService answers VenueContext"
  }
  persistent connector 'PricingServiceReply Stream' is from outlet PricingService.PricingServiceRepliesOut to inlet VenueContext.ToPricingService.ToPricingServiceReplies with {
    briefly "What PricingService answers VenueContext"
  }
  persistent connector 'CateringServiceReply Stream' is from outlet CateringService.CateringServiceRepliesOut to inlet VenueContext.ToCateringService.ToCateringServiceReplies with {
    briefly "What CateringService answers VenueContext"
  }
  persistent connector 'CateringServiceEvent Stream' is from outlet CateringService.CateringServiceEventsOut to inlet VenueContext.FromCateringService.FromCateringServiceIn with {
    briefly "What CateringService tells VenueContext, unasked"
  }
  persistent connector 'FacilitiesManagementServiceEvent Stream' is from outlet FacilitiesManagementService.FacilitiesManagementServiceEventsOut to inlet VenueContext.FromFacilitiesManagementService.FromFacilitiesManagementServiceIn with {
    briefly "What FacilitiesManagementService tells VenueContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet VenueContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells VenueContext, unasked"
  }
  persistent connector 'ResourceInventoryServiceEvent Stream' is from outlet ResourceInventoryService.ResourceInventoryServiceEventsOut to inlet VenueContext.FromResourceInventoryService.FromResourceInventoryServiceIn with {
    briefly "What ResourceInventoryService tells VenueContext, unasked"
  }
  persistent connector 'SpaceAvailabilityServiceEvent Stream' is from outlet SpaceAvailabilityService.SpaceAvailabilityServiceEventsOut to inlet VenueContext.FromSpaceAvailabilityService.FromSpaceAvailabilityServiceIn with {
    briefly "What SpaceAvailabilityService tells VenueContext, unasked"
  }
  persistent connector 'PricingServiceRequest Stream' is from outlet VenueContext.ToPricingService.ToPricingServiceOut to inlet PricingService.PricingServiceRequests with {
    briefly "What VenueContext asks PricingService to send"
  }
  persistent connector 'FacilitiesManagementServiceRequest Stream' is from outlet VenueContext.ToFacilitiesManagementService.ToFacilitiesManagementServiceOut to inlet FacilitiesManagementService.FacilitiesManagementServiceRequests with {
    briefly "What VenueContext asks FacilitiesManagementService to send"
  }
  persistent connector 'SpaceAvailabilityServiceRequest Stream' is from outlet VenueContext.ToSpaceAvailabilityService.ToSpaceAvailabilityServiceOut to inlet SpaceAvailabilityService.SpaceAvailabilityServiceRequests with {
    briefly "What VenueContext asks SpaceAvailabilityService to send"
  }
  persistent connector 'CateringServiceRequest Stream' is from outlet VenueContext.ToCateringService.ToCateringServiceOut to inlet CateringService.CateringServiceRequests with {
    briefly "What VenueContext asks CateringService to send"
  }
  persistent connector 'ResourceInventoryServiceRequest Stream' is from outlet VenueContext.ToResourceInventoryService.ToResourceInventoryServiceOut to inlet ResourceInventoryService.ResourceInventoryServiceRequests with {
    briefly "What VenueContext asks ResourceInventoryService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet VenueContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What VenueContext asks PaymentProcessingService to send"
  }
  persistent connector 'NotificationRequest Stream' is from outlet VenueContext.ToNotificationService.ToNotificationOut to inlet NotificationService.NotificationRequests with {
    briefly "What the venue asks the notification service to send"
    described as {
      |Acknowledgements on request and confirmations on commitment, both
      |translated at the adaptor that owns this boundary.
    }
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user VenueManager is "person managing venue" with {
    briefly "Venue Manager"
    described as {
      |Person overseeing venue operations.
    }
  }
  user EventPlanner is "person booking venue" with {
    briefly "Event Planner"
    described as {
      |Person arranging events at venue.
    }
  }
  user FacilitiesStaff is "person maintaining facilities" with {
    briefly "Facilities Staff"
    described as {
      |Person maintaining venue facilities.
    }
  }
  epic VenueEpic is {
    user EventPlanner wants to "to book venues for events" so that "events have appropriate spaces"
    case BookVenue is {
      user EventPlanner wants to "to reserve a venue space" so that "the event has a confirmed location"
      step is "Planner searches" "available spaces" "by criteria" with {
        briefly "Search spaces"
        described as {
          |Find available venues.
        }
      }
      step is "Planner selects" "preferred space and time" "from options" with {
        briefly "Select space"
        described as {
          |Choose space and time.
        }
      }
      step take input VenueManagementApp.VenueManagementScreen.CreateBookingInput from user EventPlanner with {
        briefly "Create booking"
        described as {
          |Submit booking request.
        }
      }
      step is "System confirms" "booking details" "to planner" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Book venue"
      described as {
        |Booking venue spaces for events.
      }
    }
  } with {
    briefly "Venue management"
    described as {
      | Epic covering venue booking, space management,
      | and facility coordination.
    }
  }
  include "VenueContext.riddl"
  include "external-contexts.riddl"
  application context VenueManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in VenueManagement are delivered.
      }
    }
    group VenueManagementScreen is {
      input CreateBookingInput acquires command VenueContext.Booking.CreateBooking with {
        briefly "Create booking control"
        described as {
          |The control through which a user submits the create booking request.
        }
      }
    } with {
      briefly "Venue management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppBookingCommands is type VenueContext.Booking.BookingCommand
    inlet AppBookingRepositoryResponses is result VenueContext.Booking.BookingResult    handler VenueManagementAppHandler is {
      on other is {
        error "Unexpected message for application context VenueManagementApp"
      }
    } with {
      briefly "VenueManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "VenueManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'BookingCommand Stream' is from outlet VenueManagementApp.AppBookingCommands to inlet VenueContext.BookingCommandStreamIn with {
    briefly "Booking commands from the application"
  }
  persistent connector 'BookingResult Stream' is from outlet VenueContext.BookingResultStreamOut to inlet VenueManagementApp.AppBookingRepositoryResponses with {
    briefly "Booking query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet VenueManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Venue management domain"
  described as {
    | The VenueManagement domain handles venue booking,
    | space management, and facility coordination.
  }
}
