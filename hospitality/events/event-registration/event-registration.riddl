// Event Registration Domain Model
// Conference and event attendee registration management
domain EventRegistration is {
  persistent connector 'BadgePrintingServiceEvent Stream' is from outlet BadgePrintingService.BadgePrintingServiceEventsOut to inlet RegistrationContext.FromBadgePrintingService.FromBadgePrintingServiceIn with {
    briefly "What BadgePrintingService tells RegistrationContext, unasked"
  }
  persistent connector 'DiscountServiceEvent Stream' is from outlet DiscountService.DiscountServiceEventsOut to inlet RegistrationContext.FromDiscountService.FromDiscountServiceIn with {
    briefly "What DiscountService tells RegistrationContext, unasked"
  }
  persistent connector 'PaymentProcessingServiceEvent Stream' is from outlet PaymentProcessingService.PaymentProcessingServiceEventsOut to inlet RegistrationContext.FromPaymentProcessingService.FromPaymentProcessingServiceIn with {
    briefly "What PaymentProcessingService tells RegistrationContext, unasked"
  }
  persistent connector 'SessionCapacityServiceEvent Stream' is from outlet SessionCapacityService.SessionCapacityServiceEventsOut to inlet RegistrationContext.FromSessionCapacityService.FromSessionCapacityServiceIn with {
    briefly "What SessionCapacityService tells RegistrationContext, unasked"
  }
  persistent connector 'TicketAvailabilityServiceEvent Stream' is from outlet TicketAvailabilityService.TicketAvailabilityServiceEventsOut to inlet RegistrationContext.FromTicketAvailabilityService.FromTicketAvailabilityServiceIn with {
    briefly "What TicketAvailabilityService tells RegistrationContext, unasked"
  }
  persistent connector 'EventCatalogServiceRequest Stream' is from outlet RegistrationContext.ToEventCatalogService.ToEventCatalogServiceOut to inlet EventCatalogService.EventCatalogServiceRequests with {
    briefly "What RegistrationContext asks EventCatalogService to send"
  }
  persistent connector 'DiscountServiceRequest Stream' is from outlet RegistrationContext.ToDiscountService.ToDiscountServiceOut to inlet DiscountService.DiscountServiceRequests with {
    briefly "What RegistrationContext asks DiscountService to send"
  }
  persistent connector 'BadgePrintingServiceRequest Stream' is from outlet RegistrationContext.ToBadgePrintingService.ToBadgePrintingServiceOut to inlet BadgePrintingService.BadgePrintingServiceRequests with {
    briefly "What RegistrationContext asks BadgePrintingService to send"
  }
  persistent connector 'TicketAvailabilityServiceRequest Stream' is from outlet RegistrationContext.ToTicketAvailabilityService.ToTicketAvailabilityServiceOut to inlet TicketAvailabilityService.TicketAvailabilityServiceRequests with {
    briefly "What RegistrationContext asks TicketAvailabilityService to send"
  }
  persistent connector 'SessionCapacityServiceRequest Stream' is from outlet RegistrationContext.ToSessionCapacityService.ToSessionCapacityServiceOut to inlet SessionCapacityService.SessionCapacityServiceRequests with {
    briefly "What RegistrationContext asks SessionCapacityService to send"
  }
  persistent connector 'PaymentProcessingServiceRequest Stream' is from outlet RegistrationContext.ToPaymentProcessingService.ToPaymentProcessingServiceOut to inlet PaymentProcessingService.PaymentProcessingServiceRequests with {
    briefly "What RegistrationContext asks PaymentProcessingService to send"
  }
  persistent connector 'EmailServiceRequest Stream' is from outlet RegistrationContext.ToEmailService.ToEmailServiceOut to inlet EmailService.EmailServiceRequests with {
    briefly "What RegistrationContext asks EmailService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user EventOrganizer is "person managing event" with {
    briefly "Event Organizer"
    described as {
      |Person organizing the event.
    }
  }
  user Attendee is "person attending event" with {
    briefly "Attendee"
    described as {
      |Person registered for event.
    }
  }
  user CheckInStaff is "person managing check-in" with {
    briefly "Check-In Staff"
    described as {
      |Person handling attendee check-in.
    }
  }
  epic RegistrationEpic is {
    user Attendee wants to "to register for events" so that "I can attend and participate"
    case RegisterForEvent is {
      user Attendee wants to "to register for an upcoming event" so that "I secure my spot"
      step is "Attendee selects" "event and ticket type" "from catalog" with {
        briefly "Select event"
        described as {
          |Choose event and ticket.
        }
      }
      step is "Attendee provides" "registration details" "and preferences" with {
        briefly "Enter details"
        described as {
          |Provide info.
        }
      }
      step take input EventRegistrationApp.EventRegistrationScreen.CreateRegistrationInput from user Attendee with {
        briefly "Create registration"
        described as {
          |Submit registration.
        }
      }
      step is "System sends" "confirmation email" "to attendee" with {
        briefly "Confirm"
        described as {
          |Send confirmation.
        }
      }
    } with {
      briefly "Event registration"
      described as {
        |Registering for events.
      }
    }
  } with {
    briefly "Registration management"
    described as {
      | Epic covering event registration, ticketing,
      | and attendee check-in operations.
    }
  }
  include "RegistrationContext.riddl"
  include "external-contexts.riddl"
  application context EventRegistrationApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EventRegistration are delivered.
      }
    }
    group EventRegistrationScreen is {
      input CreateRegistrationInput acquires command RegistrationContext.Registration.CreateRegistration with {
        briefly "Create registration control"
        described as {
          |The control through which a user submits the create registration request.
        }
      }
    } with {
      briefly "Event registration screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppRegistrationCommands is type RegistrationContext.Registration.RegistrationCommand
    inlet AppRegistrationRepositoryResponses is result RegistrationContext.Registration.RegistrationResult    handler EventRegistrationAppHandler is {
      on other is {
        error "Unexpected message for application context EventRegistrationApp"
      }
    } with {
      briefly "EventRegistrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EventRegistrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'RegistrationCommand Stream' is from outlet EventRegistrationApp.AppRegistrationCommands to inlet RegistrationContext.RegistrationCommandStreamIn with {
    briefly "Registration commands from the application"
  }
  persistent connector 'RegistrationResult Stream' is from outlet RegistrationContext.RegistrationResultStreamOut to inlet EventRegistrationApp.AppRegistrationRepositoryResponses with {
    briefly "Registration query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EventRegistrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Event registration domain"
  described as {
    | The EventRegistration domain handles attendee
    | registration, ticketing, and check-in.
  }
}
