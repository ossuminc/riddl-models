      described as {
        |Carries messages from the external SessionCapacityService.
      }
    }
  } with {
    briefly "SessionCapacityService integration"
    described as {
      |The model's side of the SessionCapacityService conversation.
    }
  }
  adaptor ToSessionCapacityService to context SessionCapacityService is { 
    handler ToSessionCapacityServiceHandler is {
      on query SessionCapacityService.CheckSessionCapacity is {
        do "the model sends check session capacity"
      }
      on command SessionCapacityService.ReleaseSessionSpot is {
        do "the model sends release session spot"
      }
      on command SessionCapacityService.ReserveSessionSpot is {
        do "the model sends reserve session spot"
      }
      on other is {
        error "Unexpected message for adaptor ToSessionCapacityService"
      }
    } with {
      briefly "to session capacity service"
      described as {
        |Carries messages to the external SessionCapacityService.
      }
    }
  } with {
    briefly "SessionCapacityService integration"
    described as {
      |The model's side of the SessionCapacityService conversation.
    }
  }
  adaptor FromTicketAvailabilityService from context TicketAvailabilityService is { 
    handler FromTicketAvailabilityServiceHandler is {
      on result TicketAvailabilityService.TicketAvailability is {
        do "the model receives ticket availability"
      }
      on event TicketAvailabilityService.TicketReleased is {
        do "the model receives ticket released"
      }
      on event TicketAvailabilityService.TicketReserved is {
        do "the model receives ticket reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromTicketAvailabilityService"
      }
    } with {
      briefly "from ticket availability service"
      described as {
        |Carries messages from the external TicketAvailabilityService.
      }
    }
  } with {
    briefly "TicketAvailabilityService integration"
    described as {
      |The model's side of the TicketAvailabilityService conversation.
    }
  }
  adaptor ToTicketAvailabilityService to context TicketAvailabilityService is { 
    handler ToTicketAvailabilityServiceHandler is {
      on query TicketAvailabilityService.CheckAvailability is {
        do "the model sends check availability"
      }
      on command TicketAvailabilityService.ReleaseTicket is {
        do "the model sends release ticket"
      }
      on command TicketAvailabilityService.ReserveTicket is {
        do "the model sends reserve ticket"
      }
      on other is {
        error "Unexpected message for adaptor ToTicketAvailabilityService"
      }
    } with {
      briefly "to ticket availability service"
      described as {
        |Carries messages to the external TicketAvailabilityService.
      }
    }
  } with {
    briefly "TicketAvailabilityService integration"
    described as {
      |The model's side of the TicketAvailabilityService conversation.
    }
  }
  include "types.riddl"
  include "Registration.riddl"
  // Repository for registration persistence
  type RegistrationRepositoryCommand is one of {
    RegistrationContext.RegistrationRepository.PersistAddedToWaitlist or RegistrationContext.RegistrationRepository.PersistAttendeeCheckedIn or RegistrationContext.RegistrationRepository.PersistAttendeeInfoUpdated or RegistrationContext.RegistrationRepository.PersistBadgeAssigned or RegistrationContext.RegistrationRepository.PersistDiscountApplied or RegistrationContext.RegistrationRepository.PersistPaymentProcessed or RegistrationContext.RegistrationRepository.PersistRefundProcessed or RegistrationContext.RegistrationRepository.PersistRegistrationCancelled or RegistrationContext.RegistrationRepository.PersistRegistrationConfirmed or RegistrationContext.RegistrationRepository.PersistRegistrationCreated or RegistrationContext.RegistrationRepository.PersistRegistrationTransferred or RegistrationContext.RegistrationRepository.PersistSessionAttendanceRecorded or RegistrationContext.RegistrationRepository.PersistSessionRegistered or RegistrationContext.RegistrationRepository.PersistSessionUnregistered
  } with {
    briefly "Anything that writes RegistrationRepository"
    described as {
      |The persistence commands RegistrationRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository RegistrationRepository as flow is {
    inlet RegistrationRepositoryFromEventAnalytics is type RegistrationRepositoryCommand    command PersistAddedToWaitlist is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row AddedToWaitlist applies to.
        }
      }
    } with {
      briefly "Persist AddedToWaitlist"
      described as {
        |Instructs this repository to apply AddedToWaitlist to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAttendeeInfoUpdated is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row AttendeeInfoUpdated applies to.
        }
      }
    } with {
      briefly "Persist AttendeeInfoUpdated"
      described as {
        |Instructs this repository to apply AttendeeInfoUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBadgeAssigned is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row BadgeAssigned applies to.
        }
      }
    } with {
      briefly "Persist BadgeAssigned"
      described as {
        |Instructs this repository to apply BadgeAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDiscountApplied is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row DiscountApplied applies to.
        }
      }
    } with {
      briefly "Persist DiscountApplied"
      described as {
        |Instructs this repository to apply DiscountApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRefundProcessed is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RefundProcessed applies to.
        }
      }
    } with {
      briefly "Persist RefundProcessed"
      described as {
        |Instructs this repository to apply RefundProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationTransferred is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationTransferred applies to.
        }
      }
    } with {
      briefly "Persist RegistrationTransferred"
      described as {
        |Instructs this repository to apply RegistrationTransferred to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionAttendanceRecorded is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionAttendanceRecorded applies to.
        }
      }
    } with {
      briefly "Persist SessionAttendanceRecorded"
      described as {
        |Instructs this repository to apply SessionAttendanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionRegistered is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionRegistered applies to.
        }
      }
    } with {
      briefly "Persist SessionRegistered"
      described as {
        |Instructs this repository to apply SessionRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSessionUnregistered is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SessionUnregistered applies to.
        }
      }
    } with {
      briefly "Persist SessionUnregistered"
      described as {
        |Instructs this repository to apply SessionUnregistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAttendeeCheckedIn is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row AttendeeCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist AttendeeCheckedIn"
      described as {
        |Instructs this repository to apply AttendeeCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationCancelled is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationCancelled applies to.
        }
      }
    } with {
      briefly "Persist RegistrationCancelled"
      described as {
        |Instructs this repository to apply RegistrationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationConfirmed is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationConfirmed applies to.
        }
      }
    } with {
      briefly "Persist RegistrationConfirmed"
      described as {
        |Instructs this repository to apply RegistrationConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationCreated is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationCreated applies to.
        }
      }
    } with {
      briefly "Persist RegistrationCreated"
      described as {
        |Instructs this repository to apply RegistrationCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet RegistrationRepositoryResponses is result Registration.RegistrationResult
    record StoredRegistration is {
      registrationId: RegistrationId with {
        briefly "registrationId"
        described as {
          |The registrationId column of the stored registration row.
        }
      }
      attendee: AttendeeInfo with {
        briefly "attendee"
        described as {
          |The attendee column of the stored registration row.
        }
      }
      event: EventInfo with {
        briefly "event"
        described as {
          |The event column of the stored registration row.
        }
      }
    } with {
      briefly "Stored registration row"
      described as {
        |The persistence shape of registration data as this repository stores it.
      }
    }
    schema RegistrationData is relational
      of registrations as record StoredRegistration
        index on field StoredRegistration.registrationId
        index on field StoredRegistration.attendee.attendeeId
        index on field StoredRegistration.event.eventId
 with {
      briefly "Registration data schema"
      described as {
        |The relational schema holding registration data for the RegistrationRepository.
      }
    }
    handler RegistrationPersistence is {
      on persistAddedToWaitlist: command PersistAddedToWaitlist is {
        do "apply AddedToWaitlist to the stored row"
      }
      on persistAttendeeInfoUpdated: command PersistAttendeeInfoUpdated is {
        do "apply AttendeeInfoUpdated to the stored row"
      }
      on persistBadgeAssigned: command PersistBadgeAssigned is {
        do "apply BadgeAssigned to the stored row"
      }
      on persistDiscountApplied: command PersistDiscountApplied is {
        do "apply DiscountApplied to the stored row"
      }
      on persistRefundProcessed: command PersistRefundProcessed is {
        do "apply RefundProcessed to the stored row"
      }
      on persistRegistrationTransferred: command PersistRegistrationTransferred is {
        do "apply RegistrationTransferred to the stored row"
      }
      on persistSessionAttendanceRecorded: command PersistSessionAttendanceRecorded is {
        do "apply SessionAttendanceRecorded to the stored row"
      }
      on persistSessionRegistered: command PersistSessionRegistered is {
        do "apply SessionRegistered to the stored row"
      }
      on persistSessionUnregistered: command PersistSessionUnregistered is {
        do "apply SessionUnregistered to the stored row"
      }
      on persistAttendeeCheckedIn: command PersistAttendeeCheckedIn is {
        do "apply AttendeeCheckedIn to the stored row"
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        do "apply PaymentProcessed to the stored row"
      }
      on persistRegistrationCancelled: command PersistRegistrationCancelled is {
        do "apply RegistrationCancelled to the stored row"
      }
      on persistRegistrationConfirmed: command PersistRegistrationConfirmed is {
        do "apply RegistrationConfirmed to the stored row"
      }
      on persistRegistrationCreated: command PersistRegistrationCreated is {
        do "apply RegistrationCreated to the stored row"
      }
      on query GetEventStats is {
        let eventStatsView: type EventStatsView = prompt("read the event stats projection")
        reply eventStatsView
      }
    } with {
      briefly "Persists registration commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Registration data persistence"
    described as {
      | The RegistrationRepository provides persistent storage for
      | registrations and related data.
    }
  }
  // Projector for event analytics
  query GetEventStats replies result EventStatsView is {
    eventStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which event stats to retrieve.
      }
    }
  } with {
    briefly "Get event stats"
    described as {
      |Retrieves the event stats projection.
    }
  }
  result EventStatsView is {
    eventStats: EventAnalytics.EventStats with {
      briefly "Event stats"
      described as {
        |The event stats being returned.
      }
    }
  } with {
    briefly "Event stats view"
    described as {
      |Read model view carrying the event stats projection.
    }
  }
  projector EventAnalytics as flow is {
    updates repository RegistrationContext.RegistrationRepository
    outlet EventAnalyticsToRepository is type RegistrationRepositoryCommand
    inlet EventAnalyticsFromRegistration is type RegistrationEvent    record EventStats is {
      totalRegistrations: Natural with {
        briefly "Total"
        described as {
          |Total registrations.
        }
      }
      confirmedRegistrations: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed registrations.
        }
      }
      waitlistSize: Natural with {
        briefly "Waitlist"
        described as {
          |Waitlist size.
        }
      }
      checkedInCount: Natural with {
        briefly "Checked in"
        described as {
          |Checked in count.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      checkInRate: Decimal(5,2) with {
        briefly "Check-in rate"
        described as {
          |Check-in percentage.
        }
      }
    } with {
      briefly "Event statistics"
      described as {
        |Event registration metrics.
      }
    }
    handler AnalyticsHandler is {
      on addedToWaitlist: event Registration.AddedToWaitlist is {
        tell command RegistrationContext.RegistrationRepository.PersistAddedToWaitlist(registrationId = addedToWaitlist.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply AddedToWaitlist to the EventAnalytics projection"
      }
      on attendeeInfoUpdated: event Registration.AttendeeInfoUpdated is {
        tell command RegistrationContext.RegistrationRepository.PersistAttendeeInfoUpdated(registrationId = attendeeInfoUpdated.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply AttendeeInfoUpdated to the EventAnalytics projection"
      }
      on badgeAssigned: event Registration.BadgeAssigned is {
        tell command RegistrationContext.RegistrationRepository.PersistBadgeAssigned(registrationId = badgeAssigned.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply BadgeAssigned to the EventAnalytics projection"
      }
      on discountApplied: event Registration.DiscountApplied is {
        tell command RegistrationContext.RegistrationRepository.PersistDiscountApplied(registrationId = discountApplied.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply DiscountApplied to the EventAnalytics projection"
      }
      on refundProcessed: event Registration.RefundProcessed is {
        tell command RegistrationContext.RegistrationRepository.PersistRefundProcessed(registrationId = refundProcessed.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply RefundProcessed to the EventAnalytics projection"
      }
      on registrationTransferred: event Registration.RegistrationTransferred is {
        tell command RegistrationContext.RegistrationRepository.PersistRegistrationTransferred(registrationId = registrationTransferred.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply RegistrationTransferred to the EventAnalytics projection"
      }
      on sessionAttendanceRecorded: event Registration.SessionAttendanceRecorded is {
        tell command RegistrationContext.RegistrationRepository.PersistSessionAttendanceRecorded(registrationId = sessionAttendanceRecorded.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply SessionAttendanceRecorded to the EventAnalytics projection"
      }
      on sessionRegistered: event Registration.SessionRegistered is {
        tell command RegistrationContext.RegistrationRepository.PersistSessionRegistered(registrationId = sessionRegistered.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply SessionRegistered to the EventAnalytics projection"
      }
      on sessionUnregistered: event Registration.SessionUnregistered is {
        tell command RegistrationContext.RegistrationRepository.PersistSessionUnregistered(registrationId = sessionUnregistered.registrationId) to repository RegistrationContext.RegistrationRepository
        do "apply SessionUnregistered to the EventAnalytics projection"
      }
      on registrationCreated: event Registration.RegistrationCreated is {
        tell command RegistrationContext.RegistrationRepository.PersistRegistrationCreated(registrationId = registrationCreated.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update registration counts"
      }
      on registrationConfirmed: event Registration.RegistrationConfirmed is {
        tell command RegistrationContext.RegistrationRepository.PersistRegistrationConfirmed(registrationId = registrationConfirmed.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update confirmed counts"
      }
      on paymentProcessed: event Registration.PaymentProcessed is {
        tell command RegistrationContext.RegistrationRepository.PersistPaymentProcessed(registrationId = paymentProcessed.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update revenue metrics"
      }
      on attendeeCheckedIn: event Registration.AttendeeCheckedIn is {
        tell command RegistrationContext.RegistrationRepository.PersistAttendeeCheckedIn(registrationId = attendeeCheckedIn.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update check-in metrics"
      }
      on registrationCancelled: event Registration.RegistrationCancelled is {
        tell command RegistrationContext.RegistrationRepository.PersistRegistrationCancelled(registrationId = registrationCancelled.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains event analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Event analytics projections"
    described as {
      |Maintains event registration analytics data.
    }
  }
  // ---- Event publication for Registration ----
  type RegistrationEvent is one of {
    RegistrationContext.Registration.RegistrationCreated or RegistrationContext.Registration.DiscountApplied or RegistrationContext.Registration.PaymentProcessed or RegistrationContext.Registration.RegistrationConfirmed or RegistrationContext.Registration.AddedToWaitlist or RegistrationContext.Registration.SessionRegistered or RegistrationContext.Registration.SessionUnregistered or RegistrationContext.Registration.AttendeeCheckedIn or RegistrationContext.Registration.BadgeAssigned or RegistrationContext.Registration.SessionAttendanceRecorded or RegistrationContext.Registration.AttendeeInfoUpdated or RegistrationContext.Registration.RegistrationTransferred or RegistrationContext.Registration.RegistrationCancelled or RegistrationContext.Registration.RefundProcessed
  } with {
    briefly "Registration event alternation"
    described as {
      |Union of all Registration events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RegistrationEventSplit as flow is {
    inlet RegistrationEventSplitIn is type RegistrationEvent    outlet RegistrationEventSplitToEventAnalytics is type RegistrationEvent
    handler RegistrationEventSplitHandler is {
      on registrationCreated: event Registration.RegistrationCreated is {
        send registrationCreated to outlet RegistrationEventSplitToEventAnalytics
        tell registrationCreated to entity RegistrationContext.Registration
      }
      on discountApplied: event Registration.DiscountApplied is {
        send discountApplied to outlet RegistrationEventSplitToEventAnalytics
        tell discountApplied to entity RegistrationContext.Registration
      }
      on paymentProcessed: event Registration.PaymentProcessed is {
        send paymentProcessed to outlet RegistrationEventSplitToEventAnalytics
        tell paymentProcessed to entity RegistrationContext.Registration
      }
      on registrationConfirmed: event Registration.RegistrationConfirmed is {
        send registrationConfirmed to outlet RegistrationEventSplitToEventAnalytics
        tell registrationConfirmed to entity RegistrationContext.Registration
      }
      on addedToWaitlist: event Registration.AddedToWaitlist is {
        send addedToWaitlist to outlet RegistrationEventSplitToEventAnalytics
        tell addedToWaitlist to entity RegistrationContext.Registration
      }
      on sessionRegistered: event Registration.SessionRegistered is {
        send sessionRegistered to outlet RegistrationEventSplitToEventAnalytics
        tell sessionRegistered to entity RegistrationContext.Registration
      }
      on sessionUnregistered: event Registration.SessionUnregistered is {
        send sessionUnregistered to outlet RegistrationEventSplitToEventAnalytics
        tell sessionUnregistered to entity RegistrationContext.Registration
      }
      on attendeeCheckedIn: event Registration.AttendeeCheckedIn is {
        send attendeeCheckedIn to outlet RegistrationEventSplitToEventAnalytics
        tell attendeeCheckedIn to entity RegistrationContext.Registration
      }
      on badgeAssigned: event Registration.BadgeAssigned is {
        send badgeAssigned to outlet RegistrationEventSplitToEventAnalytics
        tell badgeAssigned to entity RegistrationContext.Registration
      }
      on sessionAttendanceRecorded: event Registration.SessionAttendanceRecorded is {
        send sessionAttendanceRecorded to outlet RegistrationEventSplitToEventAnalytics
        tell sessionAttendanceRecorded to entity RegistrationContext.Registration
      }
      on attendeeInfoUpdated: event Registration.AttendeeInfoUpdated is {
        send attendeeInfoUpdated to outlet RegistrationEventSplitToEventAnalytics
        tell attendeeInfoUpdated to entity RegistrationContext.Registration
      }
      on registrationTransferred: event Registration.RegistrationTransferred is {
        send registrationTransferred to outlet RegistrationEventSplitToEventAnalytics
        tell registrationTransferred to entity RegistrationContext.Registration
      }
      on registrationCancelled: event Registration.RegistrationCancelled is {
        send registrationCancelled to outlet RegistrationEventSplitToEventAnalytics
        tell registrationCancelled to entity RegistrationContext.Registration
      }
      on refundProcessed: event Registration.RefundProcessed is {
        send refundProcessed to outlet RegistrationEventSplitToEventAnalytics
        tell refundProcessed to entity RegistrationContext.Registration
      }
      on other is {
        error "Unexpected message for processor RegistrationEventSplit"
      }
    } with {
      briefly "Registration event fan-out handler"
      described as {
        |Delivers each Registration event to all of its consumers.
      }
    }
  } with {
    briefly "Registration event fan-out"
    described as {
      |Fans Registration events out to the repository and projectors.
    }
  }
  connector 'RegistrationEvent Stream' is from outlet RegistrationContext.Registration.RegistrationEvents2 to inlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitIn with {
    briefly "Registration events, fanned out to storage and read models"
  }
  connector 'EventAnalytics Feed' is from outlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitToEventAnalytics to inlet RegistrationContext.EventAnalytics.EventAnalyticsFromRegistration with {
    briefly "Registration events feeding the EventAnalytics projection"
  }
  connector 'EventAnalytics Storage' is from outlet RegistrationContext.EventAnalytics.EventAnalyticsToRepository to inlet RegistrationContext.RegistrationRepository.RegistrationRepositoryFromEventAnalytics with {
    briefly "EventAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for event registration"
  described as {
    | The RegistrationContext is the bounded context for
    | event registration and attendee management.
  }
}
