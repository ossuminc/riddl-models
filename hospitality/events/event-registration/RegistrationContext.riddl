// Event Registration - Registration Context
context RegistrationContext as router is {
  inlet RegistrationCommandStreamIn is type RegistrationCommand
  outlet RegistrationCommandStreamOut is type RegistrationCommand
  inlet RegistrationResultStreamIn is type Registration.RegistrationResult
  outlet RegistrationResultStreamOut is type Registration.RegistrationResult
  handler RegistrationContextBoundary is {
    on createRegistration: command Registration.CreateRegistration is {
      send createRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on applyDiscountCode: command Registration.ApplyDiscountCode is {
      send applyDiscountCode to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on processPayment: command Registration.ProcessPayment is {
      send processPayment to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on confirmRegistration: command Registration.ConfirmRegistration is {
      send confirmRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on addToWaitlist: command Registration.AddToWaitlist is {
      send addToWaitlist to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on registerForSession: command Registration.RegisterForSession is {
      send registerForSession to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on unregisterFromSession: command Registration.UnregisterFromSession is {
      send unregisterFromSession to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on checkIn: command Registration.CheckIn is {
      send checkIn to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on assignBadge: command Registration.AssignBadge is {
      send assignBadge to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on recordSessionAttendance: command Registration.RecordSessionAttendance is {
      send recordSessionAttendance to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on updateAttendeeInfo: command Registration.UpdateAttendeeInfo is {
      send updateAttendeeInfo to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on transferRegistration: command Registration.TransferRegistration is {
      send transferRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on cancelRegistration: command Registration.CancelRegistration is {
      send cancelRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on processRefund: command Registration.ProcessRefund is {
      send processRefund to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on registrationResult: result Registration.RegistrationResult is {
      send registrationResult to outlet RegistrationContext.RegistrationResultStreamOut
    }
    on other is {
      error "Unexpected message at the RegistrationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'RegistrationCommand Stream Intake' is from outlet RegistrationContext.RegistrationCommandStreamOut to inlet RegistrationContext.Registration.RegistrationCommands
  connector 'RegistrationResult Stream Egress' is from outlet RegistrationContext.RegistrationRepository.RegistrationRepositoryResponses to inlet RegistrationContext.RegistrationResultStreamIn
  adaptor FromBadgePrintingService from context BadgePrintingService is { 
    handler FromBadgePrintingServiceHandler is {
      on event BadgePrintingService.BadgePrinted is {
        do "the model receives badge printed"
      }
      on other is {
        error "Unexpected message for adaptor FromBadgePrintingService"
      }
    } with {
      briefly "from badge printing service"
      described as {
        |Carries messages from the external BadgePrintingService.
      }
    }
  } with {
    briefly "BadgePrintingService integration"
    described as {
      |The model's side of the BadgePrintingService conversation.
    }
  }
  adaptor ToBadgePrintingService to context BadgePrintingService is { 
    handler ToBadgePrintingServiceHandler is {
      on command BadgePrintingService.PrintBadge is {
        do "the model sends print badge"
      }
      on other is {
        error "Unexpected message for adaptor ToBadgePrintingService"
      }
    } with {
      briefly "to badge printing service"
      described as {
        |Carries messages to the external BadgePrintingService.
      }
    }
  } with {
    briefly "BadgePrintingService integration"
    described as {
      |The model's side of the BadgePrintingService conversation.
    }
  }
  adaptor FromDiscountService from context DiscountService is { 
    handler FromDiscountServiceHandler is {
      on event DiscountService.DiscountRedeemed is {
        do "the model receives discount redeemed"
      }
      on result DiscountService.DiscountValidation is {
        do "the model receives discount validation"
      }
      on other is {
        error "Unexpected message for adaptor FromDiscountService"
      }
    } with {
      briefly "from discount service"
      described as {
        |Carries messages from the external DiscountService.
      }
    }
  } with {
    briefly "DiscountService integration"
    described as {
      |The model's side of the DiscountService conversation.
    }
  }
  adaptor ToDiscountService to context DiscountService is { 
    handler ToDiscountServiceHandler is {
      on command DiscountService.RedeemDiscount is {
        do "the model sends redeem discount"
      }
      on query DiscountService.ValidateDiscountCode is {
        do "the model sends validate discount code"
      }
      on other is {
        error "Unexpected message for adaptor ToDiscountService"
      }
    } with {
      briefly "to discount service"
      described as {
        |Carries messages to the external DiscountService.
      }
    }
  } with {
    briefly "DiscountService integration"
    described as {
      |The model's side of the DiscountService conversation.
    }
  }
  adaptor FromEmailService from context EmailService is { 
    handler FromEmailServiceHandler is {
      on event EmailService.CancellationEmailSent is {
        do "the model receives cancellation email sent"
      }
      on event EmailService.ConfirmationEmailSent is {
        do "the model receives confirmation email sent"
      }
      on event EmailService.ReminderEmailSent is {
        do "the model receives reminder email sent"
      }
      on other is {
        error "Unexpected message for adaptor FromEmailService"
      }
    } with {
      briefly "from email service"
      described as {
        |Carries messages from the external EmailService.
      }
    }
  } with {
    briefly "EmailService integration"
    described as {
      |The model's side of the EmailService conversation.
    }
  }
  adaptor ToEmailService to context EmailService is { 
    handler ToEmailServiceHandler is {
      on command EmailService.SendCancellationEmail is {
        do "the model sends send cancellation email"
      }
      on command EmailService.SendConfirmationEmail is {
        do "the model sends send confirmation email"
      }
      on command EmailService.SendReminderEmail is {
        do "the model sends send reminder email"
      }
      on other is {
        error "Unexpected message for adaptor ToEmailService"
      }
    } with {
      briefly "to email service"
      described as {
        |Carries messages to the external EmailService.
      }
    }
  } with {
    briefly "EmailService integration"
    described as {
      |The model's side of the EmailService conversation.
    }
  }
  adaptor FromEventCatalogService from context EventCatalogService is { 
    handler FromEventCatalogServiceHandler is {
      on result EventCatalogService.EventDetails is {
        do "the model receives event details"
      }
      on result EventCatalogService.EventList is {
        do "the model receives event list"
      }
      on other is {
        error "Unexpected message for adaptor FromEventCatalogService"
      }
    } with {
      briefly "from event catalog service"
      described as {
        |Carries messages from the external EventCatalogService.
      }
    }
  } with {
    briefly "EventCatalogService integration"
    described as {
      |The model's side of the EventCatalogService conversation.
    }
  }
  adaptor ToEventCatalogService to context EventCatalogService is { 
    handler ToEventCatalogServiceHandler is {
      on query EventCatalogService.GetEventDetails is {
        do "the model sends get event details"
      }
      on query EventCatalogService.GetEvents is {
        do "the model sends get events"
      }
      on other is {
        error "Unexpected message for adaptor ToEventCatalogService"
      }
    } with {
      briefly "to event catalog service"
      described as {
        |Carries messages to the external EventCatalogService.
      }
    }
  } with {
    briefly "EventCatalogService integration"
    described as {
      |The model's side of the EventCatalogService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentSucceeded is {
        do "the model receives payment succeeded"
      }
      on event PaymentProcessingService.RefundSucceeded is {
        do "the model receives refund succeeded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessRegistrationPayment is {
        do "the model sends process registration payment"
      }
      on command PaymentProcessingService.ProcessRegistrationRefund is {
        do "the model sends process registration refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromSessionCapacityService from context SessionCapacityService is { 
    handler FromSessionCapacityServiceHandler is {
      on result SessionCapacityService.SessionCapacity is {
        do "the model receives session capacity"
      }
      on event SessionCapacityService.SessionSpotReleased is {
        do "the model receives session spot released"
      }
      on event SessionCapacityService.SessionSpotReserved is {
        do "the model receives session spot reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromSessionCapacityService"
      }
    } with {
      briefly "from session capacity service"
      described as {
        |Carries messages from the external SessionCapacityService.
      }
    }
  } with {
    briefly "SessionCapacityService integration"
    described as {
      |The model's side of the SessionCapacityService conversation.
    }
  }
  adaptor ToSessionCapacityService to context SessionCapacityService is { 
    handler ToSessionCapacityServiceHandler is {
      on query SessionCapacityService.CheckSessionCapacity is {
        do "the model sends check session capacity"
      }
      on command SessionCapacityService.ReleaseSessionSpot is {
        do "the model sends release session spot"
      }
      on command SessionCapacityService.ReserveSessionSpot is {
        do "the model sends reserve session spot"
      }
      on other is {
        error "Unexpected message for adaptor ToSessionCapacityService"
      }
    } with {
      briefly "to session capacity service"
      described as {
        |Carries messages to the external SessionCapacityService.
      }
    }
  } with {
    briefly "SessionCapacityService integration"
    described as {
      |The model's side of the SessionCapacityService conversation.
    }
  }
  adaptor FromTicketAvailabilityService from context TicketAvailabilityService is { 
    handler FromTicketAvailabilityServiceHandler is {
      on result TicketAvailabilityService.TicketAvailability is {
        do "the model receives ticket availability"
      }
      on event TicketAvailabilityService.TicketReleased is {
        do "the model receives ticket released"
      }
      on event TicketAvailabilityService.TicketReserved is {
        do "the model receives ticket reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromTicketAvailabilityService"
      }
    } with {
      briefly "from ticket availability service"
      described as {
        |Carries messages from the external TicketAvailabilityService.
      }
    }
  } with {
    briefly "TicketAvailabilityService integration"
    described as {
      |The model's side of the TicketAvailabilityService conversation.
    }
  }
  adaptor ToTicketAvailabilityService to context TicketAvailabilityService is { 
    handler ToTicketAvailabilityServiceHandler is {
      on query TicketAvailabilityService.CheckAvailability is {
        do "the model sends check availability"
      }
      on command TicketAvailabilityService.ReleaseTicket is {
        do "the model sends release ticket"
      }
      on command TicketAvailabilityService.ReserveTicket is {
        do "the model sends reserve ticket"
      }
      on other is {
        error "Unexpected message for adaptor ToTicketAvailabilityService"
      }
    } with {
      briefly "to ticket availability service"
      described as {
        |Carries messages to the external TicketAvailabilityService.
      }
    }
  } with {
    briefly "TicketAvailabilityService integration"
    described as {
      |The model's side of the TicketAvailabilityService conversation.
    }
  }
  include "types.riddl"
  include "Registration.riddl"
  // Repository for registration persistence
  repository RegistrationRepository as merge is {
    command PersistAttendeeCheckedIn is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row AttendeeCheckedIn applies to.
        }
      }
    } with {
      briefly "Persist AttendeeCheckedIn"
      described as {
        |Instructs this repository to apply AttendeeCheckedIn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPaymentProcessed is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row PaymentProcessed applies to.
        }
      }
    } with {
      briefly "Persist PaymentProcessed"
      described as {
        |Instructs this repository to apply PaymentProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationCancelled is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationCancelled applies to.
        }
      }
    } with {
      briefly "Persist RegistrationCancelled"
      described as {
        |Instructs this repository to apply RegistrationCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationConfirmed is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationConfirmed applies to.
        }
      }
    } with {
      briefly "Persist RegistrationConfirmed"
      described as {
        |Instructs this repository to apply RegistrationConfirmed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRegistrationCreated is {
      registrationId: RegistrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row RegistrationCreated applies to.
        }
      }
    } with {
      briefly "Persist RegistrationCreated"
      described as {
        |Instructs this repository to apply RegistrationCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet RegistrationRepositoryFromRegistration is type RegistrationEvent    inlet RegistrationRepositoryFromEventAnalytics is type RegistrationEvent    outlet RegistrationRepositoryResponses is type Registration.RegistrationResult
    record StoredRegistration is  {
      registrationId: RegistrationId with {
        briefly "registrationId"
        described as {
          |The registrationId column of the stored registration row.
        }
      }
      attendee: AttendeeInfo with {
        briefly "attendee"
        described as {
          |The attendee column of the stored registration row.
        }
      }
      event: EventInfo with {
        briefly "event"
        described as {
          |The event column of the stored registration row.
        }
      }
    } with {
      briefly "Stored registration row"
      described as {
        |The persistence shape of registration data as this repository stores it.
      }
    }
    schema RegistrationData is relational
      of registrations as type StoredRegistration
        index on field StoredRegistration.registrationId
        index on field StoredRegistration.attendee.attendeeId
        index on field StoredRegistration.event.eventId
 with {
      briefly "Registration data schema"
      described as {
        |The relational schema holding registration data for the RegistrationRepository.
      }
    }
    handler RegistrationPersistence is {
      on persistAttendeeCheckedIn: command PersistAttendeeCheckedIn is {
        do "apply AttendeeCheckedIn to the stored row"
      }
      on persistPaymentProcessed: command PersistPaymentProcessed is {
        do "apply PaymentProcessed to the stored row"
      }
      on persistRegistrationCancelled: command PersistRegistrationCancelled is {
        do "apply RegistrationCancelled to the stored row"
      }
      on persistRegistrationConfirmed: command PersistRegistrationConfirmed is {
        do "apply RegistrationConfirmed to the stored row"
      }
      on persistRegistrationCreated: command PersistRegistrationCreated is {
        do "apply RegistrationCreated to the stored row"
      }
      on query GetEventStats is {
        let eventStatsView: type EventStatsView = prompt("read the event stats projection")
        reply eventStatsView
      }
      on createRegistration: command Registration.CreateRegistration is {
        tell event Registration.RegistrationCreated(registrationId = createRegistration.registrationId, attendee = createRegistration.attendee, event = createRegistration.event, ticket = createRegistration.ticket) to entity RegistrationContext.Registration
        do "Store new registration"
      }
      on command Registration.ApplyDiscountCode is {
        do "Store discount application"
      }
      on processPayment: command Registration.ProcessPayment is {
        tell event Registration.PaymentProcessed(registrationId = processPayment.registrationId) to entity RegistrationContext.Registration
        do "Store payment"
      }
      on confirmRegistration: command Registration.ConfirmRegistration is {
        tell event Registration.RegistrationConfirmed(registrationId = confirmRegistration.registrationId, confirmationNumber = confirmRegistration.confirmationNumber) to entity RegistrationContext.Registration
        do "Update to confirmed"
      }
      on command Registration.AddToWaitlist is {
        do "Update to waitlisted"
      }
      on command Registration.RegisterForSession is {
        do "Store session registration"
      }
      on command Registration.UnregisterFromSession is {
        do "Remove session registration"
      }
      on command Registration.CheckIn is {
        do "Update to checked in"
      }
      on assignBadge: command Registration.AssignBadge is {
        tell event Registration.BadgeAssigned(registrationId = assignBadge.registrationId, badgeNumber = assignBadge.badgeNumber) to entity RegistrationContext.Registration
        do "Store badge assignment"
      }
      on recordSessionAttendance: command Registration.RecordSessionAttendance is {
        tell event Registration.SessionAttendanceRecorded(registrationId = recordSessionAttendance.registrationId, sessionId = recordSessionAttendance.sessionId) to entity RegistrationContext.Registration
        do "Update session attendance"
      }
      on updateAttendeeInfo: command Registration.UpdateAttendeeInfo is {
        tell event Registration.AttendeeInfoUpdated(registrationId = updateAttendeeInfo.registrationId, attendee = updateAttendeeInfo.attendee) to entity RegistrationContext.Registration
        do "Update attendee info"
      }
      on transferRegistration: command Registration.TransferRegistration is {
        tell event Registration.RegistrationTransferred(registrationId = transferRegistration.registrationId, newAttendee = transferRegistration.newAttendee) to entity RegistrationContext.Registration
        do "Update attendee for transfer"
      }
      on cancelRegistration: command Registration.CancelRegistration is {
        tell event Registration.RegistrationCancelled(registrationId = cancelRegistration.registrationId, reason = cancelRegistration.reason) to entity RegistrationContext.Registration
        do "Update to cancelled"
      }
      on processRefund: command Registration.ProcessRefund is {
        tell event Registration.RefundProcessed(registrationId = processRefund.registrationId, refundAmount = processRefund.refundAmount) to entity RegistrationContext.Registration
        do "Store refund"
      }
    } with {
      briefly "Persists registration commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Registration data persistence"
    described as {
      | The RegistrationRepository provides persistent storage for
      | registrations and related data.
    }
  }
  // Projector for event analytics
  query GetEventStats is  {
    eventStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which event stats to retrieve.
      }
    }
  } with {
    briefly "Get event stats"
    described as {
      |Retrieves the event stats projection.
    }
  }
  result EventStatsView is  {
    eventStats: EventAnalytics.EventStats with {
      briefly "Event stats"
      described as {
        |The event stats being returned.
      }
    }
  } with {
    briefly "Event stats view"
    described as {
      |Read model view carrying the event stats projection.
    }
  }
  projector EventAnalytics as flow is {
    updates repository RegistrationContext.RegistrationRepository
    inlet EventAnalyticsFromRegistration is type RegistrationEvent    outlet EventAnalyticsOut is type RegistrationEvent
    record EventStats is  {
      totalRegistrations: Natural with {
        briefly "Total"
        described as {
          |Total registrations.
        }
      }
      confirmedRegistrations: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed registrations.
        }
      }
      waitlistSize: Natural with {
        briefly "Waitlist"
        described as {
          |Waitlist size.
        }
      }
      checkedInCount: Natural with {
        briefly "Checked in"
        described as {
          |Checked in count.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      checkInRate: Decimal(5,2) with {
        briefly "Check-in rate"
        described as {
          |Check-in percentage.
        }
      }
    } with {
      briefly "Event statistics"
      described as {
        |Event registration metrics.
      }
    }
    handler AnalyticsHandler is {
      on registrationCreated: event Registration.RegistrationCreated is {
        tell command RegistrationContext.RegistrationRepository.PersistRegistrationCreated(registrationId = registrationCreated.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update registration counts"
      }
      on registrationConfirmed: event Registration.RegistrationConfirmed is {
        tell command RegistrationContext.RegistrationRepository.PersistRegistrationConfirmed(registrationId = registrationConfirmed.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update confirmed counts"
      }
      on paymentProcessed: event Registration.PaymentProcessed is {
        tell command RegistrationContext.RegistrationRepository.PersistPaymentProcessed(registrationId = paymentProcessed.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update revenue metrics"
      }
      on attendeeCheckedIn: event Registration.AttendeeCheckedIn is {
        tell command RegistrationContext.RegistrationRepository.PersistAttendeeCheckedIn(registrationId = attendeeCheckedIn.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update check-in metrics"
      }
      on registrationCancelled: event Registration.RegistrationCancelled is {
        tell command RegistrationContext.RegistrationRepository.PersistRegistrationCancelled(registrationId = registrationCancelled.registrationId) to repository RegistrationContext.RegistrationRepository
        do "Update cancellation metrics"
      }
    } with {
      briefly "Maintains event analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Event analytics projections"
    described as {
      |Maintains event registration analytics data.
    }
  }
  // ---- Event publication for Registration ----
  type RegistrationEvent is one of {
    RegistrationContext.Registration.RegistrationCreated or RegistrationContext.Registration.DiscountApplied or RegistrationContext.Registration.PaymentProcessed or RegistrationContext.Registration.RegistrationConfirmed or RegistrationContext.Registration.AddedToWaitlist or RegistrationContext.Registration.SessionRegistered or RegistrationContext.Registration.SessionUnregistered or RegistrationContext.Registration.AttendeeCheckedIn or RegistrationContext.Registration.BadgeAssigned or RegistrationContext.Registration.SessionAttendanceRecorded or RegistrationContext.Registration.AttendeeInfoUpdated or RegistrationContext.Registration.RegistrationTransferred or RegistrationContext.Registration.RegistrationCancelled or RegistrationContext.Registration.RefundProcessed
  } with {
    briefly "Registration event alternation"
    described as {
      |Union of all Registration events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RegistrationEventSource as source is {
    outlet RegistrationEvents is type RegistrationEvent
    handler RegistrationSourceHandler is {
      on registrationCreated: event Registration.RegistrationCreated is {
        send registrationCreated to outlet RegistrationEvents
      }
      on discountApplied: event Registration.DiscountApplied is {
        send discountApplied to outlet RegistrationEvents
      }
      on paymentProcessed: event Registration.PaymentProcessed is {
        send paymentProcessed to outlet RegistrationEvents
      }
      on registrationConfirmed: event Registration.RegistrationConfirmed is {
        send registrationConfirmed to outlet RegistrationEvents
      }
      on addedToWaitlist: event Registration.AddedToWaitlist is {
        send addedToWaitlist to outlet RegistrationEvents
      }
      on sessionRegistered: event Registration.SessionRegistered is {
        send sessionRegistered to outlet RegistrationEvents
      }
      on sessionUnregistered: event Registration.SessionUnregistered is {
        send sessionUnregistered to outlet RegistrationEvents
      }
      on attendeeCheckedIn: event Registration.AttendeeCheckedIn is {
        send attendeeCheckedIn to outlet RegistrationEvents
      }
      on badgeAssigned: event Registration.BadgeAssigned is {
        send badgeAssigned to outlet RegistrationEvents
      }
      on sessionAttendanceRecorded: event Registration.SessionAttendanceRecorded is {
        send sessionAttendanceRecorded to outlet RegistrationEvents
      }
      on attendeeInfoUpdated: event Registration.AttendeeInfoUpdated is {
        send attendeeInfoUpdated to outlet RegistrationEvents
      }
      on registrationTransferred: event Registration.RegistrationTransferred is {
        send registrationTransferred to outlet RegistrationEvents
      }
      on registrationCancelled: event Registration.RegistrationCancelled is {
        send registrationCancelled to outlet RegistrationEvents
      }
      on refundProcessed: event Registration.RefundProcessed is {
        send refundProcessed to outlet RegistrationEvents
      }
      on other is {
        error "Unexpected message for source RegistrationEventSource"
      }
    } with {
      briefly "Registration source handler"
      described as {
        |Publishes Registration events onto the outlet.
      }
    }
  } with {
    briefly "Registration event source"
    described as {
      |Publishes Registration entity events into the streaming topology.
    }
  }
  processor RegistrationEventSink as sink is {
    inlet RegistrationInlet is type RegistrationEvent    handler RegistrationSinkHandler is {
      on registrationCreated: event Registration.RegistrationCreated is {
        tell registrationCreated to repository RegistrationContext.RegistrationRepository
      }
      on discountApplied: event Registration.DiscountApplied is {
        tell discountApplied to repository RegistrationContext.RegistrationRepository
      }
      on paymentProcessed: event Registration.PaymentProcessed is {
        tell paymentProcessed to repository RegistrationContext.RegistrationRepository
      }
      on registrationConfirmed: event Registration.RegistrationConfirmed is {
        tell registrationConfirmed to repository RegistrationContext.RegistrationRepository
      }
      on addedToWaitlist: event Registration.AddedToWaitlist is {
        tell addedToWaitlist to repository RegistrationContext.RegistrationRepository
      }
      on sessionRegistered: event Registration.SessionRegistered is {
        tell sessionRegistered to repository RegistrationContext.RegistrationRepository
      }
      on sessionUnregistered: event Registration.SessionUnregistered is {
        tell sessionUnregistered to repository RegistrationContext.RegistrationRepository
      }
      on attendeeCheckedIn: event Registration.AttendeeCheckedIn is {
        tell attendeeCheckedIn to repository RegistrationContext.RegistrationRepository
      }
      on badgeAssigned: event Registration.BadgeAssigned is {
        tell badgeAssigned to repository RegistrationContext.RegistrationRepository
      }
      on sessionAttendanceRecorded: event Registration.SessionAttendanceRecorded is {
        tell sessionAttendanceRecorded to repository RegistrationContext.RegistrationRepository
      }
      on attendeeInfoUpdated: event Registration.AttendeeInfoUpdated is {
        tell attendeeInfoUpdated to repository RegistrationContext.RegistrationRepository
      }
      on registrationTransferred: event Registration.RegistrationTransferred is {
        tell registrationTransferred to repository RegistrationContext.RegistrationRepository
      }
      on registrationCancelled: event Registration.RegistrationCancelled is {
        tell registrationCancelled to repository RegistrationContext.RegistrationRepository
      }
      on refundProcessed: event Registration.RefundProcessed is {
        tell refundProcessed to repository RegistrationContext.RegistrationRepository
      }
      on other is {
        error "Unexpected message for sink RegistrationEventSink"
      }
    } with {
      briefly "Registration sink handler"
      described as {
        |Persists Registration events via the repository.
      }
    }
  } with {
    briefly "Registration event sink"
    described as {
      |Receives Registration events for persistence.
    }
  }
  connector RegistrationEventFlow is from outlet RegistrationContext.RegistrationEventSource.RegistrationEvents to inlet RegistrationContext.RegistrationEventSink.RegistrationInlet with {
    briefly "Registration event flow"
    described as {
      |Connects the Registration source to its sink.
    }
  }
  processor RegistrationEventSplit as split is {
    inlet RegistrationEventSplitIn is type RegistrationEvent    outlet RegistrationEventSplitToRegistrationRepository is type RegistrationEvent
    outlet RegistrationEventSplitToEventAnalytics is type RegistrationEvent
    handler RegistrationEventSplitHandler is {
      on registrationCreated: event Registration.RegistrationCreated is {
        send registrationCreated to outlet RegistrationEventSplitToRegistrationRepository
        send registrationCreated to outlet RegistrationEventSplitToEventAnalytics
        tell registrationCreated to entity RegistrationContext.Registration
      }
      on discountApplied: event Registration.DiscountApplied is {
        send discountApplied to outlet RegistrationEventSplitToRegistrationRepository
        send discountApplied to outlet RegistrationEventSplitToEventAnalytics
        tell discountApplied to entity RegistrationContext.Registration
      }
      on paymentProcessed: event Registration.PaymentProcessed is {
        send paymentProcessed to outlet RegistrationEventSplitToRegistrationRepository
        send paymentProcessed to outlet RegistrationEventSplitToEventAnalytics
        tell paymentProcessed to entity RegistrationContext.Registration
      }
      on registrationConfirmed: event Registration.RegistrationConfirmed is {
        send registrationConfirmed to outlet RegistrationEventSplitToRegistrationRepository
        send registrationConfirmed to outlet RegistrationEventSplitToEventAnalytics
        tell registrationConfirmed to entity RegistrationContext.Registration
      }
      on addedToWaitlist: event Registration.AddedToWaitlist is {
        send addedToWaitlist to outlet RegistrationEventSplitToRegistrationRepository
        send addedToWaitlist to outlet RegistrationEventSplitToEventAnalytics
        tell addedToWaitlist to entity RegistrationContext.Registration
      }
      on sessionRegistered: event Registration.SessionRegistered is {
        send sessionRegistered to outlet RegistrationEventSplitToRegistrationRepository
        send sessionRegistered to outlet RegistrationEventSplitToEventAnalytics
        tell sessionRegistered to entity RegistrationContext.Registration
      }
      on sessionUnregistered: event Registration.SessionUnregistered is {
        send sessionUnregistered to outlet RegistrationEventSplitToRegistrationRepository
        send sessionUnregistered to outlet RegistrationEventSplitToEventAnalytics
        tell sessionUnregistered to entity RegistrationContext.Registration
      }
      on attendeeCheckedIn: event Registration.AttendeeCheckedIn is {
        send attendeeCheckedIn to outlet RegistrationEventSplitToRegistrationRepository
        send attendeeCheckedIn to outlet RegistrationEventSplitToEventAnalytics
        tell attendeeCheckedIn to entity RegistrationContext.Registration
      }
      on badgeAssigned: event Registration.BadgeAssigned is {
        send badgeAssigned to outlet RegistrationEventSplitToRegistrationRepository
        send badgeAssigned to outlet RegistrationEventSplitToEventAnalytics
        tell badgeAssigned to entity RegistrationContext.Registration
      }
      on sessionAttendanceRecorded: event Registration.SessionAttendanceRecorded is {
        send sessionAttendanceRecorded to outlet RegistrationEventSplitToRegistrationRepository
        send sessionAttendanceRecorded to outlet RegistrationEventSplitToEventAnalytics
        tell sessionAttendanceRecorded to entity RegistrationContext.Registration
      }
      on attendeeInfoUpdated: event Registration.AttendeeInfoUpdated is {
        send attendeeInfoUpdated to outlet RegistrationEventSplitToRegistrationRepository
        send attendeeInfoUpdated to outlet RegistrationEventSplitToEventAnalytics
        tell attendeeInfoUpdated to entity RegistrationContext.Registration
      }
      on registrationTransferred: event Registration.RegistrationTransferred is {
        send registrationTransferred to outlet RegistrationEventSplitToRegistrationRepository
        send registrationTransferred to outlet RegistrationEventSplitToEventAnalytics
        tell registrationTransferred to entity RegistrationContext.Registration
      }
      on registrationCancelled: event Registration.RegistrationCancelled is {
        send registrationCancelled to outlet RegistrationEventSplitToRegistrationRepository
        send registrationCancelled to outlet RegistrationEventSplitToEventAnalytics
        tell registrationCancelled to entity RegistrationContext.Registration
      }
      on refundProcessed: event Registration.RefundProcessed is {
        send refundProcessed to outlet RegistrationEventSplitToRegistrationRepository
        send refundProcessed to outlet RegistrationEventSplitToEventAnalytics
        tell refundProcessed to entity RegistrationContext.Registration
      }
      on other is {
        error "Unexpected message for processor RegistrationEventSplit"
      }
    } with {
      briefly "Registration event fan-out handler"
      described as {
        |Delivers each Registration event to all of its consumers.
      }
    }
  } with {
    briefly "Registration event fan-out"
    described as {
      |Fans Registration events out to the repository and projectors.
    }
  }
  connector 'RegistrationEvent Stream' is from outlet RegistrationContext.Registration.RegistrationEvents2 to inlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitIn with {
    briefly "Registration events, fanned out to storage and read models"
  }
  connector 'RegistrationEvent Storage' is from outlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitToRegistrationRepository to inlet RegistrationContext.RegistrationRepository.RegistrationRepositoryFromRegistration with {
    briefly "Registration events on their way to storage"
  }
  connector 'EventAnalytics Feed' is from outlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitToEventAnalytics to inlet RegistrationContext.EventAnalytics.EventAnalyticsFromRegistration with {
    briefly "Registration events feeding the EventAnalytics projection"
  }
  connector 'EventAnalytics Storage' is from outlet RegistrationContext.EventAnalytics.EventAnalyticsOut to inlet RegistrationContext.RegistrationRepository.RegistrationRepositoryFromEventAnalytics with {
    briefly "The EventAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for event registration"
  described as {
    | The RegistrationContext is the bounded context for
    | event registration and attendee management.
  }
}
