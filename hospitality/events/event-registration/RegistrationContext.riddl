// Event Registration - Registration Context
context RegistrationContext as router is {
  inlet RegistrationCommandStreamIn is type RegistrationCommand  outlet RegistrationCommandStreamOut is type RegistrationCommand
  inlet RegistrationResultStreamIn is result Registration.RegistrationResult  outlet RegistrationResultStreamOut is result Registration.RegistrationResult
  handler RegistrationContextBoundary is {
    on createRegistration: command Registration.CreateRegistration is {
      send createRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on applyDiscountCode: command Registration.ApplyDiscountCode is {
      send applyDiscountCode to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on processPayment: command Registration.ProcessPayment is {
      send processPayment to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on confirmRegistration: command Registration.ConfirmRegistration is {
      send confirmRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on addToWaitlist: command Registration.AddToWaitlist is {
      send addToWaitlist to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on registerForSession: command Registration.RegisterForSession is {
      send registerForSession to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on unregisterFromSession: command Registration.UnregisterFromSession is {
      send unregisterFromSession to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on checkInMsg: command Registration.CheckIn is {
      send checkInMsg to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on assignBadge: command Registration.AssignBadge is {
      send assignBadge to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on recordSessionAttendance: command Registration.RecordSessionAttendance is {
      send recordSessionAttendance to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on updateAttendeeInfo: command Registration.UpdateAttendeeInfo is {
      send updateAttendeeInfo to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on transferRegistration: command Registration.TransferRegistration is {
      send transferRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on cancelRegistration: command Registration.CancelRegistration is {
      send cancelRegistration to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on processRefund: command Registration.ProcessRefund is {
      send processRefund to outlet RegistrationContext.RegistrationCommandStreamOut
    }
    on registrationResult: result Registration.RegistrationResult is {
      send registrationResult to outlet RegistrationContext.RegistrationResultStreamOut
    }
    on other is {
      error "Unexpected message at the RegistrationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'RegistrationCommand Stream Intake' is from outlet RegistrationContext.RegistrationCommandStreamOut to inlet RegistrationContext.Registration.RegistrationCommands  connector 'RegistrationResult Stream Egress' is from outlet RegistrationContext.RegistrationRepository.RegistrationRepositoryResponses to inlet RegistrationContext.RegistrationResultStreamIn  adaptor FromBadgePrintingService from context BadgePrintingService is { 
    handler FromBadgePrintingServiceHandler is {
      on event BadgePrintingService.BadgePrinted is {
        do "the model receives badge printed"
      }
      on other is {
        error "Unexpected message for adaptor FromBadgePrintingService"
      }
    } with {
      briefly "from badge printing service"
      described as {
        |Carries messages from the external BadgePrintingService.
      }
    }
  } with {
    briefly "BadgePrintingService integration"
    described as {
      |The model's side of the BadgePrintingService conversation.
    }
  }
  adaptor ToBadgePrintingService to context BadgePrintingService is { 
    handler ToBadgePrintingServiceHandler is {
      on command BadgePrintingService.PrintBadge is {
        do "the model sends print badge"
      }
      on other is {
        error "Unexpected message for adaptor ToBadgePrintingService"
      }
    } with {
      briefly "to badge printing service"
      described as {
        |Carries messages to the external BadgePrintingService.
      }
    }
  } with {
    briefly "BadgePrintingService integration"
    described as {
      |The model's side of the BadgePrintingService conversation.
    }
  }
  adaptor FromDiscountService from context DiscountService is { 
    handler FromDiscountServiceHandler is {
      on event DiscountService.DiscountRedeemed is {
        do "the model receives discount redeemed"
      }
      on result DiscountService.DiscountValidation is {
        do "the model receives discount validation"
      }
      on other is {
        error "Unexpected message for adaptor FromDiscountService"
      }
    } with {
      briefly "from discount service"
      described as {
        |Carries messages from the external DiscountService.
      }
    }
  } with {
    briefly "DiscountService integration"
    described as {
      |The model's side of the DiscountService conversation.
    }
  }
  adaptor ToDiscountService to context DiscountService is { 
    handler ToDiscountServiceHandler is {
      on command DiscountService.RedeemDiscount is {
        do "the model sends redeem discount"
      }
      on query DiscountService.ValidateDiscountCode is {
        do "the model sends validate discount code"
      }
      on other is {
        error "Unexpected message for adaptor ToDiscountService"
      }
    } with {
      briefly "to discount service"
      described as {
        |Carries messages to the external DiscountService.
      }
    }
  } with {
    briefly "DiscountService integration"
    described as {
      |The model's side of the DiscountService conversation.
    }
  }
  adaptor FromEmailService from context EmailService is { 
    handler FromEmailServiceHandler is {
      on event EmailService.CancellationEmailSent is {
        do "the model receives cancellation email sent"
      }
      on event EmailService.ConfirmationEmailSent is {
        do "the model receives confirmation email sent"
      }
      on event EmailService.ReminderEmailSent is {
        do "the model receives reminder email sent"
      }
      on other is {
        error "Unexpected message for adaptor FromEmailService"
      }
    } with {
      briefly "from email service"
      described as {
        |Carries messages from the external EmailService.
      }
    }
  } with {
    briefly "EmailService integration"
    described as {
      |The model's side of the EmailService conversation.
    }
  }
  adaptor ToEmailService to context EmailService is { 
    handler ToEmailServiceHandler is {
      on command EmailService.SendCancellationEmail is {
        do "the model sends send cancellation email"
      }
      on command EmailService.SendConfirmationEmail is {
        do "the model sends send confirmation email"
      }
      on command EmailService.SendReminderEmail is {
        do "the model sends send reminder email"
      }
      on other is {
        error "Unexpected message for adaptor ToEmailService"
      }
    } with {
      briefly "to email service"
      described as {
        |Carries messages to the external EmailService.
      }
    }
  } with {
    briefly "EmailService integration"
    described as {
      |The model's side of the EmailService conversation.
    }
  }
  adaptor FromEventCatalogService from context EventCatalogService is { 
    handler FromEventCatalogServiceHandler is {
      on result EventCatalogService.EventDetails is {
        do "the model receives event details"
      }
      on result EventCatalogService.EventList is {
        do "the model receives event list"
      }
      on other is {
        error "Unexpected message for adaptor FromEventCatalogService"
      }
    } with {
      briefly "from event catalog service"
      described as {
        |Carries messages from the external EventCatalogService.
      }
    }
  } with {
    briefly "EventCatalogService integration"
    described as {
      |The model's side of the EventCatalogService conversation.
    }
  }
  adaptor ToEventCatalogService to context EventCatalogService is { 
    handler ToEventCatalogServiceHandler is {
      on query EventCatalogService.GetEventDetails is {
        do "the model sends get event details"
      }
      on query EventCatalogService.GetEvents is {
        do "the model sends get events"
      }
      on other is {
        error "Unexpected message for adaptor ToEventCatalogService"
      }
    } with {
      briefly "to event catalog service"
      described as {
        |Carries messages to the external EventCatalogService.
      }
    }
  } with {
    briefly "EventCatalogService integration"
    described as {
      |The model's side of the EventCatalogService conversation.
    }
  }
  adaptor FromPaymentProcessingService from context PaymentProcessingService is { 
    handler FromPaymentProcessingServiceHandler is {
      on event PaymentProcessingService.PaymentFailed is {
        do "the model receives payment failed"
      }
      on event PaymentProcessingService.PaymentSucceeded is {
        do "the model receives payment succeeded"
      }
      on event PaymentProcessingService.RefundSucceeded is {
        do "the model receives refund succeeded"
      }
      on other is {
        error "Unexpected message for adaptor FromPaymentProcessingService"
      }
    } with {
      briefly "from payment processing service"
      described as {
        |Carries messages from the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor ToPaymentProcessingService to context PaymentProcessingService is { 
    handler ToPaymentProcessingServiceHandler is {
      on command PaymentProcessingService.ProcessRegistrationPayment is {
        do "the model sends process registration payment"
      }
      on command PaymentProcessingService.ProcessRegistrationRefund is {
        do "the model sends process registration refund"
      }
      on other is {
        error "Unexpected message for adaptor ToPaymentProcessingService"
      }
    } with {
      briefly "to payment processing service"
      described as {
        |Carries messages to the external PaymentProcessingService.
      }
    }
  } with {
    briefly "PaymentProcessingService integration"
    described as {
      |The model's side of the PaymentProcessingService conversation.
    }
  }
  adaptor FromSessionCapacityService from context SessionCapacityService is { 
    handler FromSessionCapacityServiceHandler is {
      on result SessionCapacityService.SessionCapacity is {
        do "the model receives session capacity"
      }
      on event SessionCapacityService.SessionSpotReleased is {
        do "the model receives session spot released"
      }
      on event SessionCapacityService.SessionSpotReserved is {
        do "the model receives session spot reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromSessionCapacityService"
      }
    } with {
