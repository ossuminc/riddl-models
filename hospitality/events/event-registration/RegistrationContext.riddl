// Event Registration - Registration Context
context RegistrationContext is {
  include "types.riddl"
  include "Registration.riddl"
  // Repository for registration persistence
  repository RegistrationRepository is {
    inlet RegistrationRepositoryFromRegistration is type RegistrationEvent
    inlet RegistrationRepositoryFromEventAnalytics is type RegistrationEvent
    outlet RegistrationRepositoryResponses is type Registration.RegistrationResult
    schema RegistrationData is relational
      of registrations as type Registration
        index on field Registration.registrationId
        index on field Registration.attendee.attendeeId
        index on field Registration.event.eventId

    handler RegistrationPersistence is {
      on command Registration.CreateRegistration is {
        tell event Registration.RegistrationCreated to entity RegistrationContext.Registration
        prompt "Store new registration"
      }
      on command Registration.ApplyDiscountCode is {
        prompt "Store discount application"
      }
      on command Registration.ProcessPayment is {
        tell event Registration.PaymentProcessed to entity RegistrationContext.Registration
        prompt "Store payment"
      }
      on command Registration.ConfirmRegistration is {
        tell event Registration.RegistrationConfirmed to entity RegistrationContext.Registration
        prompt "Update to confirmed"
      }
      on command Registration.AddToWaitlist is {
        prompt "Update to waitlisted"
      }
      on command Registration.RegisterForSession is {
        prompt "Store session registration"
      }
      on command Registration.UnregisterFromSession is {
        prompt "Remove session registration"
      }
      on command Registration.CheckIn is {
        prompt "Update to checked in"
      }
      on command Registration.AssignBadge is {
        tell event Registration.BadgeAssigned to entity RegistrationContext.Registration
        prompt "Store badge assignment"
      }
      on command Registration.RecordSessionAttendance is {
        tell event Registration.SessionAttendanceRecorded to entity RegistrationContext.Registration
        prompt "Update session attendance"
      }
      on command Registration.UpdateAttendeeInfo is {
        tell event Registration.AttendeeInfoUpdated to entity RegistrationContext.Registration
        prompt "Update attendee info"
      }
      on command Registration.TransferRegistration is {
        tell event Registration.RegistrationTransferred to entity RegistrationContext.Registration
        prompt "Update attendee for transfer"
      }
      on command Registration.CancelRegistration is {
        tell event Registration.RegistrationCancelled to entity RegistrationContext.Registration
        prompt "Update to cancelled"
      }
      on command Registration.ProcessRefund is {
        tell event Registration.RefundProcessed to entity RegistrationContext.Registration
        prompt "Store refund"
      }
    } with {
      briefly "Persists registration commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Registration data persistence"
    described as {
      | The RegistrationRepository provides persistent storage for
      | registrations and related data.
    }
  }
  // Projector for event analytics
  projector EventAnalytics is {
    inlet EventAnalyticsFromRegistration is type RegistrationEvent
    outlet EventAnalyticsOut is type RegistrationEvent
    updates repository RegistrationContext.RegistrationRepository
    record EventStats is  {
      totalRegistrations: Natural with {
        briefly "Total"
        described as {
          |Total registrations.
        }
      }
      confirmedRegistrations: Natural with {
        briefly "Confirmed"
        described as {
          |Confirmed registrations.
        }
      }
      waitlistSize: Natural with {
        briefly "Waitlist"
        described as {
          |Waitlist size.
        }
      }
      checkedInCount: Natural with {
        briefly "Checked in"
        described as {
          |Checked in count.
        }
      }
      totalRevenue: Decimal(12,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      checkInRate: Decimal(5,2) with {
        briefly "Check-in rate"
        described as {
          |Check-in percentage.
        }
      }
    } with {
      briefly "Event statistics"
      described as {
        |Event registration metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Registration.RegistrationCreated is {
        tell event Registration.RegistrationCreated to repository RegistrationContext.RegistrationRepository
        prompt "Update registration counts"
      }
      on event Registration.RegistrationConfirmed is {
        tell event Registration.RegistrationConfirmed to repository RegistrationContext.RegistrationRepository
        prompt "Update confirmed counts"
      }
      on event Registration.PaymentProcessed is {
        tell event Registration.PaymentProcessed to repository RegistrationContext.RegistrationRepository
        prompt "Update revenue metrics"
      }
      on event Registration.AttendeeCheckedIn is {
        tell event Registration.AttendeeCheckedIn to repository RegistrationContext.RegistrationRepository
        prompt "Update check-in metrics"
      }
      on event Registration.RegistrationCancelled is {
        tell event Registration.RegistrationCancelled to repository RegistrationContext.RegistrationRepository
        prompt "Update cancellation metrics"
      }
    } with {
      briefly "Maintains event analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Event analytics projections"
    described as {
      |Maintains event registration analytics data.
    }
  }
  // ---- Event publication for Registration ----
  type RegistrationEvent is one of {
    RegistrationContext.Registration.RegistrationCreated,
    RegistrationContext.Registration.DiscountApplied,
    RegistrationContext.Registration.PaymentProcessed,
    RegistrationContext.Registration.RegistrationConfirmed,
    RegistrationContext.Registration.AddedToWaitlist,
    RegistrationContext.Registration.SessionRegistered,
    RegistrationContext.Registration.SessionUnregistered,
    RegistrationContext.Registration.AttendeeCheckedIn,
    RegistrationContext.Registration.BadgeAssigned,
    RegistrationContext.Registration.SessionAttendanceRecorded,
    RegistrationContext.Registration.AttendeeInfoUpdated,
    RegistrationContext.Registration.RegistrationTransferred,
    RegistrationContext.Registration.RegistrationCancelled,
    RegistrationContext.Registration.RefundProcessed
  } with {
    briefly "Registration event alternation"
    described as {
      |Union of all Registration events, for streaming and event-sourced
      |persistence.
    }
  }
  processor RegistrationEventSource as source is {
    outlet RegistrationEvents is type RegistrationEvent
    handler RegistrationSourceHandler is {
      on event Registration.RegistrationCreated is {
        send event Registration.RegistrationCreated to outlet RegistrationEvents
      }
      on event Registration.DiscountApplied is {
        send event Registration.DiscountApplied to outlet RegistrationEvents
      }
      on event Registration.PaymentProcessed is {
        send event Registration.PaymentProcessed to outlet RegistrationEvents
      }
      on event Registration.RegistrationConfirmed is {
        send event Registration.RegistrationConfirmed to outlet RegistrationEvents
      }
      on event Registration.AddedToWaitlist is {
        send event Registration.AddedToWaitlist to outlet RegistrationEvents
      }
      on event Registration.SessionRegistered is {
        send event Registration.SessionRegistered to outlet RegistrationEvents
      }
      on event Registration.SessionUnregistered is {
        send event Registration.SessionUnregistered to outlet RegistrationEvents
      }
      on event Registration.AttendeeCheckedIn is {
        send event Registration.AttendeeCheckedIn to outlet RegistrationEvents
      }
      on event Registration.BadgeAssigned is {
        send event Registration.BadgeAssigned to outlet RegistrationEvents
      }
      on event Registration.SessionAttendanceRecorded is {
        send event Registration.SessionAttendanceRecorded to outlet RegistrationEvents
      }
      on event Registration.AttendeeInfoUpdated is {
        send event Registration.AttendeeInfoUpdated to outlet RegistrationEvents
      }
      on event Registration.RegistrationTransferred is {
        send event Registration.RegistrationTransferred to outlet RegistrationEvents
      }
      on event Registration.RegistrationCancelled is {
        send event Registration.RegistrationCancelled to outlet RegistrationEvents
      }
      on event Registration.RefundProcessed is {
        send event Registration.RefundProcessed to outlet RegistrationEvents
      }
      on other is {
        error "Unexpected message for source RegistrationEventSource"
      }
    } with {
      briefly "Registration source handler"
      described as {
        |Publishes Registration events onto the outlet.
      }
    }
  } with {
    briefly "Registration event source"
    described as {
      |Publishes Registration entity events into the streaming topology.
    }
  }
  processor RegistrationEventSink as sink is {
    inlet RegistrationInlet is type RegistrationEvent
    handler RegistrationSinkHandler is {
      on event Registration.RegistrationCreated is {
        tell event Registration.RegistrationCreated to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.DiscountApplied is {
        tell event Registration.DiscountApplied to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.PaymentProcessed is {
        tell event Registration.PaymentProcessed to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.RegistrationConfirmed is {
        tell event Registration.RegistrationConfirmed to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.AddedToWaitlist is {
        tell event Registration.AddedToWaitlist to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.SessionRegistered is {
        tell event Registration.SessionRegistered to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.SessionUnregistered is {
        tell event Registration.SessionUnregistered to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.AttendeeCheckedIn is {
        tell event Registration.AttendeeCheckedIn to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.BadgeAssigned is {
        tell event Registration.BadgeAssigned to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.SessionAttendanceRecorded is {
        tell event Registration.SessionAttendanceRecorded to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.AttendeeInfoUpdated is {
        tell event Registration.AttendeeInfoUpdated to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.RegistrationTransferred is {
        tell event Registration.RegistrationTransferred to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.RegistrationCancelled is {
        tell event Registration.RegistrationCancelled to repository RegistrationContext.RegistrationRepository
      }
      on event Registration.RefundProcessed is {
        tell event Registration.RefundProcessed to repository RegistrationContext.RegistrationRepository
      }
      on other is {
        error "Unexpected message for sink RegistrationEventSink"
      }
    } with {
      briefly "Registration sink handler"
      described as {
        |Persists Registration events via the repository.
      }
    }
  } with {
    briefly "Registration event sink"
    described as {
      |Receives Registration events for persistence.
    }
  }
  connector RegistrationEventFlow is {
    from outlet RegistrationContext.RegistrationEventSource.RegistrationEvents to
      inlet RegistrationContext.RegistrationEventSink.RegistrationInlet
  } with {
    briefly "Registration event flow"
    described as {
      |Connects the Registration source to its sink.
    }
  }
  processor RegistrationEventSplit is {
    inlet RegistrationEventSplitIn is type RegistrationEvent
    outlet RegistrationEventSplitToRegistrationRepository is type RegistrationEvent
    outlet RegistrationEventSplitToEventAnalytics is type RegistrationEvent
    handler RegistrationEventSplitHandler is {
      on event Registration.RegistrationCreated is {
        send event Registration.RegistrationCreated to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.RegistrationCreated to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.RegistrationCreated to entity RegistrationContext.Registration
      }
      on event Registration.DiscountApplied is {
        send event Registration.DiscountApplied to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.DiscountApplied to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.DiscountApplied to entity RegistrationContext.Registration
      }
      on event Registration.PaymentProcessed is {
        send event Registration.PaymentProcessed to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.PaymentProcessed to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.PaymentProcessed to entity RegistrationContext.Registration
      }
      on event Registration.RegistrationConfirmed is {
        send event Registration.RegistrationConfirmed to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.RegistrationConfirmed to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.RegistrationConfirmed to entity RegistrationContext.Registration
      }
      on event Registration.AddedToWaitlist is {
        send event Registration.AddedToWaitlist to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.AddedToWaitlist to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.AddedToWaitlist to entity RegistrationContext.Registration
      }
      on event Registration.SessionRegistered is {
        send event Registration.SessionRegistered to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.SessionRegistered to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.SessionRegistered to entity RegistrationContext.Registration
      }
      on event Registration.SessionUnregistered is {
        send event Registration.SessionUnregistered to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.SessionUnregistered to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.SessionUnregistered to entity RegistrationContext.Registration
      }
      on event Registration.AttendeeCheckedIn is {
        send event Registration.AttendeeCheckedIn to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.AttendeeCheckedIn to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.AttendeeCheckedIn to entity RegistrationContext.Registration
      }
      on event Registration.BadgeAssigned is {
        send event Registration.BadgeAssigned to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.BadgeAssigned to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.BadgeAssigned to entity RegistrationContext.Registration
      }
      on event Registration.SessionAttendanceRecorded is {
        send event Registration.SessionAttendanceRecorded to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.SessionAttendanceRecorded to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.SessionAttendanceRecorded to entity RegistrationContext.Registration
      }
      on event Registration.AttendeeInfoUpdated is {
        send event Registration.AttendeeInfoUpdated to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.AttendeeInfoUpdated to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.AttendeeInfoUpdated to entity RegistrationContext.Registration
      }
      on event Registration.RegistrationTransferred is {
        send event Registration.RegistrationTransferred to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.RegistrationTransferred to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.RegistrationTransferred to entity RegistrationContext.Registration
      }
      on event Registration.RegistrationCancelled is {
        send event Registration.RegistrationCancelled to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.RegistrationCancelled to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.RegistrationCancelled to entity RegistrationContext.Registration
      }
      on event Registration.RefundProcessed is {
        send event Registration.RefundProcessed to outlet RegistrationEventSplitToRegistrationRepository
        send event Registration.RefundProcessed to outlet RegistrationEventSplitToEventAnalytics
        tell event Registration.RefundProcessed to entity RegistrationContext.Registration
      }
      on other is {
        error "Unexpected message for processor RegistrationEventSplit"
      }
    } with {
      briefly "Registration event fan-out handler"
      described as {
        |Delivers each Registration event to all of its consumers.
      }
    }
  } with {
    briefly "Registration event fan-out"
    described as {
      |Fans Registration events out to the repository and projectors.
    }
  }
  connector LinkRegistrationToRegistrationEventSplit is {
    from outlet RegistrationContext.Registration.RegistrationEvents2 to
      inlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitIn
  } with {
    briefly "LinkRegistrationToRegistrationEventSplit"
  }
  connector LinkRegistrationEventSplitToRegistrationRepository is {
    from outlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitToRegistrationRepository to
      inlet RegistrationContext.RegistrationRepository.RegistrationRepositoryFromRegistration
  } with {
    briefly "LinkRegistrationEventSplitToRegistrationRepository"
  }
  connector LinkRegistrationEventSplitToEventAnalytics is {
    from outlet RegistrationContext.RegistrationEventSplit.RegistrationEventSplitToEventAnalytics to
      inlet RegistrationContext.EventAnalytics.EventAnalyticsFromRegistration
  } with {
    briefly "LinkRegistrationEventSplitToEventAnalytics"
  }
  connector LinkEventAnalyticsToRegistrationRepository is {
    from outlet RegistrationContext.EventAnalytics.EventAnalyticsOut to
      inlet RegistrationContext.RegistrationRepository.RegistrationRepositoryFromEventAnalytics
  } with {
    briefly "LinkEventAnalyticsToRegistrationRepository"
  }
} with {
  briefly "Bounded context for event registration"
  described as {
    | The RegistrationContext is the bounded context for
    | event registration and attendee management.
  }
}
