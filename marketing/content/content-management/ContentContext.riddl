// Content Management - Content Context
context ContentContext as router is {
  inlet ContentCommandStreamIn is type ContentCommand
  outlet ContentCommandStreamOut is type ContentCommand
  inlet ContentResultStreamIn is type Content.ContentResult
  outlet ContentResultStreamOut is type Content.ContentResult
  handler ContentContextBoundary is {
    on createContent: command Content.CreateContent is {
      send createContent to outlet ContentContext.ContentCommandStreamOut
    }
    on submitDraft: command Content.SubmitDraft is {
      send submitDraft to outlet ContentContext.ContentCommandStreamOut
    }
    on attachMedia: command Content.AttachMedia is {
      send attachMedia to outlet ContentContext.ContentCommandStreamOut
    }
    on requestReview: command Content.RequestReview is {
      send requestReview to outlet ContentContext.ContentCommandStreamOut
    }
    on addReviewComment: command Content.AddReviewComment is {
      send addReviewComment to outlet ContentContext.ContentCommandStreamOut
    }
    on resolveComment: command Content.ResolveComment is {
      send resolveComment to outlet ContentContext.ContentCommandStreamOut
    }
    on requestRevision: command Content.RequestRevision is {
      send requestRevision to outlet ContentContext.ContentCommandStreamOut
    }
    on submitRevision: command Content.SubmitRevision is {
      send submitRevision to outlet ContentContext.ContentCommandStreamOut
    }
    on approveContent: command Content.ApproveContent is {
      send approveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on schedulePublish: command Content.SchedulePublish is {
      send schedulePublish to outlet ContentContext.ContentCommandStreamOut
    }
    on publishContent: command Content.PublishContent is {
      send publishContent to outlet ContentContext.ContentCommandStreamOut
    }
    on updateMetrics: command Content.UpdateMetrics is {
      send updateMetrics to outlet ContentContext.ContentCommandStreamOut
    }
    on archiveContent: command Content.ArchiveContent is {
      send archiveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on contentResult: result Content.ContentResult is {
      send contentResult to outlet ContentContext.ContentResultStreamOut
    }
    on other is {
      error "Unexpected message at the ContentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ContentCommand Stream Intake' is from outlet ContentContext.ContentCommandStreamOut to inlet ContentContext.Content.ContentCommands
  connector 'ContentResult Stream Egress' is from outlet ContentContext.ContentRepository.ContentRepositoryResponses to inlet ContentContext.ContentResultStreamIn
  adaptor FromAnalytics from context Analytics is { 
    handler FromAnalyticsHandler is {
      on event Analytics.ContentMetricsFetched is {
        do "the model receives content metrics fetched"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalytics"
      }
    } with {
      briefly "from analytics"
      described as {
        |Carries messages from the external Analytics.
      }
    }
  } with {
    briefly "Analytics integration"
    described as {
      |The model's side of the Analytics conversation.
    }
  }
  adaptor ToAnalytics to context Analytics is { 
    handler ToAnalyticsHandler is {
      on command Analytics.FetchContentMetrics is {
        do "the model sends fetch content metrics"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalytics"
      }
    } with {
      briefly "to analytics"
      described as {
        |Carries messages to the external Analytics.
      }
    }
  } with {
    briefly "Analytics integration"
    described as {
      |The model's side of the Analytics conversation.
    }
  }
  adaptor FromCMS from context CMS is { 
    handler FromCMSHandler is {
      on event CMS.CMSContentUpdated is {
        do "the model receives cms content updated"
      }
      on event CMS.CMSPublished is {
        do "the model receives cms published"
      }
      on other is {
        error "Unexpected message for adaptor FromCMS"
      }
    } with {
      briefly "from cms"
      described as {
        |Carries messages from the external CMS.
      }
    }
  } with {
    briefly "CMS integration"
    described as {
      |The model's side of the CMS conversation.
    }
  }
  adaptor ToCMS to context CMS is { 
    handler ToCMSHandler is {
      on command CMS.PublishToCMS is {
        do "the model sends publish to cms"
      }
      on command CMS.UpdateCMSContent is {
        do "the model sends update cms content"
      }
      on other is {
        error "Unexpected message for adaptor ToCMS"
      }
    } with {
      briefly "to cms"
      described as {
        |Carries messages to the external CMS.
      }
    }
  } with {
    briefly "CMS integration"
    described as {
      |The model's side of the CMS conversation.
    }
  }
  adaptor FromDAM from context DAM is { 
    handler FromDAMHandler is {
      on event DAM.AssetUploaded is {
        do "the model receives asset uploaded"
      }
      on event DAM.AssetsFound is {
        do "the model receives assets found"
      }
      on other is {
        error "Unexpected message for adaptor FromDAM"
      }
    } with {
      briefly "from dam"
      described as {
        |Carries messages from the external DAM.
      }
    }
  } with {
    briefly "DAM integration"
    described as {
      |The model's side of the DAM conversation.
    }
  }
  adaptor ToDAM to context DAM is { 
    handler ToDAMHandler is {
      on command DAM.SearchAssets is {
        do "the model sends search assets"
      }
      on command DAM.UploadAsset is {
        do "the model sends upload asset"
      }
      on other is {
        error "Unexpected message for adaptor ToDAM"
      }
    } with {
      briefly "to dam"
      described as {
        |Carries messages to the external DAM.
      }
    }
  } with {
    briefly "DAM integration"
    described as {
      |The model's side of the DAM conversation.
    }
  }
  adaptor FromPlagiarismChecker from context PlagiarismChecker is { 
    handler FromPlagiarismCheckerHandler is {
      on event PlagiarismChecker.PlagiarismChecked is {
        do "the model receives plagiarism checked"
      }
      on other is {
        error "Unexpected message for adaptor FromPlagiarismChecker"
      }
    } with {
      briefly "from plagiarism checker"
      described as {
        |Carries messages from the external PlagiarismChecker.
      }
    }
  } with {
    briefly "PlagiarismChecker integration"
    described as {
      |The model's side of the PlagiarismChecker conversation.
    }
  }
  adaptor ToPlagiarismChecker to context PlagiarismChecker is { 
    handler ToPlagiarismCheckerHandler is {
      on command PlagiarismChecker.CheckPlagiarism is {
        do "the model sends check plagiarism"
      }
      on other is {
        error "Unexpected message for adaptor ToPlagiarismChecker"
      }
    } with {
      briefly "to plagiarism checker"
      described as {
        |Carries messages to the external PlagiarismChecker.
      }
    }
  } with {
    briefly "PlagiarismChecker integration"
    described as {
      |The model's side of the PlagiarismChecker conversation.
    }
  }
  adaptor FromSEOAnalysis from context SEOAnalysis is { 
    handler FromSEOAnalysisHandler is {
      on event SEOAnalysis.SEOAnalyzed is {
        do "the model receives seo analyzed"
      }
      on other is {
        error "Unexpected message for adaptor FromSEOAnalysis"
      }
    } with {
      briefly "from seo analysis"
      described as {
        |Carries messages from the external SEOAnalysis.
      }
    }
  } with {
    briefly "SEOAnalysis integration"
    described as {
      |The model's side of the SEOAnalysis conversation.
    }
  }
  adaptor ToSEOAnalysis to context SEOAnalysis is { 
    handler ToSEOAnalysisHandler is {
      on command SEOAnalysis.AnalyzeSEO is {
        do "the model sends analyze seo"
      }
      on other is {
        error "Unexpected message for adaptor ToSEOAnalysis"
      }
    } with {
      briefly "to seo analysis"
      described as {
        |Carries messages to the external SEOAnalysis.
      }
    }
  } with {
    briefly "SEOAnalysis integration"
    described as {
      |The model's side of the SEOAnalysis conversation.
    }
  }
  include "types.riddl"
  include "Content.riddl"
  repository ContentRepository as merge is {
    inlet ContentRepositoryFromContent is type ContentEvent    inlet ContentRepositoryFromContentAnalytics is type ContentEvent    outlet ContentRepositoryResponses is type Content.ContentResult
    record StoredContent is  {
      contentId: ContentId with {
        briefly "contentId"
        described as {
          |The contentId column of the stored content row.
        }
      }
      assignedWriter: String(1,100) with {
        briefly "assignedWriter"
        described as {
          |The assignedWriter column of the stored content row.
        }
      }
      brief: ContentBrief with {
        briefly "brief"
        described as {
          |The brief column of the stored content row.
        }
      }
      category: ContentCategory with {
        briefly "category"
        described as {
          |The category column of the stored content row.
        }
      }
      status: ContentStatus with {
        briefly "status"
        described as {
          |The status column of the stored content row.
        }
      }
    } with {
      briefly "Stored content row"
      described as {
        |The persistence shape of content data as this repository stores it.
      }
    }
    schema ContentData is relational
      of content as type StoredContent
        index on field StoredContent.status
        index on field StoredContent.category
        index on field StoredContent.brief.dueDate
        index on field StoredContent.assignedWriter
 with {
      briefly "Content data schema"
      described as {
        |The relational schema holding content data for the ContentRepository.
      }
    }
    handler ContentPersistence is {
      on query GetContentMetricsAgg is {
        let contentMetricsAggView: type ContentMetricsAggView = prompt("read the content metrics agg projection")
        reply contentMetricsAggView
      }
      on createContent: command Content.CreateContent is {
        tell event Content.ContentCreated(contentId = createContent.contentId, category = createContent.category, assignedWriter = createContent.assignedWriter) to entity ContentContext.Content
        do "Store new content record"
      }
      on submitDraft: command Content.SubmitDraft is {
        tell event Content.DraftSubmitted(contentId = submitDraft.contentId) to entity ContentContext.Content
        do "Store content draft"
      }
      on command Content.AttachMedia is {
        do "Store media attachment"
      }
      on command Content.RequestReview is {
        do "Update to review status"
      }
      on addReviewComment: command Content.AddReviewComment is {
        tell event Content.ReviewCommentAdded(contentId = addReviewComment.contentId, comment = addReviewComment.comment) to entity ContentContext.Content
        do "Store review comment"
      }
      on submitRevision: command Content.SubmitRevision is {
        tell event Content.RevisionSubmitted(contentId = submitRevision.contentId) to entity ContentContext.Content
        do "Store new version"
      }
      on approveContent: command Content.ApproveContent is {
        tell event Content.ContentApproved(contentId = approveContent.contentId, approvedBy = approveContent.approvedBy) to entity ContentContext.Content
        do "Update to approved status"
      }
      on publishContent: command Content.PublishContent is {
        tell event Content.ContentPublished(contentId = publishContent.contentId) to entity ContentContext.Content
        do "Update to published status"
      }
      on updateMetrics: command Content.UpdateMetrics is {
        tell event Content.MetricsUpdated(contentId = updateMetrics.contentId, metrics = updateMetrics.metrics) to entity ContentContext.Content
        do "Store content metrics"
      }
      on command Content.ArchiveContent is {
        do "Archive content record"
      }
    } with {
      briefly "Persists content commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Content data persistence"
    described as {
      |Persistent storage for content.
    }
  }
  query GetContentMetricsAgg is  {
    contentMetricsAggKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which content metrics agg to retrieve.
      }
    }
  } with {
    briefly "Get content metrics agg"
    described as {
      |Retrieves the content metrics agg projection.
    }
  }
  result ContentMetricsAggView is  {
    contentMetricsAgg: ContentAnalytics.ContentMetricsAgg with {
      briefly "Content metrics agg"
      described as {
        |The content metrics agg being returned.
      }
    }
  } with {
    briefly "Content metrics agg view"
    described as {
      |Read model view carrying the content metrics agg projection.
    }
  }
  projector ContentAnalytics as flow is {
    updates repository ContentContext.ContentRepository
    inlet ContentAnalyticsFromContent is type ContentEvent    outlet ContentAnalyticsOut is type ContentEvent
    record ContentMetricsAgg is  {
      totalContent: Natural with {
        briefly "Total"
        described as {
          |Total content.
        }
      }
      inProduction: Natural with {
        briefly "Production"
        described as {
          |In production.
        }
      }
      publishedThisMonth: Natural with {
        briefly "Published"
        described as {
          |Published this month.
        }
      }
      averageProductionDays: Decimal(5,1) with {
        briefly "Avg days"
        described as {
          |Avg production time.
        }
      }
      topPerformingCategory: String(1,50) with {
        briefly "Top category"
        described as {
          |Best category.
        }
      }
      totalViews: Natural with {
        briefly "Views"
        described as {
          |Total views.
        }
      }
    } with {
      briefly "Content metrics aggregate"
      described as {
        |Aggregate content metrics.
      }
    }
    handler AnalyticsHandler is {
      on contentCreated: event Content.ContentCreated is {
        tell contentCreated to repository ContentContext.ContentRepository
        do "Increment content count"
      }
      on contentPublished: event Content.ContentPublished is {
        tell contentPublished to repository ContentContext.ContentRepository
        do "Track publication"
      }
      on metricsUpdated: event Content.MetricsUpdated is {
        tell metricsUpdated to repository ContentContext.ContentRepository
        do "Aggregate performance"
      }
      on contentArchived: event Content.ContentArchived is {
        tell contentArchived to repository ContentContext.ContentRepository
        do "Update production stats"
      }
    } with {
      briefly "Maintains content analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Content analytics"
    described as {
      |Content performance tracking.
    }
  }
  // ---- Event publication for Content ----
  type ContentEvent is one of {
    ContentContext.Content.ContentCreated or ContentContext.Content.DraftSubmitted or ContentContext.Content.MediaAttached or ContentContext.Content.ReviewRequested or ContentContext.Content.ReviewCommentAdded or ContentContext.Content.CommentResolved or ContentContext.Content.RevisionRequested or ContentContext.Content.RevisionSubmitted or ContentContext.Content.ContentApproved or ContentContext.Content.PublishScheduled or ContentContext.Content.ContentPublished or ContentContext.Content.MetricsUpdated or ContentContext.Content.ContentArchived
  } with {
    briefly "Content event alternation"
    described as {
      |Union of all Content events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ContentEventSource as source is {
    outlet ContentEvents is type ContentEvent
    handler ContentSourceHandler is {
      on contentCreated: event Content.ContentCreated is {
        send contentCreated to outlet ContentEvents
      }
      on draftSubmitted: event Content.DraftSubmitted is {
        send draftSubmitted to outlet ContentEvents
      }
      on mediaAttached: event Content.MediaAttached is {
        send mediaAttached to outlet ContentEvents
      }
      on reviewRequested: event Content.ReviewRequested is {
        send reviewRequested to outlet ContentEvents
      }
      on reviewCommentAdded: event Content.ReviewCommentAdded is {
        send reviewCommentAdded to outlet ContentEvents
      }
      on commentResolved: event Content.CommentResolved is {
        send commentResolved to outlet ContentEvents
      }
      on revisionRequested: event Content.RevisionRequested is {
        send revisionRequested to outlet ContentEvents
      }
      on revisionSubmitted: event Content.RevisionSubmitted is {
        send revisionSubmitted to outlet ContentEvents
      }
      on contentApproved: event Content.ContentApproved is {
        send contentApproved to outlet ContentEvents
      }
      on publishScheduled: event Content.PublishScheduled is {
        send publishScheduled to outlet ContentEvents
      }
      on contentPublished: event Content.ContentPublished is {
        send contentPublished to outlet ContentEvents
      }
      on metricsUpdated: event Content.MetricsUpdated is {
        send metricsUpdated to outlet ContentEvents
      }
      on contentArchived: event Content.ContentArchived is {
        send contentArchived to outlet ContentEvents
      }
      on other is {
        error "Unexpected message for source ContentEventSource"
      }
    } with {
      briefly "Content source handler"
      described as {
        |Publishes Content events onto the outlet.
      }
    }
  } with {
    briefly "Content event source"
    described as {
      |Publishes Content entity events into the streaming topology.
    }
  }
  processor ContentEventSink as sink is {
    inlet ContentInlet is type ContentEvent    handler ContentSinkHandler is {
      on contentCreated: event Content.ContentCreated is {
        tell contentCreated to repository ContentContext.ContentRepository
      }
      on draftSubmitted: event Content.DraftSubmitted is {
        tell draftSubmitted to repository ContentContext.ContentRepository
      }
      on mediaAttached: event Content.MediaAttached is {
        tell mediaAttached to repository ContentContext.ContentRepository
      }
      on reviewRequested: event Content.ReviewRequested is {
        tell reviewRequested to repository ContentContext.ContentRepository
      }
      on reviewCommentAdded: event Content.ReviewCommentAdded is {
        tell reviewCommentAdded to repository ContentContext.ContentRepository
      }
      on commentResolved: event Content.CommentResolved is {
        tell commentResolved to repository ContentContext.ContentRepository
      }
      on revisionRequested: event Content.RevisionRequested is {
        tell revisionRequested to repository ContentContext.ContentRepository
      }
      on revisionSubmitted: event Content.RevisionSubmitted is {
        tell revisionSubmitted to repository ContentContext.ContentRepository
      }
      on contentApproved: event Content.ContentApproved is {
        tell contentApproved to repository ContentContext.ContentRepository
      }
      on publishScheduled: event Content.PublishScheduled is {
        tell publishScheduled to repository ContentContext.ContentRepository
      }
      on contentPublished: event Content.ContentPublished is {
        tell contentPublished to repository ContentContext.ContentRepository
      }
      on metricsUpdated: event Content.MetricsUpdated is {
        tell metricsUpdated to repository ContentContext.ContentRepository
      }
      on contentArchived: event Content.ContentArchived is {
        tell contentArchived to repository ContentContext.ContentRepository
      }
      on other is {
        error "Unexpected message for sink ContentEventSink"
      }
    } with {
      briefly "Content sink handler"
      described as {
        |Persists Content events via the repository.
      }
    }
  } with {
    briefly "Content event sink"
    described as {
      |Receives Content events for persistence.
    }
  }
  connector ContentEventFlow is from outlet ContentContext.ContentEventSource.ContentEvents to inlet ContentContext.ContentEventSink.ContentInlet with {
    briefly "Content event flow"
    described as {
      |Connects the Content source to its sink.
    }
  }
  processor ContentEventSplit as split is {
    inlet ContentEventSplitIn is type ContentEvent    outlet ContentEventSplitToContentRepository is type ContentEvent
    outlet ContentEventSplitToContentAnalytics is type ContentEvent
    handler ContentEventSplitHandler is {
      on contentCreated: event Content.ContentCreated is {
        send contentCreated to outlet ContentEventSplitToContentRepository
        send contentCreated to outlet ContentEventSplitToContentAnalytics
        tell contentCreated to entity ContentContext.Content
      }
      on draftSubmitted: event Content.DraftSubmitted is {
        send draftSubmitted to outlet ContentEventSplitToContentRepository
        send draftSubmitted to outlet ContentEventSplitToContentAnalytics
        tell draftSubmitted to entity ContentContext.Content
      }
      on mediaAttached: event Content.MediaAttached is {
        send mediaAttached to outlet ContentEventSplitToContentRepository
        send mediaAttached to outlet ContentEventSplitToContentAnalytics
        tell mediaAttached to entity ContentContext.Content
      }
      on reviewRequested: event Content.ReviewRequested is {
        send reviewRequested to outlet ContentEventSplitToContentRepository
        send reviewRequested to outlet ContentEventSplitToContentAnalytics
        tell reviewRequested to entity ContentContext.Content
      }
      on reviewCommentAdded: event Content.ReviewCommentAdded is {
        send reviewCommentAdded to outlet ContentEventSplitToContentRepository
        send reviewCommentAdded to outlet ContentEventSplitToContentAnalytics
        tell reviewCommentAdded to entity ContentContext.Content
      }
      on commentResolved: event Content.CommentResolved is {
        send commentResolved to outlet ContentEventSplitToContentRepository
        send commentResolved to outlet ContentEventSplitToContentAnalytics
        tell commentResolved to entity ContentContext.Content
      }
      on revisionRequested: event Content.RevisionRequested is {
        send revisionRequested to outlet ContentEventSplitToContentRepository
        send revisionRequested to outlet ContentEventSplitToContentAnalytics
        tell revisionRequested to entity ContentContext.Content
      }
      on revisionSubmitted: event Content.RevisionSubmitted is {
        send revisionSubmitted to outlet ContentEventSplitToContentRepository
        send revisionSubmitted to outlet ContentEventSplitToContentAnalytics
        tell revisionSubmitted to entity ContentContext.Content
      }
      on contentApproved: event Content.ContentApproved is {
        send contentApproved to outlet ContentEventSplitToContentRepository
        send contentApproved to outlet ContentEventSplitToContentAnalytics
        tell contentApproved to entity ContentContext.Content
      }
      on publishScheduled: event Content.PublishScheduled is {
        send publishScheduled to outlet ContentEventSplitToContentRepository
        send publishScheduled to outlet ContentEventSplitToContentAnalytics
        tell publishScheduled to entity ContentContext.Content
      }
      on contentPublished: event Content.ContentPublished is {
        send contentPublished to outlet ContentEventSplitToContentRepository
        send contentPublished to outlet ContentEventSplitToContentAnalytics
        tell contentPublished to entity ContentContext.Content
      }
      on metricsUpdated: event Content.MetricsUpdated is {
        send metricsUpdated to outlet ContentEventSplitToContentRepository
        send metricsUpdated to outlet ContentEventSplitToContentAnalytics
        tell metricsUpdated to entity ContentContext.Content
      }
      on contentArchived: event Content.ContentArchived is {
        send contentArchived to outlet ContentEventSplitToContentRepository
        send contentArchived to outlet ContentEventSplitToContentAnalytics
        tell contentArchived to entity ContentContext.Content
      }
      on other is {
        error "Unexpected message for processor ContentEventSplit"
      }
    } with {
      briefly "Content event fan-out handler"
      described as {
        |Delivers each Content event to all of its consumers.
      }
    }
  } with {
    briefly "Content event fan-out"
    described as {
      |Fans Content events out to the repository and projectors.
    }
  }
  connector 'ContentEvent Stream' is from outlet ContentContext.Content.ContentEvents2 to inlet ContentContext.ContentEventSplit.ContentEventSplitIn with {
    briefly "Content events, fanned out to storage and read models"
  }
  connector 'ContentEvent Storage' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentRepository to inlet ContentContext.ContentRepository.ContentRepositoryFromContent with {
    briefly "Content events on their way to storage"
  }
  connector 'ContentAnalytics Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentAnalytics to inlet ContentContext.ContentAnalytics.ContentAnalyticsFromContent with {
    briefly "Content events feeding the ContentAnalytics projection"
  }
  connector 'ContentAnalytics Storage' is from outlet ContentContext.ContentAnalytics.ContentAnalyticsOut to inlet ContentContext.ContentRepository.ContentRepositoryFromContentAnalytics with {
    briefly "The ContentAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for content management"
  described as {
    |Marketing content workflow context.
  }
}
