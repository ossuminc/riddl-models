// Content Management - Content Context
context ContentContext as router is {
  inlet ContentContextFromAnalytics is command Content.UpdateMetrics with {
    briefly "What FromAnalytics makes of that service's news"
  }
  connector 'FromAnalytics Intake' is from outlet ContentContext.FromAnalytics.FromAnalyticsToContentContext to inlet ContentContext.ContentContextFromAnalytics with {
    briefly "What FromAnalytics makes of that news, on its way in"
  }
  inlet ContentCommandStreamIn is type ContentCommand  outlet ContentCommandStreamOut is type ContentCommand
  inlet ContentResultStreamIn is result Content.ContentResult  outlet ContentResultStreamOut is result Content.ContentResult
  handler ContentContextBoundary is {
    on createContent: command Content.CreateContent is {
      send createContent to outlet ContentContext.ContentCommandStreamOut
    }
    on submitDraft: command Content.SubmitDraft is {
      send submitDraft to outlet ContentContext.ContentCommandStreamOut
    }
    on attachMedia: command Content.AttachMedia is {
      send attachMedia to outlet ContentContext.ContentCommandStreamOut
    }
    on requestReview: command Content.RequestReview is {
      send requestReview to outlet ContentContext.ContentCommandStreamOut
    }
    on addReviewComment: command Content.AddReviewComment is {
      send addReviewComment to outlet ContentContext.ContentCommandStreamOut
    }
    on resolveComment: command Content.ResolveComment is {
      send resolveComment to outlet ContentContext.ContentCommandStreamOut
    }
    on requestRevision: command Content.RequestRevision is {
      send requestRevision to outlet ContentContext.ContentCommandStreamOut
    }
    on submitRevision: command Content.SubmitRevision is {
      send submitRevision to outlet ContentContext.ContentCommandStreamOut
    }
    on approveContent: command Content.ApproveContent is {
      send approveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on schedulePublish: command Content.SchedulePublish is {
      send schedulePublish to outlet ContentContext.ContentCommandStreamOut
    }
    on publishContent: command Content.PublishContent is {
      send publishContent to outlet ContentContext.ContentCommandStreamOut
    }
    on updateMetrics: command Content.UpdateMetrics is {
      send updateMetrics to outlet ContentContext.ContentCommandStreamOut
    }
    on archiveContent: command Content.ArchiveContent is {
      send archiveContent to outlet ContentContext.ContentCommandStreamOut
    }
    on contentResult: result Content.ContentResult is {
      send contentResult to outlet ContentContext.ContentResultStreamOut
    }
    on other is {
      error "Unexpected message at the ContentContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ContentCommand Stream Intake' is from outlet ContentContext.ContentCommandStreamOut to inlet ContentContext.Content.ContentCommands  connector 'ContentResult Stream Egress' is from outlet ContentContext.ContentRepository.ContentRepositoryResponses to inlet ContentContext.ContentResultStreamIn  adaptor FromAnalytics from context Analytics as flow is { 
    inlet FromAnalyticsIn is event Analytics.ContentMetricsFetched    outlet FromAnalyticsToContentContext is command Content.UpdateMetrics
    handler FromAnalyticsHandler is {
      on contentMetricsFetched: event Analytics.ContentMetricsFetched is {
        let item0: type Content.UpdateMetrics = prompt("translate the contentMetricsFetched event into a UpdateMetrics, the fetched metrics are what the content carries")
        send item0 to outlet ContentContext.FromAnalytics.FromAnalyticsToContentContext
      }
      on other is {
        error "Unexpected message for adaptor FromAnalytics"
      }
    } with {
      briefly "from analytics"
      described as {
        |Carries messages from the external Analytics.
      }
    }
  } with {
    briefly "Analytics integration"
    described as {
      |The model's side of the Analytics conversation.
    }
  }
  adaptor ToAnalytics to context Analytics as flow is { 
    inlet ToAnalyticsIn is type ContentEvent    outlet ToAnalyticsOut is command Analytics.FetchContentMetrics
    handler ToAnalyticsHandler is {
      on contentPublished: event Content.ContentPublished is {
        let item0: type Analytics.FetchContentMetrics = prompt("translate the contentPublished event into a FetchContentMetrics, there being no metrics before publication")
        send item0 to outlet ContentContext.ToAnalytics.ToAnalyticsOut
      }
      on other is {
        error "Unexpected message for adaptor ToAnalytics"
      }
    } with {
      briefly "to analytics"
      described as {
        |Carries messages to the external Analytics.
      }
    }
  } with {
    briefly "Analytics integration"
    described as {
      |The model's side of the Analytics conversation.
    }
  }
  adaptor FromCMS from context CMS as sink is { 
    inlet FromCMSIn is type CMS.CMSEvent    handler FromCMSHandler is {
      on cMSContentUpdated: event CMS.CMSContentUpdated is {
        do "the CMS matches; submitting the revision was recorded here"
      }
      on cMSPublished: event CMS.CMSPublished is {
        do "the CMS shows it; publishing was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromCMS"
      }
    } with {
      briefly "from cms"
      described as {
        |Carries messages from the external CMS.
      }
    }
  } with {
    briefly "CMS integration"
    described as {
      |The model's side of the CMS conversation.
    }
  }
  adaptor ToCMS to context CMS as flow is { 
    inlet ToCMSIn is type ContentEvent    outlet ToCMSOut is type CMS.CMSCommand
    handler ToCMSHandler is {
      on contentPublished: event Content.ContentPublished is {
        let item0: type CMS.PublishToCMS = prompt("translate the contentPublished event into a PublishToCMS, publication being what the site must show")
        send item0 to outlet ContentContext.ToCMS.ToCMSOut
      }
      on revisionSubmitted: event Content.RevisionSubmitted is {
        let item0: type CMS.UpdateCMSContent = prompt("translate the revisionSubmitted event into a UpdateCMSContent, a revision being what makes what it shows stale")
        send item0 to outlet ContentContext.ToCMS.ToCMSOut
      }
      on other is {
        error "Unexpected message for adaptor ToCMS"
      }
    } with {
      briefly "to cms"
      described as {
        |Carries messages to the external CMS.
      }
    }
  } with {
    briefly "CMS integration"
    described as {
      |The model's side of the CMS conversation.
    }
  }
  adaptor FromDAM from context DAM as sink is { 
    inlet FromDAMIn is type DAM.DAMEvent    handler FromDAMHandler is {
      on assetUploaded: event DAM.AssetUploaded is {
        do "the asset is stored; attaching it was recorded here"
      }
      on assetsFound: event DAM.AssetsFound is {
        do "the results are in; the author picks from them"
      }
      on other is {
        error "Unexpected message for adaptor FromDAM"
      }
    } with {
      briefly "from dam"
      described as {
        |Carries messages from the external DAM.
      }
    }
  } with {
    briefly "DAM integration"
    described as {
      |The model's side of the DAM conversation.
    }
  }
  adaptor ToDAM to context DAM as flow is { 
    inlet ToDAMIn is type ContentEvent    outlet ToDAMOut is type DAM.DAMCommand
    handler ToDAMHandler is {
      on contentCreated: event Content.ContentCreated is {
        let item0: type DAM.SearchAssets = prompt("translate the contentCreated event into a SearchAssets, an author looking for what already exists before making more")
        send item0 to outlet ContentContext.ToDAM.ToDAMOut
      }
      on mediaAttached: event Content.MediaAttached is {
        let item0: type DAM.UploadAsset = prompt("translate the mediaAttached event into a UploadAsset, an attached asset having to live somewhere the library can serve")
        send item0 to outlet ContentContext.ToDAM.ToDAMOut
      }
      on other is {
        error "Unexpected message for adaptor ToDAM"
      }
    } with {
      briefly "to dam"
      described as {
        |Carries messages to the external DAM.
      }
    }
  } with {
    briefly "DAM integration"
    described as {
      |The model's side of the DAM conversation.
    }
  }
  adaptor FromPlagiarismChecker from context PlagiarismChecker as sink is { 
    inlet FromPlagiarismCheckerIn is event PlagiarismChecker.PlagiarismChecked    handler FromPlagiarismCheckerHandler is {
      on plagiarismChecked: event PlagiarismChecker.PlagiarismChecked is {
        do "the check is done; the reviewer reads it before approving"
      }
      on other is {
        error "Unexpected message for adaptor FromPlagiarismChecker"
      }
    } with {
      briefly "from plagiarism checker"
      described as {
        |Carries messages from the external PlagiarismChecker.
      }
    }
  } with {
    briefly "PlagiarismChecker integration"
    described as {
      |The model's side of the PlagiarismChecker conversation.
    }
  }
  adaptor ToPlagiarismChecker to context PlagiarismChecker as flow is { 
    inlet ToPlagiarismCheckerIn is type ContentEvent    outlet ToPlagiarismCheckerOut is command PlagiarismChecker.CheckPlagiarism
    handler ToPlagiarismCheckerHandler is {
      on draftSubmitted: event Content.DraftSubmitted is {
        let item0: type PlagiarismChecker.CheckPlagiarism = prompt("translate the draftSubmitted event into a CheckPlagiarism, submission being the first point there is a draft to check")
        send item0 to outlet ContentContext.ToPlagiarismChecker.ToPlagiarismCheckerOut
      }
      on other is {
        error "Unexpected message for adaptor ToPlagiarismChecker"
      }
    } with {
      briefly "to plagiarism checker"
      described as {
        |Carries messages to the external PlagiarismChecker.
      }
    }
  } with {
    briefly "PlagiarismChecker integration"
    described as {
      |The model's side of the PlagiarismChecker conversation.
    }
  }
  adaptor FromSEOAnalysis from context SEOAnalysis as sink is { 
    inlet FromSEOAnalysisIn is event SEOAnalysis.SEOAnalyzed    handler FromSEOAnalysisHandler is {
      on sEOAnalyzed: event SEOAnalysis.SEOAnalyzed is {
        do "the analysis is in; the author revises or the reviewer approves"
      }
      on other is {
        error "Unexpected message for adaptor FromSEOAnalysis"
      }
    } with {
      briefly "from seo analysis"
      described as {
        |Carries messages from the external SEOAnalysis.
      }
    }
  } with {
    briefly "SEOAnalysis integration"
    described as {
      |The model's side of the SEOAnalysis conversation.
    }
  }
  adaptor ToSEOAnalysis to context SEOAnalysis as flow is { 
    inlet ToSEOAnalysisIn is type ContentEvent    outlet ToSEOAnalysisOut is command SEOAnalysis.AnalyzeSEO
    handler ToSEOAnalysisHandler is {
      on draftSubmitted: event Content.DraftSubmitted is {
        let item0: type SEOAnalysis.AnalyzeSEO = prompt("translate the draftSubmitted event into a AnalyzeSEO, the same draft being what search sees")
        send item0 to outlet ContentContext.ToSEOAnalysis.ToSEOAnalysisOut
      }
      on other is {
        error "Unexpected message for adaptor ToSEOAnalysis"
      }
    } with {
      briefly "to seo analysis"
      described as {
        |Carries messages to the external SEOAnalysis.
      }
    }
  } with {
    briefly "SEOAnalysis integration"
    described as {
      |The model's side of the SEOAnalysis conversation.
    }
  }
  include "types.riddl"
  include "Content.riddl"
  type ContentRepositoryCommand is one of {
    ContentContext.ContentRepository.PersistCommentResolved or ContentContext.ContentRepository.PersistContentApproved or ContentContext.ContentRepository.PersistContentArchived or ContentContext.ContentRepository.PersistContentCreated or ContentContext.ContentRepository.PersistContentPublished or ContentContext.ContentRepository.PersistDraftSubmitted or ContentContext.ContentRepository.PersistMediaAttached or ContentContext.ContentRepository.PersistMetricsUpdated or ContentContext.ContentRepository.PersistPublishScheduled or ContentContext.ContentRepository.PersistReviewCommentAdded or ContentContext.ContentRepository.PersistReviewRequested or ContentContext.ContentRepository.PersistRevisionRequested or ContentContext.ContentRepository.PersistRevisionSubmitted
  } with {
    briefly "Anything that writes ContentRepository"
    described as {
      |The persistence commands ContentRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ContentRepository as flow is {
    inlet ContentRepositoryFromContentAnalytics is type ContentRepositoryCommand    command PersistCommentResolved is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentResolved applies to.
        }
      }
      commentId: UUID? with {
        briefly "Comment id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      resolvedAt: TimeStamp? with {
        briefly "Resolved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist CommentResolved"
      described as {
        |Instructs this repository to apply CommentResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentApproved is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentApproved applies to.
        }
      }
      approvedBy: String(1,100)? with {
        briefly "Approved by"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      approvedAt: TimeStamp? with {
        briefly "Approved at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentApproved"
      described as {
        |Instructs this repository to apply ContentApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDraftSubmitted is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row DraftSubmitted applies to.
        }
      }
      headline: String(1,200)? with {
        briefly "Headline"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      draftWordCount: Natural? with {
        briefly "Draft word count"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist DraftSubmitted"
      described as {
        |Instructs this repository to apply DraftSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMediaAttached is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MediaAttached applies to.
        }
      }
      attachmentId: UUID? with {
        briefly "Attachment id"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      attachedAt: TimeStamp? with {
        briefly "Attached at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MediaAttached"
      described as {
        |Instructs this repository to apply MediaAttached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPublishScheduled is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PublishScheduled applies to.
        }
      }
      publishDate: TimeStamp? with {
        briefly "Publish date"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist PublishScheduled"
      described as {
        |Instructs this repository to apply PublishScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewCommentAdded is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewCommentAdded applies to.
        }
      }
      comment: ReviewComment? with {
        briefly "Comment"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReviewCommentAdded"
      described as {
        |Instructs this repository to apply ReviewCommentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewRequested is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewRequested applies to.
        }
      }
      assignedEditor: String(1,100)? with {
        briefly "Assigned editor"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      requestedAt: TimeStamp? with {
        briefly "Requested at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ReviewRequested"
      described as {
        |Instructs this repository to apply ReviewRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRevisionRequested is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row RevisionRequested applies to.
        }
      }
      reason: String(1,2000)? with {
        briefly "Reason"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      requestedAt: TimeStamp? with {
        briefly "Requested at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RevisionRequested"
      described as {
        |Instructs this repository to apply RevisionRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRevisionSubmitted is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row RevisionSubmitted applies to.
        }
      }
      versionNumber: Natural? with {
        briefly "Version number"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist RevisionSubmitted"
      described as {
        |Instructs this repository to apply RevisionSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentArchived is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentArchived applies to.
        }
      }
      archivedAt: TimeStamp? with {
        briefly "Archived at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentArchived"
      described as {
        |Instructs this repository to apply ContentArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentCreated is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentCreated applies to.
        }
      }
      category: ContentCategory? with {
        briefly "Category"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      assignedWriter: String(1,100)? with {
        briefly "Assigned writer"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentCreated"
      described as {
        |Instructs this repository to apply ContentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentPublished is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentPublished applies to.
        }
      }
      publishUrl: URL? with {
        briefly "Publish url"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      publishedAt: TimeStamp? with {
        briefly "Published at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist ContentPublished"
      described as {
        |Instructs this repository to apply ContentPublished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMetricsUpdated is {
      contentId: ContentId with {
        briefly "Row addressed"
        described as {
          |Which stored row MetricsUpdated applies to.
        }
      }
      metrics: ContentMetrics? with {
        briefly "Metrics"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |Carried from the event the projector folded, so the row can hold it.
        }
      }
    } with {
      briefly "Persist MetricsUpdated"
      described as {
        |Instructs this repository to apply MetricsUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ContentRepositoryResponses is result Content.ContentResult
    record StoredContent is {
      contentId: ContentId with {
        briefly "contentId"
        described as {
          |The contentId column of the stored content row.
        }
      }
      assignedWriter: String(1,100) with {
        briefly "assignedWriter"
        described as {
          |The assignedWriter column of the stored content row.
        }
      }
      brief: ContentBrief with {
        briefly "brief"
        described as {
          |The brief column of the stored content row.
        }
      }
      category: ContentCategory with {
        briefly "category"
        described as {
          |The category column of the stored content row.
        }
      }
      status: ContentStatus with {
        briefly "status"
        described as {
          |The status column of the stored content row.
        }
      }
      commentId: UUID? with {
        briefly "Comment id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      resolvedAt: TimeStamp? with {
        briefly "Resolved at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      approvedBy: String(1,100)? with {
        briefly "Approved by"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      approvedAt: TimeStamp? with {
        briefly "Approved at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      headline: String(1,200)? with {
        briefly "Headline"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      draftWordCount: Natural? with {
        briefly "Draft word count"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      submittedAt: TimeStamp? with {
        briefly "Submitted at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      attachmentId: UUID? with {
        briefly "Attachment id"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      attachedAt: TimeStamp? with {
        briefly "Attached at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      publishDate: TimeStamp? with {
        briefly "Publish date"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      scheduledAt: TimeStamp? with {
        briefly "Scheduled at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      comment: ReviewComment? with {
        briefly "Comment"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      assignedEditor: String(1,100)? with {
        briefly "Assigned editor"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      requestedAt: TimeStamp? with {
        briefly "Requested at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      reason: String(1,2000)? with {
        briefly "Reason"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      versionNumber: Natural? with {
        briefly "Version number"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      archivedAt: TimeStamp? with {
        briefly "Archived at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      createdAt: TimeStamp? with {
        briefly "Created at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      publishUrl: URL? with {
        briefly "Publish url"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      publishedAt: TimeStamp? with {
        briefly "Published at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      metrics: ContentMetrics? with {
        briefly "Metrics"
        described as {
          |As the persisting projector last wrote it.
        }
      }
      updatedAt: TimeStamp? with {
        briefly "Updated at"
        described as {
          |As the persisting projector last wrote it.
        }
      }
    } with {
      briefly "Stored content row"
      described as {
        |The persistence shape of content data as this repository stores it.
      }
    }
    schema ContentData is relational
      of content as record StoredContent
        key on field StoredContent.contentId
        index on field StoredContent.status
        index on field StoredContent.category
        index on field StoredContent.brief.dueDate
        index on field StoredContent.assignedWriter
 with {
      briefly "Content data schema"
      described as {
        |The relational schema holding content data for the ContentRepository.
      }
    }
    handler ContentPersistence is {
      on persistCommentResolved: command PersistCommentResolved is {
        update ContentData.content set commentId = persistCommentResolved.commentId, resolvedAt = persistCommentResolved.resolvedAt where contentId == persistCommentResolved.contentId
      }
      on persistContentApproved: command PersistContentApproved is {
        update ContentData.content set approvedBy = persistContentApproved.approvedBy, approvedAt = persistContentApproved.approvedAt where contentId == persistContentApproved.contentId
      }
      on persistDraftSubmitted: command PersistDraftSubmitted is {
        update ContentData.content set headline = persistDraftSubmitted.headline, draftWordCount = persistDraftSubmitted.draftWordCount, submittedAt = persistDraftSubmitted.submittedAt where contentId == persistDraftSubmitted.contentId
      }
      on persistMediaAttached: command PersistMediaAttached is {
        update ContentData.content set attachmentId = persistMediaAttached.attachmentId, attachedAt = persistMediaAttached.attachedAt where contentId == persistMediaAttached.contentId
      }
      on persistPublishScheduled: command PersistPublishScheduled is {
        update ContentData.content set publishDate = persistPublishScheduled.publishDate, scheduledAt = persistPublishScheduled.scheduledAt where contentId == persistPublishScheduled.contentId
      }
      on persistReviewCommentAdded: command PersistReviewCommentAdded is {
        update ContentData.content set comment = persistReviewCommentAdded.comment where contentId == persistReviewCommentAdded.contentId
      }
      on persistReviewRequested: command PersistReviewRequested is {
        update ContentData.content set assignedEditor = persistReviewRequested.assignedEditor, requestedAt = persistReviewRequested.requestedAt where contentId == persistReviewRequested.contentId
      }
      on persistRevisionRequested: command PersistRevisionRequested is {
        update ContentData.content set reason = persistRevisionRequested.reason, requestedAt = persistRevisionRequested.requestedAt where contentId == persistRevisionRequested.contentId
      }
      on persistRevisionSubmitted: command PersistRevisionSubmitted is {
        update ContentData.content set versionNumber = persistRevisionSubmitted.versionNumber, submittedAt = persistRevisionSubmitted.submittedAt where contentId == persistRevisionSubmitted.contentId
      }
      on persistContentArchived: command PersistContentArchived is {
        update ContentData.content set archivedAt = persistContentArchived.archivedAt where contentId == persistContentArchived.contentId
      }
      on persistContentCreated: command PersistContentCreated is {
        update ContentData.content set category = persistContentCreated.category, assignedWriter = persistContentCreated.assignedWriter, createdAt = persistContentCreated.createdAt where contentId == persistContentCreated.contentId
      }
      on persistContentPublished: command PersistContentPublished is {
        update ContentData.content set publishUrl = persistContentPublished.publishUrl, publishedAt = persistContentPublished.publishedAt where contentId == persistContentPublished.contentId
      }
      on persistMetricsUpdated: command PersistMetricsUpdated is {
        update ContentData.content set metrics = persistMetricsUpdated.metrics, updatedAt = persistMetricsUpdated.updatedAt where contentId == persistMetricsUpdated.contentId
      }
      on query GetContentMetricsAgg is {
        let contentMetricsAggView: type ContentMetricsAggView = prompt("read the content metrics agg projection")
        reply contentMetricsAggView
      }
    } with {
      briefly "Persists content commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Content data persistence"
    described as {
      |Persistent storage for content.
    }
  }
  query GetContentMetricsAgg replies result ContentMetricsAggView is {
    contentMetricsAggKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which content metrics agg to retrieve.
      }
    }
  } with {
    briefly "Get content metrics agg"
    described as {
      |Retrieves the content metrics agg projection.
    }
  }
  result ContentMetricsAggView is {
    contentMetricsAgg: ContentAnalytics.ContentMetricsAgg with {
      briefly "Content metrics agg"
      described as {
        |The content metrics agg being returned.
      }
    }
  } with {
    briefly "Content metrics agg view"
    described as {
      |Read model view carrying the content metrics agg projection.
    }
  }
  projector ContentAnalytics as flow is {
    updates repository ContentContext.ContentRepository
    outlet ContentAnalyticsToRepository is type ContentRepositoryCommand
    inlet ContentAnalyticsFromContent is type ContentEvent    record ContentMetricsAgg is {
      totalContent: Natural with {
        briefly "Total"
        described as {
          |Total content.
        }
      }
      inProduction: Natural with {
        briefly "Production"
        described as {
          |In production.
        }
      }
      publishedThisMonth: Natural with {
        briefly "Published"
        described as {
          |Published this month.
        }
      }
      averageProductionDays: Decimal(5,1) with {
        briefly "Avg days"
        described as {
          |Avg production time.
        }
      }
      topPerformingCategory: String(1,50) with {
        briefly "Top category"
        described as {
          |Best category.
        }
      }
      totalViews: Natural with {
        briefly "Views"
        described as {
          |Total views.
        }
      }
    } with {
      briefly "Content metrics aggregate"
      described as {
        |Aggregate content metrics.
      }
    }
    handler AnalyticsHandler is {
      on commentResolved: event Content.CommentResolved is {
        tell command ContentContext.ContentRepository.PersistCommentResolved(contentId = commentResolved.contentId, commentId = commentResolved.commentId, resolvedAt = commentResolved.resolvedAt) to repository ContentContext.ContentRepository
        do "apply CommentResolved to the ContentAnalytics projection"
      }
      on contentApproved: event Content.ContentApproved is {
        tell command ContentContext.ContentRepository.PersistContentApproved(contentId = contentApproved.contentId, approvedBy = contentApproved.approvedBy, approvedAt = contentApproved.approvedAt) to repository ContentContext.ContentRepository
        do "apply ContentApproved to the ContentAnalytics projection"
      }
      on draftSubmitted: event Content.DraftSubmitted is {
        tell command ContentContext.ContentRepository.PersistDraftSubmitted(contentId = draftSubmitted.contentId, headline = draftSubmitted.headline, draftWordCount = draftSubmitted.draftWordCount, submittedAt = draftSubmitted.submittedAt) to repository ContentContext.ContentRepository
        do "apply DraftSubmitted to the ContentAnalytics projection"
      }
      on mediaAttached: event Content.MediaAttached is {
        tell command ContentContext.ContentRepository.PersistMediaAttached(contentId = mediaAttached.contentId, attachmentId = mediaAttached.attachmentId, attachedAt = mediaAttached.attachedAt) to repository ContentContext.ContentRepository
        do "apply MediaAttached to the ContentAnalytics projection"
      }
      on publishScheduled: event Content.PublishScheduled is {
        tell command ContentContext.ContentRepository.PersistPublishScheduled(contentId = publishScheduled.contentId, publishDate = publishScheduled.publishDate, scheduledAt = publishScheduled.scheduledAt) to repository ContentContext.ContentRepository
        do "apply PublishScheduled to the ContentAnalytics projection"
      }
      on reviewCommentAdded: event Content.ReviewCommentAdded is {
        tell command ContentContext.ContentRepository.PersistReviewCommentAdded(contentId = reviewCommentAdded.contentId, comment = reviewCommentAdded.comment) to repository ContentContext.ContentRepository
        do "apply ReviewCommentAdded to the ContentAnalytics projection"
      }
      on reviewRequested: event Content.ReviewRequested is {
        tell command ContentContext.ContentRepository.PersistReviewRequested(contentId = reviewRequested.contentId, assignedEditor = reviewRequested.assignedEditor, requestedAt = reviewRequested.requestedAt) to repository ContentContext.ContentRepository
        do "apply ReviewRequested to the ContentAnalytics projection"
      }
      on revisionRequested: event Content.RevisionRequested is {
        tell command ContentContext.ContentRepository.PersistRevisionRequested(contentId = revisionRequested.contentId, reason = revisionRequested.reason, requestedAt = revisionRequested.requestedAt) to repository ContentContext.ContentRepository
        do "apply RevisionRequested to the ContentAnalytics projection"
      }
      on revisionSubmitted: event Content.RevisionSubmitted is {
        tell command ContentContext.ContentRepository.PersistRevisionSubmitted(contentId = revisionSubmitted.contentId, versionNumber = revisionSubmitted.versionNumber, submittedAt = revisionSubmitted.submittedAt) to repository ContentContext.ContentRepository
        do "apply RevisionSubmitted to the ContentAnalytics projection"
      }
      on contentCreated: event Content.ContentCreated is {
        tell command ContentContext.ContentRepository.PersistContentCreated(contentId = contentCreated.contentId, category = contentCreated.category, assignedWriter = contentCreated.assignedWriter, createdAt = contentCreated.createdAt) to repository ContentContext.ContentRepository
        do "Increment content count"
      }
      on contentPublished: event Content.ContentPublished is {
        tell command ContentContext.ContentRepository.PersistContentPublished(contentId = contentPublished.contentId, publishUrl = contentPublished.publishUrl, publishedAt = contentPublished.publishedAt) to repository ContentContext.ContentRepository
        do "Track publication"
      }
      on metricsUpdated: event Content.MetricsUpdated is {
        tell command ContentContext.ContentRepository.PersistMetricsUpdated(contentId = metricsUpdated.contentId, metrics = metricsUpdated.metrics, updatedAt = metricsUpdated.updatedAt) to repository ContentContext.ContentRepository
        do "Aggregate performance"
      }
      on contentArchived: event Content.ContentArchived is {
        tell command ContentContext.ContentRepository.PersistContentArchived(contentId = contentArchived.contentId, archivedAt = contentArchived.archivedAt) to repository ContentContext.ContentRepository
        do "Update production stats"
      }
    } with {
      briefly "Maintains content analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Content analytics"
    described as {
      |Content performance tracking.
    }
  }
  // ---- Event publication for Content ----
  type ContentEvent is one of {
    ContentContext.Content.ContentCreated or ContentContext.Content.DraftSubmitted or ContentContext.Content.MediaAttached or ContentContext.Content.ReviewRequested or ContentContext.Content.ReviewCommentAdded or ContentContext.Content.CommentResolved or ContentContext.Content.RevisionRequested or ContentContext.Content.RevisionSubmitted or ContentContext.Content.ContentApproved or ContentContext.Content.PublishScheduled or ContentContext.Content.ContentPublished or ContentContext.Content.MetricsUpdated or ContentContext.Content.ContentArchived
  } with {
    briefly "Content event alternation"
    described as {
      |Union of all Content events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ContentEventSplit as split is {
    outlet ContentEventSplitToToSEOAnalysis is type ContentEvent
    outlet ContentEventSplitToToPlagiarismChecker is type ContentEvent
    outlet ContentEventSplitToToDAM is type ContentEvent
    outlet ContentEventSplitToToCMS is type ContentEvent
    outlet ContentEventSplitToToAnalytics is type ContentEvent
    inlet ContentEventSplitIn is type ContentEvent    outlet ContentEventSplitToContentAnalytics is type ContentEvent
    handler ContentEventSplitHandler is {
      on contentCreated: event Content.ContentCreated is {
        send contentCreated to outlet ContentEventSplitToContentAnalytics
        send contentCreated to outlet ContentEventSplitToToDAM
        tell contentCreated to entity ContentContext.Content
      }
      on draftSubmitted: event Content.DraftSubmitted is {
        send draftSubmitted to outlet ContentEventSplitToContentAnalytics
        send draftSubmitted to outlet ContentEventSplitToToSEOAnalysis
        send draftSubmitted to outlet ContentEventSplitToToPlagiarismChecker
        tell draftSubmitted to entity ContentContext.Content
      }
      on mediaAttached: event Content.MediaAttached is {
        send mediaAttached to outlet ContentEventSplitToContentAnalytics
        send mediaAttached to outlet ContentEventSplitToToDAM
        tell mediaAttached to entity ContentContext.Content
      }
      on reviewRequested: event Content.ReviewRequested is {
        send reviewRequested to outlet ContentEventSplitToContentAnalytics
        tell reviewRequested to entity ContentContext.Content
      }
      on reviewCommentAdded: event Content.ReviewCommentAdded is {
        send reviewCommentAdded to outlet ContentEventSplitToContentAnalytics
        tell reviewCommentAdded to entity ContentContext.Content
      }
      on commentResolved: event Content.CommentResolved is {
        send commentResolved to outlet ContentEventSplitToContentAnalytics
        tell commentResolved to entity ContentContext.Content
      }
      on revisionRequested: event Content.RevisionRequested is {
        send revisionRequested to outlet ContentEventSplitToContentAnalytics
        tell revisionRequested to entity ContentContext.Content
      }
      on revisionSubmitted: event Content.RevisionSubmitted is {
        send revisionSubmitted to outlet ContentEventSplitToContentAnalytics
        send revisionSubmitted to outlet ContentEventSplitToToCMS
        tell revisionSubmitted to entity ContentContext.Content
      }
      on contentApproved: event Content.ContentApproved is {
        send contentApproved to outlet ContentEventSplitToContentAnalytics
        tell contentApproved to entity ContentContext.Content
      }
      on publishScheduled: event Content.PublishScheduled is {
        send publishScheduled to outlet ContentEventSplitToContentAnalytics
        tell publishScheduled to entity ContentContext.Content
      }
      on contentPublished: event Content.ContentPublished is {
        send contentPublished to outlet ContentEventSplitToContentAnalytics
        send contentPublished to outlet ContentEventSplitToToCMS
        send contentPublished to outlet ContentEventSplitToToAnalytics
        tell contentPublished to entity ContentContext.Content
      }
      on metricsUpdated: event Content.MetricsUpdated is {
        send metricsUpdated to outlet ContentEventSplitToContentAnalytics
        tell metricsUpdated to entity ContentContext.Content
      }
      on contentArchived: event Content.ContentArchived is {
        send contentArchived to outlet ContentEventSplitToContentAnalytics
        tell contentArchived to entity ContentContext.Content
      }
      on other is {
        error "Unexpected message for processor ContentEventSplit"
      }
    } with {
      briefly "Content event fan-out handler"
      described as {
        |Delivers each Content event to all of its consumers.
      }
    }
  } with {
    briefly "Content event fan-out"
    described as {
      |Fans Content events out to the repository and projectors.
    }
  }
  connector 'ToSEOAnalysis Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToSEOAnalysis to inlet ContentContext.ToSEOAnalysis.ToSEOAnalysisIn with {
    briefly "The Content events ToSEOAnalysis translates, on their way to it"
  }
  connector 'ToPlagiarismChecker Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToPlagiarismChecker to inlet ContentContext.ToPlagiarismChecker.ToPlagiarismCheckerIn with {
    briefly "The Content events ToPlagiarismChecker translates, on their way to it"
  }
  connector 'ToDAM Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToDAM to inlet ContentContext.ToDAM.ToDAMIn with {
    briefly "The Content events ToDAM translates, on their way to it"
  }
  connector 'ToCMS Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToCMS to inlet ContentContext.ToCMS.ToCMSIn with {
    briefly "The Content events ToCMS translates, on their way to it"
  }
  connector 'ToAnalytics Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToToAnalytics to inlet ContentContext.ToAnalytics.ToAnalyticsIn with {
    briefly "The Content events ToAnalytics translates, on their way to it"
  }
  connector 'ContentEvent Stream' is from outlet ContentContext.Content.ContentEvents2 to inlet ContentContext.ContentEventSplit.ContentEventSplitIn with {
    briefly "Content events, fanned out to storage and read models"
  }
  connector 'ContentAnalytics Feed' is from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentAnalytics to inlet ContentContext.ContentAnalytics.ContentAnalyticsFromContent with {
    briefly "Content events feeding the ContentAnalytics projection"
  }
  connector 'ContentAnalytics Storage' is from outlet ContentContext.ContentAnalytics.ContentAnalyticsToRepository to inlet ContentContext.ContentRepository.ContentRepositoryFromContentAnalytics with {
    briefly "ContentAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for content management"
  described as {
    |Marketing content workflow context.
  }
}
