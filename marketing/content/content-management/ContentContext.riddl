// Content Management - Content Context
context ContentContext is {
  adaptor FromAnalytics from context Analytics is {
    handler FromAnalyticsHandler is {
      on event Analytics.ContentMetricsFetched is {
        do "the model receives content metrics fetched"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalytics"
      }
    } with {
      briefly "from analytics"
      described as {
        |Carries messages from the external Analytics.
      }
    }
  } with {
      briefly "Analytics integration"
    described as {
      |The model's side of the Analytics conversation.
    }
  }
  adaptor ToAnalytics to context Analytics is {
    handler ToAnalyticsHandler is {
      on command Analytics.FetchContentMetrics is {
        do "the model sends fetch content metrics"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalytics"
      }
    } with {
      briefly "to analytics"
      described as {
        |Carries messages to the external Analytics.
      }
    }
  } with {
      briefly "Analytics integration"
    described as {
      |The model's side of the Analytics conversation.
    }
  }
  adaptor FromCMS from context CMS is {
    handler FromCMSHandler is {
      on event CMS.CMSContentUpdated is {
        do "the model receives cms content updated"
      }
      on event CMS.CMSPublished is {
        do "the model receives cms published"
      }
      on other is {
        error "Unexpected message for adaptor FromCMS"
      }
    } with {
      briefly "from cms"
      described as {
        |Carries messages from the external CMS.
      }
    }
  } with {
      briefly "CMS integration"
    described as {
      |The model's side of the CMS conversation.
    }
  }
  adaptor ToCMS to context CMS is {
    handler ToCMSHandler is {
      on command CMS.PublishToCMS is {
        do "the model sends publish to cms"
      }
      on command CMS.UpdateCMSContent is {
        do "the model sends update cms content"
      }
      on other is {
        error "Unexpected message for adaptor ToCMS"
      }
    } with {
      briefly "to cms"
      described as {
        |Carries messages to the external CMS.
      }
    }
  } with {
      briefly "CMS integration"
    described as {
      |The model's side of the CMS conversation.
    }
  }
  adaptor FromDAM from context DAM is {
    handler FromDAMHandler is {
      on event DAM.AssetUploaded is {
        do "the model receives asset uploaded"
      }
      on event DAM.AssetsFound is {
        do "the model receives assets found"
      }
      on other is {
        error "Unexpected message for adaptor FromDAM"
      }
    } with {
      briefly "from dam"
      described as {
        |Carries messages from the external DAM.
      }
    }
  } with {
      briefly "DAM integration"
    described as {
      |The model's side of the DAM conversation.
    }
  }
  adaptor ToDAM to context DAM is {
    handler ToDAMHandler is {
      on command DAM.SearchAssets is {
        do "the model sends search assets"
      }
      on command DAM.UploadAsset is {
        do "the model sends upload asset"
      }
      on other is {
        error "Unexpected message for adaptor ToDAM"
      }
    } with {
      briefly "to dam"
      described as {
        |Carries messages to the external DAM.
      }
    }
  } with {
      briefly "DAM integration"
    described as {
      |The model's side of the DAM conversation.
    }
  }
  adaptor FromPlagiarismChecker from context PlagiarismChecker is {
    handler FromPlagiarismCheckerHandler is {
      on event PlagiarismChecker.PlagiarismChecked is {
        do "the model receives plagiarism checked"
      }
      on other is {
        error "Unexpected message for adaptor FromPlagiarismChecker"
      }
    } with {
      briefly "from plagiarism checker"
      described as {
        |Carries messages from the external PlagiarismChecker.
      }
    }
  } with {
      briefly "PlagiarismChecker integration"
    described as {
      |The model's side of the PlagiarismChecker conversation.
    }
  }
  adaptor ToPlagiarismChecker to context PlagiarismChecker is {
    handler ToPlagiarismCheckerHandler is {
      on command PlagiarismChecker.CheckPlagiarism is {
        do "the model sends check plagiarism"
      }
      on other is {
        error "Unexpected message for adaptor ToPlagiarismChecker"
      }
    } with {
      briefly "to plagiarism checker"
      described as {
        |Carries messages to the external PlagiarismChecker.
      }
    }
  } with {
      briefly "PlagiarismChecker integration"
    described as {
      |The model's side of the PlagiarismChecker conversation.
    }
  }
  adaptor FromSEOAnalysis from context SEOAnalysis is {
    handler FromSEOAnalysisHandler is {
      on event SEOAnalysis.SEOAnalyzed is {
        do "the model receives seo analyzed"
      }
      on other is {
        error "Unexpected message for adaptor FromSEOAnalysis"
      }
    } with {
      briefly "from seo analysis"
      described as {
        |Carries messages from the external SEOAnalysis.
      }
    }
  } with {
      briefly "SEOAnalysis integration"
    described as {
      |The model's side of the SEOAnalysis conversation.
    }
  }
  adaptor ToSEOAnalysis to context SEOAnalysis is {
    handler ToSEOAnalysisHandler is {
      on command SEOAnalysis.AnalyzeSEO is {
        do "the model sends analyze seo"
      }
      on other is {
        error "Unexpected message for adaptor ToSEOAnalysis"
      }
    } with {
      briefly "to seo analysis"
      described as {
        |Carries messages to the external SEOAnalysis.
      }
    }
  } with {
      briefly "SEOAnalysis integration"
    described as {
      |The model's side of the SEOAnalysis conversation.
    }
  }
  include "types.riddl"
  include "Content.riddl"
  repository ContentRepository is {
    inlet ContentRepositoryFromContent is type ContentEvent
    inlet ContentRepositoryFromContentAnalytics is type ContentEvent
    outlet ContentRepositoryResponses is type Content.ContentResult
    record StoredContent is {
      contentId: ContentId with {
        briefly "contentId"
        described as {
          |The contentId column of the stored content row.
        }
      }
      assignedWriter: String(1,100) with {
        briefly "assignedWriter"
        described as {
          |The assignedWriter column of the stored content row.
        }
      }
      brief: ContentBrief with {
        briefly "brief"
        described as {
          |The brief column of the stored content row.
        }
      }
      category: ContentCategory with {
        briefly "category"
        described as {
          |The category column of the stored content row.
        }
      }
      status: ContentStatus with {
        briefly "status"
        described as {
          |The status column of the stored content row.
        }
      }
    } with {
      briefly "Stored content row"
      described as {
        |The persistence shape of content data as this repository stores it.
      }
    }
    schema ContentData is relational
      of content as type StoredContent
        index on field StoredContent.status
        index on field StoredContent.category
        index on field StoredContent.brief.dueDate
        index on field StoredContent.assignedWriter
      with {
      briefly "Content data schema"
      described as {
        |The relational schema holding content data for the ContentRepository.
      }
    }

    handler ContentPersistence is {
      on query GetContentMetricsAgg is {
        do "read the content metrics agg projection"
        yield result ContentMetricsAggView
      }
      on command Content.CreateContent is {
        tell event Content.ContentCreated to entity ContentContext.Content
        do "Store new content record"
      }
      on command Content.SubmitDraft is {
        tell event Content.DraftSubmitted to entity ContentContext.Content
        do "Store content draft"
      }
      on command Content.AttachMedia is {
        do "Store media attachment"
      }
      on command Content.RequestReview is {
        do "Update to review status"
      }
      on command Content.AddReviewComment is {
        tell event Content.ReviewCommentAdded to entity ContentContext.Content
        do "Store review comment"
      }
      on command Content.SubmitRevision is {
        tell event Content.RevisionSubmitted to entity ContentContext.Content
        do "Store new version"
      }
      on command Content.ApproveContent is {
        tell event Content.ContentApproved to entity ContentContext.Content
        do "Update to approved status"
      }
      on command Content.PublishContent is {
        tell event Content.ContentPublished to entity ContentContext.Content
        do "Update to published status"
      }
      on command Content.UpdateMetrics is {
        tell event Content.MetricsUpdated to entity ContentContext.Content
        do "Store content metrics"
      }
      on command Content.ArchiveContent is {
        do "Archive content record"
      }
    } with {
      briefly "Persists content commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Content data persistence"
    described as {
      |Persistent storage for content.
    }
  }
  query GetContentMetricsAgg is {
    contentMetricsAggKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which content metrics agg to retrieve.
      }
    }
  } with {
    briefly "Get content metrics agg"
    described as {
      |Retrieves the content metrics agg projection.
    }
  }
  result ContentMetricsAggView is {
    contentMetricsAgg: ContentAnalytics.ContentMetricsAgg with {
      briefly "Content metrics agg"
      described as {
        |The content metrics agg being returned.
      }
    }
  } with {
    briefly "Content metrics agg view"
    described as {
      |Read model view carrying the content metrics agg projection.
    }
  }
  projector ContentAnalytics is {
    inlet ContentAnalyticsFromContent is type ContentEvent
    outlet ContentAnalyticsOut is type ContentEvent
    updates repository ContentContext.ContentRepository
    record ContentMetricsAgg is  {
      totalContent: Natural with {
        briefly "Total"
        described as {
          |Total content.
        }
      }
      inProduction: Natural with {
        briefly "Production"
        described as {
          |In production.
        }
      }
      publishedThisMonth: Natural with {
        briefly "Published"
        described as {
          |Published this month.
        }
      }
      averageProductionDays: Decimal(5,1) with {
        briefly "Avg days"
        described as {
          |Avg production time.
        }
      }
      topPerformingCategory: String(1,50) with {
        briefly "Top category"
        described as {
          |Best category.
        }
      }
      totalViews: Natural with {
        briefly "Views"
        described as {
          |Total views.
        }
      }
    } with {
      briefly "Content metrics aggregate"
      described as {
        |Aggregate content metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Content.ContentCreated is {
        tell event Content.ContentCreated to repository ContentContext.ContentRepository
        do "Increment content count"
      }
      on event Content.ContentPublished is {
        tell event Content.ContentPublished to repository ContentContext.ContentRepository
        do "Track publication"
      }
      on event Content.MetricsUpdated is {
        tell event Content.MetricsUpdated to repository ContentContext.ContentRepository
        do "Aggregate performance"
      }
      on event Content.ContentArchived is {
        tell event Content.ContentArchived to repository ContentContext.ContentRepository
        do "Update production stats"
      }
    } with {
      briefly "Maintains content analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Content analytics"
    described as {
      |Content performance tracking.
    }
  }
  // ---- Event publication for Content ----
  type ContentEvent is one of {
    ContentContext.Content.ContentCreated,
    ContentContext.Content.DraftSubmitted,
    ContentContext.Content.MediaAttached,
    ContentContext.Content.ReviewRequested,
    ContentContext.Content.ReviewCommentAdded,
    ContentContext.Content.CommentResolved,
    ContentContext.Content.RevisionRequested,
    ContentContext.Content.RevisionSubmitted,
    ContentContext.Content.ContentApproved,
    ContentContext.Content.PublishScheduled,
    ContentContext.Content.ContentPublished,
    ContentContext.Content.MetricsUpdated,
    ContentContext.Content.ContentArchived
  } with {
    briefly "Content event alternation"
    described as {
      |Union of all Content events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ContentEventSource as source is {
    outlet ContentEvents is type ContentEvent
    handler ContentSourceHandler is {
      on event Content.ContentCreated is {
        send event Content.ContentCreated to outlet ContentEvents
      }
      on event Content.DraftSubmitted is {
        send event Content.DraftSubmitted to outlet ContentEvents
      }
      on event Content.MediaAttached is {
        send event Content.MediaAttached to outlet ContentEvents
      }
      on event Content.ReviewRequested is {
        send event Content.ReviewRequested to outlet ContentEvents
      }
      on event Content.ReviewCommentAdded is {
        send event Content.ReviewCommentAdded to outlet ContentEvents
      }
      on event Content.CommentResolved is {
        send event Content.CommentResolved to outlet ContentEvents
      }
      on event Content.RevisionRequested is {
        send event Content.RevisionRequested to outlet ContentEvents
      }
      on event Content.RevisionSubmitted is {
        send event Content.RevisionSubmitted to outlet ContentEvents
      }
      on event Content.ContentApproved is {
        send event Content.ContentApproved to outlet ContentEvents
      }
      on event Content.PublishScheduled is {
        send event Content.PublishScheduled to outlet ContentEvents
      }
      on event Content.ContentPublished is {
        send event Content.ContentPublished to outlet ContentEvents
      }
      on event Content.MetricsUpdated is {
        send event Content.MetricsUpdated to outlet ContentEvents
      }
      on event Content.ContentArchived is {
        send event Content.ContentArchived to outlet ContentEvents
      }
      on other is {
        error "Unexpected message for source ContentEventSource"
      }
    } with {
      briefly "Content source handler"
      described as {
        |Publishes Content events onto the outlet.
      }
    }
  } with {
    briefly "Content event source"
    described as {
      |Publishes Content entity events into the streaming topology.
    }
  }
  processor ContentEventSink as sink is {
    inlet ContentInlet is type ContentEvent
    handler ContentSinkHandler is {
      on event Content.ContentCreated is {
        tell event Content.ContentCreated to repository ContentContext.ContentRepository
      }
      on event Content.DraftSubmitted is {
        tell event Content.DraftSubmitted to repository ContentContext.ContentRepository
      }
      on event Content.MediaAttached is {
        tell event Content.MediaAttached to repository ContentContext.ContentRepository
      }
      on event Content.ReviewRequested is {
        tell event Content.ReviewRequested to repository ContentContext.ContentRepository
      }
      on event Content.ReviewCommentAdded is {
        tell event Content.ReviewCommentAdded to repository ContentContext.ContentRepository
      }
      on event Content.CommentResolved is {
        tell event Content.CommentResolved to repository ContentContext.ContentRepository
      }
      on event Content.RevisionRequested is {
        tell event Content.RevisionRequested to repository ContentContext.ContentRepository
      }
      on event Content.RevisionSubmitted is {
        tell event Content.RevisionSubmitted to repository ContentContext.ContentRepository
      }
      on event Content.ContentApproved is {
        tell event Content.ContentApproved to repository ContentContext.ContentRepository
      }
      on event Content.PublishScheduled is {
        tell event Content.PublishScheduled to repository ContentContext.ContentRepository
      }
      on event Content.ContentPublished is {
        tell event Content.ContentPublished to repository ContentContext.ContentRepository
      }
      on event Content.MetricsUpdated is {
        tell event Content.MetricsUpdated to repository ContentContext.ContentRepository
      }
      on event Content.ContentArchived is {
        tell event Content.ContentArchived to repository ContentContext.ContentRepository
      }
      on other is {
        error "Unexpected message for sink ContentEventSink"
      }
    } with {
      briefly "Content sink handler"
      described as {
        |Persists Content events via the repository.
      }
    }
  } with {
    briefly "Content event sink"
    described as {
      |Receives Content events for persistence.
    }
  }
  connector ContentEventFlow is {
    from outlet ContentContext.ContentEventSource.ContentEvents to
      inlet ContentContext.ContentEventSink.ContentInlet
  } with {
    briefly "Content event flow"
    described as {
      |Connects the Content source to its sink.
    }
  }
  processor ContentEventSplit is {
    inlet ContentEventSplitIn is type ContentEvent
    outlet ContentEventSplitToContentRepository is type ContentEvent
    outlet ContentEventSplitToContentAnalytics is type ContentEvent
    handler ContentEventSplitHandler is {
      on event Content.ContentCreated is {
        send event Content.ContentCreated to outlet ContentEventSplitToContentRepository
        send event Content.ContentCreated to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentCreated to entity ContentContext.Content
      }
      on event Content.DraftSubmitted is {
        send event Content.DraftSubmitted to outlet ContentEventSplitToContentRepository
        send event Content.DraftSubmitted to outlet ContentEventSplitToContentAnalytics
        tell event Content.DraftSubmitted to entity ContentContext.Content
      }
      on event Content.MediaAttached is {
        send event Content.MediaAttached to outlet ContentEventSplitToContentRepository
        send event Content.MediaAttached to outlet ContentEventSplitToContentAnalytics
        tell event Content.MediaAttached to entity ContentContext.Content
      }
      on event Content.ReviewRequested is {
        send event Content.ReviewRequested to outlet ContentEventSplitToContentRepository
        send event Content.ReviewRequested to outlet ContentEventSplitToContentAnalytics
        tell event Content.ReviewRequested to entity ContentContext.Content
      }
      on event Content.ReviewCommentAdded is {
        send event Content.ReviewCommentAdded to outlet ContentEventSplitToContentRepository
        send event Content.ReviewCommentAdded to outlet ContentEventSplitToContentAnalytics
        tell event Content.ReviewCommentAdded to entity ContentContext.Content
      }
      on event Content.CommentResolved is {
        send event Content.CommentResolved to outlet ContentEventSplitToContentRepository
        send event Content.CommentResolved to outlet ContentEventSplitToContentAnalytics
        tell event Content.CommentResolved to entity ContentContext.Content
      }
      on event Content.RevisionRequested is {
        send event Content.RevisionRequested to outlet ContentEventSplitToContentRepository
        send event Content.RevisionRequested to outlet ContentEventSplitToContentAnalytics
        tell event Content.RevisionRequested to entity ContentContext.Content
      }
      on event Content.RevisionSubmitted is {
        send event Content.RevisionSubmitted to outlet ContentEventSplitToContentRepository
        send event Content.RevisionSubmitted to outlet ContentEventSplitToContentAnalytics
        tell event Content.RevisionSubmitted to entity ContentContext.Content
      }
      on event Content.ContentApproved is {
        send event Content.ContentApproved to outlet ContentEventSplitToContentRepository
        send event Content.ContentApproved to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentApproved to entity ContentContext.Content
      }
      on event Content.PublishScheduled is {
        send event Content.PublishScheduled to outlet ContentEventSplitToContentRepository
        send event Content.PublishScheduled to outlet ContentEventSplitToContentAnalytics
        tell event Content.PublishScheduled to entity ContentContext.Content
      }
      on event Content.ContentPublished is {
        send event Content.ContentPublished to outlet ContentEventSplitToContentRepository
        send event Content.ContentPublished to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentPublished to entity ContentContext.Content
      }
      on event Content.MetricsUpdated is {
        send event Content.MetricsUpdated to outlet ContentEventSplitToContentRepository
        send event Content.MetricsUpdated to outlet ContentEventSplitToContentAnalytics
        tell event Content.MetricsUpdated to entity ContentContext.Content
      }
      on event Content.ContentArchived is {
        send event Content.ContentArchived to outlet ContentEventSplitToContentRepository
        send event Content.ContentArchived to outlet ContentEventSplitToContentAnalytics
        tell event Content.ContentArchived to entity ContentContext.Content
      }
      on other is {
        error "Unexpected message for processor ContentEventSplit"
      }
    } with {
      briefly "Content event fan-out handler"
      described as {
        |Delivers each Content event to all of its consumers.
      }
    }
  } with {
    briefly "Content event fan-out"
    described as {
      |Fans Content events out to the repository and projectors.
    }
  }
  connector LinkContentToContentEventSplit is {
    from outlet ContentContext.Content.ContentEvents2 to
      inlet ContentContext.ContentEventSplit.ContentEventSplitIn
  } with {
    briefly "LinkContentToContentEventSplit"
  }
  connector LinkContentEventSplitToContentRepository is {
    from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentRepository to
      inlet ContentContext.ContentRepository.ContentRepositoryFromContent
  } with {
    briefly "LinkContentEventSplitToContentRepository"
  }
  connector LinkContentEventSplitToContentAnalytics is {
    from outlet ContentContext.ContentEventSplit.ContentEventSplitToContentAnalytics to
      inlet ContentContext.ContentAnalytics.ContentAnalyticsFromContent
  } with {
    briefly "LinkContentEventSplitToContentAnalytics"
  }
  connector LinkContentAnalyticsToContentRepository is {
    from outlet ContentContext.ContentAnalytics.ContentAnalyticsOut to
      inlet ContentContext.ContentRepository.ContentRepositoryFromContentAnalytics
  } with {
    briefly "LinkContentAnalyticsToContentRepository"
  }
} with {
  briefly "Bounded context for content management"
  described as {
    |Marketing content workflow context.
  }
}
