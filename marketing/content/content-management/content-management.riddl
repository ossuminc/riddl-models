// Content Management Domain Model
// Marketing content creation and workflow
domain ContentManagement is {
  persistent connector 'AnalyticsEvent Stream' is from outlet Analytics.AnalyticsEventsOut to inlet ContentContext.FromAnalytics.FromAnalyticsIn with {
    briefly "What Analytics tells ContentContext, unasked"
  }
  persistent connector 'CMSEvent Stream' is from outlet CMS.CMSEventsOut to inlet ContentContext.FromCMS.FromCMSIn with {
    briefly "What CMS tells ContentContext, unasked"
  }
  persistent connector 'DAMEvent Stream' is from outlet DAM.DAMEventsOut to inlet ContentContext.FromDAM.FromDAMIn with {
    briefly "What DAM tells ContentContext, unasked"
  }
  persistent connector 'PlagiarismCheckerEvent Stream' is from outlet PlagiarismChecker.PlagiarismCheckerEventsOut to inlet ContentContext.FromPlagiarismChecker.FromPlagiarismCheckerIn with {
    briefly "What PlagiarismChecker tells ContentContext, unasked"
  }
  persistent connector 'SEOAnalysisEvent Stream' is from outlet SEOAnalysis.SEOAnalysisEventsOut to inlet ContentContext.FromSEOAnalysis.FromSEOAnalysisIn with {
    briefly "What SEOAnalysis tells ContentContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ContentManager is "person overseeing content strategy" with {
    briefly "Content Manager"
    described as {
      |Manages content calendar and strategy.
    }
  }
  user ContentWriter is "person creating written content" with {
    briefly "Content Writer"
    described as {
      |Creates articles and copy.
    }
  }
  user Editor is "person reviewing and approving content" with {
    briefly "Editor"
    described as {
      |Reviews and edits content.
    }
  }
  epic ContentWorkflow is {
    user ContentManager wants to "to manage content production" so that "content is delivered on schedule"
    case CreateContentUseCase is {
      user ContentWriter wants to "to create marketing content" so that "brand messaging reaches the audience"
      step is "Writer drafts" "content" "from brief" with {
        briefly "Draft content"
        described as {
          |Create draft.
        }
      }
      step is "Editor reviews" "and approves" "final version" with {
        briefly "Review content"
        described as {
          |Edit and approve.
        }
      }
    } with {
      briefly "Create content"
      described as {
        |Content creation workflow.
      }
    }
  } with {
    briefly "Content workflow"
    described as {
      |Epic for content management.
    }
  }
  include "ContentContext.riddl"
  include "external-contexts.riddl"
  application context ContentManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ContentManagement are delivered.
      }
    }
    group ContentManagementScreen is {
      input AddReviewCommentInput acquires command ContentContext.Content.AddReviewComment with {
        briefly "Add review comment control"
        described as {
          |The control through which a user submits the add review comment request.
        }
      }
      input ApproveContentInput acquires command ContentContext.Content.ApproveContent with {
        briefly "Approve content control"
        described as {
          |The control through which a user submits the approve content request.
        }
      }
      input ArchiveContentInput acquires command ContentContext.Content.ArchiveContent with {
        briefly "Archive content control"
        described as {
          |The control through which a user submits the archive content request.
        }
      }
      input AttachMediaInput acquires command ContentContext.Content.AttachMedia with {
        briefly "Attach media control"
        described as {
          |The control through which a user submits the attach media request.
        }
      }
      input PublishContentInput acquires command ContentContext.Content.PublishContent with {
        briefly "Publish content control"
        described as {
          |The control through which a user submits the publish content request.
        }
      }
      input RequestReviewInput acquires command ContentContext.Content.RequestReview with {
        briefly "Request review control"
        described as {
          |The control through which a user submits the request review request.
        }
      }
      input RequestRevisionInput acquires command ContentContext.Content.RequestRevision with {
        briefly "Request revision control"
        described as {
          |The control through which a user submits the request revision request.
        }
      }
      input ResolveCommentInput acquires command ContentContext.Content.ResolveComment with {
        briefly "Resolve comment control"
        described as {
          |The control through which a user submits the resolve comment request.
        }
      }
      input SchedulePublishInput acquires command ContentContext.Content.SchedulePublish with {
        briefly "Schedule publish control"
        described as {
          |The control through which a user submits the schedule publish request.
        }
      }
      input SubmitDraftInput acquires command ContentContext.Content.SubmitDraft with {
        briefly "Submit draft control"
        described as {
          |The control through which a user submits the submit draft request.
        }
      }
      input SubmitRevisionInput acquires command ContentContext.Content.SubmitRevision with {
        briefly "Submit revision control"
        described as {
          |The control through which a user submits the submit revision request.
        }
      }
      input CreateContentInput acquires command ContentContext.CreateContent with {
        briefly "Create content control"
        described as {
          |The control through which a user submits the create content request.
        }
      }
    } with {
      briefly "Content management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppContentCommands is type ContentContext.ContentRequest
    inlet AppContentRepositoryResponses is result ContentContext.Content.ContentResult
    handler ContentManagementAppHandler is {
      on other is {
        error "Unexpected message for application context ContentManagementApp"
      }
    } with {
      briefly "ContentManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ContentManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CMSRequest Stream' is from outlet ContentContext.ToCMS.ToCMSOut to inlet CMS.CMSRequests with {
    briefly "What ContentContext asks CMS to send"
  }
  persistent connector 'SEOAnalysisRequest Stream' is from outlet ContentContext.ToSEOAnalysis.ToSEOAnalysisOut to inlet SEOAnalysis.SEOAnalysisRequests with {
    briefly "What ContentContext asks SEOAnalysis to send"
  }
  persistent connector 'PlagiarismCheckerRequest Stream' is from outlet ContentContext.ToPlagiarismChecker.ToPlagiarismCheckerOut to inlet PlagiarismChecker.PlagiarismCheckerRequests with {
    briefly "What ContentContext asks PlagiarismChecker to send"
  }
  persistent connector 'DAMRequest Stream' is from outlet ContentContext.ToDAM.ToDAMOut to inlet DAM.DAMRequests with {
    briefly "What ContentContext asks DAM to send"
  }
  persistent connector 'AnalyticsRequest Stream' is from outlet ContentContext.ToAnalytics.ToAnalyticsOut to inlet Analytics.AnalyticsRequests with {
    briefly "What ContentContext asks Analytics to send"
  }
  persistent connector 'ContentCommand Stream' is from outlet ContentManagementApp.AppContentCommands to inlet ContentContext.ContentCommandStreamIn with {
    briefly "Content commands from the application"
  }
  persistent connector 'ContentResult Stream' is from outlet ContentContext.ContentResultStreamOut to inlet ContentManagementApp.AppContentRepositoryResponses with {
    briefly "Content query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ContentManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Content management domain"
  described as {
    |Marketing content creation and workflow.
  }
}
