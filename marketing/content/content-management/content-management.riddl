// Content Management Domain Model
// Marketing content creation and workflow
domain ContentManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ContentManager is "person overseeing content strategy" with {
    briefly "Content Manager"
    described as {
      |Manages content calendar and strategy.
    }
  }
  user ContentWriter is "person creating written content" with {
    briefly "Content Writer"
    described as {
      |Creates articles and copy.
    }
  }
  user Editor is "person reviewing and approving content" with {
    briefly "Editor"
    described as {
      |Reviews and edits content.
    }
  }
  epic ContentWorkflow is {
    user ContentManager wants to "to manage content production" so that "content is delivered on schedule"
    case CreateContentUseCase is {
      user ContentWriter wants to "to create marketing content" so that "brand messaging reaches the audience"
      step is "Writer drafts" "content" "from brief" with {
        briefly "Draft content"
        described as {
          |Create draft.
        }
      }
      step is "Editor reviews" "and approves" "final version" with {
        briefly "Review content"
        described as {
          |Edit and approve.
        }
      }
    } with {
      briefly "Create content"
      described as {
        |Content creation workflow.
      }
    }
  } with {
    briefly "Content workflow"
    described as {
      |Epic for content management.
    }
  }
  include "ContentContext.riddl"
  include "external-contexts.riddl"
  application context ContentManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in ContentManagement are delivered.
      }
    }
    outlet AppContentCommands is type ContentContext.Content.ContentCommand
    inlet AppContentRepositoryResponses is type ContentContext.Content.ContentResult    handler ContentManagementAppHandler is {
      on other is {
        error "Unexpected message for application context ContentManagementApp"
      }
    } with {
      briefly "ContentManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "ContentManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ContentCommand Stream' is from outlet ContentManagementApp.AppContentCommands to inlet ContentContext.Content.ContentCommands with {
    briefly "Content commands from the application"
  }
  persistent connector 'ContentResult Stream' is from outlet ContentContext.ContentRepository.ContentRepositoryResponses to inlet ContentManagementApp.AppContentRepositoryResponses with {
    briefly "Content query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet ContentManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Content management domain"
  described as {
    |Marketing content creation and workflow.
  }
}
