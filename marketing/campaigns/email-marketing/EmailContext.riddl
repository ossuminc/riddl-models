// Email Marketing - Email Context
context EmailContext is {
  include "types.riddl"
  include "EmailCampaign.riddl"
  repository EmailRepository is {
    schema CampaignData is relational
      of campaigns as type EmailCampaign
        index on field EmailCampaign.status
        index on field EmailCampaign.campaignType
        index on field EmailCampaign.createdAt

    handler CampaignPersistence is {
      on command EmailCampaign.CreateCampaign is {
        tell event EmailCampaign.CampaignCreated to entity EmailContext.EmailCampaign
        prompt "Store new campaign record"
      }
      on command EmailCampaign.SetAudience is {
        prompt "Store audience configuration"
      }
      on command EmailCampaign.UpdateTemplate is {
        tell event EmailCampaign.TemplateUpdated to entity EmailContext.EmailCampaign
        prompt "Update email template"
      }
      on command EmailCampaign.ScheduleCampaign is {
        tell event EmailCampaign.CampaignScheduled to entity EmailContext.EmailCampaign
        prompt "Store schedule information"
      }
      on command EmailCampaign.SendImmediately is {
        prompt "Update status to sending"
      }
      on command EmailCampaign.RecordDelivery is {
        tell event EmailCampaign.DeliveryRecorded to entity EmailContext.EmailCampaign
        prompt "Store delivery metrics"
      }
      on command EmailCampaign.RecordEngagement is {
        tell event EmailCampaign.EngagementRecorded to entity EmailContext.EmailCampaign
        prompt "Store engagement event"
      }
      on command EmailCampaign.CompleteCampaign is {
        tell event EmailCampaign.CampaignCompleted to entity EmailContext.EmailCampaign
        prompt "Archive completed campaign"
      }
    } with {
      briefly "Persists campaign commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Email data persistence"
    described as {
      |Persistent storage for campaigns.
    }
  }
  projector CampaignAnalytics is {
    updates repository EmailContext.EmailRepository
    record EmailMetrics is  {
      totalCampaigns: Natural with {
        briefly "Total"
        described as {
          |Total campaigns.
        }
      }
      activeCampaigns: Natural with {
        briefly "Active"
        described as {
          |Active campaigns.
        }
      }
      averageOpenRate: Decimal(5,2) with {
        briefly "Open rate"
        described as {
          |Avg open rate.
        }
      }
      averageClickRate: Decimal(5,2) with {
        briefly "Click rate"
        described as {
          |Avg click rate.
        }
      }
      totalSent: Natural with {
        briefly "Sent"
        described as {
          |Total emails sent.
        }
      }
      totalOpened: Natural with {
        briefly "Opened"
        described as {
          |Total opens.
        }
      }
    } with {
      briefly "Email metrics"
      described as {
        |Email marketing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event EmailCampaign.CampaignCreated is {
        tell event EmailCampaign.CampaignCreated to repository EmailContext.EmailRepository
        prompt "Increment campaign count"
      }
      on event EmailCampaign.CampaignSending is {
        tell event EmailCampaign.CampaignSending to repository EmailContext.EmailRepository
        prompt "Track active campaigns"
      }
      on event EmailCampaign.DeliveryRecorded is {
        tell event EmailCampaign.DeliveryRecorded to repository EmailContext.EmailRepository
        prompt "Update delivery totals"
      }
      on event EmailCampaign.CampaignCompleted is {
        tell event EmailCampaign.CampaignCompleted to repository EmailContext.EmailRepository
        prompt "Calculate campaign performance"
      }
    } with {
      briefly "Maintains email analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Campaign analytics"
    described as {
      |Email marketing performance.
    }
  }
  // ---- Event publication for EmailCampaign ----
  type EmailCampaignEvent is one of {
    EmailContext.EmailCampaign.CampaignCreated,
    EmailContext.EmailCampaign.AudienceSet,
    EmailContext.EmailCampaign.TemplateUpdated,
    EmailContext.EmailCampaign.ABTestConfigured,
    EmailContext.EmailCampaign.CampaignScheduled,
    EmailContext.EmailCampaign.CampaignSending,
    EmailContext.EmailCampaign.CampaignPaused,
    EmailContext.EmailCampaign.CampaignResumed,
    EmailContext.EmailCampaign.CampaignCancelled,
    EmailContext.EmailCampaign.DeliveryRecorded,
    EmailContext.EmailCampaign.EngagementRecorded,
    EmailContext.EmailCampaign.CampaignCompleted
  } with {
    briefly "EmailCampaign event alternation"
    described as {
      |Union of all EmailCampaign events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EmailCampaignEventSource as source is {
    outlet EmailCampaignEvents is type EmailCampaignEvent
    handler EmailCampaignSourceHandler is {
      on event EmailCampaign.CampaignCreated is {
        send event EmailCampaign.CampaignCreated to outlet EmailCampaignEvents
      }
      on event EmailCampaign.AudienceSet is {
        send event EmailCampaign.AudienceSet to outlet EmailCampaignEvents
      }
      on event EmailCampaign.TemplateUpdated is {
        send event EmailCampaign.TemplateUpdated to outlet EmailCampaignEvents
      }
      on event EmailCampaign.ABTestConfigured is {
        send event EmailCampaign.ABTestConfigured to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignScheduled is {
        send event EmailCampaign.CampaignScheduled to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignSending is {
        send event EmailCampaign.CampaignSending to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignPaused is {
        send event EmailCampaign.CampaignPaused to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignResumed is {
        send event EmailCampaign.CampaignResumed to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignCancelled is {
        send event EmailCampaign.CampaignCancelled to outlet EmailCampaignEvents
      }
      on event EmailCampaign.DeliveryRecorded is {
        send event EmailCampaign.DeliveryRecorded to outlet EmailCampaignEvents
      }
      on event EmailCampaign.EngagementRecorded is {
        send event EmailCampaign.EngagementRecorded to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignCompleted is {
        send event EmailCampaign.CampaignCompleted to outlet EmailCampaignEvents
      }
      on other is {
        error "Unexpected message for source EmailCampaignEventSource"
      }
    } with {
      briefly "EmailCampaign source handler"
      described as {
        |Publishes EmailCampaign events onto the outlet.
      }
    }
  } with {
    briefly "EmailCampaign event source"
    described as {
      |Publishes EmailCampaign entity events into the streaming topology.
    }
  }
  processor EmailCampaignEventSink as sink is {
    inlet EmailCampaignInlet is type EmailCampaignEvent
    handler EmailCampaignSinkHandler is {
      on event EmailCampaign.CampaignCreated is {
        tell event EmailCampaign.CampaignCreated to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.AudienceSet is {
        tell event EmailCampaign.AudienceSet to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.TemplateUpdated is {
        tell event EmailCampaign.TemplateUpdated to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.ABTestConfigured is {
        tell event EmailCampaign.ABTestConfigured to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignScheduled is {
        tell event EmailCampaign.CampaignScheduled to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignSending is {
        tell event EmailCampaign.CampaignSending to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignPaused is {
        tell event EmailCampaign.CampaignPaused to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignResumed is {
        tell event EmailCampaign.CampaignResumed to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignCancelled is {
        tell event EmailCampaign.CampaignCancelled to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.DeliveryRecorded is {
        tell event EmailCampaign.DeliveryRecorded to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.EngagementRecorded is {
        tell event EmailCampaign.EngagementRecorded to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignCompleted is {
        tell event EmailCampaign.CampaignCompleted to repository EmailContext.EmailRepository
      }
      on other is {
        error "Unexpected message for sink EmailCampaignEventSink"
      }
    } with {
      briefly "EmailCampaign sink handler"
      described as {
        |Persists EmailCampaign events via the repository.
      }
    }
  } with {
    briefly "EmailCampaign event sink"
    described as {
      |Receives EmailCampaign events for persistence.
    }
  }
  connector EmailCampaignEventFlow is {
    from outlet EmailContext.EmailCampaignEventSource.EmailCampaignEvents to
      inlet EmailContext.EmailCampaignEventSink.EmailCampaignInlet
  } with {
    briefly "EmailCampaign event flow"
    described as {
      |Connects the EmailCampaign source to its sink.
    }
  }
} with {
  briefly "Bounded context for email marketing"
  described as {
    |Email campaign management context.
  }
}
