// Email Marketing - Email Context
context EmailContext as router is {
  inlet EmailCampaignCommandStreamIn is type EmailCampaignCommand  outlet EmailCampaignCommandStreamOut is type EmailCampaignCommand
  inlet EmailCampaignResultStreamIn is result EmailCampaign.EmailCampaignResult  outlet EmailCampaignResultStreamOut is result EmailCampaign.EmailCampaignResult
  handler EmailContextBoundary is {
    on createCampaign: command EmailCampaign.CreateCampaign is {
      send createCampaign to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on setAudience: command EmailCampaign.SetAudience is {
      send setAudience to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on updateTemplate: command EmailCampaign.UpdateTemplate is {
      send updateTemplate to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on configureABTest: command EmailCampaign.ConfigureABTest is {
      send configureABTest to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on scheduleCampaign: command EmailCampaign.ScheduleCampaign is {
      send scheduleCampaign to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on sendImmediately: command EmailCampaign.SendImmediately is {
      send sendImmediately to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on pauseCampaign: command EmailCampaign.PauseCampaign is {
      send pauseCampaign to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on resumeCampaign: command EmailCampaign.ResumeCampaign is {
      send resumeCampaign to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on cancelCampaign: command EmailCampaign.CancelCampaign is {
      send cancelCampaign to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on recordDelivery: command EmailCampaign.RecordDelivery is {
      send recordDelivery to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on recordEngagement: command EmailCampaign.RecordEngagement is {
      send recordEngagement to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on completeCampaign: command EmailCampaign.CompleteCampaign is {
      send completeCampaign to outlet EmailContext.EmailCampaignCommandStreamOut
    }
    on emailCampaignResult: result EmailCampaign.EmailCampaignResult is {
      send emailCampaignResult to outlet EmailContext.EmailCampaignResultStreamOut
    }
    on other is {
      error "Unexpected message at the EmailContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EmailCampaignCommand Stream Intake' is from outlet EmailContext.EmailCampaignCommandStreamOut to inlet EmailContext.EmailCampaign.EmailCampaignCommands  connector 'EmailCampaignResult Stream Egress' is from outlet EmailContext.EmailRepository.EmailRepositoryResponses to inlet EmailContext.EmailCampaignResultStreamIn  adaptor FromEmailDeliveryService from context EmailDeliveryService is { 
    handler FromEmailDeliveryServiceHandler is {
      on event EmailDeliveryService.EmailBounced is {
        do "the model receives email bounced"
      }
      on event EmailDeliveryService.EmailOpened is {
        do "the model receives email opened"
      }
      on event EmailDeliveryService.EmailSent is {
        do "the model receives email sent"
      }
      on event EmailDeliveryService.LinkClicked is {
        do "the model receives link clicked"
      }
      on other is {
        error "Unexpected message for adaptor FromEmailDeliveryService"
      }
    } with {
      briefly "from email delivery service"
      described as {
        |Carries messages from the external EmailDeliveryService.
      }
    }
  } with {
    briefly "EmailDeliveryService integration"
    described as {
      |The model's side of the EmailDeliveryService conversation.
    }
  }
  adaptor ToEmailDeliveryService to context EmailDeliveryService is { 
    handler ToEmailDeliveryServiceHandler is {
      on command EmailDeliveryService.SendEmail is {
        do "the model sends send email"
      }
      on other is {
        error "Unexpected message for adaptor ToEmailDeliveryService"
      }
    } with {
      briefly "to email delivery service"
      described as {
        |Carries messages to the external EmailDeliveryService.
      }
    }
  } with {
    briefly "EmailDeliveryService integration"
    described as {
      |The model's side of the EmailDeliveryService conversation.
    }
  }
  adaptor FromListManagement from context ListManagement is { 
    handler FromListManagementHandler is {
      on event ListManagement.SubscriberUnsubscribed is {
        do "the model receives subscriber unsubscribed"
      }
      on event ListManagement.SubscribersRetrieved is {
        do "the model receives subscribers retrieved"
      }
      on other is {
        error "Unexpected message for adaptor FromListManagement"
      }
    } with {
      briefly "from list management"
      described as {
        |Carries messages from the external ListManagement.
      }
    }
  } with {
    briefly "ListManagement integration"
    described as {
      |The model's side of the ListManagement conversation.
    }
  }
  adaptor ToListManagement to context ListManagement is { 
    handler ToListManagementHandler is {
      on command ListManagement.GetListSubscribers is {
        do "the model sends get list subscribers"
      }
      on command ListManagement.ProcessUnsubscribe is {
        do "the model sends process unsubscribe"
      }
      on other is {
        error "Unexpected message for adaptor ToListManagement"
      }
    } with {
      briefly "to list management"
      described as {
        |Carries messages to the external ListManagement.
      }
    }
  } with {
    briefly "ListManagement integration"
    described as {
      |The model's side of the ListManagement conversation.
    }
  }
  adaptor FromSpamChecker from context SpamChecker is { 
    handler FromSpamCheckerHandler is {
      on event SpamChecker.SpamScoreCalculated is {
        do "the model receives spam score calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromSpamChecker"
      }
    } with {
      briefly "from spam checker"
      described as {
        |Carries messages from the external SpamChecker.
      }
    }
  } with {
    briefly "SpamChecker integration"
    described as {
      |The model's side of the SpamChecker conversation.
    }
  }
  adaptor ToSpamChecker to context SpamChecker is { 
    handler ToSpamCheckerHandler is {
      on command SpamChecker.CheckSpamScore is {
        do "the model sends check spam score"
      }
      on other is {
        error "Unexpected message for adaptor ToSpamChecker"
      }
    } with {
      briefly "to spam checker"
      described as {
        |Carries messages to the external SpamChecker.
      }
    }
  } with {
    briefly "SpamChecker integration"
    described as {
      |The model's side of the SpamChecker conversation.
    }
  }
  adaptor FromTemplateRenderer from context TemplateRenderer is { 
    handler FromTemplateRendererHandler is {
      on event TemplateRenderer.TemplateRendered is {
        do "the model receives template rendered"
      }
      on event TemplateRenderer.TemplateValidated is {
        do "the model receives template validated"
      }
      on other is {
        error "Unexpected message for adaptor FromTemplateRenderer"
      }
    } with {
      briefly "from template renderer"
      described as {
        |Carries messages from the external TemplateRenderer.
      }
    }
  } with {
    briefly "TemplateRenderer integration"
    described as {
      |The model's side of the TemplateRenderer conversation.
    }
  }
  adaptor ToTemplateRenderer to context TemplateRenderer is { 
    handler ToTemplateRendererHandler is {
      on command TemplateRenderer.RenderTemplate is {
        do "the model sends render template"
      }
      on command TemplateRenderer.ValidateTemplate is {
        do "the model sends validate template"
      }
      on other is {
        error "Unexpected message for adaptor ToTemplateRenderer"
      }
    } with {
      briefly "to template renderer"
      described as {
        |Carries messages to the external TemplateRenderer.
      }
    }
  } with {
    briefly "TemplateRenderer integration"
    described as {
      |The model's side of the TemplateRenderer conversation.
    }
  }
  include "types.riddl"
  include "EmailCampaign.riddl"
  type EmailRepositoryCommand is one of {
    EmailContext.EmailRepository.PersistABTestConfigured or EmailContext.EmailRepository.PersistAudienceSet or EmailContext.EmailRepository.PersistCampaignCancelled or EmailContext.EmailRepository.PersistCampaignCompleted or EmailContext.EmailRepository.PersistCampaignCreated or EmailContext.EmailRepository.PersistCampaignPaused or EmailContext.EmailRepository.PersistCampaignResumed or EmailContext.EmailRepository.PersistCampaignScheduled or EmailContext.EmailRepository.PersistCampaignSending or EmailContext.EmailRepository.PersistDeliveryRecorded or EmailContext.EmailRepository.PersistEngagementRecorded or EmailContext.EmailRepository.PersistTemplateUpdated
  } with {
    briefly "Anything that writes EmailRepository"
    described as {
      |The persistence commands EmailRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository EmailRepository as flow is {
    inlet EmailRepositoryFromCampaignAnalytics is type EmailRepositoryCommand    command PersistABTestConfigured is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row ABTestConfigured applies to.
        }
      }
    } with {
      briefly "Persist ABTestConfigured"
      described as {
        |Instructs this repository to apply ABTestConfigured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistAudienceSet is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row AudienceSet applies to.
        }
      }
    } with {
      briefly "Persist AudienceSet"
      described as {
        |Instructs this repository to apply AudienceSet to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignCancelled is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignCancelled applies to.
        }
      }
    } with {
      briefly "Persist CampaignCancelled"
      described as {
        |Instructs this repository to apply CampaignCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignPaused is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignPaused applies to.
        }
      }
    } with {
      briefly "Persist CampaignPaused"
      described as {
        |Instructs this repository to apply CampaignPaused to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignResumed is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignResumed applies to.
        }
      }
    } with {
      briefly "Persist CampaignResumed"
      described as {
        |Instructs this repository to apply CampaignResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignScheduled is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignScheduled applies to.
        }
      }
    } with {
      briefly "Persist CampaignScheduled"
      described as {
        |Instructs this repository to apply CampaignScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementRecorded is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementRecorded applies to.
        }
      }
    } with {
      briefly "Persist EngagementRecorded"
      described as {
        |Instructs this repository to apply EngagementRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTemplateUpdated is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row TemplateUpdated applies to.
        }
      }
    } with {
      briefly "Persist TemplateUpdated"
      described as {
        |Instructs this repository to apply TemplateUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignCompleted is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignCompleted applies to.
        }
      }
    } with {
      briefly "Persist CampaignCompleted"
      described as {
        |Instructs this repository to apply CampaignCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignCreated is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignCreated applies to.
        }
      }
    } with {
      briefly "Persist CampaignCreated"
      described as {
        |Instructs this repository to apply CampaignCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignSending is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignSending applies to.
        }
      }
    } with {
      briefly "Persist CampaignSending"
      described as {
        |Instructs this repository to apply CampaignSending to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliveryRecorded is {
      campaignId: EmailCampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliveryRecorded applies to.
        }
      }
    } with {
      briefly "Persist DeliveryRecorded"
      described as {
        |Instructs this repository to apply DeliveryRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet EmailRepositoryResponses is result EmailCampaign.EmailCampaignResult
    record StoredEmailCampaign is {
      emailCampaignId: EmailCampaignId with {
        briefly "emailCampaignId"
        described as {
          |The emailCampaignId column of the stored emailCampaign row.
        }
      }
      campaignType: CampaignType with {
        briefly "campaignType"
        described as {
          |The campaignType column of the stored emailCampaign row.
        }
      }
      createdAt: TimeStamp with {
        briefly "createdAt"
        described as {
          |The createdAt column of the stored emailCampaign row.
        }
      }
      status: CampaignStatus with {
        briefly "status"
        described as {
          |The status column of the stored emailCampaign row.
        }
      }
    } with {
      briefly "Stored emailCampaign row"
      described as {
        |The persistence shape of emailCampaign data as this repository stores it.
      }
    }
    schema CampaignData is relational
      of campaigns as record StoredEmailCampaign
        index on field StoredEmailCampaign.status
        index on field StoredEmailCampaign.campaignType
        index on field StoredEmailCampaign.createdAt
 with {
      briefly "Campaign data schema"
      described as {
        |The relational schema holding campaign data for the EmailRepository.
      }
    }
    handler CampaignPersistence is {
      on persistABTestConfigured: command PersistABTestConfigured is {
        do "apply ABTestConfigured to the stored row"
      }
      on persistAudienceSet: command PersistAudienceSet is {
        do "apply AudienceSet to the stored row"
      }
      on persistCampaignCancelled: command PersistCampaignCancelled is {
        do "apply CampaignCancelled to the stored row"
      }
      on persistCampaignPaused: command PersistCampaignPaused is {
        do "apply CampaignPaused to the stored row"
      }
      on persistCampaignResumed: command PersistCampaignResumed is {
        do "apply CampaignResumed to the stored row"
      }
      on persistCampaignScheduled: command PersistCampaignScheduled is {
        do "apply CampaignScheduled to the stored row"
      }
      on persistEngagementRecorded: command PersistEngagementRecorded is {
        do "apply EngagementRecorded to the stored row"
      }
      on persistTemplateUpdated: command PersistTemplateUpdated is {
        do "apply TemplateUpdated to the stored row"
      }
      on persistCampaignCompleted: command PersistCampaignCompleted is {
        do "apply CampaignCompleted to the stored row"
      }
      on persistCampaignCreated: command PersistCampaignCreated is {
        do "apply CampaignCreated to the stored row"
      }
      on persistCampaignSending: command PersistCampaignSending is {
        do "apply CampaignSending to the stored row"
      }
      on persistDeliveryRecorded: command PersistDeliveryRecorded is {
        do "apply DeliveryRecorded to the stored row"
      }
      on query GetEmailMetrics is {
        let emailMetricsView: type EmailMetricsView = prompt("read the email metrics projection")
        reply emailMetricsView
      }
    } with {
      briefly "Persists campaign commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Email data persistence"
    described as {
      |Persistent storage for campaigns.
    }
  }
  query GetEmailMetrics replies result EmailMetricsView is {
    emailMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which email metrics to retrieve.
      }
    }
  } with {
    briefly "Get email metrics"
    described as {
      |Retrieves the email metrics projection.
    }
  }
  result EmailMetricsView is {
    emailMetrics: CampaignAnalytics.EmailMetrics with {
      briefly "Email metrics"
      described as {
        |The email metrics being returned.
      }
    }
  } with {
    briefly "Email metrics view"
    described as {
      |Read model view carrying the email metrics projection.
    }
  }
  projector CampaignAnalytics as flow is {
    updates repository EmailContext.EmailRepository
    outlet CampaignAnalyticsToRepository is type EmailRepositoryCommand
    inlet CampaignAnalyticsFromEmailCampaign is type EmailCampaignEvent    record EmailMetrics is {
      totalCampaigns: Natural with {
        briefly "Total"
        described as {
          |Total campaigns.
        }
      }
      activeCampaigns: Natural with {
        briefly "Active"
        described as {
          |Active campaigns.
        }
      }
      averageOpenRate: Decimal(5,2) with {
        briefly "Open rate"
        described as {
          |Avg open rate.
        }
      }
      averageClickRate: Decimal(5,2) with {
        briefly "Click rate"
        described as {
          |Avg click rate.
        }
      }
      totalSent: Natural with {
        briefly "Sent"
        described as {
          |Total emails sent.
        }
      }
      totalOpened: Natural with {
        briefly "Opened"
        described as {
          |Total opens.
        }
      }
    } with {
      briefly "Email metrics"
      described as {
        |Email marketing metrics.
      }
    }
    handler AnalyticsHandler is {
      on aBTestConfigured: event EmailCampaign.ABTestConfigured is {
        tell command EmailContext.EmailRepository.PersistABTestConfigured(campaignId = aBTestConfigured.campaignId) to repository EmailContext.EmailRepository
        do "apply ABTestConfigured to the CampaignAnalytics projection"
      }
      on audienceSet: event EmailCampaign.AudienceSet is {
        tell command EmailContext.EmailRepository.PersistAudienceSet(campaignId = audienceSet.campaignId) to repository EmailContext.EmailRepository
        do "apply AudienceSet to the CampaignAnalytics projection"
      }
      on campaignCancelled: event EmailCampaign.CampaignCancelled is {
        tell command EmailContext.EmailRepository.PersistCampaignCancelled(campaignId = campaignCancelled.campaignId) to repository EmailContext.EmailRepository
        do "apply CampaignCancelled to the CampaignAnalytics projection"
      }
      on campaignPaused: event EmailCampaign.CampaignPaused is {
        tell command EmailContext.EmailRepository.PersistCampaignPaused(campaignId = campaignPaused.campaignId) to repository EmailContext.EmailRepository
        do "apply CampaignPaused to the CampaignAnalytics projection"
      }
      on campaignResumed: event EmailCampaign.CampaignResumed is {
        tell command EmailContext.EmailRepository.PersistCampaignResumed(campaignId = campaignResumed.campaignId) to repository EmailContext.EmailRepository
        do "apply CampaignResumed to the CampaignAnalytics projection"
      }
      on campaignScheduled: event EmailCampaign.CampaignScheduled is {
        tell command EmailContext.EmailRepository.PersistCampaignScheduled(campaignId = campaignScheduled.campaignId) to repository EmailContext.EmailRepository
        do "apply CampaignScheduled to the CampaignAnalytics projection"
      }
      on engagementRecorded: event EmailCampaign.EngagementRecorded is {
        tell command EmailContext.EmailRepository.PersistEngagementRecorded(campaignId = engagementRecorded.campaignId) to repository EmailContext.EmailRepository
        do "apply EngagementRecorded to the CampaignAnalytics projection"
      }
      on templateUpdated: event EmailCampaign.TemplateUpdated is {
        tell command EmailContext.EmailRepository.PersistTemplateUpdated(campaignId = templateUpdated.campaignId) to repository EmailContext.EmailRepository
        do "apply TemplateUpdated to the CampaignAnalytics projection"
      }
      on campaignCreated: event EmailCampaign.CampaignCreated is {
        tell command EmailContext.EmailRepository.PersistCampaignCreated(campaignId = campaignCreated.campaignId) to repository EmailContext.EmailRepository
        do "Increment campaign count"
      }
      on campaignSending: event EmailCampaign.CampaignSending is {
        tell command EmailContext.EmailRepository.PersistCampaignSending(campaignId = campaignSending.campaignId) to repository EmailContext.EmailRepository
        do "Track active campaigns"
      }
      on deliveryRecorded: event EmailCampaign.DeliveryRecorded is {
        tell command EmailContext.EmailRepository.PersistDeliveryRecorded(campaignId = deliveryRecorded.campaignId) to repository EmailContext.EmailRepository
        do "Update delivery totals"
      }
      on campaignCompleted: event EmailCampaign.CampaignCompleted is {
        tell command EmailContext.EmailRepository.PersistCampaignCompleted(campaignId = campaignCompleted.campaignId) to repository EmailContext.EmailRepository
        do "Calculate campaign performance"
      }
    } with {
      briefly "Maintains email analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Campaign analytics"
    described as {
      |Email marketing performance.
    }
  }
  // ---- Event publication for EmailCampaign ----
  type EmailCampaignEvent is one of {
    EmailContext.EmailCampaign.CampaignCreated or EmailContext.EmailCampaign.AudienceSet or EmailContext.EmailCampaign.TemplateUpdated or EmailContext.EmailCampaign.ABTestConfigured or EmailContext.EmailCampaign.CampaignScheduled or EmailContext.EmailCampaign.CampaignSending or EmailContext.EmailCampaign.CampaignPaused or EmailContext.EmailCampaign.CampaignResumed or EmailContext.EmailCampaign.CampaignCancelled or EmailContext.EmailCampaign.DeliveryRecorded or EmailContext.EmailCampaign.EngagementRecorded or EmailContext.EmailCampaign.CampaignCompleted
  } with {
    briefly "EmailCampaign event alternation"
    described as {
      |Union of all EmailCampaign events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EmailCampaignEventSplit as flow is {
    inlet EmailCampaignEventSplitIn is type EmailCampaignEvent    outlet EmailCampaignEventSplitToCampaignAnalytics is type EmailCampaignEvent
    handler EmailCampaignEventSplitHandler is {
      on campaignCreated: event EmailCampaign.CampaignCreated is {
        send campaignCreated to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell campaignCreated to entity EmailContext.EmailCampaign
      }
      on audienceSet: event EmailCampaign.AudienceSet is {
        send audienceSet to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell audienceSet to entity EmailContext.EmailCampaign
      }
      on templateUpdated: event EmailCampaign.TemplateUpdated is {
        send templateUpdated to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell templateUpdated to entity EmailContext.EmailCampaign
      }
      on aBTestConfigured: event EmailCampaign.ABTestConfigured is {
        send aBTestConfigured to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell aBTestConfigured to entity EmailContext.EmailCampaign
      }
      on campaignScheduled: event EmailCampaign.CampaignScheduled is {
        send campaignScheduled to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell campaignScheduled to entity EmailContext.EmailCampaign
      }
      on campaignSending: event EmailCampaign.CampaignSending is {
        send campaignSending to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell campaignSending to entity EmailContext.EmailCampaign
      }
      on campaignPaused: event EmailCampaign.CampaignPaused is {
        send campaignPaused to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell campaignPaused to entity EmailContext.EmailCampaign
      }
      on campaignResumed: event EmailCampaign.CampaignResumed is {
        send campaignResumed to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell campaignResumed to entity EmailContext.EmailCampaign
      }
      on campaignCancelled: event EmailCampaign.CampaignCancelled is {
        send campaignCancelled to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell campaignCancelled to entity EmailContext.EmailCampaign
      }
      on deliveryRecorded: event EmailCampaign.DeliveryRecorded is {
        send deliveryRecorded to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell deliveryRecorded to entity EmailContext.EmailCampaign
      }
      on engagementRecorded: event EmailCampaign.EngagementRecorded is {
        send engagementRecorded to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell engagementRecorded to entity EmailContext.EmailCampaign
      }
      on campaignCompleted: event EmailCampaign.CampaignCompleted is {
        send campaignCompleted to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell campaignCompleted to entity EmailContext.EmailCampaign
      }
      on other is {
        error "Unexpected message for processor EmailCampaignEventSplit"
      }
    } with {
      briefly "EmailCampaign event fan-out handler"
      described as {
        |Delivers each EmailCampaign event to all of its consumers.
      }
    }
  } with {
    briefly "EmailCampaign event fan-out"
    described as {
      |Fans EmailCampaign events out to the repository and projectors.
    }
  }
  connector 'EmailCampaignEvent Stream' is from outlet EmailContext.EmailCampaign.EmailCampaignEvents2 to inlet EmailContext.EmailCampaignEventSplit.EmailCampaignEventSplitIn with {
    briefly "EmailCampaign events, fanned out to storage and read models"
  }
  connector 'CampaignAnalytics Feed' is from outlet EmailContext.EmailCampaignEventSplit.EmailCampaignEventSplitToCampaignAnalytics to inlet EmailContext.CampaignAnalytics.CampaignAnalyticsFromEmailCampaign with {
    briefly "EmailCampaign events feeding the CampaignAnalytics projection"
  }
  connector 'CampaignAnalytics Storage' is from outlet EmailContext.CampaignAnalytics.CampaignAnalyticsToRepository to inlet EmailContext.EmailRepository.EmailRepositoryFromCampaignAnalytics with {
    briefly "CampaignAnalytics updates on their way to storage"
  }
} with {
