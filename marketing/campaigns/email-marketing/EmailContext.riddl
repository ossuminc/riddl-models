// Email Marketing - Email Context
context EmailContext is {
  adaptor FromEmailDeliveryService from context EmailDeliveryService is { 
    handler FromEmailDeliveryServiceHandler is {
      on event EmailDeliveryService.EmailBounced is {
        do "the model receives email bounced"
      }
      on event EmailDeliveryService.EmailOpened is {
        do "the model receives email opened"
      }
      on event EmailDeliveryService.EmailSent is {
        do "the model receives email sent"
      }
      on event EmailDeliveryService.LinkClicked is {
        do "the model receives link clicked"
      }
      on other is {
        error "Unexpected message for adaptor FromEmailDeliveryService"
      }
    } with {
      briefly "from email delivery service"
      described as {
        |Carries messages from the external EmailDeliveryService.
      }
    }
  } with {
    briefly "EmailDeliveryService integration"
    described as {
      |The model's side of the EmailDeliveryService conversation.
    }
  }
  adaptor ToEmailDeliveryService to context EmailDeliveryService is { 
    handler ToEmailDeliveryServiceHandler is {
      on command EmailDeliveryService.SendEmail is {
        do "the model sends send email"
      }
      on other is {
        error "Unexpected message for adaptor ToEmailDeliveryService"
      }
    } with {
      briefly "to email delivery service"
      described as {
        |Carries messages to the external EmailDeliveryService.
      }
    }
  } with {
    briefly "EmailDeliveryService integration"
    described as {
      |The model's side of the EmailDeliveryService conversation.
    }
  }
  adaptor FromListManagement from context ListManagement is { 
    handler FromListManagementHandler is {
      on event ListManagement.SubscriberUnsubscribed is {
        do "the model receives subscriber unsubscribed"
      }
      on event ListManagement.SubscribersRetrieved is {
        do "the model receives subscribers retrieved"
      }
      on other is {
        error "Unexpected message for adaptor FromListManagement"
      }
    } with {
      briefly "from list management"
      described as {
        |Carries messages from the external ListManagement.
      }
    }
  } with {
    briefly "ListManagement integration"
    described as {
      |The model's side of the ListManagement conversation.
    }
  }
  adaptor ToListManagement to context ListManagement is { 
    handler ToListManagementHandler is {
      on command ListManagement.GetListSubscribers is {
        do "the model sends get list subscribers"
      }
      on command ListManagement.ProcessUnsubscribe is {
        do "the model sends process unsubscribe"
      }
      on other is {
        error "Unexpected message for adaptor ToListManagement"
      }
    } with {
      briefly "to list management"
      described as {
        |Carries messages to the external ListManagement.
      }
    }
  } with {
    briefly "ListManagement integration"
    described as {
      |The model's side of the ListManagement conversation.
    }
  }
  adaptor FromSpamChecker from context SpamChecker is { 
    handler FromSpamCheckerHandler is {
      on event SpamChecker.SpamScoreCalculated is {
        do "the model receives spam score calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromSpamChecker"
      }
    } with {
      briefly "from spam checker"
      described as {
        |Carries messages from the external SpamChecker.
      }
    }
  } with {
    briefly "SpamChecker integration"
    described as {
      |The model's side of the SpamChecker conversation.
    }
  }
  adaptor ToSpamChecker to context SpamChecker is { 
    handler ToSpamCheckerHandler is {
      on command SpamChecker.CheckSpamScore is {
        do "the model sends check spam score"
      }
      on other is {
        error "Unexpected message for adaptor ToSpamChecker"
      }
    } with {
      briefly "to spam checker"
      described as {
        |Carries messages to the external SpamChecker.
      }
    }
  } with {
    briefly "SpamChecker integration"
    described as {
      |The model's side of the SpamChecker conversation.
    }
  }
  adaptor FromTemplateRenderer from context TemplateRenderer is { 
    handler FromTemplateRendererHandler is {
      on event TemplateRenderer.TemplateRendered is {
        do "the model receives template rendered"
      }
      on event TemplateRenderer.TemplateValidated is {
        do "the model receives template validated"
      }
      on other is {
        error "Unexpected message for adaptor FromTemplateRenderer"
      }
    } with {
      briefly "from template renderer"
      described as {
        |Carries messages from the external TemplateRenderer.
      }
    }
  } with {
    briefly "TemplateRenderer integration"
    described as {
      |The model's side of the TemplateRenderer conversation.
    }
  }
  adaptor ToTemplateRenderer to context TemplateRenderer is { 
    handler ToTemplateRendererHandler is {
      on command TemplateRenderer.RenderTemplate is {
        do "the model sends render template"
      }
      on command TemplateRenderer.ValidateTemplate is {
        do "the model sends validate template"
      }
      on other is {
        error "Unexpected message for adaptor ToTemplateRenderer"
      }
    } with {
      briefly "to template renderer"
      described as {
        |Carries messages to the external TemplateRenderer.
      }
    }
  } with {
    briefly "TemplateRenderer integration"
    described as {
      |The model's side of the TemplateRenderer conversation.
    }
  }
  include "types.riddl"
  include "EmailCampaign.riddl"
  repository EmailRepository as merge is {
    inlet EmailRepositoryFromEmailCampaign is type EmailCampaignEvent    inlet EmailRepositoryFromCampaignAnalytics is type EmailCampaignEvent    outlet EmailRepositoryResponses is type EmailCampaign.EmailCampaignResult
    record StoredEmailCampaign is  {
      emailCampaignId: EmailCampaignId with {
        briefly "emailCampaignId"
        described as {
          |The emailCampaignId column of the stored emailCampaign row.
        }
      }
      campaignType: CampaignType with {
        briefly "campaignType"
        described as {
          |The campaignType column of the stored emailCampaign row.
        }
      }
      createdAt: TimeStamp with {
        briefly "createdAt"
        described as {
          |The createdAt column of the stored emailCampaign row.
        }
      }
      status: CampaignStatus with {
        briefly "status"
        described as {
          |The status column of the stored emailCampaign row.
        }
      }
    } with {
      briefly "Stored emailCampaign row"
      described as {
        |The persistence shape of emailCampaign data as this repository stores it.
      }
    }
    schema CampaignData is relational
      of campaigns as type StoredEmailCampaign
        index on field StoredEmailCampaign.status
        index on field StoredEmailCampaign.campaignType
        index on field StoredEmailCampaign.createdAt
 with {
      briefly "Campaign data schema"
      described as {
        |The relational schema holding campaign data for the EmailRepository.
      }
    }
    handler CampaignPersistence is {
      on query GetEmailMetrics is {
        do "read the email metrics projection"
        yield result EmailMetricsView
      }
      on command EmailCampaign.CreateCampaign is {
        tell event EmailCampaign.CampaignCreated to entity EmailContext.EmailCampaign
        do "Store new campaign record"
      }
      on command EmailCampaign.SetAudience is {
        do "Store audience configuration"
      }
      on command EmailCampaign.UpdateTemplate is {
        tell event EmailCampaign.TemplateUpdated to entity EmailContext.EmailCampaign
        do "Update email template"
      }
      on command EmailCampaign.ScheduleCampaign is {
        tell event EmailCampaign.CampaignScheduled to entity EmailContext.EmailCampaign
        do "Store schedule information"
      }
      on command EmailCampaign.SendImmediately is {
        do "Update status to sending"
      }
      on command EmailCampaign.RecordDelivery is {
        tell event EmailCampaign.DeliveryRecorded to entity EmailContext.EmailCampaign
        do "Store delivery metrics"
      }
      on command EmailCampaign.RecordEngagement is {
        tell event EmailCampaign.EngagementRecorded to entity EmailContext.EmailCampaign
        do "Store engagement event"
      }
      on command EmailCampaign.CompleteCampaign is {
        tell event EmailCampaign.CampaignCompleted to entity EmailContext.EmailCampaign
        do "Archive completed campaign"
      }
    } with {
      briefly "Persists campaign commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Email data persistence"
    described as {
      |Persistent storage for campaigns.
    }
  }
  query GetEmailMetrics is  {
    emailMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which email metrics to retrieve.
      }
    }
  } with {
    briefly "Get email metrics"
    described as {
      |Retrieves the email metrics projection.
    }
  }
  result EmailMetricsView is  {
    emailMetrics: CampaignAnalytics.EmailMetrics with {
      briefly "Email metrics"
      described as {
        |The email metrics being returned.
      }
    }
  } with {
    briefly "Email metrics view"
    described as {
      |Read model view carrying the email metrics projection.
    }
  }
  projector CampaignAnalytics as flow is {
    updates repository EmailContext.EmailRepository
    inlet CampaignAnalyticsFromEmailCampaign is type EmailCampaignEvent    outlet CampaignAnalyticsOut is type EmailCampaignEvent
    record EmailMetrics is  {
      totalCampaigns: Natural with {
        briefly "Total"
        described as {
          |Total campaigns.
        }
      }
      activeCampaigns: Natural with {
        briefly "Active"
        described as {
          |Active campaigns.
        }
      }
      averageOpenRate: Decimal(5,2) with {
        briefly "Open rate"
        described as {
          |Avg open rate.
        }
      }
      averageClickRate: Decimal(5,2) with {
        briefly "Click rate"
        described as {
          |Avg click rate.
        }
      }
      totalSent: Natural with {
        briefly "Sent"
        described as {
          |Total emails sent.
        }
      }
      totalOpened: Natural with {
        briefly "Opened"
        described as {
          |Total opens.
        }
      }
    } with {
      briefly "Email metrics"
      described as {
        |Email marketing metrics.
      }
    }
    handler AnalyticsHandler is {
      on event EmailCampaign.CampaignCreated is {
        tell event EmailCampaign.CampaignCreated to repository EmailContext.EmailRepository
        do "Increment campaign count"
      }
      on event EmailCampaign.CampaignSending is {
        tell event EmailCampaign.CampaignSending to repository EmailContext.EmailRepository
        do "Track active campaigns"
      }
      on event EmailCampaign.DeliveryRecorded is {
        tell event EmailCampaign.DeliveryRecorded to repository EmailContext.EmailRepository
        do "Update delivery totals"
      }
      on event EmailCampaign.CampaignCompleted is {
        tell event EmailCampaign.CampaignCompleted to repository EmailContext.EmailRepository
        do "Calculate campaign performance"
      }
    } with {
      briefly "Maintains email analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Campaign analytics"
    described as {
      |Email marketing performance.
    }
  }
  // ---- Event publication for EmailCampaign ----
  type EmailCampaignEvent is one of {
    EmailContext.EmailCampaign.CampaignCreated or EmailContext.EmailCampaign.AudienceSet or EmailContext.EmailCampaign.TemplateUpdated or EmailContext.EmailCampaign.ABTestConfigured or EmailContext.EmailCampaign.CampaignScheduled or EmailContext.EmailCampaign.CampaignSending or EmailContext.EmailCampaign.CampaignPaused or EmailContext.EmailCampaign.CampaignResumed or EmailContext.EmailCampaign.CampaignCancelled or EmailContext.EmailCampaign.DeliveryRecorded or EmailContext.EmailCampaign.EngagementRecorded or EmailContext.EmailCampaign.CampaignCompleted
  } with {
    briefly "EmailCampaign event alternation"
    described as {
      |Union of all EmailCampaign events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EmailCampaignEventSource as source is {
    outlet EmailCampaignEvents is type EmailCampaignEvent
    handler EmailCampaignSourceHandler is {
      on event EmailCampaign.CampaignCreated is {
        send event EmailCampaign.CampaignCreated to outlet EmailCampaignEvents
      }
      on event EmailCampaign.AudienceSet is {
        send event EmailCampaign.AudienceSet to outlet EmailCampaignEvents
      }
      on event EmailCampaign.TemplateUpdated is {
        send event EmailCampaign.TemplateUpdated to outlet EmailCampaignEvents
      }
      on event EmailCampaign.ABTestConfigured is {
        send event EmailCampaign.ABTestConfigured to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignScheduled is {
        send event EmailCampaign.CampaignScheduled to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignSending is {
        send event EmailCampaign.CampaignSending to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignPaused is {
        send event EmailCampaign.CampaignPaused to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignResumed is {
        send event EmailCampaign.CampaignResumed to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignCancelled is {
        send event EmailCampaign.CampaignCancelled to outlet EmailCampaignEvents
      }
      on event EmailCampaign.DeliveryRecorded is {
        send event EmailCampaign.DeliveryRecorded to outlet EmailCampaignEvents
      }
      on event EmailCampaign.EngagementRecorded is {
        send event EmailCampaign.EngagementRecorded to outlet EmailCampaignEvents
      }
      on event EmailCampaign.CampaignCompleted is {
        send event EmailCampaign.CampaignCompleted to outlet EmailCampaignEvents
      }
      on other is {
        error "Unexpected message for source EmailCampaignEventSource"
      }
    } with {
      briefly "EmailCampaign source handler"
      described as {
        |Publishes EmailCampaign events onto the outlet.
      }
    }
  } with {
    briefly "EmailCampaign event source"
    described as {
      |Publishes EmailCampaign entity events into the streaming topology.
    }
  }
  processor EmailCampaignEventSink as sink is {
    inlet EmailCampaignInlet is type EmailCampaignEvent    handler EmailCampaignSinkHandler is {
      on event EmailCampaign.CampaignCreated is {
        tell event EmailCampaign.CampaignCreated to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.AudienceSet is {
        tell event EmailCampaign.AudienceSet to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.TemplateUpdated is {
        tell event EmailCampaign.TemplateUpdated to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.ABTestConfigured is {
        tell event EmailCampaign.ABTestConfigured to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignScheduled is {
        tell event EmailCampaign.CampaignScheduled to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignSending is {
        tell event EmailCampaign.CampaignSending to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignPaused is {
        tell event EmailCampaign.CampaignPaused to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignResumed is {
        tell event EmailCampaign.CampaignResumed to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignCancelled is {
        tell event EmailCampaign.CampaignCancelled to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.DeliveryRecorded is {
        tell event EmailCampaign.DeliveryRecorded to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.EngagementRecorded is {
        tell event EmailCampaign.EngagementRecorded to repository EmailContext.EmailRepository
      }
      on event EmailCampaign.CampaignCompleted is {
        tell event EmailCampaign.CampaignCompleted to repository EmailContext.EmailRepository
      }
      on other is {
        error "Unexpected message for sink EmailCampaignEventSink"
      }
    } with {
      briefly "EmailCampaign sink handler"
      described as {
        |Persists EmailCampaign events via the repository.
      }
    }
  } with {
    briefly "EmailCampaign event sink"
    described as {
      |Receives EmailCampaign events for persistence.
    }
  }
  connector EmailCampaignEventFlow is from outlet EmailContext.EmailCampaignEventSource.EmailCampaignEvents to inlet EmailContext.EmailCampaignEventSink.EmailCampaignInlet with {
    briefly "EmailCampaign event flow"
    described as {
      |Connects the EmailCampaign source to its sink.
    }
  }
  processor EmailCampaignEventSplit as split is {
    inlet EmailCampaignEventSplitIn is type EmailCampaignEvent    outlet EmailCampaignEventSplitToEmailRepository is type EmailCampaignEvent
    outlet EmailCampaignEventSplitToCampaignAnalytics is type EmailCampaignEvent
    handler EmailCampaignEventSplitHandler is {
      on event EmailCampaign.CampaignCreated is {
        send event EmailCampaign.CampaignCreated to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.CampaignCreated to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.CampaignCreated to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.AudienceSet is {
        send event EmailCampaign.AudienceSet to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.AudienceSet to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.AudienceSet to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.TemplateUpdated is {
        send event EmailCampaign.TemplateUpdated to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.TemplateUpdated to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.TemplateUpdated to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.ABTestConfigured is {
        send event EmailCampaign.ABTestConfigured to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.ABTestConfigured to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.ABTestConfigured to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.CampaignScheduled is {
        send event EmailCampaign.CampaignScheduled to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.CampaignScheduled to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.CampaignScheduled to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.CampaignSending is {
        send event EmailCampaign.CampaignSending to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.CampaignSending to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.CampaignSending to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.CampaignPaused is {
        send event EmailCampaign.CampaignPaused to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.CampaignPaused to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.CampaignPaused to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.CampaignResumed is {
        send event EmailCampaign.CampaignResumed to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.CampaignResumed to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.CampaignResumed to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.CampaignCancelled is {
        send event EmailCampaign.CampaignCancelled to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.CampaignCancelled to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.CampaignCancelled to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.DeliveryRecorded is {
        send event EmailCampaign.DeliveryRecorded to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.DeliveryRecorded to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.DeliveryRecorded to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.EngagementRecorded is {
        send event EmailCampaign.EngagementRecorded to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.EngagementRecorded to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.EngagementRecorded to entity EmailContext.EmailCampaign
      }
      on event EmailCampaign.CampaignCompleted is {
        send event EmailCampaign.CampaignCompleted to outlet EmailCampaignEventSplitToEmailRepository
        send event EmailCampaign.CampaignCompleted to outlet EmailCampaignEventSplitToCampaignAnalytics
        tell event EmailCampaign.CampaignCompleted to entity EmailContext.EmailCampaign
      }
      on other is {
        error "Unexpected message for processor EmailCampaignEventSplit"
      }
    } with {
      briefly "EmailCampaign event fan-out handler"
      described as {
        |Delivers each EmailCampaign event to all of its consumers.
      }
    }
  } with {
    briefly "EmailCampaign event fan-out"
    described as {
      |Fans EmailCampaign events out to the repository and projectors.
    }
  }
  connector 'EmailCampaignEvent Stream' is from outlet EmailContext.EmailCampaign.EmailCampaignEvents2 to inlet EmailContext.EmailCampaignEventSplit.EmailCampaignEventSplitIn with {
    briefly "EmailCampaign events, fanned out to storage and read models"
  }
  connector 'EmailCampaignEvent Storage' is from outlet EmailContext.EmailCampaignEventSplit.EmailCampaignEventSplitToEmailRepository to inlet EmailContext.EmailRepository.EmailRepositoryFromEmailCampaign with {
    briefly "EmailCampaign events on their way to storage"
  }
  connector 'CampaignAnalytics Feed' is from outlet EmailContext.EmailCampaignEventSplit.EmailCampaignEventSplitToCampaignAnalytics to inlet EmailContext.CampaignAnalytics.CampaignAnalyticsFromEmailCampaign with {
    briefly "EmailCampaign events feeding the CampaignAnalytics projection"
  }
  connector 'CampaignAnalytics Storage' is from outlet EmailContext.CampaignAnalytics.CampaignAnalyticsOut to inlet EmailContext.EmailRepository.EmailRepositoryFromCampaignAnalytics with {
    briefly "The CampaignAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for email marketing"
  described as {
    |Email campaign management context.
  }
}
