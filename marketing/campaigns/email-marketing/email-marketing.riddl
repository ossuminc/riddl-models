// Email Marketing Domain Model
// Email campaign creation and delivery
domain EmailMarketing is {
  persistent connector 'EmailDeliveryServiceEvent Stream' is from outlet EmailDeliveryService.EmailDeliveryServiceEventsOut to inlet EmailContext.FromEmailDeliveryService.FromEmailDeliveryServiceIn with {
    briefly "What EmailDeliveryService tells EmailContext, unasked"
  }
  persistent connector 'ListManagementEvent Stream' is from outlet ListManagement.ListManagementEventsOut to inlet EmailContext.FromListManagement.FromListManagementIn with {
    briefly "What ListManagement tells EmailContext, unasked"
  }
  persistent connector 'SpamCheckerEvent Stream' is from outlet SpamChecker.SpamCheckerEventsOut to inlet EmailContext.FromSpamChecker.FromSpamCheckerIn with {
    briefly "What SpamChecker tells EmailContext, unasked"
  }
  persistent connector 'TemplateRendererEvent Stream' is from outlet TemplateRenderer.TemplateRendererEventsOut to inlet EmailContext.FromTemplateRenderer.FromTemplateRendererIn with {
    briefly "What TemplateRenderer tells EmailContext, unasked"
  }
  persistent connector 'TemplateRendererRequest Stream' is from outlet EmailContext.ToTemplateRenderer.ToTemplateRendererOut to inlet TemplateRenderer.TemplateRendererRequests with {
    briefly "What EmailContext asks TemplateRenderer to send"
  }
  persistent connector 'ListManagementRequest Stream' is from outlet EmailContext.ToListManagement.ToListManagementOut to inlet ListManagement.ListManagementRequests with {
    briefly "What EmailContext asks ListManagement to send"
  }
  persistent connector 'SpamCheckerRequest Stream' is from outlet EmailContext.ToSpamChecker.ToSpamCheckerOut to inlet SpamChecker.SpamCheckerRequests with {
    briefly "What EmailContext asks SpamChecker to send"
  }
  persistent connector 'EmailDeliveryServiceRequest Stream' is from outlet EmailContext.ToEmailDeliveryService.ToEmailDeliveryServiceOut to inlet EmailDeliveryService.EmailDeliveryServiceRequests with {
    briefly "What EmailContext asks EmailDeliveryService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user EmailMarketer is "person managing email campaigns" with {
    briefly "Email Marketer"
    described as {
      |Creates and manages email campaigns.
    }
  }
  user ContentCreator is "person creating email content" with {
    briefly "Content Creator"
    described as {
      |Designs email templates and content.
    }
  }
  user Subscriber is "person receiving marketing emails" with {
    briefly "Subscriber"
    described as {
      |Email list subscriber.
    }
  }
  epic EmailCampaigns is {
    user EmailMarketer wants to "to create targeted email campaigns" so that "subscribers receive relevant content"
    case CreateCampaignUseCase is {
      user EmailMarketer wants to "to build an email campaign" so that "messages reach the right audience"
      step is "Marketer selects" "target audience" "from segments" with {
        briefly "Select audience"
        described as {
          |Choose recipients.
        }
      }
      step is "System schedules" "email delivery" "at optimal times" with {
        briefly "Schedule delivery"
        described as {
          |Plan send time.
        }
      }
    } with {
      briefly "Create email campaign"
      described as {
        |Email campaign creation.
      }
    }
  } with {
    briefly "Email campaigns"
    described as {
      |Epic for email marketing.
    }
  }
  include "EmailContext.riddl"
  include "external-contexts.riddl"
  application context EmailMarketingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EmailMarketing are delivered.
      }
    }
    group EmailMarketingScreen is {
      input CreateCampaignInput acquires command EmailContext.CreateCampaign with {
        briefly "Create campaign control"
        described as {
          |The control through which a user submits the create campaign request.
        }
      }
      input CancelCampaignInput acquires command EmailContext.EmailCampaign.CancelCampaign with {
        briefly "Cancel campaign control"
        described as {
          |The control through which a user submits the cancel campaign request.
        }
      }
      input CompleteCampaignInput acquires command EmailContext.EmailCampaign.CompleteCampaign with {
        briefly "Complete campaign control"
        described as {
          |The control through which a user submits the complete campaign request.
        }
      }
      input ConfigureABTestInput acquires command EmailContext.EmailCampaign.ConfigureABTest with {
        briefly "Configure AB test control"
        described as {
          |The control through which a user submits the configure ab test request.
        }
      }
      input PauseCampaignInput acquires command EmailContext.EmailCampaign.PauseCampaign with {
        briefly "Pause campaign control"
        described as {
          |The control through which a user submits the pause campaign request.
        }
      }
      input ResumeCampaignInput acquires command EmailContext.EmailCampaign.ResumeCampaign with {
        briefly "Resume campaign control"
        described as {
          |The control through which a user submits the resume campaign request.
        }
      }
      input ScheduleCampaignInput acquires command EmailContext.EmailCampaign.ScheduleCampaign with {
        briefly "Schedule campaign control"
        described as {
          |The control through which a user submits the schedule campaign request.
        }
      }
      input SendImmediatelyInput acquires command EmailContext.EmailCampaign.SendImmediately with {
        briefly "Send immediately control"
        described as {
          |The control through which a user submits the send immediately request.
        }
      }
      input SetAudienceInput acquires command EmailContext.EmailCampaign.SetAudience with {
        briefly "Set audience control"
        described as {
          |The control through which a user submits the set audience request.
        }
      }
      input UpdateTemplateInput acquires command EmailContext.EmailCampaign.UpdateTemplate with {
        briefly "Update template control"
        described as {
          |The control through which a user submits the update template request.
        }
      }
    } with {
      briefly "Email marketing screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppEmailCampaignCommands is type EmailContext.EmailCampaignRequest
    inlet AppEmailRepositoryResponses is result EmailContext.EmailCampaign.EmailCampaignResult
    handler EmailMarketingAppHandler is {
      on other is {
        error "Unexpected message for application context EmailMarketingApp"
      }
    } with {
      briefly "EmailMarketingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EmailMarketingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'EmailCampaignCommand Stream' is from outlet EmailMarketingApp.AppEmailCampaignCommands to inlet EmailContext.EmailCampaignCommandStreamIn with {
    briefly "EmailCampaign commands from the application"
  }
  persistent connector 'EmailCampaignResult Stream' is from outlet EmailContext.EmailCampaignResultStreamOut to inlet EmailMarketingApp.AppEmailRepositoryResponses with {
    briefly "Email query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EmailMarketingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Email marketing domain"
  described as {
    |Email campaign management.
  }
}
