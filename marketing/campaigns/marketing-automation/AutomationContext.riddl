// Marketing Automation - Automation Context
context AutomationContext is {
  include "types.riddl"
  include "AutomationWorkflow.riddl"
  repository AutomationRepository is {
    schema AutomationData is relational
      of automationWorkflows as type AutomationWorkflow
        index on field AutomationWorkflow.workflowId
        index on field AutomationWorkflow.campaignId
        index on field AutomationWorkflow.status

    handler AutomationPersistence is {
      on command AutomationWorkflow.CreateWorkflow is {
        tell event AutomationWorkflow.WorkflowCreated to entity AutomationContext.AutomationWorkflow
        prompt "Store new automation workflow"
      }
      on command AutomationWorkflow.ActivateWorkflow is {
        prompt "Update workflow to activated"
      }
      on command AutomationWorkflow.EnrollLead is {
        prompt "Store lead enrollment"
      }
      on command AutomationWorkflow.AdvanceLeadStep is {
        prompt "Update lead step progress"
      }
      on command AutomationWorkflow.RecordABTestResult is {
        tell event AutomationWorkflow.ABTestResultRecorded to entity AutomationContext.AutomationWorkflow
        prompt "Store A/B test results"
      }
      on command AutomationWorkflow.CompleteWorkflow is {
        tell event AutomationWorkflow.WorkflowCompleted to entity AutomationContext.AutomationWorkflow
        prompt "Update workflow to completed"
      }
    } with {
      briefly "Persists automation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Automation data persistence"
    described as {
      |Persistent storage for automation workflows.
    }
  }
  projector AutomationMetrics is {
    updates repository AutomationContext.AutomationRepository
    record WorkflowMetrics is  {
      workflowsCreated: Natural with {
        briefly "Created"
        described as {
          |Workflows created.
        }
      }
      workflowsActive: Natural with {
        briefly "Active"
        described as {
          |Workflows active.
        }
      }
      workflowsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Workflows completed.
        }
      }
      totalLeadsEnrolled: Natural with {
        briefly "Enrolled"
        described as {
          |Total leads enrolled.
        }
      }
      averageConversionRate: Decimal(8,4) with {
        briefly "Conversion"
        described as {
          |Average conversion rate.
        }
      }
    } with {
      briefly "Workflow metrics"
      described as {
        |Automation workflow metrics.
      }
    }
    handler MetricsHandler is {
      on event AutomationWorkflow.WorkflowCreated is {
        tell event AutomationWorkflow.WorkflowCreated to repository AutomationContext.AutomationRepository
        prompt "Increment workflows created"
      }
      on event AutomationWorkflow.WorkflowActivated is {
        tell event AutomationWorkflow.WorkflowActivated to repository AutomationContext.AutomationRepository
        prompt "Increment workflows active"
      }
      on event AutomationWorkflow.LeadEnrolled is {
        tell event AutomationWorkflow.LeadEnrolled to repository AutomationContext.AutomationRepository
        prompt "Increment total leads enrolled"
      }
      on event AutomationWorkflow.WorkflowCompleted is {
        tell event AutomationWorkflow.WorkflowCompleted to repository AutomationContext.AutomationRepository
        prompt "Increment workflows completed and calculate conversion rate"
      }
    } with {
      briefly "Maintains automation metrics"
      described as {
        |Projects events into automation metrics.
      }
    }
  } with {
    briefly "Automation metrics"
    described as {
      |Marketing automation analytics.
    }
  }
  // ---- Event publication for AutomationWorkflow ----
  type AutomationWorkflowEvent is one of {
    AutomationContext.AutomationWorkflow.WorkflowCreated,
    AutomationContext.AutomationWorkflow.WorkflowActivated,
    AutomationContext.AutomationWorkflow.WorkflowPaused,
    AutomationContext.AutomationWorkflow.WorkflowResumed,
    AutomationContext.AutomationWorkflow.LeadEnrolled,
    AutomationContext.AutomationWorkflow.LeadStepAdvanced,
    AutomationContext.AutomationWorkflow.LeadRemoved,
    AutomationContext.AutomationWorkflow.ABTestConfigured,
    AutomationContext.AutomationWorkflow.ABTestResultRecorded,
    AutomationContext.AutomationWorkflow.WorkflowCompleted,
    AutomationContext.AutomationWorkflow.WorkflowArchived
  } with {
    briefly "AutomationWorkflow event alternation"
    described as {
      |Union of all AutomationWorkflow events, for streaming and event-sourced
      |persistence.
    }
  }
  source AutomationWorkflowEventSource is {
    outlet AutomationWorkflowEvents is type AutomationWorkflowEvent
    handler AutomationWorkflowSourceHandler is {
      on event AutomationWorkflow.WorkflowCreated is {
        send event AutomationWorkflow.WorkflowCreated to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.WorkflowActivated is {
        send event AutomationWorkflow.WorkflowActivated to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.WorkflowPaused is {
        send event AutomationWorkflow.WorkflowPaused to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.WorkflowResumed is {
        send event AutomationWorkflow.WorkflowResumed to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.LeadEnrolled is {
        send event AutomationWorkflow.LeadEnrolled to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.LeadStepAdvanced is {
        send event AutomationWorkflow.LeadStepAdvanced to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.LeadRemoved is {
        send event AutomationWorkflow.LeadRemoved to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.ABTestConfigured is {
        send event AutomationWorkflow.ABTestConfigured to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.ABTestResultRecorded is {
        send event AutomationWorkflow.ABTestResultRecorded to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.WorkflowCompleted is {
        send event AutomationWorkflow.WorkflowCompleted to outlet AutomationWorkflowEvents
      }
      on event AutomationWorkflow.WorkflowArchived is {
        send event AutomationWorkflow.WorkflowArchived to outlet AutomationWorkflowEvents
      }
      on other is {
        error "Unexpected message for source AutomationWorkflowEventSource"
      }
    } with {
      briefly "AutomationWorkflow source handler"
      described as {
        |Publishes AutomationWorkflow events onto the outlet.
      }
    }
  } with {
    briefly "AutomationWorkflow event source"
    described as {
      |Publishes AutomationWorkflow entity events into the streaming topology.
    }
  }
  sink AutomationWorkflowEventSink is {
    inlet AutomationWorkflowInlet is type AutomationWorkflowEvent
    handler AutomationWorkflowSinkHandler is {
      on event AutomationWorkflow.WorkflowCreated is {
        tell event AutomationWorkflow.WorkflowCreated to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.WorkflowActivated is {
        tell event AutomationWorkflow.WorkflowActivated to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.WorkflowPaused is {
        tell event AutomationWorkflow.WorkflowPaused to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.WorkflowResumed is {
        tell event AutomationWorkflow.WorkflowResumed to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.LeadEnrolled is {
        tell event AutomationWorkflow.LeadEnrolled to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.LeadStepAdvanced is {
        tell event AutomationWorkflow.LeadStepAdvanced to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.LeadRemoved is {
        tell event AutomationWorkflow.LeadRemoved to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.ABTestConfigured is {
        tell event AutomationWorkflow.ABTestConfigured to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.ABTestResultRecorded is {
        tell event AutomationWorkflow.ABTestResultRecorded to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.WorkflowCompleted is {
        tell event AutomationWorkflow.WorkflowCompleted to repository AutomationContext.AutomationRepository
      }
      on event AutomationWorkflow.WorkflowArchived is {
        tell event AutomationWorkflow.WorkflowArchived to repository AutomationContext.AutomationRepository
      }
      on other is {
        error "Unexpected message for sink AutomationWorkflowEventSink"
      }
    } with {
      briefly "AutomationWorkflow sink handler"
      described as {
        |Persists AutomationWorkflow events via the repository.
      }
    }
  } with {
    briefly "AutomationWorkflow event sink"
    described as {
      |Receives AutomationWorkflow events for persistence.
    }
  }
  connector AutomationWorkflowEventFlow is {
    from outlet AutomationContext.AutomationWorkflowEventSource.AutomationWorkflowEvents to
      inlet AutomationContext.AutomationWorkflowEventSink.AutomationWorkflowInlet
  } with {
    briefly "AutomationWorkflow event flow"
    described as {
      |Connects the AutomationWorkflow source to its sink.
    }
  }
} with {
  briefly "Bounded context for marketing automation"
  described as {
    |Marketing automation workflow context.
  }
}
