// Marketing Automation - Automation Context
context AutomationContext as router is {
  inlet AutomationWorkflowCommandStrIn is type AutomationWorkflowCommand  outlet AutomationWorkflowCommandStrOut is type AutomationWorkflowCommand
  inlet AutomationWorkflowResultStreIn is result AutomationWorkflow.AutomationWorkflowResult  outlet AutomationWorkflowResultStreOut is result AutomationWorkflow.AutomationWorkflowResult
  handler AutomationContextBoundary is {
    on createWorkflow: command AutomationWorkflow.CreateWorkflow is {
      send createWorkflow to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on activateWorkflow: command AutomationWorkflow.ActivateWorkflow is {
      send activateWorkflow to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on pauseWorkflow: command AutomationWorkflow.PauseWorkflow is {
      send pauseWorkflow to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on resumeWorkflow: command AutomationWorkflow.ResumeWorkflow is {
      send resumeWorkflow to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on enrollLead: command AutomationWorkflow.EnrollLead is {
      send enrollLead to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on advanceLeadStep: command AutomationWorkflow.AdvanceLeadStep is {
      send advanceLeadStep to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on removeLead: command AutomationWorkflow.RemoveLead is {
      send removeLead to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on configureABTest: command AutomationWorkflow.ConfigureABTest is {
      send configureABTest to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on recordABTestResult: command AutomationWorkflow.RecordABTestResult is {
      send recordABTestResult to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on completeWorkflow: command AutomationWorkflow.CompleteWorkflow is {
      send completeWorkflow to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on archiveWorkflow: command AutomationWorkflow.ArchiveWorkflow is {
      send archiveWorkflow to outlet AutomationContext.AutomationWorkflowCommandStrOut
    }
    on automationWorkflowResult: result AutomationWorkflow.AutomationWorkflowResult is {
      send automationWorkflowResult to outlet AutomationContext.AutomationWorkflowResultStreOut
    }
    on other is {
      error "Unexpected message at the AutomationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AutomationWorkflowCommand Stream Intake' is from outlet AutomationContext.AutomationWorkflowCommandStrOut to inlet AutomationContext.AutomationWorkflow.AutomationWorkflowCommands  connector 'AutomationWorkflowResult Stream Egress' is from outlet AutomationContext.AutomationRepository.AutomationRepositoryResponses to inlet AutomationContext.AutomationWorkflowResultStreIn  adaptor FromCRMSystem from context CRMSystem is { 
    handler FromCRMSystemHandler is {
      on result CRMSystem.LeadInfo is {
        do "the model receives lead info"
      }
      on event CRMSystem.LeadScoreUpdated is {
        do "the model receives lead score updated"
      }
      on result CRMSystem.SegmentMembers is {
        do "the model receives segment members"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMSystem"
      }
    } with {
      briefly "from crm system"
      described as {
        |Carries messages from the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem is { 
    handler ToCRMSystemHandler is {
      on query CRMSystem.GetLeadInfo is {
        do "the model sends get lead info"
      }
      on query CRMSystem.GetSegmentMembers is {
        do "the model sends get segment members"
      }
      on command CRMSystem.UpdateLeadScore is {
        do "the model sends update lead score"
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromEmailDelivery from context EmailDelivery is { 
    handler FromEmailDeliveryHandler is {
      on result EmailDelivery.DeliveryStatus is {
        do "the model receives delivery status"
      }
      on event EmailDelivery.EmailDelivered is {
        do "the model receives email delivered"
      }
      on event EmailDelivery.EmailOpened is {
        do "the model receives email opened"
      }
      on event EmailDelivery.LinkClicked is {
        do "the model receives link clicked"
      }
      on other is {
        error "Unexpected message for adaptor FromEmailDelivery"
      }
    } with {
      briefly "from email delivery"
      described as {
        |Carries messages from the external EmailDelivery.
      }
    }
  } with {
    briefly "EmailDelivery integration"
    described as {
      |The model's side of the EmailDelivery conversation.
    }
  }
  adaptor ToEmailDelivery to context EmailDelivery is { 
    handler ToEmailDeliveryHandler is {
      on query EmailDelivery.GetDeliveryStatus is {
        do "the model sends get delivery status"
      }
      on command EmailDelivery.SendEmail is {
        do "the model sends send email"
      }
      on other is {
        error "Unexpected message for adaptor ToEmailDelivery"
      }
    } with {
      briefly "to email delivery"
      described as {
        |Carries messages to the external EmailDelivery.
      }
    }
  } with {
    briefly "EmailDelivery integration"
    described as {
      |The model's side of the EmailDelivery conversation.
    }
  }
  include "types.riddl"
  include "AutomationWorkflow.riddl"
  type AutomationRepositoryCommand is one of {
    AutomationContext.AutomationRepository.PersistABTestConfigured or AutomationContext.AutomationRepository.PersistABTestResultRecorded or AutomationContext.AutomationRepository.PersistLeadEnrolled or AutomationContext.AutomationRepository.PersistLeadRemoved or AutomationContext.AutomationRepository.PersistLeadStepAdvanced or AutomationContext.AutomationRepository.PersistWorkflowActivated or AutomationContext.AutomationRepository.PersistWorkflowArchived or AutomationContext.AutomationRepository.PersistWorkflowCompleted or AutomationContext.AutomationRepository.PersistWorkflowCreated or AutomationContext.AutomationRepository.PersistWorkflowPaused or AutomationContext.AutomationRepository.PersistWorkflowResumed
  } with {
    briefly "Anything that writes AutomationRepository"
    described as {
      |The persistence commands AutomationRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AutomationRepository as flow is {
    inlet AutomationRepositoryFromAutomationMetrics is type AutomationRepositoryCommand    command PersistABTestConfigured is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row ABTestConfigured applies to.
        }
      }
    } with {
      briefly "Persist ABTestConfigured"
      described as {
        |Instructs this repository to apply ABTestConfigured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistABTestResultRecorded is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row ABTestResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist ABTestResultRecorded"
      described as {
        |Instructs this repository to apply ABTestResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeadRemoved is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeadRemoved applies to.
        }
      }
    } with {
      briefly "Persist LeadRemoved"
      described as {
        |Instructs this repository to apply LeadRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeadStepAdvanced is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeadStepAdvanced applies to.
        }
      }
    } with {
      briefly "Persist LeadStepAdvanced"
      described as {
        |Instructs this repository to apply LeadStepAdvanced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkflowArchived is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkflowArchived applies to.
        }
      }
    } with {
      briefly "Persist WorkflowArchived"
      described as {
        |Instructs this repository to apply WorkflowArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkflowPaused is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkflowPaused applies to.
        }
      }
    } with {
      briefly "Persist WorkflowPaused"
      described as {
        |Instructs this repository to apply WorkflowPaused to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkflowResumed is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkflowResumed applies to.
        }
      }
    } with {
      briefly "Persist WorkflowResumed"
      described as {
        |Instructs this repository to apply WorkflowResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLeadEnrolled is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row LeadEnrolled applies to.
        }
      }
    } with {
      briefly "Persist LeadEnrolled"
      described as {
        |Instructs this repository to apply LeadEnrolled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkflowActivated is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkflowActivated applies to.
        }
      }
    } with {
      briefly "Persist WorkflowActivated"
      described as {
        |Instructs this repository to apply WorkflowActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkflowCompleted is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkflowCompleted applies to.
        }
      }
    } with {
      briefly "Persist WorkflowCompleted"
      described as {
        |Instructs this repository to apply WorkflowCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistWorkflowCreated is {
      workflowId: WorkflowId with {
        briefly "Row addressed"
        described as {
          |Which stored row WorkflowCreated applies to.
        }
      }
    } with {
      briefly "Persist WorkflowCreated"
      described as {
        |Instructs this repository to apply WorkflowCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AutomationRepositoryResponses is result AutomationWorkflow.AutomationWorkflowResult
    record StoredAutomationWorkflow is {
      automationWorkflowId: UUID with {
        briefly "automationWorkflowId"
        described as {
          |The automationWorkflowId column of the stored automationWorkflow row.
        }
      }
      campaignId: CampaignId with {
        briefly "campaignId"
        described as {
          |The campaignId column of the stored automationWorkflow row.
        }
      }
      status: WorkflowStatus with {
        briefly "status"
        described as {
          |The status column of the stored automationWorkflow row.
        }
      }
      workflowId: WorkflowId with {
        briefly "workflowId"
        described as {
          |The workflowId column of the stored automationWorkflow row.
        }
      }
    } with {
      briefly "Stored automationWorkflow row"
      described as {
        |The persistence shape of automationWorkflow data as this repository stores it.
      }
    }
    schema AutomationData is relational
      of automationWorkflows as record StoredAutomationWorkflow
        index on field StoredAutomationWorkflow.workflowId
        index on field StoredAutomationWorkflow.campaignId
        index on field StoredAutomationWorkflow.status
 with {
      briefly "Automation data schema"
      described as {
        |The relational schema holding automation data for the AutomationRepository.
      }
    }
    handler AutomationPersistence is {
      on persistABTestConfigured: command PersistABTestConfigured is {
        do "apply ABTestConfigured to the stored row"
      }
      on persistABTestResultRecorded: command PersistABTestResultRecorded is {
        do "apply ABTestResultRecorded to the stored row"
      }
      on persistLeadRemoved: command PersistLeadRemoved is {
        do "apply LeadRemoved to the stored row"
      }
      on persistLeadStepAdvanced: command PersistLeadStepAdvanced is {
        do "apply LeadStepAdvanced to the stored row"
      }
      on persistWorkflowArchived: command PersistWorkflowArchived is {
        do "apply WorkflowArchived to the stored row"
      }
      on persistWorkflowPaused: command PersistWorkflowPaused is {
        do "apply WorkflowPaused to the stored row"
      }
      on persistWorkflowResumed: command PersistWorkflowResumed is {
        do "apply WorkflowResumed to the stored row"
      }
      on persistLeadEnrolled: command PersistLeadEnrolled is {
        do "apply LeadEnrolled to the stored row"
      }
      on persistWorkflowActivated: command PersistWorkflowActivated is {
        do "apply WorkflowActivated to the stored row"
      }
      on persistWorkflowCompleted: command PersistWorkflowCompleted is {
        do "apply WorkflowCompleted to the stored row"
      }
      on persistWorkflowCreated: command PersistWorkflowCreated is {
        do "apply WorkflowCreated to the stored row"
      }
      on query GetWorkflowMetrics is {
        let workflowMetricsView: type WorkflowMetricsView = prompt("read the workflow metrics projection")
        reply workflowMetricsView
      }
    } with {
      briefly "Persists automation commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Automation data persistence"
    described as {
      |Persistent storage for automation workflows.
    }
  }
  query GetWorkflowMetrics replies result WorkflowMetricsView is {
    workflowMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which workflow metrics to retrieve.
      }
    }
  } with {
    briefly "Get workflow metrics"
    described as {
      |Retrieves the workflow metrics projection.
    }
  }
  result WorkflowMetricsView is {
    workflowMetrics: AutomationMetrics.WorkflowMetrics with {
      briefly "Workflow metrics"
      described as {
        |The workflow metrics being returned.
      }
    }
  } with {
    briefly "Workflow metrics view"
    described as {
      |Read model view carrying the workflow metrics projection.
    }
  }
  projector AutomationMetrics as flow is {
    updates repository AutomationContext.AutomationRepository
    outlet AutomationMetricsToRepository is type AutomationRepositoryCommand
    inlet AutomationMetricsFromAutomationWorkflow is type AutomationWorkflowEvent    record WorkflowMetrics is {
      workflowsCreated: Natural with {
        briefly "Created"
        described as {
          |Workflows created.
        }
      }
      workflowsActive: Natural with {
        briefly "Active"
        described as {
          |Workflows active.
        }
      }
      workflowsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Workflows completed.
        }
      }
      totalLeadsEnrolled: Natural with {
        briefly "Enrolled"
        described as {
          |Total leads enrolled.
        }
      }
      averageConversionRate: Decimal(8,4) with {
        briefly "Conversion"
        described as {
          |Average conversion rate.
        }
      }
    } with {
      briefly "Workflow metrics"
      described as {
        |Automation workflow metrics.
      }
    }
    handler MetricsHandler is {
      on aBTestConfigured: event AutomationWorkflow.ABTestConfigured is {
        tell command AutomationContext.AutomationRepository.PersistABTestConfigured(workflowId = aBTestConfigured.workflowId) to repository AutomationContext.AutomationRepository
        do "apply ABTestConfigured to the AutomationMetrics projection"
      }
      on aBTestResultRecorded: event AutomationWorkflow.ABTestResultRecorded is {
        tell command AutomationContext.AutomationRepository.PersistABTestResultRecorded(workflowId = aBTestResultRecorded.workflowId) to repository AutomationContext.AutomationRepository
        do "apply ABTestResultRecorded to the AutomationMetrics projection"
      }
      on leadRemoved: event AutomationWorkflow.LeadRemoved is {
        tell command AutomationContext.AutomationRepository.PersistLeadRemoved(workflowId = leadRemoved.workflowId) to repository AutomationContext.AutomationRepository
        do "apply LeadRemoved to the AutomationMetrics projection"
      }
      on leadStepAdvanced: event AutomationWorkflow.LeadStepAdvanced is {
        tell command AutomationContext.AutomationRepository.PersistLeadStepAdvanced(workflowId = leadStepAdvanced.workflowId) to repository AutomationContext.AutomationRepository
        do "apply LeadStepAdvanced to the AutomationMetrics projection"
      }
      on workflowArchived: event AutomationWorkflow.WorkflowArchived is {
        tell command AutomationContext.AutomationRepository.PersistWorkflowArchived(workflowId = workflowArchived.workflowId) to repository AutomationContext.AutomationRepository
        do "apply WorkflowArchived to the AutomationMetrics projection"
      }
      on workflowPaused: event AutomationWorkflow.WorkflowPaused is {
        tell command AutomationContext.AutomationRepository.PersistWorkflowPaused(workflowId = workflowPaused.workflowId) to repository AutomationContext.AutomationRepository
        do "apply WorkflowPaused to the AutomationMetrics projection"
      }
      on workflowResumed: event AutomationWorkflow.WorkflowResumed is {
        tell command AutomationContext.AutomationRepository.PersistWorkflowResumed(workflowId = workflowResumed.workflowId) to repository AutomationContext.AutomationRepository
        do "apply WorkflowResumed to the AutomationMetrics projection"
      }
      on workflowCreated: event AutomationWorkflow.WorkflowCreated is {
        tell command AutomationContext.AutomationRepository.PersistWorkflowCreated(workflowId = workflowCreated.workflowId) to repository AutomationContext.AutomationRepository
        do "Increment workflows created"
      }
      on workflowActivated: event AutomationWorkflow.WorkflowActivated is {
        tell command AutomationContext.AutomationRepository.PersistWorkflowActivated(workflowId = workflowActivated.workflowId) to repository AutomationContext.AutomationRepository
        do "Increment workflows active"
      }
      on leadEnrolled: event AutomationWorkflow.LeadEnrolled is {
        tell command AutomationContext.AutomationRepository.PersistLeadEnrolled(workflowId = leadEnrolled.workflowId) to repository AutomationContext.AutomationRepository
        do "Increment total leads enrolled"
      }
      on workflowCompleted: event AutomationWorkflow.WorkflowCompleted is {
        tell command AutomationContext.AutomationRepository.PersistWorkflowCompleted(workflowId = workflowCompleted.workflowId) to repository AutomationContext.AutomationRepository
        do "Increment workflows completed and calculate conversion rate"
      }
    } with {
      briefly "Maintains automation metrics"
      described as {
        |Projects events into automation metrics.
      }
    }
  } with {
    briefly "Automation metrics"
    described as {
      |Marketing automation analytics.
    }
  }
  // ---- Event publication for AutomationWorkflow ----
  type AutomationWorkflowEvent is one of {
    AutomationContext.AutomationWorkflow.WorkflowCreated or AutomationContext.AutomationWorkflow.WorkflowActivated or AutomationContext.AutomationWorkflow.WorkflowPaused or AutomationContext.AutomationWorkflow.WorkflowResumed or AutomationContext.AutomationWorkflow.LeadEnrolled or AutomationContext.AutomationWorkflow.LeadStepAdvanced or AutomationContext.AutomationWorkflow.LeadRemoved or AutomationContext.AutomationWorkflow.ABTestConfigured or AutomationContext.AutomationWorkflow.ABTestResultRecorded or AutomationContext.AutomationWorkflow.WorkflowCompleted or AutomationContext.AutomationWorkflow.WorkflowArchived
  } with {
    briefly "AutomationWorkflow event alternation"
    described as {
      |Union of all AutomationWorkflow events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet AutomationWorkflowEventSplit as flow is {
    inlet AutomationWorkflowEventSplitIn is type AutomationWorkflowEvent    outlet AutomationWorkflowEventSplitToAutomationMetrics is type AutomationWorkflowEvent
    handler AutomationWorkflowEventSplitHandler is {
      on workflowCreated: event AutomationWorkflow.WorkflowCreated is {
        send workflowCreated to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell workflowCreated to entity AutomationContext.AutomationWorkflow
      }
      on workflowActivated: event AutomationWorkflow.WorkflowActivated is {
        send workflowActivated to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell workflowActivated to entity AutomationContext.AutomationWorkflow
      }
      on workflowPaused: event AutomationWorkflow.WorkflowPaused is {
        send workflowPaused to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell workflowPaused to entity AutomationContext.AutomationWorkflow
      }
      on workflowResumed: event AutomationWorkflow.WorkflowResumed is {
        send workflowResumed to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell workflowResumed to entity AutomationContext.AutomationWorkflow
      }
      on leadEnrolled: event AutomationWorkflow.LeadEnrolled is {
        send leadEnrolled to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell leadEnrolled to entity AutomationContext.AutomationWorkflow
      }
      on leadStepAdvanced: event AutomationWorkflow.LeadStepAdvanced is {
        send leadStepAdvanced to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell leadStepAdvanced to entity AutomationContext.AutomationWorkflow
      }
      on leadRemoved: event AutomationWorkflow.LeadRemoved is {
        send leadRemoved to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell leadRemoved to entity AutomationContext.AutomationWorkflow
      }
      on aBTestConfigured: event AutomationWorkflow.ABTestConfigured is {
        send aBTestConfigured to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell aBTestConfigured to entity AutomationContext.AutomationWorkflow
      }
      on aBTestResultRecorded: event AutomationWorkflow.ABTestResultRecorded is {
        send aBTestResultRecorded to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell aBTestResultRecorded to entity AutomationContext.AutomationWorkflow
      }
      on workflowCompleted: event AutomationWorkflow.WorkflowCompleted is {
        send workflowCompleted to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell workflowCompleted to entity AutomationContext.AutomationWorkflow
      }
      on workflowArchived: event AutomationWorkflow.WorkflowArchived is {
        send workflowArchived to outlet AutomationWorkflowEventSplitToAutomationMetrics
        tell workflowArchived to entity AutomationContext.AutomationWorkflow
      }
      on other is {
        error "Unexpected message for processor AutomationWorkflowEventSplit"
      }
    } with {
      briefly "AutomationWorkflow event fan-out handler"
      described as {
        |Delivers each AutomationWorkflow event to all of its consumers.
      }
    }
  } with {
    briefly "AutomationWorkflow event fan-out"
    described as {
      |Fans AutomationWorkflow events out to the repository and projectors.
    }
  }
  connector 'AutomationWorkflowEvent Stream' is from outlet AutomationContext.AutomationWorkflow.AutomationWorkflowEvents2 to inlet AutomationContext.AutomationWorkflowEventSplit.AutomationWorkflowEventSplitIn with {
    briefly "AutomationWorkflow events, fanned out to storage and read models"
  }
  connector 'AutomationMetrics Feed' is from outlet AutomationContext.AutomationWorkflowEventSplit.AutomationWorkflowEventSplitToAutomationMetrics to inlet AutomationContext.AutomationMetrics.AutomationMetricsFromAutomationWorkflow with {
    briefly "AutomationWorkflow events feeding the AutomationMetrics projection"
  }
  connector 'AutomationMetrics Storage' is from outlet AutomationContext.AutomationMetrics.AutomationMetricsToRepository to inlet AutomationContext.AutomationRepository.AutomationRepositoryFromAutomationMetrics with {
    briefly "AutomationMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for marketing automation"
  described as {
    |Marketing automation workflow context.
  }
}
