// Marketing Automation Domain Model
// Automated drip campaigns, lead nurturing, trigger-based messaging, A/B testing
domain MarketingAutomation is {
  persistent connector 'EmailDeliveryReply Stream' is from outlet EmailDelivery.EmailDeliveryRepliesOut to inlet AutomationContext.ToEmailDelivery.ToEmailDeliveryReplies with {
    briefly "What EmailDelivery answers AutomationContext"
  }
  persistent connector 'CRMSystemReply Stream' is from outlet CRMSystem.CRMSystemRepliesOut to inlet AutomationContext.ToCRMSystem.ToCRMSystemReplies with {
    briefly "What CRMSystem answers AutomationContext"
  }
  persistent connector 'CRMSystemEvent Stream' is from outlet CRMSystem.CRMSystemEventsOut to inlet AutomationContext.FromCRMSystem.FromCRMSystemIn with {
    briefly "What CRMSystem tells AutomationContext, unasked"
  }
  persistent connector 'EmailDeliveryEvent Stream' is from outlet EmailDelivery.EmailDeliveryEventsOut to inlet AutomationContext.FromEmailDelivery.FromEmailDeliveryIn with {
    briefly "What EmailDelivery tells AutomationContext, unasked"
  }
  persistent connector 'CRMSystemRequest Stream' is from outlet AutomationContext.ToCRMSystem.ToCRMSystemOut to inlet CRMSystem.CRMSystemRequests with {
    briefly "What AutomationContext asks CRMSystem to send"
  }
  persistent connector 'EmailDeliveryRequest Stream' is from outlet AutomationContext.ToEmailDelivery.ToEmailDeliveryOut to inlet EmailDelivery.EmailDeliveryRequests with {
    briefly "What AutomationContext asks EmailDelivery to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MarketingManager is "person designing automation workflows" with {
    briefly "Marketing Manager"
    described as {
      |Manager who designs and oversees automation campaigns.
    }
  }
  user CampaignAnalyst is "person analyzing campaign performance" with {
    briefly "Campaign Analyst"
    described as {
      |Analyst reviewing metrics and optimizing campaigns.
    }
  }
  user ContentCreator is "person crafting email and message content" with {
    briefly "Content Creator"
    described as {
      |Creator producing content for automated messages.
    }
  }
  epic AutomatedCampaignExecution is {
    user MarketingManager wants to "to launch automated drip campaigns" so that "leads are nurtured through personalized messaging sequences"
    case LaunchDripCampaign is {
      user MarketingManager wants to "to create and activate a drip campaign" so that "leads receive timed email sequences automatically"
      step is "Manager defines" "workflow steps and triggers" "for campaign" with {
        briefly "Define workflow"
        described as {
          |Set up automation steps.
        }
      }
      step is "System enrolls" "matching leads" "into campaign" with {
        briefly "Enroll leads"
        described as {
          |Add leads to workflow.
        }
      }
    } with {
      briefly "Launch drip campaign"
      described as {
        |Creating and activating an automated drip campaign.
      }
    }
  } with {
    briefly "Automated campaign execution"
    described as {
      |Epic for marketing automation campaign lifecycle.
    }
  }
  include "AutomationContext.riddl"
  include "external-contexts.riddl"
  application context MarketingAutomationApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MarketingAutomation are delivered.
      }
    }
    group MarketingAutomationScreen is {
      input ActivateWorkflowInput acquires command AutomationContext.AutomationWorkflow.ActivateWorkflow with {
        briefly "Activate workflow control"
        described as {
          |The control through which a user submits the activate workflow request.
        }
      }
      input ArchiveWorkflowInput acquires command AutomationContext.AutomationWorkflow.ArchiveWorkflow with {
        briefly "Archive workflow control"
        described as {
          |The control through which a user submits the archive workflow request.
        }
      }
      input CompleteWorkflowInput acquires command AutomationContext.AutomationWorkflow.CompleteWorkflow with {
        briefly "Complete workflow control"
        described as {
          |The control through which a user submits the complete workflow request.
        }
      }
      input ConfigureABTestInput acquires command AutomationContext.AutomationWorkflow.ConfigureABTest with {
        briefly "Configure AB test control"
        described as {
          |The control through which a user submits the configure ab test request.
        }
      }
      input PauseWorkflowInput acquires command AutomationContext.AutomationWorkflow.PauseWorkflow with {
        briefly "Pause workflow control"
        described as {
          |The control through which a user submits the pause workflow request.
        }
      }
      input RecordABTestResultInput acquires command AutomationContext.AutomationWorkflow.RecordABTestResult with {
        briefly "Record AB test result control"
        described as {
          |The control through which a user submits the record ab test result request.
        }
      }
      input ResumeWorkflowInput acquires command AutomationContext.AutomationWorkflow.ResumeWorkflow with {
        briefly "Resume workflow control"
        described as {
          |The control through which a user submits the resume workflow request.
        }
      }
      input CreateWorkflowInput acquires command AutomationContext.CreateWorkflow with {
        briefly "Create workflow control"
        described as {
          |The control through which a user submits the create workflow request.
        }
      }
    } with {
      briefly "Marketing automation screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAutomationWorkflowCommands is type AutomationContext.AutomationWorkflowRequest
    inlet AppAutomationRepositoryResponses is result AutomationContext.AutomationWorkflow.AutomationWorkflowResult
    handler MarketingAutomationAppHandler is {
      on other is {
        error "Unexpected message for application context MarketingAutomationApp"
      }
    } with {
      briefly "MarketingAutomationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MarketingAutomationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AutomationWorkflowCommand Stream' is from outlet MarketingAutomationApp.AppAutomationWorkflowCommands to inlet AutomationContext.AutomationWorkflowCommandStrIn with {
    briefly "AutomationWorkflow commands from the application"
  }
  persistent connector 'AutomationWorkflowResult Stream' is from outlet AutomationContext.AutomationWorkflowResultStreOut to inlet MarketingAutomationApp.AppAutomationRepositoryResponses with {
    briefly "Automation query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MarketingAutomationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Marketing automation domain"
  described as {
    |Automated drip campaigns, lead nurturing, and campaign optimization.
  }
}
