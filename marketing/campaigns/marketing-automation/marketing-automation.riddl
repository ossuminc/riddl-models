// Marketing Automation Domain Model
// Automated drip campaigns, lead nurturing, trigger-based messaging, A/B testing
domain MarketingAutomation is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MarketingManager is "person designing automation workflows" with {
    briefly "Marketing Manager"
    described as {
      |Manager who designs and oversees automation campaigns.
    }
  }
  user CampaignAnalyst is "person analyzing campaign performance" with {
    briefly "Campaign Analyst"
    described as {
      |Analyst reviewing metrics and optimizing campaigns.
    }
  }
  user ContentCreator is "person crafting email and message content" with {
    briefly "Content Creator"
    described as {
      |Creator producing content for automated messages.
    }
  }
  epic AutomatedCampaignExecution is {
    user MarketingManager wants to "to launch automated drip campaigns" so that "leads are nurtured through personalized messaging sequences"
    case LaunchDripCampaign is {
      user MarketingManager wants to "to create and activate a drip campaign" so that "leads receive timed email sequences automatically"
      step is "Manager defines" "workflow steps and triggers" "for campaign" with {
        briefly "Define workflow"
        described as {
          |Set up automation steps.
        }
      }
      step is "System enrolls" "matching leads" "into campaign" with {
        briefly "Enroll leads"
        described as {
          |Add leads to workflow.
        }
      }
    } with {
      briefly "Launch drip campaign"
      described as {
        |Creating and activating an automated drip campaign.
      }
    }
  } with {
    briefly "Automated campaign execution"
    described as {
      |Epic for marketing automation campaign lifecycle.
    }
  }
  include "AutomationContext.riddl"
  include "external-contexts.riddl"
  application context MarketingAutomationApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MarketingAutomation are delivered.
      }
    }
    outlet AppAutomationWorkflowCommands is type AutomationContext.AutomationWorkflow.AutomationWorkflowCommand
    inlet AppAutomationRepositoryResponses is type AutomationContext.AutomationWorkflow.AutomationWorkflowResult    handler MarketingAutomationAppHandler is {
      on other is {
        error "Unexpected message for application context MarketingAutomationApp"
      }
    } with {
      briefly "MarketingAutomationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MarketingAutomationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppAutomationWorkflowCommands is from outlet MarketingAutomationApp.AppAutomationWorkflowCommands to inlet AutomationContext.AutomationWorkflow.AutomationWorkflowCommands with {
    option persistent()
    briefly "LinkAppAutomationWorkflowCommands"
  }
  connector LinkAppAutomationRepositoryResponses is from outlet AutomationContext.AutomationRepository.AutomationRepositoryResponses to inlet MarketingAutomationApp.AppAutomationRepositoryResponses with {
    option persistent()
    briefly "LinkAppAutomationRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MarketingAutomationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Marketing automation domain"
  described as {
    |Automated drip campaigns, lead nurturing, and campaign optimization.
  }
}
