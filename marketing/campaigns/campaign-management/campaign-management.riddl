domain CampaignManagement is {
  persistent connector 'AnalyticsContextEvent Stream' is from outlet AnalyticsContext.AnalyticsContextEventsOut to inlet CampaignContext.FromAnalyticsContext.FromAnalyticsContextIn with {
    briefly "What AnalyticsContext tells CampaignContext, unasked"
  }
  persistent connector 'AudienceContextEvent Stream' is from outlet AudienceContext.AudienceContextEventsOut to inlet CampaignContext.FromAudienceContext.FromAudienceContextIn with {
    briefly "What AudienceContext tells CampaignContext, unasked"
  }
  persistent connector 'BillingContextEvent Stream' is from outlet BillingContext.BillingContextEventsOut to inlet CampaignContext.FromBillingContext.FromBillingContextIn with {
    briefly "What BillingContext tells CampaignContext, unasked"
  }
  persistent connector 'ChannelContextEvent Stream' is from outlet ChannelContext.ChannelContextEventsOut to inlet CampaignContext.FromChannelContext.FromChannelContextIn with {
    briefly "What ChannelContext tells CampaignContext, unasked"
  }
  persistent connector 'NotificationContextEvent Stream' is from outlet NotificationContext.NotificationContextEventsOut to inlet CampaignContext.FromNotificationContext.FromNotificationContextIn with {
    briefly "What NotificationContext tells CampaignContext, unasked"
  }
  persistent connector 'NotificationContextRequest Stream' is from outlet CampaignContext.ToNotificationContext.ToNotificationContextOut to inlet NotificationContext.NotificationContextRequests with {
    briefly "What CampaignContext asks NotificationContext to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Author of the Campaign Management domain model"
    described as {
      | Ossum Inc. provides enterprise software solutions
      | for reactive system design and implementation.
    }
  }
  user MarketingManager is "A marketing professional who creates and manages campaigns" with {
    briefly "Primary user responsible for campaign strategy"
    described as {
      | Marketing managers define campaign objectives, select target audiences,
      | allocate budgets, and monitor campaign performance across channels.
    }
  }
  user CampaignAnalyst is "A data analyst who monitors campaign performance" with {
    briefly "User focused on campaign analytics and reporting"
    described as {
      | Campaign analysts review performance metrics, generate reports,
      | and provide insights to optimize campaign effectiveness.
    }
  }
  user ContentCreator is "A creative professional who produces campaign content" with {
    briefly "User responsible for campaign creative assets"
    described as {
      | Content creators develop marketing materials including ads,
      | emails, social posts, and other campaign collateral.
    }
  }
  epic CampaignLifecycle is {
    user MarketingManager wants to "to manage marketing campaign lifecycles" so that "campaigns are effectively planned, executed, and measured"
    case CreateAndLaunchCampaign is {
      user MarketingManager wants to "to create and launch a marketing campaign" so that "I can reach target audiences and achieve business objectives"
      ???
    } with {
      briefly "Create and launch a new campaign"
      described as {
        | This use case covers the complete workflow from campaign creation
        | through launch, including audience selection, budget allocation,
        | channel configuration, and activation.
      }
    }
    case MonitorCampaignPerformance is {
      user CampaignAnalyst wants to "to monitor campaign performance metrics" so that "I can optimize campaigns and report on ROI"
      ???
    } with {
      briefly "Monitor and analyze campaign metrics"
      described as {
        | This use case enables real-time monitoring of campaign KPIs,
        | performance dashboards, and automated alerting when metrics
        | fall outside acceptable thresholds.
      }
    }
    case PauseCampaignExecution is {
      user MarketingManager wants to "to pause an active campaign" so that "I can stop spend while investigating issues"
      ???
    } with {
      briefly "Temporarily pause campaign execution"
      described as {
        | This use case allows managers to quickly pause campaigns
        | without losing configuration, enabling rapid response to
        | performance issues or market changes.
      }
    }
    case CompleteCampaignLifecycle is {
      user MarketingManager wants to "to complete a campaign and archive results" so that "I can close out the campaign and retain historical data"
      ???
    } with {
      briefly "Complete and archive a campaign"
      described as {
        | This use case handles the orderly completion of a campaign,
        | including final reporting, budget reconciliation, and
        | archival of all campaign data for future reference.
      }
    }
  } with {
    briefly "Campaign lifecycle management epic"
    described as {
      | The Campaign Lifecycle epic encompasses all use cases related
      | to creating, managing, monitoring, and completing marketing
      | campaigns from inception through archival.
    }
  }
  include "types.riddl"
  include "CampaignContext.riddl"
  include "external-contexts.riddl"
  application context CampaignManagementApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in CampaignManagement are delivered.
      }
    }
    group CampaignManagementScreen is {
      input GetCampaignPerformanceInput acquires query CampaignContext.CampaignRepository.GetCampaignPerformance with {
        briefly "Get campaign performance control"
        described as {
          |The control through which a user asks the get campaign performance question.
        }
      }
      input SearchCampaignsInput acquires query CampaignContext.CampaignRepository.SearchCampaigns with {
        briefly "Search campaigns control"
        described as {
          |The control through which a user asks the search campaigns question.
        }
      }
      input ListCampaignsByObjectiveInput acquires query CampaignContext.CampaignRepository.ListCampaignsByObjective with {
        briefly "List campaigns by objective control"
        described as {
          |The control through which a user asks the list campaigns by objective question.
        }
      }
      input ListCampaignsByStatusInput acquires query CampaignContext.CampaignRepository.ListCampaignsByStatus with {
        briefly "List campaigns by status control"
        described as {
          |The control through which a user asks the list campaigns by status question.
        }
      }
      input GetCampaignByIdInput acquires query CampaignContext.CampaignRepository.GetCampaignById with {
        briefly "Get campaign by id control"
        described as {
          |The control through which a user asks the get campaign by id question.
        }
      }
      input GetChannelComparisonInput acquires query CampaignContext.GetChannelComparison with {
        briefly "Get channel comparison control"
        described as {
          |The control through which a user asks the get channel comparison question.
        }
      }
      input GetPerformanceTimeSeriesInput acquires query CampaignContext.GetPerformanceTimeSeries with {
        briefly "Get performance time series control"
        described as {
          |The control through which a user asks the get performance time series question.
        }
      }
      input GetDashboardCampaignSummaryInput acquires query CampaignContext.GetDashboardCampaignSummary with {
        briefly "Get dashboard campaign summary control"
        described as {
          |The control through which a user asks the get dashboard campaign summary question.
        }
      }
      input FetchCampaignInput acquires query CampaignContext.Campaign.FetchCampaign with {
        briefly "Fetch campaign control"
        described as {
          |The control through which a user asks the fetch campaign question.
        }
      }
      input AddTargetAudienceInput acquires command CampaignContext.Campaign.AddTargetAudience with {
        briefly "Add target audience control"
        described as {
          |The control through which a user submits the add target audience request.
        }
      }
      input AllocateChannelBudgetInput acquires command CampaignContext.Campaign.AllocateChannelBudget with {
        briefly "Allocate channel budget control"
        described as {
          |The control through which a user submits the allocate channel budget request.
        }
      }
      input ArchiveCampaignInput acquires command CampaignContext.Campaign.ArchiveCampaign with {
        briefly "Archive campaign control"
        described as {
          |The control through which a user submits the archive campaign request.
        }
      }
      input CompleteCampaignInput acquires command CampaignContext.Campaign.CompleteCampaign with {
        briefly "Complete campaign control"
        described as {
          |The control through which a user submits the complete campaign request.
        }
      }
      input LaunchCampaignInput acquires command CampaignContext.Campaign.LaunchCampaign with {
        briefly "Launch campaign control"
        described as {
          |The control through which a user submits the launch campaign request.
        }
      }
      input ResumeCampaignInput acquires command CampaignContext.Campaign.ResumeCampaign with {
        briefly "Resume campaign control"
        described as {
          |The control through which a user submits the resume campaign request.
        }
      }
      input ScheduleCampaignInput acquires command CampaignContext.Campaign.ScheduleCampaign with {
        briefly "Schedule campaign control"
        described as {
          |The control through which a user submits the schedule campaign request.
        }
      }
      input UpdateCampaignDetailsInput acquires command CampaignContext.Campaign.UpdateCampaignDetails with {
        briefly "Update campaign details control"
        described as {
          |The control through which a user submits the update campaign details request.
        }
      }
      input CreateCampaignInput acquires command CampaignContext.CreateCampaign with {
        briefly "Create campaign control"
        described as {
          |The control through which a user submits the create campaign request.
        }
      }
      output CampaignCreatedView presents event CampaignContext.Campaign.CampaignCreated with {
        briefly "The campaign created answer"
        described as {
          |What CreateCampaign brought into being, with the id it was given.
        }
      }
    } with {
      briefly "Campaign management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppCampaignRepositoryQueries is type CampaignContext.CampaignRepository.CampaignRepositoryQuery
    inlet AppCampaignRepositoryReplies is type CampaignContext.CampaignRepository.CampaignRepositoryReply
    outlet AppCampaignQueries is query CampaignContext.Campaign.FetchCampaign
    outlet AppCampaignCommands is type CampaignContext.CampaignRequest
    inlet AppCampaignRepositoryResponses is result CampaignContext.Campaign.CampaignQueryResult
    inlet AppCampaignCreatedAnswer is event CampaignContext.Campaign.CampaignCreated
    handler CampaignManagementAppHandler is {
      on campaignCreated: event CampaignContext.Campaign.CampaignCreated is {
        put campaignCreated to output CampaignManagementApp.CampaignManagementScreen.CampaignCreatedView
      }
      on other is {
        error "Unexpected message for application context CampaignManagementApp"
      }
    } with {
      briefly "CampaignManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "CampaignManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'CampaignCreated Answer' is from outlet CampaignContext.CampaignCreatedAnswerOut to inlet CampaignManagementApp.AppCampaignCreatedAnswer with {
    briefly "The campaign created answer, back to the screen that issued CreateCampaign"
  }
  persistent connector 'CampaignRepositoryQuery Stream' is from outlet CampaignManagementApp.AppCampaignRepositoryQueries to inlet CampaignContext.CampaignRepositoryQueriesIn with {
    briefly "CampaignManagementApp's look-ups of the campaign repository"
  }
  persistent connector 'CampaignRepositoryReply Stream' is from outlet CampaignContext.CampaignRepositoryRepliesOut to inlet CampaignManagementApp.AppCampaignRepositoryReplies with {
    briefly "The campaign repository's answers returned to CampaignManagementApp"
  }
  persistent connector 'CampaignQuery Stream' is from outlet CampaignManagementApp.AppCampaignQueries to inlet CampaignContext.CampaignQueriesIn with {
    briefly "CampaignManagementApp's look-ups of the campaign"
  }
  persistent connector 'CampaignCommand Stream' is from outlet CampaignManagementApp.AppCampaignCommands to inlet CampaignContext.CampaignCommandStreamIn with {
    briefly "Campaign commands from the application"
  }
  persistent connector 'CampaignResult Stream' is from outlet CampaignContext.CampaignResultStreamOut to inlet CampaignManagementApp.AppCampaignRepositoryResponses with {
    briefly "Campaign query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet CampaignManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Marketing campaign management domain"
  described as {
    | The Campaign Management domain provides comprehensive capabilities
    | for planning, executing, and measuring marketing campaigns across
    | multiple channels. It supports the full campaign lifecycle from
    | initial planning through completion and analysis.
  }
}
