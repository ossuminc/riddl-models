// Campaign Management Bounded Context
context CampaignContext as router is {
  inlet CampaignCommandStreamIn is type CampaignCommand  outlet CampaignCommandStreamOut is type CampaignCommand
  inlet CampaignResultStreamIn is type Campaign.CampaignQueryResult  outlet CampaignResultStreamOut is type Campaign.CampaignQueryResult
  handler CampaignContextBoundary is {
    on createCampaign: command Campaign.CreateCampaign is {
      send createCampaign to outlet CampaignContext.CampaignCommandStreamOut
    }
    on updateCampaignDetails: command Campaign.UpdateCampaignDetails is {
      send updateCampaignDetails to outlet CampaignContext.CampaignCommandStreamOut
    }
    on allocateChannelBudget: command Campaign.AllocateChannelBudget is {
      send allocateChannelBudget to outlet CampaignContext.CampaignCommandStreamOut
    }
    on addTargetAudience: command Campaign.AddTargetAudience is {
      send addTargetAudience to outlet CampaignContext.CampaignCommandStreamOut
    }
    on removeTargetAudience: command Campaign.RemoveTargetAudience is {
      send removeTargetAudience to outlet CampaignContext.CampaignCommandStreamOut
    }
    on scheduleCampaign: command Campaign.ScheduleCampaign is {
      send scheduleCampaign to outlet CampaignContext.CampaignCommandStreamOut
    }
    on launchCampaign: command Campaign.LaunchCampaign is {
      send launchCampaign to outlet CampaignContext.CampaignCommandStreamOut
    }
    on pauseCampaign: command Campaign.PauseCampaign is {
      send pauseCampaign to outlet CampaignContext.CampaignCommandStreamOut
    }
    on resumeCampaign: command Campaign.ResumeCampaign is {
      send resumeCampaign to outlet CampaignContext.CampaignCommandStreamOut
    }
    on recordPerformanceUpdate: command Campaign.RecordPerformanceUpdate is {
      send recordPerformanceUpdate to outlet CampaignContext.CampaignCommandStreamOut
    }
    on completeCampaign: command Campaign.CompleteCampaign is {
      send completeCampaign to outlet CampaignContext.CampaignCommandStreamOut
    }
    on archiveCampaign: command Campaign.ArchiveCampaign is {
      send archiveCampaign to outlet CampaignContext.CampaignCommandStreamOut
    }
    on campaignQueryResult: result Campaign.CampaignQueryResult is {
      send campaignQueryResult to outlet CampaignContext.CampaignResultStreamOut
    }
    on other is {
      error "Unexpected message at the CampaignContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'CampaignCommand Stream Intake' is from outlet CampaignContext.CampaignCommandStreamOut to inlet CampaignContext.Campaign.CampaignCommands  connector 'CampaignResult Stream Egress' is from outlet CampaignContext.CampaignRepository.CampaignRepositoryResponses to inlet CampaignContext.CampaignResultStreamIn  adaptor FromAnalyticsContext from context AnalyticsContext is { 
    handler FromAnalyticsContextHandler is {
      on event AnalyticsContext.AnalyticsReportGenerated is {
        do "the model receives analytics report generated"
      }
      on event AnalyticsContext.AnomalyDetected is {
        do "the model receives anomaly detected"
      }
      on event AnalyticsContext.OptimizationRecommended is {
        do "the model receives optimization recommended"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsContext"
      }
    } with {
      briefly "from analytics context"
      described as {
        |Carries messages from the external AnalyticsContext.
      }
    }
  } with {
    briefly "AnalyticsContext integration"
    described as {
      |The model's side of the AnalyticsContext conversation.
    }
  }
  adaptor FromAudienceContext from context AudienceContext is { 
    handler FromAudienceContextHandler is {
      on event AudienceContext.AudienceDeactivated is {
        do "the model receives audience deactivated"
      }
      on event AudienceContext.AudienceUpdated is {
        do "the model receives audience updated"
      }
      on other is {
        error "Unexpected message for adaptor FromAudienceContext"
      }
    } with {
      briefly "from audience context"
      described as {
        |Carries messages from the external AudienceContext.
      }
    }
  } with {
    briefly "AudienceContext integration"
    described as {
      |The model's side of the AudienceContext conversation.
    }
  }
  adaptor FromBillingContext from context BillingContext is { 
    handler FromBillingContextHandler is {
      on event BillingContext.BudgetExhausted is {
        do "the model receives budget exhausted"
      }
      on event BillingContext.BudgetReplenished is {
        do "the model receives budget replenished"
      }
      on event BillingContext.PaymentFailed is {
        do "the model receives payment failed"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingContext"
      }
    } with {
      briefly "from billing context"
      described as {
        |Carries messages from the external BillingContext.
      }
    }
  } with {
    briefly "BillingContext integration"
    described as {
      |The model's side of the BillingContext conversation.
    }
  }
  adaptor FromChannelContext from context ChannelContext is { 
    handler FromChannelContextHandler is {
      on event ChannelContext.ChannelDeliveryStarted is {
        do "the model receives channel delivery started"
      }
      on event ChannelContext.ChannelDeliveryStopped is {
        do "the model receives channel delivery stopped"
      }
      on event ChannelContext.ChannelMetricsReceived is {
        do "the model receives channel metrics received"
      }
      on other is {
        error "Unexpected message for adaptor FromChannelContext"
      }
    } with {
      briefly "from channel context"
      described as {
        |Carries messages from the external ChannelContext.
      }
    }
  } with {
    briefly "ChannelContext integration"
    described as {
      |The model's side of the ChannelContext conversation.
    }
  }
  adaptor FromNotificationContext from context NotificationContext is { 
    handler FromNotificationContextHandler is {
      on event NotificationContext.NotificationFailed is {
        do "the model receives notification failed"
      }
      on event NotificationContext.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationContext"
      }
    } with {
      briefly "from notification context"
      described as {
        |Carries messages from the external NotificationContext.
      }
    }
  } with {
    briefly "NotificationContext integration"
    described as {
      |The model's side of the NotificationContext conversation.
    }
  }
  adaptor ToNotificationContext to context NotificationContext is { 
    handler ToNotificationContextHandler is {
      on command NotificationContext.SendAlertNotification is {
        do "the model sends send alert notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationContext"
      }
    } with {
      briefly "to notification context"
      described as {
        |Carries messages to the external NotificationContext.
      }
    }
  } with {
    briefly "NotificationContext integration"
    described as {
      |The model's side of the NotificationContext conversation.
    }
  }
  type CampaignId is Id(CampaignContext.Campaign)  with {
    briefly "Unique identifier for a campaign"
    described as {
      |A globally unique identifier that references a specific marketing campaign.
    }
  }
  include "Campaign.riddl"
  processor CampaignCommandSource as source is {
    outlet Commands is type CreateCampaign
    handler CampaignCommandEmitter is {
      on other is {
        let createCampaign: type Campaign.CreateCampaign = prompt("the create campaign to issue for this this")
        send createCampaign to outlet Commands
      }
    } with {
      briefly "Campaign command emitter"
      described as {
        |Publishes inbound campaign commands onto the outlet.
      }
    }
  } with {
    briefly "Source of campaign commands"
    described as {
      | Receives campaign commands from external systems and user interfaces.
    }
  }
  processor CampaignEventSink as sink is {
    inlet Events is type CampaignCreated    handler CampaignEventIntake is {
      on campaignCreated: event Campaign.CampaignCreated is {
        tell campaignCreated to repository CampaignContext.CampaignRepository
      }
      on other is {
        error "Unexpected message for sink CampaignEvents"
      }
    } with {
      briefly "Campaign event intake"
      described as {
        |Persists campaign events arriving on the inlet.
      }
    }
  } with {
    briefly "Sink for campaign events"
    described as {
      | Publishes campaign events for consumption by projectors,
      | external systems, and analytics pipelines.
    }
  }
  repository CampaignRepository as merge is {
    command PersistCampaignCompleted is  {
      campaignId: CampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignCompleted applies to.
        }
      }
    } with {
      briefly "Persist CampaignCompleted"
      described as {
        |Instructs this repository to apply CampaignCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignCreated is  {
      campaignId: CampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignCreated applies to.
        }
      }
    } with {
      briefly "Persist CampaignCreated"
      described as {
        |Instructs this repository to apply CampaignCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignLaunched is  {
      campaignId: CampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignLaunched applies to.
        }
      }
    } with {
      briefly "Persist CampaignLaunched"
      described as {
        |Instructs this repository to apply CampaignLaunched to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignPaused is  {
      campaignId: CampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignPaused applies to.
        }
      }
    } with {
      briefly "Persist CampaignPaused"
      described as {
        |Instructs this repository to apply CampaignPaused to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignResumed is  {
      campaignId: CampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignResumed applies to.
        }
      }
    } with {
      briefly "Persist CampaignResumed"
      described as {
        |Instructs this repository to apply CampaignResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPerformanceMetricsRecorded is  {
      campaignId: CampaignId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceMetricsRecorded applies to.
        }
      }
    } with {
      briefly "Persist PerformanceMetricsRecorded"
      described as {
        |Instructs this repository to apply PerformanceMetricsRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    record StoredCampaign is  {
      campaignId: CampaignId with {
        briefly "campaignId"
        described as {
          |The campaignId column of the stored campaign row.
        }
      }
    } with {
      briefly "Stored campaign row"
      described as {
        |The persistence shape of campaign data as this repository stores it.
      }
    }
    schema CampaignData is relational
      of campaigns as type StoredCampaign
        index on field StoredCampaign.campaignId
 with {
      briefly "Campaign data schema"
      described as {
        |The relational schema persisting campaign records for this repository.
      }
    }
    inlet CampaignRepositoryFromCampaign is type CampaignEvent    inlet CampaignRepositoryFromCampaignDashboardProjector is type CampaignEvent    inlet CampaignRepositoryFromCampaignPerformanceProjector is type CampaignEvent    outlet CampaignRepositoryResponses is type Campaign.CampaignQueryResult
    handler CampaignQueryHandler is {
      on persistCampaignCompleted: command PersistCampaignCompleted is {
        do "apply CampaignCompleted to the stored row"
      }
      on persistCampaignCreated: command PersistCampaignCreated is {
        do "apply CampaignCreated to the stored row"
      }
      on persistCampaignLaunched: command PersistCampaignLaunched is {
        do "apply CampaignLaunched to the stored row"
      }
      on persistCampaignPaused: command PersistCampaignPaused is {
        do "apply CampaignPaused to the stored row"
      }
      on persistCampaignResumed: command PersistCampaignResumed is {
        do "apply CampaignResumed to the stored row"
      }
      on persistPerformanceMetricsRecorded: command PersistPerformanceMetricsRecorded is {
        do "apply PerformanceMetricsRecorded to the stored row"
      }
      on query GetDashboardCampaignSummary is {
        let dashboardCampaignSummaryView: type DashboardCampaignSummaryView = prompt("read the dashboard campaign summary projection")
        reply dashboardCampaignSummaryView
      }
      on query GetPerformanceTimeSeries is {
        let performanceTimeSeriesView: type PerformanceTimeSeriesView = prompt("read the performance time series projection")
        reply performanceTimeSeriesView
      }
      on query GetChannelComparison is {
        let channelComparisonView: type ChannelComparisonView = prompt("read the channel comparison projection")
        reply channelComparisonView
      }
      on query GetCampaignById is {
        let campaignResult: type CampaignResult = prompt("read the campaign from the store")
        reply campaignResult
      }
      on query ListCampaignsByStatus is {
        let campaignListResult: type CampaignListResult = prompt("read the campaign list that campaigns by status asks for")
        reply campaignListResult
      }
      on query ListCampaignsByObjective is {
        let campaignListResult: type CampaignListResult = prompt("read the campaign list that campaigns by objective asks for")
        reply campaignListResult
      }
      on query SearchCampaigns is {
        let campaignListResult: type CampaignListResult = prompt("read the campaign list that campaigns asks for")
        reply campaignListResult
      }
      on getCampaignPerformance: query GetCampaignPerformance is {
        reply result PerformanceResult(campaignId = getCampaignPerformance.campaignId)
      }
    } with {
      briefly "Handler for campaign queries"
      described as {
        | Processes queries against the campaign repository,
        | returning campaign data and aggregations.
      }
    }
    query GetCampaignById is  { campaignId: CampaignId } with {
      briefly "Retrieve a campaign by ID"
      described as {
        |Returns the full campaign state for the specified ID.
      }
    }
    result CampaignResult is  { campaign: Campaign.CampaignStateRecord } with {
      briefly "Single campaign result"
      described as {
        |Contains the complete state of a single campaign.
      }
    }
    query ListCampaignsByStatus is  {
      status: CampaignStatus
      limit: Integer
      offset: Integer
    } with {
      briefly "List campaigns by status"
      described as {
        |Returns campaigns filtered by their current status.
      }
    }
    query ListCampaignsByObjective is  {
      objective: CampaignObjective
      limit: Integer
      offset: Integer
    } with {
      briefly "List campaigns by objective"
      described as {
        |Returns campaigns filtered by their strategic objective.
      }
    }
    query SearchCampaigns is  {
      namePattern: String
      statuses: CampaignStatus*
      objectives: CampaignObjective*
      startDateFrom: Date
      startDateTo: Date
      limit: Integer
      offset: Integer
    } with {
      briefly "Search campaigns with filters"
      described as {
        | Searches campaigns using multiple filter criteria including
        | name pattern matching, status, objective, and date range.
      }
    }
    result CampaignListResult is  {
      campaigns: Campaign.CampaignStateRecord*
      totalCount: Integer
    } with {
      briefly "List of campaigns result"
      described as {
        |Contains a paginated list of campaigns with total count.
      }
    }
    query GetCampaignPerformance is  {
      campaignId: CampaignId
      startDate: Date
      endDate: Date
    } with {
      briefly "Get campaign performance metrics"
      described as {
        |Returns performance metrics for a campaign within a date range.
      }
    }
    result PerformanceResult is  {
      campaignId: CampaignId
      metrics: PerformanceMetrics
      channelBreakdown: ChannelPerformance*
    } with {
      briefly "Campaign performance result"
      described as {
        |Contains aggregate and channel-level performance metrics.
      }
    }
  } with {
    briefly "Repository for campaign persistence and queries"
    described as {
      | The Campaign Repository handles persistence of campaign state
      | and provides query capabilities for campaign retrieval and search.
    }
  }
  query GetDashboardCampaignSummary is  {
    dashboardCampaignSummaryKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which dashboard campaign summary to retrieve.
      }
    }
  } with {
    briefly "Get dashboard campaign summary"
    described as {
      |Retrieves the dashboard campaign summary projection.
    }
  }
  result DashboardCampaignSummaryView is  {
    dashboardCampaignSummary: CampaignDashboardProjector.DashboardCampaignSummary with {
      briefly "Dashboard campaign summary"
      described as {
        |The dashboard campaign summary being returned.
      }
    }
  } with {
    briefly "Dashboard campaign summary view"
    described as {
      |Read model view carrying the dashboard campaign summary projection.
    }
  }
  projector CampaignDashboardProjector as flow is {
    updates repository CampaignContext.CampaignRepository
    inlet CampaignDashboardProjectorFromCampaign is type CampaignEvent    outlet CampaignDashboardProjectorOut is type CampaignEvent
    record DashboardCampaignSummary is  {
      campaignId: CampaignId
      name: CampaignName
      status: CampaignStatus
      objective: CampaignObjective
      totalBudget: BudgetAmount
      spentBudget: BudgetAmount
      impressions: PerformanceMetricValue
      clicks: PerformanceMetricValue
      conversions: PerformanceMetricValue
      returnOnAdSpend: Number
      lastUpdated: TimeStamp
    } with {
      briefly "Summary record for dashboard display"
      described as {
        | A denormalized view of campaign data optimized for
        | dashboard display and quick scanning.
      }
    }
    handler DashboardProjectionHandler is {
      on campaignCreated: event CampaignCreated is {
        tell command CampaignContext.CampaignRepository.PersistCampaignCreated(campaignId = campaignCreated.campaignId) to repository CampaignContext.CampaignRepository
      }
      on campaignLaunched: event CampaignLaunched is {
        tell command CampaignContext.CampaignRepository.PersistCampaignLaunched(campaignId = campaignLaunched.campaignId) to repository CampaignContext.CampaignRepository
      }
      on campaignPaused: event CampaignPaused is {
        tell command CampaignContext.CampaignRepository.PersistCampaignPaused(campaignId = campaignPaused.campaignId) to repository CampaignContext.CampaignRepository
      }
      on campaignResumed: event CampaignResumed is {
        tell command CampaignContext.CampaignRepository.PersistCampaignResumed(campaignId = campaignResumed.campaignId) to repository CampaignContext.CampaignRepository
      }
      on campaignCompleted: event CampaignCompleted is {
        tell command CampaignContext.CampaignRepository.PersistCampaignCompleted(campaignId = campaignCompleted.campaignId) to repository CampaignContext.CampaignRepository
      }
      on performanceMetricsRecorded: event PerformanceMetricsRecorded is {
        tell command CampaignContext.CampaignRepository.PersistPerformanceMetricsRecorded(campaignId = performanceMetricsRecorded.campaignId) to repository CampaignContext.CampaignRepository
      }
    } with {
      briefly "Handler for dashboard projection updates"
      described as {
        | Listens to campaign events and updates the dashboard
        | projection with current campaign status and metrics.
      }
    }
  } with {
    briefly "Projector for campaign dashboard views"
    described as {
      | Maintains a read-optimized projection of campaign data
      | for dashboard displays and quick status overviews.
    }
  }
  query GetPerformanceTimeSeries is  {
    performanceTimeSeriesKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which performance time series to retrieve.
      }
    }
  } with {
    briefly "Get performance time series"
    described as {
      |Retrieves the performance time series projection.
    }
  }
  result PerformanceTimeSeriesView is  {
    performanceTimeSeries: CampaignPerformanceProjector.PerformanceTimeSeries with {
      briefly "Performance time series"
      described as {
        |The performance time series being returned.
      }
    }
  } with {
    briefly "Performance time series view"
    described as {
      |Read model view carrying the performance time series projection.
    }
  }
  query GetChannelComparison is  {
    channelComparisonKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which channel comparison to retrieve.
      }
    }
  } with {
    briefly "Get channel comparison"
    described as {
      |Retrieves the channel comparison projection.
    }
  }
  result ChannelComparisonView is  {
    channelComparison: CampaignPerformanceProjector.ChannelComparison with {
      briefly "Channel comparison"
      described as {
        |The channel comparison being returned.
      }
    }
  } with {
    briefly "Channel comparison view"
    described as {
      |Read model view carrying the channel comparison projection.
    }
  }
  projector CampaignPerformanceProjector as flow is {
    updates repository CampaignContext.CampaignRepository
    inlet CampaignPerformanceProjectorFromCampaign is type CampaignEvent    outlet CampaignPerformanceProjectorOut is type CampaignEvent
    record PerformanceTimeSeries is  {
      campaignId: CampaignId
      date: Date
      impressions: PerformanceMetricValue
      clicks: PerformanceMetricValue
      conversions: PerformanceMetricValue
      spend: BudgetAmount
    } with {
      briefly "Daily performance time series record"
      described as {
        | Captures daily performance metrics for time series analysis
        | and trend visualization.
      }
    }
    record ChannelComparison is  {
      campaignId: CampaignId
      channelId: ChannelId
      channelType: ChannelType
      impressions: PerformanceMetricValue
      clicks: PerformanceMetricValue
      conversions: PerformanceMetricValue
      spend: BudgetAmount
      costPerConversion: Number
    } with {
      briefly "Channel comparison record"
      described as {
        | Enables side-by-side comparison of channel performance
        | within a campaign.
      }
    }
    handler PerformanceProjectionHandler is {
      on performanceMetricsRecorded: event PerformanceMetricsRecorded is {
        tell command CampaignContext.CampaignRepository.PersistPerformanceMetricsRecorded(campaignId = performanceMetricsRecorded.campaignId) to repository CampaignContext.CampaignRepository
      }
      on campaignCompleted: event CampaignCompleted is {
        tell command CampaignContext.CampaignRepository.PersistCampaignCompleted(campaignId = campaignCompleted.campaignId) to repository CampaignContext.CampaignRepository
      }
    } with {
      briefly "Handler for performance projection updates"
      described as {
        | Processes performance events to maintain time series
        | and channel comparison projections.
      }
    }
  } with {
    briefly "Projector for performance analytics"
    described as {
      | Maintains read-optimized projections of performance data
      | for analytics, reporting, and trend analysis.
    }
  }
  // ---- Command intake and event publication wiring ----
  processor CampaignCommandIntake as sink is {
    inlet IncomingCommands is type CreateCampaign    handler CampaignCommandIntakeHandler is {
      on other is {
        let createCampaign: type Campaign.CreateCampaign = prompt("the create campaign to issue for this this")
        tell createCampaign to entity CampaignContext.Campaign
      }
    } with {
      briefly "Campaign command intake"
      described as {
        |Routes inbound campaign commands to the Campaign entity.
      }
    }
  } with {
    briefly "Campaign command intake"
    described as {
      |Consumes commands published by CampaignCommands.
    }
  }
  processor CampaignEventPublisher as source is {
    outlet PublishedEvents is type CampaignCreated
    handler CampaignEventPublisherHandler is {
      on campaignCreated: event Campaign.CampaignCreated is {
        send campaignCreated to outlet PublishedEvents
      }
      on other is {
        error "Unexpected message for source CampaignEventPublisher"
      }
    } with {
      briefly "Campaign event publisher"
      described as {
        |Publishes campaign events for the event sink.
      }
    }
  } with {
    briefly "Campaign event publisher"
    described as {
      |Emits campaign events into the streaming topology.
    }
  }
  connector CampaignCommandFlow is from outlet CampaignContext.CampaignCommandSource.Commands to inlet CampaignContext.CampaignCommandIntake.IncomingCommands with {
    briefly "Campaign command flow"
    described as {
      |Connects the command source to its intake sink.
    }
  }
  connector CampaignEventPublishFlow is from outlet CampaignContext.CampaignEventPublisher.PublishedEvents to inlet CampaignContext.CampaignEventSink.Events with {
    briefly "Campaign event publish flow"
    described as {
      |Connects the event publisher to the event sink.
    }
  }
  processor CampaignEventSplit as split is {
    inlet CampaignEventSplitIn is type CampaignEvent    outlet CampaignEventSplitToCampaignRepository is type CampaignEvent
    outlet CampaignEventSplitToCampaignDashboardProjector is type CampaignEvent
    outlet CampaignEventSplitToCampaignPerformanceProjector is type CampaignEvent
    handler CampaignEventSplitHandler is {
      on campaignCreated: event Campaign.CampaignCreated is {
        send campaignCreated to outlet CampaignEventSplitToCampaignRepository
        send campaignCreated to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignCreated to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignCreated to entity CampaignContext.Campaign
      }
      on campaignDetailsUpdated: event Campaign.CampaignDetailsUpdated is {
        send campaignDetailsUpdated to outlet CampaignEventSplitToCampaignRepository
        send campaignDetailsUpdated to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignDetailsUpdated to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignDetailsUpdated to entity CampaignContext.Campaign
      }
      on channelBudgetAllocated: event Campaign.ChannelBudgetAllocated is {
        send channelBudgetAllocated to outlet CampaignEventSplitToCampaignRepository
        send channelBudgetAllocated to outlet CampaignEventSplitToCampaignDashboardProjector
        send channelBudgetAllocated to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell channelBudgetAllocated to entity CampaignContext.Campaign
      }
      on targetAudienceAdded: event Campaign.TargetAudienceAdded is {
        send targetAudienceAdded to outlet CampaignEventSplitToCampaignRepository
        send targetAudienceAdded to outlet CampaignEventSplitToCampaignDashboardProjector
        send targetAudienceAdded to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell targetAudienceAdded to entity CampaignContext.Campaign
      }
      on targetAudienceRemoved: event Campaign.TargetAudienceRemoved is {
        send targetAudienceRemoved to outlet CampaignEventSplitToCampaignRepository
        send targetAudienceRemoved to outlet CampaignEventSplitToCampaignDashboardProjector
        send targetAudienceRemoved to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell targetAudienceRemoved to entity CampaignContext.Campaign
      }
      on campaignScheduled: event Campaign.CampaignScheduled is {
        send campaignScheduled to outlet CampaignEventSplitToCampaignRepository
        send campaignScheduled to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignScheduled to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignScheduled to entity CampaignContext.Campaign
      }
      on campaignLaunched: event Campaign.CampaignLaunched is {
        send campaignLaunched to outlet CampaignEventSplitToCampaignRepository
        send campaignLaunched to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignLaunched to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignLaunched to entity CampaignContext.Campaign
      }
      on campaignPaused: event Campaign.CampaignPaused is {
        send campaignPaused to outlet CampaignEventSplitToCampaignRepository
        send campaignPaused to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignPaused to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignPaused to entity CampaignContext.Campaign
      }
      on campaignResumed: event Campaign.CampaignResumed is {
        send campaignResumed to outlet CampaignEventSplitToCampaignRepository
        send campaignResumed to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignResumed to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignResumed to entity CampaignContext.Campaign
      }
      on performanceMetricsRecorded: event Campaign.PerformanceMetricsRecorded is {
        send performanceMetricsRecorded to outlet CampaignEventSplitToCampaignRepository
        send performanceMetricsRecorded to outlet CampaignEventSplitToCampaignDashboardProjector
        send performanceMetricsRecorded to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell performanceMetricsRecorded to entity CampaignContext.Campaign
      }
      on campaignCompleted: event Campaign.CampaignCompleted is {
        send campaignCompleted to outlet CampaignEventSplitToCampaignRepository
        send campaignCompleted to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignCompleted to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignCompleted to entity CampaignContext.Campaign
      }
      on campaignArchived: event Campaign.CampaignArchived is {
        send campaignArchived to outlet CampaignEventSplitToCampaignRepository
        send campaignArchived to outlet CampaignEventSplitToCampaignDashboardProjector
        send campaignArchived to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell campaignArchived to entity CampaignContext.Campaign
      }
      on other is {
        error "Unexpected message for processor CampaignEventSplit"
      }
    } with {
      briefly "Campaign event fan-out handler"
      described as {
        |Delivers each Campaign event to all of its consumers.
      }
    }
  } with {
    briefly "Campaign event fan-out"
    described as {
      |Fans Campaign events out to the repository and projectors.
    }
  }
  connector 'CampaignEvent Stream' is from outlet CampaignContext.Campaign.CampaignEvents to inlet CampaignContext.CampaignEventSplit.CampaignEventSplitIn with {
    briefly "Campaign events, fanned out to storage and read models"
  }
  connector 'CampaignEvent Storage' is from outlet CampaignContext.CampaignEventSplit.CampaignEventSplitToCampaignRepository to inlet CampaignContext.CampaignRepository.CampaignRepositoryFromCampaign with {
    briefly "Campaign events on their way to storage"
  }
  connector 'CampaignDashboardProjector Feed' is from outlet CampaignContext.CampaignEventSplit.CampaignEventSplitToCampaignDashboardProjector to inlet CampaignContext.CampaignDashboardProjector.CampaignDashboardProjectorFromCampaign with {
    briefly "Campaign events feeding the CampaignDashboardProjector projection"
  }
  connector 'CampaignPerformanceProjector Feed' is from outlet CampaignContext.CampaignEventSplit.CampaignEventSplitToCampaignPerformanceProjector to inlet CampaignContext.CampaignPerformanceProjector.CampaignPerformanceProjectorFromCampaign with {
    briefly "Campaign events feeding the CampaignPerformanceProjector projection"
  }
  connector 'CampaignDashboardProjector Storage' is from outlet CampaignContext.CampaignDashboardProjector.CampaignDashboardProjectorOut to inlet CampaignContext.CampaignRepository.CampaignRepositoryFromCampaignDashboardProjector with {
    briefly "The CampaignDashboardProjector projection on its way to storage"
  }
  connector 'CampaignPerformanceProjector Storage' is from outlet CampaignContext.CampaignPerformanceProjector.CampaignPerformanceProjectorOut to inlet CampaignContext.CampaignRepository.CampaignRepositoryFromCampaignPerformanceProjector with {
    briefly "The CampaignPerformanceProjector projection on its way to storage"
  }
} with {
  briefly "Bounded context for campaign management"
  described as {
    | The Campaign Context encapsulates all campaign management capabilities
    | including the Campaign aggregate, repositories for persistence and query,
    | and projectors for read-optimized views.
  }
}
