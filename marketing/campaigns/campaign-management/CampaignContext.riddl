// Campaign Management Bounded Context
context CampaignContext is {
  adaptor FromAnalyticsContext from context AnalyticsContext is {
    handler FromAnalyticsContextHandler is {
      on event AnalyticsContext.AnalyticsReportGenerated is {
        do "the model receives analytics report generated"
      }
      on event AnalyticsContext.AnomalyDetected is {
        do "the model receives anomaly detected"
      }
      on event AnalyticsContext.OptimizationRecommended is {
        do "the model receives optimization recommended"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsContext"
      }
    } with {
      briefly "from analytics context"
      described as {
        |Carries messages from the external AnalyticsContext.
      }
    }
  } with {
      briefly "AnalyticsContext integration"
    described as {
      |The model's side of the AnalyticsContext conversation.
    }
  }
  adaptor FromAudienceContext from context AudienceContext is {
    handler FromAudienceContextHandler is {
      on event AudienceContext.AudienceDeactivated is {
        do "the model receives audience deactivated"
      }
      on event AudienceContext.AudienceUpdated is {
        do "the model receives audience updated"
      }
      on other is {
        error "Unexpected message for adaptor FromAudienceContext"
      }
    } with {
      briefly "from audience context"
      described as {
        |Carries messages from the external AudienceContext.
      }
    }
  } with {
      briefly "AudienceContext integration"
    described as {
      |The model's side of the AudienceContext conversation.
    }
  }
  adaptor FromBillingContext from context BillingContext is {
    handler FromBillingContextHandler is {
      on event BillingContext.BudgetExhausted is {
        do "the model receives budget exhausted"
      }
      on event BillingContext.BudgetReplenished is {
        do "the model receives budget replenished"
      }
      on event BillingContext.PaymentFailed is {
        do "the model receives payment failed"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingContext"
      }
    } with {
      briefly "from billing context"
      described as {
        |Carries messages from the external BillingContext.
      }
    }
  } with {
      briefly "BillingContext integration"
    described as {
      |The model's side of the BillingContext conversation.
    }
  }
  adaptor FromChannelContext from context ChannelContext is {
    handler FromChannelContextHandler is {
      on event ChannelContext.ChannelDeliveryStarted is {
        do "the model receives channel delivery started"
      }
      on event ChannelContext.ChannelDeliveryStopped is {
        do "the model receives channel delivery stopped"
      }
      on event ChannelContext.ChannelMetricsReceived is {
        do "the model receives channel metrics received"
      }
      on other is {
        error "Unexpected message for adaptor FromChannelContext"
      }
    } with {
      briefly "from channel context"
      described as {
        |Carries messages from the external ChannelContext.
      }
    }
  } with {
      briefly "ChannelContext integration"
    described as {
      |The model's side of the ChannelContext conversation.
    }
  }
  adaptor FromNotificationContext from context NotificationContext is {
    handler FromNotificationContextHandler is {
      on event NotificationContext.NotificationFailed is {
        do "the model receives notification failed"
      }
      on event NotificationContext.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationContext"
      }
    } with {
      briefly "from notification context"
      described as {
        |Carries messages from the external NotificationContext.
      }
    }
  } with {
      briefly "NotificationContext integration"
    described as {
      |The model's side of the NotificationContext conversation.
    }
  }
  adaptor ToNotificationContext to context NotificationContext is {
    handler ToNotificationContextHandler is {
      on command NotificationContext.SendAlertNotification is {
        do "the model sends send alert notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationContext"
      }
    } with {
      briefly "to notification context"
      described as {
        |Carries messages to the external NotificationContext.
      }
    }
  } with {
      briefly "NotificationContext integration"
    described as {
      |The model's side of the NotificationContext conversation.
    }
  }
  type CampaignId is Id(CampaignContext.Campaign)  with {
    briefly "Unique identifier for a campaign"
    described as {
      |A globally unique identifier that references a specific marketing campaign.
    }
  }
  include "Campaign.riddl"
  processor CampaignCommandSource as source is {
    outlet Commands is type CreateCampaign
    handler CampaignCommandEmitter is {
      on command Campaign.CreateCampaign is {
        send command Campaign.CreateCampaign to outlet Commands
      }
      on other is {
        error "Unexpected message for source CampaignCommands"
      }
    } with {
      briefly "Campaign command emitter"
      described as {
        |Publishes inbound campaign commands onto the outlet.
      }
    }
  } with {
    briefly "Source of campaign commands"
    described as {
      | Receives campaign commands from external systems and user interfaces.
    }
  }
  processor CampaignEventSink as sink is {
    inlet Events is type CampaignCreated
    handler CampaignEventIntake is {
      on event Campaign.CampaignCreated is {
        tell event Campaign.CampaignCreated to repository
          CampaignContext.CampaignRepository
      }
      on other is {
        error "Unexpected message for sink CampaignEvents"
      }
    } with {
      briefly "Campaign event intake"
      described as {
        |Persists campaign events arriving on the inlet.
      }
    }
  } with {
    briefly "Sink for campaign events"
    described as {
      | Publishes campaign events for consumption by projectors,
      | external systems, and analytics pipelines.
    }
  }
  repository CampaignRepository is {
    record StoredCampaign is {
      campaignId: CampaignId with {
        briefly "campaignId"
        described as {
          |The campaignId column of the stored campaign row.
        }
      }
    } with {
      briefly "Stored campaign row"
      described as {
        |The persistence shape of campaign data as this repository stores it.
      }
    }
    schema CampaignData is relational
      of campaigns as type StoredCampaign
      with {
      briefly "Campaign data schema"
      described as {
        |The relational schema persisting campaign records for this repository.
      }
    }
    inlet CampaignRepositoryFromCampaign is type CampaignEvent
    inlet CampaignRepositoryFromCampaignDashboardProjector is type CampaignEvent
    inlet CampaignRepositoryFromCampaignPerformanceProjector is type CampaignEvent
    outlet CampaignRepositoryResponses is type Campaign.CampaignQueryResult
    handler CampaignQueryHandler is {
      on query GetCampaignById is {
        yield result CampaignResult
      }
      on query ListCampaignsByStatus is {
        yield result CampaignResult
      }
      on query ListCampaignsByObjective is {
        yield result CampaignResult
      }
      on query SearchCampaigns is {
        yield result CampaignResult
      }
      on query GetCampaignPerformance is {
        yield result CampaignResult
      }
    } with {
      briefly "Handler for campaign queries"
      described as {
        | Processes queries against the campaign repository,
        | returning campaign data and aggregations.
      }
    }
    query GetCampaignById is  { campaignId: CampaignId } with {
      briefly "Retrieve a campaign by ID"
      described as {
        |Returns the full campaign state for the specified ID.
      }
    }
    result CampaignResult is  { campaign: Campaign.CampaignStateRecord } with {
      briefly "Single campaign result"
      described as {
        |Contains the complete state of a single campaign.
      }
    }
    query ListCampaignsByStatus is  {
      status: CampaignStatus
      limit: Integer
      offset: Integer
    } with {
      briefly "List campaigns by status"
      described as {
        |Returns campaigns filtered by their current status.
      }
    }
    query ListCampaignsByObjective is  {
      objective: CampaignObjective
      limit: Integer
      offset: Integer
    } with {
      briefly "List campaigns by objective"
      described as {
        |Returns campaigns filtered by their strategic objective.
      }
    }
    query SearchCampaigns is  {
      namePattern: String
      statuses: CampaignStatus*
      objectives: CampaignObjective*
      startDateFrom: Date
      startDateTo: Date
      limit: Integer
      offset: Integer
    } with {
      briefly "Search campaigns with filters"
      described as {
        | Searches campaigns using multiple filter criteria including
        | name pattern matching, status, objective, and date range.
      }
    }
    result CampaignListResult is  {
      campaigns: Campaign.CampaignStateRecord*
      totalCount: Integer
    } with {
      briefly "List of campaigns result"
      described as {
        |Contains a paginated list of campaigns with total count.
      }
    }
    query GetCampaignPerformance is  {
      campaignId: CampaignId
      startDate: Date
      endDate: Date
    } with {
      briefly "Get campaign performance metrics"
      described as {
        |Returns performance metrics for a campaign within a date range.
      }
    }
    result PerformanceResult is  {
      campaignId: CampaignId
      metrics: PerformanceMetrics
      channelBreakdown: ChannelPerformance*
    } with {
      briefly "Campaign performance result"
      described as {
        |Contains aggregate and channel-level performance metrics.
      }
    }
  } with {
    briefly "Repository for campaign persistence and queries"
    described as {
      | The Campaign Repository handles persistence of campaign state
      | and provides query capabilities for campaign retrieval and search.
    }
  }
  projector CampaignDashboardProjector is {
    inlet CampaignDashboardProjectorFromCampaign is type CampaignEvent
    outlet CampaignDashboardProjectorOut is type CampaignEvent
    updates repository CampaignContext.CampaignRepository
    record DashboardCampaignSummary is  {
      campaignId: CampaignId
      name: CampaignName
      status: CampaignStatus
      objective: CampaignObjective
      totalBudget: BudgetAmount
      spentBudget: BudgetAmount
      impressions: PerformanceMetricValue
      clicks: PerformanceMetricValue
      conversions: PerformanceMetricValue
      returnOnAdSpend: Number
      lastUpdated: TimeStamp
    } with {
      briefly "Summary record for dashboard display"
      described as {
        | A denormalized view of campaign data optimized for
        | dashboard display and quick scanning.
      }
    }
    handler DashboardProjectionHandler is {
      on event CampaignCreated is {
        tell event CampaignCreated to repository CampaignContext.CampaignRepository
      }
      on event CampaignLaunched is {
        tell event CampaignLaunched to repository CampaignContext.CampaignRepository
      }
      on event CampaignPaused is {
        tell event CampaignPaused to repository CampaignContext.CampaignRepository
      }
      on event CampaignResumed is {
        tell event CampaignResumed to repository CampaignContext.CampaignRepository
      }
      on event CampaignCompleted is {
        tell event CampaignCompleted to repository CampaignContext.CampaignRepository
      }
      on event PerformanceMetricsRecorded is {
        tell event PerformanceMetricsRecorded to repository CampaignContext.CampaignRepository
      }
    } with {
      briefly "Handler for dashboard projection updates"
      described as {
        | Listens to campaign events and updates the dashboard
        | projection with current campaign status and metrics.
      }
    }
  } with {
    briefly "Projector for campaign dashboard views"
    described as {
      | Maintains a read-optimized projection of campaign data
      | for dashboard displays and quick status overviews.
    }
  }
  projector CampaignPerformanceProjector is {
    inlet CampaignPerformanceProjectorFromCampaign is type CampaignEvent
    outlet CampaignPerformanceProjectorOut is type CampaignEvent
    updates repository CampaignContext.CampaignRepository
    record PerformanceTimeSeries is  {
      campaignId: CampaignId
      date: Date
      impressions: PerformanceMetricValue
      clicks: PerformanceMetricValue
      conversions: PerformanceMetricValue
      spend: BudgetAmount
    } with {
      briefly "Daily performance time series record"
      described as {
        | Captures daily performance metrics for time series analysis
        | and trend visualization.
      }
    }
    record ChannelComparison is  {
      campaignId: CampaignId
      channelId: ChannelId
      channelType: ChannelType
      impressions: PerformanceMetricValue
      clicks: PerformanceMetricValue
      conversions: PerformanceMetricValue
      spend: BudgetAmount
      costPerConversion: Number
    } with {
      briefly "Channel comparison record"
      described as {
        | Enables side-by-side comparison of channel performance
        | within a campaign.
      }
    }
    handler PerformanceProjectionHandler is {
      on event PerformanceMetricsRecorded is {
        tell event PerformanceMetricsRecorded to repository CampaignContext.CampaignRepository
      }
      on event CampaignCompleted is {
        tell event CampaignCompleted to repository CampaignContext.CampaignRepository
      }
    } with {
      briefly "Handler for performance projection updates"
      described as {
        | Processes performance events to maintain time series
        | and channel comparison projections.
      }
    }
  } with {
    briefly "Projector for performance analytics"
    described as {
      | Maintains read-optimized projections of performance data
      | for analytics, reporting, and trend analysis.
    }
  }
  // ---- Command intake and event publication wiring ----
  processor CampaignCommandIntake as sink is {
    inlet IncomingCommands is type CreateCampaign
    handler CampaignCommandIntakeHandler is {
      on command Campaign.CreateCampaign is {
        tell command Campaign.CreateCampaign to entity CampaignContext.Campaign
      }
      on other is {
        error "Unexpected message for sink CampaignCommandIntake"
      }
    } with {
      briefly "Campaign command intake"
      described as {
        |Routes inbound campaign commands to the Campaign entity.
      }
    }
  } with {
    briefly "Campaign command intake"
    described as {
      |Consumes commands published by CampaignCommands.
    }
  }
  processor CampaignEventPublisher as source is {
    outlet PublishedEvents is type CampaignCreated
    handler CampaignEventPublisherHandler is {
      on event Campaign.CampaignCreated is {
        send event Campaign.CampaignCreated to outlet PublishedEvents
      }
      on other is {
        error "Unexpected message for source CampaignEventPublisher"
      }
    } with {
      briefly "Campaign event publisher"
      described as {
        |Publishes campaign events for the event sink.
      }
    }
  } with {
    briefly "Campaign event publisher"
    described as {
      |Emits campaign events into the streaming topology.
    }
  }
  connector CampaignCommandFlow is {
    from outlet CampaignContext.CampaignCommandSource.Commands to
      inlet CampaignContext.CampaignCommandIntake.IncomingCommands
  } with {
    briefly "Campaign command flow"
    described as {
      |Connects the command source to its intake sink.
    }
  }
  connector CampaignEventPublishFlow is {
    from outlet CampaignContext.CampaignEventPublisher.PublishedEvents to
      inlet CampaignContext.CampaignEventSink.Events
  } with {
    briefly "Campaign event publish flow"
    described as {
      |Connects the event publisher to the event sink.
    }
  }
  processor CampaignEventSplit is {
    inlet CampaignEventSplitIn is type CampaignEvent
    outlet CampaignEventSplitToCampaignRepository is type CampaignEvent
    outlet CampaignEventSplitToCampaignDashboardProjector is type CampaignEvent
    outlet CampaignEventSplitToCampaignPerformanceProjector is type CampaignEvent
    handler CampaignEventSplitHandler is {
      on event Campaign.CampaignCreated is {
        send event Campaign.CampaignCreated to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignCreated to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignCreated to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignCreated to entity CampaignContext.Campaign
      }
      on event Campaign.CampaignDetailsUpdated is {
        send event Campaign.CampaignDetailsUpdated to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignDetailsUpdated to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignDetailsUpdated to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignDetailsUpdated to entity CampaignContext.Campaign
      }
      on event Campaign.ChannelBudgetAllocated is {
        send event Campaign.ChannelBudgetAllocated to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.ChannelBudgetAllocated to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.ChannelBudgetAllocated to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.ChannelBudgetAllocated to entity CampaignContext.Campaign
      }
      on event Campaign.TargetAudienceAdded is {
        send event Campaign.TargetAudienceAdded to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.TargetAudienceAdded to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.TargetAudienceAdded to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.TargetAudienceAdded to entity CampaignContext.Campaign
      }
      on event Campaign.TargetAudienceRemoved is {
        send event Campaign.TargetAudienceRemoved to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.TargetAudienceRemoved to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.TargetAudienceRemoved to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.TargetAudienceRemoved to entity CampaignContext.Campaign
      }
      on event Campaign.CampaignScheduled is {
        send event Campaign.CampaignScheduled to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignScheduled to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignScheduled to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignScheduled to entity CampaignContext.Campaign
      }
      on event Campaign.CampaignLaunched is {
        send event Campaign.CampaignLaunched to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignLaunched to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignLaunched to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignLaunched to entity CampaignContext.Campaign
      }
      on event Campaign.CampaignPaused is {
        send event Campaign.CampaignPaused to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignPaused to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignPaused to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignPaused to entity CampaignContext.Campaign
      }
      on event Campaign.CampaignResumed is {
        send event Campaign.CampaignResumed to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignResumed to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignResumed to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignResumed to entity CampaignContext.Campaign
      }
      on event Campaign.PerformanceMetricsRecorded is {
        send event Campaign.PerformanceMetricsRecorded to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.PerformanceMetricsRecorded to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.PerformanceMetricsRecorded to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.PerformanceMetricsRecorded to entity CampaignContext.Campaign
      }
      on event Campaign.CampaignCompleted is {
        send event Campaign.CampaignCompleted to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignCompleted to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignCompleted to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignCompleted to entity CampaignContext.Campaign
      }
      on event Campaign.CampaignArchived is {
        send event Campaign.CampaignArchived to outlet CampaignEventSplitToCampaignRepository
        send event Campaign.CampaignArchived to outlet CampaignEventSplitToCampaignDashboardProjector
        send event Campaign.CampaignArchived to outlet CampaignEventSplitToCampaignPerformanceProjector
        tell event Campaign.CampaignArchived to entity CampaignContext.Campaign
      }
      on other is {
        error "Unexpected message for processor CampaignEventSplit"
      }
    } with {
      briefly "Campaign event fan-out handler"
      described as {
        |Delivers each Campaign event to all of its consumers.
      }
    }
  } with {
    briefly "Campaign event fan-out"
    described as {
      |Fans Campaign events out to the repository and projectors.
    }
  }
  connector LinkCampaignToCampaignEventSplit is {
    from outlet CampaignContext.Campaign.CampaignEvents to
      inlet CampaignContext.CampaignEventSplit.CampaignEventSplitIn
  } with {
    briefly "LinkCampaignToCampaignEventSplit"
  }
  connector LinkCampaignEventSplitToCampaignRepository is {
    from outlet CampaignContext.CampaignEventSplit.CampaignEventSplitToCampaignRepository to
      inlet CampaignContext.CampaignRepository.CampaignRepositoryFromCampaign
  } with {
    briefly "LinkCampaignEventSplitToCampaignRepository"
  }
  connector LinkCampaignEventSplitToCampaignDashboardProjector is {
    from outlet CampaignContext.CampaignEventSplit.CampaignEventSplitToCampaignDashboardProjector to
      inlet CampaignContext.CampaignDashboardProjector.CampaignDashboardProjectorFromCampaign
  } with {
    briefly "LinkCampaignEventSplitToCampaignDashboardProjector"
  }
  connector LinkCampaignEventSplitToCampaignPerformanceProjector is {
    from outlet CampaignContext.CampaignEventSplit.CampaignEventSplitToCampaignPerformanceProjector to
      inlet CampaignContext.CampaignPerformanceProjector.CampaignPerformanceProjectorFromCampaign
  } with {
    briefly "LinkCampaignEventSplitToCampaignPerformanceProjector"
  }
  connector LinkCampaignDashboardProjectorToCampaignRepository is {
    from outlet CampaignContext.CampaignDashboardProjector.CampaignDashboardProjectorOut to
      inlet CampaignContext.CampaignRepository.CampaignRepositoryFromCampaignDashboardProjector
  } with {
    briefly "LinkCampaignDashboardProjectorToCampaignRepository"
  }
  connector LinkCampaignPerformanceProjectorToCampaignRepository is {
    from outlet CampaignContext.CampaignPerformanceProjector.CampaignPerformanceProjectorOut to
      inlet CampaignContext.CampaignRepository.CampaignRepositoryFromCampaignPerformanceProjector
  } with {
    briefly "LinkCampaignPerformanceProjectorToCampaignRepository"
  }
} with {
  briefly "Bounded context for campaign management"
  described as {
    | The Campaign Context encapsulates all campaign management capabilities
    | including the Campaign aggregate, repositories for persistence and query,
    | and projectors for read-optimized views.
  }
}
