// Campaign Entity
aggregate event-sourced entity Campaign as flow is {
  type CampaignCommand is one of {
    Campaign.CreateCampaign or Campaign.UpdateCampaignDetails or Campaign.AllocateChannelBudget or Campaign.AddTargetAudience or Campaign.RemoveTargetAudience or Campaign.ScheduleCampaign or Campaign.LaunchCampaign or Campaign.PauseCampaign or Campaign.ResumeCampaign or Campaign.RecordPerformanceUpdate or Campaign.CompleteCampaign or Campaign.ArchiveCampaign
  } with {
    briefly "Campaign command alternation"
    described as {
      |Commands accepted by the Campaign entity.
    }
  }
  type CampaignEvent is one of {
    Campaign.CampaignCreated or Campaign.CampaignDetailsUpdated or Campaign.ChannelBudgetAllocated or Campaign.TargetAudienceAdded or Campaign.TargetAudienceRemoved or Campaign.CampaignScheduled or Campaign.CampaignLaunched or Campaign.CampaignPaused or Campaign.CampaignResumed or Campaign.PerformanceMetricsRecorded or Campaign.CampaignCompleted or Campaign.CampaignArchived
  } with {
    briefly "Campaign event alternation"
    described as {
      |Events published by the Campaign entity.
    }
  }
  inlet CampaignCommands is type CampaignCommand  outlet CampaignEvents is type CampaignEvent
  query FetchCampaign replies result CampaignQueryResult is  {
    campaignId: CampaignId with {
      briefly "ID"
      described as {
        |Identifier of the Campaign to retrieve.
      }
    }
  } with {
    briefly "Get Campaign"
    described as {
      |Retrieve Campaign data by identifier.
    }
  }
  result CampaignQueryResult is  {
    campaignId: CampaignId with {
      briefly "Campaign addressed"
      described as {
        |Which campaign this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    campaignData: Campaign.CampaignStateRecord with {
      briefly "Campaign data"
      described as {
        |The requested Campaign data.
      }
    }
  } with {
    briefly "Campaign result"
    described as {
      |Result carrying the requested Campaign data.
    }
  }
  // Commands
  command CreateCampaign yields event CampaignCreated is  {
    campaignId: CampaignId
    name: CampaignName
    objective: CampaignObjective
    schedule: CampaignSchedule
    totalBudget: BudgetAmount
  } with {
    briefly "Create a new marketing campaign"
    described as {
      | Initializes a new campaign with basic configuration including
      | name, objective, schedule, and budget. The campaign starts in Draft status.
    }
  }
  command UpdateCampaignDetails yields event CampaignDetailsUpdated is  {
    campaignId: CampaignId
    name: CampaignName
    objective: CampaignObjective
    schedule: CampaignSchedule
  } with {
    briefly "Update campaign details"
    described as {
      | Modifies the campaign name, objective, or schedule.
      | Only allowed when campaign is in Draft or Paused status.
    }
  }
  command AllocateChannelBudget yields event ChannelBudgetAllocated is  {
    campaignId: CampaignId
    allocation: ChannelAllocation
  } with {
    briefly "Allocate budget to a channel"
    described as {
      | Assigns a portion of the campaign budget to a specific channel.
      | Total channel allocations cannot exceed the campaign budget.
    }
  }
  command AddTargetAudience yields event TargetAudienceAdded is  {
    campaignId: CampaignId
    audience: AudienceTarget
  } with {
    briefly "Add a target audience to the campaign"
    described as {
      | Includes an audience segment in the campaign targeting.
      | Multiple audiences can be added with different priorities.
    }
  }
  command RemoveTargetAudience yields event TargetAudienceRemoved is  {
    campaignId: CampaignId
    audienceId: AudienceId
  } with {
    briefly "Remove a target audience from the campaign"
    described as {
      | Removes an audience segment from campaign targeting.
    }
  }
  command ScheduleCampaign yields event CampaignScheduled is  { campaignId: CampaignId } with {
    briefly "Schedule the campaign for launch"
    described as {
      | Transitions the campaign from Draft to Scheduled status.
      | Validates that all required configuration is complete.
    }
  }
  command LaunchCampaign yields event CampaignLaunched is  { campaignId: CampaignId } with {
    briefly "Launch the campaign immediately"
    described as {
      | Activates the campaign, beginning delivery across configured channels.
      | Can be used on Draft or Scheduled campaigns.
    }
  }
  command PauseCampaign yields event CampaignPaused is  {
    campaignId: CampaignId
    reason: String
  } with {
    briefly "Pause an active campaign"
    described as {
      | Temporarily stops campaign delivery while preserving configuration.
      | Records the reason for the pause for audit purposes.
    }
  }
  command ResumeCampaign yields event CampaignResumed is  { campaignId: CampaignId } with {
    briefly "Resume a paused campaign"
    described as {
      | Reactivates a paused campaign, resuming delivery.
    }
  }
  command RecordPerformanceUpdate yields event PerformanceMetricsRecorded is  {
    campaignId: CampaignId
    channelPerformance: ChannelPerformance
  } with {
    briefly "Record performance metrics update"
    described as {
      | Updates the campaign with the latest performance metrics
      | from a specific channel. Typically triggered by channel integrations.
    }
  }
  command CompleteCampaign yields event CampaignCompleted is  {
    campaignId: CampaignId
    finalMetrics: PerformanceMetrics
  } with {
    briefly "Complete and close the campaign"
    described as {
      | Marks the campaign as completed, recording final metrics.
      | No further delivery or budget spend will occur.
    }
  }
  command ArchiveCampaign yields event CampaignArchived is  { campaignId: CampaignId } with {
    briefly "Archive the campaign"
    described as {
      | Moves the campaign to archived status for long-term retention.
      | Archived campaigns are read-only.
    }
  }
  // Events
  event CampaignCreated is  {
    campaignId: CampaignId
    name: CampaignName
    objective: CampaignObjective
    schedule: CampaignSchedule
    totalBudget: BudgetAmount
    createdAt: TimeStamp
  } with {
    briefly "Campaign was created"
    described as {
      | Emitted when a new campaign is successfully created.
      | Contains all initial campaign configuration.
    }
  }
  event CampaignDetailsUpdated is  {
    campaignId: CampaignId
    name: CampaignName
    objective: CampaignObjective
    schedule: CampaignSchedule
    updatedAt: TimeStamp
  } with {
    briefly "Campaign details were updated"
    described as {
      | Emitted when campaign name, objective, or schedule changes.
    }
  }
  event ChannelBudgetAllocated is  {
    campaignId: CampaignId
    allocation: ChannelAllocation
    allocatedAt: TimeStamp
  } with {
    briefly "Budget was allocated to a channel"
    described as {
      | Emitted when budget is assigned to a marketing channel.
    }
  }
  event TargetAudienceAdded is  {
    campaignId: CampaignId
    audience: AudienceTarget
    addedAt: TimeStamp
  } with {
    briefly "Target audience was added"
    described as {
      | Emitted when an audience segment is added to the campaign.
    }
  }
  event TargetAudienceRemoved is  {
    campaignId: CampaignId
    audienceId: AudienceId
    removedAt: TimeStamp
  } with {
    briefly "Target audience was removed"
    described as {
      | Emitted when an audience segment is removed from the campaign.
    }
  }
  event CampaignScheduled is  {
    campaignId: CampaignId
    scheduledAt: TimeStamp
  } with {
    briefly "Campaign was scheduled for launch"
    described as {
      | Emitted when campaign transitions to Scheduled status.
    }
  }
  event CampaignLaunched is  {
    campaignId: CampaignId
    launchedAt: TimeStamp
  } with {
    briefly "Campaign was launched"
    described as {
      | Emitted when campaign becomes active and begins delivery.
    }
  }
  event CampaignPaused is  {
    campaignId: CampaignId
    reason: String
    pausedAt: TimeStamp
  } with {
    briefly "Campaign was paused"
    described as {
      | Emitted when an active campaign is temporarily stopped.
    }
  }
  event CampaignResumed is  {
    campaignId: CampaignId
    resumedAt: TimeStamp
  } with {
    briefly "Campaign was resumed"
    described as {
      | Emitted when a paused campaign is reactivated.
    }
  }
  event PerformanceMetricsRecorded is  {
    campaignId: CampaignId
    channelPerformance: ChannelPerformance
    recordedAt: TimeStamp
  } with {
    briefly "Performance metrics were recorded"
    described as {
      | Emitted when new performance data is received from a channel.
    }
  }
  event CampaignCompleted is  {
    campaignId: CampaignId
    finalMetrics: PerformanceMetrics
    completedAt: TimeStamp
  } with {
    briefly "Campaign was completed"
    described as {
      | Emitted when the campaign finishes its run.
    }
  }
  event CampaignArchived is  {
    campaignId: CampaignId
    archivedAt: TimeStamp
  } with {
    briefly "Campaign was archived"
    described as {
      | Emitted when the campaign is moved to archive storage.
    }
  }
  // State Records
  record CampaignStateRecord is  {
    info: CampaignInfo
    channelAllocations: ChannelAllocation*
    targetAudiences: AudienceTarget*
    aggregateMetrics: PerformanceMetrics
    channelMetrics: ChannelPerformance*
    budgetAlerts: BudgetAlert*
  } with {
    briefly "Complete campaign state record"
    described as {
      | Contains all campaign data including basic info, channel allocations,
      | audience targeting, and accumulated performance metrics.
    }
  }
  // States
  initial state DraftState of record Campaign.CampaignStateRecord is {
    initial handler DraftStateInitHandler is {
      on query FetchCampaign is {
        let campaignQueryResult: type CampaignQueryResult = prompt("read the campaign query from the store")
        reply campaignQueryResult
      }
      on init is {
        let campaignCreated: type CampaignCreated = prompt("the campaign created that brings this campaign into existence")
        yield campaignCreated
      }
    } with {
      briefly "DraftState initialization"
      described as {
        |Initializes DraftState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Draft state"
    described as {
      |The draft state of the Campaign entity, carrying CampaignStateRecord.
    }
  }
  state ScheduledState of record Campaign.CampaignStateRecord is {
    initial handler ScheduledStateInitHandler is {
      on init is {
        let campaignScheduled: type CampaignScheduled = prompt("the campaign scheduled that brings this campaign into existence")
        yield campaignScheduled
      }
    } with {
      briefly "ScheduledState initialization"
      described as {
        |Initializes ScheduledState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Scheduled state"
    described as {
      |The scheduled state of the Campaign entity, carrying CampaignStateRecord.
    }
  }
  state ActiveState of record Campaign.CampaignStateRecord is {
    initial handler ActiveStateInitHandler is {
      on init is {
        let campaignResumed: type CampaignResumed = prompt("the campaign resumed that brings this campaign into existence")
        yield campaignResumed
      }
    } with {
      briefly "ActiveState initialization"
      described as {
        |Initializes ActiveState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Active state"
    described as {
      |The active state of the Campaign entity, carrying CampaignStateRecord.
    }
  }
  state PausedState of record Campaign.CampaignStateRecord is {
    initial handler PausedStateInitHandler is {
      on init is {
        let campaignPaused: type CampaignPaused = prompt("the campaign paused that brings this campaign into existence")
        yield campaignPaused
      }
    } with {
      briefly "PausedState initialization"
      described as {
        |Initializes PausedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Paused state"
    described as {
      |The paused state of the Campaign entity, carrying CampaignStateRecord.
    }
  }
  state CompletedState of record Campaign.CampaignStateRecord is {
    initial handler CompletedStateInitHandler is {
      on init is {
        let campaignCompleted: type CampaignCompleted = prompt("the campaign completed that brings this campaign into existence")
        yield campaignCompleted
      }
    } with {
      briefly "CompletedState initialization"
      described as {
        |Initializes CompletedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Completed state"
    described as {
      |The completed state of the Campaign entity, carrying CampaignStateRecord.
    }
  }
  state ArchivedState of record Campaign.CampaignStateRecord is {
    initial handler ArchivedStateInitHandler is {
      on init is {
        let campaignArchived: type CampaignArchived = prompt("the campaign archived that brings this campaign into existence")
        yield campaignArchived
      }
    } with {
      briefly "ArchivedState initialization"
      described as {
        |Initializes ArchivedState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Archived state"
    described as {
      |The archived state of the Campaign entity, carrying CampaignStateRecord.
    }
  }
  // Handler
  handler CampaignHandler is {
    on createCampaign: command CreateCampaign is {
      yield event CampaignCreated(campaignId = createCampaign.campaignId, name = createCampaign.name, objective = createCampaign.objective, schedule = createCampaign.schedule, totalBudget = createCampaign.totalBudget, createdAt = prompt("the created at of this campaign created"))
    }
    on updateCampaignDetails: command UpdateCampaignDetails is {
      yield event CampaignDetailsUpdated(campaignId = updateCampaignDetails.campaignId, name = updateCampaignDetails.name, objective = updateCampaignDetails.objective, schedule = updateCampaignDetails.schedule, updatedAt = prompt("the updated at of this campaign details updated"))
    }
    on allocateChannelBudget: command AllocateChannelBudget is {
      yield event ChannelBudgetAllocated(campaignId = allocateChannelBudget.campaignId, allocation = allocateChannelBudget.allocation, allocatedAt = prompt("the allocated at of this channel budget allocated"))
    }
    on addTargetAudience: command AddTargetAudience is {
      yield event TargetAudienceAdded(campaignId = addTargetAudience.campaignId, audience = addTargetAudience.audience, addedAt = prompt("the added at of this target audience added"))
    }
    on removeTargetAudience: command RemoveTargetAudience is {
      yield event TargetAudienceRemoved(campaignId = removeTargetAudience.campaignId, audienceId = removeTargetAudience.audienceId, removedAt = prompt("the removed at of this target audience removed"))
    }
    on command ScheduleCampaign is {
      let campaignScheduled: type CampaignScheduled = prompt("the campaign scheduled that results from schedule campaign")
      yield campaignScheduled
    }
    on command LaunchCampaign is {
      let campaignLaunched: type CampaignLaunched = prompt("the campaign launched that results from launch campaign")
      yield campaignLaunched
    }
    on pauseCampaign: command Campaign.PauseCampaign is {
      yield event CampaignPaused(campaignId = pauseCampaign.campaignId, reason = pauseCampaign.reason, pausedAt = prompt("the paused at of this campaign paused"))
    }
    on command ResumeCampaign is {
      let campaignResumed: type CampaignResumed = prompt("the campaign resumed that results from resume campaign")
      yield campaignResumed
    }
    on recordPerformanceUpdate: command RecordPerformanceUpdate is {
      yield event PerformanceMetricsRecorded(campaignId = recordPerformanceUpdate.campaignId, channelPerformance = recordPerformanceUpdate.channelPerformance, recordedAt = prompt("the recorded at of this performance metrics recorded"))
    }
    on completeCampaign: command Campaign.CompleteCampaign is {
      yield event CampaignCompleted(campaignId = completeCampaign.campaignId, finalMetrics = completeCampaign.finalMetrics, completedAt = prompt("the completed at of this campaign completed"))
    }
    on command ArchiveCampaign is {
      let campaignArchived: type CampaignArchived = prompt("the campaign archived that results from archive campaign")
      yield campaignArchived
    }
    on event CampaignCreated is {
      let campaignStateRecord: type Campaign.CampaignStateRecord = prompt("the campaign state record that results from campaign created")
      morph entity CampaignContext.Campaign to state CampaignContext.Campaign.DraftState with campaignStateRecord
    }
    on event CampaignDetailsUpdated is {
      do "apply CampaignDetailsUpdated to the current state"
    }
    on event ChannelBudgetAllocated is {
      do "apply ChannelBudgetAllocated to the current state"
    }
    on event TargetAudienceAdded is {
      do "apply TargetAudienceAdded to the current state"
    }
    on event TargetAudienceRemoved is {
      do "apply TargetAudienceRemoved to the current state"
    }
    on event CampaignScheduled is {
      let campaignStateRecord: type Campaign.CampaignStateRecord = prompt("the campaign state record that results from campaign scheduled")
      morph entity CampaignContext.Campaign to state CampaignContext.Campaign.ScheduledState with campaignStateRecord
    }
    on event CampaignLaunched is {
      let campaignStateRecord: type Campaign.CampaignStateRecord = prompt("the campaign state record that results from campaign launched")
      morph entity CampaignContext.Campaign to state CampaignContext.Campaign.ActiveState with campaignStateRecord
    }
    on event CampaignPaused is {
      let campaignStateRecord: type Campaign.CampaignStateRecord = prompt("the campaign state record that results from campaign paused")
      morph entity CampaignContext.Campaign to state CampaignContext.Campaign.PausedState with campaignStateRecord
    }
    on event CampaignResumed is {
      let campaignStateRecord: type Campaign.CampaignStateRecord = prompt("the campaign state record that results from campaign resumed")
      morph entity CampaignContext.Campaign to state CampaignContext.Campaign.ActiveState with campaignStateRecord
    }
    on event PerformanceMetricsRecorded is {
      do "apply PerformanceMetricsRecorded to the current state"
    }
    on event CampaignCompleted is {
      let campaignStateRecord: type Campaign.CampaignStateRecord = prompt("the campaign state record that results from campaign completed")
      morph entity CampaignContext.Campaign to state CampaignContext.Campaign.CompletedState with campaignStateRecord
    }
    on event CampaignArchived is {
      let campaignStateRecord: type Campaign.CampaignStateRecord = prompt("the campaign state record that results from campaign archived")
      morph entity CampaignContext.Campaign to state CampaignContext.Campaign.ArchivedState with campaignStateRecord
    }
  } with {
    briefly "Processes campaign commands"
    described as {
      | Handles the full campaign lifecycle including creation,
      | configuration, state transitions, and performance tracking.
    }
  }
} with {
  briefly "Marketing campaign aggregate entity"
  described as {
    | The Campaign entity is the aggregate root for marketing campaigns.
    | It manages the full lifecycle from creation through archival,
    | including budget allocation, audience targeting, and performance tracking.
  }
}
