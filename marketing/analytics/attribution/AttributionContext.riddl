// Marketing Attribution - Attribution Context
context AttributionContext is {
  include "types.riddl"
  include "ConversionPath.riddl"
  repository AttributionRepository is {
    schema AttributionData is relational
      of conversionPaths as type ConversionPath
        index on field ConversionPath.conversionPathId
        index on field ConversionPath.conversionInfo.customerId
        index on field ConversionPath.status

    handler AttributionPersistence is {
      on command ConversionPath.CreateConversionPath is {
        tell event ConversionPath.ConversionPathCreated to entity AttributionContext.ConversionPath
        prompt "Store new conversion path"
      }
      on command ConversionPath.RecordTouchpoint is {
        tell event ConversionPath.TouchpointRecorded to entity AttributionContext.ConversionPath
        prompt "Store touchpoint on conversion path"
      }
      on command ConversionPath.RecordConversion is {
        tell event ConversionPath.ConversionRecorded to entity AttributionContext.ConversionPath
        prompt "Update path to converted"
      }
      on command ConversionPath.ApplyAttributionModel is {
        prompt "Store attribution results"
      }
      on command ConversionPath.ExpirePath is {
        prompt "Update path to expired"
      }
    } with {
      briefly "Persists attribution commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Attribution data persistence"
    described as {
      |Persistent storage for attribution data.
    }
  }
  projector AttributionMetrics is {
    updates repository AttributionContext.AttributionRepository
    record ChannelMetrics is  {
      totalConversions: Natural with {
        briefly "Conversions"
        described as {
          |Total conversions.
        }
      }
      totalAttributedRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Attributed revenue.
        }
      }
      averageTouchpoints: Decimal(6,2) with {
        briefly "Avg touchpoints"
        described as {
          |Average touchpoints per path.
        }
      }
      topChannel: ChannelType with {
        briefly "Top channel"
        described as {
          |Highest performing channel.
        }
      }
    } with {
      briefly "Channel metrics"
      described as {
        |Attribution channel metrics.
      }
    }
    handler MetricsHandler is {
      on event ConversionPath.ConversionPathCreated is {
        tell event ConversionPath.ConversionPathCreated to repository AttributionContext.AttributionRepository
        prompt "Track new conversion path"
      }
      on event ConversionPath.TouchpointRecorded is {
        tell event ConversionPath.TouchpointRecorded to repository AttributionContext.AttributionRepository
        prompt "Update touchpoint counts"
      }
      on event ConversionPath.AttributionModelApplied is {
        tell event ConversionPath.AttributionModelApplied to repository AttributionContext.AttributionRepository
        prompt "Update channel revenue and conversion counts"
      }
    } with {
      briefly "Maintains attribution metrics"
      described as {
        |Projects events into attribution metrics.
      }
    }
  } with {
    briefly "Attribution metrics"
    described as {
      |Marketing attribution analytics.
    }
  }
  // ---- Event publication for ConversionPath ----
  type ConversionPathEvent is one of {
    AttributionContext.ConversionPath.ConversionPathCreated,
    AttributionContext.ConversionPath.TouchpointRecorded,
    AttributionContext.ConversionPath.ConversionRecorded,
    AttributionContext.ConversionPath.AttributionModelApplied,
    AttributionContext.ConversionPath.PathExpired,
    AttributionContext.ConversionPath.PathCancelled
  } with {
    briefly "ConversionPath event alternation"
    described as {
      |Union of all ConversionPath events, for streaming and event-sourced
      |persistence.
    }
  }
  source ConversionPathEventSource is {
    outlet ConversionPathEvents is type ConversionPathEvent
    handler ConversionPathSourceHandler is {
      on event ConversionPath.ConversionPathCreated is {
        send event ConversionPath.ConversionPathCreated to outlet ConversionPathEvents
      }
      on event ConversionPath.TouchpointRecorded is {
        send event ConversionPath.TouchpointRecorded to outlet ConversionPathEvents
      }
      on event ConversionPath.ConversionRecorded is {
        send event ConversionPath.ConversionRecorded to outlet ConversionPathEvents
      }
      on event ConversionPath.AttributionModelApplied is {
        send event ConversionPath.AttributionModelApplied to outlet ConversionPathEvents
      }
      on event ConversionPath.PathExpired is {
        send event ConversionPath.PathExpired to outlet ConversionPathEvents
      }
      on event ConversionPath.PathCancelled is {
        send event ConversionPath.PathCancelled to outlet ConversionPathEvents
      }
      on other is {
        error "Unexpected message for source ConversionPathEventSource"
      }
    } with {
      briefly "ConversionPath source handler"
      described as {
        |Publishes ConversionPath events onto the outlet.
      }
    }
  } with {
    briefly "ConversionPath event source"
    described as {
      |Publishes ConversionPath entity events into the streaming topology.
    }
  }
  sink ConversionPathEventSink is {
    inlet ConversionPathInlet is type ConversionPathEvent
    handler ConversionPathSinkHandler is {
      on event ConversionPath.ConversionPathCreated is {
        tell event ConversionPath.ConversionPathCreated to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.TouchpointRecorded is {
        tell event ConversionPath.TouchpointRecorded to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.ConversionRecorded is {
        tell event ConversionPath.ConversionRecorded to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.AttributionModelApplied is {
        tell event ConversionPath.AttributionModelApplied to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.PathExpired is {
        tell event ConversionPath.PathExpired to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.PathCancelled is {
        tell event ConversionPath.PathCancelled to repository AttributionContext.AttributionRepository
      }
      on other is {
        error "Unexpected message for sink ConversionPathEventSink"
      }
    } with {
      briefly "ConversionPath sink handler"
      described as {
        |Persists ConversionPath events via the repository.
      }
    }
  } with {
    briefly "ConversionPath event sink"
    described as {
      |Receives ConversionPath events for persistence.
    }
  }
  connector ConversionPathEventFlow is {
    from outlet AttributionContext.ConversionPathEventSource.ConversionPathEvents to
      inlet AttributionContext.ConversionPathEventSink.ConversionPathInlet
  } with {
    briefly "ConversionPath event flow"
    described as {
      |Connects the ConversionPath source to its sink.
    }
  }
} with {
  briefly "Bounded context for marketing attribution"
  described as {
    |Marketing attribution analysis context.
  }
}
