// Marketing Attribution - Attribution Context
context AttributionContext as router is {
  inlet ConversionPathCommandStreamIn is type ConversionPathCommand
  outlet ConversionPathCommandStreamOut is type ConversionPathCommand
  inlet ConversionPathResultStreamIn is type ConversionPath.ConversionPathResult
  outlet ConversionPathResultStreamOut is type ConversionPath.ConversionPathResult
  handler AttributionContextBoundary is {
    on createConversionPath: command ConversionPath.CreateConversionPath is {
      send createConversionPath to outlet AttributionContext.ConversionPathCommandStreamOut
    }
    on recordTouchpoint: command ConversionPath.RecordTouchpoint is {
      send recordTouchpoint to outlet AttributionContext.ConversionPathCommandStreamOut
    }
    on recordConversion: command ConversionPath.RecordConversion is {
      send recordConversion to outlet AttributionContext.ConversionPathCommandStreamOut
    }
    on applyAttributionModel: command ConversionPath.ApplyAttributionModel is {
      send applyAttributionModel to outlet AttributionContext.ConversionPathCommandStreamOut
    }
    on expirePath: command ConversionPath.ExpirePath is {
      send expirePath to outlet AttributionContext.ConversionPathCommandStreamOut
    }
    on cancelPath: command ConversionPath.CancelPath is {
      send cancelPath to outlet AttributionContext.ConversionPathCommandStreamOut
    }
    on conversionPathResult: result ConversionPath.ConversionPathResult is {
      send conversionPathResult to outlet AttributionContext.ConversionPathResultStreamOut
    }
    on other is {
      error "Unexpected message at the AttributionContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ConversionPathCommand Stream Intake' is from outlet AttributionContext.ConversionPathCommandStreamOut to inlet AttributionContext.ConversionPath.ConversionPathCommands
  connector 'ConversionPathResult Stream Egress' is from outlet AttributionContext.AttributionRepository.AttributionRepositoryResponses to inlet AttributionContext.ConversionPathResultStreamIn
  adaptor FromCRMSystem from context CRMSystem is { 
    handler FromCRMSystemHandler is {
      on event CRMSystem.CustomerAttributionUpdated is {
        do "the model receives customer attribution updated"
      }
      on result CRMSystem.CustomerJourneyData is {
        do "the model receives customer journey data"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMSystem"
      }
    } with {
      briefly "from crm system"
      described as {
        |Carries messages from the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem is { 
    handler ToCRMSystemHandler is {
      on query CRMSystem.GetCustomerJourney is {
        do "the model sends get customer journey"
      }
      on command CRMSystem.UpdateCustomerAttribution is {
        do "the model sends update customer attribution"
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromWebAnalytics from context WebAnalytics is { 
    handler FromWebAnalyticsHandler is {
      on event WebAnalytics.EventTracked is {
        do "the model receives event tracked"
      }
      on result WebAnalytics.PageViewData is {
        do "the model receives page view data"
      }
      on other is {
        error "Unexpected message for adaptor FromWebAnalytics"
      }
    } with {
      briefly "from web analytics"
      described as {
        |Carries messages from the external WebAnalytics.
      }
    }
  } with {
    briefly "WebAnalytics integration"
    described as {
      |The model's side of the WebAnalytics conversation.
    }
  }
  adaptor ToWebAnalytics to context WebAnalytics is { 
    handler ToWebAnalyticsHandler is {
      on query WebAnalytics.GetPageViews is {
        do "the model sends get page views"
      }
      on command WebAnalytics.TrackEvent is {
        do "the model sends track event"
      }
      on other is {
        error "Unexpected message for adaptor ToWebAnalytics"
      }
    } with {
      briefly "to web analytics"
      described as {
        |Carries messages to the external WebAnalytics.
      }
    }
  } with {
    briefly "WebAnalytics integration"
    described as {
      |The model's side of the WebAnalytics conversation.
    }
  }
  include "types.riddl"
  include "ConversionPath.riddl"
  repository AttributionRepository as merge is {
    command PersistAttributionModelApplied is {
      conversionPathId: ConversionPathId with {
        briefly "Row addressed"
        described as {
          |Which stored row AttributionModelApplied applies to.
        }
      }
    } with {
      briefly "Persist AttributionModelApplied"
      described as {
        |Instructs this repository to apply AttributionModelApplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistConversionPathCreated is {
      conversionPathId: ConversionPathId with {
        briefly "Row addressed"
        described as {
          |Which stored row ConversionPathCreated applies to.
        }
      }
    } with {
      briefly "Persist ConversionPathCreated"
      described as {
        |Instructs this repository to apply ConversionPathCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTouchpointRecorded is {
      conversionPathId: ConversionPathId with {
        briefly "Row addressed"
        described as {
          |Which stored row TouchpointRecorded applies to.
        }
      }
    } with {
      briefly "Persist TouchpointRecorded"
      described as {
        |Instructs this repository to apply TouchpointRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet AttributionRepositoryFromConversionPath is type ConversionPathEvent    inlet AttributionRepositoryFromAttributionMetrics is type ConversionPathEvent    outlet AttributionRepositoryResponses is type ConversionPath.ConversionPathResult
    record StoredConversionPath is  {
      conversionPathId: ConversionPathId with {
        briefly "conversionPathId"
        described as {
          |The conversionPathId column of the stored conversionPath row.
        }
      }
      conversionInfo: ConversionInfo with {
        briefly "conversionInfo"
        described as {
          |The conversionInfo column of the stored conversionPath row.
        }
      }
      status: ConversionStatus with {
        briefly "status"
        described as {
          |The status column of the stored conversionPath row.
        }
      }
    } with {
      briefly "Stored conversionPath row"
      described as {
        |The persistence shape of conversionPath data as this repository stores it.
      }
    }
    schema AttributionData is relational
      of conversionPaths as type StoredConversionPath
        index on field StoredConversionPath.conversionPathId
        index on field StoredConversionPath.conversionInfo.customerId
        index on field StoredConversionPath.status
 with {
      briefly "Attribution data schema"
      described as {
        |The relational schema holding attribution data for the AttributionRepository.
      }
    }
    handler AttributionPersistence is {
      on persistAttributionModelApplied: command PersistAttributionModelApplied is {
        do "apply AttributionModelApplied to the stored row"
      }
      on persistConversionPathCreated: command PersistConversionPathCreated is {
        do "apply ConversionPathCreated to the stored row"
      }
      on persistTouchpointRecorded: command PersistTouchpointRecorded is {
        do "apply TouchpointRecorded to the stored row"
      }
      on query GetChannelMetrics is {
        let channelMetricsView: type ChannelMetricsView = prompt("read the channel metrics projection")
        reply channelMetricsView
      }
      on createConversionPath: command ConversionPath.CreateConversionPath is {
        tell event ConversionPath.ConversionPathCreated(conversionPathId = createConversionPath.conversionPathId, conversionInfo = createConversionPath.conversionInfo) to entity AttributionContext.ConversionPath
        do "Store new conversion path"
      }
      on recordTouchpoint: command ConversionPath.RecordTouchpoint is {
        tell event ConversionPath.TouchpointRecorded(conversionPathId = recordTouchpoint.conversionPathId, touchpoint = recordTouchpoint.touchpoint) to entity AttributionContext.ConversionPath
        do "Store touchpoint on conversion path"
      }
      on recordConversion: command ConversionPath.RecordConversion is {
        tell event ConversionPath.ConversionRecorded(conversionPathId = recordConversion.conversionPathId, actualValue = recordConversion.actualValue, convertedAt = recordConversion.convertedAt) to entity AttributionContext.ConversionPath
        do "Update path to converted"
      }
      on command ConversionPath.ApplyAttributionModel is {
        do "Store attribution results"
      }
      on command ConversionPath.ExpirePath is {
        do "Update path to expired"
      }
    } with {
      briefly "Persists attribution commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Attribution data persistence"
    described as {
      |Persistent storage for attribution data.
    }
  }
  query GetChannelMetrics is  {
    channelMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which channel metrics to retrieve.
      }
    }
  } with {
    briefly "Get channel metrics"
    described as {
      |Retrieves the channel metrics projection.
    }
  }
  result ChannelMetricsView is  {
    channelMetrics: AttributionMetrics.ChannelMetrics with {
      briefly "Channel metrics"
      described as {
        |The channel metrics being returned.
      }
    }
  } with {
    briefly "Channel metrics view"
    described as {
      |Read model view carrying the channel metrics projection.
    }
  }
  projector AttributionMetrics as flow is {
    updates repository AttributionContext.AttributionRepository
    inlet AttributionMetricsFromConversionPath is type ConversionPathEvent    outlet AttributionMetricsOut is type ConversionPathEvent
    record ChannelMetrics is  {
      totalConversions: Natural with {
        briefly "Conversions"
        described as {
          |Total conversions.
        }
      }
      totalAttributedRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Attributed revenue.
        }
      }
      averageTouchpoints: Decimal(6,2) with {
        briefly "Avg touchpoints"
        described as {
          |Average touchpoints per path.
        }
      }
      topChannel: ChannelType with {
        briefly "Top channel"
        described as {
          |Highest performing channel.
        }
      }
    } with {
      briefly "Channel metrics"
      described as {
        |Attribution channel metrics.
      }
    }
    handler MetricsHandler is {
      on conversionPathCreated: event ConversionPath.ConversionPathCreated is {
        tell command AttributionContext.AttributionRepository.PersistConversionPathCreated(conversionPathId = conversionPathCreated.conversionPathId) to repository AttributionContext.AttributionRepository
        do "Track new conversion path"
      }
      on touchpointRecorded: event ConversionPath.TouchpointRecorded is {
        tell command AttributionContext.AttributionRepository.PersistTouchpointRecorded(conversionPathId = touchpointRecorded.conversionPathId) to repository AttributionContext.AttributionRepository
        do "Update touchpoint counts"
      }
      on attributionModelApplied: event ConversionPath.AttributionModelApplied is {
        tell command AttributionContext.AttributionRepository.PersistAttributionModelApplied(conversionPathId = attributionModelApplied.conversionPathId) to repository AttributionContext.AttributionRepository
        do "Update channel revenue and conversion counts"
      }
    } with {
      briefly "Maintains attribution metrics"
      described as {
        |Projects events into attribution metrics.
      }
    }
  } with {
    briefly "Attribution metrics"
    described as {
      |Marketing attribution analytics.
    }
  }
  // ---- Event publication for ConversionPath ----
  type ConversionPathEvent is one of {
    AttributionContext.ConversionPath.ConversionPathCreated or AttributionContext.ConversionPath.TouchpointRecorded or AttributionContext.ConversionPath.ConversionRecorded or AttributionContext.ConversionPath.AttributionModelApplied or AttributionContext.ConversionPath.PathExpired or AttributionContext.ConversionPath.PathCancelled
  } with {
    briefly "ConversionPath event alternation"
    described as {
      |Union of all ConversionPath events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ConversionPathEventSource as source is {
    outlet ConversionPathEvents is type ConversionPathEvent
    handler ConversionPathSourceHandler is {
      on conversionPathCreated: event ConversionPath.ConversionPathCreated is {
        send conversionPathCreated to outlet ConversionPathEvents
      }
      on touchpointRecorded: event ConversionPath.TouchpointRecorded is {
        send touchpointRecorded to outlet ConversionPathEvents
      }
      on conversionRecorded: event ConversionPath.ConversionRecorded is {
        send conversionRecorded to outlet ConversionPathEvents
      }
      on attributionModelApplied: event ConversionPath.AttributionModelApplied is {
        send attributionModelApplied to outlet ConversionPathEvents
      }
      on pathExpired: event ConversionPath.PathExpired is {
        send pathExpired to outlet ConversionPathEvents
      }
      on pathCancelled: event ConversionPath.PathCancelled is {
        send pathCancelled to outlet ConversionPathEvents
      }
      on other is {
        error "Unexpected message for source ConversionPathEventSource"
      }
    } with {
      briefly "ConversionPath source handler"
      described as {
        |Publishes ConversionPath events onto the outlet.
      }
    }
  } with {
    briefly "ConversionPath event source"
    described as {
      |Publishes ConversionPath entity events into the streaming topology.
    }
  }
  processor ConversionPathEventSink as sink is {
    inlet ConversionPathInlet is type ConversionPathEvent    handler ConversionPathSinkHandler is {
      on conversionPathCreated: event ConversionPath.ConversionPathCreated is {
        tell conversionPathCreated to repository AttributionContext.AttributionRepository
      }
      on touchpointRecorded: event ConversionPath.TouchpointRecorded is {
        tell touchpointRecorded to repository AttributionContext.AttributionRepository
      }
      on conversionRecorded: event ConversionPath.ConversionRecorded is {
        tell conversionRecorded to repository AttributionContext.AttributionRepository
      }
      on attributionModelApplied: event ConversionPath.AttributionModelApplied is {
        tell attributionModelApplied to repository AttributionContext.AttributionRepository
      }
      on pathExpired: event ConversionPath.PathExpired is {
        tell pathExpired to repository AttributionContext.AttributionRepository
      }
      on pathCancelled: event ConversionPath.PathCancelled is {
        tell pathCancelled to repository AttributionContext.AttributionRepository
      }
      on other is {
        error "Unexpected message for sink ConversionPathEventSink"
      }
    } with {
      briefly "ConversionPath sink handler"
      described as {
        |Persists ConversionPath events via the repository.
      }
    }
  } with {
    briefly "ConversionPath event sink"
    described as {
      |Receives ConversionPath events for persistence.
    }
  }
  connector ConversionPathEventFlow is from outlet AttributionContext.ConversionPathEventSource.ConversionPathEvents to inlet AttributionContext.ConversionPathEventSink.ConversionPathInlet with {
    briefly "ConversionPath event flow"
    described as {
      |Connects the ConversionPath source to its sink.
    }
  }
  processor ConversionPathEventSplit as split is {
    inlet ConversionPathEventSplitIn is type ConversionPathEvent    outlet ConversionPathEventSplitToAttributionRepository is type ConversionPathEvent
    outlet ConversionPathEventSplitToAttributionMetrics is type ConversionPathEvent
    handler ConversionPathEventSplitHandler is {
      on conversionPathCreated: event ConversionPath.ConversionPathCreated is {
        send conversionPathCreated to outlet ConversionPathEventSplitToAttributionRepository
        send conversionPathCreated to outlet ConversionPathEventSplitToAttributionMetrics
        tell conversionPathCreated to entity AttributionContext.ConversionPath
      }
      on touchpointRecorded: event ConversionPath.TouchpointRecorded is {
        send touchpointRecorded to outlet ConversionPathEventSplitToAttributionRepository
        send touchpointRecorded to outlet ConversionPathEventSplitToAttributionMetrics
        tell touchpointRecorded to entity AttributionContext.ConversionPath
      }
      on conversionRecorded: event ConversionPath.ConversionRecorded is {
        send conversionRecorded to outlet ConversionPathEventSplitToAttributionRepository
        send conversionRecorded to outlet ConversionPathEventSplitToAttributionMetrics
        tell conversionRecorded to entity AttributionContext.ConversionPath
      }
      on attributionModelApplied: event ConversionPath.AttributionModelApplied is {
        send attributionModelApplied to outlet ConversionPathEventSplitToAttributionRepository
        send attributionModelApplied to outlet ConversionPathEventSplitToAttributionMetrics
        tell attributionModelApplied to entity AttributionContext.ConversionPath
      }
      on pathExpired: event ConversionPath.PathExpired is {
        send pathExpired to outlet ConversionPathEventSplitToAttributionRepository
        send pathExpired to outlet ConversionPathEventSplitToAttributionMetrics
        tell pathExpired to entity AttributionContext.ConversionPath
      }
      on pathCancelled: event ConversionPath.PathCancelled is {
        send pathCancelled to outlet ConversionPathEventSplitToAttributionRepository
        send pathCancelled to outlet ConversionPathEventSplitToAttributionMetrics
        tell pathCancelled to entity AttributionContext.ConversionPath
      }
      on other is {
        error "Unexpected message for processor ConversionPathEventSplit"
      }
    } with {
      briefly "ConversionPath event fan-out handler"
      described as {
        |Delivers each ConversionPath event to all of its consumers.
      }
    }
  } with {
    briefly "ConversionPath event fan-out"
    described as {
      |Fans ConversionPath events out to the repository and projectors.
    }
  }
  connector 'ConversionPathEvent Stream' is from outlet AttributionContext.ConversionPath.ConversionPathEvents2 to inlet AttributionContext.ConversionPathEventSplit.ConversionPathEventSplitIn with {
    briefly "ConversionPath events, fanned out to storage and read models"
  }
  connector 'ConversionPathEvent Storage' is from outlet AttributionContext.ConversionPathEventSplit.ConversionPathEventSplitToAttributionRepository to inlet AttributionContext.AttributionRepository.AttributionRepositoryFromConversionPath with {
    briefly "ConversionPath events on their way to storage"
  }
  connector 'AttributionMetrics Feed' is from outlet AttributionContext.ConversionPathEventSplit.ConversionPathEventSplitToAttributionMetrics to inlet AttributionContext.AttributionMetrics.AttributionMetricsFromConversionPath with {
    briefly "ConversionPath events feeding the AttributionMetrics projection"
  }
  connector 'AttributionMetrics Storage' is from outlet AttributionContext.AttributionMetrics.AttributionMetricsOut to inlet AttributionContext.AttributionRepository.AttributionRepositoryFromAttributionMetrics with {
    briefly "The AttributionMetrics projection on its way to storage"
  }
} with {
  briefly "Bounded context for marketing attribution"
  described as {
    |Marketing attribution analysis context.
  }
}
