// Marketing Attribution - Attribution Context
context AttributionContext is {
  adaptor FromCRMSystem from context CRMSystem is {
    handler FromCRMSystemHandler is {
      on event CRMSystem.CustomerAttributionUpdated is {
        do "the model receives customer attribution updated"
      }
      on result CRMSystem.CustomerJourneyData is {
        do "the model receives customer journey data"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMSystem"
      }
    } with {
      briefly "from crm system"
      described as {
        |Carries messages from the external CRMSystem.
      }
    }
  } with {
      briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem is {
    handler ToCRMSystemHandler is {
      on query CRMSystem.GetCustomerJourney is {
        do "the model sends get customer journey"
      }
      on command CRMSystem.UpdateCustomerAttribution is {
        do "the model sends update customer attribution"
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
      briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromWebAnalytics from context WebAnalytics is {
    handler FromWebAnalyticsHandler is {
      on event WebAnalytics.EventTracked is {
        do "the model receives event tracked"
      }
      on result WebAnalytics.PageViewData is {
        do "the model receives page view data"
      }
      on other is {
        error "Unexpected message for adaptor FromWebAnalytics"
      }
    } with {
      briefly "from web analytics"
      described as {
        |Carries messages from the external WebAnalytics.
      }
    }
  } with {
      briefly "WebAnalytics integration"
    described as {
      |The model's side of the WebAnalytics conversation.
    }
  }
  adaptor ToWebAnalytics to context WebAnalytics is {
    handler ToWebAnalyticsHandler is {
      on query WebAnalytics.GetPageViews is {
        do "the model sends get page views"
      }
      on command WebAnalytics.TrackEvent is {
        do "the model sends track event"
      }
      on other is {
        error "Unexpected message for adaptor ToWebAnalytics"
      }
    } with {
      briefly "to web analytics"
      described as {
        |Carries messages to the external WebAnalytics.
      }
    }
  } with {
      briefly "WebAnalytics integration"
    described as {
      |The model's side of the WebAnalytics conversation.
    }
  }
  include "types.riddl"
  include "ConversionPath.riddl"
  repository AttributionRepository is {
    inlet AttributionRepositoryFromConversionPath is type ConversionPathEvent
    inlet AttributionRepositoryFromAttributionMetrics is type ConversionPathEvent
    outlet AttributionRepositoryResponses is type ConversionPath.ConversionPathResult
    record StoredConversionPath is {
      conversionPathId: ConversionPathId with {
        briefly "conversionPathId"
        described as {
          |The conversionPathId column of the stored conversionPath row.
        }
      }
      conversionInfo: ConversionInfo with {
        briefly "conversionInfo"
        described as {
          |The conversionInfo column of the stored conversionPath row.
        }
      }
      status: ConversionStatus with {
        briefly "status"
        described as {
          |The status column of the stored conversionPath row.
        }
      }
    } with {
      briefly "Stored conversionPath row"
      described as {
        |The persistence shape of conversionPath data as this repository stores it.
      }
    }
    schema AttributionData is relational
      of conversionPaths as type StoredConversionPath
        index on field StoredConversionPath.conversionPathId
        index on field StoredConversionPath.conversionInfo.customerId
        index on field StoredConversionPath.status
      with {
      briefly "Attribution data schema"
      described as {
        |The relational schema holding attribution data for the AttributionRepository.
      }
    }

    handler AttributionPersistence is {
      on query GetChannelMetrics is {
        do "read the channel metrics projection"
        yield result ChannelMetricsView
      }
      on command ConversionPath.CreateConversionPath is {
        tell event ConversionPath.ConversionPathCreated to entity AttributionContext.ConversionPath
        do "Store new conversion path"
      }
      on command ConversionPath.RecordTouchpoint is {
        tell event ConversionPath.TouchpointRecorded to entity AttributionContext.ConversionPath
        do "Store touchpoint on conversion path"
      }
      on command ConversionPath.RecordConversion is {
        tell event ConversionPath.ConversionRecorded to entity AttributionContext.ConversionPath
        do "Update path to converted"
      }
      on command ConversionPath.ApplyAttributionModel is {
        do "Store attribution results"
      }
      on command ConversionPath.ExpirePath is {
        do "Update path to expired"
      }
    } with {
      briefly "Persists attribution commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Attribution data persistence"
    described as {
      |Persistent storage for attribution data.
    }
  }
  query GetChannelMetrics is {
    channelMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which channel metrics to retrieve.
      }
    }
  } with {
    briefly "Get channel metrics"
    described as {
      |Retrieves the channel metrics projection.
    }
  }
  result ChannelMetricsView is {
    channelMetrics: AttributionMetrics.ChannelMetrics with {
      briefly "Channel metrics"
      described as {
        |The channel metrics being returned.
      }
    }
  } with {
    briefly "Channel metrics view"
    described as {
      |Read model view carrying the channel metrics projection.
    }
  }
  projector AttributionMetrics is {
    inlet AttributionMetricsFromConversionPath is type ConversionPathEvent
    outlet AttributionMetricsOut is type ConversionPathEvent
    updates repository AttributionContext.AttributionRepository
    record ChannelMetrics is  {
      totalConversions: Natural with {
        briefly "Conversions"
        described as {
          |Total conversions.
        }
      }
      totalAttributedRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Attributed revenue.
        }
      }
      averageTouchpoints: Decimal(6,2) with {
        briefly "Avg touchpoints"
        described as {
          |Average touchpoints per path.
        }
      }
      topChannel: ChannelType with {
        briefly "Top channel"
        described as {
          |Highest performing channel.
        }
      }
    } with {
      briefly "Channel metrics"
      described as {
        |Attribution channel metrics.
      }
    }
    handler MetricsHandler is {
      on event ConversionPath.ConversionPathCreated is {
        tell event ConversionPath.ConversionPathCreated to repository AttributionContext.AttributionRepository
        do "Track new conversion path"
      }
      on event ConversionPath.TouchpointRecorded is {
        tell event ConversionPath.TouchpointRecorded to repository AttributionContext.AttributionRepository
        do "Update touchpoint counts"
      }
      on event ConversionPath.AttributionModelApplied is {
        tell event ConversionPath.AttributionModelApplied to repository AttributionContext.AttributionRepository
        do "Update channel revenue and conversion counts"
      }
    } with {
      briefly "Maintains attribution metrics"
      described as {
        |Projects events into attribution metrics.
      }
    }
  } with {
    briefly "Attribution metrics"
    described as {
      |Marketing attribution analytics.
    }
  }
  // ---- Event publication for ConversionPath ----
  type ConversionPathEvent is one of {
    AttributionContext.ConversionPath.ConversionPathCreated,
    AttributionContext.ConversionPath.TouchpointRecorded,
    AttributionContext.ConversionPath.ConversionRecorded,
    AttributionContext.ConversionPath.AttributionModelApplied,
    AttributionContext.ConversionPath.PathExpired,
    AttributionContext.ConversionPath.PathCancelled
  } with {
    briefly "ConversionPath event alternation"
    described as {
      |Union of all ConversionPath events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ConversionPathEventSource as source is {
    outlet ConversionPathEvents is type ConversionPathEvent
    handler ConversionPathSourceHandler is {
      on event ConversionPath.ConversionPathCreated is {
        send event ConversionPath.ConversionPathCreated to outlet ConversionPathEvents
      }
      on event ConversionPath.TouchpointRecorded is {
        send event ConversionPath.TouchpointRecorded to outlet ConversionPathEvents
      }
      on event ConversionPath.ConversionRecorded is {
        send event ConversionPath.ConversionRecorded to outlet ConversionPathEvents
      }
      on event ConversionPath.AttributionModelApplied is {
        send event ConversionPath.AttributionModelApplied to outlet ConversionPathEvents
      }
      on event ConversionPath.PathExpired is {
        send event ConversionPath.PathExpired to outlet ConversionPathEvents
      }
      on event ConversionPath.PathCancelled is {
        send event ConversionPath.PathCancelled to outlet ConversionPathEvents
      }
      on other is {
        error "Unexpected message for source ConversionPathEventSource"
      }
    } with {
      briefly "ConversionPath source handler"
      described as {
        |Publishes ConversionPath events onto the outlet.
      }
    }
  } with {
    briefly "ConversionPath event source"
    described as {
      |Publishes ConversionPath entity events into the streaming topology.
    }
  }
  processor ConversionPathEventSink as sink is {
    inlet ConversionPathInlet is type ConversionPathEvent
    handler ConversionPathSinkHandler is {
      on event ConversionPath.ConversionPathCreated is {
        tell event ConversionPath.ConversionPathCreated to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.TouchpointRecorded is {
        tell event ConversionPath.TouchpointRecorded to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.ConversionRecorded is {
        tell event ConversionPath.ConversionRecorded to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.AttributionModelApplied is {
        tell event ConversionPath.AttributionModelApplied to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.PathExpired is {
        tell event ConversionPath.PathExpired to repository AttributionContext.AttributionRepository
      }
      on event ConversionPath.PathCancelled is {
        tell event ConversionPath.PathCancelled to repository AttributionContext.AttributionRepository
      }
      on other is {
        error "Unexpected message for sink ConversionPathEventSink"
      }
    } with {
      briefly "ConversionPath sink handler"
      described as {
        |Persists ConversionPath events via the repository.
      }
    }
  } with {
    briefly "ConversionPath event sink"
    described as {
      |Receives ConversionPath events for persistence.
    }
  }
  connector ConversionPathEventFlow is {
    from outlet AttributionContext.ConversionPathEventSource.ConversionPathEvents to
      inlet AttributionContext.ConversionPathEventSink.ConversionPathInlet
  } with {
    briefly "ConversionPath event flow"
    described as {
      |Connects the ConversionPath source to its sink.
    }
  }
  processor ConversionPathEventSplit is {
    inlet ConversionPathEventSplitIn is type ConversionPathEvent
    outlet ConversionPathEventSplitToAttributionRepository is type ConversionPathEvent
    outlet ConversionPathEventSplitToAttributionMetrics is type ConversionPathEvent
    handler ConversionPathEventSplitHandler is {
      on event ConversionPath.ConversionPathCreated is {
        send event ConversionPath.ConversionPathCreated to outlet ConversionPathEventSplitToAttributionRepository
        send event ConversionPath.ConversionPathCreated to outlet ConversionPathEventSplitToAttributionMetrics
        tell event ConversionPath.ConversionPathCreated to entity AttributionContext.ConversionPath
      }
      on event ConversionPath.TouchpointRecorded is {
        send event ConversionPath.TouchpointRecorded to outlet ConversionPathEventSplitToAttributionRepository
        send event ConversionPath.TouchpointRecorded to outlet ConversionPathEventSplitToAttributionMetrics
        tell event ConversionPath.TouchpointRecorded to entity AttributionContext.ConversionPath
      }
      on event ConversionPath.ConversionRecorded is {
        send event ConversionPath.ConversionRecorded to outlet ConversionPathEventSplitToAttributionRepository
        send event ConversionPath.ConversionRecorded to outlet ConversionPathEventSplitToAttributionMetrics
        tell event ConversionPath.ConversionRecorded to entity AttributionContext.ConversionPath
      }
      on event ConversionPath.AttributionModelApplied is {
        send event ConversionPath.AttributionModelApplied to outlet ConversionPathEventSplitToAttributionRepository
        send event ConversionPath.AttributionModelApplied to outlet ConversionPathEventSplitToAttributionMetrics
        tell event ConversionPath.AttributionModelApplied to entity AttributionContext.ConversionPath
      }
      on event ConversionPath.PathExpired is {
        send event ConversionPath.PathExpired to outlet ConversionPathEventSplitToAttributionRepository
        send event ConversionPath.PathExpired to outlet ConversionPathEventSplitToAttributionMetrics
        tell event ConversionPath.PathExpired to entity AttributionContext.ConversionPath
      }
      on event ConversionPath.PathCancelled is {
        send event ConversionPath.PathCancelled to outlet ConversionPathEventSplitToAttributionRepository
        send event ConversionPath.PathCancelled to outlet ConversionPathEventSplitToAttributionMetrics
        tell event ConversionPath.PathCancelled to entity AttributionContext.ConversionPath
      }
      on other is {
        error "Unexpected message for processor ConversionPathEventSplit"
      }
    } with {
      briefly "ConversionPath event fan-out handler"
      described as {
        |Delivers each ConversionPath event to all of its consumers.
      }
    }
  } with {
    briefly "ConversionPath event fan-out"
    described as {
      |Fans ConversionPath events out to the repository and projectors.
    }
  }
  connector LinkConversionPathToConversionPathEventSplit is {
    from outlet AttributionContext.ConversionPath.ConversionPathEvents2 to
      inlet AttributionContext.ConversionPathEventSplit.ConversionPathEventSplitIn
  } with {
    briefly "LinkConversionPathToConversionPathEventSplit"
  }
  connector LinkConversionPathEventSplitToAttributionRepository is {
    from outlet AttributionContext.ConversionPathEventSplit.ConversionPathEventSplitToAttributionRepository to
      inlet AttributionContext.AttributionRepository.AttributionRepositoryFromConversionPath
  } with {
    briefly "LinkConversionPathEventSplitToAttributionRepository"
  }
  connector LinkConversionPathEventSplitToAttributionMetrics is {
    from outlet AttributionContext.ConversionPathEventSplit.ConversionPathEventSplitToAttributionMetrics to
      inlet AttributionContext.AttributionMetrics.AttributionMetricsFromConversionPath
  } with {
    briefly "LinkConversionPathEventSplitToAttributionMetrics"
  }
  connector LinkAttributionMetricsToAttributionRepository is {
    from outlet AttributionContext.AttributionMetrics.AttributionMetricsOut to
      inlet AttributionContext.AttributionRepository.AttributionRepositoryFromAttributionMetrics
  } with {
    briefly "LinkAttributionMetricsToAttributionRepository"
  }
} with {
  briefly "Bounded context for marketing attribution"
  described as {
    |Marketing attribution analysis context.
  }
}
