// Marketing Attribution - External Contexts
external context WebAnalytics as split is {
  outlet WebAnalyticsRepliesOut is result PageViewData
 with {
    briefly "What this service answers, on its way back"
  }
  type WebAnalyticsEvent is one of {
    EventTracked or FirstTouchTracked or ConversionTracked
  } with {
    briefly "What WebAnalytics publishes"
  }
  outlet WebAnalyticsEventsOut is type WebAnalyticsEvent
 with {
    briefly "What this service tells the model, unasked"
  }
  type WebAnalyticsRequest is one of {
    TrackEvent or GetPageViews
  } with {
    briefly "Everything this service can be asked"
  }
  inlet WebAnalyticsRequests is type WebAnalyticsRequest with {
    briefly "What this context asks the service to send"
  }
  event FirstTouchTracked is {
    conversionInfo: ConversionInfo with {
      briefly "Conversion info"
      described as {
        |Conversion path details.
      }
    }
  } with {
    briefly "First touch tracked"
    described as {
      |Published by WebAnalytics when the tracked event is a visitor's first touch.
    }
  }
  event ConversionTracked is {
    conversionPathId: ConversionPathId with {
      briefly "Path ID"
      described as {
        |Conversion path identifier.
      }
    }
    convertedAt: TimeStamp with {
      briefly "Converted"
      described as {
        |Conversion time.
      }
    }
    actualValue: Decimal(12,2) with {
      briefly "Value"
      described as {
        |Actual conversion value.
      }
    }
  } with {
    briefly "Conversion tracked"
    described as {
      |Published by WebAnalytics when the tracked event is a conversion.
    }
  }
  handler WebAnalyticsBoundary is {
    on query GetPageViews is {
      let askAnswer: type PageViewData = prompt("look up what GetPageViews asks for")
      reply askAnswer
    }
    on command TrackEvent is {
      let eventTracked: type EventTracked = prompt("the event tracked this produces")
      send eventTracked to outlet WebAnalytics.WebAnalyticsEventsOut
      do "deliver it to the recipient"
      when prompt("the tracked event is a visitor's first touch") then
        let firstTouchTracked: type FirstTouchTracked = prompt("the first touch tracked this produces")
        send firstTouchTracked to outlet WebAnalytics.WebAnalyticsEventsOut
      end
      when prompt("the tracked event is a conversion") then
        let conversionTracked: type ConversionTracked = prompt("the conversion tracked this produces")
        send conversionTracked to outlet WebAnalytics.WebAnalyticsEventsOut
      end
    }
    on other is {
      error "Unexpected message for external context WebAnalytics"
    }
  } with {
    briefly "WebAnalytics boundary"
  }
  query GetPageViews replies result PageViewData is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    period: ReportPeriod with {
      briefly "Period"
      described as {
        |Report period.
      }
    }
  } with {
    briefly "Get page views"
    described as {
      |Retrieves page view data for a customer.
    }
  }
  result PageViewData is {
    pageViews: TouchpointInfo+ with {
      briefly "Views"
      described as {
        |Page view touchpoints.
      }
    }
    sessionCount: Natural with {
      briefly "Sessions"
      described as {
        |Session count.
      }
    }
  } with {
    briefly "Page view data"
    described as {
      |Customer page view information.
    }
  }
  command TrackEvent is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    eventName: String(3,100) with {
      briefly "Event"
      described as {
        |Event name.
      }
    }
    eventData: String(3,2000) with {
      briefly "Data"
      described as {
        |Event data.
      }
    }
    timestamp: TimeStamp with {
      briefly "Time"
      described as {
        |Event time.
      }
    }
  } with {
    briefly "Track event"
    described as {
      |Tracks a web analytics event.
    }
  }
  event EventTracked is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    eventName: String(3,100) with {
      briefly "Event"
      described as {
        |Event name.
      }
    }
    trackedAt: TimeStamp with {
      briefly "Tracked"
      described as {
        |Tracking time.
      }
    }
  } with {
    briefly "Event tracked"
    described as {
      |Emitted when a web event is tracked.
    }
  }
} with {
  briefly "External web analytics system"
  described as {
    |Web analytics platform providing page view and event data.
  }
}
external context CRMSystem as split is {
  outlet CRMSystemRepliesOut is result CustomerJourneyData
 with {
    briefly "What this service answers, on its way back"
  }
  outlet CRMSystemEventsOut is event CustomerAttributionUpdated
 with {
    briefly "What this service tells the model, unasked"
  }
  type CRMSystemRequest is one of {
    UpdateCustomerAttribution or GetCustomerJourney
  } with {
    briefly "Everything this service can be asked"
  }
  inlet CRMSystemRequests is type CRMSystemRequest with {
    briefly "What this context asks the service to send"
  }
  handler CRMSystemBoundary is {
    on query GetCustomerJourney is {
      let askAnswer: type CustomerJourneyData = prompt("look up what GetCustomerJourney asks for")
      reply askAnswer
    }
    on command UpdateCustomerAttribution is {
      let customerAttributionUpdated: type CustomerAttributionUpdated = prompt("the customer attribution updated this produces")
      send customerAttributionUpdated to outlet CRMSystem.CRMSystemEventsOut
      do "deliver it to the recipient"
    }
    on other is {
      error "Unexpected message for external context CRMSystem"
    }
  } with {
    briefly "CRMSystem boundary"
  }
  query GetCustomerJourney replies result CustomerJourneyData is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    period: ReportPeriod with {
      briefly "Period"
      described as {
        |Report period.
      }
    }
  } with {
    briefly "Get customer journey"
    described as {
      |Retrieves customer journey data.
    }
  }
  result CustomerJourneyData is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    interactions: TouchpointInfo+ with {
      briefly "Interactions"
      described as {
        |Customer interactions.
      }
    }
    customerSegment: String(3,100) with {
      briefly "Segment"
      described as {
        |Customer segment.
      }
    }
  } with {
    briefly "Customer journey data"
    described as {
      |Customer journey information from CRM.
    }
  }
  command UpdateCustomerAttribution is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    attributionResults: AttributionResult+ with {
      briefly "Results"
      described as {
        |Attribution results.
      }
    }
    modelType: AttributionModelType with {
      briefly "Model"
      described as {
        |Model used.
      }
    }
  } with {
    briefly "Update customer attribution"
    described as {
      |Updates CRM with attribution results.
    }
  }
  event CustomerAttributionUpdated is {
    customerId: CustomerId with {
      briefly "Customer"
      described as {
        |Customer ID.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Customer attribution updated"
    described as {
      |Emitted when CRM attribution is updated.
    }
  }
} with {
  briefly "External CRM system"
  described as {
    |Customer relationship management system.
  }
}
