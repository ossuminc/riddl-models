// Marketing Attribution Domain Model
// Tracking customer touchpoints and attributing conversions to channels
domain MarketingAttribution is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MarketingAnalyst is "person analyzing attribution data" with {
    briefly "Marketing Analyst"
    described as {
      |Analyst evaluating channel performance.
    }
  }
  user CampaignManager is "person managing marketing campaigns" with {
    briefly "Campaign Manager"
    described as {
      |Manager overseeing campaign execution.
    }
  }
  user DataEngineer is "person maintaining data pipelines" with {
    briefly "Data Engineer"
    described as {
      |Engineer managing attribution data flows.
    }
  }
  epic AttributionAnalysis is {
    user MarketingAnalyst wants to "to attribute conversions to channels" so that "marketing spend can be optimized"
    case AnalyzeConversion is {
      user MarketingAnalyst wants to "to analyze a conversion path" so that "channel contributions are understood"
      step is "Analyst selects" "a conversion" "for analysis" with {
        briefly "Select conversion"
        described as {
          |Choose conversion to analyze.
        }
      }
      step is "System applies" "attribution model" "to touchpoints" with {
        briefly "Apply model"
        described as {
          |Calculate attribution.
        }
      }
    } with {
      briefly "Analyze a conversion"
      described as {
        |Analyzing touchpoints leading to conversion.
      }
    }
  } with {
    briefly "Attribution analysis"
    described as {
      |Epic for marketing attribution analysis.
    }
  }
  include "AttributionContext.riddl"
  include "external-contexts.riddl"
  application context MarketingAttributionApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MarketingAttribution are delivered.
      }
    }
    outlet AppConversionPathCommands is type AttributionContext.ConversionPath.ConversionPathCommand
    inlet AppAttributionRepositoryResponses is type AttributionContext.ConversionPath.ConversionPathResult    handler MarketingAttributionAppHandler is {
      on other is {
        error "Unexpected message for application context MarketingAttributionApp"
      }
    } with {
      briefly "MarketingAttributionApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MarketingAttributionApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ConversionPathCommand Stream' is from outlet MarketingAttributionApp.AppConversionPathCommands to inlet AttributionContext.ConversionPath.ConversionPathCommands with {
    briefly "ConversionPath commands from the application"
  }
  persistent connector 'ConversionPathResult Stream' is from outlet AttributionContext.AttributionRepository.AttributionRepositoryResponses to inlet MarketingAttributionApp.AppAttributionRepositoryResponses with {
    briefly "Attribution query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MarketingAttributionApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Marketing attribution domain"
  described as {
    |Tracking touchpoints and attributing conversions to channels.
  }
}
