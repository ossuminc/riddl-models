// Marketing Attribution - ConversionPath Entity
entity ConversionPath as flow is {
  type ConversionPathCommand is one of {
    ConversionPath.CreateConversionPath or ConversionPath.RecordTouchpoint or ConversionPath.RecordConversion or ConversionPath.ApplyAttributionModel or ConversionPath.ExpirePath or ConversionPath.CancelPath
  } with {
    briefly "ConversionPath command alternation"
    described as {
      |Commands accepted by the ConversionPath entity.
    }
  }
  inlet ConversionPathCommands is type ConversionPathCommand  outlet ConversionPathEvents2 is type ConversionPathEvent
  query GetConversionPath replies result ConversionPathResult is {
    conversionPathId: ConversionPathId with {
      briefly "ID"
      described as {
        |Identifier of the ConversionPath to retrieve.
      }
    }
  } with {
    briefly "Get ConversionPath"
    described as {
      |Retrieve ConversionPath data by identifier.
    }
  }
  result ConversionPathResult is {
    conversionPathId: ConversionPathId with {
      briefly "ConversionPath addressed"
      described as {
        |Which conversionpath this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    conversionPathData: ConversionPath.TrackingStateData with {
      briefly "ConversionPath data"
      described as {
        |The requested ConversionPath data.
      }
    }
  } with {
    briefly "ConversionPath result"
    described as {
      |Result carrying the requested ConversionPath data.
    }
  }
  command CreateConversionPath is {
    conversionPathId: ConversionPathId with {
      briefly "Path ID"
      described as {
        |New conversion path identifier.
      }
    }
    conversionInfo: ConversionInfo with {
      briefly "Conversion info"
      described as {
        |Conversion path details.
      }
    }
  } with {
    briefly "Create conversion path"
    described as {
      |Creates a new conversion path for tracking.
    }
  }
  command RecordTouchpoint is {
    conversionPathId: ConversionPathId with {
      briefly "Path ID"
      described as {
        |Conversion path identifier.
      }
    }
    touchpoint: TouchpointInfo with {
      briefly "Touchpoint"
      described as {
        |Touchpoint to record.
      }
    }
  } with {
    briefly "Record touchpoint"
    described as {
      |Records a customer touchpoint on the path.
    }
  }
  command RecordConversion is {
    conversionPathId: ConversionPathId with {
      briefly "Path ID"
      described as {
        |Conversion path identifier.
      }
    }
    convertedAt: TimeStamp with {
      briefly "Converted"
      described as {
        |Conversion time.
      }
    }
    actualValue: Decimal(12,2) with {
      briefly "Value"
      described as {
        |Actual conversion value.
      }
    }
  } with {
    briefly "Record conversion"
    described as {
      |Records that a conversion occurred.
    }
  }
  command ApplyAttributionModel is {
    conversionPathId: ConversionPathId with {
      briefly "Path ID"
      described as {
        |Conversion path identifier.
      }
    }
    modelType: AttributionModelType with {
      briefly "Model"
      described as {
        |Attribution model to apply.
      }
    }
  } with {
    briefly "Apply attribution model"
    described as {
      |Applies an attribution model to the touchpoints.
    }
  }
  command ExpirePath is {
    conversionPathId: ConversionPathId with {
      briefly "Path ID"
      described as {
        |Conversion path identifier.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Expiration reason.
      }
    }
  } with {
    briefly "Expire path"
    described as {
      |Expires a conversion path past its lookback window.
    }
  }
  command CancelPath is {
    conversionPathId: ConversionPathId with {
      briefly "Path ID"
      described as {
        |Conversion path identifier.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel path"
    described as {
      |Cancels a conversion path.
    }
  }
  // Events
  event ConversionPathCreated is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    conversionInfo: ConversionInfo with {
      briefly "Info"
      described as {
        |Conversion info.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Conversion path created"
    described as {
      |Emitted when a conversion path is created.
    }
  }
  event TouchpointRecorded is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    touchpoint: TouchpointInfo with {
      briefly "Touchpoint"
      described as {
        |Recorded touchpoint.
      }
    }
    touchpointCount: Natural with {
      briefly "Count"
      described as {
        |Total touchpoints.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Recording time.
      }
    }
  } with {
    briefly "Touchpoint recorded"
    described as {
      |Emitted when a touchpoint is recorded.
    }
  }
  event ConversionRecorded is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    actualValue: Decimal(12,2) with {
      briefly "Value"
      described as {
        |Conversion value.
      }
    }
    convertedAt: TimeStamp with {
      briefly "Converted"
      described as {
        |Conversion time.
      }
    }
  } with {
    briefly "Conversion recorded"
    described as {
      |Emitted when a conversion is recorded.
    }
  }
  event AttributionModelApplied is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    modelType: AttributionModelType with {
      briefly "Model"
      described as {
        |Model applied.
      }
    }
    results: AttributionResult+ with {
      briefly "Results"
      described as {
        |Attribution results.
      }
    }
    appliedAt: TimeStamp with {
      briefly "Applied"
      described as {
        |Application time.
      }
    }
  } with {
    briefly "Attribution model applied"
    described as {
      |Emitted when attribution model is applied.
    }
  }
  event PathExpired is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Expiration reason.
      }
    }
    expiredAt: TimeStamp with {
      briefly "Expired"
      described as {
        |Expiration time.
      }
    }
  } with {
    briefly "Path expired"
    described as {
      |Emitted when a conversion path expires.
    }
  }
  event PathCancelled is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    reason: String(3,500) with {
      briefly "Reason"
      described as {
        |Cancel reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Path cancelled"
    described as {
      |Emitted when a conversion path is cancelled.
    }
  }
  // States
  record TrackingStateData is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    conversionInfo: ConversionInfo with {
      briefly "Info"
      described as {
        |Conversion info.
      }
    }
    recordedTouchpoints: TouchpointInfo* with {
      briefly "Touchpoints"
      described as {
        |Recorded touchpoints.
      }
    }
    status: ConversionStatus with {
      briefly "Status"
      described as {
        |Path status.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Tracking state data"
    described as {
      |State for a conversion path being tracked.
    }
  }
  record AttributedStateData is {
    conversionPathId: ConversionPathId with {
      briefly "Path"
      described as {
        |Path ID.
      }
    }
    conversionInfo: ConversionInfo with {
      briefly "Info"
      described as {
        |Conversion info.
      }
    }
    touchpoints: TouchpointInfo+ with {
      briefly "Touchpoints"
      described as {
        |All touchpoints.
      }
    }
    modelType: AttributionModelType with {
      briefly "Model"
      described as {
        |Model used.
      }
    }
    results: AttributionResult+ with {
      briefly "Results"
      described as {
        |Attribution results.
      }
    }
    convertedAt: TimeStamp with {
      briefly "Converted"
      described as {
        |Conversion time.
      }
    }
    attributedAt: TimeStamp with {
      briefly "Attributed"
      described as {
        |Attribution time.
      }
    }
  } with {
    briefly "Attributed state data"
    described as {
      |State for a fully attributed conversion.
    }
  }
  initial state TrackingState of record ConversionPath.TrackingStateData is {
    initial handler TrackingStateInitHandler is {
      on query GetConversionPath is {
        let conversionPathResult: type ConversionPathResult = prompt("read the conversion path from the store")
        reply conversionPathResult
      }
      on init is {
        set state TrackingState to "initialize ConversionPath.TrackingStateData fields from the creating message"
      }
    } with {
      briefly "TrackingState initialization"
      described as {
        |Initializes TrackingState from the message that caused the
        |entity to enter it.
      }
    }
  } with {
    briefly "Tracking state"
    described as {
      |The tracking state of the ConversionPath entity, carrying TrackingStateData.
    }
  }
  state AttributedState of record ConversionPath.AttributedStateData with {
    briefly "Attributed state"
    described as {
      |The attributed state of the ConversionPath entity, carrying AttributedStateData.
    }
  }
  handler ConversionPathHandler is {
    on init is {
      set state AttributedState to "initialize ConversionPath.AttributedStateData fields from the creating message"
    }
    on createConversionPath: command CreateConversionPath is {
      morph entity AttributionContext.ConversionPath to state AttributionContext.ConversionPath.TrackingState with record ConversionPath.TrackingStateData(conversionPathId = createConversionPath.conversionPathId, conversionInfo = createConversionPath.conversionInfo, recordedTouchpoints = empty, status = prompt("the status of this tracking state data"), createdAt = prompt("the created at of this tracking state data"))
      tell event ConversionPathCreated(conversionPathId = createConversionPath.conversionPathId, conversionInfo = createConversionPath.conversionInfo, createdAt = prompt("the created at of this conversion path created")) to entity AttributionContext.ConversionPath
    }
    on recordTouchpoint: command RecordTouchpoint is {
      tell event TouchpointRecorded(conversionPathId = recordTouchpoint.conversionPathId, touchpoint = recordTouchpoint.touchpoint, touchpointCount = prompt("the touchpoint count of this touchpoint recorded"), recordedAt = prompt("the recorded at of this touchpoint recorded")) to entity AttributionContext.ConversionPath
    }
    on recordConversion: command RecordConversion is {
      tell event ConversionRecorded(conversionPathId = recordConversion.conversionPathId, actualValue = recordConversion.actualValue, convertedAt = recordConversion.convertedAt) to entity AttributionContext.ConversionPath
    }
    on applyAttributionModel: command ApplyAttributionModel is {
      morph entity AttributionContext.ConversionPath to state AttributionContext.ConversionPath.AttributedState with record ConversionPath.AttributedStateData(conversionPathId = applyAttributionModel.conversionPathId, modelType = applyAttributionModel.modelType, conversionInfo = prompt("the conversion info of this attributed state data"), touchpoints = prompt("the touchpoints of this attributed state data"), results = prompt("the results of this attributed state data"), convertedAt = prompt("the converted at of this attributed state data"), attributedAt = prompt("the attributed at of this attributed state data"))
      tell event AttributionModelApplied(conversionPathId = applyAttributionModel.conversionPathId, modelType = applyAttributionModel.modelType, results = prompt("the results of this attribution model applied"), appliedAt = prompt("the applied at of this attribution model applied")) to entity AttributionContext.ConversionPath
    }
    on expirePath: command ExpirePath is {
      tell event PathExpired(conversionPathId = expirePath.conversionPathId, reason = expirePath.reason, expiredAt = prompt("the expired at of this path expired")) to entity AttributionContext.ConversionPath
    }
    on cancelPath: command CancelPath is {
      tell event PathCancelled(conversionPathId = cancelPath.conversionPathId, reason = cancelPath.reason, cancelledAt = prompt("the cancelled at of this path cancelled")) to entity AttributionContext.ConversionPath
    }
    on attributionModelApplied: event AttributionModelApplied is {
      do "apply AttributionModelApplied to the conversionPath so it can be persisted and replayed"
    }
    on conversionPathCreated: event ConversionPathCreated is {
      do "apply ConversionPathCreated to the conversionPath so it can be persisted and replayed"
    }
    on conversionRecorded: event ConversionRecorded is {
      do "apply ConversionRecorded to the conversionPath so it can be persisted and replayed"
    }
    on pathCancelled: event PathCancelled is {
      do "apply PathCancelled to the conversionPath so it can be persisted and replayed"
    }
    on pathExpired: event PathExpired is {
      do "apply PathExpired to the conversionPath so it can be persisted and replayed"
    }
    on touchpointRecorded: event TouchpointRecorded is {
      do "apply TouchpointRecorded to the conversionPath so it can be persisted and replayed"
    }
  } with {
    briefly "Processes conversion path commands"
    described as {
      |Handles conversion path lifecycle.
    }
  }
} with {
  briefly "ConversionPath aggregate"
  described as {
    |Manages customer conversion paths and attribution.
  }
}
