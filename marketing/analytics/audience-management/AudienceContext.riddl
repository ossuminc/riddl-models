// Audience Management - Audience Context
context AudienceContext as router is {
  inlet AudienceSegmentCommandStreamIn is type AudienceSegmentCommand  outlet AudienceSegmentCommandStreamOut is type AudienceSegmentCommand
  inlet AudienceSegmentResultStreamIn is result AudienceSegment.AudienceSegmentResult  outlet AudienceSegmentResultStreamOut is result AudienceSegment.AudienceSegmentResult
  handler AudienceContextBoundary is {
    on createSegment: command AudienceSegment.CreateSegment is {
      send createSegment to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on updateCriteria: command AudienceSegment.UpdateCriteria is {
      send updateCriteria to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on buildSegment: command AudienceSegment.BuildSegment is {
      send buildSegment to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on attachPersona: command AudienceSegment.AttachPersona is {
      send attachPersona to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on activateSegment: command AudienceSegment.ActivateSegment is {
      send activateSegment to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on configureLookalike: command AudienceSegment.ConfigureLookalike is {
      send configureLookalike to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on pauseSegment: command AudienceSegment.PauseSegment is {
      send pauseSegment to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on archiveSegment: command AudienceSegment.ArchiveSegment is {
      send archiveSegment to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on failSegmentBuild: command AudienceSegment.FailSegmentBuild is {
      send failSegmentBuild to outlet AudienceContext.AudienceSegmentCommandStreamOut
    }
    on audienceSegmentResult: result AudienceSegment.AudienceSegmentResult is {
      send audienceSegmentResult to outlet AudienceContext.AudienceSegmentResultStreamOut
    }
    on other is {
      error "Unexpected message at the AudienceContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AudienceSegmentCommand Stream Intake' is from outlet AudienceContext.AudienceSegmentCommandStreamOut to inlet AudienceContext.AudienceSegment.AudienceSegmentCommands  connector 'AudienceSegmentResult Stream Egress' is from outlet AudienceContext.AudienceRepository.AudienceRepositoryResponses to inlet AudienceContext.AudienceSegmentResultStreamIn  adaptor FromAdPlatform from context AdPlatform is { 
    handler FromAdPlatformHandler is {
      on event AdPlatform.AudiencePushed is {
        do "the model receives audience pushed"
      }
      on result AdPlatform.ChannelReach is {
        do "the model receives channel reach"
      }
      on event AdPlatform.LookalikeAudienceBuilt is {
        do "the model receives lookalike audience built"
      }
      on other is {
        error "Unexpected message for adaptor FromAdPlatform"
      }
    } with {
      briefly "from ad platform"
      described as {
        |Carries messages from the external AdPlatform.
      }
    }
  } with {
    briefly "AdPlatform integration"
    described as {
      |The model's side of the AdPlatform conversation.
    }
  }
  adaptor ToAdPlatform to context AdPlatform is { 
    handler ToAdPlatformHandler is {
      on command AdPlatform.BuildLookalikeAudience is {
        do "the model sends build lookalike audience"
      }
      on query AdPlatform.GetChannelReach is {
        do "the model sends get channel reach"
      }
      on command AdPlatform.PushAudience is {
        do "the model sends push audience"
      }
      on other is {
        error "Unexpected message for adaptor ToAdPlatform"
      }
    } with {
      briefly "to ad platform"
      described as {
        |Carries messages to the external AdPlatform.
      }
    }
  } with {
    briefly "AdPlatform integration"
    described as {
      |The model's side of the AdPlatform conversation.
    }
  }
  adaptor FromDataManagementPlatform from context DataManagementPlatform is { 
    handler FromDataManagementPlatformHandler is {
      on event DataManagementPlatform.AudienceDataSynced is {
        do "the model receives audience data synced"
      }
      on result DataManagementPlatform.CustomerProfiles is {
        do "the model receives customer profiles"
      }
      on other is {
        error "Unexpected message for adaptor FromDataManagementPlatform"
      }
    } with {
      briefly "from data management platform"
      described as {
        |Carries messages from the external DataManagementPlatform.
      }
    }
  } with {
    briefly "DataManagementPlatform integration"
    described as {
      |The model's side of the DataManagementPlatform conversation.
    }
  }
  adaptor ToDataManagementPlatform to context DataManagementPlatform is { 
    handler ToDataManagementPlatformHandler is {
      on query DataManagementPlatform.GetCustomerProfiles is {
        do "the model sends get customer profiles"
      }
      on command DataManagementPlatform.SyncAudienceData is {
        do "the model sends sync audience data"
      }
      on other is {
        error "Unexpected message for adaptor ToDataManagementPlatform"
      }
    } with {
      briefly "to data management platform"
      described as {
        |Carries messages to the external DataManagementPlatform.
      }
    }
  } with {
    briefly "DataManagementPlatform integration"
    described as {
      |The model's side of the DataManagementPlatform conversation.
    }
  }
  include "types.riddl"
  include "AudienceSegment.riddl"
  type AudienceRepositoryCommand is one of {
    AudienceContext.AudienceRepository.PersistCriteriaUpdated or AudienceContext.AudienceRepository.PersistLookalikeConfigured or AudienceContext.AudienceRepository.PersistPersonaAttached or AudienceContext.AudienceRepository.PersistSegmentActivated or AudienceContext.AudienceRepository.PersistSegmentArchived or AudienceContext.AudienceRepository.PersistSegmentBuildCompleted or AudienceContext.AudienceRepository.PersistSegmentBuildFailed or AudienceContext.AudienceRepository.PersistSegmentBuildStarted or AudienceContext.AudienceRepository.PersistSegmentCreated or AudienceContext.AudienceRepository.PersistSegmentPaused
  } with {
    briefly "Anything that writes AudienceRepository"
    described as {
      |The persistence commands AudienceRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AudienceRepository as flow is {
    inlet AudienceRepositoryFromAudienceMetrics is type AudienceRepositoryCommand    command PersistCriteriaUpdated is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row CriteriaUpdated applies to.
        }
      }
    } with {
      briefly "Persist CriteriaUpdated"
      described as {
        |Instructs this repository to apply CriteriaUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistLookalikeConfigured is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row LookalikeConfigured applies to.
        }
      }
    } with {
      briefly "Persist LookalikeConfigured"
      described as {
        |Instructs this repository to apply LookalikeConfigured to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPersonaAttached is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row PersonaAttached applies to.
        }
      }
    } with {
      briefly "Persist PersonaAttached"
      described as {
        |Instructs this repository to apply PersonaAttached to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentBuildFailed is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentBuildFailed applies to.
        }
      }
    } with {
      briefly "Persist SegmentBuildFailed"
      described as {
        |Instructs this repository to apply SegmentBuildFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentBuildStarted is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentBuildStarted applies to.
        }
      }
    } with {
      briefly "Persist SegmentBuildStarted"
      described as {
        |Instructs this repository to apply SegmentBuildStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentPaused is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentPaused applies to.
        }
      }
    } with {
      briefly "Persist SegmentPaused"
      described as {
        |Instructs this repository to apply SegmentPaused to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentActivated is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentActivated applies to.
        }
      }
    } with {
      briefly "Persist SegmentActivated"
      described as {
        |Instructs this repository to apply SegmentActivated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentArchived is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentArchived applies to.
        }
      }
    } with {
      briefly "Persist SegmentArchived"
      described as {
        |Instructs this repository to apply SegmentArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentBuildCompleted is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentBuildCompleted applies to.
        }
      }
    } with {
      briefly "Persist SegmentBuildCompleted"
      described as {
        |Instructs this repository to apply SegmentBuildCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSegmentCreated is {
      segmentId: SegmentId with {
        briefly "Row addressed"
        described as {
          |Which stored row SegmentCreated applies to.
        }
      }
    } with {
      briefly "Persist SegmentCreated"
      described as {
        |Instructs this repository to apply SegmentCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AudienceRepositoryResponses is result AudienceSegment.AudienceSegmentResult
    record StoredAudienceSegment is {
      audienceSegmentId: UUID with {
        briefly "audienceSegmentId"
        described as {
          |The audienceSegmentId column of the stored audienceSegment row.
        }
      }
      segmentId: SegmentId with {
        briefly "segmentId"
        described as {
          |The segmentId column of the stored audienceSegment row.
        }
      }
      segmentName: String(3,200) with {
        briefly "segmentName"
        described as {
          |The segmentName column of the stored audienceSegment row.
        }
      }
      status: SegmentStatus with {
        briefly "status"
        described as {
          |The status column of the stored audienceSegment row.
        }
      }
    } with {
      briefly "Stored audienceSegment row"
      described as {
        |The persistence shape of audienceSegment data as this repository stores it.
      }
    }
    schema AudienceData is relational
      of audienceSegments as record StoredAudienceSegment
        index on field StoredAudienceSegment.segmentId
        index on field StoredAudienceSegment.segmentName
        index on field StoredAudienceSegment.status
 with {
      briefly "Audience data schema"
      described as {
        |The relational schema holding audience data for the AudienceRepository.
      }
    }
    handler AudiencePersistence is {
      on persistCriteriaUpdated: command PersistCriteriaUpdated is {
        do "apply CriteriaUpdated to the stored row"
      }
      on persistLookalikeConfigured: command PersistLookalikeConfigured is {
        do "apply LookalikeConfigured to the stored row"
      }
      on persistPersonaAttached: command PersistPersonaAttached is {
        do "apply PersonaAttached to the stored row"
      }
      on persistSegmentBuildFailed: command PersistSegmentBuildFailed is {
        do "apply SegmentBuildFailed to the stored row"
      }
      on persistSegmentBuildStarted: command PersistSegmentBuildStarted is {
        do "apply SegmentBuildStarted to the stored row"
      }
      on persistSegmentPaused: command PersistSegmentPaused is {
        do "apply SegmentPaused to the stored row"
      }
      on persistSegmentActivated: command PersistSegmentActivated is {
        do "apply SegmentActivated to the stored row"
      }
      on persistSegmentArchived: command PersistSegmentArchived is {
        do "apply SegmentArchived to the stored row"
      }
      on persistSegmentBuildCompleted: command PersistSegmentBuildCompleted is {
        do "apply SegmentBuildCompleted to the stored row"
      }
      on persistSegmentCreated: command PersistSegmentCreated is {
        do "apply SegmentCreated to the stored row"
      }
      on query GetSegmentMetrics is {
        let segmentMetricsView: type SegmentMetricsView = prompt("read the segment metrics projection")
        reply segmentMetricsView
      }
    } with {
      briefly "Persists audience commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Audience data persistence"
    described as {
      |Persistent storage for audience segments.
    }
  }
  query GetSegmentMetrics replies result SegmentMetricsView is {
    segmentMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which segment metrics to retrieve.
      }
    }
  } with {
    briefly "Get segment metrics"
    described as {
      |Retrieves the segment metrics projection.
    }
  }
  result SegmentMetricsView is {
    segmentMetrics: AudienceMetrics.SegmentMetrics with {
      briefly "Segment metrics"
      described as {
        |The segment metrics being returned.
      }
    }
  } with {
    briefly "Segment metrics view"
    described as {
      |Read model view carrying the segment metrics projection.
    }
  }
  projector AudienceMetrics as flow is {
    updates repository AudienceContext.AudienceRepository
    outlet AudienceMetricsToRepository is type AudienceRepositoryCommand
    inlet AudienceMetricsFromAudienceSegment is type AudienceSegmentEvent    record SegmentMetrics is {
      totalSegments: Natural with {
        briefly "Total"
        described as {
          |Total segments.
        }
      }
      activeSegments: Natural with {
        briefly "Active"
        described as {
          |Active segments.
        }
      }
      totalMembers: Natural with {
        briefly "Members"
        described as {
          |Total audience members.
        }
      }
      activationsCount: Natural with {
        briefly "Activations"
        described as {
          |Total activations.
        }
      }
      averageSegmentSize: Decimal(10,2) with {
        briefly "Avg size"
        described as {
          |Average segment member count.
        }
      }
    } with {
      briefly "Segment metrics"
      described as {
        |Audience segment analytics.
      }
    }
    handler MetricsHandler is {
      on criteriaUpdated: event AudienceSegment.CriteriaUpdated is {
        tell command AudienceContext.AudienceRepository.PersistCriteriaUpdated(segmentId = criteriaUpdated.segmentId) to repository AudienceContext.AudienceRepository
        do "apply CriteriaUpdated to the AudienceMetrics projection"
      }
      on lookalikeConfigured: event AudienceSegment.LookalikeConfigured is {
        tell command AudienceContext.AudienceRepository.PersistLookalikeConfigured(segmentId = lookalikeConfigured.segmentId) to repository AudienceContext.AudienceRepository
        do "apply LookalikeConfigured to the AudienceMetrics projection"
      }
      on personaAttached: event AudienceSegment.PersonaAttached is {
        tell command AudienceContext.AudienceRepository.PersistPersonaAttached(segmentId = personaAttached.segmentId) to repository AudienceContext.AudienceRepository
        do "apply PersonaAttached to the AudienceMetrics projection"
      }
      on segmentBuildFailed: event AudienceSegment.SegmentBuildFailed is {
        tell command AudienceContext.AudienceRepository.PersistSegmentBuildFailed(segmentId = segmentBuildFailed.segmentId) to repository AudienceContext.AudienceRepository
        do "apply SegmentBuildFailed to the AudienceMetrics projection"
      }
      on segmentBuildStarted: event AudienceSegment.SegmentBuildStarted is {
        tell command AudienceContext.AudienceRepository.PersistSegmentBuildStarted(segmentId = segmentBuildStarted.segmentId) to repository AudienceContext.AudienceRepository
        do "apply SegmentBuildStarted to the AudienceMetrics projection"
      }
      on segmentPaused: event AudienceSegment.SegmentPaused is {
        tell command AudienceContext.AudienceRepository.PersistSegmentPaused(segmentId = segmentPaused.segmentId) to repository AudienceContext.AudienceRepository
        do "apply SegmentPaused to the AudienceMetrics projection"
      }
      on segmentCreated: event AudienceSegment.SegmentCreated is {
        tell command AudienceContext.AudienceRepository.PersistSegmentCreated(segmentId = segmentCreated.segmentId) to repository AudienceContext.AudienceRepository
        do "Increment total and active segments"
      }
      on segmentBuildCompleted: event AudienceSegment.SegmentBuildCompleted is {
        tell command AudienceContext.AudienceRepository.PersistSegmentBuildCompleted(segmentId = segmentBuildCompleted.segmentId) to repository AudienceContext.AudienceRepository
        do "Update total members and average size"
      }
      on segmentActivated: event AudienceSegment.SegmentActivated is {
        tell command AudienceContext.AudienceRepository.PersistSegmentActivated(segmentId = segmentActivated.segmentId) to repository AudienceContext.AudienceRepository
        do "Increment activations count"
      }
      on segmentArchived: event AudienceSegment.SegmentArchived is {
        tell command AudienceContext.AudienceRepository.PersistSegmentArchived(segmentId = segmentArchived.segmentId) to repository AudienceContext.AudienceRepository
        do "Decrement active segments"
      }
    } with {
      briefly "Maintains audience metrics"
      described as {
        |Projects events into audience analytics.
      }
    }
  } with {
    briefly "Audience metrics"
    described as {
      |Audience management analytics and reporting.
    }
  }
  // ---- Event publication for AudienceSegment ----
  type AudienceSegmentEvent is one of {
    AudienceContext.AudienceSegment.SegmentCreated or AudienceContext.AudienceSegment.CriteriaUpdated or AudienceContext.AudienceSegment.SegmentBuildStarted or AudienceContext.AudienceSegment.SegmentBuildCompleted or AudienceContext.AudienceSegment.PersonaAttached or AudienceContext.AudienceSegment.SegmentActivated or AudienceContext.AudienceSegment.LookalikeConfigured or AudienceContext.AudienceSegment.SegmentPaused or AudienceContext.AudienceSegment.SegmentArchived or AudienceContext.AudienceSegment.SegmentBuildFailed
  } with {
    briefly "AudienceSegment event alternation"
    described as {
      |Union of all AudienceSegment events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet AudienceSegmentEventSplit as flow is {
    inlet AudienceSegmentEventSplitIn is type AudienceSegmentEvent    outlet AudienceSegmentEventSplitToAudienceMetrics is type AudienceSegmentEvent
    handler AudienceSegmentEventSplitHandler is {
      on segmentCreated: event AudienceSegment.SegmentCreated is {
        send segmentCreated to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell segmentCreated to entity AudienceContext.AudienceSegment
      }
      on criteriaUpdated: event AudienceSegment.CriteriaUpdated is {
        send criteriaUpdated to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell criteriaUpdated to entity AudienceContext.AudienceSegment
      }
      on segmentBuildStarted: event AudienceSegment.SegmentBuildStarted is {
        send segmentBuildStarted to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell segmentBuildStarted to entity AudienceContext.AudienceSegment
      }
      on segmentBuildCompleted: event AudienceSegment.SegmentBuildCompleted is {
        send segmentBuildCompleted to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell segmentBuildCompleted to entity AudienceContext.AudienceSegment
      }
      on personaAttached: event AudienceSegment.PersonaAttached is {
        send personaAttached to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell personaAttached to entity AudienceContext.AudienceSegment
      }
      on segmentActivated: event AudienceSegment.SegmentActivated is {
        send segmentActivated to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell segmentActivated to entity AudienceContext.AudienceSegment
      }
      on lookalikeConfigured: event AudienceSegment.LookalikeConfigured is {
        send lookalikeConfigured to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell lookalikeConfigured to entity AudienceContext.AudienceSegment by segmentId
      }
      on segmentPaused: event AudienceSegment.SegmentPaused is {
        send segmentPaused to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell segmentPaused to entity AudienceContext.AudienceSegment
      }
      on segmentArchived: event AudienceSegment.SegmentArchived is {
        send segmentArchived to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell segmentArchived to entity AudienceContext.AudienceSegment
      }
      on segmentBuildFailed: event AudienceSegment.SegmentBuildFailed is {
        send segmentBuildFailed to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell segmentBuildFailed to entity AudienceContext.AudienceSegment
      }
      on other is {
        error "Unexpected message for processor AudienceSegmentEventSplit"
      }
    } with {
      briefly "AudienceSegment event fan-out handler"
      described as {
        |Delivers each AudienceSegment event to all of its consumers.
      }
    }
  } with {
    briefly "AudienceSegment event fan-out"
    described as {
      |Fans AudienceSegment events out to the repository and projectors.
    }
  }
  connector 'AudienceSegmentEvent Stream' is from outlet AudienceContext.AudienceSegment.AudienceSegmentEvents2 to inlet AudienceContext.AudienceSegmentEventSplit.AudienceSegmentEventSplitIn with {
    briefly "AudienceSegment events, fanned out to storage and read models"
  }
  connector 'AudienceMetrics Feed' is from outlet AudienceContext.AudienceSegmentEventSplit.AudienceSegmentEventSplitToAudienceMetrics to inlet AudienceContext.AudienceMetrics.AudienceMetricsFromAudienceSegment with {
    briefly "AudienceSegment events feeding the AudienceMetrics projection"
  }
  connector 'AudienceMetrics Storage' is from outlet AudienceContext.AudienceMetrics.AudienceMetricsToRepository to inlet AudienceContext.AudienceRepository.AudienceRepositoryFromAudienceMetrics with {
    briefly "AudienceMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for audience management"
  described as {
    |Audience segmentation and activation context.
  }
}
