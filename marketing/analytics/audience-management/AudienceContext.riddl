// Audience Management - Audience Context
context AudienceContext is {
  include "types.riddl"
  include "AudienceSegment.riddl"
  repository AudienceRepository is {
    inlet AudienceRepositoryFromAudienceSegment is type AudienceSegmentEvent
    inlet AudienceRepositoryFromAudienceMetrics is type AudienceSegmentEvent
    outlet AudienceRepositoryResponses is type AudienceSegment.AudienceSegmentResult
    schema AudienceData is relational
      of audienceSegments as type AudienceSegment
        index on field AudienceSegment.segmentId
        index on field AudienceSegment.segmentName
        index on field AudienceSegment.status
      with {
      briefly "Audience data schema"
      described as {
        |The relational schema holding audience data for the AudienceRepository.
      }
    }

    handler AudiencePersistence is {
      on command AudienceSegment.CreateSegment is {
        tell event AudienceSegment.SegmentCreated to entity AudienceContext.AudienceSegment
        do "Store new audience segment"
      }
      on command AudienceSegment.UpdateCriteria is {
        tell event AudienceSegment.CriteriaUpdated to entity AudienceContext.AudienceSegment
        do "Update segment criteria"
      }
      on command AudienceSegment.BuildSegment is {
        do "Store segment members"
      }
      on command AudienceSegment.ActivateSegment is {
        do "Record channel activation"
      }
      on command AudienceSegment.ArchiveSegment is {
        do "Mark segment as archived"
      }
    } with {
      briefly "Persists audience commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Audience data persistence"
    described as {
      |Persistent storage for audience segments.
    }
  }
  projector AudienceMetrics is {
    inlet AudienceMetricsFromAudienceSegment is type AudienceSegmentEvent
    outlet AudienceMetricsOut is type AudienceSegmentEvent
    updates repository AudienceContext.AudienceRepository
    record SegmentMetrics is  {
      totalSegments: Natural with {
        briefly "Total"
        described as {
          |Total segments.
        }
      }
      activeSegments: Natural with {
        briefly "Active"
        described as {
          |Active segments.
        }
      }
      totalMembers: Natural with {
        briefly "Members"
        described as {
          |Total audience members.
        }
      }
      activationsCount: Natural with {
        briefly "Activations"
        described as {
          |Total activations.
        }
      }
      averageSegmentSize: Decimal(10,2) with {
        briefly "Avg size"
        described as {
          |Average segment member count.
        }
      }
    } with {
      briefly "Segment metrics"
      described as {
        |Audience segment analytics.
      }
    }
    handler MetricsHandler is {
      on event AudienceSegment.SegmentCreated is {
        tell event AudienceSegment.SegmentCreated to repository AudienceContext.AudienceRepository
        do "Increment total and active segments"
      }
      on event AudienceSegment.SegmentBuildCompleted is {
        tell event AudienceSegment.SegmentBuildCompleted to repository AudienceContext.AudienceRepository
        do "Update total members and average size"
      }
      on event AudienceSegment.SegmentActivated is {
        tell event AudienceSegment.SegmentActivated to repository AudienceContext.AudienceRepository
        do "Increment activations count"
      }
      on event AudienceSegment.SegmentArchived is {
        tell event AudienceSegment.SegmentArchived to repository AudienceContext.AudienceRepository
        do "Decrement active segments"
      }
    } with {
      briefly "Maintains audience metrics"
      described as {
        |Projects events into audience analytics.
      }
    }
  } with {
    briefly "Audience metrics"
    described as {
      |Audience management analytics and reporting.
    }
  }
  // ---- Event publication for AudienceSegment ----
  type AudienceSegmentEvent is one of {
    AudienceContext.AudienceSegment.SegmentCreated,
    AudienceContext.AudienceSegment.CriteriaUpdated,
    AudienceContext.AudienceSegment.SegmentBuildStarted,
    AudienceContext.AudienceSegment.SegmentBuildCompleted,
    AudienceContext.AudienceSegment.PersonaAttached,
    AudienceContext.AudienceSegment.SegmentActivated,
    AudienceContext.AudienceSegment.LookalikeConfigured,
    AudienceContext.AudienceSegment.SegmentPaused,
    AudienceContext.AudienceSegment.SegmentArchived,
    AudienceContext.AudienceSegment.SegmentBuildFailed
  } with {
    briefly "AudienceSegment event alternation"
    described as {
      |Union of all AudienceSegment events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AudienceSegmentEventSource as source is {
    outlet AudienceSegmentEvents is type AudienceSegmentEvent
    handler AudienceSegmentSourceHandler is {
      on event AudienceSegment.SegmentCreated is {
        send event AudienceSegment.SegmentCreated to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.CriteriaUpdated is {
        send event AudienceSegment.CriteriaUpdated to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.SegmentBuildStarted is {
        send event AudienceSegment.SegmentBuildStarted to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.SegmentBuildCompleted is {
        send event AudienceSegment.SegmentBuildCompleted to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.PersonaAttached is {
        send event AudienceSegment.PersonaAttached to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.SegmentActivated is {
        send event AudienceSegment.SegmentActivated to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.LookalikeConfigured is {
        send event AudienceSegment.LookalikeConfigured to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.SegmentPaused is {
        send event AudienceSegment.SegmentPaused to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.SegmentArchived is {
        send event AudienceSegment.SegmentArchived to outlet AudienceSegmentEvents
      }
      on event AudienceSegment.SegmentBuildFailed is {
        send event AudienceSegment.SegmentBuildFailed to outlet AudienceSegmentEvents
      }
      on other is {
        error "Unexpected message for source AudienceSegmentEventSource"
      }
    } with {
      briefly "AudienceSegment source handler"
      described as {
        |Publishes AudienceSegment events onto the outlet.
      }
    }
  } with {
    briefly "AudienceSegment event source"
    described as {
      |Publishes AudienceSegment entity events into the streaming topology.
    }
  }
  processor AudienceSegmentEventSink as sink is {
    inlet AudienceSegmentInlet is type AudienceSegmentEvent
    handler AudienceSegmentSinkHandler is {
      on event AudienceSegment.SegmentCreated is {
        tell event AudienceSegment.SegmentCreated to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.CriteriaUpdated is {
        tell event AudienceSegment.CriteriaUpdated to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.SegmentBuildStarted is {
        tell event AudienceSegment.SegmentBuildStarted to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.SegmentBuildCompleted is {
        tell event AudienceSegment.SegmentBuildCompleted to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.PersonaAttached is {
        tell event AudienceSegment.PersonaAttached to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.SegmentActivated is {
        tell event AudienceSegment.SegmentActivated to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.LookalikeConfigured is {
        tell event AudienceSegment.LookalikeConfigured to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.SegmentPaused is {
        tell event AudienceSegment.SegmentPaused to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.SegmentArchived is {
        tell event AudienceSegment.SegmentArchived to repository AudienceContext.AudienceRepository
      }
      on event AudienceSegment.SegmentBuildFailed is {
        tell event AudienceSegment.SegmentBuildFailed to repository AudienceContext.AudienceRepository
      }
      on other is {
        error "Unexpected message for sink AudienceSegmentEventSink"
      }
    } with {
      briefly "AudienceSegment sink handler"
      described as {
        |Persists AudienceSegment events via the repository.
      }
    }
  } with {
    briefly "AudienceSegment event sink"
    described as {
      |Receives AudienceSegment events for persistence.
    }
  }
  connector AudienceSegmentEventFlow is {
    from outlet AudienceContext.AudienceSegmentEventSource.AudienceSegmentEvents to
      inlet AudienceContext.AudienceSegmentEventSink.AudienceSegmentInlet
  } with {
    briefly "AudienceSegment event flow"
    described as {
      |Connects the AudienceSegment source to its sink.
    }
  }
  processor AudienceSegmentEventSplit is {
    inlet AudienceSegmentEventSplitIn is type AudienceSegmentEvent
    outlet AudienceSegmentEventSplitToAudienceRepository is type AudienceSegmentEvent
    outlet AudienceSegmentEventSplitToAudienceMetrics is type AudienceSegmentEvent
    handler AudienceSegmentEventSplitHandler is {
      on event AudienceSegment.SegmentCreated is {
        send event AudienceSegment.SegmentCreated to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.SegmentCreated to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.SegmentCreated to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.CriteriaUpdated is {
        send event AudienceSegment.CriteriaUpdated to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.CriteriaUpdated to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.CriteriaUpdated to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.SegmentBuildStarted is {
        send event AudienceSegment.SegmentBuildStarted to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.SegmentBuildStarted to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.SegmentBuildStarted to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.SegmentBuildCompleted is {
        send event AudienceSegment.SegmentBuildCompleted to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.SegmentBuildCompleted to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.SegmentBuildCompleted to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.PersonaAttached is {
        send event AudienceSegment.PersonaAttached to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.PersonaAttached to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.PersonaAttached to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.SegmentActivated is {
        send event AudienceSegment.SegmentActivated to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.SegmentActivated to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.SegmentActivated to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.LookalikeConfigured is {
        send event AudienceSegment.LookalikeConfigured to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.LookalikeConfigured to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.LookalikeConfigured to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.SegmentPaused is {
        send event AudienceSegment.SegmentPaused to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.SegmentPaused to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.SegmentPaused to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.SegmentArchived is {
        send event AudienceSegment.SegmentArchived to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.SegmentArchived to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.SegmentArchived to entity AudienceContext.AudienceSegment
      }
      on event AudienceSegment.SegmentBuildFailed is {
        send event AudienceSegment.SegmentBuildFailed to outlet AudienceSegmentEventSplitToAudienceRepository
        send event AudienceSegment.SegmentBuildFailed to outlet AudienceSegmentEventSplitToAudienceMetrics
        tell event AudienceSegment.SegmentBuildFailed to entity AudienceContext.AudienceSegment
      }
      on other is {
        error "Unexpected message for processor AudienceSegmentEventSplit"
      }
    } with {
      briefly "AudienceSegment event fan-out handler"
      described as {
        |Delivers each AudienceSegment event to all of its consumers.
      }
    }
  } with {
    briefly "AudienceSegment event fan-out"
    described as {
      |Fans AudienceSegment events out to the repository and projectors.
    }
  }
  connector LinkAudienceSegmentToAudienceSegmentEventSplit is {
    from outlet AudienceContext.AudienceSegment.AudienceSegmentEvents2 to
      inlet AudienceContext.AudienceSegmentEventSplit.AudienceSegmentEventSplitIn
  } with {
    briefly "LinkAudienceSegmentToAudienceSegmentEventSplit"
  }
  connector LinkAudienceSegmentEventSplitToAudienceRepository is {
    from outlet AudienceContext.AudienceSegmentEventSplit.AudienceSegmentEventSplitToAudienceRepository to
      inlet AudienceContext.AudienceRepository.AudienceRepositoryFromAudienceSegment
  } with {
    briefly "LinkAudienceSegmentEventSplitToAudienceRepository"
  }
  connector LinkAudienceSegmentEventSplitToAudienceMetrics is {
    from outlet AudienceContext.AudienceSegmentEventSplit.AudienceSegmentEventSplitToAudienceMetrics to
      inlet AudienceContext.AudienceMetrics.AudienceMetricsFromAudienceSegment
  } with {
    briefly "LinkAudienceSegmentEventSplitToAudienceMetrics"
  }
  connector LinkAudienceMetricsToAudienceRepository is {
    from outlet AudienceContext.AudienceMetrics.AudienceMetricsOut to
      inlet AudienceContext.AudienceRepository.AudienceRepositoryFromAudienceMetrics
  } with {
    briefly "LinkAudienceMetricsToAudienceRepository"
  }
} with {
  briefly "Bounded context for audience management"
  described as {
    |Audience segmentation and activation context.
  }
}
