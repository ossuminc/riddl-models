// Audience Management Domain Model
// Audience segmentation, personas, behavioral targeting, and activation
domain AudienceManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MarketingAnalyst is "person defining audience segments" with {
    briefly "Marketing Analyst"
    described as {
      |Analyst creating and managing audience segments.
    }
  }
  user CampaignManager is "person activating audiences for campaigns" with {
    briefly "Campaign Manager"
    described as {
      |Manager selecting audiences for campaign targeting.
    }
  }
  user DataScientist is "person building lookalike models" with {
    briefly "Data Scientist"
    described as {
      |Scientist creating predictive audience models.
    }
  }
  epic AudienceSegmentation is {
    user MarketingAnalyst wants to "to define and manage audience segments" so that "campaigns can target the right customers"
    case CreateNewSegment is {
      user MarketingAnalyst wants to "to create a new audience segment" so that "a specific customer group can be targeted"
      step is "Analyst defines" "segment criteria" "from customer data" with {
        briefly "Define criteria"
        described as {
          |Set segmentation rules.
        }
      }
      step is "System evaluates" "matching audience members" "for segment" with {
        briefly "Evaluate members"
        described as {
          |Find matching customers.
        }
      }
    } with {
      briefly "Create new segment"
      described as {
        |Defining a new audience segment with criteria.
      }
    }
  } with {
    briefly "Audience segmentation"
    described as {
      |Epic for audience segment creation and management.
    }
  }
  include "AudienceContext.riddl"
  include "external-contexts.riddl"
  application context AudienceManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AudienceManagement are delivered.
      }
    }
    outlet AppAudienceSegmentCommands is type AudienceContext.AudienceSegment.AudienceSegmentCommand
    inlet AppAudienceRepositoryResponses is type AudienceContext.AudienceSegment.AudienceSegmentResult    handler AudienceManagementAppHandler is {
      on other is {
        error "Unexpected message for application context AudienceManagementApp"
      }
    } with {
      briefly "AudienceManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AudienceManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppAudienceSegmentCommands is from outlet AudienceManagementApp.AppAudienceSegmentCommands to inlet AudienceContext.AudienceSegment.AudienceSegmentCommands with {
    option persistent()
    briefly "LinkAppAudienceSegmentCommands"
  }
  connector LinkAppAudienceRepositoryResponses is from outlet AudienceContext.AudienceRepository.AudienceRepositoryResponses to inlet AudienceManagementApp.AppAudienceRepositoryResponses with {
    option persistent()
    briefly "LinkAppAudienceRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AudienceManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Audience management domain"
  described as {
    |Audience segmentation, personas, targeting, and activation.
  }
}
