// Marketing Analytics - Analytics Context
context AnalyticsContext as router is {
  inlet AnalyticsReportCommandStreamIn is type AnalyticsReportCommand  outlet AnalyticsReportCommandStreamOut is type AnalyticsReportCommand
  inlet AnalyticsReportResultStreamIn is result AnalyticsReport.AnalyticsReportResult  outlet AnalyticsReportResultStreamOut is result AnalyticsReport.AnalyticsReportResult
  handler AnalyticsContextBoundary is {
    on createReport: command AnalyticsReport.CreateReport is {
      send createReport to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on generateReport: command AnalyticsReport.GenerateReport is {
      send generateReport to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on addChannelMetrics: command AnalyticsReport.AddChannelMetrics is {
      send addChannelMetrics to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on addCampaignPerformance: command AnalyticsReport.AddCampaignPerformance is {
      send addCampaignPerformance to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on addAttributionResults: command AnalyticsReport.AddAttributionResults is {
      send addAttributionResults to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on completeReport: command AnalyticsReport.CompleteReport is {
      send completeReport to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on failReport: command AnalyticsReport.FailReport is {
      send failReport to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on archiveReport: command AnalyticsReport.ArchiveReport is {
      send archiveReport to outlet AnalyticsContext.AnalyticsReportCommandStreamOut
    }
    on analyticsReportResult: result AnalyticsReport.AnalyticsReportResult is {
      send analyticsReportResult to outlet AnalyticsContext.AnalyticsReportResultStreamOut
    }
    on other is {
      error "Unexpected message at the AnalyticsContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AnalyticsReportCommand Stream Intake' is from outlet AnalyticsContext.AnalyticsReportCommandStreamOut to inlet AnalyticsContext.AnalyticsReport.AnalyticsReportCommands  connector 'AnalyticsReportResult Stream Egress' is from outlet AnalyticsContext.AnalyticsRepository.AnalyticsRepositoryResponses to inlet AnalyticsContext.AnalyticsReportResultStreamIn  adaptor ToAdPlatform to context AdPlatform as merge is { 
    inlet ToAdPlatformIn is type AnalyticsReportEvent    inlet ToAdPlatformReplies is type AdPlatform.AdPlatformReply    outlet ToAdPlatformOut is type AdPlatform.AdPlatformRequest
    handler ToAdPlatformHandler is {
      on channelMetricsAdded: event AnalyticsReport.ChannelMetricsAdded is {
        let askAnswer: type AdPlatform.AudienceInsights = ask query AdPlatform.GetAudienceInsights of context AdPlatform
        do "channel metrics needing the audience behind them"
      }
      on campaignPerformanceAdded: event AnalyticsReport.CampaignPerformanceAdded is {
        let askAnswer: type AdPlatform.CampaignData = ask query AdPlatform.GetCampaignData of context AdPlatform
        do "campaign performance needing the platform's own spend and delivery"
      }
      on other is {
        error "Unexpected message for adaptor ToAdPlatform"
      }
    } with {
      briefly "to ad platform"
      described as {
        |Carries messages to the external AdPlatform.
      }
    }
  } with {
    briefly "AdPlatform integration"
    described as {
      |The model's side of the AdPlatform conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem as merge is { 
    inlet ToCRMSystemIn is type AnalyticsReportEvent    inlet ToCRMSystemReplies is type CRMSystem.CRMSystemReply    outlet ToCRMSystemOut is type CRMSystem.CRMSystemRequest
    handler ToCRMSystemHandler is {
      on attributionResultsAdded: event AnalyticsReport.AttributionResultsAdded is {
        let askAnswer: type CRMSystem.ConversionRecords = ask query CRMSystem.GetConversionData of context CRMSystem
        do "attribution needing the conversions it assigns credit for"
      }
      on reportCreated: event AnalyticsReport.ReportCreated is {
        let askAnswer: type CRMSystem.CustomerSegments = ask query CRMSystem.GetCustomerSegments of context CRMSystem
        do "a new report needing the segments it will break results down by"
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromDataWarehouse from context DataWarehouse is { 
    inlet FromDataWarehouseIn is event DataWarehouse.ExportCompleted    handler FromDataWarehouseHandler is {
      on exportCompleted: event DataWarehouse.ExportCompleted is {
        do "the warehouse has the export; completing the report was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDataWarehouse"
      }
    } with {
      briefly "from data warehouse"
      described as {
        |Carries messages from the external DataWarehouse.
      }
    }
  } with {
    briefly "DataWarehouse integration"
    described as {
      |The model's side of the DataWarehouse conversation.
    }
  }
  adaptor ToDataWarehouse to context DataWarehouse as flow is { 
    inlet ToDataWarehouseIn is type AnalyticsReportEvent    outlet ToDataWarehouseOut is command DataWarehouse.ExportReportData
    handler ToDataWarehouseHandler is {
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        let export: type DataWarehouse.ExportReportData = prompt("translate the reportCompleted event into an ExportReportData pushing the finished figures to the warehouse, completion being where they stop changing")
        send export to outlet AnalyticsContext.ToDataWarehouse.ToDataWarehouseOut
      }
      on other is {
        error "Unexpected message for adaptor ToDataWarehouse"
      }
    } with {
      briefly "to data warehouse"
      described as {
        |Carries messages to the external DataWarehouse.
      }
    }
  } with {
    briefly "DataWarehouse integration"
    described as {
      |The model's side of the DataWarehouse conversation.
    }
  }
  adaptor ToWebAnalytics to context WebAnalytics as merge is { 
    inlet ToWebAnalyticsIn is type AnalyticsReportEvent    inlet ToWebAnalyticsReplies is type WebAnalytics.WebAnalyticsReply    outlet ToWebAnalyticsOut is type WebAnalytics.WebAnalyticsRequest
    handler ToWebAnalyticsHandler is {
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        let askAnswer: type WebAnalytics.GoalCompletions = ask query WebAnalytics.GetGoalCompletions of context WebAnalytics
        do "a completed report needing goal completions to close the funnel"
      }
      on reportGenerationStarted: event AnalyticsReport.ReportGenerationStarted is {
        let askAnswer: type WebAnalytics.TrafficData = ask query WebAnalytics.GetTrafficData of context WebAnalytics
        do "a report starting needing the traffic it is built on"
      }
      on other is {
        error "Unexpected message for adaptor ToWebAnalytics"
      }
    } with {
      briefly "to web analytics"
      described as {
        |Carries messages to the external WebAnalytics.
      }
    }
  } with {
    briefly "WebAnalytics integration"
    described as {
      |The model's side of the WebAnalytics conversation.
    }
  }
  include "types.riddl"
  include "AnalyticsReport.riddl"
  type AnalyticsRepositoryCommand is one of {
    AnalyticsContext.AnalyticsRepository.PersistAttributionResultsAdded or AnalyticsContext.AnalyticsRepository.PersistCampaignPerformanceAdded or AnalyticsContext.AnalyticsRepository.PersistChannelMetricsAdded or AnalyticsContext.AnalyticsRepository.PersistReportArchived or AnalyticsContext.AnalyticsRepository.PersistReportCompleted or AnalyticsContext.AnalyticsRepository.PersistReportCreated or AnalyticsContext.AnalyticsRepository.PersistReportFailed or AnalyticsContext.AnalyticsRepository.PersistReportGenerationStarted
  } with {
    briefly "Anything that writes AnalyticsRepository"
    described as {
      |The persistence commands AnalyticsRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository AnalyticsRepository as flow is {
    inlet AnalyticsRepositoryFromPerformanceDashboard is type AnalyticsRepositoryCommand    command PersistAttributionResultsAdded is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row AttributionResultsAdded applies to.
        }
      }
    } with {
      briefly "Persist AttributionResultsAdded"
      described as {
        |Instructs this repository to apply AttributionResultsAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCampaignPerformanceAdded is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row CampaignPerformanceAdded applies to.
        }
      }
    } with {
      briefly "Persist CampaignPerformanceAdded"
      described as {
        |Instructs this repository to apply CampaignPerformanceAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistChannelMetricsAdded is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChannelMetricsAdded applies to.
        }
      }
    } with {
      briefly "Persist ChannelMetricsAdded"
      described as {
        |Instructs this repository to apply ChannelMetricsAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportArchived is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportArchived applies to.
        }
      }
    } with {
      briefly "Persist ReportArchived"
      described as {
        |Instructs this repository to apply ReportArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportCreated is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportCreated applies to.
        }
      }
    } with {
      briefly "Persist ReportCreated"
      described as {
        |Instructs this repository to apply ReportCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportFailed is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportFailed applies to.
        }
      }
    } with {
      briefly "Persist ReportFailed"
      described as {
        |Instructs this repository to apply ReportFailed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportGenerationStarted is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportGenerationStarted applies to.
        }
      }
    } with {
      briefly "Persist ReportGenerationStarted"
      described as {
        |Instructs this repository to apply ReportGenerationStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReportCompleted is {
      reportId: AnalyticsReportId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReportCompleted applies to.
        }
      }
    } with {
      briefly "Persist ReportCompleted"
      described as {
        |Instructs this repository to apply ReportCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet AnalyticsRepositoryResponses is result AnalyticsReport.AnalyticsReportResult
    record StoredAnalyticsReport is {
      analyticsReportId: AnalyticsReportId with {
        briefly "analyticsReportId"
        described as {
          |The analyticsReportId column of the stored analyticsReport row.
        }
      }
      reportId: AnalyticsReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored analyticsReport row.
        }
      }
      requestedBy: String(1,100) with {
        briefly "requestedBy"
        described as {
          |The requestedBy column of the stored analyticsReport row.
        }
      }
      status: ReportStatus with {
        briefly "status"
        described as {
          |The status column of the stored analyticsReport row.
        }
      }
    } with {
      briefly "Stored analyticsReport row"
      described as {
        |The persistence shape of analyticsReport data as this repository stores it.
      }
    }
    schema AnalyticsData is relational
      of reports as record StoredAnalyticsReport
        index on field StoredAnalyticsReport.reportId
        index on field StoredAnalyticsReport.status
        index on field StoredAnalyticsReport.requestedBy
 with {
      briefly "Analytics data schema"
      described as {
        |The relational schema holding analytics data for the AnalyticsRepository.
      }
    }
    handler AnalyticsPersistence is {
      on persistAttributionResultsAdded: command PersistAttributionResultsAdded is {
        do "apply AttributionResultsAdded to the stored row"
      }
      on persistCampaignPerformanceAdded: command PersistCampaignPerformanceAdded is {
        do "apply CampaignPerformanceAdded to the stored row"
      }
      on persistChannelMetricsAdded: command PersistChannelMetricsAdded is {
        do "apply ChannelMetricsAdded to the stored row"
      }
      on persistReportArchived: command PersistReportArchived is {
        do "apply ReportArchived to the stored row"
      }
      on persistReportCreated: command PersistReportCreated is {
        do "apply ReportCreated to the stored row"
      }
      on persistReportFailed: command PersistReportFailed is {
        do "apply ReportFailed to the stored row"
      }
      on persistReportGenerationStarted: command PersistReportGenerationStarted is {
        do "apply ReportGenerationStarted to the stored row"
      }
      on persistReportCompleted: command PersistReportCompleted is {
        do "apply ReportCompleted to the stored row"
      }
      on query GetDashboardMetrics is {
        let dashboardMetricsView: type DashboardMetricsView = prompt("read the dashboard metrics projection")
        reply dashboardMetricsView
      }
    } with {
      briefly "Persists analytics commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Analytics data persistence"
    described as {
      |Persistent storage for analytics.
    }
  }
  query GetDashboardMetrics replies result DashboardMetricsView is {
    dashboardMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which dashboard metrics to retrieve.
      }
    }
  } with {
    briefly "Get dashboard metrics"
    described as {
      |Retrieves the dashboard metrics projection.
    }
  }
  result DashboardMetricsView is {
    dashboardMetrics: PerformanceDashboard.DashboardMetrics with {
      briefly "Dashboard metrics"
      described as {
        |The dashboard metrics being returned.
      }
    }
  } with {
    briefly "Dashboard metrics view"
    described as {
      |Read model view carrying the dashboard metrics projection.
    }
  }
  projector PerformanceDashboard as flow is {
    updates repository AnalyticsContext.AnalyticsRepository
    outlet PerformanceDashboardToRepository is type AnalyticsRepositoryCommand
    inlet PerformanceDashboardFromAnalyticsReport is type AnalyticsReportEvent    record DashboardMetrics is {
      period: MetricPeriod with {
        briefly "Period"
        described as {
          |Dashboard period.
        }
      }
      aggregateTotalSpend: Decimal(15,2) with {
        briefly "Spend"
        described as {
          |Total spend.
        }
      }
      aggregateTotalRevenue: Decimal(15,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      overallROAS: Decimal(8,2) with {
        briefly "ROAS"
        described as {
          |Overall ROAS.
        }
      }
      topChannel: ChannelType with {
        briefly "Top channel"
        described as {
          |Best channel.
        }
      }
      activeCampaigns: Natural with {
        briefly "Active"
        described as {
          |Active campaigns.
        }
      }
    } with {
      briefly "Dashboard metrics"
      described as {
        |Executive dashboard metrics.
      }
    }
    handler DashboardHandler is {
      on attributionResultsAdded: event AnalyticsReport.AttributionResultsAdded is {
        tell command AnalyticsContext.AnalyticsRepository.PersistAttributionResultsAdded(reportId = attributionResultsAdded.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "apply AttributionResultsAdded to the PerformanceDashboard projection"
      }
      on campaignPerformanceAdded: event AnalyticsReport.CampaignPerformanceAdded is {
        tell command AnalyticsContext.AnalyticsRepository.PersistCampaignPerformanceAdded(reportId = campaignPerformanceAdded.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "apply CampaignPerformanceAdded to the PerformanceDashboard projection"
      }
      on channelMetricsAdded: event AnalyticsReport.ChannelMetricsAdded is {
        tell command AnalyticsContext.AnalyticsRepository.PersistChannelMetricsAdded(reportId = channelMetricsAdded.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "apply ChannelMetricsAdded to the PerformanceDashboard projection"
      }
      on reportArchived: event AnalyticsReport.ReportArchived is {
        tell command AnalyticsContext.AnalyticsRepository.PersistReportArchived(reportId = reportArchived.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "apply ReportArchived to the PerformanceDashboard projection"
      }
      on reportCreated: event AnalyticsReport.ReportCreated is {
        tell command AnalyticsContext.AnalyticsRepository.PersistReportCreated(reportId = reportCreated.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "apply ReportCreated to the PerformanceDashboard projection"
      }
      on reportFailed: event AnalyticsReport.ReportFailed is {
        tell command AnalyticsContext.AnalyticsRepository.PersistReportFailed(reportId = reportFailed.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "apply ReportFailed to the PerformanceDashboard projection"
      }
      on reportGenerationStarted: event AnalyticsReport.ReportGenerationStarted is {
        tell command AnalyticsContext.AnalyticsRepository.PersistReportGenerationStarted(reportId = reportGenerationStarted.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "apply ReportGenerationStarted to the PerformanceDashboard projection"
      }
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        tell command AnalyticsContext.AnalyticsRepository.PersistReportCompleted(reportId = reportCompleted.reportId) to repository AnalyticsContext.AnalyticsRepository
        do "Update dashboard with latest report data"
      }
    } with {
      briefly "Maintains dashboard"
      described as {
        |Projects reports into dashboard.
      }
    }
  } with {
    briefly "Performance dashboard"
    described as {
      |Marketing executive dashboard.
    }
  }
  // ---- Event publication for AnalyticsReport ----
  type AnalyticsReportEvent is one of {
    AnalyticsContext.AnalyticsReport.ReportCreated or AnalyticsContext.AnalyticsReport.ReportGenerationStarted or AnalyticsContext.AnalyticsReport.ChannelMetricsAdded or AnalyticsContext.AnalyticsReport.CampaignPerformanceAdded or AnalyticsContext.AnalyticsReport.AttributionResultsAdded or AnalyticsContext.AnalyticsReport.ReportCompleted or AnalyticsContext.AnalyticsReport.ReportFailed or AnalyticsContext.AnalyticsReport.ReportArchived
  } with {
    briefly "AnalyticsReport event alternation"
    described as {
      |Union of all AnalyticsReport events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet AnalyticsReportEventSplit as split is {
    outlet AnalyticsReportEventSplitToToWebAnalytics is type AnalyticsReportEvent
    outlet AnalyticsReportEventSplitToToDataWarehouse is type AnalyticsReportEvent
    outlet AnalyticsReportEventSplitToToCRMSystem is type AnalyticsReportEvent
    outlet AnalyticsReportEventSplitToToAdPlatform is type AnalyticsReportEvent
    inlet AnalyticsReportEventSplitIn is type AnalyticsReportEvent    outlet AnalyticsReportEventSplitToPerformanceDashboard is type AnalyticsReportEvent
    handler AnalyticsReportEventSplitHandler is {
      on reportCreated: event AnalyticsReport.ReportCreated is {
        send reportCreated to outlet AnalyticsReportEventSplitToPerformanceDashboard
        send reportCreated to outlet AnalyticsReportEventSplitToToCRMSystem
        tell reportCreated to entity AnalyticsContext.AnalyticsReport
      }
      on reportGenerationStarted: event AnalyticsReport.ReportGenerationStarted is {
        send reportGenerationStarted to outlet AnalyticsReportEventSplitToPerformanceDashboard
        send reportGenerationStarted to outlet AnalyticsReportEventSplitToToWebAnalytics
        tell reportGenerationStarted to entity AnalyticsContext.AnalyticsReport
      }
      on channelMetricsAdded: event AnalyticsReport.ChannelMetricsAdded is {
        send channelMetricsAdded to outlet AnalyticsReportEventSplitToPerformanceDashboard
        send channelMetricsAdded to outlet AnalyticsReportEventSplitToToAdPlatform
        tell channelMetricsAdded to entity AnalyticsContext.AnalyticsReport
      }
      on campaignPerformanceAdded: event AnalyticsReport.CampaignPerformanceAdded is {
        send campaignPerformanceAdded to outlet AnalyticsReportEventSplitToPerformanceDashboard
        send campaignPerformanceAdded to outlet AnalyticsReportEventSplitToToAdPlatform
        tell campaignPerformanceAdded to entity AnalyticsContext.AnalyticsReport
      }
      on attributionResultsAdded: event AnalyticsReport.AttributionResultsAdded is {
        send attributionResultsAdded to outlet AnalyticsReportEventSplitToPerformanceDashboard
        send attributionResultsAdded to outlet AnalyticsReportEventSplitToToCRMSystem
        tell attributionResultsAdded to entity AnalyticsContext.AnalyticsReport
      }
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        send reportCompleted to outlet AnalyticsReportEventSplitToPerformanceDashboard
        send reportCompleted to outlet AnalyticsReportEventSplitToToWebAnalytics
        send reportCompleted to outlet AnalyticsReportEventSplitToToDataWarehouse
        tell reportCompleted to entity AnalyticsContext.AnalyticsReport
      }
      on reportFailed: event AnalyticsReport.ReportFailed is {
        send reportFailed to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell reportFailed to entity AnalyticsContext.AnalyticsReport
      }
      on reportArchived: event AnalyticsReport.ReportArchived is {
        send reportArchived to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell reportArchived to entity AnalyticsContext.AnalyticsReport
      }
      on other is {
        error "Unexpected message for processor AnalyticsReportEventSplit"
      }
    } with {
      briefly "AnalyticsReport event fan-out handler"
      described as {
        |Delivers each AnalyticsReport event to all of its consumers.
      }
    }
  } with {
    briefly "AnalyticsReport event fan-out"
    described as {
      |Fans AnalyticsReport events out to the repository and projectors.
    }
  }
  connector 'ToWebAnalytics Feed' is from outlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitToToWebAnalytics to inlet AnalyticsContext.ToWebAnalytics.ToWebAnalyticsIn with {
    briefly "The AnalyticsReport events ToWebAnalytics translates, on their way to it"
  }
  connector 'ToDataWarehouse Feed' is from outlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitToToDataWarehouse to inlet AnalyticsContext.ToDataWarehouse.ToDataWarehouseIn with {
    briefly "The AnalyticsReport events ToDataWarehouse translates, on their way to it"
  }
  connector 'ToCRMSystem Feed' is from outlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitToToCRMSystem to inlet AnalyticsContext.ToCRMSystem.ToCRMSystemIn with {
    briefly "The AnalyticsReport events ToCRMSystem translates, on their way to it"
  }
  connector 'ToAdPlatform Feed' is from outlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitToToAdPlatform to inlet AnalyticsContext.ToAdPlatform.ToAdPlatformIn with {
    briefly "The AnalyticsReport events ToAdPlatform translates, on their way to it"
  }
  connector 'AnalyticsReportEvent Stream' is from outlet AnalyticsContext.AnalyticsReport.AnalyticsReportEvents2 to inlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitIn with {
    briefly "AnalyticsReport events, fanned out to storage and read models"
  }
  connector 'PerformanceDashboard Feed' is from outlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitToPerformanceDashboard to inlet AnalyticsContext.PerformanceDashboard.PerformanceDashboardFromAnalyticsReport with {
    briefly "AnalyticsReport events feeding the PerformanceDashboard projection"
  }
  connector 'PerformanceDashboard Storage' is from outlet AnalyticsContext.PerformanceDashboard.PerformanceDashboardToRepository to inlet AnalyticsContext.AnalyticsRepository.AnalyticsRepositoryFromPerformanceDashboard with {
    briefly "PerformanceDashboard updates on their way to storage"
  }
} with {
  briefly "Bounded context for marketing analytics"
  described as {
    |Marketing performance analysis context.
  }
}
