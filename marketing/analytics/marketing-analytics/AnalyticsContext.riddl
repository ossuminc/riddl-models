// Marketing Analytics - Analytics Context
context AnalyticsContext is {
  adaptor FromAdPlatform from context AdPlatform is { 
    handler FromAdPlatformHandler is {
      on result AdPlatform.AudienceInsights is {
        do "the model receives audience insights"
      }
      on result AdPlatform.CampaignData is {
        do "the model receives campaign data"
      }
      on other is {
        error "Unexpected message for adaptor FromAdPlatform"
      }
    } with {
      briefly "from ad platform"
      described as {
        |Carries messages from the external AdPlatform.
      }
    }
  } with {
    briefly "AdPlatform integration"
    described as {
      |The model's side of the AdPlatform conversation.
    }
  }
  adaptor ToAdPlatform to context AdPlatform is { 
    handler ToAdPlatformHandler is {
      on query AdPlatform.GetAudienceInsights is {
        do "the model sends get audience insights"
      }
      on query AdPlatform.GetCampaignData is {
        do "the model sends get campaign data"
      }
      on other is {
        error "Unexpected message for adaptor ToAdPlatform"
      }
    } with {
      briefly "to ad platform"
      described as {
        |Carries messages to the external AdPlatform.
      }
    }
  } with {
    briefly "AdPlatform integration"
    described as {
      |The model's side of the AdPlatform conversation.
    }
  }
  adaptor FromCRMSystem from context CRMSystem is { 
    handler FromCRMSystemHandler is {
      on result CRMSystem.ConversionRecords is {
        do "the model receives conversion records"
      }
      on result CRMSystem.CustomerSegments is {
        do "the model receives customer segments"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMSystem"
      }
    } with {
      briefly "from crm system"
      described as {
        |Carries messages from the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor ToCRMSystem to context CRMSystem is { 
    handler ToCRMSystemHandler is {
      on query CRMSystem.GetConversionData is {
        do "the model sends get conversion data"
      }
      on query CRMSystem.GetCustomerSegments is {
        do "the model sends get customer segments"
      }
      on other is {
        error "Unexpected message for adaptor ToCRMSystem"
      }
    } with {
      briefly "to crm system"
      described as {
        |Carries messages to the external CRMSystem.
      }
    }
  } with {
    briefly "CRMSystem integration"
    described as {
      |The model's side of the CRMSystem conversation.
    }
  }
  adaptor FromDataWarehouse from context DataWarehouse is { 
    handler FromDataWarehouseHandler is {
      on event DataWarehouse.ExportCompleted is {
        do "the model receives export completed"
      }
      on other is {
        error "Unexpected message for adaptor FromDataWarehouse"
      }
    } with {
      briefly "from data warehouse"
      described as {
        |Carries messages from the external DataWarehouse.
      }
    }
  } with {
    briefly "DataWarehouse integration"
    described as {
      |The model's side of the DataWarehouse conversation.
    }
  }
  adaptor ToDataWarehouse to context DataWarehouse is { 
    handler ToDataWarehouseHandler is {
      on command DataWarehouse.ExportReportData is {
        do "the model sends export report data"
      }
      on other is {
        error "Unexpected message for adaptor ToDataWarehouse"
      }
    } with {
      briefly "to data warehouse"
      described as {
        |Carries messages to the external DataWarehouse.
      }
    }
  } with {
    briefly "DataWarehouse integration"
    described as {
      |The model's side of the DataWarehouse conversation.
    }
  }
  adaptor FromWebAnalytics from context WebAnalytics is { 
    handler FromWebAnalyticsHandler is {
      on result WebAnalytics.GoalCompletions is {
        do "the model receives goal completions"
      }
      on result WebAnalytics.TrafficData is {
        do "the model receives traffic data"
      }
      on other is {
        error "Unexpected message for adaptor FromWebAnalytics"
      }
    } with {
      briefly "from web analytics"
      described as {
        |Carries messages from the external WebAnalytics.
      }
    }
  } with {
    briefly "WebAnalytics integration"
    described as {
      |The model's side of the WebAnalytics conversation.
    }
  }
  adaptor ToWebAnalytics to context WebAnalytics is { 
    handler ToWebAnalyticsHandler is {
      on query WebAnalytics.GetGoalCompletions is {
        do "the model sends get goal completions"
      }
      on query WebAnalytics.GetTrafficData is {
        do "the model sends get traffic data"
      }
      on other is {
        error "Unexpected message for adaptor ToWebAnalytics"
      }
    } with {
      briefly "to web analytics"
      described as {
        |Carries messages to the external WebAnalytics.
      }
    }
  } with {
    briefly "WebAnalytics integration"
    described as {
      |The model's side of the WebAnalytics conversation.
    }
  }
  include "types.riddl"
  include "AnalyticsReport.riddl"
  repository AnalyticsRepository as merge is {
    inlet AnalyticsRepositoryFromAnalyticsReport is type AnalyticsReportEvent    inlet AnalyticsRepositoryFromPerformanceDashboard is type AnalyticsReportEvent    outlet AnalyticsRepositoryResponses is type AnalyticsReport.AnalyticsReportResult
    record StoredAnalyticsReport is  {
      analyticsReportId: AnalyticsReportId with {
        briefly "analyticsReportId"
        described as {
          |The analyticsReportId column of the stored analyticsReport row.
        }
      }
      reportId: AnalyticsReportId with {
        briefly "reportId"
        described as {
          |The reportId column of the stored analyticsReport row.
        }
      }
      requestedBy: String(1,100) with {
        briefly "requestedBy"
        described as {
          |The requestedBy column of the stored analyticsReport row.
        }
      }
      status: ReportStatus with {
        briefly "status"
        described as {
          |The status column of the stored analyticsReport row.
        }
      }
    } with {
      briefly "Stored analyticsReport row"
      described as {
        |The persistence shape of analyticsReport data as this repository stores it.
      }
    }
    schema AnalyticsData is relational
      of reports as type StoredAnalyticsReport
        index on field StoredAnalyticsReport.reportId
        index on field StoredAnalyticsReport.status
        index on field StoredAnalyticsReport.requestedBy
 with {
      briefly "Analytics data schema"
      described as {
        |The relational schema holding analytics data for the AnalyticsRepository.
      }
    }
    handler AnalyticsPersistence is {
      on query GetDashboardMetrics is {
        do "read the dashboard metrics projection"
        reply result DashboardMetricsView
      }
      on createReport: command AnalyticsReport.CreateReport is {
        tell event AnalyticsReport.ReportCreated(reportId = createReport.reportId, reportName = createReport.reportName, parameters = createReport.parameters) to entity AnalyticsContext.AnalyticsReport
        do "Store new report record"
      }
      on addChannelMetrics: command AnalyticsReport.AddChannelMetrics is {
        tell event AnalyticsReport.ChannelMetricsAdded(reportId = addChannelMetrics.reportId) to entity AnalyticsContext.AnalyticsReport
        do "Store channel metrics"
      }
      on addCampaignPerformance: command AnalyticsReport.AddCampaignPerformance is {
        tell event AnalyticsReport.CampaignPerformanceAdded(reportId = addCampaignPerformance.reportId) to entity AnalyticsContext.AnalyticsReport
        do "Store campaign performance"
      }
      on addAttributionResults: command AnalyticsReport.AddAttributionResults is {
        tell event AnalyticsReport.AttributionResultsAdded(reportId = addAttributionResults.reportId) to entity AnalyticsContext.AnalyticsReport
        do "Store attribution results"
      }
      on completeReport: command AnalyticsReport.CompleteReport is {
        tell event AnalyticsReport.ReportCompleted(reportId = completeReport.reportId, summary = completeReport.summary, completedAt = completeReport.completedAt) to entity AnalyticsContext.AnalyticsReport
        do "Update report to ready status"
      }
      on command AnalyticsReport.ArchiveReport is {
        do "Move report to archive storage"
      }
    } with {
      briefly "Persists analytics commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Analytics data persistence"
    described as {
      |Persistent storage for analytics.
    }
  }
  query GetDashboardMetrics is  {
    dashboardMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which dashboard metrics to retrieve.
      }
    }
  } with {
    briefly "Get dashboard metrics"
    described as {
      |Retrieves the dashboard metrics projection.
    }
  }
  result DashboardMetricsView is  {
    dashboardMetrics: PerformanceDashboard.DashboardMetrics with {
      briefly "Dashboard metrics"
      described as {
        |The dashboard metrics being returned.
      }
    }
  } with {
    briefly "Dashboard metrics view"
    described as {
      |Read model view carrying the dashboard metrics projection.
    }
  }
  projector PerformanceDashboard as flow is {
    updates repository AnalyticsContext.AnalyticsRepository
    inlet PerformanceDashboardFromAnalyticsReport is type AnalyticsReportEvent    outlet PerformanceDashboardOut is type AnalyticsReportEvent
    record DashboardMetrics is  {
      period: MetricPeriod with {
        briefly "Period"
        described as {
          |Dashboard period.
        }
      }
      aggregateTotalSpend: Decimal(15,2) with {
        briefly "Spend"
        described as {
          |Total spend.
        }
      }
      aggregateTotalRevenue: Decimal(15,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      overallROAS: Decimal(8,2) with {
        briefly "ROAS"
        described as {
          |Overall ROAS.
        }
      }
      topChannel: ChannelType with {
        briefly "Top channel"
        described as {
          |Best channel.
        }
      }
      activeCampaigns: Natural with {
        briefly "Active"
        described as {
          |Active campaigns.
        }
      }
    } with {
      briefly "Dashboard metrics"
      described as {
        |Executive dashboard metrics.
      }
    }
    handler DashboardHandler is {
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        tell reportCompleted to repository AnalyticsContext.AnalyticsRepository
        do "Update dashboard with latest report data"
      }
    } with {
      briefly "Maintains dashboard"
      described as {
        |Projects reports into dashboard.
      }
    }
  } with {
    briefly "Performance dashboard"
    described as {
      |Marketing executive dashboard.
    }
  }
  // ---- Event publication for AnalyticsReport ----
  type AnalyticsReportEvent is one of {
    AnalyticsContext.AnalyticsReport.ReportCreated or AnalyticsContext.AnalyticsReport.ReportGenerationStarted or AnalyticsContext.AnalyticsReport.ChannelMetricsAdded or AnalyticsContext.AnalyticsReport.CampaignPerformanceAdded or AnalyticsContext.AnalyticsReport.AttributionResultsAdded or AnalyticsContext.AnalyticsReport.ReportCompleted or AnalyticsContext.AnalyticsReport.ReportFailed or AnalyticsContext.AnalyticsReport.ReportArchived
  } with {
    briefly "AnalyticsReport event alternation"
    described as {
      |Union of all AnalyticsReport events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AnalyticsReportEventSource as source is {
    outlet AnalyticsReportEvents is type AnalyticsReportEvent
    handler AnalyticsReportSourceHandler is {
      on reportCreated: event AnalyticsReport.ReportCreated is {
        send reportCreated to outlet AnalyticsReportEvents
      }
      on reportGenerationStarted: event AnalyticsReport.ReportGenerationStarted is {
        send reportGenerationStarted to outlet AnalyticsReportEvents
      }
      on channelMetricsAdded: event AnalyticsReport.ChannelMetricsAdded is {
        send channelMetricsAdded to outlet AnalyticsReportEvents
      }
      on campaignPerformanceAdded: event AnalyticsReport.CampaignPerformanceAdded is {
        send campaignPerformanceAdded to outlet AnalyticsReportEvents
      }
      on attributionResultsAdded: event AnalyticsReport.AttributionResultsAdded is {
        send attributionResultsAdded to outlet AnalyticsReportEvents
      }
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        send reportCompleted to outlet AnalyticsReportEvents
      }
      on reportFailed: event AnalyticsReport.ReportFailed is {
        send reportFailed to outlet AnalyticsReportEvents
      }
      on reportArchived: event AnalyticsReport.ReportArchived is {
        send reportArchived to outlet AnalyticsReportEvents
      }
      on other is {
        error "Unexpected message for source AnalyticsReportEventSource"
      }
    } with {
      briefly "AnalyticsReport source handler"
      described as {
        |Publishes AnalyticsReport events onto the outlet.
      }
    }
  } with {
    briefly "AnalyticsReport event source"
    described as {
      |Publishes AnalyticsReport entity events into the streaming topology.
    }
  }
  processor AnalyticsReportEventSink as sink is {
    inlet AnalyticsReportInlet is type AnalyticsReportEvent    handler AnalyticsReportSinkHandler is {
      on reportCreated: event AnalyticsReport.ReportCreated is {
        tell reportCreated to repository AnalyticsContext.AnalyticsRepository
      }
      on reportGenerationStarted: event AnalyticsReport.ReportGenerationStarted is {
        tell reportGenerationStarted to repository AnalyticsContext.AnalyticsRepository
      }
      on channelMetricsAdded: event AnalyticsReport.ChannelMetricsAdded is {
        tell channelMetricsAdded to repository AnalyticsContext.AnalyticsRepository
      }
      on campaignPerformanceAdded: event AnalyticsReport.CampaignPerformanceAdded is {
        tell campaignPerformanceAdded to repository AnalyticsContext.AnalyticsRepository
      }
      on attributionResultsAdded: event AnalyticsReport.AttributionResultsAdded is {
        tell attributionResultsAdded to repository AnalyticsContext.AnalyticsRepository
      }
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        tell reportCompleted to repository AnalyticsContext.AnalyticsRepository
      }
      on reportFailed: event AnalyticsReport.ReportFailed is {
        tell reportFailed to repository AnalyticsContext.AnalyticsRepository
      }
      on reportArchived: event AnalyticsReport.ReportArchived is {
        tell reportArchived to repository AnalyticsContext.AnalyticsRepository
      }
      on other is {
        error "Unexpected message for sink AnalyticsReportEventSink"
      }
    } with {
      briefly "AnalyticsReport sink handler"
      described as {
        |Persists AnalyticsReport events via the repository.
      }
    }
  } with {
    briefly "AnalyticsReport event sink"
    described as {
      |Receives AnalyticsReport events for persistence.
    }
  }
  connector AnalyticsReportEventFlow is from outlet AnalyticsContext.AnalyticsReportEventSource.AnalyticsReportEvents to inlet AnalyticsContext.AnalyticsReportEventSink.AnalyticsReportInlet with {
    briefly "AnalyticsReport event flow"
    described as {
      |Connects the AnalyticsReport source to its sink.
    }
  }
  processor AnalyticsReportEventSplit as split is {
    inlet AnalyticsReportEventSplitIn is type AnalyticsReportEvent    outlet AnalyticsReportEventSplitToAnalyticsRepository is type AnalyticsReportEvent
    outlet AnalyticsReportEventSplitToPerformanceDashboard is type AnalyticsReportEvent
    handler AnalyticsReportEventSplitHandler is {
      on reportCreated: event AnalyticsReport.ReportCreated is {
        send reportCreated to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send reportCreated to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell reportCreated to entity AnalyticsContext.AnalyticsReport
      }
      on reportGenerationStarted: event AnalyticsReport.ReportGenerationStarted is {
        send reportGenerationStarted to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send reportGenerationStarted to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell reportGenerationStarted to entity AnalyticsContext.AnalyticsReport
      }
      on channelMetricsAdded: event AnalyticsReport.ChannelMetricsAdded is {
        send channelMetricsAdded to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send channelMetricsAdded to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell channelMetricsAdded to entity AnalyticsContext.AnalyticsReport
      }
      on campaignPerformanceAdded: event AnalyticsReport.CampaignPerformanceAdded is {
        send campaignPerformanceAdded to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send campaignPerformanceAdded to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell campaignPerformanceAdded to entity AnalyticsContext.AnalyticsReport
      }
      on attributionResultsAdded: event AnalyticsReport.AttributionResultsAdded is {
        send attributionResultsAdded to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send attributionResultsAdded to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell attributionResultsAdded to entity AnalyticsContext.AnalyticsReport
      }
      on reportCompleted: event AnalyticsReport.ReportCompleted is {
        send reportCompleted to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send reportCompleted to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell reportCompleted to entity AnalyticsContext.AnalyticsReport
      }
      on reportFailed: event AnalyticsReport.ReportFailed is {
        send reportFailed to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send reportFailed to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell reportFailed to entity AnalyticsContext.AnalyticsReport
      }
      on reportArchived: event AnalyticsReport.ReportArchived is {
        send reportArchived to outlet AnalyticsReportEventSplitToAnalyticsRepository
        send reportArchived to outlet AnalyticsReportEventSplitToPerformanceDashboard
        tell reportArchived to entity AnalyticsContext.AnalyticsReport
      }
      on other is {
        error "Unexpected message for processor AnalyticsReportEventSplit"
      }
    } with {
      briefly "AnalyticsReport event fan-out handler"
      described as {
        |Delivers each AnalyticsReport event to all of its consumers.
      }
    }
  } with {
    briefly "AnalyticsReport event fan-out"
    described as {
      |Fans AnalyticsReport events out to the repository and projectors.
    }
  }
  connector 'AnalyticsReportEvent Stream' is from outlet AnalyticsContext.AnalyticsReport.AnalyticsReportEvents2 to inlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitIn with {
    briefly "AnalyticsReport events, fanned out to storage and read models"
  }
  connector 'AnalyticsReportEvent Storage' is from outlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitToAnalyticsRepository to inlet AnalyticsContext.AnalyticsRepository.AnalyticsRepositoryFromAnalyticsReport with {
    briefly "AnalyticsReport events on their way to storage"
  }
  connector 'PerformanceDashboard Feed' is from outlet AnalyticsContext.AnalyticsReportEventSplit.AnalyticsReportEventSplitToPerformanceDashboard to inlet AnalyticsContext.PerformanceDashboard.PerformanceDashboardFromAnalyticsReport with {
    briefly "AnalyticsReport events feeding the PerformanceDashboard projection"
  }
  connector 'PerformanceDashboard Storage' is from outlet AnalyticsContext.PerformanceDashboard.PerformanceDashboardOut to inlet AnalyticsContext.AnalyticsRepository.AnalyticsRepositoryFromPerformanceDashboard with {
    briefly "The PerformanceDashboard projection on its way to storage"
  }
} with {
  briefly "Bounded context for marketing analytics"
  described as {
    |Marketing performance analysis context.
  }
}
