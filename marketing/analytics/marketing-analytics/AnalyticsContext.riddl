// Marketing Analytics - Analytics Context
context AnalyticsContext is {
  include "types.riddl"
  include "AnalyticsReport.riddl"
  repository AnalyticsRepository is {
    schema AnalyticsData is relational
      of reports as type AnalyticsReport
        index on field AnalyticsReport.reportId
        index on field AnalyticsReport.status
        index on field AnalyticsReport.requestedBy

    handler AnalyticsPersistence is {
      on command AnalyticsReport.CreateReport is {
        tell event AnalyticsReport.ReportCreated to entity AnalyticsContext.AnalyticsReport
        prompt "Store new report record"
      }
      on command AnalyticsReport.AddChannelMetrics is {
        tell event AnalyticsReport.ChannelMetricsAdded to entity AnalyticsContext.AnalyticsReport
        prompt "Store channel metrics"
      }
      on command AnalyticsReport.AddCampaignPerformance is {
        tell event AnalyticsReport.CampaignPerformanceAdded to entity AnalyticsContext.AnalyticsReport
        prompt "Store campaign performance"
      }
      on command AnalyticsReport.AddAttributionResults is {
        tell event AnalyticsReport.AttributionResultsAdded to entity AnalyticsContext.AnalyticsReport
        prompt "Store attribution results"
      }
      on command AnalyticsReport.CompleteReport is {
        tell event AnalyticsReport.ReportCompleted to entity AnalyticsContext.AnalyticsReport
        prompt "Update report to ready status"
      }
      on command AnalyticsReport.ArchiveReport is {
        prompt "Move report to archive storage"
      }
    } with {
      briefly "Persists analytics commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Analytics data persistence"
    described as {
      |Persistent storage for analytics.
    }
  }
  projector PerformanceDashboard is {
    updates repository AnalyticsContext.AnalyticsRepository
    record DashboardMetrics is  {
      period: MetricPeriod with {
        briefly "Period"
        described as {
          |Dashboard period.
        }
      }
      aggregateTotalSpend: Decimal(15,2) with {
        briefly "Spend"
        described as {
          |Total spend.
        }
      }
      aggregateTotalRevenue: Decimal(15,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      overallROAS: Decimal(8,2) with {
        briefly "ROAS"
        described as {
          |Overall ROAS.
        }
      }
      topChannel: ChannelType with {
        briefly "Top channel"
        described as {
          |Best channel.
        }
      }
      activeCampaigns: Natural with {
        briefly "Active"
        described as {
          |Active campaigns.
        }
      }
    } with {
      briefly "Dashboard metrics"
      described as {
        |Executive dashboard metrics.
      }
    }
    handler DashboardHandler is {
      on event AnalyticsReport.ReportCompleted is {
        tell event AnalyticsReport.ReportCompleted to repository AnalyticsContext.AnalyticsRepository
        prompt "Update dashboard with latest report data"
      }
    } with {
      briefly "Maintains dashboard"
      described as {
        |Projects reports into dashboard.
      }
    }
  } with {
    briefly "Performance dashboard"
    described as {
      |Marketing executive dashboard.
    }
  }
  // ---- Event publication for AnalyticsReport ----
  type AnalyticsReportEvent is one of {
    AnalyticsContext.AnalyticsReport.ReportCreated,
    AnalyticsContext.AnalyticsReport.ReportGenerationStarted,
    AnalyticsContext.AnalyticsReport.ChannelMetricsAdded,
    AnalyticsContext.AnalyticsReport.CampaignPerformanceAdded,
    AnalyticsContext.AnalyticsReport.AttributionResultsAdded,
    AnalyticsContext.AnalyticsReport.ReportCompleted,
    AnalyticsContext.AnalyticsReport.ReportFailed,
    AnalyticsContext.AnalyticsReport.ReportArchived
  } with {
    briefly "AnalyticsReport event alternation"
    described as {
      |Union of all AnalyticsReport events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AnalyticsReportEventSource as source is {
    outlet AnalyticsReportEvents is type AnalyticsReportEvent
    handler AnalyticsReportSourceHandler is {
      on event AnalyticsReport.ReportCreated is {
        send event AnalyticsReport.ReportCreated to outlet AnalyticsReportEvents
      }
      on event AnalyticsReport.ReportGenerationStarted is {
        send event AnalyticsReport.ReportGenerationStarted to outlet AnalyticsReportEvents
      }
      on event AnalyticsReport.ChannelMetricsAdded is {
        send event AnalyticsReport.ChannelMetricsAdded to outlet AnalyticsReportEvents
      }
      on event AnalyticsReport.CampaignPerformanceAdded is {
        send event AnalyticsReport.CampaignPerformanceAdded to outlet AnalyticsReportEvents
      }
      on event AnalyticsReport.AttributionResultsAdded is {
        send event AnalyticsReport.AttributionResultsAdded to outlet AnalyticsReportEvents
      }
      on event AnalyticsReport.ReportCompleted is {
        send event AnalyticsReport.ReportCompleted to outlet AnalyticsReportEvents
      }
      on event AnalyticsReport.ReportFailed is {
        send event AnalyticsReport.ReportFailed to outlet AnalyticsReportEvents
      }
      on event AnalyticsReport.ReportArchived is {
        send event AnalyticsReport.ReportArchived to outlet AnalyticsReportEvents
      }
      on other is {
        error "Unexpected message for source AnalyticsReportEventSource"
      }
    } with {
      briefly "AnalyticsReport source handler"
      described as {
        |Publishes AnalyticsReport events onto the outlet.
      }
    }
  } with {
    briefly "AnalyticsReport event source"
    described as {
      |Publishes AnalyticsReport entity events into the streaming topology.
    }
  }
  processor AnalyticsReportEventSink as sink is {
    inlet AnalyticsReportInlet is type AnalyticsReportEvent
    handler AnalyticsReportSinkHandler is {
      on event AnalyticsReport.ReportCreated is {
        tell event AnalyticsReport.ReportCreated to repository AnalyticsContext.AnalyticsRepository
      }
      on event AnalyticsReport.ReportGenerationStarted is {
        tell event AnalyticsReport.ReportGenerationStarted to repository AnalyticsContext.AnalyticsRepository
      }
      on event AnalyticsReport.ChannelMetricsAdded is {
        tell event AnalyticsReport.ChannelMetricsAdded to repository AnalyticsContext.AnalyticsRepository
      }
      on event AnalyticsReport.CampaignPerformanceAdded is {
        tell event AnalyticsReport.CampaignPerformanceAdded to repository AnalyticsContext.AnalyticsRepository
      }
      on event AnalyticsReport.AttributionResultsAdded is {
        tell event AnalyticsReport.AttributionResultsAdded to repository AnalyticsContext.AnalyticsRepository
      }
      on event AnalyticsReport.ReportCompleted is {
        tell event AnalyticsReport.ReportCompleted to repository AnalyticsContext.AnalyticsRepository
      }
      on event AnalyticsReport.ReportFailed is {
        tell event AnalyticsReport.ReportFailed to repository AnalyticsContext.AnalyticsRepository
      }
      on event AnalyticsReport.ReportArchived is {
        tell event AnalyticsReport.ReportArchived to repository AnalyticsContext.AnalyticsRepository
      }
      on other is {
        error "Unexpected message for sink AnalyticsReportEventSink"
      }
    } with {
      briefly "AnalyticsReport sink handler"
      described as {
        |Persists AnalyticsReport events via the repository.
      }
    }
  } with {
    briefly "AnalyticsReport event sink"
    described as {
      |Receives AnalyticsReport events for persistence.
    }
  }
  connector AnalyticsReportEventFlow is {
    from outlet AnalyticsContext.AnalyticsReportEventSource.AnalyticsReportEvents to
      inlet AnalyticsContext.AnalyticsReportEventSink.AnalyticsReportInlet
  } with {
    briefly "AnalyticsReport event flow"
    described as {
      |Connects the AnalyticsReport source to its sink.
    }
  }
} with {
  briefly "Bounded context for marketing analytics"
  described as {
    |Marketing performance analysis context.
  }
}
