// Marketing Analytics Domain Model
// Marketing performance and attribution analysis
domain MarketingAnalytics is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MarketingAnalyst is "person analyzing campaign performance" with {
    briefly "Marketing Analyst"
    described as {
      |Analyst reviewing marketing metrics.
    }
  }
  user MarketingManager is "person overseeing marketing strategy" with {
    briefly "Marketing Manager"
    described as {
      |Manager directing marketing efforts.
    }
  }
  user DataScientist is "person building attribution models" with {
    briefly "Data Scientist"
    described as {
      |Scientist developing predictive models.
    }
  }
  epic MarketingPerformanceAnalysis is {
    user MarketingAnalyst wants to "to analyze marketing performance" so that "ROI can be maximized"
    case AnalyzeCampaignROI is {
      user MarketingAnalyst wants to "to measure campaign effectiveness" so that "budget allocation can be optimized"
      step is "Analyst defines" "attribution model" "for campaigns" with {
        briefly "Define model"
        described as {
          |Set attribution.
        }
      }
      step is "System calculates" "ROI metrics" "by channel" with {
        briefly "Calculate ROI"
        described as {
          |Compute returns.
        }
      }
    } with {
      briefly "Analyze campaign ROI"
      described as {
        |Measuring marketing returns.
      }
    }
  } with {
    briefly "Marketing performance analysis"
    described as {
      |Epic for marketing analytics.
    }
  }
  include "AnalyticsContext.riddl"
  include "external-contexts.riddl"
  application context MarketingAnalyticsApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MarketingAnalytics are delivered.
      }
    }
    outlet AppAnalyticsReportCommands is type AnalyticsContext.AnalyticsReport.AnalyticsReportCommand
    inlet AppAnalyticsRepositoryResponses is type AnalyticsContext.AnalyticsReport.AnalyticsReportResult    handler MarketingAnalyticsAppHandler is {
      on other is {
        error "Unexpected message for application context MarketingAnalyticsApp"
      }
    } with {
      briefly "MarketingAnalyticsApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MarketingAnalyticsApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AnalyticsReportCommand Stream' is from outlet MarketingAnalyticsApp.AppAnalyticsReportCommands to inlet AnalyticsContext.AnalyticsReport.AnalyticsReportCommands with {
    briefly "AnalyticsReport commands from the application"
  }
  persistent connector 'AnalyticsReportResult Stream' is from outlet AnalyticsContext.AnalyticsRepository.AnalyticsRepositoryResponses to inlet MarketingAnalyticsApp.AppAnalyticsRepositoryResponses with {
    briefly "Analytics query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MarketingAnalyticsApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Marketing analytics domain"
  described as {
    |Marketing performance analysis and attribution.
  }
}
