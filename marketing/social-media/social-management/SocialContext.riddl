// Social Media Management - Social Context
context SocialContext is {
  adaptor FromMediaStorage from context MediaStorage is { 
    handler FromMediaStorageHandler is {
      on event MediaStorage.MediaUploaded is {
        do "the model receives media uploaded"
      }
      on event MediaStorage.ThumbnailGenerated is {
        do "the model receives thumbnail generated"
      }
      on other is {
        error "Unexpected message for adaptor FromMediaStorage"
      }
    } with {
      briefly "from media storage"
      described as {
        |Carries messages from the external MediaStorage.
      }
    }
  } with {
    briefly "MediaStorage integration"
    described as {
      |The model's side of the MediaStorage conversation.
    }
  }
  adaptor ToMediaStorage to context MediaStorage is { 
    handler ToMediaStorageHandler is {
      on command MediaStorage.GenerateThumbnail is {
        do "the model sends generate thumbnail"
      }
      on command MediaStorage.UploadMedia is {
        do "the model sends upload media"
      }
      on other is {
        error "Unexpected message for adaptor ToMediaStorage"
      }
    } with {
      briefly "to media storage"
      described as {
        |Carries messages to the external MediaStorage.
      }
    }
  } with {
    briefly "MediaStorage integration"
    described as {
      |The model's side of the MediaStorage conversation.
    }
  }
  adaptor FromOptimalTimeService from context OptimalTimeService is { 
    handler FromOptimalTimeServiceHandler is {
      on event OptimalTimeService.OptimalTimeCalculated is {
        do "the model receives optimal time calculated"
      }
      on other is {
        error "Unexpected message for adaptor FromOptimalTimeService"
      }
    } with {
      briefly "from optimal time service"
      described as {
        |Carries messages from the external OptimalTimeService.
      }
    }
  } with {
    briefly "OptimalTimeService integration"
    described as {
      |The model's side of the OptimalTimeService conversation.
    }
  }
  adaptor ToOptimalTimeService to context OptimalTimeService is { 
    handler ToOptimalTimeServiceHandler is {
      on command OptimalTimeService.GetOptimalPostTime is {
        do "the model sends get optimal post time"
      }
      on other is {
        error "Unexpected message for adaptor ToOptimalTimeService"
      }
    } with {
      briefly "to optimal time service"
      described as {
        |Carries messages to the external OptimalTimeService.
      }
    }
  } with {
    briefly "OptimalTimeService integration"
    described as {
      |The model's side of the OptimalTimeService conversation.
    }
  }
  adaptor FromPlatformAPI from context PlatformAPI is { 
    handler FromPlatformAPIHandler is {
      on event PlatformAPI.CommentsFetched is {
        do "the model receives comments fetched"
      }
      on event PlatformAPI.EngagementFetched is {
        do "the model receives engagement fetched"
      }
      on event PlatformAPI.PlatformPublishFailed is {
        do "the model receives platform publish failed"
      }
      on event PlatformAPI.PlatformPublished is {
        do "the model receives platform published"
      }
      on event PlatformAPI.ReplyPosted is {
        do "the model receives reply posted"
      }
      on other is {
        error "Unexpected message for adaptor FromPlatformAPI"
      }
    } with {
      briefly "from platform api"
      described as {
        |Carries messages from the external PlatformAPI.
      }
    }
  } with {
    briefly "PlatformAPI integration"
    described as {
      |The model's side of the PlatformAPI conversation.
    }
  }
  adaptor ToPlatformAPI to context PlatformAPI is { 
    handler ToPlatformAPIHandler is {
      on command PlatformAPI.FetchComments is {
        do "the model sends fetch comments"
      }
      on command PlatformAPI.FetchEngagement is {
        do "the model sends fetch engagement"
      }
      on command PlatformAPI.PostReply is {
        do "the model sends post reply"
      }
      on command PlatformAPI.PublishToPlatform is {
        do "the model sends publish to platform"
      }
      on other is {
        error "Unexpected message for adaptor ToPlatformAPI"
      }
    } with {
      briefly "to platform api"
      described as {
        |Carries messages to the external PlatformAPI.
      }
    }
  } with {
    briefly "PlatformAPI integration"
    described as {
      |The model's side of the PlatformAPI conversation.
    }
  }
  adaptor FromSentimentAnalysis from context SentimentAnalysis is { 
    handler FromSentimentAnalysisHandler is {
      on event SentimentAnalysis.SentimentAnalyzed is {
        do "the model receives sentiment analyzed"
      }
      on other is {
        error "Unexpected message for adaptor FromSentimentAnalysis"
      }
    } with {
      briefly "from sentiment analysis"
      described as {
        |Carries messages from the external SentimentAnalysis.
      }
    }
  } with {
    briefly "SentimentAnalysis integration"
    described as {
      |The model's side of the SentimentAnalysis conversation.
    }
  }
  adaptor ToSentimentAnalysis to context SentimentAnalysis is { 
    handler ToSentimentAnalysisHandler is {
      on command SentimentAnalysis.AnalyzeComment is {
        do "the model sends analyze comment"
      }
      on other is {
        error "Unexpected message for adaptor ToSentimentAnalysis"
      }
    } with {
      briefly "to sentiment analysis"
      described as {
        |Carries messages to the external SentimentAnalysis.
      }
    }
  } with {
    briefly "SentimentAnalysis integration"
    described as {
      |The model's side of the SentimentAnalysis conversation.
    }
  }
  include "types.riddl"
  include "SocialPost.riddl"
  repository SocialRepository as merge is {
    inlet SocialRepositoryFromSocialPost is type SocialPostEvent    inlet SocialRepositoryFromSocialAnalytics is type SocialPostEvent    outlet SocialRepositoryResponses is type SocialPost.SocialPostResult
    record StoredSocialPost is  {
      socialPostId: UUID with {
        briefly "socialPostId"
        described as {
          |The socialPostId column of the stored socialPost row.
        }
      }
      contentType: ContentType with {
        briefly "contentType"
        described as {
          |The contentType column of the stored socialPost row.
        }
      }
      schedule: ScheduleSettings with {
        briefly "schedule"
        described as {
          |The schedule column of the stored socialPost row.
        }
      }
      status: PostStatus with {
        briefly "status"
        described as {
          |The status column of the stored socialPost row.
        }
      }
    } with {
      briefly "Stored socialPost row"
      described as {
        |The persistence shape of socialPost data as this repository stores it.
      }
    }
    schema PostData is relational
      of posts as type StoredSocialPost
        index on field StoredSocialPost.status
        index on field StoredSocialPost.contentType
        index on field StoredSocialPost.schedule.scheduledTime
 with {
      briefly "Post data schema"
      described as {
        |The relational schema holding post data for the SocialRepository.
      }
    }
    handler PostPersistence is {
      on query GetSocialMetrics is {
        do "read the social metrics projection"
        yield result SocialMetricsView
      }
      on command SocialPost.CreatePost is {
        tell event SocialPost.PostCreated to entity SocialContext.SocialPost
        do "Store new post record"
      }
      on command SocialPost.UpdateContent is {
        tell event SocialPost.ContentUpdated to entity SocialContext.SocialPost
        do "Update post content"
      }
      on command SocialPost.SchedulePost is {
        tell event SocialPost.PostScheduled to entity SocialContext.SocialPost
        do "Store schedule information"
      }
      on command SocialPost.RecordPublishResult is {
        tell event SocialPost.PublishResultRecorded to entity SocialContext.SocialPost
        do "Store publish result"
      }
      on command SocialPost.UpdateEngagement is {
        tell event SocialPost.EngagementUpdated to entity SocialContext.SocialPost
        do "Store engagement metrics"
      }
      on command SocialPost.AddComment is {
        tell event SocialPost.CommentAdded to entity SocialContext.SocialPost
        do "Store comment"
      }
      on command SocialPost.DeletePost is {
        do "Mark post as deleted"
      }
    } with {
      briefly "Persists post commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Social data persistence"
    described as {
      |Persistent storage for posts.
    }
  }
  query GetSocialMetrics is  {
    socialMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which social metrics to retrieve.
      }
    }
  } with {
    briefly "Get social metrics"
    described as {
      |Retrieves the social metrics projection.
    }
  }
  result SocialMetricsView is  {
    socialMetrics: SocialAnalytics.SocialMetrics with {
      briefly "Social metrics"
      described as {
        |The social metrics being returned.
      }
    }
  } with {
    briefly "Social metrics view"
    described as {
      |Read model view carrying the social metrics projection.
    }
  }
  projector SocialAnalytics as flow is {
    updates repository SocialContext.SocialRepository
    inlet SocialAnalyticsFromSocialPost is type SocialPostEvent    outlet SocialAnalyticsOut is type SocialPostEvent
    record SocialMetrics is  {
      totalPosts: Natural with {
        briefly "Posts"
        described as {
          |Total posts.
        }
      }
      scheduledPosts: Natural with {
        briefly "Scheduled"
        described as {
          |Scheduled posts.
        }
      }
      totalEngagement: Natural with {
        briefly "Engagement"
        described as {
          |Total engagement.
        }
      }
      averageEngagementRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Avg rate.
        }
      }
      topPlatform: String(1,20) with {
        briefly "Top"
        described as {
          |Best performing.
        }
      }
      totalReach: Natural with {
        briefly "Reach"
        described as {
          |Total reach.
        }
      }
    } with {
      briefly "Social metrics"
      described as {
        |Social media metrics.
      }
    }
    handler AnalyticsHandler is {
      on event SocialPost.PostCreated is {
        tell event SocialPost.PostCreated to repository SocialContext.SocialRepository
        do "Increment post count"
      }
      on event SocialPost.PostScheduled is {
        tell event SocialPost.PostScheduled to repository SocialContext.SocialRepository
        do "Track scheduled posts"
      }
      on event SocialPost.PublishResultRecorded is {
        tell event SocialPost.PublishResultRecorded to repository SocialContext.SocialRepository
        do "Update publish statistics"
      }
      on event SocialPost.EngagementUpdated is {
        tell event SocialPost.EngagementUpdated to repository SocialContext.SocialRepository
        do "Aggregate engagement"
      }
    } with {
      briefly "Maintains social analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Social analytics"
    described as {
      |Social media performance.
    }
  }
  // ---- Event publication for SocialPost ----
  type SocialPostEvent is one of {
    SocialContext.SocialPost.PostCreated or SocialContext.SocialPost.ContentUpdated or SocialContext.SocialPost.PlatformVariantAdded or SocialContext.SocialPost.PostScheduled or SocialContext.SocialPost.PostPublishing or SocialContext.SocialPost.PublishResultRecorded or SocialContext.SocialPost.EngagementUpdated or SocialContext.SocialPost.CommentAdded or SocialContext.SocialPost.CommentReplied or SocialContext.SocialPost.PostDeleted
  } with {
    briefly "SocialPost event alternation"
    described as {
      |Union of all SocialPost events, for streaming and event-sourced
      |persistence.
    }
  }
  processor SocialPostEventSource as source is {
    outlet SocialPostEvents is type SocialPostEvent
    handler SocialPostSourceHandler is {
      on event SocialPost.PostCreated is {
        send event SocialPost.PostCreated to outlet SocialPostEvents
      }
      on event SocialPost.ContentUpdated is {
        send event SocialPost.ContentUpdated to outlet SocialPostEvents
      }
      on event SocialPost.PlatformVariantAdded is {
        send event SocialPost.PlatformVariantAdded to outlet SocialPostEvents
      }
      on event SocialPost.PostScheduled is {
        send event SocialPost.PostScheduled to outlet SocialPostEvents
      }
      on event SocialPost.PostPublishing is {
        send event SocialPost.PostPublishing to outlet SocialPostEvents
      }
      on event SocialPost.PublishResultRecorded is {
        send event SocialPost.PublishResultRecorded to outlet SocialPostEvents
      }
      on event SocialPost.EngagementUpdated is {
        send event SocialPost.EngagementUpdated to outlet SocialPostEvents
      }
      on event SocialPost.CommentAdded is {
        send event SocialPost.CommentAdded to outlet SocialPostEvents
      }
      on event SocialPost.CommentReplied is {
        send event SocialPost.CommentReplied to outlet SocialPostEvents
      }
      on event SocialPost.PostDeleted is {
        send event SocialPost.PostDeleted to outlet SocialPostEvents
      }
      on other is {
        error "Unexpected message for source SocialPostEventSource"
      }
    } with {
      briefly "SocialPost source handler"
      described as {
        |Publishes SocialPost events onto the outlet.
      }
    }
  } with {
    briefly "SocialPost event source"
    described as {
      |Publishes SocialPost entity events into the streaming topology.
    }
  }
  processor SocialPostEventSink as sink is {
    inlet SocialPostInlet is type SocialPostEvent    handler SocialPostSinkHandler is {
      on event SocialPost.PostCreated is {
        tell event SocialPost.PostCreated to repository SocialContext.SocialRepository
      }
      on event SocialPost.ContentUpdated is {
        tell event SocialPost.ContentUpdated to repository SocialContext.SocialRepository
      }
      on event SocialPost.PlatformVariantAdded is {
        tell event SocialPost.PlatformVariantAdded to repository SocialContext.SocialRepository
      }
      on event SocialPost.PostScheduled is {
        tell event SocialPost.PostScheduled to repository SocialContext.SocialRepository
      }
      on event SocialPost.PostPublishing is {
        tell event SocialPost.PostPublishing to repository SocialContext.SocialRepository
      }
      on event SocialPost.PublishResultRecorded is {
        tell event SocialPost.PublishResultRecorded to repository SocialContext.SocialRepository
      }
      on event SocialPost.EngagementUpdated is {
        tell event SocialPost.EngagementUpdated to repository SocialContext.SocialRepository
      }
      on event SocialPost.CommentAdded is {
        tell event SocialPost.CommentAdded to repository SocialContext.SocialRepository
      }
      on event SocialPost.CommentReplied is {
        tell event SocialPost.CommentReplied to repository SocialContext.SocialRepository
      }
      on event SocialPost.PostDeleted is {
        tell event SocialPost.PostDeleted to repository SocialContext.SocialRepository
      }
      on other is {
        error "Unexpected message for sink SocialPostEventSink"
      }
    } with {
      briefly "SocialPost sink handler"
      described as {
        |Persists SocialPost events via the repository.
      }
    }
  } with {
    briefly "SocialPost event sink"
    described as {
      |Receives SocialPost events for persistence.
    }
  }
  connector SocialPostEventFlow is from outlet SocialContext.SocialPostEventSource.SocialPostEvents to inlet SocialContext.SocialPostEventSink.SocialPostInlet with {
    briefly "SocialPost event flow"
    described as {
      |Connects the SocialPost source to its sink.
    }
  }
  processor SocialPostEventSplit as split is {
    inlet SocialPostEventSplitIn is type SocialPostEvent    outlet SocialPostEventSplitToSocialRepository is type SocialPostEvent
    outlet SocialPostEventSplitToSocialAnalytics is type SocialPostEvent
    handler SocialPostEventSplitHandler is {
      on event SocialPost.PostCreated is {
        send event SocialPost.PostCreated to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.PostCreated to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.PostCreated to entity SocialContext.SocialPost
      }
      on event SocialPost.ContentUpdated is {
        send event SocialPost.ContentUpdated to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.ContentUpdated to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.ContentUpdated to entity SocialContext.SocialPost
      }
      on event SocialPost.PlatformVariantAdded is {
        send event SocialPost.PlatformVariantAdded to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.PlatformVariantAdded to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.PlatformVariantAdded to entity SocialContext.SocialPost
      }
      on event SocialPost.PostScheduled is {
        send event SocialPost.PostScheduled to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.PostScheduled to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.PostScheduled to entity SocialContext.SocialPost
      }
      on event SocialPost.PostPublishing is {
        send event SocialPost.PostPublishing to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.PostPublishing to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.PostPublishing to entity SocialContext.SocialPost
      }
      on event SocialPost.PublishResultRecorded is {
        send event SocialPost.PublishResultRecorded to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.PublishResultRecorded to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.PublishResultRecorded to entity SocialContext.SocialPost
      }
      on event SocialPost.EngagementUpdated is {
        send event SocialPost.EngagementUpdated to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.EngagementUpdated to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.EngagementUpdated to entity SocialContext.SocialPost
      }
      on event SocialPost.CommentAdded is {
        send event SocialPost.CommentAdded to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.CommentAdded to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.CommentAdded to entity SocialContext.SocialPost
      }
      on event SocialPost.CommentReplied is {
        send event SocialPost.CommentReplied to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.CommentReplied to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.CommentReplied to entity SocialContext.SocialPost
      }
      on event SocialPost.PostDeleted is {
        send event SocialPost.PostDeleted to outlet SocialPostEventSplitToSocialRepository
        send event SocialPost.PostDeleted to outlet SocialPostEventSplitToSocialAnalytics
        tell event SocialPost.PostDeleted to entity SocialContext.SocialPost
      }
      on other is {
        error "Unexpected message for processor SocialPostEventSplit"
      }
    } with {
      briefly "SocialPost event fan-out handler"
      described as {
        |Delivers each SocialPost event to all of its consumers.
      }
    }
  } with {
    briefly "SocialPost event fan-out"
    described as {
      |Fans SocialPost events out to the repository and projectors.
    }
  }
  connector 'SocialPostEvent Stream' is from outlet SocialContext.SocialPost.SocialPostEvents2 to inlet SocialContext.SocialPostEventSplit.SocialPostEventSplitIn with {
    briefly "SocialPost events, fanned out to storage and read models"
  }
  connector 'SocialPostEvent Storage' is from outlet SocialContext.SocialPostEventSplit.SocialPostEventSplitToSocialRepository to inlet SocialContext.SocialRepository.SocialRepositoryFromSocialPost with {
    briefly "SocialPost events on their way to storage"
  }
  connector 'SocialAnalytics Feed' is from outlet SocialContext.SocialPostEventSplit.SocialPostEventSplitToSocialAnalytics to inlet SocialContext.SocialAnalytics.SocialAnalyticsFromSocialPost with {
    briefly "SocialPost events feeding the SocialAnalytics projection"
  }
  connector 'SocialAnalytics Storage' is from outlet SocialContext.SocialAnalytics.SocialAnalyticsOut to inlet SocialContext.SocialRepository.SocialRepositoryFromSocialAnalytics with {
    briefly "The SocialAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for social media"
  described as {
    |Social content management context.
  }
}
