// Social Media Management - Social Context
context SocialContext as router is {
  type FromPlatformAPICommand is one of {
    SocialPost.AddComment or SocialPost.RecordPublishResult or SocialPost.UpdateEngagement
  } with {
    briefly "What FromPlatformAPI turns that service's news into"
  }
  inlet SocialContextFromPlatformAPI is type SocialContext.FromPlatformAPICommand with {
    briefly "What FromPlatformAPI makes of that service's news"
  }
  connector 'FromPlatformAPI Intake' is from outlet SocialContext.FromPlatformAPI.FromPlatformAPIToSocialContext to inlet SocialContext.SocialContextFromPlatformAPI with {
    briefly "What FromPlatformAPI makes of that news, on its way in"
  }
  inlet SocialPostCommandStreamIn is type SocialPostCommand  outlet SocialPostCommandStreamOut is type SocialPostCommand
  inlet SocialPostResultStreamIn is result SocialPost.SocialPostResult  outlet SocialPostResultStreamOut is result SocialPost.SocialPostResult
  handler SocialContextBoundary is {
    on createPost: command SocialPost.CreatePost is {
      send createPost to outlet SocialContext.SocialPostCommandStreamOut
    }
    on updateContent: command SocialPost.UpdateContent is {
      send updateContent to outlet SocialContext.SocialPostCommandStreamOut
    }
    on addPlatformVariant: command SocialPost.AddPlatformVariant is {
      send addPlatformVariant to outlet SocialContext.SocialPostCommandStreamOut
    }
    on schedulePost: command SocialPost.SchedulePost is {
      send schedulePost to outlet SocialContext.SocialPostCommandStreamOut
    }
    on publishNow: command SocialPost.PublishNow is {
      send publishNow to outlet SocialContext.SocialPostCommandStreamOut
    }
    on recordPublishResult: command SocialPost.RecordPublishResult is {
      send recordPublishResult to outlet SocialContext.SocialPostCommandStreamOut
    }
    on updateEngagement: command SocialPost.UpdateEngagement is {
      send updateEngagement to outlet SocialContext.SocialPostCommandStreamOut
    }
    on addComment: command SocialPost.AddComment is {
      send addComment to outlet SocialContext.SocialPostCommandStreamOut
    }
    on replyToComment: command SocialPost.ReplyToComment is {
      send replyToComment to outlet SocialContext.SocialPostCommandStreamOut
    }
    on deletePost: command SocialPost.DeletePost is {
      send deletePost to outlet SocialContext.SocialPostCommandStreamOut
    }
    on socialPostResult: result SocialPost.SocialPostResult is {
      send socialPostResult to outlet SocialContext.SocialPostResultStreamOut
    }
    on other is {
      error "Unexpected message at the SocialContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SocialPostCommand Stream Intake' is from outlet SocialContext.SocialPostCommandStreamOut to inlet SocialContext.SocialPost.SocialPostCommands  connector 'SocialPostResult Stream Egress' is from outlet SocialContext.SocialRepository.SocialRepositoryResponses to inlet SocialContext.SocialPostResultStreamIn  adaptor FromMediaStorage from context MediaStorage is { 
    inlet FromMediaStorageIn is type MediaStorage.MediaStorageEvent    handler FromMediaStorageHandler is {
      on mediaUploaded: event MediaStorage.MediaUploaded is {
        do "the media is stored; creating the post was recorded here"
      }
      on thumbnailGenerated: event MediaStorage.ThumbnailGenerated is {
        do "the thumbnail exists; nothing the post holds changes"
      }
      on other is {
        error "Unexpected message for adaptor FromMediaStorage"
      }
    } with {
      briefly "from media storage"
      described as {
        |Carries messages from the external MediaStorage.
      }
    }
  } with {
    briefly "MediaStorage integration"
    described as {
      |The model's side of the MediaStorage conversation.
    }
  }
  adaptor ToMediaStorage to context MediaStorage as flow is { 
    inlet ToMediaStorageIn is type SocialPostEvent    outlet ToMediaStorageOut is type MediaStorage.MediaStorageCommand
    handler ToMediaStorageHandler is {
      on postCreated: event PostCreated is {
        let artifact: type MediaStorage.UploadMedia = prompt("translate the postCreated event into an UploadMedia putting the post's images and video where the channels can fetch them")
        send artifact to outlet SocialContext.ToMediaStorage.ToMediaStorageOut
        let thumbnail: type MediaStorage.GenerateThumbnail = prompt("translate the postCreated event into a GenerateThumbnail, since every channel wants a preview of the same media")
        send thumbnail to outlet SocialContext.ToMediaStorage.ToMediaStorageOut
      }
      on other is {
        error "Unexpected message for adaptor ToMediaStorage"
      }
    } with {
      briefly "to media storage"
      described as {
        |Carries messages to the external MediaStorage.
      }
    }
  } with {
    briefly "MediaStorage integration"
    described as {
      |The model's side of the MediaStorage conversation.
    }
  }
  adaptor FromOptimalTimeService from context OptimalTimeService is { 
    inlet FromOptimalTimeServiceIn is event OptimalTimeService.OptimalTimeCalculated    handler FromOptimalTimeServiceHandler is {
      on optimalTimeCalculated: event OptimalTimeService.OptimalTimeCalculated is {
        do "the suggested time is in; scheduling is the author's choice"
      }
      on other is {
        error "Unexpected message for adaptor FromOptimalTimeService"
      }
    } with {
      briefly "from optimal time service"
      described as {
        |Carries messages from the external OptimalTimeService.
      }
    }
  } with {
    briefly "OptimalTimeService integration"
    described as {
      |The model's side of the OptimalTimeService conversation.
    }
  }
  adaptor ToOptimalTimeService to context OptimalTimeService as flow is { 
    inlet ToOptimalTimeServiceIn is type SocialPostEvent    outlet ToOptimalTimeServiceOut is command OptimalTimeService.GetOptimalPostTime
    handler ToOptimalTimeServiceHandler is {
      on postCreated: event SocialPost.PostCreated is {
        let item0: type OptimalTimeService.GetOptimalPostTime = prompt("translate the postCreated event into a GetOptimalPostTime, the time being needed before the post can be scheduled")
        send item0 to outlet SocialContext.ToOptimalTimeService.ToOptimalTimeServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToOptimalTimeService"
      }
    } with {
      briefly "to optimal time service"
      described as {
        |Carries messages to the external OptimalTimeService.
      }
    }
  } with {
    briefly "OptimalTimeService integration"
    described as {
      |The model's side of the OptimalTimeService conversation.
    }
  }
  adaptor FromPlatformAPI from context PlatformAPI as flow is { 
    inlet FromPlatformAPIIn is type PlatformAPI.PlatformAPIEvent    outlet FromPlatformAPIToSocialContext is type SocialContext.FromPlatformAPICommand
    handler FromPlatformAPIHandler is {
      on commentsFetched: event PlatformAPI.CommentsFetched is {
        let item0: type SocialPost.AddComment = prompt("translate the commentsFetched event into a AddComment, the platform's comments are the ones the post carries")
        send item0 to outlet SocialContext.FromPlatformAPI.FromPlatformAPIToSocialContext
      }
      on engagementFetched: event PlatformAPI.EngagementFetched is {
        let item0: type SocialPost.UpdateEngagement = prompt("translate the engagementFetched event into a UpdateEngagement, the platform's engagement figures are what the post carries")
        send item0 to outlet SocialContext.FromPlatformAPI.FromPlatformAPIToSocialContext
      }
      on platformPublishFailed: event PlatformAPI.PlatformPublishFailed is {
        let item0: type SocialPost.RecordPublishResult = prompt("translate the platformPublishFailed event into a RecordPublishResult, a failed publish is the result the post records for that platform")
        send item0 to outlet SocialContext.FromPlatformAPI.FromPlatformAPIToSocialContext
      }
      on platformPublished: event PlatformAPI.PlatformPublished is {
        let item0: type SocialPost.RecordPublishResult = prompt("translate the platformPublished event into a RecordPublishResult, the platform's post id and time are the result the post records")
        send item0 to outlet SocialContext.FromPlatformAPI.FromPlatformAPIToSocialContext
      }
      on replyPosted: event PlatformAPI.ReplyPosted is {
        do "the reply is on the platform; replying was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromPlatformAPI"
      }
    } with {
      briefly "from platform api"
      described as {
        |Carries messages from the external PlatformAPI.
      }
    }
  } with {
    briefly "PlatformAPI integration"
    described as {
      |The model's side of the PlatformAPI conversation.
    }
  }
  adaptor ToPlatformAPI to context PlatformAPI as flow is { 
    inlet ToPlatformAPIIn is type SocialPostEvent    outlet ToPlatformAPIOut is type PlatformAPI.PlatformAPICommand
    handler ToPlatformAPIHandler is {
      on postPublishing: event SocialPost.PostPublishing is {
        let item0: type PlatformAPI.PublishToPlatform = prompt("translate the postPublishing event into a PublishToPlatform, publishing being the act the platform performs")
        send item0 to outlet SocialContext.ToPlatformAPI.ToPlatformAPIOut
      }
      on publishResultRecorded: event SocialPost.PublishResultRecorded is {
        let item0: type PlatformAPI.FetchEngagement = prompt("translate the publishResultRecorded event into a FetchEngagement, a live post being the only thing that has engagement")
        send item0 to outlet SocialContext.ToPlatformAPI.ToPlatformAPIOut
        let item1: type PlatformAPI.FetchComments = prompt("translate the publishResultRecorded event into a FetchComments, and the only thing that has comments")
        send item1 to outlet SocialContext.ToPlatformAPI.ToPlatformAPIOut
      }
      on commentReplied: event SocialPost.CommentReplied is {
        let item0: type PlatformAPI.PostReply = prompt("translate the commentReplied event into a PostReply, the reply having to reach the platform it answers on")
        send item0 to outlet SocialContext.ToPlatformAPI.ToPlatformAPIOut
      }
      on other is {
        error "Unexpected message for adaptor ToPlatformAPI"
      }
    } with {
      briefly "to platform api"
      described as {
        |Carries messages to the external PlatformAPI.
      }
    }
  } with {
    briefly "PlatformAPI integration"
    described as {
      |The model's side of the PlatformAPI conversation.
    }
  }
  adaptor FromSentimentAnalysis from context SentimentAnalysis is { 
    inlet FromSentimentAnalysisIn is event SentimentAnalysis.SentimentAnalyzed    handler FromSentimentAnalysisHandler is {
      on sentimentAnalyzed: event SentimentAnalysis.SentimentAnalyzed is {
        do "the sentiment is scored; the community manager reads it"
      }
      on other is {
        error "Unexpected message for adaptor FromSentimentAnalysis"
      }
    } with {
      briefly "from sentiment analysis"
      described as {
        |Carries messages from the external SentimentAnalysis.
      }
    }
  } with {
    briefly "SentimentAnalysis integration"
    described as {
      |The model's side of the SentimentAnalysis conversation.
    }
  }
  adaptor ToSentimentAnalysis to context SentimentAnalysis as flow is { 
    inlet ToSentimentAnalysisIn is type SocialPostEvent    outlet ToSentimentAnalysisOut is command SentimentAnalysis.AnalyzeComment
    handler ToSentimentAnalysisHandler is {
      on commentAdded: event SocialPost.CommentAdded is {
        let item0: type SentimentAnalysis.AnalyzeComment = prompt("translate the commentAdded event into a AnalyzeComment, a comment's tone being unknown until it is read")
        send item0 to outlet SocialContext.ToSentimentAnalysis.ToSentimentAnalysisOut
      }
      on other is {
        error "Unexpected message for adaptor ToSentimentAnalysis"
      }
    } with {
      briefly "to sentiment analysis"
      described as {
        |Carries messages to the external SentimentAnalysis.
      }
    }
  } with {
    briefly "SentimentAnalysis integration"
    described as {
      |The model's side of the SentimentAnalysis conversation.
    }
  }
  include "types.riddl"
  include "SocialPost.riddl"
  type SocialRepositoryCommand is one of {
    SocialContext.SocialRepository.PersistCommentAdded or SocialContext.SocialRepository.PersistCommentReplied or SocialContext.SocialRepository.PersistContentUpdated or SocialContext.SocialRepository.PersistEngagementUpdated or SocialContext.SocialRepository.PersistPlatformVariantAdded or SocialContext.SocialRepository.PersistPostCreated or SocialContext.SocialRepository.PersistPostDeleted or SocialContext.SocialRepository.PersistPostPublishing or SocialContext.SocialRepository.PersistPostScheduled or SocialContext.SocialRepository.PersistPublishResultRecorded
  } with {
    briefly "Anything that writes SocialRepository"
    described as {
      |The persistence commands SocialRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SocialRepository as flow is {
    inlet SocialRepositoryFromSocialAnalytics is type SocialRepositoryCommand    command PersistCommentAdded is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentAdded applies to.
        }
      }
    } with {
      briefly "Persist CommentAdded"
      described as {
        |Instructs this repository to apply CommentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommentReplied is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentReplied applies to.
        }
      }
    } with {
      briefly "Persist CommentReplied"
      described as {
        |Instructs this repository to apply CommentReplied to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistContentUpdated is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row ContentUpdated applies to.
        }
      }
    } with {
      briefly "Persist ContentUpdated"
      described as {
        |Instructs this repository to apply ContentUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPlatformVariantAdded is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row PlatformVariantAdded applies to.
        }
      }
    } with {
      briefly "Persist PlatformVariantAdded"
      described as {
        |Instructs this repository to apply PlatformVariantAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPostDeleted is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row PostDeleted applies to.
        }
      }
    } with {
      briefly "Persist PostDeleted"
      described as {
        |Instructs this repository to apply PostDeleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPostPublishing is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row PostPublishing applies to.
        }
      }
    } with {
      briefly "Persist PostPublishing"
      described as {
        |Instructs this repository to apply PostPublishing to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementUpdated is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementUpdated applies to.
        }
      }
    } with {
      briefly "Persist EngagementUpdated"
      described as {
        |Instructs this repository to apply EngagementUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPostCreated is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row PostCreated applies to.
        }
      }
    } with {
      briefly "Persist PostCreated"
      described as {
        |Instructs this repository to apply PostCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPostScheduled is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row PostScheduled applies to.
        }
      }
    } with {
      briefly "Persist PostScheduled"
      described as {
        |Instructs this repository to apply PostScheduled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPublishResultRecorded is {
      postId: PostId with {
        briefly "Row addressed"
        described as {
          |Which stored row PublishResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist PublishResultRecorded"
      described as {
        |Instructs this repository to apply PublishResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SocialRepositoryResponses is result SocialPost.SocialPostResult
    record StoredSocialPost is {
      socialPostId: UUID with {
        briefly "socialPostId"
        described as {
          |The socialPostId column of the stored socialPost row.
        }
      }
      contentType: ContentType with {
        briefly "contentType"
        described as {
          |The contentType column of the stored socialPost row.
        }
      }
      schedule: ScheduleSettings with {
        briefly "schedule"
        described as {
          |The schedule column of the stored socialPost row.
        }
      }
      status: PostStatus with {
        briefly "status"
        described as {
          |The status column of the stored socialPost row.
        }
      }
    } with {
      briefly "Stored socialPost row"
      described as {
        |The persistence shape of socialPost data as this repository stores it.
      }
    }
    schema PostData is relational
      of posts as record StoredSocialPost
        index on field StoredSocialPost.status
        index on field StoredSocialPost.contentType
        index on field StoredSocialPost.schedule.scheduledTime
 with {
      briefly "Post data schema"
      described as {
        |The relational schema holding post data for the SocialRepository.
      }
    }
    handler PostPersistence is {
      on persistCommentAdded: command PersistCommentAdded is {
        do "apply CommentAdded to the stored row"
      }
      on persistCommentReplied: command PersistCommentReplied is {
        do "apply CommentReplied to the stored row"
      }
      on persistContentUpdated: command PersistContentUpdated is {
        do "apply ContentUpdated to the stored row"
      }
      on persistPlatformVariantAdded: command PersistPlatformVariantAdded is {
        do "apply PlatformVariantAdded to the stored row"
      }
      on persistPostDeleted: command PersistPostDeleted is {
        do "apply PostDeleted to the stored row"
      }
      on persistPostPublishing: command PersistPostPublishing is {
        do "apply PostPublishing to the stored row"
      }
      on persistEngagementUpdated: command PersistEngagementUpdated is {
        do "apply EngagementUpdated to the stored row"
      }
      on persistPostCreated: command PersistPostCreated is {
        do "apply PostCreated to the stored row"
      }
      on persistPostScheduled: command PersistPostScheduled is {
        do "apply PostScheduled to the stored row"
      }
      on persistPublishResultRecorded: command PersistPublishResultRecorded is {
        do "apply PublishResultRecorded to the stored row"
      }
      on query GetSocialMetrics is {
        let socialMetricsView: type SocialMetricsView = prompt("read the social metrics projection")
        reply socialMetricsView
      }
    } with {
      briefly "Persists post commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Social data persistence"
    described as {
      |Persistent storage for posts.
    }
  }
  query GetSocialMetrics replies result SocialMetricsView is {
    socialMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which social metrics to retrieve.
      }
    }
  } with {
    briefly "Get social metrics"
    described as {
      |Retrieves the social metrics projection.
    }
  }
  result SocialMetricsView is {
    socialMetrics: SocialAnalytics.SocialMetrics with {
      briefly "Social metrics"
      described as {
        |The social metrics being returned.
      }
    }
  } with {
    briefly "Social metrics view"
    described as {
      |Read model view carrying the social metrics projection.
    }
  }
  projector SocialAnalytics as flow is {
    updates repository SocialContext.SocialRepository
    outlet SocialAnalyticsToRepository is type SocialRepositoryCommand
    inlet SocialAnalyticsFromSocialPost is type SocialPostEvent    record SocialMetrics is {
      totalPosts: Natural with {
        briefly "Posts"
        described as {
          |Total posts.
        }
      }
      scheduledPosts: Natural with {
        briefly "Scheduled"
        described as {
          |Scheduled posts.
        }
      }
      totalEngagement: Natural with {
        briefly "Engagement"
        described as {
          |Total engagement.
        }
      }
      averageEngagementRate: Decimal(5,2) with {
        briefly "Rate"
        described as {
          |Avg rate.
        }
      }
      topPlatform: String(1,20) with {
        briefly "Top"
        described as {
          |Best performing.
        }
      }
      totalReach: Natural with {
        briefly "Reach"
        described as {
          |Total reach.
        }
      }
    } with {
      briefly "Social metrics"
      described as {
        |Social media metrics.
      }
    }
    handler AnalyticsHandler is {
      on commentAdded: event SocialPost.CommentAdded is {
        tell command SocialContext.SocialRepository.PersistCommentAdded(postId = commentAdded.postId) to repository SocialContext.SocialRepository
        do "apply CommentAdded to the SocialAnalytics projection"
      }
      on commentReplied: event SocialPost.CommentReplied is {
        tell command SocialContext.SocialRepository.PersistCommentReplied(postId = commentReplied.postId) to repository SocialContext.SocialRepository
        do "apply CommentReplied to the SocialAnalytics projection"
      }
      on contentUpdated: event SocialPost.ContentUpdated is {
        tell command SocialContext.SocialRepository.PersistContentUpdated(postId = contentUpdated.postId) to repository SocialContext.SocialRepository
        do "apply ContentUpdated to the SocialAnalytics projection"
      }
      on platformVariantAdded: event SocialPost.PlatformVariantAdded is {
        tell command SocialContext.SocialRepository.PersistPlatformVariantAdded(postId = platformVariantAdded.postId) to repository SocialContext.SocialRepository
        do "apply PlatformVariantAdded to the SocialAnalytics projection"
      }
      on postDeleted: event SocialPost.PostDeleted is {
        tell command SocialContext.SocialRepository.PersistPostDeleted(postId = postDeleted.postId) to repository SocialContext.SocialRepository
        do "apply PostDeleted to the SocialAnalytics projection"
      }
      on postPublishing: event SocialPost.PostPublishing is {
        tell command SocialContext.SocialRepository.PersistPostPublishing(postId = postPublishing.postId) to repository SocialContext.SocialRepository
        do "apply PostPublishing to the SocialAnalytics projection"
      }
      on postCreated: event SocialPost.PostCreated is {
        tell command SocialContext.SocialRepository.PersistPostCreated(postId = postCreated.postId) to repository SocialContext.SocialRepository
        do "Increment post count"
      }
      on postScheduled: event SocialPost.PostScheduled is {
        tell command SocialContext.SocialRepository.PersistPostScheduled(postId = postScheduled.postId) to repository SocialContext.SocialRepository
        do "Track scheduled posts"
      }
      on publishResultRecorded: event SocialPost.PublishResultRecorded is {
        tell command SocialContext.SocialRepository.PersistPublishResultRecorded(postId = publishResultRecorded.postId) to repository SocialContext.SocialRepository
        do "Update publish statistics"
      }
      on engagementUpdated: event SocialPost.EngagementUpdated is {
        tell command SocialContext.SocialRepository.PersistEngagementUpdated(postId = engagementUpdated.postId) to repository SocialContext.SocialRepository
        do "Aggregate engagement"
      }
    } with {
      briefly "Maintains social analytics"
      described as {
        |Projects events into metrics.
      }
    }
  } with {
    briefly "Social analytics"
    described as {
      |Social media performance.
    }
  }
  // ---- Event publication for SocialPost ----
  type SocialPostEvent is one of {
    SocialContext.SocialPost.PostCreated or SocialContext.SocialPost.ContentUpdated or SocialContext.SocialPost.PlatformVariantAdded or SocialContext.SocialPost.PostScheduled or SocialContext.SocialPost.PostPublishing or SocialContext.SocialPost.PublishResultRecorded or SocialContext.SocialPost.EngagementUpdated or SocialContext.SocialPost.CommentAdded or SocialContext.SocialPost.CommentReplied or SocialContext.SocialPost.PostDeleted
  } with {
    briefly "SocialPost event alternation"
    described as {
      |Union of all SocialPost events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet SocialPostEventSplit as split is {
    outlet SocialPostEventSplitToToSentimentAnalysis is type SocialPostEvent
    outlet SocialPostEventSplitToToPlatformAPI is type SocialPostEvent
    outlet SocialPostEventSplitToToOptimalTimeService is type SocialPostEvent
    outlet SocialPostEventSplitToToMediaStorage is type SocialPostEvent
    inlet SocialPostEventSplitIn is type SocialPostEvent    outlet SocialPostEventSplitToSocialAnalytics is type SocialPostEvent
    handler SocialPostEventSplitHandler is {
      on postCreated: event SocialPost.PostCreated is {
        send postCreated to outlet SocialPostEventSplitToSocialAnalytics
        send postCreated to outlet SocialPostEventSplitToToOptimalTimeService
        send postCreated to outlet SocialPostEventSplitToToMediaStorage
        tell postCreated to entity SocialContext.SocialPost
      }
      on contentUpdated: event SocialPost.ContentUpdated is {
        send contentUpdated to outlet SocialPostEventSplitToSocialAnalytics
        tell contentUpdated to entity SocialContext.SocialPost
      }
      on platformVariantAdded: event SocialPost.PlatformVariantAdded is {
        send platformVariantAdded to outlet SocialPostEventSplitToSocialAnalytics
        tell platformVariantAdded to entity SocialContext.SocialPost
      }
      on postScheduled: event SocialPost.PostScheduled is {
        send postScheduled to outlet SocialPostEventSplitToSocialAnalytics
        tell postScheduled to entity SocialContext.SocialPost
      }
      on postPublishing: event SocialPost.PostPublishing is {
        send postPublishing to outlet SocialPostEventSplitToSocialAnalytics
        send postPublishing to outlet SocialPostEventSplitToToPlatformAPI
        tell postPublishing to entity SocialContext.SocialPost
      }
      on publishResultRecorded: event SocialPost.PublishResultRecorded is {
        send publishResultRecorded to outlet SocialPostEventSplitToSocialAnalytics
        send publishResultRecorded to outlet SocialPostEventSplitToToPlatformAPI
        tell publishResultRecorded to entity SocialContext.SocialPost
      }
      on engagementUpdated: event SocialPost.EngagementUpdated is {
        send engagementUpdated to outlet SocialPostEventSplitToSocialAnalytics
        tell engagementUpdated to entity SocialContext.SocialPost
      }
      on commentAdded: event SocialPost.CommentAdded is {
        send commentAdded to outlet SocialPostEventSplitToSocialAnalytics
        send commentAdded to outlet SocialPostEventSplitToToSentimentAnalysis
        tell commentAdded to entity SocialContext.SocialPost
      }
      on commentReplied: event SocialPost.CommentReplied is {
        send commentReplied to outlet SocialPostEventSplitToSocialAnalytics
        send commentReplied to outlet SocialPostEventSplitToToPlatformAPI
        tell commentReplied to entity SocialContext.SocialPost
      }
      on postDeleted: event SocialPost.PostDeleted is {
        send postDeleted to outlet SocialPostEventSplitToSocialAnalytics
        tell postDeleted to entity SocialContext.SocialPost
      }
      on other is {
        error "Unexpected message for processor SocialPostEventSplit"
      }
    } with {
      briefly "SocialPost event fan-out handler"
      described as {
        |Delivers each SocialPost event to all of its consumers.
      }
