// Ad Serving - Ad Context
context AdContext as router is {
  inlet AdCommandStreamIn is type AdCommand  outlet AdCommandStreamOut is type AdCommand
  inlet AdImpressionResultStreamIn is type Advertisement.AdResult  outlet AdImpressionResultStreamOut is type Advertisement.AdResult
  handler AdContextBoundary is {
    on createAd: command Advertisement.CreateAd is {
      send createAd to outlet AdContext.AdCommandStreamOut
    }
    on updateTargeting: command Advertisement.UpdateTargeting is {
      send updateTargeting to outlet AdContext.AdCommandStreamOut
    }
    on updateBid: command Advertisement.UpdateBid is {
      send updateBid to outlet AdContext.AdCommandStreamOut
    }
    on activateAd: command Advertisement.ActivateAd is {
      send activateAd to outlet AdContext.AdCommandStreamOut
    }
    on pauseAd: command Advertisement.PauseAd is {
      send pauseAd to outlet AdContext.AdCommandStreamOut
    }
    on recordImpression: command Advertisement.RecordImpression is {
      send recordImpression to outlet AdContext.AdCommandStreamOut
    }
    on recordClick: command Advertisement.RecordClick is {
      send recordClick to outlet AdContext.AdCommandStreamOut
    }
    on completeAd: command Advertisement.CompleteAd is {
      send completeAd to outlet AdContext.AdCommandStreamOut
    }
    on archiveAd: command Advertisement.ArchiveAd is {
      send archiveAd to outlet AdContext.AdCommandStreamOut
    }
    on adResult: result Advertisement.AdResult is {
      send adResult to outlet AdContext.AdImpressionResultStreamOut
    }
    on other is {
      error "Unexpected message at the AdContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'AdCommand Stream Intake' is from outlet AdContext.AdCommandStreamOut to inlet AdContext.Advertisement.AdCommands  connector 'AdImpressionResult Stream Egress' is from outlet AdContext.AdRepository.AdRepositoryResponses to inlet AdContext.AdImpressionResultStreamIn  adaptor FromAdExchange from context AdExchange is { 
    handler FromAdExchangeHandler is {
      on result AdExchange.BidRequest is {
        do "the model receives bid request"
      }
      on event AdExchange.BidWon is {
        do "the model receives bid won"
      }
      on other is {
        error "Unexpected message for adaptor FromAdExchange"
      }
    } with {
      briefly "from ad exchange"
      described as {
        |Carries messages from the external AdExchange.
      }
    }
  } with {
    briefly "AdExchange integration"
    described as {
      |The model's side of the AdExchange conversation.
    }
  }
  adaptor ToAdExchange to context AdExchange is { 
    handler ToAdExchangeHandler is {
      on query AdExchange.GetBidRequest is {
        do "the model sends get bid request"
      }
      on command AdExchange.SubmitBid is {
        do "the model sends submit bid"
      }
      on other is {
        error "Unexpected message for adaptor ToAdExchange"
      }
    } with {
      briefly "to ad exchange"
      described as {
        |Carries messages to the external AdExchange.
      }
    }
  } with {
    briefly "AdExchange integration"
    described as {
      |The model's side of the AdExchange conversation.
    }
  }
  adaptor FromAdVerification from context AdVerification is { 
    handler FromAdVerificationHandler is {
      on result AdVerification.VerificationResult is {
        do "the model receives verification result"
      }
      on other is {
        error "Unexpected message for adaptor FromAdVerification"
      }
    } with {
      briefly "from ad verification"
      described as {
        |Carries messages from the external AdVerification.
      }
    }
  } with {
    briefly "AdVerification integration"
    described as {
      |The model's side of the AdVerification conversation.
    }
  }
  adaptor ToAdVerification to context AdVerification is { 
    handler ToAdVerificationHandler is {
      on query AdVerification.GetVerification is {
        do "the model sends get verification"
      }
      on command AdVerification.VerifyImpression is {
        do "the model sends verify impression"
      }
      on other is {
        error "Unexpected message for adaptor ToAdVerification"
      }
    } with {
      briefly "to ad verification"
      described as {
        |Carries messages to the external AdVerification.
      }
    }
  } with {
    briefly "AdVerification integration"
    described as {
      |The model's side of the AdVerification conversation.
    }
  }
  adaptor FromCDN from context CDN is { 
    handler FromCDNHandler is {
      on event CDN.CreativeCached is {
        do "the model receives creative cached"
      }
      on other is {
        error "Unexpected message for adaptor FromCDN"
      }
    } with {
      briefly "from cdn"
      described as {
        |Carries messages from the external CDN.
      }
    }
  } with {
    briefly "CDN integration"
    described as {
      |The model's side of the CDN conversation.
    }
  }
  adaptor ToCDN to context CDN is { 
    handler ToCDNHandler is {
      on command CDN.CacheCreative is {
        do "the model sends cache creative"
      }
      on command CDN.PurgeCreative is {
        do "the model sends purge creative"
      }
      on other is {
        error "Unexpected message for adaptor ToCDN"
      }
    } with {
      briefly "to cdn"
      described as {
        |Carries messages to the external CDN.
      }
    }
  } with {
    briefly "CDN integration"
    described as {
      |The model's side of the CDN conversation.
    }
  }
  adaptor FromDataManagementPlatform from context DataManagementPlatform is { 
    handler FromDataManagementPlatformHandler is {
      on result DataManagementPlatform.AudienceSegments is {
        do "the model receives audience segments"
      }
      on other is {
        error "Unexpected message for adaptor FromDataManagementPlatform"
      }
    } with {
      briefly "from data management platform"
      described as {
        |Carries messages from the external DataManagementPlatform.
      }
    }
  } with {
    briefly "DataManagementPlatform integration"
    described as {
      |The model's side of the DataManagementPlatform conversation.
    }
  }
  adaptor ToDataManagementPlatform to context DataManagementPlatform is { 
    handler ToDataManagementPlatformHandler is {
      on query DataManagementPlatform.GetAudienceSegments is {
        do "the model sends get audience segments"
      }
      on command DataManagementPlatform.SyncConversion is {
        do "the model sends sync conversion"
      }
      on other is {
        error "Unexpected message for adaptor ToDataManagementPlatform"
      }
    } with {
      briefly "to data management platform"
      described as {
        |Carries messages to the external DataManagementPlatform.
      }
    }
  } with {
    briefly "DataManagementPlatform integration"
    described as {
      |The model's side of the DataManagementPlatform conversation.
    }
  }
  include "types.riddl"
  include "Advertisement.riddl"
  repository AdRepository as merge is {
    command PersistClickRecorded is  {
      adId: AdId with {
        briefly "Row addressed"
        described as {
          |Which stored row ClickRecorded applies to.
        }
      }
    } with {
      briefly "Persist ClickRecorded"
      described as {
        |Instructs this repository to apply ClickRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistImpressionRecorded is  {
      adId: AdId with {
        briefly "Row addressed"
        described as {
          |Which stored row ImpressionRecorded applies to.
        }
      }
    } with {
      briefly "Persist ImpressionRecorded"
      described as {
        |Instructs this repository to apply ImpressionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet AdRepositoryFromAd is type AdEvent    inlet AdRepositoryFromAdPerformance is type AdEvent    outlet AdRepositoryResponses is type Advertisement.AdResult
    record StoredAd is  {
      adId: AdId with {
        briefly "adId"
        described as {
          |The adId column of the stored ad row.
        }
      }
      campaignId: CampaignId with {
        briefly "campaignId"
        described as {
          |The campaignId column of the stored ad row.
        }
      }
      status: AdStatus with {
        briefly "status"
        described as {
          |The status column of the stored ad row.
        }
      }
    } with {
      briefly "Stored ad row"
      described as {
        |The persistence shape of ad data as this repository stores it.
      }
    }
    schema AdData is relational
      of ads as type StoredAd
        index on field StoredAd.adId
        index on field StoredAd.campaignId
        index on field StoredAd.status
 with {
      briefly "Ad data schema"
      described as {
        |The relational schema holding ad data for the AdRepository.
      }
    }
    handler AdPersistence is {
      on persistClickRecorded: command PersistClickRecorded is {
        do "apply ClickRecorded to the stored row"
      }
      on persistImpressionRecorded: command PersistImpressionRecorded is {
        do "apply ImpressionRecorded to the stored row"
      }
      on query GetCampaignPerformance is {
        let campaignPerformanceView: type CampaignPerformanceView = prompt("read the campaign performance projection")
        reply campaignPerformanceView
      }
      on createAd: command Advertisement.CreateAd is {
        tell event Advertisement.AdCreated(adId = createAd.adId, campaignId = createAd.campaignId, adName = createAd.adName) to entity AdContext.Advertisement
        do "Store new ad record"
      }
      on updateTargeting: command Advertisement.UpdateTargeting is {
        tell event Advertisement.TargetingUpdated(adId = updateTargeting.adId, targeting = updateTargeting.targeting) to entity AdContext.Advertisement
        do "Update ad targeting"
      }
      on command Advertisement.ActivateAd is {
        do "Update ad to active"
      }
      on recordImpression: command Advertisement.RecordImpression is {
        tell event Advertisement.ImpressionRecorded(adId = recordImpression.adId, impression = recordImpression.impression) to entity AdContext.Advertisement
        do "Store impression and update stats"
      }
      on recordClick: command Advertisement.RecordClick is {
        tell event Advertisement.ClickRecorded(adId = recordClick.adId, click = recordClick.click) to entity AdContext.Advertisement
        do "Store click and update stats"
      }
      on completeAd: command Advertisement.CompleteAd is {
        tell event Advertisement.AdCompleted(adId = completeAd.adId, finalStats = completeAd.finalStats, completedAt = completeAd.completedAt) to entity AdContext.Advertisement
        do "Update ad to completed"
      }
    } with {
      briefly "Persists ad commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad data persistence"
    described as {
      |Persistent storage for ads.
    }
  }
  query GetCampaignPerformance is  {
    campaignPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which campaign performance to retrieve.
      }
    }
  } with {
    briefly "Get campaign performance"
    described as {
      |Retrieves the campaign performance projection.
    }
  }
  result CampaignPerformanceView is  {
    campaignPerformance: AdPerformance.CampaignPerformance with {
      briefly "Campaign performance"
      described as {
        |The campaign performance being returned.
      }
    }
  } with {
    briefly "Campaign performance view"
    described as {
      |Read model view carrying the campaign performance projection.
    }
  }
  projector AdPerformance as flow is {
    updates repository AdContext.AdRepository
    inlet AdPerformanceFromAd is type AdEvent    outlet AdPerformanceOut is type AdEvent
    record CampaignPerformance is  {
      campaignId: CampaignId with {
        briefly "Campaign"
        described as {
          |Campaign ID.
        }
      }
      totalImpressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions.
        }
      }
      totalClicks: Natural with {
        briefly "Clicks"
        described as {
          |Total clicks.
        }
      }
      totalSpend: Decimal(15,2) with {
        briefly "Spend"
        described as {
          |Total spend.
        }
      }
      ctr: Decimal(8,6) with {
        briefly "CTR"
        described as {
          |Click-through rate.
        }
      }
      avgEcpm: Decimal(10,4) with {
        briefly "eCPM"
        described as {
          |Avg eCPM.
        }
      }
    } with {
      briefly "Campaign performance"
      described as {
        |Campaign delivery performance.
      }
    }
    handler PerformanceHandler is {
      on impressionRecorded: event Advertisement.ImpressionRecorded is {
        tell command AdContext.AdRepository.PersistImpressionRecorded(adId = impressionRecorded.adId) to repository AdContext.AdRepository
        do "Aggregate impressions by campaign"
      }
      on clickRecorded: event Advertisement.ClickRecorded is {
        tell command AdContext.AdRepository.PersistClickRecorded(adId = clickRecorded.adId) to repository AdContext.AdRepository
        do "Calculate CTR by campaign"
      }
    } with {
      briefly "Maintains performance metrics"
      described as {
        |Projects events into performance.
      }
    }
  } with {
    briefly "Ad performance"
    described as {
      |Ad delivery analytics.
    }
  }
  // ---- Event publication for Ad ----
  type AdEvent is one of {
    AdContext.Advertisement.AdCreated or AdContext.Advertisement.TargetingUpdated or AdContext.Advertisement.BidUpdated or AdContext.Advertisement.AdActivated or AdContext.Advertisement.AdPaused or AdContext.Advertisement.ImpressionRecorded or AdContext.Advertisement.ClickRecorded or AdContext.Advertisement.AdCompleted or AdContext.Advertisement.AdArchived
  } with {
    briefly "Ad event alternation"
    described as {
      |Union of all Ad events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AdEventSource as source is {
    outlet AdEvents is type AdEvent
    handler AdSourceHandler is {
      on adCreated: event Advertisement.AdCreated is {
        send adCreated to outlet AdEvents
      }
      on targetingUpdated: event Advertisement.TargetingUpdated is {
        send targetingUpdated to outlet AdEvents
      }
      on bidUpdated: event Advertisement.BidUpdated is {
        send bidUpdated to outlet AdEvents
      }
      on adActivated: event Advertisement.AdActivated is {
        send adActivated to outlet AdEvents
      }
      on adPaused: event Advertisement.AdPaused is {
        send adPaused to outlet AdEvents
      }
      on impressionRecorded: event Advertisement.ImpressionRecorded is {
        send impressionRecorded to outlet AdEvents
      }
      on clickRecorded: event Advertisement.ClickRecorded is {
        send clickRecorded to outlet AdEvents
      }
      on adCompleted: event Advertisement.AdCompleted is {
        send adCompleted to outlet AdEvents
      }
      on adArchived: event Advertisement.AdArchived is {
        send adArchived to outlet AdEvents
      }
      on other is {
        error "Unexpected message for source AdEventSource"
      }
    } with {
      briefly "Ad source handler"
      described as {
        |Publishes Ad events onto the outlet.
      }
    }
  } with {
    briefly "Ad event source"
    described as {
      |Publishes Ad entity events into the streaming topology.
    }
  }
  processor AdEventSink as sink is {
    inlet AdInlet is type AdEvent    handler AdSinkHandler is {
      on adCreated: event Advertisement.AdCreated is {
        tell adCreated to repository AdContext.AdRepository
      }
      on targetingUpdated: event Advertisement.TargetingUpdated is {
        tell targetingUpdated to repository AdContext.AdRepository
      }
      on bidUpdated: event Advertisement.BidUpdated is {
        tell bidUpdated to repository AdContext.AdRepository
      }
      on adActivated: event Advertisement.AdActivated is {
        tell adActivated to repository AdContext.AdRepository
      }
      on adPaused: event Advertisement.AdPaused is {
        tell adPaused to repository AdContext.AdRepository
      }
      on impressionRecorded: event Advertisement.ImpressionRecorded is {
        tell impressionRecorded to repository AdContext.AdRepository
      }
      on clickRecorded: event Advertisement.ClickRecorded is {
        tell clickRecorded to repository AdContext.AdRepository
      }
      on adCompleted: event Advertisement.AdCompleted is {
        tell adCompleted to repository AdContext.AdRepository
      }
      on adArchived: event Advertisement.AdArchived is {
        tell adArchived to repository AdContext.AdRepository
      }
      on other is {
        error "Unexpected message for sink AdEventSink"
      }
    } with {
      briefly "Ad sink handler"
      described as {
        |Persists Ad events via the repository.
      }
    }
  } with {
    briefly "Ad event sink"
    described as {
      |Receives Ad events for persistence.
    }
  }
  connector AdEventFlow is from outlet AdContext.AdEventSource.AdEvents to inlet AdContext.AdEventSink.AdInlet with {
    briefly "Ad event flow"
    described as {
      |Connects the Ad source to its sink.
    }
  }
  processor AdEventSplit as split is {
    inlet AdEventSplitIn is type AdEvent    outlet AdEventSplitToAdRepository is type AdEvent
    outlet AdEventSplitToAdPerformance is type AdEvent
    handler AdEventSplitHandler is {
      on adCreated: event Advertisement.AdCreated is {
        send adCreated to outlet AdEventSplitToAdRepository
        send adCreated to outlet AdEventSplitToAdPerformance
        tell adCreated to entity AdContext.Advertisement
      }
      on targetingUpdated: event Advertisement.TargetingUpdated is {
        send targetingUpdated to outlet AdEventSplitToAdRepository
        send targetingUpdated to outlet AdEventSplitToAdPerformance
        tell targetingUpdated to entity AdContext.Advertisement
      }
      on bidUpdated: event Advertisement.BidUpdated is {
        send bidUpdated to outlet AdEventSplitToAdRepository
        send bidUpdated to outlet AdEventSplitToAdPerformance
        tell bidUpdated to entity AdContext.Advertisement
      }
      on adActivated: event Advertisement.AdActivated is {
        send adActivated to outlet AdEventSplitToAdRepository
        send adActivated to outlet AdEventSplitToAdPerformance
        tell adActivated to entity AdContext.Advertisement
      }
      on adPaused: event Advertisement.AdPaused is {
        send adPaused to outlet AdEventSplitToAdRepository
        send adPaused to outlet AdEventSplitToAdPerformance
        tell adPaused to entity AdContext.Advertisement
      }
      on impressionRecorded: event Advertisement.ImpressionRecorded is {
        send impressionRecorded to outlet AdEventSplitToAdRepository
        send impressionRecorded to outlet AdEventSplitToAdPerformance
        tell impressionRecorded to entity AdContext.Advertisement
      }
      on clickRecorded: event Advertisement.ClickRecorded is {
        send clickRecorded to outlet AdEventSplitToAdRepository
        send clickRecorded to outlet AdEventSplitToAdPerformance
        tell clickRecorded to entity AdContext.Advertisement
      }
      on adCompleted: event Advertisement.AdCompleted is {
        send adCompleted to outlet AdEventSplitToAdRepository
        send adCompleted to outlet AdEventSplitToAdPerformance
        tell adCompleted to entity AdContext.Advertisement
      }
      on adArchived: event Advertisement.AdArchived is {
        send adArchived to outlet AdEventSplitToAdRepository
        send adArchived to outlet AdEventSplitToAdPerformance
        tell adArchived to entity AdContext.Advertisement
      }
      on other is {
        error "Unexpected message for processor AdEventSplit"
      }
    } with {
      briefly "Ad event fan-out handler"
      described as {
        |Delivers each Ad event to all of its consumers.
      }
    }
  } with {
    briefly "Ad event fan-out"
    described as {
      |Fans Ad events out to the repository and projectors.
    }
  }
  connector 'AdEvent Stream' is from outlet AdContext.Advertisement.AdEvents2 to inlet AdContext.AdEventSplit.AdEventSplitIn with {
    briefly "Ad events, fanned out to storage and read models"
  }
  connector 'AdEvent Storage' is from outlet AdContext.AdEventSplit.AdEventSplitToAdRepository to inlet AdContext.AdRepository.AdRepositoryFromAd with {
    briefly "Ad events on their way to storage"
  }
  connector 'AdPerformance Feed' is from outlet AdContext.AdEventSplit.AdEventSplitToAdPerformance to inlet AdContext.AdPerformance.AdPerformanceFromAd with {
    briefly "Ad events feeding the AdPerformance projection"
  }
  connector 'AdPerformance Storage' is from outlet AdContext.AdPerformance.AdPerformanceOut to inlet AdContext.AdRepository.AdRepositoryFromAdPerformance with {
    briefly "The AdPerformance projection on its way to storage"
  }
} with {
  briefly "Bounded context for ad serving"
  described as {
    |Digital advertising delivery context.
  }
}
