// Ad Serving - Ad Context
context AdContext is {
  adaptor FromAdExchange from context AdExchange is { 
    handler FromAdExchangeHandler is {
      on result AdExchange.BidRequest is {
        do "the model receives bid request"
      }
      on event AdExchange.BidWon is {
        do "the model receives bid won"
      }
      on other is {
        error "Unexpected message for adaptor FromAdExchange"
      }
    } with {
      briefly "from ad exchange"
      described as {
        |Carries messages from the external AdExchange.
      }
    }
  } with {
    briefly "AdExchange integration"
    described as {
      |The model's side of the AdExchange conversation.
    }
  }
  adaptor ToAdExchange to context AdExchange is { 
    handler ToAdExchangeHandler is {
      on query AdExchange.GetBidRequest is {
        do "the model sends get bid request"
      }
      on command AdExchange.SubmitBid is {
        do "the model sends submit bid"
      }
      on other is {
        error "Unexpected message for adaptor ToAdExchange"
      }
    } with {
      briefly "to ad exchange"
      described as {
        |Carries messages to the external AdExchange.
      }
    }
  } with {
    briefly "AdExchange integration"
    described as {
      |The model's side of the AdExchange conversation.
    }
  }
  adaptor FromAdVerification from context AdVerification is { 
    handler FromAdVerificationHandler is {
      on result AdVerification.VerificationResult is {
        do "the model receives verification result"
      }
      on other is {
        error "Unexpected message for adaptor FromAdVerification"
      }
    } with {
      briefly "from ad verification"
      described as {
        |Carries messages from the external AdVerification.
      }
    }
  } with {
    briefly "AdVerification integration"
    described as {
      |The model's side of the AdVerification conversation.
    }
  }
  adaptor ToAdVerification to context AdVerification is { 
    handler ToAdVerificationHandler is {
      on query AdVerification.GetVerification is {
        do "the model sends get verification"
      }
      on command AdVerification.VerifyImpression is {
        do "the model sends verify impression"
      }
      on other is {
        error "Unexpected message for adaptor ToAdVerification"
      }
    } with {
      briefly "to ad verification"
      described as {
        |Carries messages to the external AdVerification.
      }
    }
  } with {
    briefly "AdVerification integration"
    described as {
      |The model's side of the AdVerification conversation.
    }
  }
  adaptor FromCDN from context CDN is { 
    handler FromCDNHandler is {
      on event CDN.CreativeCached is {
        do "the model receives creative cached"
      }
      on other is {
        error "Unexpected message for adaptor FromCDN"
      }
    } with {
      briefly "from cdn"
      described as {
        |Carries messages from the external CDN.
      }
    }
  } with {
    briefly "CDN integration"
    described as {
      |The model's side of the CDN conversation.
    }
  }
  adaptor ToCDN to context CDN is { 
    handler ToCDNHandler is {
      on command CDN.CacheCreative is {
        do "the model sends cache creative"
      }
      on command CDN.PurgeCreative is {
        do "the model sends purge creative"
      }
      on other is {
        error "Unexpected message for adaptor ToCDN"
      }
    } with {
      briefly "to cdn"
      described as {
        |Carries messages to the external CDN.
      }
    }
  } with {
    briefly "CDN integration"
    described as {
      |The model's side of the CDN conversation.
    }
  }
  adaptor FromDataManagementPlatform from context DataManagementPlatform is { 
    handler FromDataManagementPlatformHandler is {
      on result DataManagementPlatform.AudienceSegments is {
        do "the model receives audience segments"
      }
      on other is {
        error "Unexpected message for adaptor FromDataManagementPlatform"
      }
    } with {
      briefly "from data management platform"
      described as {
        |Carries messages from the external DataManagementPlatform.
      }
    }
  } with {
    briefly "DataManagementPlatform integration"
    described as {
      |The model's side of the DataManagementPlatform conversation.
    }
  }
  adaptor ToDataManagementPlatform to context DataManagementPlatform is { 
    handler ToDataManagementPlatformHandler is {
      on query DataManagementPlatform.GetAudienceSegments is {
        do "the model sends get audience segments"
      }
      on command DataManagementPlatform.SyncConversion is {
        do "the model sends sync conversion"
      }
      on other is {
        error "Unexpected message for adaptor ToDataManagementPlatform"
      }
    } with {
      briefly "to data management platform"
      described as {
        |Carries messages to the external DataManagementPlatform.
      }
    }
  } with {
    briefly "DataManagementPlatform integration"
    described as {
      |The model's side of the DataManagementPlatform conversation.
    }
  }
  include "types.riddl"
  include "Advertisement.riddl"
  repository AdRepository as merge is {
    inlet AdRepositoryFromAd is type AdEvent    inlet AdRepositoryFromAdPerformance is type AdEvent    outlet AdRepositoryResponses is type Advertisement.AdResult
    record StoredAd is  {
      adId: AdId with {
        briefly "adId"
        described as {
          |The adId column of the stored ad row.
        }
      }
      campaignId: CampaignId with {
        briefly "campaignId"
        described as {
          |The campaignId column of the stored ad row.
        }
      }
      status: AdStatus with {
        briefly "status"
        described as {
          |The status column of the stored ad row.
        }
      }
    } with {
      briefly "Stored ad row"
      described as {
        |The persistence shape of ad data as this repository stores it.
      }
    }
    schema AdData is relational
      of ads as type StoredAd
        index on field StoredAd.adId
        index on field StoredAd.campaignId
        index on field StoredAd.status
 with {
      briefly "Ad data schema"
      described as {
        |The relational schema holding ad data for the AdRepository.
      }
    }
    handler AdPersistence is {
      on query GetCampaignPerformance is {
        do "read the campaign performance projection"
        yield result CampaignPerformanceView
      }
      on command Advertisement.CreateAd is {
        tell event Advertisement.AdCreated to entity AdContext.Advertisement
        do "Store new ad record"
      }
      on command Advertisement.UpdateTargeting is {
        tell event Advertisement.TargetingUpdated to entity AdContext.Advertisement
        do "Update ad targeting"
      }
      on command Advertisement.ActivateAd is {
        do "Update ad to active"
      }
      on command Advertisement.RecordImpression is {
        tell event Advertisement.ImpressionRecorded to entity AdContext.Advertisement
        do "Store impression and update stats"
      }
      on command Advertisement.RecordClick is {
        tell event Advertisement.ClickRecorded to entity AdContext.Advertisement
        do "Store click and update stats"
      }
      on command Advertisement.CompleteAd is {
        tell event Advertisement.AdCompleted to entity AdContext.Advertisement
        do "Update ad to completed"
      }
    } with {
      briefly "Persists ad commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad data persistence"
    described as {
      |Persistent storage for ads.
    }
  }
  query GetCampaignPerformance is  {
    campaignPerformanceKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which campaign performance to retrieve.
      }
    }
  } with {
    briefly "Get campaign performance"
    described as {
      |Retrieves the campaign performance projection.
    }
  }
  result CampaignPerformanceView is  {
    campaignPerformance: AdPerformance.CampaignPerformance with {
      briefly "Campaign performance"
      described as {
        |The campaign performance being returned.
      }
    }
  } with {
    briefly "Campaign performance view"
    described as {
      |Read model view carrying the campaign performance projection.
    }
  }
  projector AdPerformance as flow is {
    updates repository AdContext.AdRepository
    inlet AdPerformanceFromAd is type AdEvent    outlet AdPerformanceOut is type AdEvent
    record CampaignPerformance is  {
      campaignId: CampaignId with {
        briefly "Campaign"
        described as {
          |Campaign ID.
        }
      }
      totalImpressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions.
        }
      }
      totalClicks: Natural with {
        briefly "Clicks"
        described as {
          |Total clicks.
        }
      }
      totalSpend: Decimal(15,2) with {
        briefly "Spend"
        described as {
          |Total spend.
        }
      }
      ctr: Decimal(8,6) with {
        briefly "CTR"
        described as {
          |Click-through rate.
        }
      }
      avgEcpm: Decimal(10,4) with {
        briefly "eCPM"
        described as {
          |Avg eCPM.
        }
      }
    } with {
      briefly "Campaign performance"
      described as {
        |Campaign delivery performance.
      }
    }
    handler PerformanceHandler is {
      on event Advertisement.ImpressionRecorded is {
        tell event Advertisement.ImpressionRecorded to repository AdContext.AdRepository
        do "Aggregate impressions by campaign"
      }
      on event Advertisement.ClickRecorded is {
        tell event Advertisement.ClickRecorded to repository AdContext.AdRepository
        do "Calculate CTR by campaign"
      }
    } with {
      briefly "Maintains performance metrics"
      described as {
        |Projects events into performance.
      }
    }
  } with {
    briefly "Ad performance"
    described as {
      |Ad delivery analytics.
    }
  }
  // ---- Event publication for Ad ----
  type AdEvent is one of {
    AdContext.Advertisement.AdCreated or AdContext.Advertisement.TargetingUpdated or AdContext.Advertisement.BidUpdated or AdContext.Advertisement.AdActivated or AdContext.Advertisement.AdPaused or AdContext.Advertisement.ImpressionRecorded or AdContext.Advertisement.ClickRecorded or AdContext.Advertisement.AdCompleted or AdContext.Advertisement.AdArchived
  } with {
    briefly "Ad event alternation"
    described as {
      |Union of all Ad events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AdEventSource as source is {
    outlet AdEvents is type AdEvent
    handler AdSourceHandler is {
      on event Advertisement.AdCreated is {
        send event Advertisement.AdCreated to outlet AdEvents
      }
      on event Advertisement.TargetingUpdated is {
        send event Advertisement.TargetingUpdated to outlet AdEvents
      }
      on event Advertisement.BidUpdated is {
        send event Advertisement.BidUpdated to outlet AdEvents
      }
      on event Advertisement.AdActivated is {
        send event Advertisement.AdActivated to outlet AdEvents
      }
      on event Advertisement.AdPaused is {
        send event Advertisement.AdPaused to outlet AdEvents
      }
      on event Advertisement.ImpressionRecorded is {
        send event Advertisement.ImpressionRecorded to outlet AdEvents
      }
      on event Advertisement.ClickRecorded is {
        send event Advertisement.ClickRecorded to outlet AdEvents
      }
      on event Advertisement.AdCompleted is {
        send event Advertisement.AdCompleted to outlet AdEvents
      }
      on event Advertisement.AdArchived is {
        send event Advertisement.AdArchived to outlet AdEvents
      }
      on other is {
        error "Unexpected message for source AdEventSource"
      }
    } with {
      briefly "Ad source handler"
      described as {
        |Publishes Ad events onto the outlet.
      }
    }
  } with {
    briefly "Ad event source"
    described as {
      |Publishes Ad entity events into the streaming topology.
    }
  }
  processor AdEventSink as sink is {
    inlet AdInlet is type AdEvent    handler AdSinkHandler is {
      on event Advertisement.AdCreated is {
        tell event Advertisement.AdCreated to repository AdContext.AdRepository
      }
      on event Advertisement.TargetingUpdated is {
        tell event Advertisement.TargetingUpdated to repository AdContext.AdRepository
      }
      on event Advertisement.BidUpdated is {
        tell event Advertisement.BidUpdated to repository AdContext.AdRepository
      }
      on event Advertisement.AdActivated is {
        tell event Advertisement.AdActivated to repository AdContext.AdRepository
      }
      on event Advertisement.AdPaused is {
        tell event Advertisement.AdPaused to repository AdContext.AdRepository
      }
      on event Advertisement.ImpressionRecorded is {
        tell event Advertisement.ImpressionRecorded to repository AdContext.AdRepository
      }
      on event Advertisement.ClickRecorded is {
        tell event Advertisement.ClickRecorded to repository AdContext.AdRepository
      }
      on event Advertisement.AdCompleted is {
        tell event Advertisement.AdCompleted to repository AdContext.AdRepository
      }
      on event Advertisement.AdArchived is {
        tell event Advertisement.AdArchived to repository AdContext.AdRepository
      }
      on other is {
        error "Unexpected message for sink AdEventSink"
      }
    } with {
      briefly "Ad sink handler"
      described as {
        |Persists Ad events via the repository.
      }
    }
  } with {
    briefly "Ad event sink"
    described as {
      |Receives Ad events for persistence.
    }
  }
  connector AdEventFlow is from outlet AdContext.AdEventSource.AdEvents to inlet AdContext.AdEventSink.AdInlet with {
    briefly "Ad event flow"
    described as {
      |Connects the Ad source to its sink.
    }
  }
  processor AdEventSplit as split is {
    inlet AdEventSplitIn is type AdEvent    outlet AdEventSplitToAdRepository is type AdEvent
    outlet AdEventSplitToAdPerformance is type AdEvent
    handler AdEventSplitHandler is {
      on event Advertisement.AdCreated is {
        send event Advertisement.AdCreated to outlet AdEventSplitToAdRepository
        send event Advertisement.AdCreated to outlet AdEventSplitToAdPerformance
        tell event Advertisement.AdCreated to entity AdContext.Advertisement
      }
      on event Advertisement.TargetingUpdated is {
        send event Advertisement.TargetingUpdated to outlet AdEventSplitToAdRepository
        send event Advertisement.TargetingUpdated to outlet AdEventSplitToAdPerformance
        tell event Advertisement.TargetingUpdated to entity AdContext.Advertisement
      }
      on event Advertisement.BidUpdated is {
        send event Advertisement.BidUpdated to outlet AdEventSplitToAdRepository
        send event Advertisement.BidUpdated to outlet AdEventSplitToAdPerformance
        tell event Advertisement.BidUpdated to entity AdContext.Advertisement
      }
      on event Advertisement.AdActivated is {
        send event Advertisement.AdActivated to outlet AdEventSplitToAdRepository
        send event Advertisement.AdActivated to outlet AdEventSplitToAdPerformance
        tell event Advertisement.AdActivated to entity AdContext.Advertisement
      }
      on event Advertisement.AdPaused is {
        send event Advertisement.AdPaused to outlet AdEventSplitToAdRepository
        send event Advertisement.AdPaused to outlet AdEventSplitToAdPerformance
        tell event Advertisement.AdPaused to entity AdContext.Advertisement
      }
      on event Advertisement.ImpressionRecorded is {
        send event Advertisement.ImpressionRecorded to outlet AdEventSplitToAdRepository
        send event Advertisement.ImpressionRecorded to outlet AdEventSplitToAdPerformance
        tell event Advertisement.ImpressionRecorded to entity AdContext.Advertisement
      }
      on event Advertisement.ClickRecorded is {
        send event Advertisement.ClickRecorded to outlet AdEventSplitToAdRepository
        send event Advertisement.ClickRecorded to outlet AdEventSplitToAdPerformance
        tell event Advertisement.ClickRecorded to entity AdContext.Advertisement
      }
      on event Advertisement.AdCompleted is {
        send event Advertisement.AdCompleted to outlet AdEventSplitToAdRepository
        send event Advertisement.AdCompleted to outlet AdEventSplitToAdPerformance
        tell event Advertisement.AdCompleted to entity AdContext.Advertisement
      }
      on event Advertisement.AdArchived is {
        send event Advertisement.AdArchived to outlet AdEventSplitToAdRepository
        send event Advertisement.AdArchived to outlet AdEventSplitToAdPerformance
        tell event Advertisement.AdArchived to entity AdContext.Advertisement
      }
      on other is {
        error "Unexpected message for processor AdEventSplit"
      }
    } with {
      briefly "Ad event fan-out handler"
      described as {
        |Delivers each Ad event to all of its consumers.
      }
    }
  } with {
    briefly "Ad event fan-out"
    described as {
      |Fans Ad events out to the repository and projectors.
    }
  }
  connector 'AdEvent Stream' is from outlet AdContext.Advertisement.AdEvents2 to inlet AdContext.AdEventSplit.AdEventSplitIn with {
    briefly "Ad events, fanned out to storage and read models"
  }
  connector 'AdEvent Storage' is from outlet AdContext.AdEventSplit.AdEventSplitToAdRepository to inlet AdContext.AdRepository.AdRepositoryFromAd with {
    briefly "Ad events on their way to storage"
  }
  connector 'AdPerformance Feed' is from outlet AdContext.AdEventSplit.AdEventSplitToAdPerformance to inlet AdContext.AdPerformance.AdPerformanceFromAd with {
    briefly "Ad events feeding the AdPerformance projection"
  }
  connector 'AdPerformance Storage' is from outlet AdContext.AdPerformance.AdPerformanceOut to inlet AdContext.AdRepository.AdRepositoryFromAdPerformance with {
    briefly "The AdPerformance projection on its way to storage"
  }
} with {
  briefly "Bounded context for ad serving"
  described as {
    |Digital advertising delivery context.
  }
}
