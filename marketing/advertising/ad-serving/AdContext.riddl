// Ad Serving - Ad Context
context AdContext is {
  include "types.riddl"
  include "Ad.riddl"
  repository AdRepository is {
    schema AdData is relational
      of ads as type Ad
        index on field Ad.adId
        index on field Ad.campaignId
        index on field Ad.status

    handler AdPersistence is {
      on command Ad.CreateAd is {
        tell event Ad.AdCreated to entity AdContext.Ad
        prompt "Store new ad record"
      }
      on command Ad.UpdateTargeting is {
        tell event Ad.TargetingUpdated to entity AdContext.Ad
        prompt "Update ad targeting"
      }
      on command Ad.ActivateAd is {
        prompt "Update ad to active"
      }
      on command Ad.RecordImpression is {
        tell event Ad.ImpressionRecorded to entity AdContext.Ad
        prompt "Store impression and update stats"
      }
      on command Ad.RecordClick is {
        tell event Ad.ClickRecorded to entity AdContext.Ad
        prompt "Store click and update stats"
      }
      on command Ad.CompleteAd is {
        tell event Ad.AdCompleted to entity AdContext.Ad
        prompt "Update ad to completed"
      }
    } with {
      briefly "Persists ad commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad data persistence"
    described as {
      |Persistent storage for ads.
    }
  }
  projector AdPerformance is {
    updates repository AdContext.AdRepository
    record CampaignPerformance is  {
      campaignId: CampaignId with {
        briefly "Campaign"
        described as {
          |Campaign ID.
        }
      }
      totalImpressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions.
        }
      }
      totalClicks: Natural with {
        briefly "Clicks"
        described as {
          |Total clicks.
        }
      }
      totalSpend: Decimal(15,2) with {
        briefly "Spend"
        described as {
          |Total spend.
        }
      }
      ctr: Decimal(8,6) with {
        briefly "CTR"
        described as {
          |Click-through rate.
        }
      }
      avgEcpm: Decimal(10,4) with {
        briefly "eCPM"
        described as {
          |Avg eCPM.
        }
      }
    } with {
      briefly "Campaign performance"
      described as {
        |Campaign delivery performance.
      }
    }
    handler PerformanceHandler is {
      on event Ad.ImpressionRecorded is {
        tell event Ad.ImpressionRecorded to repository AdContext.AdRepository
        prompt "Aggregate impressions by campaign"
      }
      on event Ad.ClickRecorded is {
        tell event Ad.ClickRecorded to repository AdContext.AdRepository
        prompt "Calculate CTR by campaign"
      }
    } with {
      briefly "Maintains performance metrics"
      described as {
        |Projects events into performance.
      }
    }
  } with {
    briefly "Ad performance"
    described as {
      |Ad delivery analytics.
    }
  }
  // ---- Event publication for Ad ----
  type AdEvent is one of {
    AdContext.Ad.AdCreated,
    AdContext.Ad.TargetingUpdated,
    AdContext.Ad.BidUpdated,
    AdContext.Ad.AdActivated,
    AdContext.Ad.AdPaused,
    AdContext.Ad.ImpressionRecorded,
    AdContext.Ad.ClickRecorded,
    AdContext.Ad.AdCompleted,
    AdContext.Ad.AdArchived
  } with {
    briefly "Ad event alternation"
    described as {
      |Union of all Ad events, for streaming and event-sourced
      |persistence.
    }
  }
  source AdEventSource is {
    outlet AdEvents is type AdEvent
    handler AdSourceHandler is {
      on event Ad.AdCreated is {
        send event Ad.AdCreated to outlet AdEvents
      }
      on event Ad.TargetingUpdated is {
        send event Ad.TargetingUpdated to outlet AdEvents
      }
      on event Ad.BidUpdated is {
        send event Ad.BidUpdated to outlet AdEvents
      }
      on event Ad.AdActivated is {
        send event Ad.AdActivated to outlet AdEvents
      }
      on event Ad.AdPaused is {
        send event Ad.AdPaused to outlet AdEvents
      }
      on event Ad.ImpressionRecorded is {
        send event Ad.ImpressionRecorded to outlet AdEvents
      }
      on event Ad.ClickRecorded is {
        send event Ad.ClickRecorded to outlet AdEvents
      }
      on event Ad.AdCompleted is {
        send event Ad.AdCompleted to outlet AdEvents
      }
      on event Ad.AdArchived is {
        send event Ad.AdArchived to outlet AdEvents
      }
      on other is {
        error "Unexpected message for source AdEventSource"
      }
    } with {
      briefly "Ad source handler"
      described as {
        |Publishes Ad events onto the outlet.
      }
    }
  } with {
    briefly "Ad event source"
    described as {
      |Publishes Ad entity events into the streaming topology.
    }
  }
  sink AdEventSink is {
    inlet AdInlet is type AdEvent
    handler AdSinkHandler is {
      on event Ad.AdCreated is {
        tell event Ad.AdCreated to repository AdContext.AdRepository
      }
      on event Ad.TargetingUpdated is {
        tell event Ad.TargetingUpdated to repository AdContext.AdRepository
      }
      on event Ad.BidUpdated is {
        tell event Ad.BidUpdated to repository AdContext.AdRepository
      }
      on event Ad.AdActivated is {
        tell event Ad.AdActivated to repository AdContext.AdRepository
      }
      on event Ad.AdPaused is {
        tell event Ad.AdPaused to repository AdContext.AdRepository
      }
      on event Ad.ImpressionRecorded is {
        tell event Ad.ImpressionRecorded to repository AdContext.AdRepository
      }
      on event Ad.ClickRecorded is {
        tell event Ad.ClickRecorded to repository AdContext.AdRepository
      }
      on event Ad.AdCompleted is {
        tell event Ad.AdCompleted to repository AdContext.AdRepository
      }
      on event Ad.AdArchived is {
        tell event Ad.AdArchived to repository AdContext.AdRepository
      }
      on other is {
        error "Unexpected message for sink AdEventSink"
      }
    } with {
      briefly "Ad sink handler"
      described as {
        |Persists Ad events via the repository.
      }
    }
  } with {
    briefly "Ad event sink"
    described as {
      |Receives Ad events for persistence.
    }
  }
  connector AdEventFlow is {
    from outlet AdContext.AdEventSource.AdEvents to
      inlet AdContext.AdEventSink.AdInlet
  } with {
    briefly "Ad event flow"
    described as {
      |Connects the Ad source to its sink.
    }
  }
} with {
  briefly "Bounded context for ad serving"
  described as {
    |Digital advertising delivery context.
  }
}
