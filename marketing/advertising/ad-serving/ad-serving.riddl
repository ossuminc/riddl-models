// Ad Serving Domain Model
// Digital advertising delivery and targeting
domain AdServing is {
  persistent connector 'ClickTrackerEvent Stream' is from outlet ClickTracker.ClickTrackerEventsOut to inlet AdContext.FromClickTracker.FromClickTrackerIn with {
    briefly "What ClickTracker tells AdContext, unasked"
  }
  persistent connector 'DataManagementPlatformReply Stream' is from outlet DataManagementPlatform.DataManagementPlatformRepliesOut to inlet AdContext.ToDataManagementPlatform.ToDataManagementPlatformReplies with {
    briefly "What DataManagementPlatform answers AdContext"
  }
  persistent connector 'AdVerificationReply Stream' is from outlet AdVerification.AdVerificationRepliesOut to inlet AdContext.ToAdVerification.ToAdVerificationReplies with {
    briefly "What AdVerification answers AdContext"
  }
  persistent connector 'AdExchangeReply Stream' is from outlet AdExchange.AdExchangeRepliesOut to inlet AdContext.ToAdExchange.ToAdExchangeReplies with {
    briefly "What AdExchange answers AdContext"
  }
  persistent connector 'AdExchangeEvent Stream' is from outlet AdExchange.AdExchangeEventsOut to inlet AdContext.FromAdExchange.FromAdExchangeIn with {
    briefly "What AdExchange tells AdContext, unasked"
  }
  persistent connector 'CDNEvent Stream' is from outlet CDN.CDNEventsOut to inlet AdContext.FromCDN.FromCDNIn with {
    briefly "What CDN tells AdContext, unasked"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user AdOpsManager is "person managing ad operations" with {
    briefly "Ad Ops Manager"
    described as {
      |Manager overseeing ad delivery.
    }
  }
  user CampaignPlanner is "person planning ad campaigns" with {
    briefly "Campaign Planner"
    described as {
      |Planner defining ad strategy.
    }
  }
  user TrafficManager is "person managing ad traffic" with {
    briefly "Traffic Manager"
    described as {
      |Manager routing ad inventory.
    }
  }
  epic AdDeliveryManagement is {
    user AdOpsManager wants to "to deliver ads effectively" so that "campaigns achieve their goals"
    case ServeTargetedAds is {
      user AdOpsManager wants to "to serve targeted ads" so that "relevant ads reach the right audience"
      step is "System evaluates" "targeting criteria" "for requests" with {
        briefly "Evaluate targeting"
        described as {
          |Match audience.
        }
      }
      step is "System selects" "best ad" "for impression" with {
        briefly "Select ad"
        described as {
          |Choose optimal ad.
        }
      }
    } with {
      briefly "Serve targeted ads"
      described as {
        |Delivering personalized ads.
      }
    }
  } with {
    briefly "Ad delivery management"
    described as {
      |Epic for ad serving.
    }
  }
  include "AdContext.riddl"
  include "external-contexts.riddl"
  application context AdServingApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AdServing are delivered.
      }
    }
    group AdServingScreen is {
      input GetCampaignPerformanceInput acquires query AdContext.GetCampaignPerformance with {
        briefly "Get campaign performance control"
        described as {
          |The control through which a user asks the get campaign performance question.
        }
      }
      input GetAdInput acquires query AdContext.Advertisement.GetAd with {
        briefly "Get ad control"
        described as {
          |The control through which a user asks the get ad question.
        }
      }
      input ActivateAdInput acquires command AdContext.Advertisement.ActivateAd with {
        briefly "Activate ad control"
        described as {
          |The control through which a user submits the activate ad request.
        }
      }
      input ArchiveAdInput acquires command AdContext.Advertisement.ArchiveAd with {
        briefly "Archive ad control"
        described as {
          |The control through which a user submits the archive ad request.
        }
      }
      input CompleteAdInput acquires command AdContext.Advertisement.CompleteAd with {
        briefly "Complete ad control"
        described as {
          |The control through which a user submits the complete ad request.
        }
      }
      input PauseAdInput acquires command AdContext.Advertisement.PauseAd with {
        briefly "Pause ad control"
        described as {
          |The control through which a user submits the pause ad request.
        }
      }
      input CreateAdInput acquires command AdContext.CreateAd with {
        briefly "Create ad control"
        described as {
          |The control through which a user submits the create ad request.
        }
      }
    } with {
      briefly "Ad serving screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppAdRepositoryQueries is query AdContext.GetCampaignPerformance
    inlet AppAdRepositoryReplies is result AdContext.CampaignPerformanceView
    outlet AppAdvertisementQueries is query AdContext.Advertisement.GetAd
    outlet AppAdCommands is type AdContext.AdvertisementRequest
    inlet AppAdRepositoryResponses is result AdContext.Advertisement.AdResult
    handler AdServingAppHandler is {
      on other is {
        error "Unexpected message for application context AdServingApp"
      }
    } with {
      briefly "AdServingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AdServingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AdExchangeRequest Stream' is from outlet AdContext.ToAdExchange.ToAdExchangeOut to inlet AdExchange.AdExchangeRequests with {
    briefly "What AdContext asks AdExchange to send"
  }
  persistent connector 'DataManagementPlatformRequest Stream' is from outlet AdContext.ToDataManagementPlatform.ToDataManagementPlatformOut to inlet DataManagementPlatform.DataManagementPlatformRequests with {
    briefly "What AdContext asks DataManagementPlatform to send"
  }
  persistent connector 'CDNRequest Stream' is from outlet AdContext.ToCDN.ToCDNOut to inlet CDN.CDNRequests with {
    briefly "What AdContext asks CDN to send"
  }
  persistent connector 'AdVerificationRequest Stream' is from outlet AdContext.ToAdVerification.ToAdVerificationOut to inlet AdVerification.AdVerificationRequests with {
    briefly "What AdContext asks AdVerification to send"
  }
  persistent connector 'AdRepositoryQuery Stream' is from outlet AdServingApp.AppAdRepositoryQueries to inlet AdContext.AdRepositoryQueriesIn with {
    briefly "AdServingApp's look-ups of the ad repository"
  }
  persistent connector 'AdRepositoryReply Stream' is from outlet AdContext.AdRepositoryRepliesOut to inlet AdServingApp.AppAdRepositoryReplies with {
    briefly "The ad repository's answers returned to AdServingApp"
  }
  persistent connector 'AdvertisementQuery Stream' is from outlet AdServingApp.AppAdvertisementQueries to inlet AdContext.AdvertisementQueriesIn with {
    briefly "AdServingApp's look-ups of the advertisement"
  }
  persistent connector 'AdCommand Stream' is from outlet AdServingApp.AppAdCommands to inlet AdContext.AdCommandStreamIn with {
    briefly "Ad commands from the application"
  }
  persistent connector 'AdImpressionResult Stream' is from outlet AdContext.AdImpressionResultStreamOut to inlet AdServingApp.AppAdRepositoryResponses with {
    briefly "Ad query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AdServingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term TargetingCriteria is "The rules evaluated against ad requests to decide eligibility."
  term Impression is "A single ad shown to a viewer, selected as the best match."
  briefly "Ad serving domain"
  described as {
    |Digital advertising delivery.
  }
}
