// Ad Serving Domain Model
// Digital advertising delivery and targeting
domain AdServing is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user AdOpsManager is "person managing ad operations" with {
    briefly "Ad Ops Manager"
    described as {
      |Manager overseeing ad delivery.
    }
  }
  user CampaignPlanner is "person planning ad campaigns" with {
    briefly "Campaign Planner"
    described as {
      |Planner defining ad strategy.
    }
  }
  user TrafficManager is "person managing ad traffic" with {
    briefly "Traffic Manager"
    described as {
      |Manager routing ad inventory.
    }
  }
  epic AdDeliveryManagement is {
    user AdOpsManager wants to "to deliver ads effectively" so that "campaigns achieve their goals"
    case ServeTargetedAds is {
      user AdOpsManager wants to "to serve targeted ads" so that "relevant ads reach the right audience"
      step is "System evaluates" "targeting criteria" "for requests" with {
        briefly "Evaluate targeting"
        described as {
          |Match audience.
        }
      }
      step is "System selects" "best ad" "for impression" with {
        briefly "Select ad"
        described as {
          |Choose optimal ad.
        }
      }
    } with {
      briefly "Serve targeted ads"
      described as {
        |Delivering personalized ads.
      }
    }
  } with {
    briefly "Ad delivery management"
    described as {
      |Epic for ad serving.
    }
  }
  include "AdContext.riddl"
  include "external-contexts.riddl"
  application context AdServingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in AdServing are delivered.
      }
    }
    outlet AppAdCommands is type AdContext.Advertisement.AdCommand
    inlet AppAdRepositoryResponses is result AdContext.Advertisement.AdResult    handler AdServingAppHandler is {
      on other is {
        error "Unexpected message for application context AdServingApp"
      }
    } with {
      briefly "AdServingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "AdServingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'AdCommand Stream' is from outlet AdServingApp.AppAdCommands to inlet AdContext.AdCommandStreamIn with {
    briefly "Ad commands from the application"
  }
  persistent connector 'AdImpressionResult Stream' is from outlet AdContext.AdImpressionResultStreamOut to inlet AdServingApp.AppAdRepositoryResponses with {
    briefly "Ad query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet AdServingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term TargetingCriteria is  "The rules evaluated against ad requests to decide eligibility." 
  term Impression is  "A single ad shown to a viewer, selected as the best match." 
  briefly "Ad serving domain"
  described as {
    |Digital advertising delivery.
  }
}
