// Ad Operations - AdOps Context
context AdOpsContext is {
  adaptor FromAdExchange from context AdExchange is { 
    handler FromAdExchangeHandler is {
      on event AdExchange.AdRequestAccepted is {
        do "the model receives ad request accepted"
      }
      on result AdExchange.BidResults is {
        do "the model receives bid results"
      }
      on other is {
        error "Unexpected message for adaptor FromAdExchange"
      }
    } with {
      briefly "from ad exchange"
      described as {
        |Carries messages from the external AdExchange.
      }
    }
  } with {
    briefly "AdExchange integration"
    described as {
      |The model's side of the AdExchange conversation.
    }
  }
  adaptor ToAdExchange to context AdExchange is { 
    handler ToAdExchangeHandler is {
      on query AdExchange.GetBidResults is {
        do "the model sends get bid results"
      }
      on command AdExchange.SubmitAdRequest is {
        do "the model sends submit ad request"
      }
      on other is {
        error "Unexpected message for adaptor ToAdExchange"
      }
    } with {
      briefly "to ad exchange"
      described as {
        |Carries messages to the external AdExchange.
      }
    }
  } with {
    briefly "AdExchange integration"
    described as {
      |The model's side of the AdExchange conversation.
    }
  }
  adaptor FromCreativeAssetStore from context CreativeAssetStore is { 
    handler FromCreativeAssetStoreHandler is {
      on result CreativeAssetStore.CreativeAssetResult is {
        do "the model receives creative asset result"
      }
      on event CreativeAssetStore.CreativeUploaded is {
        do "the model receives creative uploaded"
      }
      on other is {
        error "Unexpected message for adaptor FromCreativeAssetStore"
      }
    } with {
      briefly "from creative asset store"
      described as {
        |Carries messages from the external CreativeAssetStore.
      }
    }
  } with {
    briefly "CreativeAssetStore integration"
    described as {
      |The model's side of the CreativeAssetStore conversation.
    }
  }
  adaptor ToCreativeAssetStore to context CreativeAssetStore is { 
    handler ToCreativeAssetStoreHandler is {
      on query CreativeAssetStore.GetCreativeAsset is {
        do "the model sends get creative asset"
      }
      on command CreativeAssetStore.UploadCreative is {
        do "the model sends upload creative"
      }
      on other is {
        error "Unexpected message for adaptor ToCreativeAssetStore"
      }
    } with {
      briefly "to creative asset store"
      described as {
        |Carries messages to the external CreativeAssetStore.
      }
    }
  } with {
    briefly "CreativeAssetStore integration"
    described as {
      |The model's side of the CreativeAssetStore conversation.
    }
  }
  include "types.riddl"
  include "AdCampaign.riddl"
  repository AdOpsRepository as merge is {
    inlet AdOpsRepositoryFromAdCampaign is type AdCampaignEvent    inlet AdOpsRepositoryFromCampaignPerformance is type AdCampaignEvent    outlet AdOpsRepositoryResponses is type AdCampaign.AdCampaignResult
    record StoredAdCampaign is  {
      adCampaignId: AdCampaignId with {
        briefly "adCampaignId"
        described as {
          |The adCampaignId column of the stored adCampaign row.
        }
      }
      campaignId: AdCampaignId with {
        briefly "campaignId"
        described as {
          |The campaignId column of the stored adCampaign row.
        }
      }
      campaignInfo: CampaignInfo with {
        briefly "campaignInfo"
        described as {
          |The campaignInfo column of the stored adCampaign row.
        }
      }
      status: CampaignStatus with {
        briefly "status"
        described as {
          |The status column of the stored adCampaign row.
        }
      }
    } with {
      briefly "Stored adCampaign row"
      described as {
        |The persistence shape of adCampaign data as this repository stores it.
      }
    }
    schema AdOpsData is relational
      of adCampaigns as type StoredAdCampaign
        index on field StoredAdCampaign.campaignId
        index on field StoredAdCampaign.campaignInfo.advertiserId
        index on field StoredAdCampaign.status
 with {
      briefly "Ad ops data schema"
      described as {
        |The relational schema holding ad ops data for the AdOpsRepository.
      }
    }
    handler AdOpsPersistence is {
      on query GetCampaignMetrics is {
        let campaignMetricsView: CampaignMetricsView = prompt("read the campaign metrics projection")
        reply campaignMetricsView
      }
      on createCampaign: command AdCampaign.CreateCampaign is {
        tell event AdCampaign.CampaignCreated(campaignId = createCampaign.campaignId, campaignInfo = createCampaign.campaignInfo) to entity AdOpsContext.AdCampaign
        do "Store new ad campaign"
      }
      on approveCampaign: command AdCampaign.ApproveCampaign is {
        tell event AdCampaign.CampaignApproved(campaignId = approveCampaign.campaignId) to entity AdOpsContext.AdCampaign
        do "Update campaign to approved"
      }
      on command AdCampaign.AttachCreative is {
        do "Store creative attachment"
      }
      on schedulePlacement: command AdCampaign.SchedulePlacement is {
        tell event AdCampaign.PlacementScheduled(campaignId = schedulePlacement.campaignId) to entity AdOpsContext.AdCampaign
        do "Store placement schedule"
      }
      on command AdCampaign.LaunchCampaign is {
        do "Update campaign to live"
      }
      on recordPerformance: command AdCampaign.RecordPerformance is {
        tell event AdCampaign.PerformanceRecorded(campaignId = recordPerformance.campaignId, metric = recordPerformance.metric) to entity AdOpsContext.AdCampaign
        do "Store performance metrics"
      }
      on completeCampaign: command AdCampaign.CompleteCampaign is {
        tell event AdCampaign.CampaignCompleted(campaignId = completeCampaign.campaignId, completedAt = completeCampaign.completedAt) to entity AdOpsContext.AdCampaign
        do "Update campaign to completed"
      }
    } with {
      briefly "Persists ad ops events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad ops data persistence"
    described as {
      |Persistent storage for ad operations.
    }
  }
  query GetCampaignMetrics is  {
    campaignMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which campaign metrics to retrieve.
      }
    }
  } with {
    briefly "Get campaign metrics"
    described as {
      |Retrieves the campaign metrics projection.
    }
  }
  result CampaignMetricsView is  {
    campaignMetrics: CampaignPerformance.CampaignMetrics with {
      briefly "Campaign metrics"
      described as {
        |The campaign metrics being returned.
      }
    }
  } with {
    briefly "Campaign metrics view"
    described as {
      |Read model view carrying the campaign metrics projection.
    }
  }
  projector CampaignPerformance as flow is {
    updates repository AdOpsContext.AdOpsRepository
    inlet CampaignPerformanceFromAdCampaign is type AdCampaignEvent    outlet CampaignPerformanceOut is type AdCampaignEvent
    record CampaignMetrics is  {
      campaignsCreated: Natural with {
        briefly "Created"
        described as {
          |Campaigns created.
        }
      }
      campaignsLive: Natural with {
        briefly "Live"
        described as {
          |Campaigns currently live.
        }
      }
      campaignsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Campaigns completed.
        }
      }
      totalImpressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions served.
        }
      }
      totalClicks: Natural with {
        briefly "Clicks"
        described as {
          |Total clicks recorded.
        }
      }
      aggregateTotalSpend: Decimal(14,2) with {
        briefly "Spend"
        described as {
          |Total ad spend.
        }
      }
    } with {
      briefly "Campaign metrics"
      described as {
        |Aggregate campaign performance metrics.
      }
    }
    handler PerformanceHandler is {
      on campaignCreated: event AdCampaign.CampaignCreated is {
        tell campaignCreated to repository AdOpsContext.AdOpsRepository
        do "Increment campaigns created"
      }
      on campaignLaunched: event AdCampaign.CampaignLaunched is {
        tell campaignLaunched to repository AdOpsContext.AdOpsRepository
        do "Increment campaigns live"
      }
      on performanceRecorded: event AdCampaign.PerformanceRecorded is {
        tell performanceRecorded to repository AdOpsContext.AdOpsRepository
        do "Accumulate impressions clicks and spend"
      }
      on campaignCompleted: event AdCampaign.CampaignCompleted is {
        tell campaignCompleted to repository AdOpsContext.AdOpsRepository
        do "Decrement live and increment completed"
      }
    } with {
      briefly "Maintains campaign performance metrics"
      described as {
        |Projects events into performance analytics.
      }
    }
  } with {
    briefly "Campaign performance projector"
    described as {
      |Ad campaign performance analytics.
    }
  }
  // ---- Event publication for AdCampaign ----
  type AdCampaignEvent is one of {
    AdOpsContext.AdCampaign.CampaignCreated or AdOpsContext.AdCampaign.CampaignSubmitted or AdOpsContext.AdCampaign.CampaignApproved or AdOpsContext.AdCampaign.CreativeAttached or AdOpsContext.AdCampaign.PlacementScheduled or AdOpsContext.AdCampaign.CampaignLaunched or AdOpsContext.AdCampaign.PerformanceRecorded or AdOpsContext.AdCampaign.CampaignPaused or AdOpsContext.AdCampaign.CampaignCompleted or AdOpsContext.AdCampaign.CampaignCancelled or AdOpsContext.AdCampaign.InvoiceGenerated
  } with {
    briefly "AdCampaign event alternation"
    described as {
      |Union of all AdCampaign events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AdCampaignEventSource as source is {
    outlet AdCampaignEvents is type AdCampaignEvent
    handler AdCampaignSourceHandler is {
      on campaignCreated: event AdCampaign.CampaignCreated is {
        send campaignCreated to outlet AdCampaignEvents
      }
      on campaignSubmitted: event AdCampaign.CampaignSubmitted is {
        send campaignSubmitted to outlet AdCampaignEvents
      }
      on campaignApproved: event AdCampaign.CampaignApproved is {
        send campaignApproved to outlet AdCampaignEvents
      }
      on creativeAttached: event AdCampaign.CreativeAttached is {
        send creativeAttached to outlet AdCampaignEvents
      }
      on placementScheduled: event AdCampaign.PlacementScheduled is {
        send placementScheduled to outlet AdCampaignEvents
      }
      on campaignLaunched: event AdCampaign.CampaignLaunched is {
        send campaignLaunched to outlet AdCampaignEvents
      }
      on performanceRecorded: event AdCampaign.PerformanceRecorded is {
        send performanceRecorded to outlet AdCampaignEvents
      }
      on campaignPaused: event AdCampaign.CampaignPaused is {
        send campaignPaused to outlet AdCampaignEvents
      }
      on campaignCompleted: event AdCampaign.CampaignCompleted is {
        send campaignCompleted to outlet AdCampaignEvents
      }
      on campaignCancelled: event AdCampaign.CampaignCancelled is {
        send campaignCancelled to outlet AdCampaignEvents
      }
      on invoiceGenerated: event AdCampaign.InvoiceGenerated is {
        send invoiceGenerated to outlet AdCampaignEvents
      }
      on other is {
        error "Unexpected message for source AdCampaignEventSource"
      }
    } with {
      briefly "AdCampaign source handler"
      described as {
        |Publishes AdCampaign events onto the outlet.
      }
    }
  } with {
    briefly "AdCampaign event source"
    described as {
      |Publishes AdCampaign entity events into the streaming topology.
    }
  }
  processor AdCampaignEventSink as sink is {
    inlet AdCampaignInlet is type AdCampaignEvent    handler AdCampaignSinkHandler is {
      on campaignCreated: event AdCampaign.CampaignCreated is {
        tell campaignCreated to repository AdOpsContext.AdOpsRepository
      }
      on campaignSubmitted: event AdCampaign.CampaignSubmitted is {
        tell campaignSubmitted to repository AdOpsContext.AdOpsRepository
      }
      on campaignApproved: event AdCampaign.CampaignApproved is {
        tell campaignApproved to repository AdOpsContext.AdOpsRepository
      }
      on creativeAttached: event AdCampaign.CreativeAttached is {
        tell creativeAttached to repository AdOpsContext.AdOpsRepository
      }
      on placementScheduled: event AdCampaign.PlacementScheduled is {
        tell placementScheduled to repository AdOpsContext.AdOpsRepository
      }
      on campaignLaunched: event AdCampaign.CampaignLaunched is {
        tell campaignLaunched to repository AdOpsContext.AdOpsRepository
      }
      on performanceRecorded: event AdCampaign.PerformanceRecorded is {
        tell performanceRecorded to repository AdOpsContext.AdOpsRepository
      }
      on campaignPaused: event AdCampaign.CampaignPaused is {
        tell campaignPaused to repository AdOpsContext.AdOpsRepository
      }
      on campaignCompleted: event AdCampaign.CampaignCompleted is {
        tell campaignCompleted to repository AdOpsContext.AdOpsRepository
      }
      on campaignCancelled: event AdCampaign.CampaignCancelled is {
        tell campaignCancelled to repository AdOpsContext.AdOpsRepository
      }
      on invoiceGenerated: event AdCampaign.InvoiceGenerated is {
        tell invoiceGenerated to repository AdOpsContext.AdOpsRepository
      }
      on other is {
        error "Unexpected message for sink AdCampaignEventSink"
      }
    } with {
      briefly "AdCampaign sink handler"
      described as {
        |Persists AdCampaign events via the repository.
      }
    }
  } with {
    briefly "AdCampaign event sink"
    described as {
      |Receives AdCampaign events for persistence.
    }
  }
  connector AdCampaignEventFlow is from outlet AdOpsContext.AdCampaignEventSource.AdCampaignEvents to inlet AdOpsContext.AdCampaignEventSink.AdCampaignInlet with {
    briefly "AdCampaign event flow"
    described as {
      |Connects the AdCampaign source to its sink.
    }
  }
  processor AdCampaignEventSplit as split is {
    inlet AdCampaignEventSplitIn is type AdCampaignEvent    outlet AdCampaignEventSplitToAdOpsRepository is type AdCampaignEvent
    outlet AdCampaignEventSplitToCampaignPerformance is type AdCampaignEvent
    handler AdCampaignEventSplitHandler is {
      on campaignCreated: event AdCampaign.CampaignCreated is {
        send campaignCreated to outlet AdCampaignEventSplitToAdOpsRepository
        send campaignCreated to outlet AdCampaignEventSplitToCampaignPerformance
        tell campaignCreated to entity AdOpsContext.AdCampaign
      }
      on campaignSubmitted: event AdCampaign.CampaignSubmitted is {
        send campaignSubmitted to outlet AdCampaignEventSplitToAdOpsRepository
        send campaignSubmitted to outlet AdCampaignEventSplitToCampaignPerformance
        tell campaignSubmitted to entity AdOpsContext.AdCampaign
      }
      on campaignApproved: event AdCampaign.CampaignApproved is {
        send campaignApproved to outlet AdCampaignEventSplitToAdOpsRepository
        send campaignApproved to outlet AdCampaignEventSplitToCampaignPerformance
        tell campaignApproved to entity AdOpsContext.AdCampaign
      }
      on creativeAttached: event AdCampaign.CreativeAttached is {
        send creativeAttached to outlet AdCampaignEventSplitToAdOpsRepository
        send creativeAttached to outlet AdCampaignEventSplitToCampaignPerformance
        tell creativeAttached to entity AdOpsContext.AdCampaign
      }
      on placementScheduled: event AdCampaign.PlacementScheduled is {
        send placementScheduled to outlet AdCampaignEventSplitToAdOpsRepository
        send placementScheduled to outlet AdCampaignEventSplitToCampaignPerformance
        tell placementScheduled to entity AdOpsContext.AdCampaign
      }
      on campaignLaunched: event AdCampaign.CampaignLaunched is {
        send campaignLaunched to outlet AdCampaignEventSplitToAdOpsRepository
        send campaignLaunched to outlet AdCampaignEventSplitToCampaignPerformance
        tell campaignLaunched to entity AdOpsContext.AdCampaign
      }
      on performanceRecorded: event AdCampaign.PerformanceRecorded is {
        send performanceRecorded to outlet AdCampaignEventSplitToAdOpsRepository
        send performanceRecorded to outlet AdCampaignEventSplitToCampaignPerformance
        tell performanceRecorded to entity AdOpsContext.AdCampaign
      }
      on campaignPaused: event AdCampaign.CampaignPaused is {
        send campaignPaused to outlet AdCampaignEventSplitToAdOpsRepository
        send campaignPaused to outlet AdCampaignEventSplitToCampaignPerformance
        tell campaignPaused to entity AdOpsContext.AdCampaign
      }
      on campaignCompleted: event AdCampaign.CampaignCompleted is {
        send campaignCompleted to outlet AdCampaignEventSplitToAdOpsRepository
        send campaignCompleted to outlet AdCampaignEventSplitToCampaignPerformance
        tell campaignCompleted to entity AdOpsContext.AdCampaign
      }
      on campaignCancelled: event AdCampaign.CampaignCancelled is {
        send campaignCancelled to outlet AdCampaignEventSplitToAdOpsRepository
        send campaignCancelled to outlet AdCampaignEventSplitToCampaignPerformance
        tell campaignCancelled to entity AdOpsContext.AdCampaign
      }
      on invoiceGenerated: event AdCampaign.InvoiceGenerated is {
        send invoiceGenerated to outlet AdCampaignEventSplitToAdOpsRepository
        send invoiceGenerated to outlet AdCampaignEventSplitToCampaignPerformance
        tell invoiceGenerated to entity AdOpsContext.AdCampaign
      }
      on other is {
        error "Unexpected message for processor AdCampaignEventSplit"
      }
    } with {
      briefly "AdCampaign event fan-out handler"
      described as {
        |Delivers each AdCampaign event to all of its consumers.
      }
    }
  } with {
    briefly "AdCampaign event fan-out"
    described as {
      |Fans AdCampaign events out to the repository and projectors.
    }
  }
  connector 'AdCampaignEvent Stream' is from outlet AdOpsContext.AdCampaign.AdCampaignEvents2 to inlet AdOpsContext.AdCampaignEventSplit.AdCampaignEventSplitIn with {
    briefly "AdCampaign events, fanned out to storage and read models"
  }
  connector 'AdCampaignEvent Storage' is from outlet AdOpsContext.AdCampaignEventSplit.AdCampaignEventSplitToAdOpsRepository to inlet AdOpsContext.AdOpsRepository.AdOpsRepositoryFromAdCampaign with {
    briefly "AdCampaign events on their way to storage"
  }
  connector 'CampaignPerformance Feed' is from outlet AdOpsContext.AdCampaignEventSplit.AdCampaignEventSplitToCampaignPerformance to inlet AdOpsContext.CampaignPerformance.CampaignPerformanceFromAdCampaign with {
    briefly "AdCampaign events feeding the CampaignPerformance projection"
  }
  connector 'CampaignPerformance Storage' is from outlet AdOpsContext.CampaignPerformance.CampaignPerformanceOut to inlet AdOpsContext.AdOpsRepository.AdOpsRepositoryFromCampaignPerformance with {
    briefly "The CampaignPerformance projection on its way to storage"
  }
} with {
  briefly "Bounded context for ad operations"
  described as {
    |Ad operations bounded context for campaign trafficking and management.
  }
}
