// Ad Operations - AdOps Context
context AdOpsContext is {
  include "types.riddl"
  include "AdCampaign.riddl"
  repository AdOpsRepository is {
    inlet AdOpsRepositoryFromAdCampaign is type AdCampaignEvent
    inlet AdOpsRepositoryFromCampaignPerformance is type AdCampaignEvent
    outlet AdOpsRepositoryResponses is type AdCampaign.AdCampaignResult
    schema AdOpsData is relational
      of adCampaigns as type AdCampaign
        index on field AdCampaign.campaignId
        index on field AdCampaign.campaignInfo.advertiserId
        index on field AdCampaign.status

    handler AdOpsPersistence is {
      on command AdCampaign.CreateCampaign is {
        tell event AdCampaign.CampaignCreated to entity AdOpsContext.AdCampaign
        do "Store new ad campaign"
      }
      on command AdCampaign.ApproveCampaign is {
        tell event AdCampaign.CampaignApproved to entity AdOpsContext.AdCampaign
        do "Update campaign to approved"
      }
      on command AdCampaign.AttachCreative is {
        do "Store creative attachment"
      }
      on command AdCampaign.SchedulePlacement is {
        tell event AdCampaign.PlacementScheduled to entity AdOpsContext.AdCampaign
        do "Store placement schedule"
      }
      on command AdCampaign.LaunchCampaign is {
        do "Update campaign to live"
      }
      on command AdCampaign.RecordPerformance is {
        tell event AdCampaign.PerformanceRecorded to entity AdOpsContext.AdCampaign
        do "Store performance metrics"
      }
      on command AdCampaign.CompleteCampaign is {
        tell event AdCampaign.CampaignCompleted to entity AdOpsContext.AdCampaign
        do "Update campaign to completed"
      }
    } with {
      briefly "Persists ad ops events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Ad ops data persistence"
    described as {
      |Persistent storage for ad operations.
    }
  }
  projector CampaignPerformance is {
    inlet CampaignPerformanceFromAdCampaign is type AdCampaignEvent
    outlet CampaignPerformanceOut is type AdCampaignEvent
    updates repository AdOpsContext.AdOpsRepository
    record CampaignMetrics is  {
      campaignsCreated: Natural with {
        briefly "Created"
        described as {
          |Campaigns created.
        }
      }
      campaignsLive: Natural with {
        briefly "Live"
        described as {
          |Campaigns currently live.
        }
      }
      campaignsCompleted: Natural with {
        briefly "Completed"
        described as {
          |Campaigns completed.
        }
      }
      totalImpressions: Natural with {
        briefly "Impressions"
        described as {
          |Total impressions served.
        }
      }
      totalClicks: Natural with {
        briefly "Clicks"
        described as {
          |Total clicks recorded.
        }
      }
      aggregateTotalSpend: Decimal(14,2) with {
        briefly "Spend"
        described as {
          |Total ad spend.
        }
      }
    } with {
      briefly "Campaign metrics"
      described as {
        |Aggregate campaign performance metrics.
      }
    }
    handler PerformanceHandler is {
      on event AdCampaign.CampaignCreated is {
        tell event AdCampaign.CampaignCreated to repository AdOpsContext.AdOpsRepository
        do "Increment campaigns created"
      }
      on event AdCampaign.CampaignLaunched is {
        tell event AdCampaign.CampaignLaunched to repository AdOpsContext.AdOpsRepository
        do "Increment campaigns live"
      }
      on event AdCampaign.PerformanceRecorded is {
        tell event AdCampaign.PerformanceRecorded to repository AdOpsContext.AdOpsRepository
        do "Accumulate impressions clicks and spend"
      }
      on event AdCampaign.CampaignCompleted is {
        tell event AdCampaign.CampaignCompleted to repository AdOpsContext.AdOpsRepository
        do "Decrement live and increment completed"
      }
    } with {
      briefly "Maintains campaign performance metrics"
      described as {
        |Projects events into performance analytics.
      }
    }
  } with {
    briefly "Campaign performance projector"
    described as {
      |Ad campaign performance analytics.
    }
  }
  // ---- Event publication for AdCampaign ----
  type AdCampaignEvent is one of {
    AdOpsContext.AdCampaign.CampaignCreated,
    AdOpsContext.AdCampaign.CampaignSubmitted,
    AdOpsContext.AdCampaign.CampaignApproved,
    AdOpsContext.AdCampaign.CreativeAttached,
    AdOpsContext.AdCampaign.PlacementScheduled,
    AdOpsContext.AdCampaign.CampaignLaunched,
    AdOpsContext.AdCampaign.PerformanceRecorded,
    AdOpsContext.AdCampaign.CampaignPaused,
    AdOpsContext.AdCampaign.CampaignCompleted,
    AdOpsContext.AdCampaign.CampaignCancelled,
    AdOpsContext.AdCampaign.InvoiceGenerated
  } with {
    briefly "AdCampaign event alternation"
    described as {
      |Union of all AdCampaign events, for streaming and event-sourced
      |persistence.
    }
  }
  processor AdCampaignEventSource as source is {
    outlet AdCampaignEvents is type AdCampaignEvent
    handler AdCampaignSourceHandler is {
      on event AdCampaign.CampaignCreated is {
        send event AdCampaign.CampaignCreated to outlet AdCampaignEvents
      }
      on event AdCampaign.CampaignSubmitted is {
        send event AdCampaign.CampaignSubmitted to outlet AdCampaignEvents
      }
      on event AdCampaign.CampaignApproved is {
        send event AdCampaign.CampaignApproved to outlet AdCampaignEvents
      }
      on event AdCampaign.CreativeAttached is {
        send event AdCampaign.CreativeAttached to outlet AdCampaignEvents
      }
      on event AdCampaign.PlacementScheduled is {
        send event AdCampaign.PlacementScheduled to outlet AdCampaignEvents
      }
      on event AdCampaign.CampaignLaunched is {
        send event AdCampaign.CampaignLaunched to outlet AdCampaignEvents
      }
      on event AdCampaign.PerformanceRecorded is {
        send event AdCampaign.PerformanceRecorded to outlet AdCampaignEvents
      }
      on event AdCampaign.CampaignPaused is {
        send event AdCampaign.CampaignPaused to outlet AdCampaignEvents
      }
      on event AdCampaign.CampaignCompleted is {
        send event AdCampaign.CampaignCompleted to outlet AdCampaignEvents
      }
      on event AdCampaign.CampaignCancelled is {
        send event AdCampaign.CampaignCancelled to outlet AdCampaignEvents
      }
      on event AdCampaign.InvoiceGenerated is {
        send event AdCampaign.InvoiceGenerated to outlet AdCampaignEvents
      }
      on other is {
        error "Unexpected message for source AdCampaignEventSource"
      }
    } with {
      briefly "AdCampaign source handler"
      described as {
        |Publishes AdCampaign events onto the outlet.
      }
    }
  } with {
    briefly "AdCampaign event source"
    described as {
      |Publishes AdCampaign entity events into the streaming topology.
    }
  }
  processor AdCampaignEventSink as sink is {
    inlet AdCampaignInlet is type AdCampaignEvent
    handler AdCampaignSinkHandler is {
      on event AdCampaign.CampaignCreated is {
        tell event AdCampaign.CampaignCreated to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.CampaignSubmitted is {
        tell event AdCampaign.CampaignSubmitted to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.CampaignApproved is {
        tell event AdCampaign.CampaignApproved to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.CreativeAttached is {
        tell event AdCampaign.CreativeAttached to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.PlacementScheduled is {
        tell event AdCampaign.PlacementScheduled to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.CampaignLaunched is {
        tell event AdCampaign.CampaignLaunched to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.PerformanceRecorded is {
        tell event AdCampaign.PerformanceRecorded to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.CampaignPaused is {
        tell event AdCampaign.CampaignPaused to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.CampaignCompleted is {
        tell event AdCampaign.CampaignCompleted to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.CampaignCancelled is {
        tell event AdCampaign.CampaignCancelled to repository AdOpsContext.AdOpsRepository
      }
      on event AdCampaign.InvoiceGenerated is {
        tell event AdCampaign.InvoiceGenerated to repository AdOpsContext.AdOpsRepository
      }
      on other is {
        error "Unexpected message for sink AdCampaignEventSink"
      }
    } with {
      briefly "AdCampaign sink handler"
      described as {
        |Persists AdCampaign events via the repository.
      }
    }
  } with {
    briefly "AdCampaign event sink"
    described as {
      |Receives AdCampaign events for persistence.
    }
  }
  connector AdCampaignEventFlow is {
    from outlet AdOpsContext.AdCampaignEventSource.AdCampaignEvents to
      inlet AdOpsContext.AdCampaignEventSink.AdCampaignInlet
  } with {
    briefly "AdCampaign event flow"
    described as {
      |Connects the AdCampaign source to its sink.
    }
  }
  processor AdCampaignEventSplit is {
    inlet AdCampaignEventSplitIn is type AdCampaignEvent
    outlet AdCampaignEventSplitToAdOpsRepository is type AdCampaignEvent
    outlet AdCampaignEventSplitToCampaignPerformance is type AdCampaignEvent
    handler AdCampaignEventSplitHandler is {
      on event AdCampaign.CampaignCreated is {
        send event AdCampaign.CampaignCreated to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CampaignCreated to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CampaignCreated to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.CampaignSubmitted is {
        send event AdCampaign.CampaignSubmitted to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CampaignSubmitted to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CampaignSubmitted to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.CampaignApproved is {
        send event AdCampaign.CampaignApproved to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CampaignApproved to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CampaignApproved to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.CreativeAttached is {
        send event AdCampaign.CreativeAttached to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CreativeAttached to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CreativeAttached to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.PlacementScheduled is {
        send event AdCampaign.PlacementScheduled to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.PlacementScheduled to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.PlacementScheduled to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.CampaignLaunched is {
        send event AdCampaign.CampaignLaunched to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CampaignLaunched to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CampaignLaunched to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.PerformanceRecorded is {
        send event AdCampaign.PerformanceRecorded to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.PerformanceRecorded to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.PerformanceRecorded to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.CampaignPaused is {
        send event AdCampaign.CampaignPaused to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CampaignPaused to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CampaignPaused to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.CampaignCompleted is {
        send event AdCampaign.CampaignCompleted to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CampaignCompleted to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CampaignCompleted to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.CampaignCancelled is {
        send event AdCampaign.CampaignCancelled to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.CampaignCancelled to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.CampaignCancelled to entity AdOpsContext.AdCampaign
      }
      on event AdCampaign.InvoiceGenerated is {
        send event AdCampaign.InvoiceGenerated to outlet AdCampaignEventSplitToAdOpsRepository
        send event AdCampaign.InvoiceGenerated to outlet AdCampaignEventSplitToCampaignPerformance
        tell event AdCampaign.InvoiceGenerated to entity AdOpsContext.AdCampaign
      }
      on other is {
        error "Unexpected message for processor AdCampaignEventSplit"
      }
    } with {
      briefly "AdCampaign event fan-out handler"
      described as {
        |Delivers each AdCampaign event to all of its consumers.
      }
    }
  } with {
    briefly "AdCampaign event fan-out"
    described as {
      |Fans AdCampaign events out to the repository and projectors.
    }
  }
  connector LinkAdCampaignToAdCampaignEventSplit is {
    from outlet AdOpsContext.AdCampaign.AdCampaignEvents2 to
      inlet AdOpsContext.AdCampaignEventSplit.AdCampaignEventSplitIn
  } with {
    briefly "LinkAdCampaignToAdCampaignEventSplit"
  }
  connector LinkAdCampaignEventSplitToAdOpsRepository is {
    from outlet AdOpsContext.AdCampaignEventSplit.AdCampaignEventSplitToAdOpsRepository to
      inlet AdOpsContext.AdOpsRepository.AdOpsRepositoryFromAdCampaign
  } with {
    briefly "LinkAdCampaignEventSplitToAdOpsRepository"
  }
  connector LinkAdCampaignEventSplitToCampaignPerformance is {
    from outlet AdOpsContext.AdCampaignEventSplit.AdCampaignEventSplitToCampaignPerformance to
      inlet AdOpsContext.CampaignPerformance.CampaignPerformanceFromAdCampaign
  } with {
    briefly "LinkAdCampaignEventSplitToCampaignPerformance"
  }
  connector LinkCampaignPerformanceToAdOpsRepository is {
    from outlet AdOpsContext.CampaignPerformance.CampaignPerformanceOut to
      inlet AdOpsContext.AdOpsRepository.AdOpsRepositoryFromCampaignPerformance
  } with {
    briefly "LinkCampaignPerformanceToAdOpsRepository"
  }
} with {
  briefly "Bounded context for ad operations"
  described as {
    |Ad operations bounded context for campaign trafficking and management.
  }
}
