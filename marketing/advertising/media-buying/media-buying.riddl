// Media Buying Domain Model
// Planning, purchasing, and managing advertising inventory across channels
domain MediaBuying is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user MediaPlanner is "person planning media spend across channels" with {
    briefly "Media Planner"
    described as {
      |Strategist who plans media allocation and channel mix.
    }
  }
  user MediaBuyer is "person negotiating rates and purchasing inventory" with {
    briefly "Media Buyer"
    described as {
      |Buyer who negotiates rates and places media orders.
    }
  }
  user CampaignManager is "person overseeing campaign delivery" with {
    briefly "Campaign Manager"
    described as {
      |Manager tracking campaign performance and ROI.
    }
  }
  epic MediaPurchase is {
    user MediaBuyer wants to "to purchase advertising inventory" so that "campaigns reach target audiences effectively"
    case PlaceMediaOrder is {
      user MediaBuyer wants to "to place a media order with a vendor" so that "ad inventory is secured for the campaign"
      step is "Buyer creates" "media order" "from media plan" with {
        briefly "Create order"
        described as {
          |Create media order.
        }
      }
      step is "System submits" "insertion order" "to vendor" with {
        briefly "Submit IO"
        described as {
          |Send insertion order.
        }
      }
    } with {
      briefly "Place media order"
      described as {
        |Purchasing ad inventory from a media vendor.
      }
    }
  } with {
    briefly "Media purchase"
    described as {
      |Epic for purchasing advertising inventory.
    }
  }
  include "MediaBuyingContext.riddl"
  include "external-contexts.riddl"
  application context MediaBuyingApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in MediaBuying are delivered.
      }
    }
    outlet AppMediaOrderCommands is type MediaBuyingContext.MediaOrder.MediaOrderCommand
    inlet AppMediaBuyingRepositoryResponses is type MediaBuyingContext.MediaOrder.MediaOrderResult    handler MediaBuyingAppHandler is {
      on other is {
        error "Unexpected message for application context MediaBuyingApp"
      }
    } with {
      briefly "MediaBuyingApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "MediaBuyingApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'MediaOrderCommand Stream' is from outlet MediaBuyingApp.AppMediaOrderCommands to inlet MediaBuyingContext.MediaOrder.MediaOrderCommands with {
    briefly "MediaOrder commands from the application"
  }
  persistent connector 'MediaOrderResult Stream' is from outlet MediaBuyingContext.MediaBuyingRepository.MediaBuyingRepositoryResponses to inlet MediaBuyingApp.AppMediaBuyingRepositoryResponses with {
    briefly "MediaBuying query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet MediaBuyingApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Media buying domain"
  described as {
    |Planning, purchasing, and managing advertising inventory.
  }
}
