// Media Buying - Media Buying Context
context MediaBuyingContext is {
  adaptor FromAnalyticsPlatform from context AnalyticsPlatform is {
    handler FromAnalyticsPlatformHandler is {
      on result AnalyticsPlatform.CampaignROI is {
        do "the model receives campaign roi"
      }
      on event AnalyticsPlatform.PerformanceDataReceived is {
        do "the model receives performance data received"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsPlatform"
      }
    } with {
      briefly "from analytics platform"
      described as {
        |Carries messages from the external AnalyticsPlatform.
      }
    }
  } with {
      briefly "AnalyticsPlatform integration"
    described as {
      |The model's side of the AnalyticsPlatform conversation.
    }
  }
  adaptor ToAnalyticsPlatform to context AnalyticsPlatform is {
    handler ToAnalyticsPlatformHandler is {
      on query AnalyticsPlatform.GetCampaignROI is {
        do "the model sends get campaign roi"
      }
      on command AnalyticsPlatform.SendPerformanceData is {
        do "the model sends send performance data"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalyticsPlatform"
      }
    } with {
      briefly "to analytics platform"
      described as {
        |Carries messages to the external AnalyticsPlatform.
      }
    }
  } with {
      briefly "AnalyticsPlatform integration"
    described as {
      |The model's side of the AnalyticsPlatform conversation.
    }
  }
  adaptor FromMediaVendor from context MediaVendor is {
    handler FromMediaVendorHandler is {
      on result MediaVendor.AvailableInventory is {
        do "the model receives available inventory"
      }
      on event MediaVendor.InsertionOrderAccepted is {
        do "the model receives insertion order accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromMediaVendor"
      }
    } with {
      briefly "from media vendor"
      described as {
        |Carries messages from the external MediaVendor.
      }
    }
  } with {
      briefly "MediaVendor integration"
    described as {
      |The model's side of the MediaVendor conversation.
    }
  }
  adaptor ToMediaVendor to context MediaVendor is {
    handler ToMediaVendorHandler is {
      on query MediaVendor.GetAvailableInventory is {
        do "the model sends get available inventory"
      }
      on command MediaVendor.SubmitInsertionOrder is {
        do "the model sends submit insertion order"
      }
      on other is {
        error "Unexpected message for adaptor ToMediaVendor"
      }
    } with {
      briefly "to media vendor"
      described as {
        |Carries messages to the external MediaVendor.
      }
    }
  } with {
      briefly "MediaVendor integration"
    described as {
      |The model's side of the MediaVendor conversation.
    }
  }
  include "types.riddl"
  include "MediaOrder.riddl"
  repository MediaBuyingRepository is {
    inlet MediaBuyingRepositoryFromMediaOrder is type MediaOrderEvent
    inlet MediaBuyingRepositoryFromMediaBuyingMetrics is type MediaOrderEvent
    outlet MediaBuyingRepositoryResponses is type MediaOrder.MediaOrderResult
    schema MediaBuyingData is relational
      of mediaOrders as type MediaOrder
        index on field MediaOrder.orderId
        index on field MediaOrder.orderInfo.campaignId
        index on field MediaOrder.status
      with {
      briefly "Media buying data schema"
      described as {
        |The relational schema holding media buying data for the MediaBuyingRepository.
      }
    }

    handler MediaBuyingPersistence is {
      on command MediaOrder.CreateMediaOrder is {
        tell event MediaOrder.MediaOrderCreated to entity MediaBuyingContext.MediaOrder
        do "Store new media order"
      }
      on command MediaOrder.SubmitForApproval is {
        do "Update order to submitted"
      }
      on command MediaOrder.ApproveOrder is {
        tell event MediaOrder.OrderApproved to entity MediaBuyingContext.MediaOrder
        do "Update order to approved"
      }
      on command MediaOrder.BookInventory is {
        do "Store insertion order and update to booked"
      }
      on command MediaOrder.RecordSpend is {
        tell event MediaOrder.SpendRecorded to entity MediaBuyingContext.MediaOrder
        do "Store spend record"
      }
      on command MediaOrder.CompleteOrder is {
        tell event MediaOrder.OrderCompleted to entity MediaBuyingContext.MediaOrder
        do "Update order to completed"
      }
    } with {
      briefly "Persists media buying events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Media buying data persistence"
    described as {
      |Persistent storage for media buying.
    }
  }
  projector MediaBuyingMetrics is {
    inlet MediaBuyingMetricsFromMediaOrder is type MediaOrderEvent
    outlet MediaBuyingMetricsOut is type MediaOrderEvent
    updates repository MediaBuyingContext.MediaBuyingRepository
    record SpendMetrics is  {
      ordersPlaced: Natural with {
        briefly "Placed"
        described as {
          |Orders placed.
        }
      }
      ordersCompleted: Natural with {
        briefly "Completed"
        described as {
          |Orders completed.
        }
      }
      ordersCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Orders cancelled.
        }
      }
      totalMediaSpend: Decimal(14,2) with {
        briefly "Total spend"
        described as {
          |Total media spend.
        }
      }
    } with {
      briefly "Spend metrics"
      described as {
        |Media spend metrics.
      }
    }
    handler MetricsHandler is {
      on event MediaOrder.MediaOrderCreated is {
        tell event MediaOrder.MediaOrderCreated to repository MediaBuyingContext.MediaBuyingRepository
        do "Increment orders placed"
      }
      on event MediaOrder.OrderCompleted is {
        tell event MediaOrder.OrderCompleted to repository MediaBuyingContext.MediaBuyingRepository
        do "Increment orders completed"
      }
      on event MediaOrder.OrderCancelled is {
        tell event MediaOrder.OrderCancelled to repository MediaBuyingContext.MediaBuyingRepository
        do "Increment orders cancelled"
      }
      on event MediaOrder.SpendRecorded is {
        tell event MediaOrder.SpendRecorded to repository MediaBuyingContext.MediaBuyingRepository
        do "Accumulate total media spend"
      }
    } with {
      briefly "Maintains media buying metrics"
      described as {
        |Projects events into spend metrics.
      }
    }
  } with {
    briefly "Media buying metrics"
    described as {
      |Media buying analytics and reporting.
    }
  }
  // ---- Event publication for MediaOrder ----
  type MediaOrderEvent is one of {
    MediaBuyingContext.MediaOrder.MediaOrderCreated,
    MediaBuyingContext.MediaOrder.OrderSubmitted,
    MediaBuyingContext.MediaOrder.RateNegotiated,
    MediaBuyingContext.MediaOrder.OrderApproved,
    MediaBuyingContext.MediaOrder.InventoryBooked,
    MediaBuyingContext.MediaOrder.SpendRecorded,
    MediaBuyingContext.MediaOrder.PerformanceRecorded,
    MediaBuyingContext.MediaOrder.OrderCompleted,
    MediaBuyingContext.MediaOrder.OrderCancelled
  } with {
    briefly "MediaOrder event alternation"
    described as {
      |Union of all MediaOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MediaOrderEventSource as source is {
    outlet MediaOrderEvents is type MediaOrderEvent
    handler MediaOrderSourceHandler is {
      on event MediaOrder.MediaOrderCreated is {
        send event MediaOrder.MediaOrderCreated to outlet MediaOrderEvents
      }
      on event MediaOrder.OrderSubmitted is {
        send event MediaOrder.OrderSubmitted to outlet MediaOrderEvents
      }
      on event MediaOrder.RateNegotiated is {
        send event MediaOrder.RateNegotiated to outlet MediaOrderEvents
      }
      on event MediaOrder.OrderApproved is {
        send event MediaOrder.OrderApproved to outlet MediaOrderEvents
      }
      on event MediaOrder.InventoryBooked is {
        send event MediaOrder.InventoryBooked to outlet MediaOrderEvents
      }
      on event MediaOrder.SpendRecorded is {
        send event MediaOrder.SpendRecorded to outlet MediaOrderEvents
      }
      on event MediaOrder.PerformanceRecorded is {
        send event MediaOrder.PerformanceRecorded to outlet MediaOrderEvents
      }
      on event MediaOrder.OrderCompleted is {
        send event MediaOrder.OrderCompleted to outlet MediaOrderEvents
      }
      on event MediaOrder.OrderCancelled is {
        send event MediaOrder.OrderCancelled to outlet MediaOrderEvents
      }
      on other is {
        error "Unexpected message for source MediaOrderEventSource"
      }
    } with {
      briefly "MediaOrder source handler"
      described as {
        |Publishes MediaOrder events onto the outlet.
      }
    }
  } with {
    briefly "MediaOrder event source"
    described as {
      |Publishes MediaOrder entity events into the streaming topology.
    }
  }
  processor MediaOrderEventSink as sink is {
    inlet MediaOrderInlet is type MediaOrderEvent
    handler MediaOrderSinkHandler is {
      on event MediaOrder.MediaOrderCreated is {
        tell event MediaOrder.MediaOrderCreated to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.OrderSubmitted is {
        tell event MediaOrder.OrderSubmitted to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.RateNegotiated is {
        tell event MediaOrder.RateNegotiated to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.OrderApproved is {
        tell event MediaOrder.OrderApproved to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.InventoryBooked is {
        tell event MediaOrder.InventoryBooked to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.SpendRecorded is {
        tell event MediaOrder.SpendRecorded to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.PerformanceRecorded is {
        tell event MediaOrder.PerformanceRecorded to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.OrderCompleted is {
        tell event MediaOrder.OrderCompleted to repository MediaBuyingContext.MediaBuyingRepository
      }
      on event MediaOrder.OrderCancelled is {
        tell event MediaOrder.OrderCancelled to repository MediaBuyingContext.MediaBuyingRepository
      }
      on other is {
        error "Unexpected message for sink MediaOrderEventSink"
      }
    } with {
      briefly "MediaOrder sink handler"
      described as {
        |Persists MediaOrder events via the repository.
      }
    }
  } with {
    briefly "MediaOrder event sink"
    described as {
      |Receives MediaOrder events for persistence.
    }
  }
  connector MediaOrderEventFlow is {
    from outlet MediaBuyingContext.MediaOrderEventSource.MediaOrderEvents to
      inlet MediaBuyingContext.MediaOrderEventSink.MediaOrderInlet
  } with {
    briefly "MediaOrder event flow"
    described as {
      |Connects the MediaOrder source to its sink.
    }
  }
  processor MediaOrderEventSplit is {
    inlet MediaOrderEventSplitIn is type MediaOrderEvent
    outlet MediaOrderEventSplitToMediaBuyingRepository is type MediaOrderEvent
    outlet MediaOrderEventSplitToMediaBuyingMetrics is type MediaOrderEvent
    handler MediaOrderEventSplitHandler is {
      on event MediaOrder.MediaOrderCreated is {
        send event MediaOrder.MediaOrderCreated to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.MediaOrderCreated to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.MediaOrderCreated to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.OrderSubmitted is {
        send event MediaOrder.OrderSubmitted to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.OrderSubmitted to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.OrderSubmitted to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.RateNegotiated is {
        send event MediaOrder.RateNegotiated to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.RateNegotiated to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.RateNegotiated to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.OrderApproved is {
        send event MediaOrder.OrderApproved to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.OrderApproved to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.OrderApproved to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.InventoryBooked is {
        send event MediaOrder.InventoryBooked to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.InventoryBooked to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.InventoryBooked to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.SpendRecorded is {
        send event MediaOrder.SpendRecorded to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.SpendRecorded to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.SpendRecorded to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.PerformanceRecorded is {
        send event MediaOrder.PerformanceRecorded to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.PerformanceRecorded to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.PerformanceRecorded to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.OrderCompleted is {
        send event MediaOrder.OrderCompleted to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.OrderCompleted to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.OrderCompleted to entity MediaBuyingContext.MediaOrder
      }
      on event MediaOrder.OrderCancelled is {
        send event MediaOrder.OrderCancelled to outlet MediaOrderEventSplitToMediaBuyingRepository
        send event MediaOrder.OrderCancelled to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell event MediaOrder.OrderCancelled to entity MediaBuyingContext.MediaOrder
      }
      on other is {
        error "Unexpected message for processor MediaOrderEventSplit"
      }
    } with {
      briefly "MediaOrder event fan-out handler"
      described as {
        |Delivers each MediaOrder event to all of its consumers.
      }
    }
  } with {
    briefly "MediaOrder event fan-out"
    described as {
      |Fans MediaOrder events out to the repository and projectors.
    }
  }
  connector LinkMediaOrderToMediaOrderEventSplit is {
    from outlet MediaBuyingContext.MediaOrder.MediaOrderEvents2 to
      inlet MediaBuyingContext.MediaOrderEventSplit.MediaOrderEventSplitIn
  } with {
    briefly "LinkMediaOrderToMediaOrderEventSplit"
  }
  connector LinkMediaOrderEventSplitToMediaBuyingRepository is {
    from outlet MediaBuyingContext.MediaOrderEventSplit.MediaOrderEventSplitToMediaBuyingRepository to
      inlet MediaBuyingContext.MediaBuyingRepository.MediaBuyingRepositoryFromMediaOrder
  } with {
    briefly "LinkMediaOrderEventSplitToMediaBuyingRepository"
  }
  connector LinkMediaOrderEventSplitToMediaBuyingMetrics is {
    from outlet MediaBuyingContext.MediaOrderEventSplit.MediaOrderEventSplitToMediaBuyingMetrics to
      inlet MediaBuyingContext.MediaBuyingMetrics.MediaBuyingMetricsFromMediaOrder
  } with {
    briefly "LinkMediaOrderEventSplitToMediaBuyingMetrics"
  }
  connector LinkMediaBuyingMetricsToMediaBuyingRepository is {
    from outlet MediaBuyingContext.MediaBuyingMetrics.MediaBuyingMetricsOut to
      inlet MediaBuyingContext.MediaBuyingRepository.MediaBuyingRepositoryFromMediaBuyingMetrics
  } with {
    briefly "LinkMediaBuyingMetricsToMediaBuyingRepository"
  }
} with {
  briefly "Bounded context for media buying"
  described as {
    |Media buying operations context.
  }
}
