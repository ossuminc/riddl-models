// Media Buying - Media Buying Context
context MediaBuyingContext as router is {
  inlet MediaOrderCommandStreamIn is type MediaOrderCommand  outlet MediaOrderCommandStreamOut is type MediaOrderCommand
  inlet MediaOrderResultStreamIn is result MediaOrder.MediaOrderResult  outlet MediaOrderResultStreamOut is result MediaOrder.MediaOrderResult
  handler MediaBuyingContextBoundary is {
    on createMediaOrder: command MediaOrder.CreateMediaOrder is {
      send createMediaOrder to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on submitForApproval: command MediaOrder.SubmitForApproval is {
      send submitForApproval to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on negotiateRate: command MediaOrder.NegotiateRate is {
      send negotiateRate to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on approveOrder: command MediaOrder.ApproveOrder is {
      send approveOrder to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on bookInventory: command MediaOrder.BookInventory is {
      send bookInventory to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on recordSpend: command MediaOrder.RecordSpend is {
      send recordSpend to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on recordPerformance: command MediaOrder.RecordPerformance is {
      send recordPerformance to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on completeOrder: command MediaOrder.CompleteOrder is {
      send completeOrder to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on cancelOrder: command MediaOrder.CancelOrder is {
      send cancelOrder to outlet MediaBuyingContext.MediaOrderCommandStreamOut
    }
    on mediaOrderResult: result MediaOrder.MediaOrderResult is {
      send mediaOrderResult to outlet MediaBuyingContext.MediaOrderResultStreamOut
    }
    on other is {
      error "Unexpected message at the MediaBuyingContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'MediaOrderCommand Stream Intake' is from outlet MediaBuyingContext.MediaOrderCommandStreamOut to inlet MediaBuyingContext.MediaOrder.MediaOrderCommands  connector 'MediaOrderResult Stream Egress' is from outlet MediaBuyingContext.MediaBuyingRepository.MediaBuyingRepositoryResponses to inlet MediaBuyingContext.MediaOrderResultStreamIn  adaptor FromAnalyticsPlatform from context AnalyticsPlatform is { 
    handler FromAnalyticsPlatformHandler is {
      on result AnalyticsPlatform.CampaignROI is {
        do "the model receives campaign roi"
      }
      on event AnalyticsPlatform.PerformanceDataReceived is {
        do "the model receives performance data received"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsPlatform"
      }
    } with {
      briefly "from analytics platform"
      described as {
        |Carries messages from the external AnalyticsPlatform.
      }
    }
  } with {
    briefly "AnalyticsPlatform integration"
    described as {
      |The model's side of the AnalyticsPlatform conversation.
    }
  }
  adaptor ToAnalyticsPlatform to context AnalyticsPlatform is { 
    handler ToAnalyticsPlatformHandler is {
      on query AnalyticsPlatform.GetCampaignROI is {
        do "the model sends get campaign roi"
      }
      on command AnalyticsPlatform.SendPerformanceData is {
        do "the model sends send performance data"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalyticsPlatform"
      }
    } with {
      briefly "to analytics platform"
      described as {
        |Carries messages to the external AnalyticsPlatform.
      }
    }
  } with {
    briefly "AnalyticsPlatform integration"
    described as {
      |The model's side of the AnalyticsPlatform conversation.
    }
  }
  adaptor FromMediaVendor from context MediaVendor is { 
    handler FromMediaVendorHandler is {
      on result MediaVendor.AvailableInventory is {
        do "the model receives available inventory"
      }
      on event MediaVendor.InsertionOrderAccepted is {
        do "the model receives insertion order accepted"
      }
      on other is {
        error "Unexpected message for adaptor FromMediaVendor"
      }
    } with {
      briefly "from media vendor"
      described as {
        |Carries messages from the external MediaVendor.
      }
    }
  } with {
    briefly "MediaVendor integration"
    described as {
      |The model's side of the MediaVendor conversation.
    }
  }
  adaptor ToMediaVendor to context MediaVendor is { 
    handler ToMediaVendorHandler is {
      on query MediaVendor.GetAvailableInventory is {
        do "the model sends get available inventory"
      }
      on command MediaVendor.SubmitInsertionOrder is {
        do "the model sends submit insertion order"
      }
      on other is {
        error "Unexpected message for adaptor ToMediaVendor"
      }
    } with {
      briefly "to media vendor"
      described as {
        |Carries messages to the external MediaVendor.
      }
    }
  } with {
    briefly "MediaVendor integration"
    described as {
      |The model's side of the MediaVendor conversation.
    }
  }
  include "types.riddl"
  include "MediaOrder.riddl"
  type MediaBuyingRepositoryCommand is one of {
    MediaBuyingContext.MediaBuyingRepository.PersistInventoryBooked or MediaBuyingContext.MediaBuyingRepository.PersistMediaOrderCreated or MediaBuyingContext.MediaBuyingRepository.PersistOrderApproved or MediaBuyingContext.MediaBuyingRepository.PersistOrderCancelled or MediaBuyingContext.MediaBuyingRepository.PersistOrderCompleted or MediaBuyingContext.MediaBuyingRepository.PersistOrderSubmitted or MediaBuyingContext.MediaBuyingRepository.PersistPerformanceRecorded or MediaBuyingContext.MediaBuyingRepository.PersistRateNegotiated or MediaBuyingContext.MediaBuyingRepository.PersistSpendRecorded
  } with {
    briefly "Anything that writes MediaBuyingRepository"
    described as {
      |The persistence commands MediaBuyingRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository MediaBuyingRepository as flow is {
    inlet MediaBuyingRepositoryFromMediaBuyingMetrics is type MediaBuyingRepositoryCommand
    command PersistInventoryBooked is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row InventoryBooked applies to.
        }
      }
    } with {
      briefly "Persist InventoryBooked"
      described as {
        |Instructs this repository to apply InventoryBooked to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderApproved is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderApproved applies to.
        }
      }
    } with {
      briefly "Persist OrderApproved"
      described as {
        |Instructs this repository to apply OrderApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderSubmitted is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderSubmitted applies to.
        }
      }
    } with {
      briefly "Persist OrderSubmitted"
      described as {
        |Instructs this repository to apply OrderSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPerformanceRecorded is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row PerformanceRecorded applies to.
        }
      }
    } with {
      briefly "Persist PerformanceRecorded"
      described as {
        |Instructs this repository to apply PerformanceRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRateNegotiated is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row RateNegotiated applies to.
        }
      }
    } with {
      briefly "Persist RateNegotiated"
      described as {
        |Instructs this repository to apply RateNegotiated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMediaOrderCreated is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row MediaOrderCreated applies to.
        }
      }
    } with {
      briefly "Persist MediaOrderCreated"
      described as {
        |Instructs this repository to apply MediaOrderCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCancelled is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCancelled applies to.
        }
      }
    } with {
      briefly "Persist OrderCancelled"
      described as {
        |Instructs this repository to apply OrderCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistOrderCompleted is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row OrderCompleted applies to.
        }
      }
    } with {
      briefly "Persist OrderCompleted"
      described as {
        |Instructs this repository to apply OrderCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSpendRecorded is  {
      orderId: MediaOrderId with {
        briefly "Row addressed"
        described as {
          |Which stored row SpendRecorded applies to.
        }
      }
    } with {
      briefly "Persist SpendRecorded"
      described as {
        |Instructs this repository to apply SpendRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet MediaBuyingRepositoryResponses is result MediaOrder.MediaOrderResult
    record StoredMediaOrder is  {
      mediaOrderId: MediaOrderId with {
        briefly "mediaOrderId"
        described as {
          |The mediaOrderId column of the stored mediaOrder row.
        }
      }
      orderId: MediaOrderId with {
        briefly "orderId"
        described as {
          |The orderId column of the stored mediaOrder row.
        }
      }
      orderInfo: MediaOrderInfo with {
        briefly "orderInfo"
        described as {
          |The orderInfo column of the stored mediaOrder row.
        }
      }
      status: OrderStatus with {
        briefly "status"
        described as {
          |The status column of the stored mediaOrder row.
        }
      }
    } with {
      briefly "Stored mediaOrder row"
      described as {
        |The persistence shape of mediaOrder data as this repository stores it.
      }
    }
    schema MediaBuyingData is relational
      of mediaOrders as record StoredMediaOrder
        index on field StoredMediaOrder.orderId
        index on field StoredMediaOrder.orderInfo.campaignId
        index on field StoredMediaOrder.status
 with {
      briefly "Media buying data schema"
      described as {
        |The relational schema holding media buying data for the MediaBuyingRepository.
      }
    }
    handler MediaBuyingPersistence is {
      on persistInventoryBooked: command PersistInventoryBooked is {
        do "apply InventoryBooked to the stored row"
      }
      on persistOrderApproved: command PersistOrderApproved is {
        do "apply OrderApproved to the stored row"
      }
      on persistOrderSubmitted: command PersistOrderSubmitted is {
        do "apply OrderSubmitted to the stored row"
      }
      on persistPerformanceRecorded: command PersistPerformanceRecorded is {
        do "apply PerformanceRecorded to the stored row"
      }
      on persistRateNegotiated: command PersistRateNegotiated is {
        do "apply RateNegotiated to the stored row"
      }
      on persistMediaOrderCreated: command PersistMediaOrderCreated is {
        do "apply MediaOrderCreated to the stored row"
      }
      on persistOrderCancelled: command PersistOrderCancelled is {
        do "apply OrderCancelled to the stored row"
      }
      on persistOrderCompleted: command PersistOrderCompleted is {
        do "apply OrderCompleted to the stored row"
      }
      on persistSpendRecorded: command PersistSpendRecorded is {
        do "apply SpendRecorded to the stored row"
      }
      on query GetSpendMetrics is {
        let spendMetricsView: type SpendMetricsView = prompt("read the spend metrics projection")
        reply spendMetricsView
      }
    } with {
      briefly "Persists media buying events"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Media buying data persistence"
    described as {
      |Persistent storage for media buying.
    }
  }
  query GetSpendMetrics replies result SpendMetricsView is  {
    spendMetricsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which spend metrics to retrieve.
      }
    }
  } with {
    briefly "Get spend metrics"
    described as {
      |Retrieves the spend metrics projection.
    }
  }
  result SpendMetricsView is  {
    spendMetrics: MediaBuyingMetrics.SpendMetrics with {
      briefly "Spend metrics"
      described as {
        |The spend metrics being returned.
      }
    }
  } with {
    briefly "Spend metrics view"
    described as {
      |Read model view carrying the spend metrics projection.
    }
  }
  projector MediaBuyingMetrics as flow is {
    outlet MediaBuyingMetricsToRepository is type MediaBuyingRepositoryCommand
    updates repository MediaBuyingContext.MediaBuyingRepository
    inlet MediaBuyingMetricsFromMediaOrder is type MediaOrderEvent
    record SpendMetrics is  {
      ordersPlaced: Natural with {
        briefly "Placed"
        described as {
          |Orders placed.
        }
      }
      ordersCompleted: Natural with {
        briefly "Completed"
        described as {
          |Orders completed.
        }
      }
      ordersCancelled: Natural with {
        briefly "Cancelled"
        described as {
          |Orders cancelled.
        }
      }
      totalMediaSpend: Decimal(14,2) with {
        briefly "Total spend"
        described as {
          |Total media spend.
        }
      }
    } with {
      briefly "Spend metrics"
      described as {
        |Media spend metrics.
      }
    }
    handler MetricsHandler is {
      on inventoryBooked: event MediaOrder.InventoryBooked is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistInventoryBooked(orderId = inventoryBooked.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "apply InventoryBooked to the MediaBuyingMetrics projection"
      }
      on orderApproved: event MediaOrder.OrderApproved is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistOrderApproved(orderId = orderApproved.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "apply OrderApproved to the MediaBuyingMetrics projection"
      }
      on orderSubmitted: event MediaOrder.OrderSubmitted is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistOrderSubmitted(orderId = orderSubmitted.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "apply OrderSubmitted to the MediaBuyingMetrics projection"
      }
      on performanceRecorded: event MediaOrder.PerformanceRecorded is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistPerformanceRecorded(orderId = performanceRecorded.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "apply PerformanceRecorded to the MediaBuyingMetrics projection"
      }
      on rateNegotiated: event MediaOrder.RateNegotiated is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistRateNegotiated(orderId = rateNegotiated.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "apply RateNegotiated to the MediaBuyingMetrics projection"
      }
      on mediaOrderCreated: event MediaOrder.MediaOrderCreated is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistMediaOrderCreated(orderId = mediaOrderCreated.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "Increment orders placed"
      }
      on orderCompleted: event MediaOrder.OrderCompleted is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistOrderCompleted(orderId = orderCompleted.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "Increment orders completed"
      }
      on orderCancelled: event MediaOrder.OrderCancelled is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistOrderCancelled(orderId = orderCancelled.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "Increment orders cancelled"
      }
      on spendRecorded: event MediaOrder.SpendRecorded is {
        tell command MediaBuyingContext.MediaBuyingRepository.PersistSpendRecorded(orderId = spendRecorded.orderId) to repository MediaBuyingContext.MediaBuyingRepository
        do "Accumulate total media spend"
      }
    } with {
      briefly "Maintains media buying metrics"
      described as {
        |Projects events into spend metrics.
      }
    }
  } with {
    briefly "Media buying metrics"
    described as {
      |Media buying analytics and reporting.
    }
  }
  // ---- Event publication for MediaOrder ----
  type MediaOrderEvent is one of {
    MediaBuyingContext.MediaOrder.MediaOrderCreated or MediaBuyingContext.MediaOrder.OrderSubmitted or MediaBuyingContext.MediaOrder.RateNegotiated or MediaBuyingContext.MediaOrder.OrderApproved or MediaBuyingContext.MediaOrder.InventoryBooked or MediaBuyingContext.MediaOrder.SpendRecorded or MediaBuyingContext.MediaOrder.PerformanceRecorded or MediaBuyingContext.MediaOrder.OrderCompleted or MediaBuyingContext.MediaOrder.OrderCancelled
  } with {
    briefly "MediaOrder event alternation"
    described as {
      |Union of all MediaOrder events, for streaming and event-sourced
      |persistence.
    }
  }
  processor MediaOrderEventSplit as flow is {
    inlet MediaOrderEventSplitIn is type MediaOrderEvent
    outlet MediaOrderEventSplitToMediaBuyingMetrics is type MediaOrderEvent
    handler MediaOrderEventSplitHandler is {
      on mediaOrderCreated: event MediaOrder.MediaOrderCreated is {
        send mediaOrderCreated to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell mediaOrderCreated to entity MediaBuyingContext.MediaOrder
      }
      on orderSubmitted: event MediaOrder.OrderSubmitted is {
        send orderSubmitted to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell orderSubmitted to entity MediaBuyingContext.MediaOrder
      }
      on rateNegotiated: event MediaOrder.RateNegotiated is {
        send rateNegotiated to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell rateNegotiated to entity MediaBuyingContext.MediaOrder
      }
      on orderApproved: event MediaOrder.OrderApproved is {
        send orderApproved to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell orderApproved to entity MediaBuyingContext.MediaOrder
      }
      on inventoryBooked: event MediaOrder.InventoryBooked is {
        send inventoryBooked to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell inventoryBooked to entity MediaBuyingContext.MediaOrder
      }
      on spendRecorded: event MediaOrder.SpendRecorded is {
        send spendRecorded to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell spendRecorded to entity MediaBuyingContext.MediaOrder
      }
      on performanceRecorded: event MediaOrder.PerformanceRecorded is {
        send performanceRecorded to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell performanceRecorded to entity MediaBuyingContext.MediaOrder
      }
      on orderCompleted: event MediaOrder.OrderCompleted is {
        send orderCompleted to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell orderCompleted to entity MediaBuyingContext.MediaOrder
      }
      on orderCancelled: event MediaOrder.OrderCancelled is {
        send orderCancelled to outlet MediaOrderEventSplitToMediaBuyingMetrics
        tell orderCancelled to entity MediaBuyingContext.MediaOrder
      }
      on other is {
        error "Unexpected message for processor MediaOrderEventSplit"
      }
    } with {
      briefly "MediaOrder event fan-out handler"
      described as {
        |Delivers each MediaOrder event to all of its consumers.
      }
    }
  } with {
    briefly "MediaOrder event fan-out"
    described as {
      |Fans MediaOrder events out to the repository and projectors.
    }
  }
  connector 'MediaOrderEvent Stream' is from outlet MediaBuyingContext.MediaOrder.MediaOrderEvents2 to inlet MediaBuyingContext.MediaOrderEventSplit.MediaOrderEventSplitIn with {
    briefly "MediaOrder events, fanned out to storage and read models"
  }
  connector 'MediaBuyingMetrics Feed' is from outlet MediaBuyingContext.MediaOrderEventSplit.MediaOrderEventSplitToMediaBuyingMetrics to inlet MediaBuyingContext.MediaBuyingMetrics.MediaBuyingMetricsFromMediaOrder with {
    briefly "MediaOrder events feeding the MediaBuyingMetrics projection"
  }
  connector 'MediaBuyingMetrics Storage' is from outlet MediaBuyingContext.MediaBuyingMetrics.MediaBuyingMetricsToRepository to inlet MediaBuyingContext.MediaBuyingRepository.MediaBuyingRepositoryFromMediaBuyingMetrics with {
    briefly "MediaBuyingMetrics updates on their way to storage"
  }
} with {
  briefly "Bounded context for media buying"
  described as {
    |Media buying operations context.
  }
}
