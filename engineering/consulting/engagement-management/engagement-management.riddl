// Engagement Management Domain Model
// Client engagements, project delivery, and consulting operations
domain EngagementManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user EngagementManager is "partner or manager overseeing engagements" with {
    briefly "Engagement Manager"
    described as {
      |Person responsible for client engagements.
    }
  }
  user Consultant is "consultant delivering services" with {
    briefly "Consultant"
    described as {
      |Person performing consulting work.
    }
  }
  user ClientContact is "client stakeholder" with {
    briefly "Client Contact"
    described as {
      |Client representative on the engagement.
    }
  }
  epic EngagementDeliveryEpic is {
    user EngagementManager wants to "to manage client engagements successfully" so that "projects are delivered on time and within budget"
    case InitiateEngagement is {
      user EngagementManager wants to "to initiate a new client engagement" so that "the team can begin delivery"
      step is "Manager creates" "engagement record" "with scope and timeline" with {
        briefly "Create engagement"
        described as {
          |Set up engagement.
        }
      }
      step is "System assigns" "team members" "based on skills needed" with {
        briefly "Assign team"
        described as {
          |Staff the engagement.
        }
      }
      step take input EngagementManagementApp.EngagementManagementScreen.StartEngagementInput from user EngagementManager with {
        briefly "Start"
        described as {
          |Begin engagement.
        }
      }
      step is "System notifies" "stakeholders" "of engagement kickoff" with {
        briefly "Notify"
        described as {
          |Alert stakeholders.
        }
      }
    } with {
      briefly "Engagement initiation workflow"
      described as {
        |Standard flow for starting engagements.
      }
    }
  } with {
    briefly "Engagement delivery processing"
    described as {
      | Epic covering engagement lifecycle from setup
      | through delivery and completion.
    }
  }
  include "EngagementContext.riddl"
  include "external-contexts.riddl"
  application context EngagementManagementApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EngagementManagement are delivered.
      }
    }
    group EngagementManagementScreen is {
      input StartEngagementInput acquires command EngagementContext.Engagement.StartEngagement with {
        briefly "Start engagement control"
        described as {
          |The control through which a user submits the start engagement request.
        }
      }
    } with {
      briefly "Engagement management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppEngagementCommands is type EngagementContext.Engagement.EngagementCommand
    inlet AppEngagementRepositoryResponses is result EngagementContext.Engagement.EngagementResult    handler EngagementManagementAppHandler is {
      on other is {
        error "Unexpected message for application context EngagementManagementApp"
      }
    } with {
      briefly "EngagementManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EngagementManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'EngagementCommand Stream' is from outlet EngagementManagementApp.AppEngagementCommands to inlet EngagementContext.EngagementCommandStreamIn with {
    briefly "Engagement commands from the application"
  }
  persistent connector 'EngagementQueryResult Stream' is from outlet EngagementContext.EngagementQueryResultStreamOut to inlet EngagementManagementApp.AppEngagementRepositoryResponses with {
    briefly "Engagement query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EngagementManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Engagement management domain"
  described as {
    | The EngagementManagement domain handles client engagements,
    | project delivery, staffing, and consulting operations.
  }
}
