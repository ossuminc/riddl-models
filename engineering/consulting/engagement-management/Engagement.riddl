// Engagement Management - Engagement Entity
entity Engagement as flow is {
  type EngagementCommand is one of {
    Engagement.CreateEngagement or Engagement.UpdateEngagement or Engagement.ApproveEngagement or Engagement.StartEngagement or Engagement.AssignTeamMember or Engagement.RemoveTeamMember or Engagement.AddDeliverable or Engagement.UpdateDeliverableStatus or Engagement.AddMilestone or Engagement.CompleteMilestone or Engagement.RecordTime or Engagement.ApproveTimeEntry or Engagement.PutOnHold or Engagement.ResumeEngagement or Engagement.CompleteEngagement
  } with {
    briefly "Engagement command alternation"
    described as {
      |Commands accepted by the Engagement entity.
    }
  }
  inlet EngagementCommands is type EngagementCommand  outlet EngagementEvents2 is type EngagementEvent
  query GetEngagement replies result EngagementResult is {
    engagementId: EngagementId with {
      briefly "ID"
      described as {
        |Identifier of the Engagement to retrieve.
      }
    }
  } with {
    briefly "Get Engagement"
    described as {
      |Retrieve Engagement data by identifier.
    }
  }
  result EngagementResult is  {
    engagementId: EngagementId with {
      briefly "Engagement addressed"
      described as {
        |Which engagement this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    engagementData: Engagement.ProposalStateData with {
      briefly "Engagement data"
      described as {
        |The requested Engagement data.
      }
    }
  } with {
    briefly "Engagement result"
    described as {
      |Result carrying the requested Engagement data.
    }
  }
  // Commands
  command CreateEngagement is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |New engagement identifier.
      }
    }
    info: EngagementInfo with {
      briefly "Info"
      described as {
        |Engagement information.
      }
    }
    clientInfo: ClientInfo with {
      briefly "Client"
      described as {
        |Client details.
      }
    }
  } with {
    briefly "Create engagement"
    described as {
      |Creates a new client engagement.
    }
  }
  command UpdateEngagement is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement to update.
      }
    }
    info: EngagementInfo with {
      briefly "Info"
      described as {
        |Updated information.
      }
    }
  } with {
    briefly "Update engagement"
    described as {
      |Updates engagement details.
    }
  }
  command ApproveEngagement is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement to approve.
      }
    }
    approvedBy: String(1,200) with {
      briefly "Approved by"
      described as {
        |Approver name.
      }
    }
  } with {
    briefly "Approve engagement"
    described as {
      |Approves engagement to proceed.
    }
  }
  command StartEngagement is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement to start.
      }
    }
  } with {
    briefly "Start engagement"
    described as {
      |Begins active delivery.
    }
  }
  command AssignTeamMember is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    assignment: TeamAssignment with {
      briefly "Assignment"
      described as {
        |Team assignment.
      }
    }
  } with {
    briefly "Assign team member"
    described as {
      |Assigns consultant to engagement.
    }
  }
  command RemoveTeamMember is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    consultantId: ConsultantId with {
      briefly "Consultant"
      described as {
        |Consultant to remove.
      }
    }
  } with {
    briefly "Remove team member"
    described as {
      |Removes consultant from engagement.
    }
  }
  command AddDeliverable is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    deliverable: Deliverable with {
      briefly "Deliverable"
      described as {
        |Deliverable to add.
      }
    }
  } with {
    briefly "Add deliverable"
    described as {
      |Adds deliverable to engagement.
    }
  }
  command UpdateDeliverableStatus is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    deliverableId: DeliverableId with {
      briefly "Deliverable ID"
      described as {
        |Deliverable to update.
      }
    }
    status: DeliverableStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
  } with {
    briefly "Update deliverable"
    described as {
      |Updates deliverable status.
    }
  }
  command AddMilestone is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    milestone: Milestone with {
      briefly "Milestone"
      described as {
        |Milestone to add.
      }
    }
  } with {
    briefly "Add milestone"
    described as {
      |Adds milestone to engagement.
    }
  }
  command CompleteMilestone is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    milestoneId: MilestoneId with {
      briefly "Milestone ID"
      described as {
        |Milestone to complete.
      }
    }
  } with {
    briefly "Complete milestone"
    described as {
      |Marks milestone as completed.
    }
  }
  command RecordTime is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    entry: TimeEntry with {
      briefly "Entry"
      described as {
        |Time entry.
      }
    }
  } with {
    briefly "Record time"
    described as {
      |Records consultant time.
    }
  }
  command ApproveTimeEntry is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    entryId: UUID with {
      briefly "Entry ID"
      described as {
        |Entry to approve.
      }
    }
  } with {
    briefly "Approve time"
    described as {
      |Approves time entry.
    }
  }
  command PutOnHold is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
  } with {
    briefly "Put on hold"
    described as {
      |Puts engagement on hold.
    }
  }
  command ResumeEngagement is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement to resume.
      }
    }
  } with {
    briefly "Resume engagement"
    described as {
      |Resumes held engagement.
    }
  }
  command CompleteEngagement is  {
    engagementId: EngagementId with {
      briefly "Engagement ID"
      described as {
        |Engagement to complete.
      }
    }
    summary: String(1,2000)? with {
      briefly "Summary"
      described as {
        |Completion summary.
      }
    }
  } with {
    briefly "Complete engagement"
    described as {
      |Marks engagement as completed.
    }
  }
  // Events
  event EngagementCreated is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    info: EngagementInfo with {
      briefly "Info"
      described as {
        |Engagement info.
      }
    }
    clientInfo: ClientInfo with {
      briefly "Client"
      described as {
        |Client info.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Engagement was created"
    described as {
      |Emitted when engagement is created.
    }
  }
  event EngagementUpdated is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    info: EngagementInfo with {
      briefly "Info"
      described as {
        |Updated info.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Engagement was updated"
    described as {
      |Emitted when engagement is updated.
    }
  }
  event EngagementApproved is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    approvedBy: String(1,200) with {
      briefly "Approved by"
      described as {
        |Approver.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Engagement was approved"
    described as {
      |Emitted when engagement is approved.
    }
  }
  event EngagementStarted is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Engagement was started"
    described as {
      |Emitted when delivery begins.
    }
  }
  event TeamMemberAssigned is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    assignment: TeamAssignment with {
      briefly "Assignment"
      described as {
        |Team assignment.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned"
      described as {
        |Assignment time.
      }
    }
  } with {
    briefly "Team member was assigned"
    described as {
      |Emitted when consultant is assigned.
    }
  }
  event TeamMemberRemoved is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    consultantId: ConsultantId with {
      briefly "Consultant"
      described as {
        |Removed consultant.
      }
    }
    removedAt: TimeStamp with {
      briefly "Removed"
      described as {
        |Removal time.
      }
    }
  } with {
    briefly "Team member was removed"
    described as {
      |Emitted when consultant is removed.
    }
  }
  event DeliverableAdded is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    deliverable: Deliverable with {
      briefly "Deliverable"
      described as {
        |Added deliverable.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "Deliverable was added"
    described as {
      |Emitted when deliverable is added.
    }
  }
  event DeliverableStatusUpdated is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    deliverableId: DeliverableId with {
      briefly "Deliverable"
      described as {
        |Deliverable ID.
      }
    }
    status: DeliverableStatus with {
      briefly "Status"
      described as {
        |New status.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Deliverable status was updated"
    described as {
      |Emitted when deliverable status changes.
    }
  }
  event MilestoneAdded is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    milestone: Milestone with {
      briefly "Milestone"
      described as {
        |Added milestone.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Add time.
      }
    }
  } with {
    briefly "Milestone was added"
    described as {
      |Emitted when milestone is added.
    }
  }
  event MilestoneCompleted is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    milestoneId: MilestoneId with {
      briefly "Milestone"
      described as {
        |Milestone ID.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Milestone was completed"
    described as {
      |Emitted when milestone is completed.
    }
  }
  event TimeRecorded is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    entry: TimeEntry with {
      briefly "Entry"
      described as {
        |Time entry.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Time was recorded"
    described as {
      |Emitted when time is logged.
    }
  }
  event TimeEntryApproved is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    entryId: UUID with {
      briefly "Entry"
      described as {
        |Entry ID.
      }
    }
    approvedAt: TimeStamp with {
      briefly "Approved"
      described as {
        |Approval time.
      }
    }
  } with {
    briefly "Time entry was approved"
    described as {
      |Emitted when time is approved.
    }
  }
  event EngagementPutOnHold is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Hold reason.
      }
    }
    heldAt: TimeStamp with {
      briefly "Held"
      described as {
        |Hold time.
      }
    }
  } with {
    briefly "Engagement was put on hold"
    described as {
      |Emitted when engagement is paused.
    }
  }
  event EngagementResumed is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    resumedAt: TimeStamp with {
      briefly "Resumed"
      described as {
        |Resume time.
      }
    }
  } with {
    briefly "Engagement was resumed"
    described as {
      |Emitted when engagement resumes.
    }
  }
  event EngagementCompleted is  {
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    summary: String(1,2000)? with {
      briefly "Summary"
      described as {
        |Completion summary.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Engagement was completed"
    described as {
      |Emitted when engagement finishes.
    }
  }
  // State Records
  record ProposalStateData is  {
    stateValue: EngagementStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    info: EngagementInfo with {
      briefly "Info"
      described as {
        |Engagement info.
      }
    }
    clientInfo: ClientInfo with {
      briefly "Client"
      described as {
        |Client info.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Proposal state data"
    described as {
      |State data for proposal stage.
    }
  }
  record ActiveStateData is  {
    stateValue: EngagementStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    info: EngagementInfo with {
      briefly "Info"
      described as {
        |Engagement info.
      }
    }
    clientInfo: ClientInfo with {
      briefly "Client"
      described as {
        |Client info.
      }
    }
    team: TeamAssignment+ with {
      briefly "Team"
      described as {
        |Team assignments.
      }
    }
    deliverables: Deliverable+ with {
      briefly "Deliverables"
      described as {
        |Deliverables.
      }
    }
    milestones: Milestone+ with {
      briefly "Milestones"
      described as {
        |Milestones.
      }
    }
    timeEntries: TimeEntry+ with {
      briefly "Time"
      described as {
        |Time entries.
      }
    }
    financials: EngagementFinancials with {
      briefly "Financials"
      described as {
        |Financial data.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Active state data"
    described as {
      |State data for active engagement.
    }
  }
  record CompletedStateData is  {
    stateValue: EngagementStatus with {
      briefly "State value"
      described as {
        |The enumeration value naming the state this record represents.
      }
    }
    engagementId: EngagementId with {
      briefly "Engagement"
      described as {
        |Engagement ID.
      }
    }
    info: EngagementInfo with {
      briefly "Info"
      described as {
        |Engagement info.
      }
    }
    clientInfo: ClientInfo with {
      briefly "Client"
      described as {
        |Client info.
      }
    }
    financials: EngagementFinancials with {
      briefly "Financials"
      described as {
        |Final financials.
      }
    }
    summary: String(1,2000)? with {
      briefly "Summary"
      described as {
        |Completion summary.
      }
    }
    completedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Completed state data"
    described as {
      |State data for completed engagement.
    }
  }
  // States
  initial state ProposalState of record Engagement.ProposalStateData is {
    initial handler ProposalStateInitHandler is {
      on query GetEngagement is {
        let engagementResult: type EngagementResult = prompt("read the engagement from the store")
        reply engagementResult
      }
      on init is {
        set state ProposalState to "initialize from prior event"
        set field ProposalStateData.stateValue to "Proposal"
      }
    } with {
      briefly "ProposalState init handler"
      described as {
        |Initializes the ProposalState state.
      }
    }
  } with {
    briefly "ProposalState state"
    described as {
      |The ProposalState state of the Engagement.
    }
  }
  state ActiveState of record Engagement.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from prior event"
        set field ActiveStateData.stateValue to "Active"
      }
    } with {
      briefly "ActiveState init handler"
      described as {
        |Initializes the ActiveState state.
      }
    }
  } with {
    briefly "ActiveState state"
    described as {
      |The ActiveState state of the Engagement.
    }
  }
  state CompletedState of record Engagement.CompletedStateData is {
    initial handler CompletedStateInitHandler is {
      on init is {
        set state CompletedState to "initialize from prior event"
        set field CompletedStateData.stateValue to "Completed"
      }
    } with {
      briefly "CompletedState init handler"
      described as {
        |Initializes the CompletedState state.
      }
    }
  } with {
    briefly "CompletedState state"
    described as {
      |The CompletedState state of the Engagement.
    }
  }
  // Handler
  handler EngagementHandler is {
    on createEngagement: command CreateEngagement is {
      morph entity EngagementContext.Engagement to state EngagementContext.Engagement.ProposalState with record Engagement.ProposalStateData(engagementId = createEngagement.engagementId, info = createEngagement.info, clientInfo = createEngagement.clientInfo, stateValue = prompt("the state value of this proposal state data"), createdAt = prompt("the created at of this proposal state data"))
      tell event EngagementCreated(engagementId = createEngagement.engagementId, info = createEngagement.info, clientInfo = createEngagement.clientInfo, createdAt = prompt("the created at of this engagement created")) to entity EngagementContext.Engagement
    }
    on updateEngagement: command UpdateEngagement is {
      tell event EngagementUpdated(engagementId = updateEngagement.engagementId, info = updateEngagement.info, updatedAt = prompt("the updated at of this engagement updated")) to entity EngagementContext.Engagement
    }
    on approveEngagement: command ApproveEngagement is {
      tell event EngagementApproved(engagementId = approveEngagement.engagementId, approvedBy = approveEngagement.approvedBy, approvedAt = prompt("the approved at of this engagement approved")) to entity EngagementContext.Engagement
    }
    on startEngagement: command StartEngagement is {
      morph entity EngagementContext.Engagement to state EngagementContext.Engagement.ActiveState with record Engagement.ActiveStateData(engagementId = startEngagement.engagementId, stateValue = prompt("the state value of this active state data"), info = prompt("the info of this active state data"), clientInfo = prompt("the client info of this active state data"), team = prompt("the team of this active state data"), deliverables = prompt("the deliverables of this active state data"), milestones = prompt("the milestones of this active state data"), timeEntries = prompt("the time entries of this active state data"), financials = prompt("the financials of this active state data"), startedAt = prompt("the started at of this active state data"))
      tell event EngagementStarted(engagementId = startEngagement.engagementId, startedAt = prompt("the started at of this engagement started")) to entity EngagementContext.Engagement
    }
    on assignTeamMember: command AssignTeamMember is {
      tell event TeamMemberAssigned(engagementId = assignTeamMember.engagementId, assignment = assignTeamMember.assignment, assignedAt = prompt("the assigned at of this team member assigned")) to entity EngagementContext.Engagement
    }
    on removeTeamMember: command RemoveTeamMember is {
      tell event TeamMemberRemoved(engagementId = removeTeamMember.engagementId, consultantId = removeTeamMember.consultantId, removedAt = prompt("the removed at of this team member removed")) to entity EngagementContext.Engagement
    }
    on addDeliverable: command AddDeliverable is {
      tell event DeliverableAdded(engagementId = addDeliverable.engagementId, deliverable = addDeliverable.deliverable, addedAt = prompt("the added at of this deliverable added")) to entity EngagementContext.Engagement
    }
    on updateDeliverableStatus: command UpdateDeliverableStatus is {
      tell event DeliverableStatusUpdated(engagementId = updateDeliverableStatus.engagementId, deliverableId = updateDeliverableStatus.deliverableId, status = updateDeliverableStatus.status, updatedAt = prompt("the updated at of this deliverable status updated")) to entity EngagementContext.Engagement
    }
    on addMilestone: command AddMilestone is {
      tell event MilestoneAdded(engagementId = addMilestone.engagementId, milestone = addMilestone.milestone, addedAt = prompt("the added at of this milestone added")) to entity EngagementContext.Engagement
    }
    on completeMilestone: command CompleteMilestone is {
      tell event MilestoneCompleted(engagementId = completeMilestone.engagementId, milestoneId = completeMilestone.milestoneId, completedAt = prompt("the completed at of this milestone completed")) to entity EngagementContext.Engagement
    }
    on recordTime: command RecordTime is {
      tell event TimeRecorded(engagementId = recordTime.engagementId, entry = recordTime.entry, recordedAt = prompt("the recorded at of this time recorded")) to entity EngagementContext.Engagement
    }
    on approveTimeEntry: command ApproveTimeEntry is {
      tell event TimeEntryApproved(engagementId = approveTimeEntry.engagementId, entryId = approveTimeEntry.entryId, approvedAt = prompt("the approved at of this time entry approved")) to entity EngagementContext.Engagement
    }
    on putOnHold: command PutOnHold is {
      tell event EngagementPutOnHold(engagementId = putOnHold.engagementId, reason = putOnHold.reason, heldAt = prompt("the held at of this engagement put on hold")) to entity EngagementContext.Engagement
    }
    on resumeEngagement: command ResumeEngagement is {
      tell event EngagementResumed(engagementId = resumeEngagement.engagementId, resumedAt = prompt("the resumed at of this engagement resumed")) to entity EngagementContext.Engagement
    }
    on completeEngagement: command CompleteEngagement is {
      morph entity EngagementContext.Engagement to state EngagementContext.Engagement.CompletedState with record Engagement.CompletedStateData(engagementId = completeEngagement.engagementId, summary = completeEngagement.summary, stateValue = prompt("the state value of this completed state data"), info = prompt("the info of this completed state data"), clientInfo = prompt("the client info of this completed state data"), financials = prompt("the financials of this completed state data"), completedAt = prompt("the completed at of this completed state data"))
      tell event EngagementCompleted(engagementId = completeEngagement.engagementId, summary = completeEngagement.summary, completedAt = prompt("the completed at of this engagement completed")) to entity EngagementContext.Engagement
    }
      on deliverableAdded: event DeliverableAdded is {
      do "apply DeliverableAdded to the engagement so it can be persisted and replayed"
    }
    on deliverableStatusUpdated: event DeliverableStatusUpdated is {
      do "apply DeliverableStatusUpdated to the engagement so it can be persisted and replayed"
    }
    on engagementApproved: event EngagementApproved is {
      do "apply EngagementApproved to the engagement so it can be persisted and replayed"
    }
    on engagementCompleted: event EngagementCompleted is {
      do "apply EngagementCompleted to the engagement so it can be persisted and replayed"
    }
    on engagementCreated: event EngagementCreated is {
      do "apply EngagementCreated to the engagement so it can be persisted and replayed"
    }
    on engagementPutOnHold: event EngagementPutOnHold is {
      do "apply EngagementPutOnHold to the engagement so it can be persisted and replayed"
    }
    on engagementResumed: event EngagementResumed is {
      do "apply EngagementResumed to the engagement so it can be persisted and replayed"
    }
    on engagementStarted: event EngagementStarted is {
      do "apply EngagementStarted to the engagement so it can be persisted and replayed"
    }
    on engagementUpdated: event EngagementUpdated is {
      do "apply EngagementUpdated to the engagement so it can be persisted and replayed"
    }
    on milestoneAdded: event MilestoneAdded is {
      do "apply MilestoneAdded to the engagement so it can be persisted and replayed"
    }
    on milestoneCompleted: event MilestoneCompleted is {
      do "apply MilestoneCompleted to the engagement so it can be persisted and replayed"
    }
    on teamMemberAssigned: event TeamMemberAssigned is {
      do "apply TeamMemberAssigned to the engagement so it can be persisted and replayed"
    }
    on teamMemberRemoved: event TeamMemberRemoved is {
      do "apply TeamMemberRemoved to the engagement so it can be persisted and replayed"
    }
    on timeEntryApproved: event TimeEntryApproved is {
      do "apply TimeEntryApproved to the engagement so it can be persisted and replayed"
    }
    on timeRecorded: event TimeRecorded is {
      do "apply TimeRecorded to the engagement so it can be persisted and replayed"
    }
} with {
    briefly "Processes engagement commands"
    described as {
      | Handles engagement lifecycle including staffing,
      | deliverables, milestones, and time tracking.
    }
  }
} with {
  briefly "Engagement aggregate"
  described as {
    | The Engagement entity manages client engagements
    | including team, deliverables, and financials.
  }
