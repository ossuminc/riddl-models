// Engagement Management - Engagement Context
context EngagementContext as router is {
  inlet EngagementCommandStreamIn is type EngagementCommand  outlet EngagementCommandStreamOut is type EngagementCommand
  inlet EngagementQueryResultStreamIn is result Engagement.EngagementResult  outlet EngagementQueryResultStreamOut is result Engagement.EngagementResult
  handler EngagementContextBoundary is {
    on createEngagement: command Engagement.CreateEngagement is {
      send createEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on updateEngagement: command Engagement.UpdateEngagement is {
      send updateEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on approveEngagement: command Engagement.ApproveEngagement is {
      send approveEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on startEngagement: command Engagement.StartEngagement is {
      send startEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on assignTeamMember: command Engagement.AssignTeamMember is {
      send assignTeamMember to outlet EngagementContext.EngagementCommandStreamOut
    }
    on removeTeamMember: command Engagement.RemoveTeamMember is {
      send removeTeamMember to outlet EngagementContext.EngagementCommandStreamOut
    }
    on addDeliverable: command Engagement.AddDeliverable is {
      send addDeliverable to outlet EngagementContext.EngagementCommandStreamOut
    }
    on updateDeliverableStatus: command Engagement.UpdateDeliverableStatus is {
      send updateDeliverableStatus to outlet EngagementContext.EngagementCommandStreamOut
    }
    on addMilestone: command Engagement.AddMilestone is {
      send addMilestone to outlet EngagementContext.EngagementCommandStreamOut
    }
    on completeMilestone: command Engagement.CompleteMilestone is {
      send completeMilestone to outlet EngagementContext.EngagementCommandStreamOut
    }
    on recordTime: command Engagement.RecordTime is {
      send recordTime to outlet EngagementContext.EngagementCommandStreamOut
    }
    on approveTimeEntry: command Engagement.ApproveTimeEntry is {
      send approveTimeEntry to outlet EngagementContext.EngagementCommandStreamOut
    }
    on putOnHold: command Engagement.PutOnHold is {
      send putOnHold to outlet EngagementContext.EngagementCommandStreamOut
    }
    on resumeEngagement: command Engagement.ResumeEngagement is {
      send resumeEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on completeEngagement: command Engagement.CompleteEngagement is {
      send completeEngagement to outlet EngagementContext.EngagementCommandStreamOut
    }
    on engagementResult: result Engagement.EngagementResult is {
      send engagementResult to outlet EngagementContext.EngagementQueryResultStreamOut
    }
    on other is {
      error "Unexpected message at the EngagementContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'EngagementCommand Stream Intake' is from outlet EngagementContext.EngagementCommandStreamOut to inlet EngagementContext.Engagement.EngagementCommands  connector 'EngagementQueryResult Stream Egress' is from outlet EngagementContext.EngagementRepository.EngagementRepositoryResponses to inlet EngagementContext.EngagementQueryResultStreamIn  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.InvoiceCreated is {
        do "the model receives invoice created"
      }
      on event BillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.CreateInvoice is {
        do "the model sends create invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCRMService from context CRMService is { 
    handler FromCRMServiceHandler is {
      on event CRMService.ClientCreated is {
        do "the model receives client created"
      }
      on event CRMService.ClientUpdated is {
        do "the model receives client updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMService"
      }
    } with {
      briefly "from crm service"
      described as {
        |Carries messages from the external CRMService.
      }
    }
  } with {
    briefly "CRMService integration"
    described as {
      |The model's side of the CRMService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService is { 
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is { 
    handler ToDocumentServiceHandler is {
      on command DocumentService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendMilestoneReminder is {
        do "the model sends send milestone reminder"
      }
      on command NotificationService.SendStatusUpdate is {
        do "the model sends send status update"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromResourceService from context ResourceService is { 
    handler FromResourceServiceHandler is {
      on event ResourceService.AvailabilityConfirmed is {
        do "the model receives availability confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromResourceService"
      }
    } with {
      briefly "from resource service"
      described as {
        |Carries messages from the external ResourceService.
      }
    }
  } with {
    briefly "ResourceService integration"
    described as {
      |The model's side of the ResourceService conversation.
    }
  }
  adaptor ToResourceService to context ResourceService is { 
    handler ToResourceServiceHandler is {
      on command ResourceService.CheckAvailability is {
        do "the model sends check availability"
      }
      on other is {
        error "Unexpected message for adaptor ToResourceService"
      }
    } with {
      briefly "to resource service"
      described as {
        |Carries messages to the external ResourceService.
      }
    }
  } with {
    briefly "ResourceService integration"
    described as {
      |The model's side of the ResourceService conversation.
    }
  }
  include "types.riddl"
  include "Engagement.riddl"
  // Repository for engagement persistence
  type EngagementRepositoryCommand is one of {
    EngagementContext.EngagementRepository.PersistDeliverableAdded or EngagementContext.EngagementRepository.PersistDeliverableStatusUpdated or EngagementContext.EngagementRepository.PersistEngagementApproved or EngagementContext.EngagementRepository.PersistEngagementCompleted or EngagementContext.EngagementRepository.PersistEngagementCreated or EngagementContext.EngagementRepository.PersistEngagementPutOnHold or EngagementContext.EngagementRepository.PersistEngagementResumed or EngagementContext.EngagementRepository.PersistEngagementStarted or EngagementContext.EngagementRepository.PersistEngagementUpdated or EngagementContext.EngagementRepository.PersistMilestoneAdded or EngagementContext.EngagementRepository.PersistMilestoneCompleted or EngagementContext.EngagementRepository.PersistTeamMemberAssigned or EngagementContext.EngagementRepository.PersistTeamMemberRemoved or EngagementContext.EngagementRepository.PersistTimeEntryApproved or EngagementContext.EngagementRepository.PersistTimeRecorded
  } with {
    briefly "Anything that writes EngagementRepository"
    described as {
      |The persistence commands EngagementRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository EngagementRepository as flow is {
    inlet EngagementRepositoryFromEngagementAnalytics is type EngagementRepositoryCommand    command PersistDeliverableAdded is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliverableAdded applies to.
        }
      }
    } with {
      briefly "Persist DeliverableAdded"
      described as {
        |Instructs this repository to apply DeliverableAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDeliverableStatusUpdated is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row DeliverableStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist DeliverableStatusUpdated"
      described as {
        |Instructs this repository to apply DeliverableStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementApproved is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementApproved applies to.
        }
      }
    } with {
      briefly "Persist EngagementApproved"
      described as {
        |Instructs this repository to apply EngagementApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementPutOnHold is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementPutOnHold applies to.
        }
      }
    } with {
      briefly "Persist EngagementPutOnHold"
      described as {
        |Instructs this repository to apply EngagementPutOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementResumed is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementResumed applies to.
        }
      }
    } with {
      briefly "Persist EngagementResumed"
      described as {
        |Instructs this repository to apply EngagementResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementUpdated is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementUpdated applies to.
        }
      }
    } with {
      briefly "Persist EngagementUpdated"
      described as {
        |Instructs this repository to apply EngagementUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneAdded is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneAdded applies to.
        }
      }
    } with {
      briefly "Persist MilestoneAdded"
      described as {
        |Instructs this repository to apply MilestoneAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneCompleted is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneCompleted applies to.
        }
      }
    } with {
      briefly "Persist MilestoneCompleted"
      described as {
        |Instructs this repository to apply MilestoneCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamMemberAssigned is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamMemberAssigned applies to.
        }
      }
    } with {
      briefly "Persist TeamMemberAssigned"
      described as {
        |Instructs this repository to apply TeamMemberAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTeamMemberRemoved is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row TeamMemberRemoved applies to.
        }
      }
    } with {
      briefly "Persist TeamMemberRemoved"
      described as {
        |Instructs this repository to apply TeamMemberRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimeRecorded is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimeRecorded applies to.
        }
      }
    } with {
      briefly "Persist TimeRecorded"
      described as {
        |Instructs this repository to apply TimeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementCompleted is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementCompleted applies to.
        }
      }
    } with {
      briefly "Persist EngagementCompleted"
      described as {
        |Instructs this repository to apply EngagementCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementCreated is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementCreated applies to.
        }
      }
    } with {
      briefly "Persist EngagementCreated"
      described as {
        |Instructs this repository to apply EngagementCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistEngagementStarted is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row EngagementStarted applies to.
        }
      }
    } with {
      briefly "Persist EngagementStarted"
      described as {
        |Instructs this repository to apply EngagementStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimeEntryApproved is  {
      engagementId: EngagementId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimeEntryApproved applies to.
        }
      }
    } with {
      briefly "Persist TimeEntryApproved"
      described as {
        |Instructs this repository to apply TimeEntryApproved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet EngagementRepositoryResponses is result Engagement.EngagementResult
    record StoredEngagement is  {
      engagementId: EngagementId with {
        briefly "engagementId"
        described as {
          |The engagementId column of the stored engagement row.
        }
      }
      clientInfo: ClientInfo with {
        briefly "clientInfo"
        described as {
          |The clientInfo column of the stored engagement row.
        }
      }
    } with {
      briefly "Stored engagement row"
      described as {
        |The persistence shape of engagement data as this repository stores it.
      }
    }
    schema EngagementData is relational
      of engagements as record StoredEngagement
        index on field StoredEngagement.engagementId
        index on field StoredEngagement.clientInfo.clientId
 with {
      briefly "Engagement data schema"
      described as {
        |The relational schema holding engagement data for the EngagementRepository.
      }
    }
    handler EngagementPersistence is {
      on persistDeliverableAdded: command PersistDeliverableAdded is {
        do "apply DeliverableAdded to the stored row"
      }
      on persistDeliverableStatusUpdated: command PersistDeliverableStatusUpdated is {
        do "apply DeliverableStatusUpdated to the stored row"
      }
      on persistEngagementApproved: command PersistEngagementApproved is {
        do "apply EngagementApproved to the stored row"
      }
      on persistEngagementPutOnHold: command PersistEngagementPutOnHold is {
        do "apply EngagementPutOnHold to the stored row"
      }
      on persistEngagementResumed: command PersistEngagementResumed is {
        do "apply EngagementResumed to the stored row"
      }
      on persistEngagementUpdated: command PersistEngagementUpdated is {
        do "apply EngagementUpdated to the stored row"
      }
      on persistMilestoneAdded: command PersistMilestoneAdded is {
        do "apply MilestoneAdded to the stored row"
      }
      on persistMilestoneCompleted: command PersistMilestoneCompleted is {
        do "apply MilestoneCompleted to the stored row"
      }
      on persistTeamMemberAssigned: command PersistTeamMemberAssigned is {
        do "apply TeamMemberAssigned to the stored row"
      }
      on persistTeamMemberRemoved: command PersistTeamMemberRemoved is {
        do "apply TeamMemberRemoved to the stored row"
      }
      on persistTimeRecorded: command PersistTimeRecorded is {
        do "apply TimeRecorded to the stored row"
      }
      on persistEngagementCompleted: command PersistEngagementCompleted is {
        do "apply EngagementCompleted to the stored row"
      }
      on persistEngagementCreated: command PersistEngagementCreated is {
        do "apply EngagementCreated to the stored row"
      }
      on persistEngagementStarted: command PersistEngagementStarted is {
        do "apply EngagementStarted to the stored row"
      }
      on persistTimeEntryApproved: command PersistTimeEntryApproved is {
        do "apply TimeEntryApproved to the stored row"
      }
      on query GetEngagementStats is {
        let engagementStatsView: type EngagementStatsView = prompt("read the engagement stats projection")
        reply engagementStatsView
      }
    } with {
      briefly "Persists engagement commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Engagement data persistence"
    described as {
      | The EngagementRepository provides persistent storage for
      | engagements, team assignments, and time entries.
    }
  }
  // Projector for engagement analytics
  query GetEngagementStats replies result EngagementStatsView is  {
    engagementStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which engagement stats to retrieve.
      }
    }
  } with {
    briefly "Get engagement stats"
    described as {
      |Retrieves the engagement stats projection.
    }
  }
  result EngagementStatsView is  {
    engagementStats: EngagementAnalytics.EngagementStats with {
      briefly "Engagement stats"
      described as {
        |The engagement stats being returned.
      }
    }
  } with {
    briefly "Engagement stats view"
    described as {
      |Read model view carrying the engagement stats projection.
    }
  }
  projector EngagementAnalytics as flow is {
    updates repository EngagementContext.EngagementRepository
    outlet EngagementAnalyticsToRepository is type EngagementRepositoryCommand
    inlet EngagementAnalyticsFromEngagement is type EngagementEvent    record EngagementStats is  {
      clientId: ClientId with {
        briefly "Client"
        described as {
          |Client ID.
        }
      }
      totalEngagements: Natural with {
        briefly "Total"
        described as {
          |Total engagements.
        }
      }
      activeEngagements: Natural with {
        briefly "Active"
        described as {
          |Active count.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageMargin: Decimal(5,2) with {
        briefly "Margin"
        described as {
          |Average margin.
        }
      }
    } with {
      briefly "Engagement statistics"
      described as {
        |Client engagement metrics.
      }
    }
    handler AnalyticsHandler is {
      on deliverableAdded: event Engagement.DeliverableAdded is {
        tell command EngagementContext.EngagementRepository.PersistDeliverableAdded(engagementId = deliverableAdded.engagementId) to repository EngagementContext.EngagementRepository
        do "apply DeliverableAdded to the EngagementAnalytics projection"
      }
      on deliverableStatusUpdated: event Engagement.DeliverableStatusUpdated is {
        tell command EngagementContext.EngagementRepository.PersistDeliverableStatusUpdated(engagementId = deliverableStatusUpdated.engagementId) to repository EngagementContext.EngagementRepository
        do "apply DeliverableStatusUpdated to the EngagementAnalytics projection"
      }
      on engagementApproved: event Engagement.EngagementApproved is {
        tell command EngagementContext.EngagementRepository.PersistEngagementApproved(engagementId = engagementApproved.engagementId) to repository EngagementContext.EngagementRepository
        do "apply EngagementApproved to the EngagementAnalytics projection"
      }
      on engagementPutOnHold: event Engagement.EngagementPutOnHold is {
        tell command EngagementContext.EngagementRepository.PersistEngagementPutOnHold(engagementId = engagementPutOnHold.engagementId) to repository EngagementContext.EngagementRepository
        do "apply EngagementPutOnHold to the EngagementAnalytics projection"
      }
      on engagementResumed: event Engagement.EngagementResumed is {
        tell command EngagementContext.EngagementRepository.PersistEngagementResumed(engagementId = engagementResumed.engagementId) to repository EngagementContext.EngagementRepository
        do "apply EngagementResumed to the EngagementAnalytics projection"
      }
      on engagementUpdated: event Engagement.EngagementUpdated is {
        tell command EngagementContext.EngagementRepository.PersistEngagementUpdated(engagementId = engagementUpdated.engagementId) to repository EngagementContext.EngagementRepository
        do "apply EngagementUpdated to the EngagementAnalytics projection"
      }
      on milestoneAdded: event Engagement.MilestoneAdded is {
        tell command EngagementContext.EngagementRepository.PersistMilestoneAdded(engagementId = milestoneAdded.engagementId) to repository EngagementContext.EngagementRepository
        do "apply MilestoneAdded to the EngagementAnalytics projection"
      }
      on milestoneCompleted: event Engagement.MilestoneCompleted is {
        tell command EngagementContext.EngagementRepository.PersistMilestoneCompleted(engagementId = milestoneCompleted.engagementId) to repository EngagementContext.EngagementRepository
        do "apply MilestoneCompleted to the EngagementAnalytics projection"
      }
      on teamMemberAssigned: event Engagement.TeamMemberAssigned is {
        tell command EngagementContext.EngagementRepository.PersistTeamMemberAssigned(engagementId = teamMemberAssigned.engagementId) to repository EngagementContext.EngagementRepository
        do "apply TeamMemberAssigned to the EngagementAnalytics projection"
      }
      on teamMemberRemoved: event Engagement.TeamMemberRemoved is {
        tell command EngagementContext.EngagementRepository.PersistTeamMemberRemoved(engagementId = teamMemberRemoved.engagementId) to repository EngagementContext.EngagementRepository
        do "apply TeamMemberRemoved to the EngagementAnalytics projection"
      }
      on timeRecorded: event Engagement.TimeRecorded is {
        tell command EngagementContext.EngagementRepository.PersistTimeRecorded(engagementId = timeRecorded.engagementId) to repository EngagementContext.EngagementRepository
        do "apply TimeRecorded to the EngagementAnalytics projection"
      }
      on engagementCreated: event Engagement.EngagementCreated is {
        tell command EngagementContext.EngagementRepository.PersistEngagementCreated(engagementId = engagementCreated.engagementId) to repository EngagementContext.EngagementRepository
        do "Update engagement counts"
      }
      on engagementStarted: event Engagement.EngagementStarted is {
        tell command EngagementContext.EngagementRepository.PersistEngagementStarted(engagementId = engagementStarted.engagementId) to repository EngagementContext.EngagementRepository
        do "Update active counts"
      }
      on timeEntryApproved: event Engagement.TimeEntryApproved is {
        tell command EngagementContext.EngagementRepository.PersistTimeEntryApproved(engagementId = timeEntryApproved.engagementId) to repository EngagementContext.EngagementRepository
        do "Update utilization metrics"
      }
      on engagementCompleted: event Engagement.EngagementCompleted is {
        tell command EngagementContext.EngagementRepository.PersistEngagementCompleted(engagementId = engagementCompleted.engagementId) to repository EngagementContext.EngagementRepository
        do "Update revenue metrics"
      }
    } with {
      briefly "Maintains engagement analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Engagement analytics projections"
    described as {
      |Maintains engagement analytics data.
    }
  }
  // ---- Event publication for Engagement ----
  type EngagementEvent is one of {
    EngagementContext.Engagement.EngagementCreated or EngagementContext.Engagement.EngagementUpdated or EngagementContext.Engagement.EngagementApproved or EngagementContext.Engagement.EngagementStarted or EngagementContext.Engagement.TeamMemberAssigned or EngagementContext.Engagement.TeamMemberRemoved or EngagementContext.Engagement.DeliverableAdded or EngagementContext.Engagement.DeliverableStatusUpdated or EngagementContext.Engagement.MilestoneAdded or EngagementContext.Engagement.MilestoneCompleted or EngagementContext.Engagement.TimeRecorded or EngagementContext.Engagement.TimeEntryApproved or EngagementContext.Engagement.EngagementPutOnHold or EngagementContext.Engagement.EngagementResumed or EngagementContext.Engagement.EngagementCompleted
  } with {
    briefly "Engagement event alternation"
    described as {
      |Union of all Engagement events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EngagementEventSplit as flow is {
    inlet EngagementEventSplitIn is type EngagementEvent    outlet EngagementEventSplitToEngagementAnalytics is type EngagementEvent
    handler EngagementEventSplitHandler is {
      on engagementCreated: event Engagement.EngagementCreated is {
        send engagementCreated to outlet EngagementEventSplitToEngagementAnalytics
        tell engagementCreated to entity EngagementContext.Engagement
      }
      on engagementUpdated: event Engagement.EngagementUpdated is {
        send engagementUpdated to outlet EngagementEventSplitToEngagementAnalytics
        tell engagementUpdated to entity EngagementContext.Engagement
      }
      on engagementApproved: event Engagement.EngagementApproved is {
        send engagementApproved to outlet EngagementEventSplitToEngagementAnalytics
        tell engagementApproved to entity EngagementContext.Engagement
      }
      on engagementStarted: event Engagement.EngagementStarted is {
        send engagementStarted to outlet EngagementEventSplitToEngagementAnalytics
        tell engagementStarted to entity EngagementContext.Engagement
      }
      on teamMemberAssigned: event Engagement.TeamMemberAssigned is {
        send teamMemberAssigned to outlet EngagementEventSplitToEngagementAnalytics
        tell teamMemberAssigned to entity EngagementContext.Engagement
      }
      on teamMemberRemoved: event Engagement.TeamMemberRemoved is {
        send teamMemberRemoved to outlet EngagementEventSplitToEngagementAnalytics
        tell teamMemberRemoved to entity EngagementContext.Engagement
      }
      on deliverableAdded: event Engagement.DeliverableAdded is {
        send deliverableAdded to outlet EngagementEventSplitToEngagementAnalytics
        tell deliverableAdded to entity EngagementContext.Engagement
      }
      on deliverableStatusUpdated: event Engagement.DeliverableStatusUpdated is {
        send deliverableStatusUpdated to outlet EngagementEventSplitToEngagementAnalytics
        tell deliverableStatusUpdated to entity EngagementContext.Engagement
      }
      on milestoneAdded: event Engagement.MilestoneAdded is {
        send milestoneAdded to outlet EngagementEventSplitToEngagementAnalytics
        tell milestoneAdded to entity EngagementContext.Engagement
      }
      on milestoneCompleted: event Engagement.MilestoneCompleted is {
        send milestoneCompleted to outlet EngagementEventSplitToEngagementAnalytics
        tell milestoneCompleted to entity EngagementContext.Engagement
      }
      on timeRecorded: event Engagement.TimeRecorded is {
        send timeRecorded to outlet EngagementEventSplitToEngagementAnalytics
        tell timeRecorded to entity EngagementContext.Engagement
      }
      on timeEntryApproved: event Engagement.TimeEntryApproved is {
        send timeEntryApproved to outlet EngagementEventSplitToEngagementAnalytics
        tell timeEntryApproved to entity EngagementContext.Engagement
      }
      on engagementPutOnHold: event Engagement.EngagementPutOnHold is {
        send engagementPutOnHold to outlet EngagementEventSplitToEngagementAnalytics
        tell engagementPutOnHold to entity EngagementContext.Engagement
      }
      on engagementResumed: event Engagement.EngagementResumed is {
        send engagementResumed to outlet EngagementEventSplitToEngagementAnalytics
        tell engagementResumed to entity EngagementContext.Engagement
      }
      on engagementCompleted: event Engagement.EngagementCompleted is {
        send engagementCompleted to outlet EngagementEventSplitToEngagementAnalytics
        tell engagementCompleted to entity EngagementContext.Engagement
      }
      on other is {
        error "Unexpected message for processor EngagementEventSplit"
      }
    } with {
      briefly "Engagement event fan-out handler"
      described as {
        |Delivers each Engagement event to all of its consumers.
      }
    }
  } with {
    briefly "Engagement event fan-out"
    described as {
      |Fans Engagement events out to the repository and projectors.
    }
  }
  connector 'EngagementEvent Stream' is from outlet EngagementContext.Engagement.EngagementEvents2 to inlet EngagementContext.EngagementEventSplit.EngagementEventSplitIn with {
    briefly "Engagement events, fanned out to storage and read models"
  }
  connector 'EngagementAnalytics Feed' is from outlet EngagementContext.EngagementEventSplit.EngagementEventSplitToEngagementAnalytics to inlet EngagementContext.EngagementAnalytics.EngagementAnalyticsFromEngagement with {
    briefly "Engagement events feeding the EngagementAnalytics projection"
  }
  connector 'EngagementAnalytics Storage' is from outlet EngagementContext.EngagementAnalytics.EngagementAnalyticsToRepository to inlet EngagementContext.EngagementRepository.EngagementRepositoryFromEngagementAnalytics with {
    briefly "EngagementAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for engagement management"
  described as {
    | The EngagementContext is the bounded context for client
    | engagements, project delivery, and consulting operations.
  }
}
