// Engagement Management - Engagement Context
context EngagementContext is {
  include "types.riddl"
  include "Engagement.riddl"
  // Repository for engagement persistence
  repository EngagementRepository is {
    schema EngagementData is relational
      of engagements as type Engagement
        index on field Engagement.engagementId
        index on field Engagement.clientInfo.clientId

    handler EngagementPersistence is {
      on command Engagement.CreateEngagement is {
        tell event Engagement.EngagementCreated to entity EngagementContext.Engagement
        prompt "Store engagement record"
      }
      on command Engagement.UpdateEngagement is {
        tell event Engagement.EngagementUpdated to entity EngagementContext.Engagement
        prompt "Update engagement info"
      }
      on command Engagement.StartEngagement is {
        tell event Engagement.EngagementStarted to entity EngagementContext.Engagement
        prompt "Update engagement status"
      }
      on command Engagement.AssignTeamMember is {
        tell event Engagement.TeamMemberAssigned to entity EngagementContext.Engagement
        prompt "Store team assignment"
      }
      on command Engagement.AddDeliverable is {
        tell event Engagement.DeliverableAdded to entity EngagementContext.Engagement
        prompt "Store deliverable"
      }
      on command Engagement.CompleteMilestone is {
        tell event Engagement.MilestoneCompleted to entity EngagementContext.Engagement
        prompt "Update milestone status"
      }
      on command Engagement.RecordTime is {
        tell event Engagement.TimeRecorded to entity EngagementContext.Engagement
        prompt "Store time entry"
      }
      on command Engagement.CompleteEngagement is {
        tell event Engagement.EngagementCompleted to entity EngagementContext.Engagement
        prompt "Update completion status"
      }
    } with {
      briefly "Persists engagement commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Engagement data persistence"
    described as {
      | The EngagementRepository provides persistent storage for
      | engagements, team assignments, and time entries.
    }
  }
  // Projector for engagement analytics
  projector EngagementAnalytics is {
    updates repository EngagementContext.EngagementRepository
    record EngagementStats is  {
      clientId: ClientId with {
        briefly "Client"
        described as {
          |Client ID.
        }
      }
      totalEngagements: Natural with {
        briefly "Total"
        described as {
          |Total engagements.
        }
      }
      activeEngagements: Natural with {
        briefly "Active"
        described as {
          |Active count.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageMargin: Decimal(5,2) with {
        briefly "Margin"
        described as {
          |Average margin.
        }
      }
    } with {
      briefly "Engagement statistics"
      described as {
        |Client engagement metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Engagement.EngagementCreated is {
        tell event Engagement.EngagementCreated to repository EngagementContext.EngagementRepository
        prompt "Update engagement counts"
      }
      on event Engagement.EngagementStarted is {
        tell event Engagement.EngagementStarted to repository EngagementContext.EngagementRepository
        prompt "Update active counts"
      }
      on event Engagement.TimeEntryApproved is {
        tell event Engagement.TimeEntryApproved to repository EngagementContext.EngagementRepository
        prompt "Update utilization metrics"
      }
      on event Engagement.EngagementCompleted is {
        tell event Engagement.EngagementCompleted to repository EngagementContext.EngagementRepository
        prompt "Update revenue metrics"
      }
    } with {
      briefly "Maintains engagement analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Engagement analytics projections"
    described as {
      |Maintains engagement analytics data.
    }
  }
  // ---- Event publication for Engagement ----
  type EngagementEvent is one of {
    EngagementContext.Engagement.EngagementCreated,
    EngagementContext.Engagement.EngagementUpdated,
    EngagementContext.Engagement.EngagementApproved,
    EngagementContext.Engagement.EngagementStarted,
    EngagementContext.Engagement.TeamMemberAssigned,
    EngagementContext.Engagement.TeamMemberRemoved,
    EngagementContext.Engagement.DeliverableAdded,
    EngagementContext.Engagement.DeliverableStatusUpdated,
    EngagementContext.Engagement.MilestoneAdded,
    EngagementContext.Engagement.MilestoneCompleted,
    EngagementContext.Engagement.TimeRecorded,
    EngagementContext.Engagement.TimeEntryApproved,
    EngagementContext.Engagement.EngagementPutOnHold,
    EngagementContext.Engagement.EngagementResumed,
    EngagementContext.Engagement.EngagementCompleted
  } with {
    briefly "Engagement event alternation"
    described as {
      |Union of all Engagement events, for streaming and event-sourced
      |persistence.
    }
  }
  source EngagementEventSource is {
    outlet EngagementEvents is type EngagementEvent
    handler EngagementSourceHandler is {
      on event Engagement.EngagementCreated is {
        send event Engagement.EngagementCreated to outlet EngagementEvents
      }
      on event Engagement.EngagementUpdated is {
        send event Engagement.EngagementUpdated to outlet EngagementEvents
      }
      on event Engagement.EngagementApproved is {
        send event Engagement.EngagementApproved to outlet EngagementEvents
      }
      on event Engagement.EngagementStarted is {
        send event Engagement.EngagementStarted to outlet EngagementEvents
      }
      on event Engagement.TeamMemberAssigned is {
        send event Engagement.TeamMemberAssigned to outlet EngagementEvents
      }
      on event Engagement.TeamMemberRemoved is {
        send event Engagement.TeamMemberRemoved to outlet EngagementEvents
      }
      on event Engagement.DeliverableAdded is {
        send event Engagement.DeliverableAdded to outlet EngagementEvents
      }
      on event Engagement.DeliverableStatusUpdated is {
        send event Engagement.DeliverableStatusUpdated to outlet EngagementEvents
      }
      on event Engagement.MilestoneAdded is {
        send event Engagement.MilestoneAdded to outlet EngagementEvents
      }
      on event Engagement.MilestoneCompleted is {
        send event Engagement.MilestoneCompleted to outlet EngagementEvents
      }
      on event Engagement.TimeRecorded is {
        send event Engagement.TimeRecorded to outlet EngagementEvents
      }
      on event Engagement.TimeEntryApproved is {
        send event Engagement.TimeEntryApproved to outlet EngagementEvents
      }
      on event Engagement.EngagementPutOnHold is {
        send event Engagement.EngagementPutOnHold to outlet EngagementEvents
      }
      on event Engagement.EngagementResumed is {
        send event Engagement.EngagementResumed to outlet EngagementEvents
      }
      on event Engagement.EngagementCompleted is {
        send event Engagement.EngagementCompleted to outlet EngagementEvents
      }
      on other is {
        error "Unexpected message for source EngagementEventSource"
      }
    } with {
      briefly "Engagement source handler"
      described as {
        |Publishes Engagement events onto the outlet.
      }
    }
  } with {
    briefly "Engagement event source"
    described as {
      |Publishes Engagement entity events into the streaming topology.
    }
  }
  sink EngagementEventSink is {
    inlet EngagementInlet is type EngagementEvent
    handler EngagementSinkHandler is {
      on event Engagement.EngagementCreated is {
        tell event Engagement.EngagementCreated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementUpdated is {
        tell event Engagement.EngagementUpdated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementApproved is {
        tell event Engagement.EngagementApproved to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementStarted is {
        tell event Engagement.EngagementStarted to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TeamMemberAssigned is {
        tell event Engagement.TeamMemberAssigned to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TeamMemberRemoved is {
        tell event Engagement.TeamMemberRemoved to repository EngagementContext.EngagementRepository
      }
      on event Engagement.DeliverableAdded is {
        tell event Engagement.DeliverableAdded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.DeliverableStatusUpdated is {
        tell event Engagement.DeliverableStatusUpdated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.MilestoneAdded is {
        tell event Engagement.MilestoneAdded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.MilestoneCompleted is {
        tell event Engagement.MilestoneCompleted to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TimeRecorded is {
        tell event Engagement.TimeRecorded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TimeEntryApproved is {
        tell event Engagement.TimeEntryApproved to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementPutOnHold is {
        tell event Engagement.EngagementPutOnHold to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementResumed is {
        tell event Engagement.EngagementResumed to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementCompleted is {
        tell event Engagement.EngagementCompleted to repository EngagementContext.EngagementRepository
      }
      on other is {
        error "Unexpected message for sink EngagementEventSink"
      }
    } with {
      briefly "Engagement sink handler"
      described as {
        |Persists Engagement events via the repository.
      }
    }
  } with {
    briefly "Engagement event sink"
    described as {
      |Receives Engagement events for persistence.
    }
  }
  connector EngagementEventFlow is {
    from outlet EngagementContext.EngagementEventSource.EngagementEvents to
      inlet EngagementContext.EngagementEventSink.EngagementInlet
  } with {
    briefly "Engagement event flow"
    described as {
      |Connects the Engagement source to its sink.
    }
  }
} with {
  briefly "Bounded context for engagement management"
  described as {
    | The EngagementContext is the bounded context for client
    | engagements, project delivery, and consulting operations.
  }
}
