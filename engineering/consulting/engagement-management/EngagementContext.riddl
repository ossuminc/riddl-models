// Engagement Management - Engagement Context
context EngagementContext is {
  adaptor FromBillingService from context BillingService is {
    handler FromBillingServiceHandler is {
      on event BillingService.InvoiceCreated is {
        do "the model receives invoice created"
      }
      on event BillingService.PaymentReceived is {
        do "the model receives payment received"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
      briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is {
    handler ToBillingServiceHandler is {
      on command BillingService.CreateInvoice is {
        do "the model sends create invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
      briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCRMService from context CRMService is {
    handler FromCRMServiceHandler is {
      on event CRMService.ClientCreated is {
        do "the model receives client created"
      }
      on event CRMService.ClientUpdated is {
        do "the model receives client updated"
      }
      on other is {
        error "Unexpected message for adaptor FromCRMService"
      }
    } with {
      briefly "from crm service"
      described as {
        |Carries messages from the external CRMService.
      }
    }
  } with {
      briefly "CRMService integration"
    described as {
      |The model's side of the CRMService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService is {
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
      briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is {
    handler ToDocumentServiceHandler is {
      on command DocumentService.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
      briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendMilestoneReminder is {
        do "the model sends send milestone reminder"
      }
      on command NotificationService.SendStatusUpdate is {
        do "the model sends send status update"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromResourceService from context ResourceService is {
    handler FromResourceServiceHandler is {
      on event ResourceService.AvailabilityConfirmed is {
        do "the model receives availability confirmed"
      }
      on other is {
        error "Unexpected message for adaptor FromResourceService"
      }
    } with {
      briefly "from resource service"
      described as {
        |Carries messages from the external ResourceService.
      }
    }
  } with {
      briefly "ResourceService integration"
    described as {
      |The model's side of the ResourceService conversation.
    }
  }
  adaptor ToResourceService to context ResourceService is {
    handler ToResourceServiceHandler is {
      on command ResourceService.CheckAvailability is {
        do "the model sends check availability"
      }
      on other is {
        error "Unexpected message for adaptor ToResourceService"
      }
    } with {
      briefly "to resource service"
      described as {
        |Carries messages to the external ResourceService.
      }
    }
  } with {
      briefly "ResourceService integration"
    described as {
      |The model's side of the ResourceService conversation.
    }
  }
  include "types.riddl"
  include "Engagement.riddl"
  // Repository for engagement persistence
  repository EngagementRepository is {
    inlet EngagementRepositoryFromEngagement is type EngagementEvent
    inlet EngagementRepositoryFromEngagementAnalytics is type EngagementEvent
    outlet EngagementRepositoryResponses is type Engagement.EngagementResult
    record StoredEngagement is {
      engagementId: EngagementId with {
        briefly "engagementId"
        described as {
          |The engagementId column of the stored engagement row.
        }
      }
      clientInfo: ClientInfo with {
        briefly "clientInfo"
        described as {
          |The clientInfo column of the stored engagement row.
        }
      }
    } with {
      briefly "Stored engagement row"
      described as {
        |The persistence shape of engagement data as this repository stores it.
      }
    }
    schema EngagementData is relational
      of engagements as type StoredEngagement
        index on field StoredEngagement.engagementId
        index on field StoredEngagement.clientInfo.clientId
      with {
      briefly "Engagement data schema"
      described as {
        |The relational schema holding engagement data for the EngagementRepository.
      }
    }

    handler EngagementPersistence is {
      on command Engagement.CreateEngagement is {
        tell event Engagement.EngagementCreated to entity EngagementContext.Engagement
        do "Store engagement record"
      }
      on command Engagement.UpdateEngagement is {
        tell event Engagement.EngagementUpdated to entity EngagementContext.Engagement
        do "Update engagement info"
      }
      on command Engagement.StartEngagement is {
        tell event Engagement.EngagementStarted to entity EngagementContext.Engagement
        do "Update engagement status"
      }
      on command Engagement.AssignTeamMember is {
        tell event Engagement.TeamMemberAssigned to entity EngagementContext.Engagement
        do "Store team assignment"
      }
      on command Engagement.AddDeliverable is {
        tell event Engagement.DeliverableAdded to entity EngagementContext.Engagement
        do "Store deliverable"
      }
      on command Engagement.CompleteMilestone is {
        tell event Engagement.MilestoneCompleted to entity EngagementContext.Engagement
        do "Update milestone status"
      }
      on command Engagement.RecordTime is {
        tell event Engagement.TimeRecorded to entity EngagementContext.Engagement
        do "Store time entry"
      }
      on command Engagement.CompleteEngagement is {
        tell event Engagement.EngagementCompleted to entity EngagementContext.Engagement
        do "Update completion status"
      }
    } with {
      briefly "Persists engagement commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Engagement data persistence"
    described as {
      | The EngagementRepository provides persistent storage for
      | engagements, team assignments, and time entries.
    }
  }
  // Projector for engagement analytics
  projector EngagementAnalytics is {
    inlet EngagementAnalyticsFromEngagement is type EngagementEvent
    outlet EngagementAnalyticsOut is type EngagementEvent
    updates repository EngagementContext.EngagementRepository
    record EngagementStats is  {
      clientId: ClientId with {
        briefly "Client"
        described as {
          |Client ID.
        }
      }
      totalEngagements: Natural with {
        briefly "Total"
        described as {
          |Total engagements.
        }
      }
      activeEngagements: Natural with {
        briefly "Active"
        described as {
          |Active count.
        }
      }
      totalRevenue: Decimal(14,2) with {
        briefly "Revenue"
        described as {
          |Total revenue.
        }
      }
      averageMargin: Decimal(5,2) with {
        briefly "Margin"
        described as {
          |Average margin.
        }
      }
    } with {
      briefly "Engagement statistics"
      described as {
        |Client engagement metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Engagement.EngagementCreated is {
        tell event Engagement.EngagementCreated to repository EngagementContext.EngagementRepository
        do "Update engagement counts"
      }
      on event Engagement.EngagementStarted is {
        tell event Engagement.EngagementStarted to repository EngagementContext.EngagementRepository
        do "Update active counts"
      }
      on event Engagement.TimeEntryApproved is {
        tell event Engagement.TimeEntryApproved to repository EngagementContext.EngagementRepository
        do "Update utilization metrics"
      }
      on event Engagement.EngagementCompleted is {
        tell event Engagement.EngagementCompleted to repository EngagementContext.EngagementRepository
        do "Update revenue metrics"
      }
    } with {
      briefly "Maintains engagement analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Engagement analytics projections"
    described as {
      |Maintains engagement analytics data.
    }
  }
  // ---- Event publication for Engagement ----
  type EngagementEvent is one of {
    EngagementContext.Engagement.EngagementCreated,
    EngagementContext.Engagement.EngagementUpdated,
    EngagementContext.Engagement.EngagementApproved,
    EngagementContext.Engagement.EngagementStarted,
    EngagementContext.Engagement.TeamMemberAssigned,
    EngagementContext.Engagement.TeamMemberRemoved,
    EngagementContext.Engagement.DeliverableAdded,
    EngagementContext.Engagement.DeliverableStatusUpdated,
    EngagementContext.Engagement.MilestoneAdded,
    EngagementContext.Engagement.MilestoneCompleted,
    EngagementContext.Engagement.TimeRecorded,
    EngagementContext.Engagement.TimeEntryApproved,
    EngagementContext.Engagement.EngagementPutOnHold,
    EngagementContext.Engagement.EngagementResumed,
    EngagementContext.Engagement.EngagementCompleted
  } with {
    briefly "Engagement event alternation"
    described as {
      |Union of all Engagement events, for streaming and event-sourced
      |persistence.
    }
  }
  processor EngagementEventSource as source is {
    outlet EngagementEvents is type EngagementEvent
    handler EngagementSourceHandler is {
      on event Engagement.EngagementCreated is {
        send event Engagement.EngagementCreated to outlet EngagementEvents
      }
      on event Engagement.EngagementUpdated is {
        send event Engagement.EngagementUpdated to outlet EngagementEvents
      }
      on event Engagement.EngagementApproved is {
        send event Engagement.EngagementApproved to outlet EngagementEvents
      }
      on event Engagement.EngagementStarted is {
        send event Engagement.EngagementStarted to outlet EngagementEvents
      }
      on event Engagement.TeamMemberAssigned is {
        send event Engagement.TeamMemberAssigned to outlet EngagementEvents
      }
      on event Engagement.TeamMemberRemoved is {
        send event Engagement.TeamMemberRemoved to outlet EngagementEvents
      }
      on event Engagement.DeliverableAdded is {
        send event Engagement.DeliverableAdded to outlet EngagementEvents
      }
      on event Engagement.DeliverableStatusUpdated is {
        send event Engagement.DeliverableStatusUpdated to outlet EngagementEvents
      }
      on event Engagement.MilestoneAdded is {
        send event Engagement.MilestoneAdded to outlet EngagementEvents
      }
      on event Engagement.MilestoneCompleted is {
        send event Engagement.MilestoneCompleted to outlet EngagementEvents
      }
      on event Engagement.TimeRecorded is {
        send event Engagement.TimeRecorded to outlet EngagementEvents
      }
      on event Engagement.TimeEntryApproved is {
        send event Engagement.TimeEntryApproved to outlet EngagementEvents
      }
      on event Engagement.EngagementPutOnHold is {
        send event Engagement.EngagementPutOnHold to outlet EngagementEvents
      }
      on event Engagement.EngagementResumed is {
        send event Engagement.EngagementResumed to outlet EngagementEvents
      }
      on event Engagement.EngagementCompleted is {
        send event Engagement.EngagementCompleted to outlet EngagementEvents
      }
      on other is {
        error "Unexpected message for source EngagementEventSource"
      }
    } with {
      briefly "Engagement source handler"
      described as {
        |Publishes Engagement events onto the outlet.
      }
    }
  } with {
    briefly "Engagement event source"
    described as {
      |Publishes Engagement entity events into the streaming topology.
    }
  }
  processor EngagementEventSink as sink is {
    inlet EngagementInlet is type EngagementEvent
    handler EngagementSinkHandler is {
      on event Engagement.EngagementCreated is {
        tell event Engagement.EngagementCreated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementUpdated is {
        tell event Engagement.EngagementUpdated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementApproved is {
        tell event Engagement.EngagementApproved to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementStarted is {
        tell event Engagement.EngagementStarted to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TeamMemberAssigned is {
        tell event Engagement.TeamMemberAssigned to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TeamMemberRemoved is {
        tell event Engagement.TeamMemberRemoved to repository EngagementContext.EngagementRepository
      }
      on event Engagement.DeliverableAdded is {
        tell event Engagement.DeliverableAdded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.DeliverableStatusUpdated is {
        tell event Engagement.DeliverableStatusUpdated to repository EngagementContext.EngagementRepository
      }
      on event Engagement.MilestoneAdded is {
        tell event Engagement.MilestoneAdded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.MilestoneCompleted is {
        tell event Engagement.MilestoneCompleted to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TimeRecorded is {
        tell event Engagement.TimeRecorded to repository EngagementContext.EngagementRepository
      }
      on event Engagement.TimeEntryApproved is {
        tell event Engagement.TimeEntryApproved to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementPutOnHold is {
        tell event Engagement.EngagementPutOnHold to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementResumed is {
        tell event Engagement.EngagementResumed to repository EngagementContext.EngagementRepository
      }
      on event Engagement.EngagementCompleted is {
        tell event Engagement.EngagementCompleted to repository EngagementContext.EngagementRepository
      }
      on other is {
        error "Unexpected message for sink EngagementEventSink"
      }
    } with {
      briefly "Engagement sink handler"
      described as {
        |Persists Engagement events via the repository.
      }
    }
  } with {
    briefly "Engagement event sink"
    described as {
      |Receives Engagement events for persistence.
    }
  }
  connector EngagementEventFlow is {
    from outlet EngagementContext.EngagementEventSource.EngagementEvents to
      inlet EngagementContext.EngagementEventSink.EngagementInlet
  } with {
    briefly "Engagement event flow"
    described as {
      |Connects the Engagement source to its sink.
    }
  }
  processor EngagementEventSplit is {
    inlet EngagementEventSplitIn is type EngagementEvent
    outlet EngagementEventSplitToEngagementRepository is type EngagementEvent
    outlet EngagementEventSplitToEngagementAnalytics is type EngagementEvent
    handler EngagementEventSplitHandler is {
      on event Engagement.EngagementCreated is {
        send event Engagement.EngagementCreated to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.EngagementCreated to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.EngagementCreated to entity EngagementContext.Engagement
      }
      on event Engagement.EngagementUpdated is {
        send event Engagement.EngagementUpdated to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.EngagementUpdated to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.EngagementUpdated to entity EngagementContext.Engagement
      }
      on event Engagement.EngagementApproved is {
        send event Engagement.EngagementApproved to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.EngagementApproved to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.EngagementApproved to entity EngagementContext.Engagement
      }
      on event Engagement.EngagementStarted is {
        send event Engagement.EngagementStarted to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.EngagementStarted to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.EngagementStarted to entity EngagementContext.Engagement
      }
      on event Engagement.TeamMemberAssigned is {
        send event Engagement.TeamMemberAssigned to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.TeamMemberAssigned to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.TeamMemberAssigned to entity EngagementContext.Engagement
      }
      on event Engagement.TeamMemberRemoved is {
        send event Engagement.TeamMemberRemoved to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.TeamMemberRemoved to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.TeamMemberRemoved to entity EngagementContext.Engagement
      }
      on event Engagement.DeliverableAdded is {
        send event Engagement.DeliverableAdded to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.DeliverableAdded to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.DeliverableAdded to entity EngagementContext.Engagement
      }
      on event Engagement.DeliverableStatusUpdated is {
        send event Engagement.DeliverableStatusUpdated to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.DeliverableStatusUpdated to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.DeliverableStatusUpdated to entity EngagementContext.Engagement
      }
      on event Engagement.MilestoneAdded is {
        send event Engagement.MilestoneAdded to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.MilestoneAdded to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.MilestoneAdded to entity EngagementContext.Engagement
      }
      on event Engagement.MilestoneCompleted is {
        send event Engagement.MilestoneCompleted to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.MilestoneCompleted to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.MilestoneCompleted to entity EngagementContext.Engagement
      }
      on event Engagement.TimeRecorded is {
        send event Engagement.TimeRecorded to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.TimeRecorded to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.TimeRecorded to entity EngagementContext.Engagement
      }
      on event Engagement.TimeEntryApproved is {
        send event Engagement.TimeEntryApproved to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.TimeEntryApproved to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.TimeEntryApproved to entity EngagementContext.Engagement
      }
      on event Engagement.EngagementPutOnHold is {
        send event Engagement.EngagementPutOnHold to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.EngagementPutOnHold to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.EngagementPutOnHold to entity EngagementContext.Engagement
      }
      on event Engagement.EngagementResumed is {
        send event Engagement.EngagementResumed to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.EngagementResumed to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.EngagementResumed to entity EngagementContext.Engagement
      }
      on event Engagement.EngagementCompleted is {
        send event Engagement.EngagementCompleted to outlet EngagementEventSplitToEngagementRepository
        send event Engagement.EngagementCompleted to outlet EngagementEventSplitToEngagementAnalytics
        tell event Engagement.EngagementCompleted to entity EngagementContext.Engagement
      }
      on other is {
        error "Unexpected message for processor EngagementEventSplit"
      }
    } with {
      briefly "Engagement event fan-out handler"
      described as {
        |Delivers each Engagement event to all of its consumers.
      }
    }
  } with {
    briefly "Engagement event fan-out"
    described as {
      |Fans Engagement events out to the repository and projectors.
    }
  }
  connector LinkEngagementToEngagementEventSplit is {
    from outlet EngagementContext.Engagement.EngagementEvents2 to
      inlet EngagementContext.EngagementEventSplit.EngagementEventSplitIn
  } with {
    briefly "LinkEngagementToEngagementEventSplit"
  }
  connector LinkEngagementEventSplitToEngagementRepository is {
    from outlet EngagementContext.EngagementEventSplit.EngagementEventSplitToEngagementRepository to
      inlet EngagementContext.EngagementRepository.EngagementRepositoryFromEngagement
  } with {
    briefly "LinkEngagementEventSplitToEngagementRepository"
  }
  connector LinkEngagementEventSplitToEngagementAnalytics is {
    from outlet EngagementContext.EngagementEventSplit.EngagementEventSplitToEngagementAnalytics to
      inlet EngagementContext.EngagementAnalytics.EngagementAnalyticsFromEngagement
  } with {
    briefly "LinkEngagementEventSplitToEngagementAnalytics"
  }
  connector LinkEngagementAnalyticsToEngagementRepository is {
    from outlet EngagementContext.EngagementAnalytics.EngagementAnalyticsOut to
      inlet EngagementContext.EngagementRepository.EngagementRepositoryFromEngagementAnalytics
  } with {
    briefly "LinkEngagementAnalyticsToEngagementRepository"
  }
} with {
  briefly "Bounded context for engagement management"
  described as {
    | The EngagementContext is the bounded context for client
    | engagements, project delivery, and consulting operations.
  }
}
