// Knowledge Management - Knowledge Context
context KnowledgeContext is {
  adaptor FromAnalyticsService from context AnalyticsService is {
    handler FromAnalyticsServiceHandler is {
      on event AnalyticsService.EventTracked is {
        do "the model receives event tracked"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsService"
      }
    } with {
      briefly "from analytics service"
      described as {
        |Carries messages from the external AnalyticsService.
      }
    }
  } with {
      briefly "AnalyticsService integration"
    described as {
      |The model's side of the AnalyticsService conversation.
    }
  }
  adaptor ToAnalyticsService to context AnalyticsService is {
    handler ToAnalyticsServiceHandler is {
      on command AnalyticsService.TrackEvent is {
        do "the model sends track event"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalyticsService"
      }
    } with {
      briefly "to analytics service"
      described as {
        |Carries messages to the external AnalyticsService.
      }
    }
  } with {
      briefly "AnalyticsService integration"
    described as {
      |The model's side of the AnalyticsService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is {
    handler FromDocumentStorageServiceHandler is {
      on event DocumentStorageService.AttachmentStored is {
        do "the model receives attachment stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
      briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is {
    handler ToDocumentStorageServiceHandler is {
      on command DocumentStorageService.StoreAttachment is {
        do "the model sends store attachment"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
      briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is {
    handler FromIdentityServiceHandler is {
      on event IdentityService.PermissionsChecked is {
        do "the model receives permissions checked"
      }
      on event IdentityService.UserAuthenticated is {
        do "the model receives user authenticated"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
      briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is {
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is {
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendContentAlert is {
        do "the model sends send content alert"
      }
      on command NotificationService.SendReviewRequest is {
        do "the model sends send review request"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
      briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSearchService from context SearchService is {
    handler FromSearchServiceHandler is {
      on event SearchService.ItemIndexed is {
        do "the model receives item indexed"
      }
      on other is {
        error "Unexpected message for adaptor FromSearchService"
      }
    } with {
      briefly "from search service"
      described as {
        |Carries messages from the external SearchService.
      }
    }
  } with {
      briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  adaptor ToSearchService to context SearchService is {
    handler ToSearchServiceHandler is {
      on command SearchService.IndexItem is {
        do "the model sends index item"
      }
      on command SearchService.RemoveFromIndex is {
        do "the model sends remove from index"
      }
      on other is {
        error "Unexpected message for adaptor ToSearchService"
      }
    } with {
      briefly "to search service"
      described as {
        |Carries messages to the external SearchService.
      }
    }
  } with {
      briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  include "types.riddl"
  include "KnowledgeItem.riddl"
  // Repository for knowledge persistence
  repository KnowledgeRepository is {
    inlet KnowledgeRepositoryFromKnowledgeItem is type KnowledgeItemEvent
    inlet KnowledgeRepositoryFromKnowledgeAnalytics is type KnowledgeItemEvent
    outlet KnowledgeRepositoryResponses is type KnowledgeItem.KnowledgeItemResult
    schema KnowledgeData is relational
      of items as type KnowledgeItem
        index on field KnowledgeItem.itemId
        index on field KnowledgeItem.metadata.categoryId
      with {
      briefly "Knowledge data schema"
      described as {
        |The relational schema holding knowledge data for the KnowledgeRepository.
      }
    }

    handler KnowledgePersistence is {
      on command KnowledgeItem.CreateItem is {
        tell event KnowledgeItem.ItemCreated to entity KnowledgeContext.KnowledgeItem
        do "Store knowledge item"
      }
      on command KnowledgeItem.UpdateItem is {
        tell event KnowledgeItem.ItemUpdated to entity KnowledgeContext.KnowledgeItem
        do "Update knowledge item"
      }
      on command KnowledgeItem.PublishItem is {
        tell event KnowledgeItem.ItemPublished to entity KnowledgeContext.KnowledgeItem
        do "Update item status"
      }
      on command KnowledgeItem.ArchiveItem is {
        do "Update item status"
      }
      on command KnowledgeItem.AddComment is {
        tell event KnowledgeItem.CommentAdded to entity KnowledgeContext.KnowledgeItem
        do "Store comment"
      }
      on command KnowledgeItem.RateItem is {
        do "Update rating"
      }
      on command KnowledgeItem.RecordView is {
        tell event KnowledgeItem.ViewRecorded to entity KnowledgeContext.KnowledgeItem
        do "Increment view count"
      }
    } with {
      briefly "Persists knowledge commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Knowledge data persistence"
    described as {
      | The KnowledgeRepository provides persistent storage for
      | knowledge items, categories, and engagement data.
    }
  }
  // Projector for knowledge analytics
  projector KnowledgeAnalytics is {
    inlet KnowledgeAnalyticsFromKnowledgeItem is type KnowledgeItemEvent
    outlet KnowledgeAnalyticsOut is type KnowledgeItemEvent
    updates repository KnowledgeContext.KnowledgeRepository
    record KnowledgeStats is  {
      categoryId: CategoryId with {
        briefly "Category"
        described as {
          |Category ID.
        }
      }
      totalItems: Natural with {
        briefly "Items"
        described as {
          |Total items.
        }
      }
      publishedItems: Natural with {
        briefly "Published"
        described as {
          |Published count.
        }
      }
      totalViews: Natural with {
        briefly "Views"
        described as {
          |Total views.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
    } with {
      briefly "Knowledge statistics"
      described as {
        |Knowledge category metrics.
      }
    }
    handler AnalyticsHandler is {
      on event KnowledgeItem.ItemCreated is {
        tell event KnowledgeItem.ItemCreated to repository KnowledgeContext.KnowledgeRepository
        do "Update item counts"
      }
      on event KnowledgeItem.ItemPublished is {
        tell event KnowledgeItem.ItemPublished to repository KnowledgeContext.KnowledgeRepository
        do "Update published counts"
      }
      on event KnowledgeItem.ViewRecorded is {
        tell event KnowledgeItem.ViewRecorded to repository KnowledgeContext.KnowledgeRepository
        do "Update view counts"
      }
      on event KnowledgeItem.ItemRated is {
        tell event KnowledgeItem.ItemRated to repository KnowledgeContext.KnowledgeRepository
        do "Update rating metrics"
      }
    } with {
      briefly "Maintains knowledge analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Knowledge analytics projections"
    described as {
      |Maintains knowledge analytics data.
    }
  }
  // ---- Event publication for KnowledgeItem ----
  type KnowledgeItemEvent is one of {
    KnowledgeContext.KnowledgeItem.ItemCreated,
    KnowledgeContext.KnowledgeItem.ItemUpdated,
    KnowledgeContext.KnowledgeItem.ItemSubmittedForReview,
    KnowledgeContext.KnowledgeItem.ItemReviewed,
    KnowledgeContext.KnowledgeItem.ItemPublished,
    KnowledgeContext.KnowledgeItem.ItemArchived,
    KnowledgeContext.KnowledgeItem.CommentAdded,
    KnowledgeContext.KnowledgeItem.ItemRated,
    KnowledgeContext.KnowledgeItem.ViewRecorded,
    KnowledgeContext.KnowledgeItem.AddedToCollection
  } with {
    briefly "KnowledgeItem event alternation"
    described as {
      |Union of all KnowledgeItem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor KnowledgeItemEventSource as source is {
    outlet KnowledgeItemEvents is type KnowledgeItemEvent
    handler KnowledgeItemSourceHandler is {
      on event KnowledgeItem.ItemCreated is {
        send event KnowledgeItem.ItemCreated to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.ItemUpdated is {
        send event KnowledgeItem.ItemUpdated to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.ItemSubmittedForReview is {
        send event KnowledgeItem.ItemSubmittedForReview to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.ItemReviewed is {
        send event KnowledgeItem.ItemReviewed to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.ItemPublished is {
        send event KnowledgeItem.ItemPublished to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.ItemArchived is {
        send event KnowledgeItem.ItemArchived to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.CommentAdded is {
        send event KnowledgeItem.CommentAdded to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.ItemRated is {
        send event KnowledgeItem.ItemRated to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.ViewRecorded is {
        send event KnowledgeItem.ViewRecorded to outlet KnowledgeItemEvents
      }
      on event KnowledgeItem.AddedToCollection is {
        send event KnowledgeItem.AddedToCollection to outlet KnowledgeItemEvents
      }
      on other is {
        error "Unexpected message for source KnowledgeItemEventSource"
      }
    } with {
      briefly "KnowledgeItem source handler"
      described as {
        |Publishes KnowledgeItem events onto the outlet.
      }
    }
  } with {
    briefly "KnowledgeItem event source"
    described as {
      |Publishes KnowledgeItem entity events into the streaming topology.
    }
  }
  processor KnowledgeItemEventSink as sink is {
    inlet KnowledgeItemInlet is type KnowledgeItemEvent
    handler KnowledgeItemSinkHandler is {
      on event KnowledgeItem.ItemCreated is {
        tell event KnowledgeItem.ItemCreated to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.ItemUpdated is {
        tell event KnowledgeItem.ItemUpdated to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.ItemSubmittedForReview is {
        tell event KnowledgeItem.ItemSubmittedForReview to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.ItemReviewed is {
        tell event KnowledgeItem.ItemReviewed to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.ItemPublished is {
        tell event KnowledgeItem.ItemPublished to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.ItemArchived is {
        tell event KnowledgeItem.ItemArchived to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.CommentAdded is {
        tell event KnowledgeItem.CommentAdded to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.ItemRated is {
        tell event KnowledgeItem.ItemRated to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.ViewRecorded is {
        tell event KnowledgeItem.ViewRecorded to repository KnowledgeContext.KnowledgeRepository
      }
      on event KnowledgeItem.AddedToCollection is {
        tell event KnowledgeItem.AddedToCollection to repository KnowledgeContext.KnowledgeRepository
      }
      on other is {
        error "Unexpected message for sink KnowledgeItemEventSink"
      }
    } with {
      briefly "KnowledgeItem sink handler"
      described as {
        |Persists KnowledgeItem events via the repository.
      }
    }
  } with {
    briefly "KnowledgeItem event sink"
    described as {
      |Receives KnowledgeItem events for persistence.
    }
  }
  connector KnowledgeItemEventFlow is {
    from outlet KnowledgeContext.KnowledgeItemEventSource.KnowledgeItemEvents to
      inlet KnowledgeContext.KnowledgeItemEventSink.KnowledgeItemInlet
  } with {
    briefly "KnowledgeItem event flow"
    described as {
      |Connects the KnowledgeItem source to its sink.
    }
  }
  processor KnowledgeItemEventSplit is {
    inlet KnowledgeItemEventSplitIn is type KnowledgeItemEvent
    outlet KnowledgeItemEventSplitToKnowledgeRepository is type KnowledgeItemEvent
    outlet KnowledgeItemEventSplitToKnowledgeAnalytics is type KnowledgeItemEvent
    handler KnowledgeItemEventSplitHandler is {
      on event KnowledgeItem.ItemCreated is {
        send event KnowledgeItem.ItemCreated to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ItemCreated to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ItemCreated to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.ItemUpdated is {
        send event KnowledgeItem.ItemUpdated to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ItemUpdated to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ItemUpdated to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.ItemSubmittedForReview is {
        send event KnowledgeItem.ItemSubmittedForReview to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ItemSubmittedForReview to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ItemSubmittedForReview to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.ItemReviewed is {
        send event KnowledgeItem.ItemReviewed to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ItemReviewed to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ItemReviewed to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.ItemPublished is {
        send event KnowledgeItem.ItemPublished to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ItemPublished to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ItemPublished to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.ItemArchived is {
        send event KnowledgeItem.ItemArchived to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ItemArchived to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ItemArchived to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.CommentAdded is {
        send event KnowledgeItem.CommentAdded to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.CommentAdded to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.CommentAdded to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.ItemRated is {
        send event KnowledgeItem.ItemRated to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ItemRated to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ItemRated to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.ViewRecorded is {
        send event KnowledgeItem.ViewRecorded to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.ViewRecorded to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.ViewRecorded to entity KnowledgeContext.KnowledgeItem
      }
      on event KnowledgeItem.AddedToCollection is {
        send event KnowledgeItem.AddedToCollection to outlet KnowledgeItemEventSplitToKnowledgeRepository
        send event KnowledgeItem.AddedToCollection to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell event KnowledgeItem.AddedToCollection to entity KnowledgeContext.KnowledgeItem
      }
      on other is {
        error "Unexpected message for processor KnowledgeItemEventSplit"
      }
    } with {
      briefly "KnowledgeItem event fan-out handler"
      described as {
        |Delivers each KnowledgeItem event to all of its consumers.
      }
    }
  } with {
    briefly "KnowledgeItem event fan-out"
    described as {
      |Fans KnowledgeItem events out to the repository and projectors.
    }
  }
  connector LinkKnowledgeItemToKnowledgeItemEventSplit is {
    from outlet KnowledgeContext.KnowledgeItem.KnowledgeItemEvents2 to
      inlet KnowledgeContext.KnowledgeItemEventSplit.KnowledgeItemEventSplitIn
  } with {
    briefly "LinkKnowledgeItemToKnowledgeItemEventSplit"
  }
  connector LinkKnowledgeItemEventSplitToKnowledgeRepository is {
    from outlet KnowledgeContext.KnowledgeItemEventSplit.KnowledgeItemEventSplitToKnowledgeRepository to
      inlet KnowledgeContext.KnowledgeRepository.KnowledgeRepositoryFromKnowledgeItem
  } with {
    briefly "LinkKnowledgeItemEventSplitToKnowledgeRepository"
  }
  connector LinkKnowledgeItemEventSplitToKnowledgeAnalytics is {
    from outlet KnowledgeContext.KnowledgeItemEventSplit.KnowledgeItemEventSplitToKnowledgeAnalytics to
      inlet KnowledgeContext.KnowledgeAnalytics.KnowledgeAnalyticsFromKnowledgeItem
  } with {
    briefly "LinkKnowledgeItemEventSplitToKnowledgeAnalytics"
  }
  connector LinkKnowledgeAnalyticsToKnowledgeRepository is {
    from outlet KnowledgeContext.KnowledgeAnalytics.KnowledgeAnalyticsOut to
      inlet KnowledgeContext.KnowledgeRepository.KnowledgeRepositoryFromKnowledgeAnalytics
  } with {
    briefly "LinkKnowledgeAnalyticsToKnowledgeRepository"
  }
} with {
  briefly "Bounded context for knowledge management"
  described as {
    | The KnowledgeContext is the bounded context for organizational
    | knowledge capture, curation, sharing, and reuse.
  }
}
