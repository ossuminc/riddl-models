// Knowledge Management - Knowledge Context
context KnowledgeContext as router is {
  inlet KnowledgeItemCommandStreamIn is type KnowledgeItemCommand  outlet KnowledgeItemCommandStreamOut is type KnowledgeItemCommand
  inlet KnowledgeItemResultStreamIn is result KnowledgeItem.KnowledgeItemResult  outlet KnowledgeItemResultStreamOut is result KnowledgeItem.KnowledgeItemResult
  handler KnowledgeContextBoundary is {
    on createItem: command KnowledgeItem.CreateItem is {
      send createItem to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on updateItem: command KnowledgeItem.UpdateItem is {
      send updateItem to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on submitForReview: command KnowledgeItem.SubmitForReview is {
      send submitForReview to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on reviewItem: command KnowledgeItem.ReviewItem is {
      send reviewItem to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on publishItem: command KnowledgeItem.PublishItem is {
      send publishItem to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on archiveItem: command KnowledgeItem.ArchiveItem is {
      send archiveItem to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on addComment: command KnowledgeItem.AddComment is {
      send addComment to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on rateItem: command KnowledgeItem.RateItem is {
      send rateItem to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on recordView: command KnowledgeItem.RecordView is {
      send recordView to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on addToCollection: command KnowledgeItem.AddToCollection is {
      send addToCollection to outlet KnowledgeContext.KnowledgeItemCommandStreamOut
    }
    on knowledgeItemResult: result KnowledgeItem.KnowledgeItemResult is {
      send knowledgeItemResult to outlet KnowledgeContext.KnowledgeItemResultStreamOut
    }
    on other is {
      error "Unexpected message at the KnowledgeContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'KnowledgeItemCommand Stream Intake' is from outlet KnowledgeContext.KnowledgeItemCommandStreamOut to inlet KnowledgeContext.KnowledgeItem.KnowledgeItemCommands  connector 'KnowledgeItemResult Stream Egress' is from outlet KnowledgeContext.KnowledgeRepository.KnowledgeRepositoryResponses to inlet KnowledgeContext.KnowledgeItemResultStreamIn  adaptor FromAnalyticsService from context AnalyticsService is { 
    handler FromAnalyticsServiceHandler is {
      on event AnalyticsService.EventTracked is {
        do "the model receives event tracked"
      }
      on other is {
        error "Unexpected message for adaptor FromAnalyticsService"
      }
    } with {
      briefly "from analytics service"
      described as {
        |Carries messages from the external AnalyticsService.
      }
    }
  } with {
    briefly "AnalyticsService integration"
    described as {
      |The model's side of the AnalyticsService conversation.
    }
  }
  adaptor ToAnalyticsService to context AnalyticsService is { 
    handler ToAnalyticsServiceHandler is {
      on command AnalyticsService.TrackEvent is {
        do "the model sends track event"
      }
      on other is {
        error "Unexpected message for adaptor ToAnalyticsService"
      }
    } with {
      briefly "to analytics service"
      described as {
        |Carries messages to the external AnalyticsService.
      }
    }
  } with {
    briefly "AnalyticsService integration"
    described as {
      |The model's side of the AnalyticsService conversation.
    }
  }
  adaptor FromDocumentStorageService from context DocumentStorageService is { 
    handler FromDocumentStorageServiceHandler is {
      on event DocumentStorageService.AttachmentStored is {
        do "the model receives attachment stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorageService"
      }
    } with {
      briefly "from document storage service"
      described as {
        |Carries messages from the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor ToDocumentStorageService to context DocumentStorageService is { 
    handler ToDocumentStorageServiceHandler is {
      on command DocumentStorageService.StoreAttachment is {
        do "the model sends store attachment"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorageService"
      }
    } with {
      briefly "to document storage service"
      described as {
        |Carries messages to the external DocumentStorageService.
      }
    }
  } with {
    briefly "DocumentStorageService integration"
    described as {
      |The model's side of the DocumentStorageService conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is { 
    handler FromIdentityServiceHandler is {
      on event IdentityService.PermissionsChecked is {
        do "the model receives permissions checked"
      }
      on event IdentityService.UserAuthenticated is {
        do "the model receives user authenticated"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendContentAlert is {
        do "the model sends send content alert"
      }
      on command NotificationService.SendReviewRequest is {
        do "the model sends send review request"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromSearchService from context SearchService is { 
    handler FromSearchServiceHandler is {
      on event SearchService.ItemIndexed is {
        do "the model receives item indexed"
      }
      on other is {
        error "Unexpected message for adaptor FromSearchService"
      }
    } with {
      briefly "from search service"
      described as {
        |Carries messages from the external SearchService.
      }
    }
  } with {
    briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  adaptor ToSearchService to context SearchService is { 
    handler ToSearchServiceHandler is {
      on command SearchService.IndexItem is {
        do "the model sends index item"
      }
      on command SearchService.RemoveFromIndex is {
        do "the model sends remove from index"
      }
      on other is {
        error "Unexpected message for adaptor ToSearchService"
      }
    } with {
      briefly "to search service"
      described as {
        |Carries messages to the external SearchService.
      }
    }
  } with {
    briefly "SearchService integration"
    described as {
      |The model's side of the SearchService conversation.
    }
  }
  include "types.riddl"
  include "KnowledgeItem.riddl"
  // Repository for knowledge persistence
  type KnowledgeRepositoryCommand is one of {
    KnowledgeContext.KnowledgeRepository.PersistAddedToCollection or KnowledgeContext.KnowledgeRepository.PersistCommentAdded or KnowledgeContext.KnowledgeRepository.PersistItemArchived or KnowledgeContext.KnowledgeRepository.PersistItemCreated or KnowledgeContext.KnowledgeRepository.PersistItemPublished or KnowledgeContext.KnowledgeRepository.PersistItemRated or KnowledgeContext.KnowledgeRepository.PersistItemReviewed or KnowledgeContext.KnowledgeRepository.PersistItemSubmittedForReview or KnowledgeContext.KnowledgeRepository.PersistItemUpdated or KnowledgeContext.KnowledgeRepository.PersistViewRecorded
  } with {
    briefly "Anything that writes KnowledgeRepository"
    described as {
      |The persistence commands KnowledgeRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository KnowledgeRepository as flow is {
    inlet KnowledgeRepositoryFromKnowledgeAnalytics is type KnowledgeRepositoryCommand    command PersistAddedToCollection is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row AddedToCollection applies to.
        }
      }
    } with {
      briefly "Persist AddedToCollection"
      described as {
        |Instructs this repository to apply AddedToCollection to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommentAdded is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentAdded applies to.
        }
      }
    } with {
      briefly "Persist CommentAdded"
      described as {
        |Instructs this repository to apply CommentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemArchived is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemArchived applies to.
        }
      }
    } with {
      briefly "Persist ItemArchived"
      described as {
        |Instructs this repository to apply ItemArchived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemReviewed is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemReviewed applies to.
        }
      }
    } with {
      briefly "Persist ItemReviewed"
      described as {
        |Instructs this repository to apply ItemReviewed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemSubmittedForReview is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemSubmittedForReview applies to.
        }
      }
    } with {
      briefly "Persist ItemSubmittedForReview"
      described as {
        |Instructs this repository to apply ItemSubmittedForReview to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemUpdated is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemUpdated applies to.
        }
      }
    } with {
      briefly "Persist ItemUpdated"
      described as {
        |Instructs this repository to apply ItemUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemCreated is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemCreated applies to.
        }
      }
    } with {
      briefly "Persist ItemCreated"
      described as {
        |Instructs this repository to apply ItemCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemPublished is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemPublished applies to.
        }
      }
    } with {
      briefly "Persist ItemPublished"
      described as {
        |Instructs this repository to apply ItemPublished to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistItemRated is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ItemRated applies to.
        }
      }
    } with {
      briefly "Persist ItemRated"
      described as {
        |Instructs this repository to apply ItemRated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistViewRecorded is {
      itemId: KnowledgeItemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ViewRecorded applies to.
        }
      }
    } with {
      briefly "Persist ViewRecorded"
      described as {
        |Instructs this repository to apply ViewRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet KnowledgeRepositoryResponses is result KnowledgeItem.KnowledgeItemResult
    record StoredKnowledgeItem is {
      knowledgeItemId: KnowledgeItemId with {
        briefly "knowledgeItemId"
        described as {
          |The knowledgeItemId column of the stored knowledgeItem row.
        }
      }
      itemId: KnowledgeItemId with {
        briefly "itemId"
        described as {
          |The itemId column of the stored knowledgeItem row.
        }
      }
      metadata: KnowledgeMetadata with {
        briefly "metadata"
        described as {
          |The metadata column of the stored knowledgeItem row.
        }
      }
    } with {
      briefly "Stored knowledgeItem row"
      described as {
        |The persistence shape of knowledgeItem data as this repository stores it.
      }
    }
    schema KnowledgeData is relational
      of items as record StoredKnowledgeItem
        index on field StoredKnowledgeItem.itemId
        index on field StoredKnowledgeItem.metadata.categoryId
 with {
      briefly "Knowledge data schema"
      described as {
        |The relational schema holding knowledge data for the KnowledgeRepository.
      }
    }
    handler KnowledgePersistence is {
      on persistAddedToCollection: command PersistAddedToCollection is {
        do "apply AddedToCollection to the stored row"
      }
      on persistCommentAdded: command PersistCommentAdded is {
        do "apply CommentAdded to the stored row"
      }
      on persistItemArchived: command PersistItemArchived is {
        do "apply ItemArchived to the stored row"
      }
      on persistItemReviewed: command PersistItemReviewed is {
        do "apply ItemReviewed to the stored row"
      }
      on persistItemSubmittedForReview: command PersistItemSubmittedForReview is {
        do "apply ItemSubmittedForReview to the stored row"
      }
      on persistItemUpdated: command PersistItemUpdated is {
        do "apply ItemUpdated to the stored row"
      }
      on persistItemCreated: command PersistItemCreated is {
        do "apply ItemCreated to the stored row"
      }
      on persistItemPublished: command PersistItemPublished is {
        do "apply ItemPublished to the stored row"
      }
      on persistItemRated: command PersistItemRated is {
        do "apply ItemRated to the stored row"
      }
      on persistViewRecorded: command PersistViewRecorded is {
        do "apply ViewRecorded to the stored row"
      }
      on query GetKnowledgeStats is {
        let knowledgeStatsView: type KnowledgeStatsView = prompt("read the knowledge stats projection")
        reply knowledgeStatsView
      }
    } with {
      briefly "Persists knowledge commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Knowledge data persistence"
    described as {
      | The KnowledgeRepository provides persistent storage for
      | knowledge items, categories, and engagement data.
    }
  }
  // Projector for knowledge analytics
  query GetKnowledgeStats replies result KnowledgeStatsView is {
    knowledgeStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which knowledge stats to retrieve.
      }
    }
  } with {
    briefly "Get knowledge stats"
    described as {
      |Retrieves the knowledge stats projection.
    }
  }
  result KnowledgeStatsView is {
    knowledgeStats: KnowledgeAnalytics.KnowledgeStats with {
      briefly "Knowledge stats"
      described as {
        |The knowledge stats being returned.
      }
    }
  } with {
    briefly "Knowledge stats view"
    described as {
      |Read model view carrying the knowledge stats projection.
    }
  }
  projector KnowledgeAnalytics as flow is {
    updates repository KnowledgeContext.KnowledgeRepository
    outlet KnowledgeAnalyticsToRepository is type KnowledgeRepositoryCommand
    inlet KnowledgeAnalyticsFromKnowledgeItem is type KnowledgeItemEvent    record KnowledgeStats is {
      categoryId: CategoryId with {
        briefly "Category"
        described as {
          |Category ID.
        }
      }
      totalItems: Natural with {
        briefly "Items"
        described as {
          |Total items.
        }
      }
      publishedItems: Natural with {
        briefly "Published"
        described as {
          |Published count.
        }
      }
      totalViews: Natural with {
        briefly "Views"
        described as {
          |Total views.
        }
      }
      averageRating: Decimal(3,2) with {
        briefly "Rating"
        described as {
          |Average rating.
        }
      }
    } with {
      briefly "Knowledge statistics"
      described as {
        |Knowledge category metrics.
      }
    }
    handler AnalyticsHandler is {
      on addedToCollection: event KnowledgeItem.AddedToCollection is {
        tell command KnowledgeContext.KnowledgeRepository.PersistAddedToCollection(itemId = addedToCollection.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "apply AddedToCollection to the KnowledgeAnalytics projection"
      }
      on commentAdded: event KnowledgeItem.CommentAdded is {
        tell command KnowledgeContext.KnowledgeRepository.PersistCommentAdded(itemId = commentAdded.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "apply CommentAdded to the KnowledgeAnalytics projection"
      }
      on itemArchived: event KnowledgeItem.ItemArchived is {
        tell command KnowledgeContext.KnowledgeRepository.PersistItemArchived(itemId = itemArchived.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "apply ItemArchived to the KnowledgeAnalytics projection"
      }
      on itemReviewed: event KnowledgeItem.ItemReviewed is {
        tell command KnowledgeContext.KnowledgeRepository.PersistItemReviewed(itemId = itemReviewed.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "apply ItemReviewed to the KnowledgeAnalytics projection"
      }
      on itemSubmittedForReview: event KnowledgeItem.ItemSubmittedForReview is {
        tell command KnowledgeContext.KnowledgeRepository.PersistItemSubmittedForReview(itemId = itemSubmittedForReview.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "apply ItemSubmittedForReview to the KnowledgeAnalytics projection"
      }
      on itemUpdated: event KnowledgeItem.ItemUpdated is {
        tell command KnowledgeContext.KnowledgeRepository.PersistItemUpdated(itemId = itemUpdated.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "apply ItemUpdated to the KnowledgeAnalytics projection"
      }
      on itemCreated: event KnowledgeItem.ItemCreated is {
        tell command KnowledgeContext.KnowledgeRepository.PersistItemCreated(itemId = itemCreated.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "Update item counts"
      }
      on itemPublished: event KnowledgeItem.ItemPublished is {
        tell command KnowledgeContext.KnowledgeRepository.PersistItemPublished(itemId = itemPublished.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "Update published counts"
      }
      on viewRecorded: event KnowledgeItem.ViewRecorded is {
        tell command KnowledgeContext.KnowledgeRepository.PersistViewRecorded(itemId = viewRecorded.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "Update view counts"
      }
      on itemRated: event KnowledgeItem.ItemRated is {
        tell command KnowledgeContext.KnowledgeRepository.PersistItemRated(itemId = itemRated.itemId) to repository KnowledgeContext.KnowledgeRepository
        do "Update rating metrics"
      }
    } with {
      briefly "Maintains knowledge analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Knowledge analytics projections"
    described as {
      |Maintains knowledge analytics data.
    }
  }
  // ---- Event publication for KnowledgeItem ----
  type KnowledgeItemEvent is one of {
    KnowledgeContext.KnowledgeItem.ItemCreated or KnowledgeContext.KnowledgeItem.ItemUpdated or KnowledgeContext.KnowledgeItem.ItemSubmittedForReview or KnowledgeContext.KnowledgeItem.ItemReviewed or KnowledgeContext.KnowledgeItem.ItemPublished or KnowledgeContext.KnowledgeItem.ItemArchived or KnowledgeContext.KnowledgeItem.CommentAdded or KnowledgeContext.KnowledgeItem.ItemRated or KnowledgeContext.KnowledgeItem.ViewRecorded or KnowledgeContext.KnowledgeItem.AddedToCollection
  } with {
    briefly "KnowledgeItem event alternation"
    described as {
      |Union of all KnowledgeItem events, for streaming and event-sourced
      |persistence.
    }
  }
  processor KnowledgeItemEventSplit as flow is {
    inlet KnowledgeItemEventSplitIn is type KnowledgeItemEvent    outlet KnowledgeItemEventSplitToKnowledgeAnalytics is type KnowledgeItemEvent
    handler KnowledgeItemEventSplitHandler is {
      on itemCreated: event KnowledgeItem.ItemCreated is {
        send itemCreated to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell itemCreated to entity KnowledgeContext.KnowledgeItem
      }
      on itemUpdated: event KnowledgeItem.ItemUpdated is {
        send itemUpdated to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell itemUpdated to entity KnowledgeContext.KnowledgeItem
      }
      on itemSubmittedForReview: event KnowledgeItem.ItemSubmittedForReview is {
        send itemSubmittedForReview to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell itemSubmittedForReview to entity KnowledgeContext.KnowledgeItem
      }
      on itemReviewed: event KnowledgeItem.ItemReviewed is {
        send itemReviewed to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell itemReviewed to entity KnowledgeContext.KnowledgeItem
      }
      on itemPublished: event KnowledgeItem.ItemPublished is {
        send itemPublished to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell itemPublished to entity KnowledgeContext.KnowledgeItem
      }
      on itemArchived: event KnowledgeItem.ItemArchived is {
        send itemArchived to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell itemArchived to entity KnowledgeContext.KnowledgeItem
      }
      on commentAdded: event KnowledgeItem.CommentAdded is {
        send commentAdded to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell commentAdded to entity KnowledgeContext.KnowledgeItem
      }
      on itemRated: event KnowledgeItem.ItemRated is {
        send itemRated to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell itemRated to entity KnowledgeContext.KnowledgeItem
      }
      on viewRecorded: event KnowledgeItem.ViewRecorded is {
        send viewRecorded to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell viewRecorded to entity KnowledgeContext.KnowledgeItem
      }
      on addedToCollection: event KnowledgeItem.AddedToCollection is {
        send addedToCollection to outlet KnowledgeItemEventSplitToKnowledgeAnalytics
        tell addedToCollection to entity KnowledgeContext.KnowledgeItem
      }
      on other is {
        error "Unexpected message for processor KnowledgeItemEventSplit"
      }
    } with {
      briefly "KnowledgeItem event fan-out handler"
      described as {
        |Delivers each KnowledgeItem event to all of its consumers.
      }
    }
  } with {
    briefly "KnowledgeItem event fan-out"
    described as {
      |Fans KnowledgeItem events out to the repository and projectors.
    }
  }
  connector 'KnowledgeItemEvent Stream' is from outlet KnowledgeContext.KnowledgeItem.KnowledgeItemEvents2 to inlet KnowledgeContext.KnowledgeItemEventSplit.KnowledgeItemEventSplitIn with {
    briefly "KnowledgeItem events, fanned out to storage and read models"
  }
  connector 'KnowledgeAnalytics Feed' is from outlet KnowledgeContext.KnowledgeItemEventSplit.KnowledgeItemEventSplitToKnowledgeAnalytics to inlet KnowledgeContext.KnowledgeAnalytics.KnowledgeAnalyticsFromKnowledgeItem with {
    briefly "KnowledgeItem events feeding the KnowledgeAnalytics projection"
  }
  connector 'KnowledgeAnalytics Storage' is from outlet KnowledgeContext.KnowledgeAnalytics.KnowledgeAnalyticsToRepository to inlet KnowledgeContext.KnowledgeRepository.KnowledgeRepositoryFromKnowledgeAnalytics with {
    briefly "KnowledgeAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for knowledge management"
  described as {
    | The KnowledgeContext is the bounded context for organizational
    | knowledge capture, curation, sharing, and reuse.
  }
}
