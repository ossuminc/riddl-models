// Knowledge Management Domain Model
// Organizational knowledge capture, sharing, and reuse
domain KnowledgeManagement is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user KnowledgeManager is "curator managing knowledge assets" with {
    briefly "Knowledge Manager"
    described as {
      |Person responsible for knowledge curation.
    }
  }
  user Contributor is "person contributing knowledge" with {
    briefly "Contributor"
    described as {
      |Person adding knowledge to the system.
    }
  }
  user Researcher is "person searching for knowledge" with {
    briefly "Researcher"
    described as {
      |Person seeking information.
    }
  }
  epic KnowledgeSharingEpic is {
    user Contributor wants to "to capture and share organizational knowledge" so that "others can benefit from lessons learned"
    case ShareKnowledge is {
      user Contributor wants to "to document and share valuable knowledge" so that "it can be reused by others"
      step is "Contributor creates" "knowledge article" "with relevant content" with {
        briefly "Create article"
        described as {
          |Author content.
        }
      }
      step is "System categorizes" "and tags article" "for discoverability" with {
        briefly "Categorize"
        described as {
          |Add metadata.
        }
      }
      step take input KnowledgeManagementApp.KnowledgeManagementScreen.PublishItemInput from user KnowledgeManager with {
        briefly "Publish"
        described as {
          |Make available.
        }
      }
      step is "System notifies" "relevant stakeholders" "of new content" with {
        briefly "Notify"
        described as {
          |Alert interested parties.
        }
      }
    } with {
      briefly "Knowledge sharing workflow"
      described as {
        |Standard flow for sharing knowledge.
      }
    }
  } with {
    briefly "Knowledge sharing processing"
    described as {
      | Epic covering knowledge capture from creation
      | through review, publication, and discovery.
    }
  }
  include "KnowledgeContext.riddl"
  include "external-contexts.riddl"
  application context KnowledgeManagementApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in KnowledgeManagement are delivered.
      }
    }
    group KnowledgeManagementScreen is {
      input PublishItemInput acquires command KnowledgeContext.KnowledgeItem.PublishItem with {
        briefly "Publish item control"
        described as {
          |The control through which a user submits the publish item request.
        }
      }
    } with {
      briefly "Knowledge management screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppKnowledgeItemCommands is type KnowledgeContext.KnowledgeItem.KnowledgeItemCommand
    inlet AppKnowledgeRepositoryResponses is type KnowledgeContext.KnowledgeItem.KnowledgeItemResult    handler KnowledgeManagementAppHandler is {
      on other is {
        error "Unexpected message for application context KnowledgeManagementApp"
      }
    } with {
      briefly "KnowledgeManagementApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "KnowledgeManagementApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'KnowledgeItemCommand Stream' is from outlet KnowledgeManagementApp.AppKnowledgeItemCommands to inlet KnowledgeContext.KnowledgeItem.KnowledgeItemCommands with {
    option persistent()
    briefly "KnowledgeItem commands from the application"
  }
  connector 'KnowledgeItemResult Stream' is from outlet KnowledgeContext.KnowledgeRepository.KnowledgeRepositoryResponses to inlet KnowledgeManagementApp.AppKnowledgeRepositoryResponses with {
    option persistent()
    briefly "Knowledge query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet KnowledgeManagementApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  term Article is  "A knowledge article, categorised and tagged for discoverability." 
  term Stakeholder is  "A person notified of new content relevant to their work." 
  briefly "Knowledge management domain"
  described as {
    | The KnowledgeManagement domain handles organizational
    | knowledge capture, curation, sharing, and reuse.
  }
}
