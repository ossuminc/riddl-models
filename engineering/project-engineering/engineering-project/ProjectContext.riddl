// Engineering Project - Project Context
context ProjectContext is {
  adaptor FromBillingService from context BillingService is { 
    handler FromBillingServiceHandler is {
      on event BillingService.InvoiceCreated is {
        do "the model receives invoice created"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService is { 
    handler ToBillingServiceHandler is {
      on command BillingService.CreateInvoice is {
        do "the model sends create invoice"
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCalendarService from context CalendarService is { 
    handler FromCalendarServiceHandler is {
      on event CalendarService.MeetingScheduled is {
        do "the model receives meeting scheduled"
      }
      on other is {
        error "Unexpected message for adaptor FromCalendarService"
      }
    } with {
      briefly "from calendar service"
      described as {
        |Carries messages from the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor ToCalendarService to context CalendarService is { 
    handler ToCalendarServiceHandler is {
      on command CalendarService.ScheduleMeeting is {
        do "the model sends schedule meeting"
      }
      on other is {
        error "Unexpected message for adaptor ToCalendarService"
      }
    } with {
      briefly "to calendar service"
      described as {
        |Carries messages to the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor FromClientService from context ClientService is { 
    handler FromClientServiceHandler is {
      on event ClientService.ClientUpdated is {
        do "the model receives client updated"
      }
      on other is {
        error "Unexpected message for adaptor FromClientService"
      }
    } with {
      briefly "from client service"
      described as {
        |Carries messages from the external ClientService.
      }
    }
  } with {
    briefly "ClientService integration"
    described as {
      |The model's side of the ClientService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService is { 
    handler FromDocumentServiceHandler is {
      on event DocumentService.DeliverableStored is {
        do "the model receives deliverable stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is { 
    handler ToDocumentServiceHandler is {
      on command DocumentService.StoreDeliverable is {
        do "the model sends store deliverable"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendProjectUpdate is {
        do "the model sends send project update"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromResourceService from context ResourceService is { 
    handler FromResourceServiceHandler is {
      on result ResourceService.ResourceAvailability is {
        do "the model receives resource availability"
      }
      on other is {
        error "Unexpected message for adaptor FromResourceService"
      }
    } with {
      briefly "from resource service"
      described as {
        |Carries messages from the external ResourceService.
      }
    }
  } with {
    briefly "ResourceService integration"
    described as {
      |The model's side of the ResourceService conversation.
    }
  }
  adaptor ToResourceService to context ResourceService is { 
    handler ToResourceServiceHandler is {
      on query ResourceService.GetAvailableResources is {
        do "the model sends get available resources"
      }
      on other is {
        error "Unexpected message for adaptor ToResourceService"
      }
    } with {
      briefly "to resource service"
      described as {
        |Carries messages to the external ResourceService.
      }
    }
  } with {
    briefly "ResourceService integration"
    described as {
      |The model's side of the ResourceService conversation.
    }
  }
  include "types.riddl"
  include "Project.riddl"
  // Repository for project persistence
  repository ProjectRepository as merge is {
    inlet ProjectRepositoryFromProject is type ProjectEvent    inlet ProjectRepositoryFromProjectAnalytics is type ProjectEvent    outlet ProjectRepositoryResponses is type Project.ProjectResult
    record StoredProject is  {
      projectId: ProjectId with {
        briefly "projectId"
        described as {
          |The projectId column of the stored project row.
        }
      }
      info: ProjectInfo with {
        briefly "info"
        described as {
          |The info column of the stored project row.
        }
      }
    } with {
      briefly "Stored project row"
      described as {
        |The persistence shape of project data as this repository stores it.
      }
    }
    schema ProjectData is relational
      of projects as type StoredProject
        index on field StoredProject.projectId
        index on field StoredProject.info.clientId
 with {
      briefly "Project data schema"
      described as {
        |The relational schema holding project data for the ProjectRepository.
      }
    }
    handler ProjectPersistence is {
      on query GetProjectStats is {
        let projectStatsView: type ProjectStatsView = prompt("read the project stats projection")
        reply projectStatsView
      }
      on createProject: command Project.CreateProject is {
        tell event Project.ProjectCreated(projectId = createProject.projectId, info = createProject.info, managerId = createProject.managerId) to entity ProjectContext.Project
        do "Store project record"
      }
      on updateProject: command Project.UpdateProject is {
        tell event Project.ProjectUpdated(projectId = updateProject.projectId, info = updateProject.info) to entity ProjectContext.Project
        do "Update project info"
      }
      on addPhase: command Project.AddPhase is {
        tell event Project.PhaseAdded(projectId = addPhase.projectId, phase = addPhase.phase) to entity ProjectContext.Project
        do "Store phase record"
      }
      on updatePhase: command Project.UpdatePhase is {
        tell event Project.PhaseUpdated(projectId = updatePhase.projectId, phaseId = updatePhase.phaseId, status = updatePhase.status) to entity ProjectContext.Project
        do "Update phase status"
      }
      on addTask: command Project.AddTask is {
        tell event Project.TaskAdded(projectId = addTask.projectId, task = addTask.task) to entity ProjectContext.Project
        do "Store task record"
      }
      on updateTaskStatus: command Project.UpdateTaskStatus is {
        tell event Project.TaskStatusUpdated(projectId = updateTaskStatus.projectId, taskId = updateTaskStatus.taskId, status = updateTaskStatus.status) to entity ProjectContext.Project
        do "Update task status"
      }
      on assignResource: command Project.AssignResource is {
        tell event Project.ResourceAssigned(projectId = assignResource.projectId, allocation = assignResource.allocation) to entity ProjectContext.Project
        do "Store resource allocation"
      }
      on recordTime: command Project.RecordTime is {
        tell event Project.TimeRecorded(projectId = recordTime.projectId, entry = recordTime.entry) to entity ProjectContext.Project
        do "Store time entry"
      }
      on addMilestone: command Project.AddMilestone is {
        tell event Project.MilestoneAdded(projectId = addMilestone.projectId, phaseId = addMilestone.phaseId, milestone = addMilestone.milestone) to entity ProjectContext.Project
        do "Store milestone record"
      }
      on completeMilestone: command Project.CompleteMilestone is {
        tell event Project.MilestoneCompleted(projectId = completeMilestone.projectId, milestoneId = completeMilestone.milestoneId) to entity ProjectContext.Project
        do "Update milestone completion"
      }
      on addRisk: command Project.AddRisk is {
        tell event Project.RiskAdded(projectId = addRisk.projectId, risk = addRisk.risk) to entity ProjectContext.Project
        do "Store risk record"
      }
      on updateRisk: command Project.UpdateRisk is {
        tell event Project.RiskUpdated(projectId = updateRisk.projectId, riskId = updateRisk.riskId, riskStatus = updateRisk.riskStatus) to entity ProjectContext.Project
        do "Update risk status"
      }
      on completeProject: command Project.CompleteProject is {
        tell event Project.ProjectCompleted(projectId = completeProject.projectId, summary = completeProject.summary) to entity ProjectContext.Project
        do "Update project to completed"
      }
      on cancelProject: command Project.CancelProject is {
        tell event Project.ProjectCancelled(projectId = cancelProject.projectId, reason = cancelProject.reason) to entity ProjectContext.Project
        do "Update project to cancelled"
      }
    } with {
      briefly "Persists project commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Project data persistence"
    described as {
      | The ProjectRepository provides persistent storage for
      | engineering projects, tasks, and resources.
    }
  }
  // Projector for project analytics
  query GetProjectStats is  {
    projectStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which project stats to retrieve.
      }
    }
  } with {
    briefly "Get project stats"
    described as {
      |Retrieves the project stats projection.
    }
  }
  result ProjectStatsView is  {
    projectStats: ProjectAnalytics.ProjectStats with {
      briefly "Project stats"
      described as {
        |The project stats being returned.
      }
    }
  } with {
    briefly "Project stats view"
    described as {
      |Read model view carrying the project stats projection.
    }
  }
  projector ProjectAnalytics as flow is {
    updates repository ProjectContext.ProjectRepository
    inlet ProjectAnalyticsFromProject is type ProjectEvent    outlet ProjectAnalyticsOut is type ProjectEvent
    record ProjectStats is  {
      clientId: UUID with {
        briefly "Client"
        described as {
          |Client ID.
        }
      }
      totalProjects: Natural with {
        briefly "Projects"
        described as {
          |Total projects.
        }
      }
      activeProjects: Natural with {
        briefly "Active"
        described as {
          |Active projects.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageDuration: Duration with {
        briefly "Duration"
        described as {
          |Average project duration.
        }
      }
      totalBudget: Decimal(15,2) with {
        briefly "Budget"
        described as {
          |Total budget allocated.
        }
      }
    } with {
      briefly "Project statistics"
      described as {
        |Client project metrics.
      }
    }
    handler AnalyticsHandler is {
      on projectCreated: event Project.ProjectCreated is {
        tell projectCreated to repository ProjectContext.ProjectRepository
        do "Update project counts"
      }
      on taskStatusUpdated: event Project.TaskStatusUpdated is {
        tell taskStatusUpdated to repository ProjectContext.ProjectRepository
        do "Update task metrics"
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        tell milestoneCompleted to repository ProjectContext.ProjectRepository
        do "Update milestone metrics"
      }
      on projectCompleted: event Project.ProjectCompleted is {
        tell projectCompleted to repository ProjectContext.ProjectRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains project analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Project analytics projections"
    described as {
      |Maintains engineering project analytics data.
    }
  }
  // ---- Event publication for Project ----
  type ProjectEvent is one of {
    ProjectContext.Project.ProjectCreated or ProjectContext.Project.ProjectUpdated or ProjectContext.Project.PhaseAdded or ProjectContext.Project.PhaseUpdated or ProjectContext.Project.TaskAdded or ProjectContext.Project.TaskStatusUpdated or ProjectContext.Project.ResourceAssigned or ProjectContext.Project.TimeRecorded or ProjectContext.Project.MilestoneAdded or ProjectContext.Project.MilestoneCompleted or ProjectContext.Project.RiskAdded or ProjectContext.Project.RiskUpdated or ProjectContext.Project.ProjectPlacedOnHold or ProjectContext.Project.ProjectResumed or ProjectContext.Project.ProjectCompleted or ProjectContext.Project.ProjectCancelled
  } with {
    briefly "Project event alternation"
    described as {
      |Union of all Project events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ProjectEventSource as source is {
    outlet ProjectEvents is type ProjectEvent
    handler ProjectSourceHandler is {
      on projectCreated: event Project.ProjectCreated is {
        send projectCreated to outlet ProjectEvents
      }
      on projectUpdated: event Project.ProjectUpdated is {
        send projectUpdated to outlet ProjectEvents
      }
      on phaseAdded: event Project.PhaseAdded is {
        send phaseAdded to outlet ProjectEvents
      }
      on phaseUpdated: event Project.PhaseUpdated is {
        send phaseUpdated to outlet ProjectEvents
      }
      on taskAdded: event Project.TaskAdded is {
        send taskAdded to outlet ProjectEvents
      }
      on taskStatusUpdated: event Project.TaskStatusUpdated is {
        send taskStatusUpdated to outlet ProjectEvents
      }
      on resourceAssigned: event Project.ResourceAssigned is {
        send resourceAssigned to outlet ProjectEvents
      }
      on timeRecorded: event Project.TimeRecorded is {
        send timeRecorded to outlet ProjectEvents
      }
      on milestoneAdded: event Project.MilestoneAdded is {
        send milestoneAdded to outlet ProjectEvents
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        send milestoneCompleted to outlet ProjectEvents
      }
      on riskAdded: event Project.RiskAdded is {
        send riskAdded to outlet ProjectEvents
      }
      on riskUpdated: event Project.RiskUpdated is {
        send riskUpdated to outlet ProjectEvents
      }
      on projectPlacedOnHold: event Project.ProjectPlacedOnHold is {
        send projectPlacedOnHold to outlet ProjectEvents
      }
      on projectResumed: event Project.ProjectResumed is {
        send projectResumed to outlet ProjectEvents
      }
      on projectCompleted: event Project.ProjectCompleted is {
        send projectCompleted to outlet ProjectEvents
      }
      on projectCancelled: event Project.ProjectCancelled is {
        send projectCancelled to outlet ProjectEvents
      }
      on other is {
        error "Unexpected message for source ProjectEventSource"
      }
    } with {
      briefly "Project source handler"
      described as {
        |Publishes Project events onto the outlet.
      }
    }
  } with {
    briefly "Project event source"
    described as {
      |Publishes Project entity events into the streaming topology.
    }
  }
  processor ProjectEventSink as sink is {
    inlet ProjectInlet is type ProjectEvent    handler ProjectSinkHandler is {
      on projectCreated: event Project.ProjectCreated is {
        tell projectCreated to repository ProjectContext.ProjectRepository
      }
      on projectUpdated: event Project.ProjectUpdated is {
        tell projectUpdated to repository ProjectContext.ProjectRepository
      }
      on phaseAdded: event Project.PhaseAdded is {
        tell phaseAdded to repository ProjectContext.ProjectRepository
      }
      on phaseUpdated: event Project.PhaseUpdated is {
        tell phaseUpdated to repository ProjectContext.ProjectRepository
      }
      on taskAdded: event Project.TaskAdded is {
        tell taskAdded to repository ProjectContext.ProjectRepository
      }
      on taskStatusUpdated: event Project.TaskStatusUpdated is {
        tell taskStatusUpdated to repository ProjectContext.ProjectRepository
      }
      on resourceAssigned: event Project.ResourceAssigned is {
        tell resourceAssigned to repository ProjectContext.ProjectRepository
      }
      on timeRecorded: event Project.TimeRecorded is {
        tell timeRecorded to repository ProjectContext.ProjectRepository
      }
      on milestoneAdded: event Project.MilestoneAdded is {
        tell milestoneAdded to repository ProjectContext.ProjectRepository
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        tell milestoneCompleted to repository ProjectContext.ProjectRepository
      }
      on riskAdded: event Project.RiskAdded is {
        tell riskAdded to repository ProjectContext.ProjectRepository
      }
      on riskUpdated: event Project.RiskUpdated is {
        tell riskUpdated to repository ProjectContext.ProjectRepository
      }
      on projectPlacedOnHold: event Project.ProjectPlacedOnHold is {
        tell projectPlacedOnHold to repository ProjectContext.ProjectRepository
      }
      on projectResumed: event Project.ProjectResumed is {
        tell projectResumed to repository ProjectContext.ProjectRepository
      }
      on projectCompleted: event Project.ProjectCompleted is {
        tell projectCompleted to repository ProjectContext.ProjectRepository
      }
      on projectCancelled: event Project.ProjectCancelled is {
        tell projectCancelled to repository ProjectContext.ProjectRepository
      }
      on other is {
        error "Unexpected message for sink ProjectEventSink"
      }
    } with {
      briefly "Project sink handler"
      described as {
        |Persists Project events via the repository.
      }
    }
  } with {
    briefly "Project event sink"
    described as {
      |Receives Project events for persistence.
    }
  }
  connector ProjectEventFlow is from outlet ProjectContext.ProjectEventSource.ProjectEvents to inlet ProjectContext.ProjectEventSink.ProjectInlet with {
    briefly "Project event flow"
    described as {
      |Connects the Project source to its sink.
    }
  }
  processor ProjectEventSplit as split is {
    inlet ProjectEventSplitIn is type ProjectEvent    outlet ProjectEventSplitToProjectRepository is type ProjectEvent
    outlet ProjectEventSplitToProjectAnalytics is type ProjectEvent
    handler ProjectEventSplitHandler is {
      on projectCreated: event Project.ProjectCreated is {
        send projectCreated to outlet ProjectEventSplitToProjectRepository
        send projectCreated to outlet ProjectEventSplitToProjectAnalytics
        tell projectCreated to entity ProjectContext.Project
      }
      on projectUpdated: event Project.ProjectUpdated is {
        send projectUpdated to outlet ProjectEventSplitToProjectRepository
        send projectUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell projectUpdated to entity ProjectContext.Project
      }
      on phaseAdded: event Project.PhaseAdded is {
        send phaseAdded to outlet ProjectEventSplitToProjectRepository
        send phaseAdded to outlet ProjectEventSplitToProjectAnalytics
        tell phaseAdded to entity ProjectContext.Project
      }
      on phaseUpdated: event Project.PhaseUpdated is {
        send phaseUpdated to outlet ProjectEventSplitToProjectRepository
        send phaseUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell phaseUpdated to entity ProjectContext.Project
      }
      on taskAdded: event Project.TaskAdded is {
        send taskAdded to outlet ProjectEventSplitToProjectRepository
        send taskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell taskAdded to entity ProjectContext.Project
      }
      on taskStatusUpdated: event Project.TaskStatusUpdated is {
        send taskStatusUpdated to outlet ProjectEventSplitToProjectRepository
        send taskStatusUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell taskStatusUpdated to entity ProjectContext.Project
      }
      on resourceAssigned: event Project.ResourceAssigned is {
        send resourceAssigned to outlet ProjectEventSplitToProjectRepository
        send resourceAssigned to outlet ProjectEventSplitToProjectAnalytics
        tell resourceAssigned to entity ProjectContext.Project
      }
      on timeRecorded: event Project.TimeRecorded is {
        send timeRecorded to outlet ProjectEventSplitToProjectRepository
        send timeRecorded to outlet ProjectEventSplitToProjectAnalytics
        tell timeRecorded to entity ProjectContext.Project
      }
      on milestoneAdded: event Project.MilestoneAdded is {
        send milestoneAdded to outlet ProjectEventSplitToProjectRepository
        send milestoneAdded to outlet ProjectEventSplitToProjectAnalytics
        tell milestoneAdded to entity ProjectContext.Project
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        send milestoneCompleted to outlet ProjectEventSplitToProjectRepository
        send milestoneCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell milestoneCompleted to entity ProjectContext.Project
      }
      on riskAdded: event Project.RiskAdded is {
        send riskAdded to outlet ProjectEventSplitToProjectRepository
        send riskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell riskAdded to entity ProjectContext.Project
      }
      on riskUpdated: event Project.RiskUpdated is {
        send riskUpdated to outlet ProjectEventSplitToProjectRepository
        send riskUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell riskUpdated to entity ProjectContext.Project
      }
      on projectPlacedOnHold: event Project.ProjectPlacedOnHold is {
        send projectPlacedOnHold to outlet ProjectEventSplitToProjectRepository
        send projectPlacedOnHold to outlet ProjectEventSplitToProjectAnalytics
        tell projectPlacedOnHold to entity ProjectContext.Project
      }
      on projectResumed: event Project.ProjectResumed is {
        send projectResumed to outlet ProjectEventSplitToProjectRepository
        send projectResumed to outlet ProjectEventSplitToProjectAnalytics
        tell projectResumed to entity ProjectContext.Project
      }
      on projectCompleted: event Project.ProjectCompleted is {
        send projectCompleted to outlet ProjectEventSplitToProjectRepository
        send projectCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell projectCompleted to entity ProjectContext.Project
      }
      on projectCancelled: event Project.ProjectCancelled is {
        send projectCancelled to outlet ProjectEventSplitToProjectRepository
        send projectCancelled to outlet ProjectEventSplitToProjectAnalytics
        tell projectCancelled to entity ProjectContext.Project
      }
      on other is {
        error "Unexpected message for processor ProjectEventSplit"
      }
    } with {
      briefly "Project event fan-out handler"
      described as {
        |Delivers each Project event to all of its consumers.
      }
    }
  } with {
    briefly "Project event fan-out"
    described as {
      |Fans Project events out to the repository and projectors.
    }
  }
  connector 'ProjectEvent Stream' is from outlet ProjectContext.Project.ProjectEvents2 to inlet ProjectContext.ProjectEventSplit.ProjectEventSplitIn with {
    briefly "Project events, fanned out to storage and read models"
  }
  connector 'ProjectEvent Storage' is from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectRepository to inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProject with {
    briefly "Project events on their way to storage"
  }
  connector 'ProjectAnalytics Feed' is from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectAnalytics to inlet ProjectContext.ProjectAnalytics.ProjectAnalyticsFromProject with {
    briefly "Project events feeding the ProjectAnalytics projection"
  }
  connector 'ProjectAnalytics Storage' is from outlet ProjectContext.ProjectAnalytics.ProjectAnalyticsOut to inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProjectAnalytics with {
    briefly "The ProjectAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for engineering projects"
  described as {
    | The ProjectContext is the bounded context for engineering
    | project management, execution, and resource tracking.
  }
}
