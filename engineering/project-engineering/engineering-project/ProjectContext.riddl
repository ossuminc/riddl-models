// Engineering Project - Project Context
context ProjectContext as router is {
  inlet ProjectCommandStreamIn is type ProjectCommand  outlet ProjectCommandStreamOut is type ProjectCommand
  inlet ProjectResultStreamIn is result Project.ProjectResult  outlet ProjectResultStreamOut is result Project.ProjectResult
  handler ProjectContextBoundary is {
    on createProject: command Project.CreateProject is {
      send createProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on updateProject: command Project.UpdateProject is {
      send updateProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on addPhase: command Project.AddPhase is {
      send addPhase to outlet ProjectContext.ProjectCommandStreamOut
    }
    on updatePhase: command Project.UpdatePhase is {
      send updatePhase to outlet ProjectContext.ProjectCommandStreamOut
    }
    on addTask: command Project.AddTask is {
      send addTask to outlet ProjectContext.ProjectCommandStreamOut
    }
    on updateTaskStatus: command Project.UpdateTaskStatus is {
      send updateTaskStatus to outlet ProjectContext.ProjectCommandStreamOut
    }
    on assignResource: command Project.AssignResource is {
      send assignResource to outlet ProjectContext.ProjectCommandStreamOut
    }
    on recordTime: command Project.RecordTime is {
      send recordTime to outlet ProjectContext.ProjectCommandStreamOut
    }
    on addMilestone: command Project.AddMilestone is {
      send addMilestone to outlet ProjectContext.ProjectCommandStreamOut
    }
    on completeMilestone: command Project.CompleteMilestone is {
      send completeMilestone to outlet ProjectContext.ProjectCommandStreamOut
    }
    on addRisk: command Project.AddRisk is {
      send addRisk to outlet ProjectContext.ProjectCommandStreamOut
    }
    on updateRisk: command Project.UpdateRisk is {
      send updateRisk to outlet ProjectContext.ProjectCommandStreamOut
    }
    on placeOnHold: command Project.PlaceOnHold is {
      send placeOnHold to outlet ProjectContext.ProjectCommandStreamOut
    }
    on resumeProject: command Project.ResumeProject is {
      send resumeProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on completeProject: command Project.CompleteProject is {
      send completeProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on cancelProject: command Project.CancelProject is {
      send cancelProject to outlet ProjectContext.ProjectCommandStreamOut
    }
    on projectResult: result Project.ProjectResult is {
      send projectResult to outlet ProjectContext.ProjectResultStreamOut
    }
    on other is {
      error "Unexpected message at the ProjectContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ProjectCommand Stream Intake' is from outlet ProjectContext.ProjectCommandStreamOut to inlet ProjectContext.Project.ProjectCommands  connector 'ProjectResult Stream Egress' is from outlet ProjectContext.ProjectRepository.ProjectRepositoryResponses to inlet ProjectContext.ProjectResultStreamIn  adaptor FromBillingService from context BillingService as flow is { 
    inlet FromBillingServiceIn is event BillingService.InvoiceCreated    handler FromBillingServiceHandler is {
      on invoiceCreated: event BillingService.InvoiceCreated is {
        do "the invoice exists; the time it bills was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromBillingService"
      }
    } with {
      briefly "from billing service"
      described as {
        |Carries messages from the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor ToBillingService to context BillingService as flow is { 
    outlet ToBillingServiceOut is command BillingService.CreateInvoice
    handler ToBillingServiceHandler is {
      on milestoneCompleted: event Project.MilestoneCompleted is {
        let notice: type BillingService.CreateInvoice = prompt("translate the milestoneCompleted event into a CreateInvoice billing the project milestone just completed, whose value is now fixed")
        send notice to outlet ProjectContext.ToBillingService.ToBillingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToBillingService"
      }
    } with {
      briefly "to billing service"
      described as {
        |Carries messages to the external BillingService.
      }
    }
  } with {
    briefly "BillingService integration"
    described as {
      |The model's side of the BillingService conversation.
    }
  }
  adaptor FromCalendarService from context CalendarService as flow is { 
    inlet FromCalendarServiceIn is event CalendarService.MeetingScheduled    handler FromCalendarServiceHandler is {
      on meetingScheduled: event CalendarService.MeetingScheduled is {
        do "the meeting is on the calendar; the project's own milestones are unaffected"
      }
      on other is {
        error "Unexpected message for adaptor FromCalendarService"
      }
    } with {
      briefly "from calendar service"
      described as {
        |Carries messages from the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor ToCalendarService to context CalendarService as flow is { 
    outlet ToCalendarServiceOut is command CalendarService.ScheduleMeeting
    handler ToCalendarServiceHandler is {
      on milestoneAdded: event Project.MilestoneAdded is {
        let request: type CalendarService.ScheduleMeeting = prompt("translate the milestoneAdded event into a ScheduleMeeting putting the milestone review in the team's calendars")
        send request to outlet ProjectContext.ToCalendarService.ToCalendarServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCalendarService"
      }
    } with {
      briefly "to calendar service"
      described as {
        |Carries messages to the external CalendarService.
      }
    }
  } with {
    briefly "CalendarService integration"
    described as {
      |The model's side of the CalendarService conversation.
    }
  }
  adaptor FromClientService from context ClientService as flow is { 
    inlet FromClientServiceIn is event ClientService.ClientUpdated    handler FromClientServiceHandler is {
      on clientUpdated: event ClientService.ClientUpdated is {
        do "client details live in the client system; the project carries only what it needs"
      }
      on other is {
        error "Unexpected message for adaptor FromClientService"
      }
    } with {
      briefly "from client service"
      described as {
        |Carries messages from the external ClientService.
      }
    }
  } with {
    briefly "ClientService integration"
    described as {
      |The model's side of the ClientService conversation.
    }
  }
  adaptor FromDocumentService from context DocumentService as flow is { 
    inlet FromDocumentServiceIn is event DocumentService.DeliverableStored    handler FromDocumentServiceHandler is {
      on deliverableStored: event DocumentService.DeliverableStored is {
        do "the deliverable is safe; completing the milestone it belongs to is a separate act"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService as flow is { 
    outlet ToDocumentServiceOut is command DocumentService.StoreDeliverable
    handler ToDocumentServiceHandler is {
      on milestoneCompleted: event MilestoneCompleted is {
        let artifact: type DocumentService.StoreDeliverable = prompt("translate the milestoneCompleted event into a StoreDeliverable keeping what the milestone produced")
        send artifact to outlet ProjectContext.ToDocumentService.ToDocumentServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    outlet ToNotificationServiceOut is command NotificationService.SendProjectUpdate
    handler ToNotificationServiceHandler is {
      on milestoneCompleted: event MilestoneCompleted is {
        let notice: type NotificationService.SendProjectUpdate = prompt("translate the milestoneCompleted event into a SendProjectUpdate telling the client a milestone is met, since schedule and invoicing both hang on it")
        send notice to outlet ProjectContext.ToNotificationService.ToNotificationServiceOut
      }
      on phaseUpdated: event PhaseUpdated is {
        let notice: type NotificationService.SendProjectUpdate = prompt("translate the phaseUpdated event into a SendProjectUpdate telling the client the phase plan has changed and what now stands")
        send notice to outlet ProjectContext.ToNotificationService.ToNotificationServiceOut
      }
      on projectPlacedOnHold: event ProjectPlacedOnHold is {
        let notice: type NotificationService.SendProjectUpdate = prompt("translate the projectPlacedOnHold event into a SendProjectUpdate telling the client work has stopped and why")
        send notice to outlet ProjectContext.ToNotificationService.ToNotificationServiceOut
      }
      on projectResumed: event ProjectResumed is {
        let notice: type NotificationService.SendProjectUpdate = prompt("translate the projectResumed event into a SendProjectUpdate telling the client work has restarted")
        send notice to outlet ProjectContext.ToNotificationService.ToNotificationServiceOut
      }
      on projectCompleted: event ProjectCompleted is {
        let notice: type NotificationService.SendProjectUpdate = prompt("translate the projectCompleted event into a SendProjectUpdate telling the client the project is finished")
        send notice to outlet ProjectContext.ToNotificationService.ToNotificationServiceOut
      }
      on riskAdded: event RiskAdded is {
        let notice: type NotificationService.SendProjectUpdate = prompt("translate the riskAdded event into a SendProjectUpdate telling the client a risk has been logged against their project, since they may have to decide about it")
        send notice to outlet ProjectContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToResourceService to context ResourceService as flow is { 
    outlet ToResourceServiceOut is query ResourceService.GetAvailableResources
    handler ToResourceServiceHandler is {
      on taskAdded: event Project.TaskAdded is {
        let askAnswer: type ResourceService.ResourceAvailability = ask query ResourceService.GetAvailableResources of context ResourceService
        do "a new task needing people free to be put on it"
      }
      on other is {
        error "Unexpected message for adaptor ToResourceService"
      }
    } with {
      briefly "to resource service"
      described as {
        |Carries messages to the external ResourceService.
      }
    }
  } with {
    briefly "ResourceService integration"
    described as {
      |The model's side of the ResourceService conversation.
    }
  }
  include "types.riddl"
  include "Project.riddl"
  // Repository for project persistence
  type ProjectRepositoryCommand is one of {
    ProjectContext.ProjectRepository.PersistMilestoneAdded or ProjectContext.ProjectRepository.PersistMilestoneCompleted or ProjectContext.ProjectRepository.PersistPhaseAdded or ProjectContext.ProjectRepository.PersistPhaseUpdated or ProjectContext.ProjectRepository.PersistProjectCancelled or ProjectContext.ProjectRepository.PersistProjectCompleted or ProjectContext.ProjectRepository.PersistProjectCreated or ProjectContext.ProjectRepository.PersistProjectPlacedOnHold or ProjectContext.ProjectRepository.PersistProjectResumed or ProjectContext.ProjectRepository.PersistProjectUpdated or ProjectContext.ProjectRepository.PersistResourceAssigned or ProjectContext.ProjectRepository.PersistRiskAdded or ProjectContext.ProjectRepository.PersistRiskUpdated or ProjectContext.ProjectRepository.PersistTaskAdded or ProjectContext.ProjectRepository.PersistTaskStatusUpdated or ProjectContext.ProjectRepository.PersistTimeRecorded
  } with {
    briefly "Anything that writes ProjectRepository"
    described as {
      |The persistence commands ProjectRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ProjectRepository as flow is {
    inlet ProjectRepositoryFromProjectAnalytics is type ProjectRepositoryCommand    command PersistMilestoneAdded is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneAdded applies to.
        }
      }
    } with {
      briefly "Persist MilestoneAdded"
      described as {
        |Instructs this repository to apply MilestoneAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPhaseAdded is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row PhaseAdded applies to.
        }
      }
    } with {
      briefly "Persist PhaseAdded"
      described as {
        |Instructs this repository to apply PhaseAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPhaseUpdated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row PhaseUpdated applies to.
        }
      }
    } with {
      briefly "Persist PhaseUpdated"
      described as {
        |Instructs this repository to apply PhaseUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectCancelled is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectCancelled applies to.
        }
      }
    } with {
      briefly "Persist ProjectCancelled"
      described as {
        |Instructs this repository to apply ProjectCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectPlacedOnHold is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectPlacedOnHold applies to.
        }
      }
    } with {
      briefly "Persist ProjectPlacedOnHold"
      described as {
        |Instructs this repository to apply ProjectPlacedOnHold to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectResumed is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectResumed applies to.
        }
      }
    } with {
      briefly "Persist ProjectResumed"
      described as {
        |Instructs this repository to apply ProjectResumed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectUpdated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectUpdated applies to.
        }
      }
    } with {
      briefly "Persist ProjectUpdated"
      described as {
        |Instructs this repository to apply ProjectUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistResourceAssigned is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ResourceAssigned applies to.
        }
      }
    } with {
      briefly "Persist ResourceAssigned"
      described as {
        |Instructs this repository to apply ResourceAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRiskAdded is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row RiskAdded applies to.
        }
      }
    } with {
      briefly "Persist RiskAdded"
      described as {
        |Instructs this repository to apply RiskAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRiskUpdated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row RiskUpdated applies to.
        }
      }
    } with {
      briefly "Persist RiskUpdated"
      described as {
        |Instructs this repository to apply RiskUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskAdded is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskAdded applies to.
        }
      }
    } with {
      briefly "Persist TaskAdded"
      described as {
        |Instructs this repository to apply TaskAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTimeRecorded is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row TimeRecorded applies to.
        }
      }
    } with {
      briefly "Persist TimeRecorded"
      described as {
        |Instructs this repository to apply TimeRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneCompleted is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneCompleted applies to.
        }
      }
    } with {
      briefly "Persist MilestoneCompleted"
      described as {
        |Instructs this repository to apply MilestoneCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectCompleted is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectCompleted applies to.
        }
      }
    } with {
      briefly "Persist ProjectCompleted"
      described as {
        |Instructs this repository to apply ProjectCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProjectCreated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProjectCreated applies to.
        }
      }
    } with {
      briefly "Persist ProjectCreated"
      described as {
        |Instructs this repository to apply ProjectCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTaskStatusUpdated is {
      projectId: ProjectId with {
        briefly "Row addressed"
        described as {
          |Which stored row TaskStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist TaskStatusUpdated"
      described as {
        |Instructs this repository to apply TaskStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ProjectRepositoryResponses is result Project.ProjectResult
    record StoredProject is {
      projectId: ProjectId with {
        briefly "projectId"
        described as {
          |The projectId column of the stored project row.
        }
      }
      info: ProjectInfo with {
        briefly "info"
        described as {
          |The info column of the stored project row.
        }
      }
    } with {
      briefly "Stored project row"
      described as {
        |The persistence shape of project data as this repository stores it.
      }
    }
    schema ProjectData is relational
      of projects as record StoredProject
        index on field StoredProject.projectId
        index on field StoredProject.info.clientId
 with {
      briefly "Project data schema"
      described as {
        |The relational schema holding project data for the ProjectRepository.
      }
    }
    handler ProjectPersistence is {
      on persistMilestoneAdded: command PersistMilestoneAdded is {
        do "apply MilestoneAdded to the stored row"
      }
      on persistPhaseAdded: command PersistPhaseAdded is {
        do "apply PhaseAdded to the stored row"
      }
      on persistPhaseUpdated: command PersistPhaseUpdated is {
        do "apply PhaseUpdated to the stored row"
      }
      on persistProjectCancelled: command PersistProjectCancelled is {
        do "apply ProjectCancelled to the stored row"
      }
      on persistProjectPlacedOnHold: command PersistProjectPlacedOnHold is {
        do "apply ProjectPlacedOnHold to the stored row"
      }
      on persistProjectResumed: command PersistProjectResumed is {
        do "apply ProjectResumed to the stored row"
      }
      on persistProjectUpdated: command PersistProjectUpdated is {
        do "apply ProjectUpdated to the stored row"
      }
      on persistResourceAssigned: command PersistResourceAssigned is {
        do "apply ResourceAssigned to the stored row"
      }
      on persistRiskAdded: command PersistRiskAdded is {
        do "apply RiskAdded to the stored row"
      }
      on persistRiskUpdated: command PersistRiskUpdated is {
        do "apply RiskUpdated to the stored row"
      }
      on persistTaskAdded: command PersistTaskAdded is {
        do "apply TaskAdded to the stored row"
      }
      on persistTimeRecorded: command PersistTimeRecorded is {
        do "apply TimeRecorded to the stored row"
      }
      on persistMilestoneCompleted: command PersistMilestoneCompleted is {
        do "apply MilestoneCompleted to the stored row"
      }
      on persistProjectCompleted: command PersistProjectCompleted is {
        do "apply ProjectCompleted to the stored row"
      }
      on persistProjectCreated: command PersistProjectCreated is {
        do "apply ProjectCreated to the stored row"
      }
      on persistTaskStatusUpdated: command PersistTaskStatusUpdated is {
        do "apply TaskStatusUpdated to the stored row"
      }
      on query GetProjectStats is {
        let projectStatsView: type ProjectStatsView = prompt("read the project stats projection")
        reply projectStatsView
      }
    } with {
      briefly "Persists project commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Project data persistence"
    described as {
      | The ProjectRepository provides persistent storage for
      | engineering projects, tasks, and resources.
    }
  }
  // Projector for project analytics
  query GetProjectStats replies result ProjectStatsView is {
    projectStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which project stats to retrieve.
      }
    }
  } with {
    briefly "Get project stats"
    described as {
      |Retrieves the project stats projection.
    }
  }
  result ProjectStatsView is {
    projectStats: ProjectAnalytics.ProjectStats with {
      briefly "Project stats"
      described as {
        |The project stats being returned.
      }
    }
  } with {
    briefly "Project stats view"
    described as {
      |Read model view carrying the project stats projection.
    }
  }
  projector ProjectAnalytics as flow is {
    updates repository ProjectContext.ProjectRepository
    outlet ProjectAnalyticsToRepository is type ProjectRepositoryCommand
    inlet ProjectAnalyticsFromProject is type ProjectEvent    record ProjectStats is {
      clientId: UUID with {
        briefly "Client"
        described as {
          |Client ID.
        }
      }
      totalProjects: Natural with {
        briefly "Projects"
        described as {
          |Total projects.
        }
      }
      activeProjects: Natural with {
        briefly "Active"
        described as {
          |Active projects.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageDuration: Duration with {
        briefly "Duration"
        described as {
          |Average project duration.
        }
      }
      totalBudget: Decimal(15,2) with {
        briefly "Budget"
        described as {
          |Total budget allocated.
        }
      }
    } with {
      briefly "Project statistics"
      described as {
        |Client project metrics.
      }
    }
    handler AnalyticsHandler is {
      on milestoneAdded: event Project.MilestoneAdded is {
        tell command ProjectContext.ProjectRepository.PersistMilestoneAdded(projectId = milestoneAdded.projectId) to repository ProjectContext.ProjectRepository
        do "apply MilestoneAdded to the ProjectAnalytics projection"
      }
      on phaseAdded: event Project.PhaseAdded is {
        tell command ProjectContext.ProjectRepository.PersistPhaseAdded(projectId = phaseAdded.projectId) to repository ProjectContext.ProjectRepository
        do "apply PhaseAdded to the ProjectAnalytics projection"
      }
      on phaseUpdated: event Project.PhaseUpdated is {
        tell command ProjectContext.ProjectRepository.PersistPhaseUpdated(projectId = phaseUpdated.projectId) to repository ProjectContext.ProjectRepository
        do "apply PhaseUpdated to the ProjectAnalytics projection"
      }
      on projectCancelled: event Project.ProjectCancelled is {
        tell command ProjectContext.ProjectRepository.PersistProjectCancelled(projectId = projectCancelled.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectCancelled to the ProjectAnalytics projection"
      }
      on projectPlacedOnHold: event Project.ProjectPlacedOnHold is {
        tell command ProjectContext.ProjectRepository.PersistProjectPlacedOnHold(projectId = projectPlacedOnHold.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectPlacedOnHold to the ProjectAnalytics projection"
      }
      on projectResumed: event Project.ProjectResumed is {
        tell command ProjectContext.ProjectRepository.PersistProjectResumed(projectId = projectResumed.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectResumed to the ProjectAnalytics projection"
      }
      on projectUpdated: event Project.ProjectUpdated is {
        tell command ProjectContext.ProjectRepository.PersistProjectUpdated(projectId = projectUpdated.projectId) to repository ProjectContext.ProjectRepository
        do "apply ProjectUpdated to the ProjectAnalytics projection"
      }
      on resourceAssigned: event Project.ResourceAssigned is {
        tell command ProjectContext.ProjectRepository.PersistResourceAssigned(projectId = resourceAssigned.projectId) to repository ProjectContext.ProjectRepository
        do "apply ResourceAssigned to the ProjectAnalytics projection"
      }
      on riskAdded: event Project.RiskAdded is {
        tell command ProjectContext.ProjectRepository.PersistRiskAdded(projectId = riskAdded.projectId) to repository ProjectContext.ProjectRepository
        do "apply RiskAdded to the ProjectAnalytics projection"
      }
      on riskUpdated: event Project.RiskUpdated is {
        tell command ProjectContext.ProjectRepository.PersistRiskUpdated(projectId = riskUpdated.projectId) to repository ProjectContext.ProjectRepository
        do "apply RiskUpdated to the ProjectAnalytics projection"
      }
      on taskAdded: event Project.TaskAdded is {
        tell command ProjectContext.ProjectRepository.PersistTaskAdded(projectId = taskAdded.projectId) to repository ProjectContext.ProjectRepository
        do "apply TaskAdded to the ProjectAnalytics projection"
      }
      on timeRecorded: event Project.TimeRecorded is {
        tell command ProjectContext.ProjectRepository.PersistTimeRecorded(projectId = timeRecorded.projectId) to repository ProjectContext.ProjectRepository
        do "apply TimeRecorded to the ProjectAnalytics projection"
      }
      on projectCreated: event Project.ProjectCreated is {
        tell command ProjectContext.ProjectRepository.PersistProjectCreated(projectId = projectCreated.projectId) to repository ProjectContext.ProjectRepository
        do "Update project counts"
      }
      on taskStatusUpdated: event Project.TaskStatusUpdated is {
        tell command ProjectContext.ProjectRepository.PersistTaskStatusUpdated(projectId = taskStatusUpdated.projectId) to repository ProjectContext.ProjectRepository
        do "Update task metrics"
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        tell command ProjectContext.ProjectRepository.PersistMilestoneCompleted(projectId = milestoneCompleted.projectId) to repository ProjectContext.ProjectRepository
        do "Update milestone metrics"
      }
      on projectCompleted: event Project.ProjectCompleted is {
        tell command ProjectContext.ProjectRepository.PersistProjectCompleted(projectId = projectCompleted.projectId) to repository ProjectContext.ProjectRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains project analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Project analytics projections"
    described as {
      |Maintains engineering project analytics data.
    }
  }
  // ---- Event publication for Project ----
  type ProjectEvent is one of {
    ProjectContext.Project.ProjectCreated or ProjectContext.Project.ProjectUpdated or ProjectContext.Project.PhaseAdded or ProjectContext.Project.PhaseUpdated or ProjectContext.Project.TaskAdded or ProjectContext.Project.TaskStatusUpdated or ProjectContext.Project.ResourceAssigned or ProjectContext.Project.TimeRecorded or ProjectContext.Project.MilestoneAdded or ProjectContext.Project.MilestoneCompleted or ProjectContext.Project.RiskAdded or ProjectContext.Project.RiskUpdated or ProjectContext.Project.ProjectPlacedOnHold or ProjectContext.Project.ProjectResumed or ProjectContext.Project.ProjectCompleted or ProjectContext.Project.ProjectCancelled
  } with {
    briefly "Project event alternation"
    described as {
      |Union of all Project events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet ProjectEventSplit as flow is {
    inlet ProjectEventSplitIn is type ProjectEvent    outlet ProjectEventSplitToProjectAnalytics is type ProjectEvent
    handler ProjectEventSplitHandler is {
      on projectCreated: event Project.ProjectCreated is {
        send projectCreated to outlet ProjectEventSplitToProjectAnalytics
        tell projectCreated to entity ProjectContext.Project
      }
      on projectUpdated: event Project.ProjectUpdated is {
        send projectUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell projectUpdated to entity ProjectContext.Project
      }
      on phaseAdded: event Project.PhaseAdded is {
        send phaseAdded to outlet ProjectEventSplitToProjectAnalytics
        tell phaseAdded to entity ProjectContext.Project
      }
      on phaseUpdated: event Project.PhaseUpdated is {
        send phaseUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell phaseUpdated to entity ProjectContext.Project
      }
      on taskAdded: event Project.TaskAdded is {
        send taskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell taskAdded to entity ProjectContext.Project
      }
      on taskStatusUpdated: event Project.TaskStatusUpdated is {
        send taskStatusUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell taskStatusUpdated to entity ProjectContext.Project
      }
      on resourceAssigned: event Project.ResourceAssigned is {
        send resourceAssigned to outlet ProjectEventSplitToProjectAnalytics
        tell resourceAssigned to entity ProjectContext.Project
      }
      on timeRecorded: event Project.TimeRecorded is {
        send timeRecorded to outlet ProjectEventSplitToProjectAnalytics
        tell timeRecorded to entity ProjectContext.Project
      }
      on milestoneAdded: event Project.MilestoneAdded is {
        send milestoneAdded to outlet ProjectEventSplitToProjectAnalytics
        tell milestoneAdded to entity ProjectContext.Project
      }
      on milestoneCompleted: event Project.MilestoneCompleted is {
        send milestoneCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell milestoneCompleted to entity ProjectContext.Project
      }
      on riskAdded: event Project.RiskAdded is {
        send riskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell riskAdded to entity ProjectContext.Project
      }
      on riskUpdated: event Project.RiskUpdated is {
        send riskUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell riskUpdated to entity ProjectContext.Project
      }
      on projectPlacedOnHold: event Project.ProjectPlacedOnHold is {
        send projectPlacedOnHold to outlet ProjectEventSplitToProjectAnalytics
        tell projectPlacedOnHold to entity ProjectContext.Project
      }
      on projectResumed: event Project.ProjectResumed is {
        send projectResumed to outlet ProjectEventSplitToProjectAnalytics
        tell projectResumed to entity ProjectContext.Project
      }
      on projectCompleted: event Project.ProjectCompleted is {
        send projectCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell projectCompleted to entity ProjectContext.Project
      }
      on projectCancelled: event Project.ProjectCancelled is {
        send projectCancelled to outlet ProjectEventSplitToProjectAnalytics
        tell projectCancelled to entity ProjectContext.Project
      }
      on other is {
        error "Unexpected message for processor ProjectEventSplit"
      }
    } with {
      briefly "Project event fan-out handler"
      described as {
        |Delivers each Project event to all of its consumers.
      }
    }
  } with {
    briefly "Project event fan-out"
    described as {
      |Fans Project events out to the repository and projectors.
    }
  }
  connector 'ProjectEvent Stream' is from outlet ProjectContext.Project.ProjectEvents2 to inlet ProjectContext.ProjectEventSplit.ProjectEventSplitIn with {
    briefly "Project events, fanned out to storage and read models"
  }
  connector 'ProjectAnalytics Feed' is from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectAnalytics to inlet ProjectContext.ProjectAnalytics.ProjectAnalyticsFromProject with {
    briefly "Project events feeding the ProjectAnalytics projection"
  }
  connector 'ProjectAnalytics Storage' is from outlet ProjectContext.ProjectAnalytics.ProjectAnalyticsToRepository to inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProjectAnalytics with {
    briefly "ProjectAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for engineering projects"
  described as {
    | The ProjectContext is the bounded context for engineering
    | project management, execution, and resource tracking.
  }
}
