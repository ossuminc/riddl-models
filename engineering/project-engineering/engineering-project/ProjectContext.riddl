// Engineering Project - Project Context
context ProjectContext is {
  include "types.riddl"
  include "Project.riddl"
  // Repository for project persistence
  repository ProjectRepository is {
    inlet ProjectRepositoryFromProject is type ProjectEvent
    inlet ProjectRepositoryFromProjectAnalytics is type ProjectEvent
    outlet ProjectRepositoryResponses is type Project.ProjectResult
    schema ProjectData is relational
      of projects as type Project
        index on field Project.projectId
        index on field Project.info.clientId

    handler ProjectPersistence is {
      on command Project.CreateProject is {
        tell event Project.ProjectCreated to entity ProjectContext.Project
        do "Store project record"
      }
      on command Project.UpdateProject is {
        tell event Project.ProjectUpdated to entity ProjectContext.Project
        do "Update project info"
      }
      on command Project.AddPhase is {
        tell event Project.PhaseAdded to entity ProjectContext.Project
        do "Store phase record"
      }
      on command Project.UpdatePhase is {
        tell event Project.PhaseUpdated to entity ProjectContext.Project
        do "Update phase status"
      }
      on command Project.AddTask is {
        tell event Project.TaskAdded to entity ProjectContext.Project
        do "Store task record"
      }
      on command Project.UpdateTaskStatus is {
        tell event Project.TaskStatusUpdated to entity ProjectContext.Project
        do "Update task status"
      }
      on command Project.AssignResource is {
        tell event Project.ResourceAssigned to entity ProjectContext.Project
        do "Store resource allocation"
      }
      on command Project.RecordTime is {
        tell event Project.TimeRecorded to entity ProjectContext.Project
        do "Store time entry"
      }
      on command Project.AddMilestone is {
        tell event Project.MilestoneAdded to entity ProjectContext.Project
        do "Store milestone record"
      }
      on command Project.CompleteMilestone is {
        tell event Project.MilestoneCompleted to entity ProjectContext.Project
        do "Update milestone completion"
      }
      on command Project.AddRisk is {
        tell event Project.RiskAdded to entity ProjectContext.Project
        do "Store risk record"
      }
      on command Project.UpdateRisk is {
        tell event Project.RiskUpdated to entity ProjectContext.Project
        do "Update risk status"
      }
      on command Project.CompleteProject is {
        tell event Project.ProjectCompleted to entity ProjectContext.Project
        do "Update project to completed"
      }
      on command Project.CancelProject is {
        tell event Project.ProjectCancelled to entity ProjectContext.Project
        do "Update project to cancelled"
      }
    } with {
      briefly "Persists project commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Project data persistence"
    described as {
      | The ProjectRepository provides persistent storage for
      | engineering projects, tasks, and resources.
    }
  }
  // Projector for project analytics
  projector ProjectAnalytics is {
    inlet ProjectAnalyticsFromProject is type ProjectEvent
    outlet ProjectAnalyticsOut is type ProjectEvent
    updates repository ProjectContext.ProjectRepository
    record ProjectStats is  {
      clientId: UUID with {
        briefly "Client"
        described as {
          |Client ID.
        }
      }
      totalProjects: Natural with {
        briefly "Projects"
        described as {
          |Total projects.
        }
      }
      activeProjects: Natural with {
        briefly "Active"
        described as {
          |Active projects.
        }
      }
      completionRate: Decimal(5,2) with {
        briefly "Completion"
        described as {
          |Completion rate.
        }
      }
      averageDuration: Duration with {
        briefly "Duration"
        described as {
          |Average project duration.
        }
      }
      totalBudget: Decimal(15,2) with {
        briefly "Budget"
        described as {
          |Total budget allocated.
        }
      }
    } with {
      briefly "Project statistics"
      described as {
        |Client project metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Project.ProjectCreated is {
        tell event Project.ProjectCreated to repository ProjectContext.ProjectRepository
        do "Update project counts"
      }
      on event Project.TaskStatusUpdated is {
        tell event Project.TaskStatusUpdated to repository ProjectContext.ProjectRepository
        do "Update task metrics"
      }
      on event Project.MilestoneCompleted is {
        tell event Project.MilestoneCompleted to repository ProjectContext.ProjectRepository
        do "Update milestone metrics"
      }
      on event Project.ProjectCompleted is {
        tell event Project.ProjectCompleted to repository ProjectContext.ProjectRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains project analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Project analytics projections"
    described as {
      |Maintains engineering project analytics data.
    }
  }
  // ---- Event publication for Project ----
  type ProjectEvent is one of {
    ProjectContext.Project.ProjectCreated,
    ProjectContext.Project.ProjectUpdated,
    ProjectContext.Project.PhaseAdded,
    ProjectContext.Project.PhaseUpdated,
    ProjectContext.Project.TaskAdded,
    ProjectContext.Project.TaskStatusUpdated,
    ProjectContext.Project.ResourceAssigned,
    ProjectContext.Project.TimeRecorded,
    ProjectContext.Project.MilestoneAdded,
    ProjectContext.Project.MilestoneCompleted,
    ProjectContext.Project.RiskAdded,
    ProjectContext.Project.RiskUpdated,
    ProjectContext.Project.ProjectPlacedOnHold,
    ProjectContext.Project.ProjectResumed,
    ProjectContext.Project.ProjectCompleted,
    ProjectContext.Project.ProjectCancelled
  } with {
    briefly "Project event alternation"
    described as {
      |Union of all Project events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ProjectEventSource as source is {
    outlet ProjectEvents is type ProjectEvent
    handler ProjectSourceHandler is {
      on event Project.ProjectCreated is {
        send event Project.ProjectCreated to outlet ProjectEvents
      }
      on event Project.ProjectUpdated is {
        send event Project.ProjectUpdated to outlet ProjectEvents
      }
      on event Project.PhaseAdded is {
        send event Project.PhaseAdded to outlet ProjectEvents
      }
      on event Project.PhaseUpdated is {
        send event Project.PhaseUpdated to outlet ProjectEvents
      }
      on event Project.TaskAdded is {
        send event Project.TaskAdded to outlet ProjectEvents
      }
      on event Project.TaskStatusUpdated is {
        send event Project.TaskStatusUpdated to outlet ProjectEvents
      }
      on event Project.ResourceAssigned is {
        send event Project.ResourceAssigned to outlet ProjectEvents
      }
      on event Project.TimeRecorded is {
        send event Project.TimeRecorded to outlet ProjectEvents
      }
      on event Project.MilestoneAdded is {
        send event Project.MilestoneAdded to outlet ProjectEvents
      }
      on event Project.MilestoneCompleted is {
        send event Project.MilestoneCompleted to outlet ProjectEvents
      }
      on event Project.RiskAdded is {
        send event Project.RiskAdded to outlet ProjectEvents
      }
      on event Project.RiskUpdated is {
        send event Project.RiskUpdated to outlet ProjectEvents
      }
      on event Project.ProjectPlacedOnHold is {
        send event Project.ProjectPlacedOnHold to outlet ProjectEvents
      }
      on event Project.ProjectResumed is {
        send event Project.ProjectResumed to outlet ProjectEvents
      }
      on event Project.ProjectCompleted is {
        send event Project.ProjectCompleted to outlet ProjectEvents
      }
      on event Project.ProjectCancelled is {
        send event Project.ProjectCancelled to outlet ProjectEvents
      }
      on other is {
        error "Unexpected message for source ProjectEventSource"
      }
    } with {
      briefly "Project source handler"
      described as {
        |Publishes Project events onto the outlet.
      }
    }
  } with {
    briefly "Project event source"
    described as {
      |Publishes Project entity events into the streaming topology.
    }
  }
  processor ProjectEventSink as sink is {
    inlet ProjectInlet is type ProjectEvent
    handler ProjectSinkHandler is {
      on event Project.ProjectCreated is {
        tell event Project.ProjectCreated to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectUpdated is {
        tell event Project.ProjectUpdated to repository ProjectContext.ProjectRepository
      }
      on event Project.PhaseAdded is {
        tell event Project.PhaseAdded to repository ProjectContext.ProjectRepository
      }
      on event Project.PhaseUpdated is {
        tell event Project.PhaseUpdated to repository ProjectContext.ProjectRepository
      }
      on event Project.TaskAdded is {
        tell event Project.TaskAdded to repository ProjectContext.ProjectRepository
      }
      on event Project.TaskStatusUpdated is {
        tell event Project.TaskStatusUpdated to repository ProjectContext.ProjectRepository
      }
      on event Project.ResourceAssigned is {
        tell event Project.ResourceAssigned to repository ProjectContext.ProjectRepository
      }
      on event Project.TimeRecorded is {
        tell event Project.TimeRecorded to repository ProjectContext.ProjectRepository
      }
      on event Project.MilestoneAdded is {
        tell event Project.MilestoneAdded to repository ProjectContext.ProjectRepository
      }
      on event Project.MilestoneCompleted is {
        tell event Project.MilestoneCompleted to repository ProjectContext.ProjectRepository
      }
      on event Project.RiskAdded is {
        tell event Project.RiskAdded to repository ProjectContext.ProjectRepository
      }
      on event Project.RiskUpdated is {
        tell event Project.RiskUpdated to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectPlacedOnHold is {
        tell event Project.ProjectPlacedOnHold to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectResumed is {
        tell event Project.ProjectResumed to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectCompleted is {
        tell event Project.ProjectCompleted to repository ProjectContext.ProjectRepository
      }
      on event Project.ProjectCancelled is {
        tell event Project.ProjectCancelled to repository ProjectContext.ProjectRepository
      }
      on other is {
        error "Unexpected message for sink ProjectEventSink"
      }
    } with {
      briefly "Project sink handler"
      described as {
        |Persists Project events via the repository.
      }
    }
  } with {
    briefly "Project event sink"
    described as {
      |Receives Project events for persistence.
    }
  }
  connector ProjectEventFlow is {
    from outlet ProjectContext.ProjectEventSource.ProjectEvents to
      inlet ProjectContext.ProjectEventSink.ProjectInlet
  } with {
    briefly "Project event flow"
    described as {
      |Connects the Project source to its sink.
    }
  }
  processor ProjectEventSplit is {
    inlet ProjectEventSplitIn is type ProjectEvent
    outlet ProjectEventSplitToProjectRepository is type ProjectEvent
    outlet ProjectEventSplitToProjectAnalytics is type ProjectEvent
    handler ProjectEventSplitHandler is {
      on event Project.ProjectCreated is {
        send event Project.ProjectCreated to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectCreated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectCreated to entity ProjectContext.Project
      }
      on event Project.ProjectUpdated is {
        send event Project.ProjectUpdated to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectUpdated to entity ProjectContext.Project
      }
      on event Project.PhaseAdded is {
        send event Project.PhaseAdded to outlet ProjectEventSplitToProjectRepository
        send event Project.PhaseAdded to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.PhaseAdded to entity ProjectContext.Project
      }
      on event Project.PhaseUpdated is {
        send event Project.PhaseUpdated to outlet ProjectEventSplitToProjectRepository
        send event Project.PhaseUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.PhaseUpdated to entity ProjectContext.Project
      }
      on event Project.TaskAdded is {
        send event Project.TaskAdded to outlet ProjectEventSplitToProjectRepository
        send event Project.TaskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.TaskAdded to entity ProjectContext.Project
      }
      on event Project.TaskStatusUpdated is {
        send event Project.TaskStatusUpdated to outlet ProjectEventSplitToProjectRepository
        send event Project.TaskStatusUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.TaskStatusUpdated to entity ProjectContext.Project
      }
      on event Project.ResourceAssigned is {
        send event Project.ResourceAssigned to outlet ProjectEventSplitToProjectRepository
        send event Project.ResourceAssigned to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ResourceAssigned to entity ProjectContext.Project
      }
      on event Project.TimeRecorded is {
        send event Project.TimeRecorded to outlet ProjectEventSplitToProjectRepository
        send event Project.TimeRecorded to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.TimeRecorded to entity ProjectContext.Project
      }
      on event Project.MilestoneAdded is {
        send event Project.MilestoneAdded to outlet ProjectEventSplitToProjectRepository
        send event Project.MilestoneAdded to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.MilestoneAdded to entity ProjectContext.Project
      }
      on event Project.MilestoneCompleted is {
        send event Project.MilestoneCompleted to outlet ProjectEventSplitToProjectRepository
        send event Project.MilestoneCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.MilestoneCompleted to entity ProjectContext.Project
      }
      on event Project.RiskAdded is {
        send event Project.RiskAdded to outlet ProjectEventSplitToProjectRepository
        send event Project.RiskAdded to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.RiskAdded to entity ProjectContext.Project
      }
      on event Project.RiskUpdated is {
        send event Project.RiskUpdated to outlet ProjectEventSplitToProjectRepository
        send event Project.RiskUpdated to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.RiskUpdated to entity ProjectContext.Project
      }
      on event Project.ProjectPlacedOnHold is {
        send event Project.ProjectPlacedOnHold to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectPlacedOnHold to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectPlacedOnHold to entity ProjectContext.Project
      }
      on event Project.ProjectResumed is {
        send event Project.ProjectResumed to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectResumed to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectResumed to entity ProjectContext.Project
      }
      on event Project.ProjectCompleted is {
        send event Project.ProjectCompleted to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectCompleted to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectCompleted to entity ProjectContext.Project
      }
      on event Project.ProjectCancelled is {
        send event Project.ProjectCancelled to outlet ProjectEventSplitToProjectRepository
        send event Project.ProjectCancelled to outlet ProjectEventSplitToProjectAnalytics
        tell event Project.ProjectCancelled to entity ProjectContext.Project
      }
      on other is {
        error "Unexpected message for processor ProjectEventSplit"
      }
    } with {
      briefly "Project event fan-out handler"
      described as {
        |Delivers each Project event to all of its consumers.
      }
    }
  } with {
    briefly "Project event fan-out"
    described as {
      |Fans Project events out to the repository and projectors.
    }
  }
  connector LinkProjectToProjectEventSplit is {
    from outlet ProjectContext.Project.ProjectEvents2 to
      inlet ProjectContext.ProjectEventSplit.ProjectEventSplitIn
  } with {
    briefly "LinkProjectToProjectEventSplit"
  }
  connector LinkProjectEventSplitToProjectRepository is {
    from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectRepository to
      inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProject
  } with {
    briefly "LinkProjectEventSplitToProjectRepository"
  }
  connector LinkProjectEventSplitToProjectAnalytics is {
    from outlet ProjectContext.ProjectEventSplit.ProjectEventSplitToProjectAnalytics to
      inlet ProjectContext.ProjectAnalytics.ProjectAnalyticsFromProject
  } with {
    briefly "LinkProjectEventSplitToProjectAnalytics"
  }
  connector LinkProjectAnalyticsToProjectRepository is {
    from outlet ProjectContext.ProjectAnalytics.ProjectAnalyticsOut to
      inlet ProjectContext.ProjectRepository.ProjectRepositoryFromProjectAnalytics
  } with {
    briefly "LinkProjectAnalyticsToProjectRepository"
  }
} with {
  briefly "Bounded context for engineering projects"
  described as {
    | The ProjectContext is the bounded context for engineering
    | project management, execution, and resource tracking.
  }
}
