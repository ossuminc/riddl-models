// Engineering Project Domain Model
// Engineering project planning, execution, and resource management
domain EngineeringProject is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ProjectManager is "person managing engineering projects" with {
    briefly "Project Manager"
    described as {
      |Person overseeing project execution.
    }
  }
  user LeadEngineer is "senior engineer leading technical work" with {
    briefly "Lead Engineer"
    described as {
      |Person directing technical efforts.
    }
  }
  user TeamMember is "engineer working on project tasks" with {
    briefly "Team Member"
    described as {
      |Person executing project tasks.
    }
  }
  epic ProjectExecutionEpic is {
    user ProjectManager wants to "to track project progress" so that "deliverables are completed on schedule"
    case TrackProjectProgress is {
      user ProjectManager wants to "to monitor project milestones and tasks" so that "risks can be identified early"
      step is "Manager reviews" "project dashboard" "for status updates" with {
        briefly "Review status"
        described as {
          |Check current state.
        }
      }
      step is "Manager identifies" "delayed tasks" "and blockers" with {
        briefly "Identify delays"
        described as {
          |Find problem areas.
        }
      }
      step take input EngineeringProjectApp.EngineeringProjectScreen.UpdatePhaseInput from user ProjectManager with {
        briefly "Update phase"
        described as {
          |Advance project phase.
        }
      }
      step is "System notifies" "stakeholders" "of progress" with {
        briefly "Notify stakeholders"
        described as {
          |Send updates.
        }
      }
    } with {
      briefly "Project tracking workflow"
      described as {
        |Standard flow for monitoring projects.
      }
    }
  } with {
    briefly "Project execution processing"
    described as {
      | Epic covering project execution from planning
      | through completion and closeout.
    }
  }
  include "ProjectContext.riddl"
  include "external-contexts.riddl"
  application context EngineeringProjectApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in EngineeringProject are delivered.
      }
    }
    group EngineeringProjectScreen is {
      input UpdatePhaseInput acquires command ProjectContext.Project.UpdatePhase with {
        briefly "Update phase control"
        described as {
          |The control through which a user submits the update phase request.
        }
      }
    } with {
      briefly "Engineering project screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppProjectCommands is type ProjectContext.Project.ProjectCommand
    inlet AppProjectRepositoryResponses is type ProjectContext.Project.ProjectResult    handler EngineeringProjectAppHandler is {
      on other is {
        error "Unexpected message for application context EngineeringProjectApp"
      }
    } with {
      briefly "EngineeringProjectApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "EngineeringProjectApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'ProjectCommand Stream' is from outlet EngineeringProjectApp.AppProjectCommands to inlet ProjectContext.Project.ProjectCommands with {
    option persistent()
    briefly "Project commands from the application"
  }
  connector 'ProjectResult Stream' is from outlet ProjectContext.ProjectRepository.ProjectRepositoryResponses to inlet EngineeringProjectApp.AppProjectRepositoryResponses with {
    option persistent()
    briefly "Project query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet EngineeringProjectApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Engineering project domain"
  described as {
    | The EngineeringProject domain handles project planning,
    | resource allocation, task management, and delivery tracking.
  }
}
