// Design Review Domain Model
// Submittal management, approvals, and revision tracking
domain DesignReview is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user DesignEngineer is "engineer submitting designs for review" with {
    briefly "Design Engineer"
    described as {
      |Person who creates and submits designs.
    }
  }
  user ReviewCoordinator is "person managing the review process" with {
    briefly "Review Coordinator"
    described as {
      |Person who assigns reviewers and tracks progress.
    }
  }
  user DesignReviewer is "engineer evaluating submitted designs" with {
    briefly "Design Reviewer"
    described as {
      |Person who reviews and comments on designs.
    }
  }
  user ProjectApprover is "senior engineer with approval authority" with {
    briefly "Project Approver"
    described as {
      |Person who grants or denies design approval.
    }
  }
  epic DesignReviewEpic is {
    user DesignEngineer wants to "to submit designs for review" so that "designs are validated before implementation"
    case SubmitAndReviewDesign is {
      user DesignEngineer wants to "to submit a design and get feedback" so that "the design meets quality standards"
      step is "Engineer creates" "a submittal" "with design documents" with {
        briefly "Create submittal"
        described as {
          |Prepare design for review.
        }
      }
      step take input DesignReviewApp.DesignReviewScreen.SubmitForReviewInput from user DesignEngineer with {
        briefly "Submit design"
        described as {
          |Submit design for review.
        }
      }
      step is "Coordinator assigns" "reviewers" "to the submittal" with {
        briefly "Assign reviewers"
        described as {
          |Route to appropriate reviewers.
        }
      }
      step is "Reviewers add" "comments" "on the design" with {
        briefly "Review design"
        described as {
          |Evaluate and comment.
        }
      }
      step is "Engineer resolves" "comments" "with revisions" with {
        briefly "Address feedback"
        described as {
          |Resolve review comments.
        }
      }
      step is "Approver records" "approval decision" "for the submittal" with {
        briefly "Record approval"
        described as {
          |Grant or deny approval.
        }
      }
    } with {
      briefly "Design review workflow"
      described as {
        |Standard flow for submitting and reviewing designs.
      }
    }
  } with {
    briefly "Design review processing"
    described as {
      | Epic covering the design review lifecycle from
      | submittal through approval or rejection.
    }
  }
  include "DesignReviewContext.riddl"
  include "external-contexts.riddl"
  application context DesignReviewApp as merge is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DesignReview are delivered.
      }
    }
    group DesignReviewScreen is {
      input SubmitForReviewInput acquires command DesignReviewContext.Submittal.SubmitForReview with {
        briefly "Submit for review control"
        described as {
          |The control through which a user submits the submit for review request.
        }
      }
    } with {
      briefly "Design review screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppSubmittalCommands is type DesignReviewContext.Submittal.SubmittalCommand
    inlet AppSubmittalRepositoryResponses is type DesignReviewContext.Submittal.SubmittalResult    handler DesignReviewAppHandler is {
      on other is {
        error "Unexpected message for application context DesignReviewApp"
      }
    } with {
      briefly "DesignReviewApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DesignReviewApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector 'SubmittalCommand Stream' is from outlet DesignReviewApp.AppSubmittalCommands to inlet DesignReviewContext.Submittal.SubmittalCommands with {
    option persistent()
    briefly "Submittal commands from the application"
  }
  connector 'SubmittalResult Stream' is from outlet DesignReviewContext.SubmittalRepository.SubmittalRepositoryResponses to inlet DesignReviewApp.AppSubmittalRepositoryResponses with {
    option persistent()
    briefly "Submittal query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DesignReviewApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Design review domain"
  described as {
    | The DesignReview domain handles submittal management,
    | review assignment, comment resolution, revision tracking,
    | and design milestone sign-off.
  }
}
