// Design Review - Design Review Context
context DesignReviewContext is {
  include "types.riddl"
  include "Submittal.riddl"
  // Repository for submittal persistence
  repository SubmittalRepository is {
    schema SubmittalData is relational
      of submittals as type Submittal
        index on field Submittal.submittalId
        index on field Submittal.info.projectId

    handler SubmittalPersistence is {
      on command Submittal.CreateSubmittal is {
        tell event Submittal.SubmittalCreated to entity DesignReviewContext.Submittal
        prompt "Store submittal record"
      }
      on command Submittal.UpdateSubmittal is {
        tell event Submittal.SubmittalUpdated to entity DesignReviewContext.Submittal
        prompt "Update submittal info"
      }
      on command Submittal.SubmitForReview is {
        prompt "Update submittal status to submitted"
      }
      on command Submittal.AssignReviewer is {
        tell event Submittal.ReviewerAssigned to entity DesignReviewContext.Submittal
        prompt "Store reviewer assignment"
      }
      on command Submittal.RemoveReviewer is {
        tell event Submittal.ReviewerRemoved to entity DesignReviewContext.Submittal
        prompt "Remove reviewer assignment"
      }
      on command Submittal.AddComment is {
        tell event Submittal.CommentAdded to entity DesignReviewContext.Submittal
        prompt "Store review comment"
      }
      on command Submittal.ResolveComment is {
        prompt "Update comment resolution"
      }
      on command Submittal.SubmitRevision is {
        tell event Submittal.RevisionSubmitted to entity DesignReviewContext.Submittal
        prompt "Store revision record"
      }
      on command Submittal.RecordApproval is {
        tell event Submittal.ApprovalRecorded to entity DesignReviewContext.Submittal
        prompt "Store approval record"
      }
      on command Submittal.RejectSubmittal is {
        tell event Submittal.SubmittalRejected to entity DesignReviewContext.Submittal
        prompt "Update submittal to rejected"
      }
      on command Submittal.WithdrawSubmittal is {
        prompt "Update submittal to withdrawn"
      }
      on command Submittal.AddMilestone is {
        tell event Submittal.MilestoneAdded to entity DesignReviewContext.Submittal
        prompt "Store milestone record"
      }
      on command Submittal.SignOffMilestone is {
        prompt "Update milestone sign-off"
      }
    } with {
      briefly "Persists submittal commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Submittal data persistence"
    described as {
      | The SubmittalRepository provides persistent storage for
      | design submittals, reviews, comments, and approvals.
    }
  }
  // Projector for review analytics
  projector ReviewAnalytics is {
    updates repository DesignReviewContext.SubmittalRepository
    record ReviewStats is  {
      projectId: UUID with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      totalSubmittals: Natural with {
        briefly "Submittals"
        described as {
          |Total submittals.
        }
      }
      pendingReviews: Natural with {
        briefly "Pending"
        described as {
          |Pending reviews.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval rate"
        described as {
          |Approval percentage.
        }
      }
      averageReviewDuration: Duration with {
        briefly "Duration"
        described as {
          |Average review time.
        }
      }
      openComments: Natural with {
        briefly "Open comments"
        described as {
          |Unresolved comments.
        }
      }
    } with {
      briefly "Review statistics"
      described as {
        |Project review metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Submittal.SubmittalCreated is {
        tell event Submittal.SubmittalCreated to repository DesignReviewContext.SubmittalRepository
        prompt "Update submittal counts"
      }
      on event Submittal.SubmittalSubmitted is {
        tell event Submittal.SubmittalSubmitted to repository DesignReviewContext.SubmittalRepository
        prompt "Update pending review counts"
      }
      on event Submittal.CommentAdded is {
        tell event Submittal.CommentAdded to repository DesignReviewContext.SubmittalRepository
        prompt "Update comment metrics"
      }
      on event Submittal.CommentResolved is {
        tell event Submittal.CommentResolved to repository DesignReviewContext.SubmittalRepository
        prompt "Update resolved comment metrics"
      }
      on event Submittal.ApprovalRecorded is {
        tell event Submittal.ApprovalRecorded to repository DesignReviewContext.SubmittalRepository
        prompt "Update approval metrics"
      }
      on event Submittal.SubmittalRejected is {
        tell event Submittal.SubmittalRejected to repository DesignReviewContext.SubmittalRepository
        prompt "Update rejection metrics"
      }
    } with {
      briefly "Maintains review analytics"
      described as {
        |Projects events into review analytics views.
      }
    }
  } with {
    briefly "Review analytics projections"
    described as {
      |Maintains design review analytics data.
    }
  }
  // ---- Event publication for Submittal ----
  type SubmittalEvent is one of {
    DesignReviewContext.Submittal.SubmittalCreated,
    DesignReviewContext.Submittal.SubmittalUpdated,
    DesignReviewContext.Submittal.SubmittalSubmitted,
    DesignReviewContext.Submittal.ReviewerAssigned,
    DesignReviewContext.Submittal.ReviewerRemoved,
    DesignReviewContext.Submittal.CommentAdded,
    DesignReviewContext.Submittal.CommentResolved,
    DesignReviewContext.Submittal.RevisionSubmitted,
    DesignReviewContext.Submittal.ApprovalRecorded,
    DesignReviewContext.Submittal.SubmittalRejected,
    DesignReviewContext.Submittal.SubmittalWithdrawn,
    DesignReviewContext.Submittal.MilestoneAdded,
    DesignReviewContext.Submittal.MilestoneSignedOff
  } with {
    briefly "Submittal event alternation"
    described as {
      |Union of all Submittal events, for streaming and event-sourced
      |persistence.
    }
  }
  source SubmittalEventSource is {
    outlet SubmittalEvents is type SubmittalEvent
    handler SubmittalSourceHandler is {
      on event Submittal.SubmittalCreated is {
        send event Submittal.SubmittalCreated to outlet SubmittalEvents
      }
      on event Submittal.SubmittalUpdated is {
        send event Submittal.SubmittalUpdated to outlet SubmittalEvents
      }
      on event Submittal.SubmittalSubmitted is {
        send event Submittal.SubmittalSubmitted to outlet SubmittalEvents
      }
      on event Submittal.ReviewerAssigned is {
        send event Submittal.ReviewerAssigned to outlet SubmittalEvents
      }
      on event Submittal.ReviewerRemoved is {
        send event Submittal.ReviewerRemoved to outlet SubmittalEvents
      }
      on event Submittal.CommentAdded is {
        send event Submittal.CommentAdded to outlet SubmittalEvents
      }
      on event Submittal.CommentResolved is {
        send event Submittal.CommentResolved to outlet SubmittalEvents
      }
      on event Submittal.RevisionSubmitted is {
        send event Submittal.RevisionSubmitted to outlet SubmittalEvents
      }
      on event Submittal.ApprovalRecorded is {
        send event Submittal.ApprovalRecorded to outlet SubmittalEvents
      }
      on event Submittal.SubmittalRejected is {
        send event Submittal.SubmittalRejected to outlet SubmittalEvents
      }
      on event Submittal.SubmittalWithdrawn is {
        send event Submittal.SubmittalWithdrawn to outlet SubmittalEvents
      }
      on event Submittal.MilestoneAdded is {
        send event Submittal.MilestoneAdded to outlet SubmittalEvents
      }
      on event Submittal.MilestoneSignedOff is {
        send event Submittal.MilestoneSignedOff to outlet SubmittalEvents
      }
      on other is {
        error "Unexpected message for source SubmittalEventSource"
      }
    } with {
      briefly "Submittal source handler"
      described as {
        |Publishes Submittal events onto the outlet.
      }
    }
  } with {
    briefly "Submittal event source"
    described as {
      |Publishes Submittal entity events into the streaming topology.
    }
  }
  sink SubmittalEventSink is {
    inlet SubmittalInlet is type SubmittalEvent
    handler SubmittalSinkHandler is {
      on event Submittal.SubmittalCreated is {
        tell event Submittal.SubmittalCreated to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.SubmittalUpdated is {
        tell event Submittal.SubmittalUpdated to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.SubmittalSubmitted is {
        tell event Submittal.SubmittalSubmitted to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.ReviewerAssigned is {
        tell event Submittal.ReviewerAssigned to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.ReviewerRemoved is {
        tell event Submittal.ReviewerRemoved to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.CommentAdded is {
        tell event Submittal.CommentAdded to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.CommentResolved is {
        tell event Submittal.CommentResolved to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.RevisionSubmitted is {
        tell event Submittal.RevisionSubmitted to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.ApprovalRecorded is {
        tell event Submittal.ApprovalRecorded to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.SubmittalRejected is {
        tell event Submittal.SubmittalRejected to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.SubmittalWithdrawn is {
        tell event Submittal.SubmittalWithdrawn to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.MilestoneAdded is {
        tell event Submittal.MilestoneAdded to repository DesignReviewContext.SubmittalRepository
      }
      on event Submittal.MilestoneSignedOff is {
        tell event Submittal.MilestoneSignedOff to repository DesignReviewContext.SubmittalRepository
      }
      on other is {
        error "Unexpected message for sink SubmittalEventSink"
      }
    } with {
      briefly "Submittal sink handler"
      described as {
        |Persists Submittal events via the repository.
      }
    }
  } with {
    briefly "Submittal event sink"
    described as {
      |Receives Submittal events for persistence.
    }
  }
  connector SubmittalEventFlow is {
    from outlet DesignReviewContext.SubmittalEventSource.SubmittalEvents to
      inlet DesignReviewContext.SubmittalEventSink.SubmittalInlet
  } with {
    briefly "Submittal event flow"
    described as {
      |Connects the Submittal source to its sink.
    }
  }
} with {
  briefly "Bounded context for design reviews"
  described as {
    | The DesignReviewContext is the bounded context for design
    | submittal management, review routing, and approval tracking.
  }
}
