// Design Review - Design Review Context
context DesignReviewContext as router is {
  inlet SubmittalCommandStreamIn is type SubmittalCommand  outlet SubmittalCommandStreamOut is type SubmittalCommand
  inlet SubmittalResultStreamIn is result Submittal.SubmittalResult  outlet SubmittalResultStreamOut is result Submittal.SubmittalResult
  handler DesignReviewContextBoundary is {
    on createSubmittal: command Submittal.CreateSubmittal is {
      send createSubmittal to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on updateSubmittal: command Submittal.UpdateSubmittal is {
      send updateSubmittal to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on submitForReview: command Submittal.SubmitForReview is {
      send submitForReview to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on assignReviewer: command Submittal.AssignReviewer is {
      send assignReviewer to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on removeReviewer: command Submittal.RemoveReviewer is {
      send removeReviewer to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on addComment: command Submittal.AddComment is {
      send addComment to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on resolveComment: command Submittal.ResolveComment is {
      send resolveComment to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on submitRevision: command Submittal.SubmitRevision is {
      send submitRevision to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on recordApproval: command Submittal.RecordApproval is {
      send recordApproval to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on rejectSubmittal: command Submittal.RejectSubmittal is {
      send rejectSubmittal to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on withdrawSubmittal: command Submittal.WithdrawSubmittal is {
      send withdrawSubmittal to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on addMilestone: command Submittal.AddMilestone is {
      send addMilestone to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on signOffMilestone: command Submittal.SignOffMilestone is {
      send signOffMilestone to outlet DesignReviewContext.SubmittalCommandStreamOut
    }
    on submittalResult: result Submittal.SubmittalResult is {
      send submittalResult to outlet DesignReviewContext.SubmittalResultStreamOut
    }
    on other is {
      error "Unexpected message at the DesignReviewContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'SubmittalCommand Stream Intake' is from outlet DesignReviewContext.SubmittalCommandStreamOut to inlet DesignReviewContext.Submittal.SubmittalCommands  connector 'SubmittalResult Stream Egress' is from outlet DesignReviewContext.SubmittalRepository.SubmittalRepositoryResponses to inlet DesignReviewContext.SubmittalResultStreamIn  adaptor FromDocumentStorage from context DocumentStorage is { 
    handler FromDocumentStorageHandler is {
      on event DocumentStorage.DocumentStored is {
        do "the model receives document stored"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentStorage"
      }
    } with {
      briefly "from document storage"
      described as {
        |Carries messages from the external DocumentStorage.
      }
    }
  } with {
    briefly "DocumentStorage integration"
    described as {
      |The model's side of the DocumentStorage conversation.
    }
  }
  adaptor ToDocumentStorage to context DocumentStorage is { 
    handler ToDocumentStorageHandler is {
      on command DocumentStorage.StoreDocument is {
        do "the model sends store document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentStorage"
      }
    } with {
      briefly "to document storage"
      described as {
        |Carries messages to the external DocumentStorage.
      }
    }
  } with {
    briefly "DocumentStorage integration"
    described as {
      |The model's side of the DocumentStorage conversation.
    }
  }
  adaptor FromIdentityService from context IdentityService is { 
    handler FromIdentityServiceHandler is {
      on result IdentityService.ReviewerDetails is {
        do "the model receives reviewer details"
      }
      on other is {
        error "Unexpected message for adaptor FromIdentityService"
      }
    } with {
      briefly "from identity service"
      described as {
        |Carries messages from the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor ToIdentityService to context IdentityService is { 
    handler ToIdentityServiceHandler is {
      on query IdentityService.GetReviewerInfo is {
        do "the model sends get reviewer info"
      }
      on other is {
        error "Unexpected message for adaptor ToIdentityService"
      }
    } with {
      briefly "to identity service"
      described as {
        |Carries messages to the external IdentityService.
      }
    }
  } with {
    briefly "IdentityService integration"
    described as {
      |The model's side of the IdentityService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendReviewNotification is {
        do "the model sends send review notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromProjectService from context ProjectService is { 
    handler FromProjectServiceHandler is {
      on result ProjectService.ProjectDetails is {
        do "the model receives project details"
      }
      on other is {
        error "Unexpected message for adaptor FromProjectService"
      }
    } with {
      briefly "from project service"
      described as {
        |Carries messages from the external ProjectService.
      }
    }
  } with {
    briefly "ProjectService integration"
    described as {
      |The model's side of the ProjectService conversation.
    }
  }
  adaptor ToProjectService to context ProjectService is { 
    handler ToProjectServiceHandler is {
      on query ProjectService.GetProjectInfo is {
        do "the model sends get project info"
      }
      on other is {
        error "Unexpected message for adaptor ToProjectService"
      }
    } with {
      briefly "to project service"
      described as {
        |Carries messages to the external ProjectService.
      }
    }
  } with {
    briefly "ProjectService integration"
    described as {
      |The model's side of the ProjectService conversation.
    }
  }
  include "types.riddl"
  include "Submittal.riddl"
  // Repository for submittal persistence
  type SubmittalRepositoryCommand is one of {
    DesignReviewContext.SubmittalRepository.PersistApprovalRecorded or DesignReviewContext.SubmittalRepository.PersistCommentAdded or DesignReviewContext.SubmittalRepository.PersistCommentResolved or DesignReviewContext.SubmittalRepository.PersistMilestoneAdded or DesignReviewContext.SubmittalRepository.PersistMilestoneSignedOff or DesignReviewContext.SubmittalRepository.PersistReviewerAssigned or DesignReviewContext.SubmittalRepository.PersistReviewerRemoved or DesignReviewContext.SubmittalRepository.PersistRevisionSubmitted or DesignReviewContext.SubmittalRepository.PersistSubmittalCreated or DesignReviewContext.SubmittalRepository.PersistSubmittalRejected or DesignReviewContext.SubmittalRepository.PersistSubmittalSubmitted or DesignReviewContext.SubmittalRepository.PersistSubmittalUpdated or DesignReviewContext.SubmittalRepository.PersistSubmittalWithdrawn
  } with {
    briefly "Anything that writes SubmittalRepository"
    described as {
      |The persistence commands SubmittalRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository SubmittalRepository as flow is {
    inlet SubmittalRepositoryFromReviewAnalytics is type SubmittalRepositoryCommand    command PersistMilestoneAdded is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneAdded applies to.
        }
      }
    } with {
      briefly "Persist MilestoneAdded"
      described as {
        |Instructs this repository to apply MilestoneAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistMilestoneSignedOff is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row MilestoneSignedOff applies to.
        }
      }
    } with {
      briefly "Persist MilestoneSignedOff"
      described as {
        |Instructs this repository to apply MilestoneSignedOff to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewerAssigned is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewerAssigned applies to.
        }
      }
    } with {
      briefly "Persist ReviewerAssigned"
      described as {
        |Instructs this repository to apply ReviewerAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewerRemoved is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewerRemoved applies to.
        }
      }
    } with {
      briefly "Persist ReviewerRemoved"
      described as {
        |Instructs this repository to apply ReviewerRemoved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRevisionSubmitted is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row RevisionSubmitted applies to.
        }
      }
    } with {
      briefly "Persist RevisionSubmitted"
      described as {
        |Instructs this repository to apply RevisionSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubmittalUpdated is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubmittalUpdated applies to.
        }
      }
    } with {
      briefly "Persist SubmittalUpdated"
      described as {
        |Instructs this repository to apply SubmittalUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubmittalWithdrawn is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubmittalWithdrawn applies to.
        }
      }
    } with {
      briefly "Persist SubmittalWithdrawn"
      described as {
        |Instructs this repository to apply SubmittalWithdrawn to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistApprovalRecorded is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row ApprovalRecorded applies to.
        }
      }
    } with {
      briefly "Persist ApprovalRecorded"
      described as {
        |Instructs this repository to apply ApprovalRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommentAdded is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentAdded applies to.
        }
      }
    } with {
      briefly "Persist CommentAdded"
      described as {
        |Instructs this repository to apply CommentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommentResolved is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentResolved applies to.
        }
      }
    } with {
      briefly "Persist CommentResolved"
      described as {
        |Instructs this repository to apply CommentResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubmittalCreated is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubmittalCreated applies to.
        }
      }
    } with {
      briefly "Persist SubmittalCreated"
      described as {
        |Instructs this repository to apply SubmittalCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubmittalRejected is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubmittalRejected applies to.
        }
      }
    } with {
      briefly "Persist SubmittalRejected"
      described as {
        |Instructs this repository to apply SubmittalRejected to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSubmittalSubmitted is {
      submittalId: SubmittalId with {
        briefly "Row addressed"
        described as {
          |Which stored row SubmittalSubmitted applies to.
        }
      }
    } with {
      briefly "Persist SubmittalSubmitted"
      described as {
        |Instructs this repository to apply SubmittalSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet SubmittalRepositoryResponses is result Submittal.SubmittalResult
    record StoredSubmittal is {
      submittalId: SubmittalId with {
        briefly "submittalId"
        described as {
          |The submittalId column of the stored submittal row.
        }
      }
      info: SubmittalInfo with {
        briefly "info"
        described as {
          |The info column of the stored submittal row.
        }
      }
    } with {
      briefly "Stored submittal row"
      described as {
        |The persistence shape of submittal data as this repository stores it.
      }
    }
    schema SubmittalData is relational
      of submittals as record StoredSubmittal
        index on field StoredSubmittal.submittalId
        index on field StoredSubmittal.info.projectId
 with {
      briefly "Submittal data schema"
      described as {
        |The relational schema holding submittal data for the SubmittalRepository.
      }
    }
    handler SubmittalPersistence is {
      on persistMilestoneAdded: command PersistMilestoneAdded is {
        do "apply MilestoneAdded to the stored row"
      }
      on persistMilestoneSignedOff: command PersistMilestoneSignedOff is {
        do "apply MilestoneSignedOff to the stored row"
      }
      on persistReviewerAssigned: command PersistReviewerAssigned is {
        do "apply ReviewerAssigned to the stored row"
      }
      on persistReviewerRemoved: command PersistReviewerRemoved is {
        do "apply ReviewerRemoved to the stored row"
      }
      on persistRevisionSubmitted: command PersistRevisionSubmitted is {
        do "apply RevisionSubmitted to the stored row"
      }
      on persistSubmittalUpdated: command PersistSubmittalUpdated is {
        do "apply SubmittalUpdated to the stored row"
      }
      on persistSubmittalWithdrawn: command PersistSubmittalWithdrawn is {
        do "apply SubmittalWithdrawn to the stored row"
      }
      on persistApprovalRecorded: command PersistApprovalRecorded is {
        do "apply ApprovalRecorded to the stored row"
      }
      on persistCommentAdded: command PersistCommentAdded is {
        do "apply CommentAdded to the stored row"
      }
      on persistCommentResolved: command PersistCommentResolved is {
        do "apply CommentResolved to the stored row"
      }
      on persistSubmittalCreated: command PersistSubmittalCreated is {
        do "apply SubmittalCreated to the stored row"
      }
      on persistSubmittalRejected: command PersistSubmittalRejected is {
        do "apply SubmittalRejected to the stored row"
      }
      on persistSubmittalSubmitted: command PersistSubmittalSubmitted is {
        do "apply SubmittalSubmitted to the stored row"
      }
      on query GetReviewStats is {
        let reviewStatsView: type ReviewStatsView = prompt("read the review stats projection")
        reply reviewStatsView
      }
    } with {
      briefly "Persists submittal commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Submittal data persistence"
    described as {
      | The SubmittalRepository provides persistent storage for
      | design submittals, reviews, comments, and approvals.
    }
  }
  // Projector for review analytics
  query GetReviewStats replies result ReviewStatsView is {
    reviewStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which review stats to retrieve.
      }
    }
  } with {
    briefly "Get review stats"
    described as {
      |Retrieves the review stats projection.
    }
  }
  result ReviewStatsView is {
    reviewStats: ReviewAnalytics.ReviewStats with {
      briefly "Review stats"
      described as {
        |The review stats being returned.
      }
    }
  } with {
    briefly "Review stats view"
    described as {
      |Read model view carrying the review stats projection.
    }
  }
  projector ReviewAnalytics as flow is {
    updates repository DesignReviewContext.SubmittalRepository
    outlet ReviewAnalyticsToRepository is type SubmittalRepositoryCommand
    inlet ReviewAnalyticsFromSubmittal is type SubmittalEvent    record ReviewStats is {
      projectId: UUID with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      totalSubmittals: Natural with {
        briefly "Submittals"
        described as {
          |Total submittals.
        }
      }
      pendingReviews: Natural with {
        briefly "Pending"
        described as {
          |Pending reviews.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval rate"
        described as {
          |Approval percentage.
        }
      }
      averageReviewDuration: Duration with {
        briefly "Duration"
        described as {
          |Average review time.
        }
      }
      openComments: Natural with {
        briefly "Open comments"
        described as {
          |Unresolved comments.
        }
      }
    } with {
      briefly "Review statistics"
      described as {
        |Project review metrics.
      }
    }
    handler AnalyticsHandler is {
      on milestoneAdded: event Submittal.MilestoneAdded is {
        tell command DesignReviewContext.SubmittalRepository.PersistMilestoneAdded(submittalId = milestoneAdded.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "apply MilestoneAdded to the ReviewAnalytics projection"
      }
      on milestoneSignedOff: event Submittal.MilestoneSignedOff is {
        tell command DesignReviewContext.SubmittalRepository.PersistMilestoneSignedOff(submittalId = milestoneSignedOff.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "apply MilestoneSignedOff to the ReviewAnalytics projection"
      }
      on reviewerAssigned: event Submittal.ReviewerAssigned is {
        tell command DesignReviewContext.SubmittalRepository.PersistReviewerAssigned(submittalId = reviewerAssigned.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "apply ReviewerAssigned to the ReviewAnalytics projection"
      }
      on reviewerRemoved: event Submittal.ReviewerRemoved is {
        tell command DesignReviewContext.SubmittalRepository.PersistReviewerRemoved(submittalId = reviewerRemoved.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "apply ReviewerRemoved to the ReviewAnalytics projection"
      }
      on revisionSubmitted: event Submittal.RevisionSubmitted is {
        tell command DesignReviewContext.SubmittalRepository.PersistRevisionSubmitted(submittalId = revisionSubmitted.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "apply RevisionSubmitted to the ReviewAnalytics projection"
      }
      on submittalUpdated: event Submittal.SubmittalUpdated is {
        tell command DesignReviewContext.SubmittalRepository.PersistSubmittalUpdated(submittalId = submittalUpdated.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "apply SubmittalUpdated to the ReviewAnalytics projection"
      }
      on submittalWithdrawn: event Submittal.SubmittalWithdrawn is {
        tell command DesignReviewContext.SubmittalRepository.PersistSubmittalWithdrawn(submittalId = submittalWithdrawn.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "apply SubmittalWithdrawn to the ReviewAnalytics projection"
      }
      on submittalCreated: event Submittal.SubmittalCreated is {
        tell command DesignReviewContext.SubmittalRepository.PersistSubmittalCreated(submittalId = submittalCreated.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "Update submittal counts"
      }
      on submittalSubmitted: event Submittal.SubmittalSubmitted is {
        tell command DesignReviewContext.SubmittalRepository.PersistSubmittalSubmitted(submittalId = submittalSubmitted.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "Update pending review counts"
      }
      on commentAdded: event Submittal.CommentAdded is {
        tell command DesignReviewContext.SubmittalRepository.PersistCommentAdded(submittalId = commentAdded.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "Update comment metrics"
      }
      on commentResolved: event Submittal.CommentResolved is {
        tell command DesignReviewContext.SubmittalRepository.PersistCommentResolved(submittalId = commentResolved.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "Update resolved comment metrics"
      }
      on approvalRecorded: event Submittal.ApprovalRecorded is {
        tell command DesignReviewContext.SubmittalRepository.PersistApprovalRecorded(submittalId = approvalRecorded.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "Update approval metrics"
      }
      on submittalRejected: event Submittal.SubmittalRejected is {
        tell command DesignReviewContext.SubmittalRepository.PersistSubmittalRejected(submittalId = submittalRejected.submittalId) to repository DesignReviewContext.SubmittalRepository
        do "Update rejection metrics"
      }
    } with {
      briefly "Maintains review analytics"
      described as {
        |Projects events into review analytics views.
      }
    }
  } with {
    briefly "Review analytics projections"
    described as {
      |Maintains design review analytics data.
    }
  }
  // ---- Event publication for Submittal ----
  type SubmittalEvent is one of {
    DesignReviewContext.Submittal.SubmittalCreated or DesignReviewContext.Submittal.SubmittalUpdated or DesignReviewContext.Submittal.SubmittalSubmitted or DesignReviewContext.Submittal.ReviewerAssigned or DesignReviewContext.Submittal.ReviewerRemoved or DesignReviewContext.Submittal.CommentAdded or DesignReviewContext.Submittal.CommentResolved or DesignReviewContext.Submittal.RevisionSubmitted or DesignReviewContext.Submittal.ApprovalRecorded or DesignReviewContext.Submittal.SubmittalRejected or DesignReviewContext.Submittal.SubmittalWithdrawn or DesignReviewContext.Submittal.MilestoneAdded or DesignReviewContext.Submittal.MilestoneSignedOff
  } with {
    briefly "Submittal event alternation"
    described as {
      |Union of all Submittal events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet SubmittalEventSplit as flow is {
    inlet SubmittalEventSplitIn is type SubmittalEvent    outlet SubmittalEventSplitToReviewAnalytics is type SubmittalEvent
    handler SubmittalEventSplitHandler is {
      on submittalCreated: event Submittal.SubmittalCreated is {
        send submittalCreated to outlet SubmittalEventSplitToReviewAnalytics
        tell submittalCreated to entity DesignReviewContext.Submittal
      }
      on submittalUpdated: event Submittal.SubmittalUpdated is {
        send submittalUpdated to outlet SubmittalEventSplitToReviewAnalytics
        tell submittalUpdated to entity DesignReviewContext.Submittal
      }
      on submittalSubmitted: event Submittal.SubmittalSubmitted is {
        send submittalSubmitted to outlet SubmittalEventSplitToReviewAnalytics
        tell submittalSubmitted to entity DesignReviewContext.Submittal
      }
      on reviewerAssigned: event Submittal.ReviewerAssigned is {
        send reviewerAssigned to outlet SubmittalEventSplitToReviewAnalytics
        tell reviewerAssigned to entity DesignReviewContext.Submittal
      }
      on reviewerRemoved: event Submittal.ReviewerRemoved is {
        send reviewerRemoved to outlet SubmittalEventSplitToReviewAnalytics
        tell reviewerRemoved to entity DesignReviewContext.Submittal
      }
      on commentAdded: event Submittal.CommentAdded is {
        send commentAdded to outlet SubmittalEventSplitToReviewAnalytics
        tell commentAdded to entity DesignReviewContext.Submittal
      }
      on commentResolved: event Submittal.CommentResolved is {
        send commentResolved to outlet SubmittalEventSplitToReviewAnalytics
        tell commentResolved to entity DesignReviewContext.Submittal
      }
      on revisionSubmitted: event Submittal.RevisionSubmitted is {
        send revisionSubmitted to outlet SubmittalEventSplitToReviewAnalytics
        tell revisionSubmitted to entity DesignReviewContext.Submittal
      }
      on approvalRecorded: event Submittal.ApprovalRecorded is {
        send approvalRecorded to outlet SubmittalEventSplitToReviewAnalytics
        tell approvalRecorded to entity DesignReviewContext.Submittal
      }
      on submittalRejected: event Submittal.SubmittalRejected is {
        send submittalRejected to outlet SubmittalEventSplitToReviewAnalytics
        tell submittalRejected to entity DesignReviewContext.Submittal
      }
      on submittalWithdrawn: event Submittal.SubmittalWithdrawn is {
        send submittalWithdrawn to outlet SubmittalEventSplitToReviewAnalytics
        tell submittalWithdrawn to entity DesignReviewContext.Submittal
      }
      on milestoneAdded: event Submittal.MilestoneAdded is {
        send milestoneAdded to outlet SubmittalEventSplitToReviewAnalytics
        tell milestoneAdded to entity DesignReviewContext.Submittal
      }
      on milestoneSignedOff: event Submittal.MilestoneSignedOff is {
        send milestoneSignedOff to outlet SubmittalEventSplitToReviewAnalytics
        tell milestoneSignedOff to entity DesignReviewContext.Submittal
      }
      on other is {
        error "Unexpected message for processor SubmittalEventSplit"
      }
    } with {
      briefly "Submittal event fan-out handler"
      described as {
        |Delivers each Submittal event to all of its consumers.
      }
    }
  } with {
    briefly "Submittal event fan-out"
    described as {
      |Fans Submittal events out to the repository and projectors.
    }
  }
  connector 'SubmittalEvent Stream' is from outlet DesignReviewContext.Submittal.SubmittalEvents2 to inlet DesignReviewContext.SubmittalEventSplit.SubmittalEventSplitIn with {
    briefly "Submittal events, fanned out to storage and read models"
  }
  connector 'ReviewAnalytics Feed' is from outlet DesignReviewContext.SubmittalEventSplit.SubmittalEventSplitToReviewAnalytics to inlet DesignReviewContext.ReviewAnalytics.ReviewAnalyticsFromSubmittal with {
    briefly "Submittal events feeding the ReviewAnalytics projection"
  }
  connector 'ReviewAnalytics Storage' is from outlet DesignReviewContext.ReviewAnalytics.ReviewAnalyticsToRepository to inlet DesignReviewContext.SubmittalRepository.SubmittalRepositoryFromReviewAnalytics with {
    briefly "ReviewAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for design reviews"
  described as {
    | The DesignReviewContext is the bounded context for design
    | submittal management, review routing, and approval tracking.
  }
}
