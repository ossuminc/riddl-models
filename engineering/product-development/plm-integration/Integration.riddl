// PLM Integration - Integration Entity
entity Integration as flow is {
  type IntegrationCommand is one of {
    Integration.CreateIntegration or Integration.UpdateIntegration or Integration.EnableIntegration or Integration.DisableIntegration or Integration.RegisterSystem or Integration.TestConnection or Integration.SyncProduct or Integration.StartSyncJob or Integration.CancelSyncJob or Integration.ProcessChangeEvent or Integration.UpdateFieldMapping
  } with {
    briefly "Integration command alternation"
    described as {
      |Commands accepted by the Integration entity.
    }
  }
  inlet IntegrationCommands is type IntegrationCommand  outlet IntegrationEvents2 is type IntegrationEvent
  query GetIntegration replies result IntegrationResult is {
    integrationId: IntegrationId with {
      briefly "ID"
      described as {
        |Identifier of the Integration to retrieve.
      }
    }
  } with {
    briefly "Get Integration"
    described as {
      |Retrieve Integration data by identifier.
    }
  }
  result IntegrationResult is  {
    integrationId: IntegrationId with {
      briefly "Integration addressed"
      described as {
        |Which integration this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    integrationData: Integration.ConfiguredStateData with {
      briefly "Integration data"
      described as {
        |The requested Integration data.
      }
    }
  } with {
    briefly "Integration result"
    described as {
      |Result carrying the requested Integration data.
    }
  }
  // Commands
  command CreateIntegration is  {
    integrationId: IntegrationId with {
      briefly "Integration ID"
      described as {
        |New integration identifier.
      }
    }
    config: IntegrationConfig with {
      briefly "Config"
      described as {
        |Integration configuration.
      }
    }
  } with {
    briefly "Create integration"
    described as {
      |Creates a new PLM integration.
    }
  }
  command UpdateIntegration is  {
    integrationId: IntegrationId with {
      briefly "Integration ID"
      described as {
        |Integration to update.
      }
    }
    config: IntegrationConfig with {
      briefly "Config"
      described as {
        |Updated configuration.
      }
    }
  } with {
    briefly "Update integration"
    described as {
      |Updates integration configuration.
    }
  }
  command EnableIntegration is  {
    integrationId: IntegrationId with {
      briefly "Integration ID"
      described as {
        |Integration to enable.
      }
    }
  } with {
    briefly "Enable integration"
    described as {
      |Enables integration for syncing.
    }
  }
  command DisableIntegration is  {
    integrationId: IntegrationId with {
      briefly "Integration ID"
      described as {
        |Integration to disable.
      }
    }
    reason: String(1,500)? with {
      briefly "Reason"
      described as {
        |Disable reason.
      }
    }
  } with {
    briefly "Disable integration"
    described as {
      |Disables integration temporarily.
    }
  }
  command RegisterSystem is  {
    system: ConnectedSystem with {
      briefly "System"
      described as {
        |System to register.
      }
    }
  } with {
    briefly "Register system"
    described as {
      |Registers connected system.
    }
  }
  command TestConnection is  {
    systemId: SystemId with {
      briefly "System ID"
      described as {
        |System to test.
      }
    }
  } with {
    briefly "Test connection"
    described as {
      |Tests system connectivity.
    }
  }
  command SyncProduct is  {
    integrationId: IntegrationId with {
      briefly "Integration ID"
      described as {
        |Integration ID.
      }
    }
    productId: ProductId with {
      briefly "Product"
      described as {
        |Product to sync.
      }
    }
  } with {
    briefly "Sync product"
    described as {
      |Synchronizes specific product.
    }
  }
  command StartSyncJob is  {
    integrationId: IntegrationId with {
      briefly "Integration ID"
      described as {
        |Integration ID.
      }
    }
    syncEntityTypes: DataEntityType* with {
      briefly "Entities"
      described as {
        |Entity types to sync.
      }
    }
  } with {
    briefly "Start sync job"
    described as {
      |Starts synchronization job.
    }
  }
  command CancelSyncJob is  {
    jobId: SyncJobId with {
      briefly "Job ID"
      described as {
        |Job to cancel.
      }
    }
  } with {
    briefly "Cancel sync job"
    described as {
      |Cancels running sync job.
    }
  }
  command ProcessChangeEvent is  {
    event: DataChangeEvent with {
      briefly "Event"
      described as {
        |Change event to process.
      }
    }
  } with {
    briefly "Process change"
    described as {
      |Processes data change event.
    }
  }
  command UpdateFieldMapping is  {
    integrationId: IntegrationId with {
      briefly "Integration ID"
      described as {
        |Integration ID.
      }
    }
    mapping: FieldMapping with {
      briefly "Mapping"
      described as {
        |Updated field mapping.
      }
    }
    valueMap: mapping from String to String with {
      briefly "Value map"
      described as {
        |Source-value to target-value translations that accompany this
        |field mapping, for a ValueMapping or Lookup transform.
      }
    }
  } with {
    briefly "Update mapping"
    described as {
      |Updates field mapping.
    }
  }
  // Events
  event IntegrationCreated is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    config: IntegrationConfig with {
      briefly "Config"
      described as {
        |Configuration.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Integration was created"
    described as {
      |Emitted when integration is created.
    }
  }
  event IntegrationUpdated is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    config: IntegrationConfig with {
      briefly "Config"
      described as {
        |Updated config.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Integration was updated"
    described as {
      |Emitted when integration is updated.
    }
  }
  event IntegrationEnabled is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    enabledAt: TimeStamp with {
      briefly "Enabled"
      described as {
        |Enable time.
      }
    }
  } with {
    briefly "Integration was enabled"
    described as {
      |Emitted when integration is enabled.
    }
  }
  event IntegrationDisabled is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    reason: String(1,500)? with {
      briefly "Reason"
      described as {
        |Disable reason.
      }
    }
    disabledAt: TimeStamp with {
      briefly "Disabled"
      described as {
        |Disable time.
      }
    }
  } with {
    briefly "Integration was disabled"
    described as {
      |Emitted when integration is disabled.
    }
  }
  event SystemRegistered is  {
    integrationId: IntegrationId with {
      briefly "Integration addressed"
      described as {
        |Which integration this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    system: ConnectedSystem with {
      briefly "System"
      described as {
        |Registered system.
      }
    }
    registeredAt: TimeStamp with {
      briefly "Registered"
      described as {
        |Registration time.
      }
    }
  } with {
    briefly "System was registered"
    described as {
      |Emitted when system is registered.
    }
  }
  event ConnectionTested is  {
    integrationId: IntegrationId with {
      briefly "Integration addressed"
      described as {
        |Which integration this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    systemId: SystemId with {
      briefly "System"
      described as {
        |System ID.
      }
    }
    success: Boolean with {
      briefly "Success"
      described as {
        |Test result.
      }
    }
    latencyMs: Natural with {
      briefly "Latency"
      described as {
        |Response latency.
      }
    }
    testedAt: TimeStamp with {
      briefly "Tested"
      described as {
        |Test time.
      }
    }
  } with {
    briefly "Connection was tested"
    described as {
      |Emitted when connection is tested.
    }
  }
  event ProductSynced is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    productId: ProductId with {
      briefly "Product"
      described as {
        |Product ID.
      }
    }
    success: Boolean with {
      briefly "Success"
      described as {
        |Sync result.
      }
    }
    syncedAt: TimeStamp with {
      briefly "Synced"
      described as {
        |Sync time.
      }
    }
  } with {
    briefly "Product was synced"
    described as {
      |Emitted when product is synchronized.
    }
  }
  event SyncJobStarted is  {
    integrationId: IntegrationId with {
      briefly "Integration addressed"
      described as {
        |Which integration this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    job: SyncJob with {
      briefly "Job"
      described as {
        |Started job.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Sync job was started"
    described as {
      |Emitted when sync job begins.
    }
  }
  event SyncJobCompleted is  {
    integrationId: IntegrationId with {
      briefly "Integration addressed"
      described as {
        |Which integration this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    jobId: SyncJobId with {
      briefly "Job"
      described as {
        |Job ID.
      }
    }
    status: SyncStatus with {
      briefly "Status"
      described as {
        |Final status.
      }
    }
    recordsProcessed: Natural with {
      briefly "Processed"
      described as {
        |Records processed.
      }
    }
    recordsFailed: Natural with {
      briefly "Failed"
      described as {
        |Records failed.
      }
    }
    jobCompletedAt: TimeStamp with {
      briefly "Completed"
      described as {
        |Completion time.
      }
    }
  } with {
    briefly "Sync job was completed"
    described as {
      |Emitted when sync job finishes.
    }
  }
  event SyncJobCancelled is  {
    integrationId: IntegrationId with {
      briefly "Integration addressed"
      described as {
        |Which integration this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    jobId: SyncJobId with {
      briefly "Job"
      described as {
        |Job ID.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancel time.
      }
    }
  } with {
    briefly "Sync job was cancelled"
    described as {
      |Emitted when sync job is cancelled.
    }
  }
  event ChangeEventProcessed is  {
    integrationId: IntegrationId with {
      briefly "Integration addressed"
      described as {
        |Which integration this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    event: DataChangeEvent with {
      briefly "Event"
      described as {
        |Processed event.
      }
    }
    processedAt: TimeStamp with {
      briefly "Processed"
      described as {
        |Process time.
      }
    }
  } with {
    briefly "Change event was processed"
    described as {
      |Emitted when change is processed.
    }
  }
  event FieldMappingUpdated is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    mapping: FieldMapping with {
      briefly "Mapping"
      described as {
        |Updated mapping.
      }
    }
    updatedAt: TimeStamp with {
      briefly "Updated"
      described as {
        |Update time.
      }
    }
  } with {
    briefly "Field mapping was updated"
    described as {
      |Emitted when mapping is updated.
    }
  }
  // State Records
  record ConfiguredStateData is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    config: IntegrationConfig with {
      briefly "Config"
      described as {
        |Configuration.
      }
    }
    systems: ConnectedSystem+ with {
      briefly "Systems"
      described as {
        |Connected systems.
      }
    }
    syncJobs: SyncJob+ with {
      briefly "Jobs"
      described as {
        |Sync job history.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Configured state data"
    described as {
      |State data for configured integration.
    }
  }
  record ActiveStateData is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    config: IntegrationConfig with {
      briefly "Config"
      described as {
        |Configuration.
      }
    }
    systems: ConnectedSystem+ with {
      briefly "Systems"
      described as {
        |Connected systems.
      }
    }
    syncJobs: SyncJob+ with {
      briefly "Jobs"
      described as {
        |Sync job history.
      }
    }
    lastSyncAt: TimeStamp? with {
      briefly "Last sync"
      described as {
        |Last sync time.
      }
    }
    enabledAt: TimeStamp with {
      briefly "Enabled"
      described as {
        |Enable time.
      }
    }
  } with {
    briefly "Active state data"
    described as {
      |State data for active integration.
    }
  }
  record DisabledStateData is  {
    integrationId: IntegrationId with {
      briefly "Integration"
      described as {
        |Integration ID.
      }
    }
    config: IntegrationConfig with {
      briefly "Config"
      described as {
        |Configuration.
      }
    }
    reason: String(1,500)? with {
      briefly "Reason"
      described as {
        |Disable reason.
      }
    }
    disabledAt: TimeStamp with {
      briefly "Disabled"
      described as {
        |Disable time.
      }
    }
  } with {
    briefly "Disabled state data"
    described as {
      |State data for disabled integration.
    }
  }
  // States
  initial state ConfiguredState of record Integration.ConfiguredStateData is {
    initial handler ConfiguredStateInitHandler is {
      on query GetIntegration is {
        let integrationResult: type IntegrationResult = prompt("read the integration from the store")
        reply integrationResult
      }
      on init is {
        set state ConfiguredState to "initialize from prior event"
      }
    } with {
      briefly "ConfiguredState init handler"
      described as {
        |Initializes the ConfiguredState state.
      }
    }
  } with {
    briefly "ConfiguredState state"
    described as {
      |The ConfiguredState state of the Integration.
    }
  }
  state ActiveState of record Integration.ActiveStateData is {
    initial handler ActiveStateInitHandler is {
      on init is {
        set state ActiveState to "initialize from prior event"
      }
    } with {
      briefly "ActiveState init handler"
      described as {
        |Initializes the ActiveState state.
      }
    }
  } with {
    briefly "ActiveState state"
    described as {
      |The ActiveState state of the Integration.
    }
  }
  state DisabledState of record Integration.DisabledStateData is {
    initial handler DisabledStateInitHandler is {
      on init is {
        set state DisabledState to "initialize from prior event"
      }
    } with {
      briefly "DisabledState init handler"
      described as {
        |Initializes the DisabledState state.
      }
    }
  } with {
    briefly "DisabledState state"
    described as {
      |The DisabledState state of the Integration.
    }
  }
  // Handler
  handler IntegrationHandler is {
    on createIntegration: command CreateIntegration is {
      morph entity IntegrationContext.Integration to state IntegrationContext.Integration.ConfiguredState with record Integration.ConfiguredStateData(integrationId = createIntegration.integrationId, config = createIntegration.config, systems = prompt("the systems of this configured state data"), syncJobs = prompt("the sync jobs of this configured state data"), createdAt = prompt("the created at of this configured state data"))
      tell event IntegrationCreated(integrationId = createIntegration.integrationId, config = createIntegration.config, createdAt = prompt("the created at of this integration created")) to entity IntegrationContext.Integration
    }
    on updateIntegration: command UpdateIntegration is {
      tell event IntegrationUpdated(integrationId = updateIntegration.integrationId, config = updateIntegration.config, updatedAt = prompt("the updated at of this integration updated")) to entity IntegrationContext.Integration
    }
    on enableIntegration: command EnableIntegration is {
      morph entity IntegrationContext.Integration to state IntegrationContext.Integration.ActiveState with record Integration.ActiveStateData(integrationId = enableIntegration.integrationId, config = prompt("the config of this active state data"), systems = prompt("the systems of this active state data"), syncJobs = prompt("the sync jobs of this active state data"), lastSyncAt = empty, enabledAt = prompt("the enabled at of this active state data"))
      tell event IntegrationEnabled(integrationId = enableIntegration.integrationId, enabledAt = prompt("the enabled at of this integration enabled")) to entity IntegrationContext.Integration
    }
    on disableIntegration: command DisableIntegration is {
      morph entity IntegrationContext.Integration to state IntegrationContext.Integration.DisabledState with record Integration.DisabledStateData(integrationId = disableIntegration.integrationId, reason = disableIntegration.reason, config = prompt("the config of this disabled state data"), disabledAt = prompt("the disabled at of this disabled state data"))
      tell event IntegrationDisabled(integrationId = disableIntegration.integrationId, reason = disableIntegration.reason, disabledAt = prompt("the disabled at of this integration disabled")) to entity IntegrationContext.Integration
    }
    on registerSystem: command RegisterSystem is {
      tell event SystemRegistered(system = registerSystem.system, integrationId = prompt("the integration id of this system registered"), registeredAt = prompt("the registered at of this system registered")) to entity IntegrationContext.Integration
    }
    on testConnection: command TestConnection is {
      tell event ConnectionTested(systemId = testConnection.systemId, integrationId = prompt("the integration id of this connection tested"), success = prompt("the success of this connection tested"), latencyMs = prompt("the latency ms of this connection tested"), testedAt = prompt("the tested at of this connection tested")) to entity IntegrationContext.Integration
    }
    on syncProduct: command SyncProduct is {
      tell event ProductSynced(integrationId = syncProduct.integrationId, productId = syncProduct.productId, success = prompt("the success of this product synced"), syncedAt = prompt("the synced at of this product synced")) to entity IntegrationContext.Integration
    }
    on command StartSyncJob is {
      let syncJobStarted: type SyncJobStarted = prompt("the sync job started that results from start sync job")
      tell syncJobStarted to entity IntegrationContext.Integration
    }
    on cancelSyncJob: command CancelSyncJob is {
      tell event SyncJobCancelled(jobId = cancelSyncJob.jobId, integrationId = prompt("the integration id of this sync job cancelled"), cancelledAt = prompt("the cancelled at of this sync job cancelled")) to entity IntegrationContext.Integration
    }
    on processChangeEvent: command ProcessChangeEvent is {
      tell event ChangeEventProcessed(event = processChangeEvent.event, integrationId = prompt("the integration id of this change event processed"), processedAt = prompt("the processed at of this change event processed")) to entity IntegrationContext.Integration
    }
    on updateFieldMapping: command UpdateFieldMapping is {
      foreach sourceValue, targetValue in field UpdateFieldMapping.valueMap {
        do "record that sourceValue translates to targetValue for this field"
      }
      tell event FieldMappingUpdated(integrationId = updateFieldMapping.integrationId, mapping = updateFieldMapping.mapping, updatedAt = prompt("the updated at of this field mapping updated")) to entity IntegrationContext.Integration
    }
      on changeEventProcessed: event ChangeEventProcessed is {
      do "apply ChangeEventProcessed to the integration so it can be persisted and replayed"
    }
    on connectionTested: event ConnectionTested is {
      do "apply ConnectionTested to the integration so it can be persisted and replayed"
    }
    on fieldMappingUpdated: event FieldMappingUpdated is {
      do "apply FieldMappingUpdated to the integration so it can be persisted and replayed"
    }
    on integrationCreated: event IntegrationCreated is {
      do "apply IntegrationCreated to the integration so it can be persisted and replayed"
    }
    on integrationDisabled: event IntegrationDisabled is {
      do "apply IntegrationDisabled to the integration so it can be persisted and replayed"
    }
    on integrationEnabled: event IntegrationEnabled is {
      do "apply IntegrationEnabled to the integration so it can be persisted and replayed"
    }
    on integrationUpdated: event IntegrationUpdated is {
      do "apply IntegrationUpdated to the integration so it can be persisted and replayed"
    }
    on productSynced: event ProductSynced is {
      do "apply ProductSynced to the integration so it can be persisted and replayed"
    }
    on syncJobCancelled: event SyncJobCancelled is {
      do "apply SyncJobCancelled to the integration so it can be persisted and replayed"
    }
    on syncJobCompleted: event SyncJobCompleted is {
      do "apply SyncJobCompleted to the integration so it can be persisted and replayed"
    }
    on syncJobStarted: event SyncJobStarted is {
      do "apply SyncJobStarted to the integration so it can be persisted and replayed"
    }
    on systemRegistered: event SystemRegistered is {
      do "apply SystemRegistered to the integration so it can be persisted and replayed"
    }
} with {
    briefly "Processes integration commands"
    described as {
      | Handles integration lifecycle including configuration,
      | sync operations, and change event processing.
    }
  }
} with {
  briefly "Integration aggregate"
  described as {
    | The Integration entity manages PLM integrations
    | including data synchronization and transformations.
  }
}
