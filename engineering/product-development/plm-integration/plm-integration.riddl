// PLM Integration Domain Model
// Product lifecycle management data synchronization and orchestration
domain PLMIntegration is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user PLMAdmin is "administrator managing PLM integrations" with {
    briefly "PLM Admin"
    described as {
      |Person managing PLM system integrations.
    }
  }
  user Engineer is "engineer working with product data" with {
    briefly "Engineer"
    described as {
      |Person using integrated product data.
    }
  }
  epic ProductDataSyncEpic is {
    user PLMAdmin wants to "to synchronize product data across systems" so that "engineering teams have consistent information"
    case SyncProductData is {
      user PLMAdmin wants to "to synchronize product changes" so that "downstream systems stay current"
      step is "System detects" "product data change" "in source PLM system" with {
        briefly "Detect change"
        described as {
          |Monitor for changes.
        }
      }
      step is "System transforms" "data to target format" "per mapping rules" with {
        briefly "Transform data"
        described as {
          |Apply transformations.
        }
      }
      step take input PLMIntegrationApp.PLMIntegrationScreen.SyncProductInput from user PLMAdmin with {
        briefly "Sync"
        described as {
          |Execute synchronization.
        }
      }
      step is "System validates" "sync completion" "and logs results" with {
        briefly "Validate"
        described as {
          |Confirm sync success.
        }
      }
    } with {
      briefly "Product sync workflow"
      described as {
        |Standard flow for product data synchronization.
      }
    }
  } with {
    briefly "Product data sync processing"
    described as {
      | Epic covering product data synchronization
      | from change detection through validation.
    }
  }
  include "IntegrationContext.riddl"
  include "external-contexts.riddl"
  application context PLMIntegrationApp is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in PLMIntegration are delivered.
      }
    }
    group PLMIntegrationScreen is {
      input SyncProductInput acquires command IntegrationContext.Integration.SyncProduct with {
        briefly "Sync product control"
        described as {
          |The control through which a user submits the sync product request.
        }
      }
    } with {
      briefly "Plm integration screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppIntegrationCommands is type IntegrationContext.Integration.IntegrationCommand
    inlet AppIntegrationRepositoryResponses is type IntegrationContext.Integration.IntegrationResult    handler PLMIntegrationAppHandler is {
      on other is {
        error "Unexpected message for application context PLMIntegrationApp"
      }
    } with {
      briefly "PLMIntegrationApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "PLMIntegrationApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  connector LinkAppIntegrationCommands is from outlet PLMIntegrationApp.AppIntegrationCommands to inlet IntegrationContext.Integration.IntegrationCommands with {
    option persistent()
    briefly "LinkAppIntegrationCommands"
  }
  connector LinkAppIntegrationRepositoryResponses is from outlet IntegrationContext.IntegrationRepository.IntegrationRepositoryResponses to inlet PLMIntegrationApp.AppIntegrationRepositoryResponses with {
    option persistent()
    briefly "LinkAppIntegrationRepositoryResponses"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet PLMIntegrationApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "PLM integration domain"
  described as {
    | The PLMIntegration domain handles product lifecycle
    | management data synchronization and orchestration.
  }
}
