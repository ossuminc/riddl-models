// PLM Integration - Integration Context
context IntegrationContext as router is {
  inlet IntegrationCommandStreamIn is type IntegrationCommand  outlet IntegrationCommandStreamOut is type IntegrationCommand
  inlet IntegrationResultStreamIn is type Integration.IntegrationResult  outlet IntegrationResultStreamOut is type Integration.IntegrationResult
  handler IntegrationContextBoundary is {
    on createIntegration: command Integration.CreateIntegration is {
      send createIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on updateIntegration: command Integration.UpdateIntegration is {
      send updateIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on enableIntegration: command Integration.EnableIntegration is {
      send enableIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on disableIntegration: command Integration.DisableIntegration is {
      send disableIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on registerSystem: command Integration.RegisterSystem is {
      send registerSystem to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on testConnection: command Integration.TestConnection is {
      send testConnection to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on syncProduct: command Integration.SyncProduct is {
      send syncProduct to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on startSyncJob: command Integration.StartSyncJob is {
      send startSyncJob to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on cancelSyncJob: command Integration.CancelSyncJob is {
      send cancelSyncJob to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on processChangeEvent: command Integration.ProcessChangeEvent is {
      send processChangeEvent to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on updateFieldMapping: command Integration.UpdateFieldMapping is {
      send updateFieldMapping to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on integrationResult: result Integration.IntegrationResult is {
      send integrationResult to outlet IntegrationContext.IntegrationResultStreamOut
    }
    on other is {
      error "Unexpected message at the IntegrationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'IntegrationCommand Stream Intake' is from outlet IntegrationContext.IntegrationCommandStreamOut to inlet IntegrationContext.Integration.IntegrationCommands  connector 'IntegrationResult Stream Egress' is from outlet IntegrationContext.IntegrationRepository.IntegrationRepositoryResponses to inlet IntegrationContext.IntegrationResultStreamIn  adaptor FromCADSystemService from context CADSystemService is { 
    handler FromCADSystemServiceHandler is {
      on event CADSystemService.CADFileFetched is {
        do "the model receives cad file fetched"
      }
      on other is {
        error "Unexpected message for adaptor FromCADSystemService"
      }
    } with {
      briefly "from cad system service"
      described as {
        |Carries messages from the external CADSystemService.
      }
    }
  } with {
    briefly "CADSystemService integration"
    described as {
      |The model's side of the CADSystemService conversation.
    }
  }
  adaptor ToCADSystemService to context CADSystemService is { 
    handler ToCADSystemServiceHandler is {
      on command CADSystemService.FetchCADFile is {
        do "the model sends fetch cad file"
      }
      on other is {
        error "Unexpected message for adaptor ToCADSystemService"
      }
    } with {
      briefly "to cad system service"
      described as {
        |Carries messages to the external CADSystemService.
      }
    }
  } with {
    briefly "CADSystemService integration"
    described as {
      |The model's side of the CADSystemService conversation.
    }
  }
  adaptor FromERPSystemService from context ERPSystemService is { 
    handler FromERPSystemServiceHandler is {
      on event ERPSystemService.BOMSynced is {
        do "the model receives bom synced"
      }
      on other is {
        error "Unexpected message for adaptor FromERPSystemService"
      }
    } with {
      briefly "from erp system service"
      described as {
        |Carries messages from the external ERPSystemService.
      }
    }
  } with {
    briefly "ERPSystemService integration"
    described as {
      |The model's side of the ERPSystemService conversation.
    }
  }
  adaptor ToERPSystemService to context ERPSystemService is { 
    handler ToERPSystemServiceHandler is {
      on command ERPSystemService.SyncBOM is {
        do "the model sends sync bom"
      }
      on other is {
        error "Unexpected message for adaptor ToERPSystemService"
      }
    } with {
      briefly "to erp system service"
      described as {
        |Carries messages to the external ERPSystemService.
      }
    }
  } with {
    briefly "ERPSystemService integration"
    described as {
      |The model's side of the ERPSystemService conversation.
    }
  }
  adaptor FromMessageQueueService from context MessageQueueService is { 
    handler FromMessageQueueServiceHandler is {
      on event MessageQueueService.EventPublished is {
        do "the model receives event published"
      }
      on other is {
        error "Unexpected message for adaptor FromMessageQueueService"
      }
    } with {
      briefly "from message queue service"
      described as {
        |Carries messages from the external MessageQueueService.
      }
    }
  } with {
    briefly "MessageQueueService integration"
    described as {
      |The model's side of the MessageQueueService conversation.
    }
  }
  adaptor ToMessageQueueService to context MessageQueueService is { 
    handler ToMessageQueueServiceHandler is {
      on command MessageQueueService.PublishEvent is {
        do "the model sends publish event"
      }
      on command MessageQueueService.SubscribeToTopic is {
        do "the model sends subscribe to topic"
      }
      on other is {
        error "Unexpected message for adaptor ToMessageQueueService"
      }
    } with {
      briefly "to message queue service"
      described as {
        |Carries messages to the external MessageQueueService.
      }
    }
  } with {
    briefly "MessageQueueService integration"
    described as {
      |The model's side of the MessageQueueService conversation.
    }
  }
  adaptor FromMonitoringService from context MonitoringService is { 
    handler FromMonitoringServiceHandler is {
      on event MonitoringService.AlertCreated is {
        do "the model receives alert created"
      }
      on other is {
        error "Unexpected message for adaptor FromMonitoringService"
      }
    } with {
      briefly "from monitoring service"
      described as {
        |Carries messages from the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor ToMonitoringService to context MonitoringService is { 
    handler ToMonitoringServiceHandler is {
      on command MonitoringService.CreateAlert is {
        do "the model sends create alert"
      }
      on command MonitoringService.RecordMetric is {
        do "the model sends record metric"
      }
      on other is {
        error "Unexpected message for adaptor ToMonitoringService"
      }
    } with {
      briefly "to monitoring service"
      described as {
        |Carries messages to the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor FromPLMSystemService from context PLMSystemService is { 
    handler FromPLMSystemServiceHandler is {
      on event PLMSystemService.ProductFetched is {
        do "the model receives product fetched"
      }
      on other is {
        error "Unexpected message for adaptor FromPLMSystemService"
      }
    } with {
      briefly "from plm system service"
      described as {
        |Carries messages from the external PLMSystemService.
      }
    }
  } with {
    briefly "PLMSystemService integration"
    described as {
      |The model's side of the PLMSystemService conversation.
    }
  }
  adaptor ToPLMSystemService to context PLMSystemService is { 
    handler ToPLMSystemServiceHandler is {
      on command PLMSystemService.FetchProduct is {
        do "the model sends fetch product"
      }
      on command PLMSystemService.UpdateProduct is {
        do "the model sends update product"
      }
      on other is {
        error "Unexpected message for adaptor ToPLMSystemService"
      }
    } with {
      briefly "to plm system service"
      described as {
        |Carries messages to the external PLMSystemService.
      }
    }
  } with {
    briefly "PLMSystemService integration"
    described as {
      |The model's side of the PLMSystemService conversation.
    }
  }
  include "types.riddl"
  include "Integration.riddl"
  // Repository for integration persistence
  repository IntegrationRepository as merge is {
    command PersistConnectionTested is  {
      systemId: SystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ConnectionTested applies to.
        }
      }
    } with {
      briefly "Persist ConnectionTested"
      described as {
        |Instructs this repository to apply ConnectionTested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductSynced is  {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductSynced applies to.
        }
      }
    } with {
      briefly "Persist ProductSynced"
      described as {
        |Instructs this repository to apply ProductSynced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSyncJobCompleted is  {
      jobId: SyncJobId with {
        briefly "Row addressed"
        described as {
          |Which stored row SyncJobCompleted applies to.
        }
      }
    } with {
      briefly "Persist SyncJobCompleted"
      described as {
        |Instructs this repository to apply SyncJobCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSyncJobStarted is  {
      job: SyncJob with {
        briefly "Row addressed"
        described as {
          |Which stored row SyncJobStarted applies to.
        }
      }
    } with {
      briefly "Persist SyncJobStarted"
      described as {
        |Instructs this repository to apply SyncJobStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    inlet IntegrationRepositoryFromIntegration is type IntegrationEvent    inlet IntegrationRepositoryFromIntegrationAnalytics is type IntegrationEvent    outlet IntegrationRepositoryResponses is type Integration.IntegrationResult
    record StoredIntegration is  {
      integrationId: IntegrationId with {
        briefly "integrationId"
        described as {
          |The integrationId column of the stored integration row.
        }
      }
      config: IntegrationConfig with {
        briefly "config"
        described as {
          |The config column of the stored integration row.
        }
      }
    } with {
      briefly "Stored integration row"
      described as {
        |The persistence shape of integration data as this repository stores it.
      }
    }
    schema IntegrationData is relational
      of integrations as type StoredIntegration
        index on field StoredIntegration.integrationId
        index on field StoredIntegration.config.sourceSystemId
 with {
      briefly "Integration data schema"
      described as {
        |The relational schema holding integration data for the IntegrationRepository.
      }
    }
    handler IntegrationPersistence is {
      on persistConnectionTested: command PersistConnectionTested is {
        do "apply ConnectionTested to the stored row"
      }
      on persistProductSynced: command PersistProductSynced is {
        do "apply ProductSynced to the stored row"
      }
      on persistSyncJobCompleted: command PersistSyncJobCompleted is {
        do "apply SyncJobCompleted to the stored row"
      }
      on persistSyncJobStarted: command PersistSyncJobStarted is {
        do "apply SyncJobStarted to the stored row"
      }
      on query GetIntegrationStats is {
        let integrationStatsView: type IntegrationStatsView = prompt("read the integration stats projection")
        reply integrationStatsView
      }
      on createIntegration: command Integration.CreateIntegration is {
        tell event Integration.IntegrationCreated(integrationId = createIntegration.integrationId, config = createIntegration.config) to entity IntegrationContext.Integration
        do "Store integration config"
      }
      on updateIntegration: command Integration.UpdateIntegration is {
        tell event Integration.IntegrationUpdated(integrationId = updateIntegration.integrationId, config = updateIntegration.config) to entity IntegrationContext.Integration
        do "Update integration config"
      }
      on command Integration.RegisterSystem is {
        do "Store system record"
      }
      on command Integration.StartSyncJob is {
        let syncJobStarted: type Integration.SyncJobStarted = prompt("the sync job started that results from start sync job")
        tell syncJobStarted to entity IntegrationContext.Integration
        do "Store sync job"
      }
      on cancelSyncJob: command Integration.CancelSyncJob is {
        tell event Integration.SyncJobCancelled(jobId = cancelSyncJob.jobId) to entity IntegrationContext.Integration
        do "Update sync job status"
      }
      on processChangeEvent: command Integration.ProcessChangeEvent is {
        tell event Integration.ChangeEventProcessed(event = processChangeEvent.event) to entity IntegrationContext.Integration
        do "Log change event"
      }
    } with {
      briefly "Persists integration commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Integration data persistence"
    described as {
      | The IntegrationRepository provides persistent storage for
      | integrations, sync jobs, and change events.
    }
  }
  // Projector for integration analytics
  query GetIntegrationStats is  {
    integrationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which integration stats to retrieve.
      }
    }
  } with {
    briefly "Get integration stats"
    described as {
      |Retrieves the integration stats projection.
    }
  }
  result IntegrationStatsView is  {
    integrationStats: IntegrationAnalytics.IntegrationStats with {
      briefly "Integration stats"
      described as {
        |The integration stats being returned.
      }
    }
  } with {
    briefly "Integration stats view"
    described as {
      |Read model view carrying the integration stats projection.
    }
  }
  projector IntegrationAnalytics as flow is {
    updates repository IntegrationContext.IntegrationRepository
    inlet IntegrationAnalyticsFromIntegration is type IntegrationEvent    outlet IntegrationAnalyticsOut is type IntegrationEvent
    record IntegrationStats is  {
      integrationId: IntegrationId with {
        briefly "Integration"
        described as {
          |Integration ID.
        }
      }
      totalSyncs: Natural with {
        briefly "Syncs"
        described as {
          |Total sync jobs.
        }
      }
      successfulSyncs: Natural with {
        briefly "Successful"
        described as {
          |Successful syncs.
        }
      }
      totalRecords: Natural with {
        briefly "Records"
        described as {
          |Total records synced.
        }
      }
      averageLatency: Duration with {
        briefly "Latency"
        described as {
          |Average sync time.
        }
      }
    } with {
      briefly "Integration statistics"
      described as {
        |Integration performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on syncJobStarted: event Integration.SyncJobStarted is {
        tell command IntegrationContext.IntegrationRepository.PersistSyncJobStarted(job = syncJobStarted.job) to repository IntegrationContext.IntegrationRepository
        do "Track sync start"
      }
      on syncJobCompleted: event Integration.SyncJobCompleted is {
        tell command IntegrationContext.IntegrationRepository.PersistSyncJobCompleted(jobId = syncJobCompleted.jobId) to repository IntegrationContext.IntegrationRepository
        do "Update sync metrics"
      }
      on connectionTested: event Integration.ConnectionTested is {
        tell command IntegrationContext.IntegrationRepository.PersistConnectionTested(systemId = connectionTested.systemId) to repository IntegrationContext.IntegrationRepository
        do "Update connection metrics"
      }
      on productSynced: event Integration.ProductSynced is {
        tell command IntegrationContext.IntegrationRepository.PersistProductSynced(integrationId = productSynced.integrationId) to repository IntegrationContext.IntegrationRepository
        do "Update record counts"
      }
    } with {
      briefly "Maintains integration analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Integration analytics projections"
    described as {
      |Maintains integration analytics data.
    }
  }
  // ---- Event publication for Integration ----
  type IntegrationEvent is one of {
    IntegrationContext.Integration.IntegrationCreated or IntegrationContext.Integration.IntegrationUpdated or IntegrationContext.Integration.IntegrationEnabled or IntegrationContext.Integration.IntegrationDisabled or IntegrationContext.Integration.SystemRegistered or IntegrationContext.Integration.ConnectionTested or IntegrationContext.Integration.ProductSynced or IntegrationContext.Integration.SyncJobStarted or IntegrationContext.Integration.SyncJobCompleted or IntegrationContext.Integration.SyncJobCancelled or IntegrationContext.Integration.ChangeEventProcessed or IntegrationContext.Integration.FieldMappingUpdated
  } with {
    briefly "Integration event alternation"
    described as {
      |Union of all Integration events, for streaming and event-sourced
      |persistence.
    }
  }
  processor IntegrationEventSource as source is {
    outlet IntegrationEvents is type IntegrationEvent
    handler IntegrationSourceHandler is {
      on integrationCreated: event Integration.IntegrationCreated is {
        send integrationCreated to outlet IntegrationEvents
      }
      on integrationUpdated: event Integration.IntegrationUpdated is {
        send integrationUpdated to outlet IntegrationEvents
      }
      on integrationEnabled: event Integration.IntegrationEnabled is {
        send integrationEnabled to outlet IntegrationEvents
      }
      on integrationDisabled: event Integration.IntegrationDisabled is {
        send integrationDisabled to outlet IntegrationEvents
      }
      on systemRegistered: event Integration.SystemRegistered is {
        send systemRegistered to outlet IntegrationEvents
      }
      on connectionTested: event Integration.ConnectionTested is {
        send connectionTested to outlet IntegrationEvents
      }
      on productSynced: event Integration.ProductSynced is {
        send productSynced to outlet IntegrationEvents
      }
      on syncJobStarted: event Integration.SyncJobStarted is {
        send syncJobStarted to outlet IntegrationEvents
      }
      on syncJobCompleted: event Integration.SyncJobCompleted is {
        send syncJobCompleted to outlet IntegrationEvents
      }
      on syncJobCancelled: event Integration.SyncJobCancelled is {
        send syncJobCancelled to outlet IntegrationEvents
      }
      on changeEventProcessed: event Integration.ChangeEventProcessed is {
        send changeEventProcessed to outlet IntegrationEvents
      }
      on fieldMappingUpdated: event Integration.FieldMappingUpdated is {
        send fieldMappingUpdated to outlet IntegrationEvents
      }
      on other is {
        error "Unexpected message for source IntegrationEventSource"
      }
    } with {
      briefly "Integration source handler"
      described as {
        |Publishes Integration events onto the outlet.
      }
    }
  } with {
    briefly "Integration event source"
    described as {
      |Publishes Integration entity events into the streaming topology.
    }
  }
  processor IntegrationEventSink as sink is {
    inlet IntegrationInlet is type IntegrationEvent    handler IntegrationSinkHandler is {
      on integrationCreated: event Integration.IntegrationCreated is {
        tell integrationCreated to repository IntegrationContext.IntegrationRepository
      }
      on integrationUpdated: event Integration.IntegrationUpdated is {
        tell integrationUpdated to repository IntegrationContext.IntegrationRepository
      }
      on integrationEnabled: event Integration.IntegrationEnabled is {
        tell integrationEnabled to repository IntegrationContext.IntegrationRepository
      }
      on integrationDisabled: event Integration.IntegrationDisabled is {
        tell integrationDisabled to repository IntegrationContext.IntegrationRepository
      }
      on systemRegistered: event Integration.SystemRegistered is {
        tell systemRegistered to repository IntegrationContext.IntegrationRepository
      }
      on connectionTested: event Integration.ConnectionTested is {
        tell connectionTested to repository IntegrationContext.IntegrationRepository
      }
      on productSynced: event Integration.ProductSynced is {
        tell productSynced to repository IntegrationContext.IntegrationRepository
      }
      on syncJobStarted: event Integration.SyncJobStarted is {
        tell syncJobStarted to repository IntegrationContext.IntegrationRepository
      }
      on syncJobCompleted: event Integration.SyncJobCompleted is {
        tell syncJobCompleted to repository IntegrationContext.IntegrationRepository
      }
      on syncJobCancelled: event Integration.SyncJobCancelled is {
        tell syncJobCancelled to repository IntegrationContext.IntegrationRepository
      }
      on changeEventProcessed: event Integration.ChangeEventProcessed is {
        tell changeEventProcessed to repository IntegrationContext.IntegrationRepository
      }
      on fieldMappingUpdated: event Integration.FieldMappingUpdated is {
        tell fieldMappingUpdated to repository IntegrationContext.IntegrationRepository
      }
      on other is {
        error "Unexpected message for sink IntegrationEventSink"
      }
    } with {
      briefly "Integration sink handler"
      described as {
        |Persists Integration events via the repository.
      }
    }
  } with {
    briefly "Integration event sink"
    described as {
      |Receives Integration events for persistence.
    }
  }
  connector IntegrationEventFlow is from outlet IntegrationContext.IntegrationEventSource.IntegrationEvents to inlet IntegrationContext.IntegrationEventSink.IntegrationInlet with {
    briefly "Integration event flow"
    described as {
      |Connects the Integration source to its sink.
    }
  }
  processor IntegrationEventSplit as split is {
    inlet IntegrationEventSplitIn is type IntegrationEvent    outlet IntegrationEventSplitToIntegrationRepository is type IntegrationEvent
    outlet IntegrationEventSplitToIntegrationAnalytics is type IntegrationEvent
    handler IntegrationEventSplitHandler is {
      on integrationCreated: event Integration.IntegrationCreated is {
        send integrationCreated to outlet IntegrationEventSplitToIntegrationRepository
        send integrationCreated to outlet IntegrationEventSplitToIntegrationAnalytics
        tell integrationCreated to entity IntegrationContext.Integration
      }
      on integrationUpdated: event Integration.IntegrationUpdated is {
        send integrationUpdated to outlet IntegrationEventSplitToIntegrationRepository
        send integrationUpdated to outlet IntegrationEventSplitToIntegrationAnalytics
        tell integrationUpdated to entity IntegrationContext.Integration
      }
      on integrationEnabled: event Integration.IntegrationEnabled is {
        send integrationEnabled to outlet IntegrationEventSplitToIntegrationRepository
        send integrationEnabled to outlet IntegrationEventSplitToIntegrationAnalytics
        tell integrationEnabled to entity IntegrationContext.Integration
      }
      on integrationDisabled: event Integration.IntegrationDisabled is {
        send integrationDisabled to outlet IntegrationEventSplitToIntegrationRepository
        send integrationDisabled to outlet IntegrationEventSplitToIntegrationAnalytics
        tell integrationDisabled to entity IntegrationContext.Integration
      }
      on systemRegistered: event Integration.SystemRegistered is {
        send systemRegistered to outlet IntegrationEventSplitToIntegrationRepository
        send systemRegistered to outlet IntegrationEventSplitToIntegrationAnalytics
        tell systemRegistered to entity IntegrationContext.Integration
      }
      on connectionTested: event Integration.ConnectionTested is {
        send connectionTested to outlet IntegrationEventSplitToIntegrationRepository
        send connectionTested to outlet IntegrationEventSplitToIntegrationAnalytics
        tell connectionTested to entity IntegrationContext.Integration
      }
      on productSynced: event Integration.ProductSynced is {
        send productSynced to outlet IntegrationEventSplitToIntegrationRepository
        send productSynced to outlet IntegrationEventSplitToIntegrationAnalytics
        tell productSynced to entity IntegrationContext.Integration
      }
      on syncJobStarted: event Integration.SyncJobStarted is {
        send syncJobStarted to outlet IntegrationEventSplitToIntegrationRepository
        send syncJobStarted to outlet IntegrationEventSplitToIntegrationAnalytics
        tell syncJobStarted to entity IntegrationContext.Integration
      }
      on syncJobCompleted: event Integration.SyncJobCompleted is {
        send syncJobCompleted to outlet IntegrationEventSplitToIntegrationRepository
        send syncJobCompleted to outlet IntegrationEventSplitToIntegrationAnalytics
        tell syncJobCompleted to entity IntegrationContext.Integration
      }
      on syncJobCancelled: event Integration.SyncJobCancelled is {
        send syncJobCancelled to outlet IntegrationEventSplitToIntegrationRepository
        send syncJobCancelled to outlet IntegrationEventSplitToIntegrationAnalytics
        tell syncJobCancelled to entity IntegrationContext.Integration
      }
      on changeEventProcessed: event Integration.ChangeEventProcessed is {
        send changeEventProcessed to outlet IntegrationEventSplitToIntegrationRepository
        send changeEventProcessed to outlet IntegrationEventSplitToIntegrationAnalytics
        tell changeEventProcessed to entity IntegrationContext.Integration
      }
      on fieldMappingUpdated: event Integration.FieldMappingUpdated is {
        send fieldMappingUpdated to outlet IntegrationEventSplitToIntegrationRepository
        send fieldMappingUpdated to outlet IntegrationEventSplitToIntegrationAnalytics
        tell fieldMappingUpdated to entity IntegrationContext.Integration
      }
      on other is {
        error "Unexpected message for processor IntegrationEventSplit"
      }
    } with {
      briefly "Integration event fan-out handler"
      described as {
        |Delivers each Integration event to all of its consumers.
      }
    }
  } with {
    briefly "Integration event fan-out"
    described as {
      |Fans Integration events out to the repository and projectors.
    }
  }
  connector 'IntegrationEvent Stream' is from outlet IntegrationContext.Integration.IntegrationEvents2 to inlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitIn with {
    briefly "Integration events, fanned out to storage and read models"
  }
  connector 'IntegrationEvent Storage' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToIntegrationRepository to inlet IntegrationContext.IntegrationRepository.IntegrationRepositoryFromIntegration with {
    briefly "Integration events on their way to storage"
  }
  connector 'IntegrationAnalytics Feed' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToIntegrationAnalytics to inlet IntegrationContext.IntegrationAnalytics.IntegrationAnalyticsFromIntegration with {
    briefly "Integration events feeding the IntegrationAnalytics projection"
  }
  connector 'IntegrationAnalytics Storage' is from outlet IntegrationContext.IntegrationAnalytics.IntegrationAnalyticsOut to inlet IntegrationContext.IntegrationRepository.IntegrationRepositoryFromIntegrationAnalytics with {
    briefly "The IntegrationAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for PLM integration"
  described as {
    | The IntegrationContext is the bounded context for PLM
    | data synchronization and system orchestration.
  }
}
