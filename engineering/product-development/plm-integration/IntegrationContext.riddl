// PLM Integration - Integration Context
context IntegrationContext as router is {
  inlet IntegrationCommandStreamIn is type IntegrationCommand  outlet IntegrationCommandStreamOut is type IntegrationCommand
  inlet IntegrationResultStreamIn is result Integration.IntegrationResult  outlet IntegrationResultStreamOut is result Integration.IntegrationResult
  handler IntegrationContextBoundary is {
    on createIntegration: command Integration.CreateIntegration is {
      send createIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on updateIntegration: command Integration.UpdateIntegration is {
      send updateIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on enableIntegration: command Integration.EnableIntegration is {
      send enableIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on disableIntegration: command Integration.DisableIntegration is {
      send disableIntegration to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on registerSystem: command Integration.RegisterSystem is {
      send registerSystem to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on testConnection: command Integration.TestConnection is {
      send testConnection to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on syncProduct: command Integration.SyncProduct is {
      send syncProduct to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on startSyncJob: command Integration.StartSyncJob is {
      send startSyncJob to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on cancelSyncJob: command Integration.CancelSyncJob is {
      send cancelSyncJob to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on processChangeEvent: command Integration.ProcessChangeEvent is {
      send processChangeEvent to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on updateFieldMapping: command Integration.UpdateFieldMapping is {
      send updateFieldMapping to outlet IntegrationContext.IntegrationCommandStreamOut
    }
    on integrationResult: result Integration.IntegrationResult is {
      send integrationResult to outlet IntegrationContext.IntegrationResultStreamOut
    }
    on other is {
      error "Unexpected message at the IntegrationContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'IntegrationCommand Stream Intake' is from outlet IntegrationContext.IntegrationCommandStreamOut to inlet IntegrationContext.Integration.IntegrationCommands  connector 'IntegrationResult Stream Egress' is from outlet IntegrationContext.IntegrationRepository.IntegrationRepositoryResponses to inlet IntegrationContext.IntegrationResultStreamIn  adaptor FromCADSystemService from context CADSystemService as sink is { 
    inlet FromCADSystemServiceIn is event CADSystemService.CADFileFetched    handler FromCADSystemServiceHandler is {
      on cADFileFetched: event CADSystemService.CADFileFetched is {
        do "the file is here; the sync job that wanted it carries on"
      }
      on other is {
        error "Unexpected message for adaptor FromCADSystemService"
      }
    } with {
      briefly "from cad system service"
      described as {
        |Carries messages from the external CADSystemService.
      }
    }
  } with {
    briefly "CADSystemService integration"
    described as {
      |The model's side of the CADSystemService conversation.
    }
  }
  adaptor ToCADSystemService to context CADSystemService as flow is { 
    inlet ToCADSystemServiceIn is type IntegrationEvent    outlet ToCADSystemServiceOut is command CADSystemService.FetchCADFile
    handler ToCADSystemServiceHandler is {
      on syncJobStarted: event Integration.SyncJobStarted is {
        let item0: type CADSystemService.FetchCADFile = prompt("translate the syncJobStarted event into a FetchCADFile, the job being unable to proceed without the geometry")
        send item0 to outlet IntegrationContext.ToCADSystemService.ToCADSystemServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToCADSystemService"
      }
    } with {
      briefly "to cad system service"
      described as {
        |Carries messages to the external CADSystemService.
      }
    }
  } with {
    briefly "CADSystemService integration"
    described as {
      |The model's side of the CADSystemService conversation.
    }
  }
  adaptor FromERPSystemService from context ERPSystemService as sink is { 
    inlet FromERPSystemServiceIn is event ERPSystemService.BOMSynced    handler FromERPSystemServiceHandler is {
      on bOMSynced: event ERPSystemService.BOMSynced is {
        do "the BOM matches; the sync job already recorded that it ran"
      }
      on other is {
        error "Unexpected message for adaptor FromERPSystemService"
      }
    } with {
      briefly "from erp system service"
      described as {
        |Carries messages from the external ERPSystemService.
      }
    }
  } with {
    briefly "ERPSystemService integration"
    described as {
      |The model's side of the ERPSystemService conversation.
    }
  }
  adaptor ToERPSystemService to context ERPSystemService as flow is { 
    inlet ToERPSystemServiceIn is type IntegrationEvent    outlet ToERPSystemServiceOut is command ERPSystemService.SyncBOM
    handler ToERPSystemServiceHandler is {
      on productSynced: event Integration.ProductSynced is {
        let item0: type ERPSystemService.SyncBOM = prompt("translate the productSynced event into a SyncBOM, a synced product leaving its bill of materials stale")
        send item0 to outlet IntegrationContext.ToERPSystemService.ToERPSystemServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToERPSystemService"
      }
    } with {
      briefly "to erp system service"
      described as {
        |Carries messages to the external ERPSystemService.
      }
    }
  } with {
    briefly "ERPSystemService integration"
    described as {
      |The model's side of the ERPSystemService conversation.
    }
  }
  adaptor FromMessageQueueService from context MessageQueueService as sink is { 
    inlet FromMessageQueueServiceIn is event MessageQueueService.EventPublished    handler FromMessageQueueServiceHandler is {
      on eventPublished: event MessageQueueService.EventPublished is {
        do "the event is on the queue; publishing it was the whole of the obligation"
      }
      on other is {
        error "Unexpected message for adaptor FromMessageQueueService"
      }
    } with {
      briefly "from message queue service"
      described as {
        |Carries messages from the external MessageQueueService.
      }
    }
  } with {
    briefly "MessageQueueService integration"
    described as {
      |The model's side of the MessageQueueService conversation.
    }
  }
  adaptor ToMessageQueueService to context MessageQueueService as flow is { 
    inlet ToMessageQueueServiceIn is type IntegrationEvent    outlet ToMessageQueueServiceOut is type MessageQueueService.MessageQueueServiceCommand
    handler ToMessageQueueServiceHandler is {
      on changeEventProcessed: event Integration.ChangeEventProcessed is {
        let item0: type MessageQueueService.PublishEvent = prompt("translate the changeEventProcessed event into a PublishEvent, a processed change being what downstream subscribers wait for")
        send item0 to outlet IntegrationContext.ToMessageQueueService.ToMessageQueueServiceOut
      }
      on integrationEnabled: event Integration.IntegrationEnabled is {
        let item0: type MessageQueueService.SubscribeToTopic = prompt("translate the integrationEnabled event into a SubscribeToTopic, enabling an integration being when it starts listening")
        send item0 to outlet IntegrationContext.ToMessageQueueService.ToMessageQueueServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMessageQueueService"
      }
    } with {
      briefly "to message queue service"
      described as {
        |Carries messages to the external MessageQueueService.
      }
    }
  } with {
    briefly "MessageQueueService integration"
    described as {
      |The model's side of the MessageQueueService conversation.
    }
  }
  adaptor FromMonitoringService from context MonitoringService as sink is { 
    inlet FromMonitoringServiceIn is event MonitoringService.AlertCreated    handler FromMonitoringServiceHandler is {
      on alertCreated: event MonitoringService.AlertCreated is {
        do "monitoring holds the alert; the condition that raised it was detected here"
      }
      on other is {
        error "Unexpected message for adaptor FromMonitoringService"
      }
    } with {
      briefly "from monitoring service"
      described as {
        |Carries messages from the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor ToMonitoringService to context MonitoringService as flow is { 
    inlet ToMonitoringServiceIn is type IntegrationEvent    outlet ToMonitoringServiceOut is type MonitoringService.MonitoringServiceCommand
    handler ToMonitoringServiceHandler is {
      on syncJobCompleted: event Integration.SyncJobCompleted is {
        let item0: type MonitoringService.RecordMetric = prompt("translate the syncJobCompleted event into a RecordMetric, a finished job being what there is to measure")
        send item0 to outlet IntegrationContext.ToMonitoringService.ToMonitoringServiceOut
      }
      on syncJobCancelled: event Integration.SyncJobCancelled is {
        let item0: type MonitoringService.CreateAlert = prompt("translate the syncJobCancelled event into a CreateAlert, a cancelled job being what someone must look at")
        send item0 to outlet IntegrationContext.ToMonitoringService.ToMonitoringServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToMonitoringService"
      }
    } with {
      briefly "to monitoring service"
      described as {
        |Carries messages to the external MonitoringService.
      }
    }
  } with {
    briefly "MonitoringService integration"
    described as {
      |The model's side of the MonitoringService conversation.
    }
  }
  adaptor FromPLMSystemService from context PLMSystemService as sink is { 
    inlet FromPLMSystemServiceIn is event PLMSystemService.ProductFetched    handler FromPLMSystemServiceHandler is {
      on productFetched: event PLMSystemService.ProductFetched is {
        do "the product is here; what the sync does with it is the job's own business"
      }
      on other is {
        error "Unexpected message for adaptor FromPLMSystemService"
      }
    } with {
      briefly "from plm system service"
      described as {
        |Carries messages from the external PLMSystemService.
      }
    }
  } with {
    briefly "PLMSystemService integration"
    described as {
      |The model's side of the PLMSystemService conversation.
    }
  }
  adaptor ToPLMSystemService to context PLMSystemService as flow is { 
    inlet ToPLMSystemServiceIn is type IntegrationEvent    outlet ToPLMSystemServiceOut is type PLMSystemService.PLMSystemServiceCommand
    handler ToPLMSystemServiceHandler is {
      on syncJobStarted: event Integration.SyncJobStarted is {
        let item0: type PLMSystemService.FetchProduct = prompt("translate the syncJobStarted event into a FetchProduct, the job needing the current product record before it can compare")
        send item0 to outlet IntegrationContext.ToPLMSystemService.ToPLMSystemServiceOut
      }
      on changeEventProcessed: event Integration.ChangeEventProcessed is {
        let item0: type PLMSystemService.UpdateProduct = prompt("translate the changeEventProcessed event into a UpdateProduct, a processed change being what there is to write back")
        send item0 to outlet IntegrationContext.ToPLMSystemService.ToPLMSystemServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToPLMSystemService"
      }
    } with {
      briefly "to plm system service"
      described as {
        |Carries messages to the external PLMSystemService.
      }
    }
  } with {
    briefly "PLMSystemService integration"
    described as {
      |The model's side of the PLMSystemService conversation.
    }
  }
  include "types.riddl"
  include "Integration.riddl"
  // Repository for integration persistence
  type IntegrationRepositoryCommand is one of {
    IntegrationContext.IntegrationRepository.PersistChangeEventProcessed or IntegrationContext.IntegrationRepository.PersistConnectionTested or IntegrationContext.IntegrationRepository.PersistFieldMappingUpdated or IntegrationContext.IntegrationRepository.PersistIntegrationCreated or IntegrationContext.IntegrationRepository.PersistIntegrationDisabled or IntegrationContext.IntegrationRepository.PersistIntegrationEnabled or IntegrationContext.IntegrationRepository.PersistIntegrationUpdated or IntegrationContext.IntegrationRepository.PersistProductSynced or IntegrationContext.IntegrationRepository.PersistSyncJobCancelled or IntegrationContext.IntegrationRepository.PersistSyncJobCompleted or IntegrationContext.IntegrationRepository.PersistSyncJobStarted or IntegrationContext.IntegrationRepository.PersistSystemRegistered
  } with {
    briefly "Anything that writes IntegrationRepository"
    described as {
      |The persistence commands IntegrationRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository IntegrationRepository as flow is {
    inlet IntegrationRepositoryFromIntegrationAnalytics is type IntegrationRepositoryCommand    command PersistChangeEventProcessed is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ChangeEventProcessed applies to.
        }
      }
    } with {
      briefly "Persist ChangeEventProcessed"
      described as {
        |Instructs this repository to apply ChangeEventProcessed to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistFieldMappingUpdated is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row FieldMappingUpdated applies to.
        }
      }
    } with {
      briefly "Persist FieldMappingUpdated"
      described as {
        |Instructs this repository to apply FieldMappingUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIntegrationCreated is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row IntegrationCreated applies to.
        }
      }
    } with {
      briefly "Persist IntegrationCreated"
      described as {
        |Instructs this repository to apply IntegrationCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIntegrationDisabled is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row IntegrationDisabled applies to.
        }
      }
    } with {
      briefly "Persist IntegrationDisabled"
      described as {
        |Instructs this repository to apply IntegrationDisabled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIntegrationEnabled is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row IntegrationEnabled applies to.
        }
      }
    } with {
      briefly "Persist IntegrationEnabled"
      described as {
        |Instructs this repository to apply IntegrationEnabled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistIntegrationUpdated is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row IntegrationUpdated applies to.
        }
      }
    } with {
      briefly "Persist IntegrationUpdated"
      described as {
        |Instructs this repository to apply IntegrationUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSyncJobCancelled is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SyncJobCancelled applies to.
        }
      }
    } with {
      briefly "Persist SyncJobCancelled"
      described as {
        |Instructs this repository to apply SyncJobCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSystemRegistered is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row SystemRegistered applies to.
        }
      }
    } with {
      briefly "Persist SystemRegistered"
      described as {
        |Instructs this repository to apply SystemRegistered to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistConnectionTested is {
      systemId: SystemId with {
        briefly "Row addressed"
        described as {
          |Which stored row ConnectionTested applies to.
        }
      }
    } with {
      briefly "Persist ConnectionTested"
      described as {
        |Instructs this repository to apply ConnectionTested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistProductSynced is {
      integrationId: IntegrationId with {
        briefly "Row addressed"
        described as {
          |Which stored row ProductSynced applies to.
        }
      }
    } with {
      briefly "Persist ProductSynced"
      described as {
        |Instructs this repository to apply ProductSynced to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSyncJobCompleted is {
      jobId: SyncJobId with {
        briefly "Row addressed"
        described as {
          |Which stored row SyncJobCompleted applies to.
        }
      }
    } with {
      briefly "Persist SyncJobCompleted"
      described as {
        |Instructs this repository to apply SyncJobCompleted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistSyncJobStarted is {
      job: SyncJob with {
        briefly "Row addressed"
        described as {
          |Which stored row SyncJobStarted applies to.
        }
      }
    } with {
      briefly "Persist SyncJobStarted"
      described as {
        |Instructs this repository to apply SyncJobStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet IntegrationRepositoryResponses is result Integration.IntegrationResult
    record StoredIntegration is {
      integrationId: IntegrationId with {
        briefly "integrationId"
        described as {
          |The integrationId column of the stored integration row.
        }
      }
      config: IntegrationConfig with {
        briefly "config"
        described as {
          |The config column of the stored integration row.
        }
      }
    } with {
      briefly "Stored integration row"
      described as {
        |The persistence shape of integration data as this repository stores it.
      }
    }
    schema IntegrationData is relational
      of integrations as record StoredIntegration
        index on field StoredIntegration.integrationId
        index on field StoredIntegration.config.sourceSystemId
 with {
      briefly "Integration data schema"
      described as {
        |The relational schema holding integration data for the IntegrationRepository.
      }
    }
    handler IntegrationPersistence is {
      on persistChangeEventProcessed: command PersistChangeEventProcessed is {
        do "apply ChangeEventProcessed to the stored row"
      }
      on persistFieldMappingUpdated: command PersistFieldMappingUpdated is {
        do "apply FieldMappingUpdated to the stored row"
      }
      on persistIntegrationCreated: command PersistIntegrationCreated is {
        do "apply IntegrationCreated to the stored row"
      }
      on persistIntegrationDisabled: command PersistIntegrationDisabled is {
        do "apply IntegrationDisabled to the stored row"
      }
      on persistIntegrationEnabled: command PersistIntegrationEnabled is {
        do "apply IntegrationEnabled to the stored row"
      }
      on persistIntegrationUpdated: command PersistIntegrationUpdated is {
        do "apply IntegrationUpdated to the stored row"
      }
      on persistSyncJobCancelled: command PersistSyncJobCancelled is {
        do "apply SyncJobCancelled to the stored row"
      }
      on persistSystemRegistered: command PersistSystemRegistered is {
        do "apply SystemRegistered to the stored row"
      }
      on persistConnectionTested: command PersistConnectionTested is {
        do "apply ConnectionTested to the stored row"
      }
      on persistProductSynced: command PersistProductSynced is {
        do "apply ProductSynced to the stored row"
      }
      on persistSyncJobCompleted: command PersistSyncJobCompleted is {
        do "apply SyncJobCompleted to the stored row"
      }
      on persistSyncJobStarted: command PersistSyncJobStarted is {
        do "apply SyncJobStarted to the stored row"
      }
      on query GetIntegrationStats is {
        let integrationStatsView: type IntegrationStatsView = prompt("read the integration stats projection")
        reply integrationStatsView
      }
    } with {
      briefly "Persists integration commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Integration data persistence"
    described as {
      | The IntegrationRepository provides persistent storage for
      | integrations, sync jobs, and change events.
    }
  }
  // Projector for integration analytics
  query GetIntegrationStats replies result IntegrationStatsView is {
    integrationStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which integration stats to retrieve.
      }
    }
  } with {
    briefly "Get integration stats"
    described as {
      |Retrieves the integration stats projection.
    }
  }
  result IntegrationStatsView is {
    integrationStats: IntegrationAnalytics.IntegrationStats with {
      briefly "Integration stats"
      described as {
        |The integration stats being returned.
      }
    }
  } with {
    briefly "Integration stats view"
    described as {
      |Read model view carrying the integration stats projection.
    }
  }
  projector IntegrationAnalytics as flow is {
    updates repository IntegrationContext.IntegrationRepository
    outlet IntegrationAnalyticsToRepository is type IntegrationRepositoryCommand
    inlet IntegrationAnalyticsFromIntegration is type IntegrationEvent    record IntegrationStats is {
      integrationId: IntegrationId with {
        briefly "Integration"
        described as {
          |Integration ID.
        }
      }
      totalSyncs: Natural with {
        briefly "Syncs"
        described as {
          |Total sync jobs.
        }
      }
      successfulSyncs: Natural with {
        briefly "Successful"
        described as {
          |Successful syncs.
        }
      }
      totalRecords: Natural with {
        briefly "Records"
        described as {
          |Total records synced.
        }
      }
      averageLatency: Duration with {
        briefly "Latency"
        described as {
          |Average sync time.
        }
      }
    } with {
      briefly "Integration statistics"
      described as {
        |Integration performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on changeEventProcessed: event Integration.ChangeEventProcessed is {
        tell command IntegrationContext.IntegrationRepository.PersistChangeEventProcessed(integrationId = changeEventProcessed.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply ChangeEventProcessed to the IntegrationAnalytics projection"
      }
      on fieldMappingUpdated: event Integration.FieldMappingUpdated is {
        tell command IntegrationContext.IntegrationRepository.PersistFieldMappingUpdated(integrationId = fieldMappingUpdated.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply FieldMappingUpdated to the IntegrationAnalytics projection"
      }
      on integrationCreated: event Integration.IntegrationCreated is {
        tell command IntegrationContext.IntegrationRepository.PersistIntegrationCreated(integrationId = integrationCreated.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply IntegrationCreated to the IntegrationAnalytics projection"
      }
      on integrationDisabled: event Integration.IntegrationDisabled is {
        tell command IntegrationContext.IntegrationRepository.PersistIntegrationDisabled(integrationId = integrationDisabled.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply IntegrationDisabled to the IntegrationAnalytics projection"
      }
      on integrationEnabled: event Integration.IntegrationEnabled is {
        tell command IntegrationContext.IntegrationRepository.PersistIntegrationEnabled(integrationId = integrationEnabled.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply IntegrationEnabled to the IntegrationAnalytics projection"
      }
      on integrationUpdated: event Integration.IntegrationUpdated is {
        tell command IntegrationContext.IntegrationRepository.PersistIntegrationUpdated(integrationId = integrationUpdated.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply IntegrationUpdated to the IntegrationAnalytics projection"
      }
      on syncJobCancelled: event Integration.SyncJobCancelled is {
        tell command IntegrationContext.IntegrationRepository.PersistSyncJobCancelled(integrationId = syncJobCancelled.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply SyncJobCancelled to the IntegrationAnalytics projection"
      }
      on systemRegistered: event Integration.SystemRegistered is {
        tell command IntegrationContext.IntegrationRepository.PersistSystemRegistered(integrationId = systemRegistered.integrationId) to repository IntegrationContext.IntegrationRepository
        do "apply SystemRegistered to the IntegrationAnalytics projection"
      }
      on syncJobStarted: event Integration.SyncJobStarted is {
        tell command IntegrationContext.IntegrationRepository.PersistSyncJobStarted(job = syncJobStarted.job) to repository IntegrationContext.IntegrationRepository
        do "Track sync start"
      }
      on syncJobCompleted: event Integration.SyncJobCompleted is {
        tell command IntegrationContext.IntegrationRepository.PersistSyncJobCompleted(jobId = syncJobCompleted.jobId) to repository IntegrationContext.IntegrationRepository
        do "Update sync metrics"
      }
      on connectionTested: event Integration.ConnectionTested is {
        tell command IntegrationContext.IntegrationRepository.PersistConnectionTested(systemId = connectionTested.systemId) to repository IntegrationContext.IntegrationRepository
        do "Update connection metrics"
      }
      on productSynced: event Integration.ProductSynced is {
        tell command IntegrationContext.IntegrationRepository.PersistProductSynced(integrationId = productSynced.integrationId) to repository IntegrationContext.IntegrationRepository
        do "Update record counts"
      }
    } with {
      briefly "Maintains integration analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Integration analytics projections"
    described as {
      |Maintains integration analytics data.
    }
  }
  // ---- Event publication for Integration ----
  type IntegrationEvent is one of {
    IntegrationContext.Integration.IntegrationCreated or IntegrationContext.Integration.IntegrationUpdated or IntegrationContext.Integration.IntegrationEnabled or IntegrationContext.Integration.IntegrationDisabled or IntegrationContext.Integration.SystemRegistered or IntegrationContext.Integration.ConnectionTested or IntegrationContext.Integration.ProductSynced or IntegrationContext.Integration.SyncJobStarted or IntegrationContext.Integration.SyncJobCompleted or IntegrationContext.Integration.SyncJobCancelled or IntegrationContext.Integration.ChangeEventProcessed or IntegrationContext.Integration.FieldMappingUpdated
  } with {
    briefly "Integration event alternation"
    described as {
      |Union of all Integration events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet IntegrationEventSplit as split is {
    outlet IntegrationEventSplitToToPLMSystemService is type IntegrationEvent
    outlet IntegrationEventSplitToToMonitoringService is type IntegrationEvent
    outlet IntegrationEventSplitToToMessageQueueService is type IntegrationEvent
    outlet IntegrationEventSplitToToERPSystemService is type IntegrationEvent
    outlet IntegrationEventSplitToToCADSystemService is type IntegrationEvent
    inlet IntegrationEventSplitIn is type IntegrationEvent    outlet IntegrationEventSplitToIntegrationAnalytics is type IntegrationEvent
    handler IntegrationEventSplitHandler is {
      on integrationCreated: event Integration.IntegrationCreated is {
        send integrationCreated to outlet IntegrationEventSplitToIntegrationAnalytics
        tell integrationCreated to entity IntegrationContext.Integration
      }
      on integrationUpdated: event Integration.IntegrationUpdated is {
        send integrationUpdated to outlet IntegrationEventSplitToIntegrationAnalytics
        tell integrationUpdated to entity IntegrationContext.Integration
      }
      on integrationEnabled: event Integration.IntegrationEnabled is {
        send integrationEnabled to outlet IntegrationEventSplitToIntegrationAnalytics
        send integrationEnabled to outlet IntegrationEventSplitToToMessageQueueService
        tell integrationEnabled to entity IntegrationContext.Integration
      }
      on integrationDisabled: event Integration.IntegrationDisabled is {
        send integrationDisabled to outlet IntegrationEventSplitToIntegrationAnalytics
        tell integrationDisabled to entity IntegrationContext.Integration
      }
      on systemRegistered: event Integration.SystemRegistered is {
        send systemRegistered to outlet IntegrationEventSplitToIntegrationAnalytics
        tell systemRegistered to entity IntegrationContext.Integration
      }
      on connectionTested: event Integration.ConnectionTested is {
        send connectionTested to outlet IntegrationEventSplitToIntegrationAnalytics
        tell connectionTested to entity IntegrationContext.Integration
      }
      on productSynced: event Integration.ProductSynced is {
        send productSynced to outlet IntegrationEventSplitToIntegrationAnalytics
        send productSynced to outlet IntegrationEventSplitToToERPSystemService
        tell productSynced to entity IntegrationContext.Integration
      }
      on syncJobStarted: event Integration.SyncJobStarted is {
        send syncJobStarted to outlet IntegrationEventSplitToIntegrationAnalytics
        send syncJobStarted to outlet IntegrationEventSplitToToPLMSystemService
        send syncJobStarted to outlet IntegrationEventSplitToToCADSystemService
        tell syncJobStarted to entity IntegrationContext.Integration
      }
      on syncJobCompleted: event Integration.SyncJobCompleted is {
        send syncJobCompleted to outlet IntegrationEventSplitToIntegrationAnalytics
        send syncJobCompleted to outlet IntegrationEventSplitToToMonitoringService
        tell syncJobCompleted to entity IntegrationContext.Integration
      }
      on syncJobCancelled: event Integration.SyncJobCancelled is {
        send syncJobCancelled to outlet IntegrationEventSplitToIntegrationAnalytics
        send syncJobCancelled to outlet IntegrationEventSplitToToMonitoringService
        tell syncJobCancelled to entity IntegrationContext.Integration
      }
      on changeEventProcessed: event Integration.ChangeEventProcessed is {
        send changeEventProcessed to outlet IntegrationEventSplitToIntegrationAnalytics
        send changeEventProcessed to outlet IntegrationEventSplitToToPLMSystemService
        send changeEventProcessed to outlet IntegrationEventSplitToToMessageQueueService
        tell changeEventProcessed to entity IntegrationContext.Integration
      }
      on fieldMappingUpdated: event Integration.FieldMappingUpdated is {
        send fieldMappingUpdated to outlet IntegrationEventSplitToIntegrationAnalytics
        tell fieldMappingUpdated to entity IntegrationContext.Integration
      }
      on other is {
        error "Unexpected message for processor IntegrationEventSplit"
      }
    } with {
      briefly "Integration event fan-out handler"
      described as {
        |Delivers each Integration event to all of its consumers.
      }
    }
  } with {
    briefly "Integration event fan-out"
    described as {
      |Fans Integration events out to the repository and projectors.
    }
  }
  connector 'ToPLMSystemService Feed' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToToPLMSystemService to inlet IntegrationContext.ToPLMSystemService.ToPLMSystemServiceIn with {
    briefly "The Integration events ToPLMSystemService translates, on their way to it"
  }
  connector 'ToMonitoringService Feed' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToToMonitoringService to inlet IntegrationContext.ToMonitoringService.ToMonitoringServiceIn with {
    briefly "The Integration events ToMonitoringService translates, on their way to it"
  }
  connector 'ToMessageQueueService Feed' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToToMessageQueueService to inlet IntegrationContext.ToMessageQueueService.ToMessageQueueServiceIn with {
    briefly "The Integration events ToMessageQueueService translates, on their way to it"
  }
  connector 'ToERPSystemService Feed' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToToERPSystemService to inlet IntegrationContext.ToERPSystemService.ToERPSystemServiceIn with {
    briefly "The Integration events ToERPSystemService translates, on their way to it"
  }
  connector 'ToCADSystemService Feed' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToToCADSystemService to inlet IntegrationContext.ToCADSystemService.ToCADSystemServiceIn with {
    briefly "The Integration events ToCADSystemService translates, on their way to it"
  }
  connector 'IntegrationEvent Stream' is from outlet IntegrationContext.Integration.IntegrationEvents2 to inlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitIn with {
    briefly "Integration events, fanned out to storage and read models"
  }
  connector 'IntegrationAnalytics Feed' is from outlet IntegrationContext.IntegrationEventSplit.IntegrationEventSplitToIntegrationAnalytics to inlet IntegrationContext.IntegrationAnalytics.IntegrationAnalyticsFromIntegration with {
    briefly "Integration events feeding the IntegrationAnalytics projection"
  }
  connector 'IntegrationAnalytics Storage' is from outlet IntegrationContext.IntegrationAnalytics.IntegrationAnalyticsToRepository to inlet IntegrationContext.IntegrationRepository.IntegrationRepositoryFromIntegrationAnalytics with {
    briefly "IntegrationAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for PLM integration"
  described as {
    | The IntegrationContext is the bounded context for PLM
    | data synchronization and system orchestration.
  }
}
