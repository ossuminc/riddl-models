// PLM Integration - Integration Context
context IntegrationContext is {
  include "types.riddl"
  include "Integration.riddl"
  // Repository for integration persistence
  repository IntegrationRepository is {
    schema IntegrationData is relational
      of integrations as type Integration
        index on field Integration.integrationId
        index on field Integration.config.sourceSystemId

    handler IntegrationPersistence is {
      on command Integration.CreateIntegration is {
        tell event Integration.IntegrationCreated to entity IntegrationContext.Integration
        prompt "Store integration config"
      }
      on command Integration.UpdateIntegration is {
        tell event Integration.IntegrationUpdated to entity IntegrationContext.Integration
        prompt "Update integration config"
      }
      on command Integration.RegisterSystem is {
        prompt "Store system record"
      }
      on command Integration.StartSyncJob is {
        tell event Integration.SyncJobStarted to entity IntegrationContext.Integration
        prompt "Store sync job"
      }
      on command Integration.CancelSyncJob is {
        tell event Integration.SyncJobCancelled to entity IntegrationContext.Integration
        prompt "Update sync job status"
      }
      on command Integration.ProcessChangeEvent is {
        tell event Integration.ChangeEventProcessed to entity IntegrationContext.Integration
        prompt "Log change event"
      }
    } with {
      briefly "Persists integration commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Integration data persistence"
    described as {
      | The IntegrationRepository provides persistent storage for
      | integrations, sync jobs, and change events.
    }
  }
  // Projector for integration analytics
  projector IntegrationAnalytics is {
    updates repository IntegrationContext.IntegrationRepository
    record IntegrationStats is  {
      integrationId: IntegrationId with {
        briefly "Integration"
        described as {
          |Integration ID.
        }
      }
      totalSyncs: Natural with {
        briefly "Syncs"
        described as {
          |Total sync jobs.
        }
      }
      successfulSyncs: Natural with {
        briefly "Successful"
        described as {
          |Successful syncs.
        }
      }
      totalRecords: Natural with {
        briefly "Records"
        described as {
          |Total records synced.
        }
      }
      averageLatency: Duration with {
        briefly "Latency"
        described as {
          |Average sync time.
        }
      }
    } with {
      briefly "Integration statistics"
      described as {
        |Integration performance metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Integration.SyncJobStarted is {
        tell event Integration.SyncJobStarted to repository IntegrationContext.IntegrationRepository
        prompt "Track sync start"
      }
      on event Integration.SyncJobCompleted is {
        tell event Integration.SyncJobCompleted to repository IntegrationContext.IntegrationRepository
        prompt "Update sync metrics"
      }
      on event Integration.ConnectionTested is {
        tell event Integration.ConnectionTested to repository IntegrationContext.IntegrationRepository
        prompt "Update connection metrics"
      }
      on event Integration.ProductSynced is {
        tell event Integration.ProductSynced to repository IntegrationContext.IntegrationRepository
        prompt "Update record counts"
      }
    } with {
      briefly "Maintains integration analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Integration analytics projections"
    described as {
      |Maintains integration analytics data.
    }
  }
  // ---- Event publication for Integration ----
  type IntegrationEvent is one of {
    IntegrationContext.Integration.IntegrationCreated,
    IntegrationContext.Integration.IntegrationUpdated,
    IntegrationContext.Integration.IntegrationEnabled,
    IntegrationContext.Integration.IntegrationDisabled,
    IntegrationContext.Integration.SystemRegistered,
    IntegrationContext.Integration.ConnectionTested,
    IntegrationContext.Integration.ProductSynced,
    IntegrationContext.Integration.SyncJobStarted,
    IntegrationContext.Integration.SyncJobCompleted,
    IntegrationContext.Integration.SyncJobCancelled,
    IntegrationContext.Integration.ChangeEventProcessed,
    IntegrationContext.Integration.FieldMappingUpdated
  } with {
    briefly "Integration event alternation"
    described as {
      |Union of all Integration events, for streaming and event-sourced
      |persistence.
    }
  }
  source IntegrationEventSource is {
    outlet IntegrationEvents is type IntegrationEvent
    handler IntegrationSourceHandler is {
      on event Integration.IntegrationCreated is {
        send event Integration.IntegrationCreated to outlet IntegrationEvents
      }
      on event Integration.IntegrationUpdated is {
        send event Integration.IntegrationUpdated to outlet IntegrationEvents
      }
      on event Integration.IntegrationEnabled is {
        send event Integration.IntegrationEnabled to outlet IntegrationEvents
      }
      on event Integration.IntegrationDisabled is {
        send event Integration.IntegrationDisabled to outlet IntegrationEvents
      }
      on event Integration.SystemRegistered is {
        send event Integration.SystemRegistered to outlet IntegrationEvents
      }
      on event Integration.ConnectionTested is {
        send event Integration.ConnectionTested to outlet IntegrationEvents
      }
      on event Integration.ProductSynced is {
        send event Integration.ProductSynced to outlet IntegrationEvents
      }
      on event Integration.SyncJobStarted is {
        send event Integration.SyncJobStarted to outlet IntegrationEvents
      }
      on event Integration.SyncJobCompleted is {
        send event Integration.SyncJobCompleted to outlet IntegrationEvents
      }
      on event Integration.SyncJobCancelled is {
        send event Integration.SyncJobCancelled to outlet IntegrationEvents
      }
      on event Integration.ChangeEventProcessed is {
        send event Integration.ChangeEventProcessed to outlet IntegrationEvents
      }
      on event Integration.FieldMappingUpdated is {
        send event Integration.FieldMappingUpdated to outlet IntegrationEvents
      }
      on other is {
        error "Unexpected message for source IntegrationEventSource"
      }
    } with {
      briefly "Integration source handler"
      described as {
        |Publishes Integration events onto the outlet.
      }
    }
  } with {
    briefly "Integration event source"
    described as {
      |Publishes Integration entity events into the streaming topology.
    }
  }
  sink IntegrationEventSink is {
    inlet IntegrationInlet is type IntegrationEvent
    handler IntegrationSinkHandler is {
      on event Integration.IntegrationCreated is {
        tell event Integration.IntegrationCreated to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.IntegrationUpdated is {
        tell event Integration.IntegrationUpdated to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.IntegrationEnabled is {
        tell event Integration.IntegrationEnabled to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.IntegrationDisabled is {
        tell event Integration.IntegrationDisabled to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.SystemRegistered is {
        tell event Integration.SystemRegistered to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.ConnectionTested is {
        tell event Integration.ConnectionTested to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.ProductSynced is {
        tell event Integration.ProductSynced to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.SyncJobStarted is {
        tell event Integration.SyncJobStarted to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.SyncJobCompleted is {
        tell event Integration.SyncJobCompleted to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.SyncJobCancelled is {
        tell event Integration.SyncJobCancelled to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.ChangeEventProcessed is {
        tell event Integration.ChangeEventProcessed to repository IntegrationContext.IntegrationRepository
      }
      on event Integration.FieldMappingUpdated is {
        tell event Integration.FieldMappingUpdated to repository IntegrationContext.IntegrationRepository
      }
      on other is {
        error "Unexpected message for sink IntegrationEventSink"
      }
    } with {
      briefly "Integration sink handler"
      described as {
        |Persists Integration events via the repository.
      }
    }
  } with {
    briefly "Integration event sink"
    described as {
      |Receives Integration events for persistence.
    }
  }
  connector IntegrationEventFlow is {
    from outlet IntegrationContext.IntegrationEventSource.IntegrationEvents to
      inlet IntegrationContext.IntegrationEventSink.IntegrationInlet
  } with {
    briefly "Integration event flow"
    described as {
      |Connects the Integration source to its sink.
    }
  }
} with {
  briefly "Bounded context for PLM integration"
  described as {
    | The IntegrationContext is the bounded context for PLM
    | data synchronization and system orchestration.
  }
}
