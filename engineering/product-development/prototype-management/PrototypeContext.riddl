// Prototype Management - Prototype Context
context PrototypeContext is {
  adaptor FromDefectTrackingService from context DefectTrackingService is { 
    handler FromDefectTrackingServiceHandler is {
      on event DefectTrackingService.DefectCreated is {
        do "the model receives defect created"
      }
      on other is {
        error "Unexpected message for adaptor FromDefectTrackingService"
      }
    } with {
      briefly "from defect tracking service"
      described as {
        |Carries messages from the external DefectTrackingService.
      }
    }
  } with {
    briefly "DefectTrackingService integration"
    described as {
      |The model's side of the DefectTrackingService conversation.
    }
  }
  adaptor ToDefectTrackingService to context DefectTrackingService is { 
    handler ToDefectTrackingServiceHandler is {
      on command DefectTrackingService.CreateDefect is {
        do "the model sends create defect"
      }
      on other is {
        error "Unexpected message for adaptor ToDefectTrackingService"
      }
    } with {
      briefly "to defect tracking service"
      described as {
        |Carries messages to the external DefectTrackingService.
      }
    }
  } with {
    briefly "DefectTrackingService integration"
    described as {
      |The model's side of the DefectTrackingService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendBuildUpdate is {
        do "the model sends send build update"
      }
      on command NotificationService.SendTestAlert is {
        do "the model sends send test alert"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPLMService from context PLMService is { 
    handler FromPLMServiceHandler is {
      on event PLMService.DesignChanged is {
        do "the model receives design changed"
      }
      on event PLMService.DesignReleased is {
        do "the model receives design released"
      }
      on other is {
        error "Unexpected message for adaptor FromPLMService"
      }
    } with {
      briefly "from plm service"
      described as {
        |Carries messages from the external PLMService.
      }
    }
  } with {
    briefly "PLMService integration"
    described as {
      |The model's side of the PLMService conversation.
    }
  }
  adaptor FromProcurementService from context ProcurementService is { 
    handler FromProcurementServiceHandler is {
      on event ProcurementService.ComponentOrdered is {
        do "the model receives component ordered"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementService"
      }
    } with {
      briefly "from procurement service"
      described as {
        |Carries messages from the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor ToProcurementService to context ProcurementService is { 
    handler ToProcurementServiceHandler is {
      on command ProcurementService.OrderComponent is {
        do "the model sends order component"
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementService"
      }
    } with {
      briefly "to procurement service"
      described as {
        |Carries messages to the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor FromTestEquipmentService from context TestEquipmentService is { 
    handler FromTestEquipmentServiceHandler is {
      on event TestEquipmentService.EquipmentReserved is {
        do "the model receives equipment reserved"
      }
      on other is {
        error "Unexpected message for adaptor FromTestEquipmentService"
      }
    } with {
      briefly "from test equipment service"
      described as {
        |Carries messages from the external TestEquipmentService.
      }
    }
  } with {
    briefly "TestEquipmentService integration"
    described as {
      |The model's side of the TestEquipmentService conversation.
    }
  }
  adaptor ToTestEquipmentService to context TestEquipmentService is { 
    handler ToTestEquipmentServiceHandler is {
      on command TestEquipmentService.ReserveEquipment is {
        do "the model sends reserve equipment"
      }
      on other is {
        error "Unexpected message for adaptor ToTestEquipmentService"
      }
    } with {
      briefly "to test equipment service"
      described as {
        |Carries messages to the external TestEquipmentService.
      }
    }
  } with {
    briefly "TestEquipmentService integration"
    described as {
      |The model's side of the TestEquipmentService conversation.
    }
  }
  include "types.riddl"
  include "Prototype.riddl"
  // Repository for prototype persistence
  repository PrototypeRepository as merge is {
    inlet PrototypeRepositoryFromPrototype is type PrototypeEvent    inlet PrototypeRepositoryFromPrototypeAnalytics is type PrototypeEvent    outlet PrototypeRepositoryResponses is type Prototype.PrototypeResult
    record StoredPrototype is  {
      prototypeId: PrototypeId with {
        briefly "prototypeId"
        described as {
          |The prototypeId column of the stored prototype row.
        }
      }
      info: PrototypeInfo with {
        briefly "info"
        described as {
          |The info column of the stored prototype row.
        }
      }
    } with {
      briefly "Stored prototype row"
      described as {
        |The persistence shape of prototype data as this repository stores it.
      }
    }
    schema PrototypeData is relational
      of prototypes as type StoredPrototype
        index on field StoredPrototype.prototypeId
        index on field StoredPrototype.info.projectId
 with {
      briefly "Prototype data schema"
      described as {
        |The relational schema holding prototype data for the PrototypeRepository.
      }
    }
    handler PrototypePersistence is {
      on query GetPrototypeStats is {
        do "read the prototype stats projection"
        reply result PrototypeStatsView
      }
      on createPrototype: command Prototype.CreatePrototype is {
        tell event Prototype.PrototypeCreated(prototypeId = createPrototype.prototypeId, info = createPrototype.info) to entity PrototypeContext.Prototype
        do "Store prototype record"
      }
      on updatePrototype: command Prototype.UpdatePrototype is {
        tell event Prototype.PrototypeUpdated(prototypeId = updatePrototype.prototypeId, info = updatePrototype.info) to entity PrototypeContext.Prototype
        do "Update prototype info"
      }
      on startBuild: command Prototype.StartBuild is {
        tell event Prototype.BuildStarted(prototypeId = startBuild.prototypeId, build = startBuild.build) to entity PrototypeContext.Prototype
        do "Store build record"
      }
      on updateBuildStatus: command Prototype.UpdateBuildStatus is {
        tell event Prototype.BuildStatusUpdated(prototypeId = updateBuildStatus.prototypeId, buildId = updateBuildStatus.buildId, status = updateBuildStatus.status) to entity PrototypeContext.Prototype
        do "Update build status"
      }
      on receiveComponent: command Prototype.ReceiveComponent is {
        tell event Prototype.ComponentReceived(prototypeId = receiveComponent.prototypeId, buildId = receiveComponent.buildId, componentId = receiveComponent.componentId) to entity PrototypeContext.Prototype
        do "Update component status"
      }
      on createTestPlan: command Prototype.CreateTestPlan is {
        tell event Prototype.TestPlanCreated(prototypeId = createTestPlan.prototypeId, plan = createTestPlan.plan) to entity PrototypeContext.Prototype
        do "Store test plan"
      }
      on command Prototype.ExecuteTest is {
        do "Store test execution"
      }
      on recordTestResult: command Prototype.RecordTestResult is {
        tell event Prototype.TestResultRecorded(prototypeId = recordTestResult.prototypeId, testId = recordTestResult.testId, result = recordTestResult.result) to entity PrototypeContext.Prototype
        do "Store test result"
      }
      on command Prototype.ValidatePrototype is {
        do "Update validation status"
      }
    } with {
      briefly "Persists prototype commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Prototype data persistence"
    described as {
      | The PrototypeRepository provides persistent storage for
      | prototypes, builds, and test results.
    }
  }
  // Projector for prototype analytics
  query GetPrototypeStats is  {
    prototypeStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which prototype stats to retrieve.
      }
    }
  } with {
    briefly "Get prototype stats"
    described as {
      |Retrieves the prototype stats projection.
    }
  }
  result PrototypeStatsView is  {
    prototypeStats: PrototypeAnalytics.PrototypeStats with {
      briefly "Prototype stats"
      described as {
        |The prototype stats being returned.
      }
    }
  } with {
    briefly "Prototype stats view"
    described as {
      |Read model view carrying the prototype stats projection.
    }
  }
  projector PrototypeAnalytics as flow is {
    updates repository PrototypeContext.PrototypeRepository
    inlet PrototypeAnalyticsFromPrototype is type PrototypeEvent    outlet PrototypeAnalyticsOut is type PrototypeEvent
    record PrototypeStats is  {
      projectId: ProjectId with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      totalPrototypes: Natural with {
        briefly "Prototypes"
        described as {
          |Total prototypes.
        }
      }
      totalBuilds: Natural with {
        briefly "Builds"
        described as {
          |Total builds.
        }
      }
      testPassRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Test pass rate.
        }
      }
      averageBuildTime: Duration with {
        briefly "Build time"
        described as {
          |Average build time.
        }
      }
    } with {
      briefly "Prototype statistics"
      described as {
        |Project prototype metrics.
      }
    }
    handler AnalyticsHandler is {
      on prototypeCreated: event Prototype.PrototypeCreated is {
        tell prototypeCreated to repository PrototypeContext.PrototypeRepository
        do "Update prototype counts"
      }
      on buildStarted: event Prototype.BuildStarted is {
        tell buildStarted to repository PrototypeContext.PrototypeRepository
        do "Update build counts"
      }
      on testResultRecorded: event Prototype.TestResultRecorded is {
        tell testResultRecorded to repository PrototypeContext.PrototypeRepository
        do "Update test metrics"
      }
      on prototypeValidated: event Prototype.PrototypeValidated is {
        tell prototypeValidated to repository PrototypeContext.PrototypeRepository
        do "Update validation metrics"
      }
    } with {
      briefly "Maintains prototype analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Prototype analytics projections"
    described as {
      |Maintains prototype analytics data.
    }
  }
  // ---- Event publication for Prototype ----
  type PrototypeEvent is one of {
    PrototypeContext.Prototype.PrototypeCreated or PrototypeContext.Prototype.PrototypeUpdated or PrototypeContext.Prototype.BuildStarted or PrototypeContext.Prototype.BuildStatusUpdated or PrototypeContext.Prototype.ComponentReceived or PrototypeContext.Prototype.TestPlanCreated or PrototypeContext.Prototype.TestExecuted or PrototypeContext.Prototype.TestResultRecorded or PrototypeContext.Prototype.PrototypeValidated or PrototypeContext.Prototype.PrototypeRetired
  } with {
    briefly "Prototype event alternation"
    described as {
      |Union of all Prototype events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PrototypeEventSource as source is {
    outlet PrototypeEvents is type PrototypeEvent
    handler PrototypeSourceHandler is {
      on prototypeCreated: event Prototype.PrototypeCreated is {
        send prototypeCreated to outlet PrototypeEvents
      }
      on prototypeUpdated: event Prototype.PrototypeUpdated is {
        send prototypeUpdated to outlet PrototypeEvents
      }
      on buildStarted: event Prototype.BuildStarted is {
        send buildStarted to outlet PrototypeEvents
      }
      on buildStatusUpdated: event Prototype.BuildStatusUpdated is {
        send buildStatusUpdated to outlet PrototypeEvents
      }
      on componentReceived: event Prototype.ComponentReceived is {
        send componentReceived to outlet PrototypeEvents
      }
      on testPlanCreated: event Prototype.TestPlanCreated is {
        send testPlanCreated to outlet PrototypeEvents
      }
      on testExecuted: event Prototype.TestExecuted is {
        send testExecuted to outlet PrototypeEvents
      }
      on testResultRecorded: event Prototype.TestResultRecorded is {
        send testResultRecorded to outlet PrototypeEvents
      }
      on prototypeValidated: event Prototype.PrototypeValidated is {
        send prototypeValidated to outlet PrototypeEvents
      }
      on prototypeRetired: event Prototype.PrototypeRetired is {
        send prototypeRetired to outlet PrototypeEvents
      }
      on other is {
        error "Unexpected message for source PrototypeEventSource"
      }
    } with {
      briefly "Prototype source handler"
      described as {
        |Publishes Prototype events onto the outlet.
      }
    }
  } with {
    briefly "Prototype event source"
    described as {
      |Publishes Prototype entity events into the streaming topology.
    }
  }
  processor PrototypeEventSink as sink is {
    inlet PrototypeInlet is type PrototypeEvent    handler PrototypeSinkHandler is {
      on prototypeCreated: event Prototype.PrototypeCreated is {
        tell prototypeCreated to repository PrototypeContext.PrototypeRepository
      }
      on prototypeUpdated: event Prototype.PrototypeUpdated is {
        tell prototypeUpdated to repository PrototypeContext.PrototypeRepository
      }
      on buildStarted: event Prototype.BuildStarted is {
        tell buildStarted to repository PrototypeContext.PrototypeRepository
      }
      on buildStatusUpdated: event Prototype.BuildStatusUpdated is {
        tell buildStatusUpdated to repository PrototypeContext.PrototypeRepository
      }
      on componentReceived: event Prototype.ComponentReceived is {
        tell componentReceived to repository PrototypeContext.PrototypeRepository
      }
      on testPlanCreated: event Prototype.TestPlanCreated is {
        tell testPlanCreated to repository PrototypeContext.PrototypeRepository
      }
      on testExecuted: event Prototype.TestExecuted is {
        tell testExecuted to repository PrototypeContext.PrototypeRepository
      }
      on testResultRecorded: event Prototype.TestResultRecorded is {
        tell testResultRecorded to repository PrototypeContext.PrototypeRepository
      }
      on prototypeValidated: event Prototype.PrototypeValidated is {
        tell prototypeValidated to repository PrototypeContext.PrototypeRepository
      }
      on prototypeRetired: event Prototype.PrototypeRetired is {
        tell prototypeRetired to repository PrototypeContext.PrototypeRepository
      }
      on other is {
        error "Unexpected message for sink PrototypeEventSink"
      }
    } with {
      briefly "Prototype sink handler"
      described as {
        |Persists Prototype events via the repository.
      }
    }
  } with {
    briefly "Prototype event sink"
    described as {
      |Receives Prototype events for persistence.
    }
  }
  connector PrototypeEventFlow is from outlet PrototypeContext.PrototypeEventSource.PrototypeEvents to inlet PrototypeContext.PrototypeEventSink.PrototypeInlet with {
    briefly "Prototype event flow"
    described as {
      |Connects the Prototype source to its sink.
    }
  }
  processor PrototypeEventSplit as split is {
    inlet PrototypeEventSplitIn is type PrototypeEvent    outlet PrototypeEventSplitToPrototypeRepository is type PrototypeEvent
    outlet PrototypeEventSplitToPrototypeAnalytics is type PrototypeEvent
    handler PrototypeEventSplitHandler is {
      on prototypeCreated: event Prototype.PrototypeCreated is {
        send prototypeCreated to outlet PrototypeEventSplitToPrototypeRepository
        send prototypeCreated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell prototypeCreated to entity PrototypeContext.Prototype
      }
      on prototypeUpdated: event Prototype.PrototypeUpdated is {
        send prototypeUpdated to outlet PrototypeEventSplitToPrototypeRepository
        send prototypeUpdated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell prototypeUpdated to entity PrototypeContext.Prototype
      }
      on buildStarted: event Prototype.BuildStarted is {
        send buildStarted to outlet PrototypeEventSplitToPrototypeRepository
        send buildStarted to outlet PrototypeEventSplitToPrototypeAnalytics
        tell buildStarted to entity PrototypeContext.Prototype
      }
      on buildStatusUpdated: event Prototype.BuildStatusUpdated is {
        send buildStatusUpdated to outlet PrototypeEventSplitToPrototypeRepository
        send buildStatusUpdated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell buildStatusUpdated to entity PrototypeContext.Prototype
      }
      on componentReceived: event Prototype.ComponentReceived is {
        send componentReceived to outlet PrototypeEventSplitToPrototypeRepository
        send componentReceived to outlet PrototypeEventSplitToPrototypeAnalytics
        tell componentReceived to entity PrototypeContext.Prototype
      }
      on testPlanCreated: event Prototype.TestPlanCreated is {
        send testPlanCreated to outlet PrototypeEventSplitToPrototypeRepository
        send testPlanCreated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell testPlanCreated to entity PrototypeContext.Prototype
      }
      on testExecuted: event Prototype.TestExecuted is {
        send testExecuted to outlet PrototypeEventSplitToPrototypeRepository
        send testExecuted to outlet PrototypeEventSplitToPrototypeAnalytics
        tell testExecuted to entity PrototypeContext.Prototype
      }
      on testResultRecorded: event Prototype.TestResultRecorded is {
        send testResultRecorded to outlet PrototypeEventSplitToPrototypeRepository
        send testResultRecorded to outlet PrototypeEventSplitToPrototypeAnalytics
        tell testResultRecorded to entity PrototypeContext.Prototype
      }
      on prototypeValidated: event Prototype.PrototypeValidated is {
        send prototypeValidated to outlet PrototypeEventSplitToPrototypeRepository
        send prototypeValidated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell prototypeValidated to entity PrototypeContext.Prototype
      }
      on prototypeRetired: event Prototype.PrototypeRetired is {
        send prototypeRetired to outlet PrototypeEventSplitToPrototypeRepository
        send prototypeRetired to outlet PrototypeEventSplitToPrototypeAnalytics
        tell prototypeRetired to entity PrototypeContext.Prototype
      }
      on other is {
        error "Unexpected message for processor PrototypeEventSplit"
      }
    } with {
      briefly "Prototype event fan-out handler"
      described as {
        |Delivers each Prototype event to all of its consumers.
      }
    }
  } with {
    briefly "Prototype event fan-out"
    described as {
      |Fans Prototype events out to the repository and projectors.
    }
  }
  connector 'PrototypeEvent Stream' is from outlet PrototypeContext.Prototype.PrototypeEvents2 to inlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitIn with {
    briefly "Prototype events, fanned out to storage and read models"
  }
  connector 'PrototypeEvent Storage' is from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToPrototypeRepository to inlet PrototypeContext.PrototypeRepository.PrototypeRepositoryFromPrototype with {
    briefly "Prototype events on their way to storage"
  }
  connector 'PrototypeAnalytics Feed' is from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToPrototypeAnalytics to inlet PrototypeContext.PrototypeAnalytics.PrototypeAnalyticsFromPrototype with {
    briefly "Prototype events feeding the PrototypeAnalytics projection"
  }
  connector 'PrototypeAnalytics Storage' is from outlet PrototypeContext.PrototypeAnalytics.PrototypeAnalyticsOut to inlet PrototypeContext.PrototypeRepository.PrototypeRepositoryFromPrototypeAnalytics with {
    briefly "The PrototypeAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for prototype management"
  described as {
    | The PrototypeContext is the bounded context for prototype
    | lifecycle, build tracking, and validation testing.
  }
}
