// Prototype Management - Prototype Context
context PrototypeContext as router is {
  type FromPLMServiceCommand is one of {
    Prototype.CreatePrototype or Prototype.UpdatePrototype
  } with {
    briefly "What FromPLMService turns that service's news into"
  }
  inlet PrototypeContextFromPLMService is type PrototypeContext.FromPLMServiceCommand with {
    briefly "What FromPLMService makes of that service's news"
  }
  connector 'FromPLMService Intake' is from outlet PrototypeContext.FromPLMService.FromPLMServiceToPrototypeContext to inlet PrototypeContext.PrototypeContextFromPLMService with {
    briefly "What FromPLMService makes of that news, on its way in"
  }
  inlet PrototypeCommandStreamIn is type PrototypeCommand  outlet PrototypeCommandStreamOut is type PrototypeCommand
  inlet PrototypeResultStreamIn is result Prototype.PrototypeResult  outlet PrototypeResultStreamOut is result Prototype.PrototypeResult
  handler PrototypeContextBoundary is {
    on createPrototype: command Prototype.CreatePrototype is {
      send createPrototype to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on updatePrototype: command Prototype.UpdatePrototype is {
      send updatePrototype to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on startBuild: command Prototype.StartBuild is {
      send startBuild to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on updateBuildStatus: command Prototype.UpdateBuildStatus is {
      send updateBuildStatus to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on receiveComponent: command Prototype.ReceiveComponent is {
      send receiveComponent to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on createTestPlan: command Prototype.CreateTestPlan is {
      send createTestPlan to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on executeTest: command Prototype.ExecuteTest is {
      send executeTest to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on recordTestResult: command Prototype.RecordTestResult is {
      send recordTestResult to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on validatePrototype: command Prototype.ValidatePrototype is {
      send validatePrototype to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on retirePrototype: command Prototype.RetirePrototype is {
      send retirePrototype to outlet PrototypeContext.PrototypeCommandStreamOut
    }
    on prototypeResult: result Prototype.PrototypeResult is {
      send prototypeResult to outlet PrototypeContext.PrototypeResultStreamOut
    }
    on other is {
      error "Unexpected message at the PrototypeContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'PrototypeCommand Stream Intake' is from outlet PrototypeContext.PrototypeCommandStreamOut to inlet PrototypeContext.Prototype.PrototypeCommands  connector 'PrototypeResult Stream Egress' is from outlet PrototypeContext.PrototypeRepository.PrototypeRepositoryResponses to inlet PrototypeContext.PrototypeResultStreamIn  adaptor FromDefectTrackingService from context DefectTrackingService as sink is { 
    inlet FromDefectTrackingServiceIn is event DefectTrackingService.DefectCreated    handler FromDefectTrackingServiceHandler is {
      on defectCreated: event DefectTrackingService.DefectCreated is {
        do "the defect is tracked; the test result that found it was recorded here"
      }
      on other is {
        error "Unexpected message for adaptor FromDefectTrackingService"
      }
    } with {
      briefly "from defect tracking service"
      described as {
        |Carries messages from the external DefectTrackingService.
      }
    }
  } with {
    briefly "DefectTrackingService integration"
    described as {
      |The model's side of the DefectTrackingService conversation.
    }
  }
  adaptor ToDefectTrackingService to context DefectTrackingService as flow is { 
    inlet ToDefectTrackingServiceIn is type PrototypeEvent    outlet ToDefectTrackingServiceOut is command DefectTrackingService.CreateDefect
    handler ToDefectTrackingServiceHandler is {
      on testFailed: event Prototype.TestFailed is {
        let item0: type DefectTrackingService.CreateDefect = prompt("translate the testFailed event into a CreateDefect, a failed test being what a defect records")
        send item0 to outlet PrototypeContext.ToDefectTrackingService.ToDefectTrackingServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToDefectTrackingService"
      }
    } with {
      briefly "to defect tracking service"
      described as {
        |Carries messages to the external DefectTrackingService.
      }
    }
  } with {
    briefly "DefectTrackingService integration"
    described as {
      |The model's side of the DefectTrackingService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService as flow is { 
    inlet ToNotificationServiceIn is type PrototypeEvent    outlet ToNotificationServiceOut is type NotificationService.NotificationServiceCommand
    handler ToNotificationServiceHandler is {
      on testFailed: event TestFailed is {
        let alert: type NotificationService.SendTestAlert = prompt("translate the testFailed event into a SendTestAlert telling the engineers on the prototype which test failed, so the failure is seen without waiting for someone to read the results")
        send alert to outlet PrototypeContext.ToNotificationService.ToNotificationServiceOut
      }
      on buildStarted: event BuildStarted is {
        let notice: type NotificationService.SendBuildUpdate = prompt("translate the buildStarted event into a SendBuildUpdate telling the engineers the build has begun, so they know the prototype is in progress")
        send notice to outlet PrototypeContext.ToNotificationService.ToNotificationServiceOut
      }
      on buildStatusUpdated: event BuildStatusUpdated is {
        let notice: type NotificationService.SendBuildUpdate = prompt("translate the buildStatusUpdated event into a SendBuildUpdate telling the engineers where the build now stands")
        send notice to outlet PrototypeContext.ToNotificationService.ToNotificationServiceOut
      }
      on prototypeValidated: event PrototypeValidated is {
        let notice: type NotificationService.SendBuildUpdate = prompt("translate the prototypeValidated event into a SendBuildUpdate telling the engineers the prototype passed validation and may move on")
        send notice to outlet PrototypeContext.ToNotificationService.ToNotificationServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPLMService from context PLMService as flow is { 
    inlet FromPLMServiceIn is type PLMService.PLMServiceEvent    outlet FromPLMServiceToPrototypeContext is type PrototypeContext.FromPLMServiceCommand
    handler FromPLMServiceHandler is {
      on designChanged: event PLMService.DesignChanged is {
        let item0: type Prototype.UpdatePrototype = prompt("translate the designChanged event into a UpdatePrototype, a prototype built to a design that has changed must be updated or it is testing the wrong thing")
        send item0 to outlet PrototypeContext.FromPLMService.FromPLMServiceToPrototypeContext
      }
      on designReleased: event PLMService.DesignReleased is {
        let item0: type Prototype.CreatePrototype = prompt("translate the designReleased event into a CreatePrototype, a released design is what a prototype is built from")
        send item0 to outlet PrototypeContext.FromPLMService.FromPLMServiceToPrototypeContext
      }
      on other is {
        error "Unexpected message for adaptor FromPLMService"
      }
    } with {
      briefly "from plm service"
      described as {
        |Carries messages from the external PLMService.
      }
    }
  } with {
    briefly "PLMService integration"
    described as {
      |The model's side of the PLMService conversation.
    }
  }
  adaptor FromProcurementService from context ProcurementService as sink is { 
    inlet FromProcurementServiceIn is event ProcurementService.ComponentOrdered    handler FromProcurementServiceHandler is {
      on componentOrdered: event ProcurementService.ComponentOrdered is {
        do "the order is placed; the component counts when it arrives, not when it is ordered"
      }
      on other is {
        error "Unexpected message for adaptor FromProcurementService"
      }
    } with {
      briefly "from procurement service"
      described as {
        |Carries messages from the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor ToProcurementService to context ProcurementService as flow is { 
    inlet ToProcurementServiceIn is type PrototypeEvent    outlet ToProcurementServiceOut is command ProcurementService.OrderComponent
    handler ToProcurementServiceHandler is {
      on buildStarted: event Prototype.BuildStarted is {
        let item0: type ProcurementService.OrderComponent = prompt("translate the buildStarted event into a OrderComponent, a build starting being when parts must be on order")
        send item0 to outlet PrototypeContext.ToProcurementService.ToProcurementServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToProcurementService"
      }
    } with {
      briefly "to procurement service"
      described as {
        |Carries messages to the external ProcurementService.
      }
    }
  } with {
    briefly "ProcurementService integration"
    described as {
      |The model's side of the ProcurementService conversation.
    }
  }
  adaptor FromTestEquipmentService from context TestEquipmentService as sink is { 
    inlet FromTestEquipmentServiceIn is event TestEquipmentService.EquipmentReserved    handler FromTestEquipmentServiceHandler is {
      on equipmentReserved: event TestEquipmentService.EquipmentReserved is {
        do "the rig is held; the test runs when someone executes it"
      }
      on other is {
        error "Unexpected message for adaptor FromTestEquipmentService"
      }
    } with {
      briefly "from test equipment service"
      described as {
        |Carries messages from the external TestEquipmentService.
      }
    }
  } with {
    briefly "TestEquipmentService integration"
    described as {
      |The model's side of the TestEquipmentService conversation.
    }
  }
  adaptor ToTestEquipmentService to context TestEquipmentService as flow is { 
    inlet ToTestEquipmentServiceIn is type PrototypeEvent    outlet ToTestEquipmentServiceOut is command TestEquipmentService.ReserveEquipment
    handler ToTestEquipmentServiceHandler is {
      on testPlanCreated: event Prototype.TestPlanCreated is {
        let item0: type TestEquipmentService.ReserveEquipment = prompt("translate the testPlanCreated event into a ReserveEquipment, the plan naming the rig the tests need")
        send item0 to outlet PrototypeContext.ToTestEquipmentService.ToTestEquipmentServiceOut
      }
      on other is {
        error "Unexpected message for adaptor ToTestEquipmentService"
      }
    } with {
      briefly "to test equipment service"
      described as {
        |Carries messages to the external TestEquipmentService.
      }
    }
  } with {
    briefly "TestEquipmentService integration"
    described as {
      |The model's side of the TestEquipmentService conversation.
    }
  }
  include "types.riddl"
  include "Prototype.riddl"
  // Repository for prototype persistence
  type PrototypeRepositoryCommand is one of {
    PrototypeContext.PrototypeRepository.PersistBuildStarted or PrototypeContext.PrototypeRepository.PersistBuildStatusUpdated or PrototypeContext.PrototypeRepository.PersistComponentReceived or PrototypeContext.PrototypeRepository.PersistPrototypeCreated or PrototypeContext.PrototypeRepository.PersistPrototypeRetired or PrototypeContext.PrototypeRepository.PersistPrototypeUpdated or PrototypeContext.PrototypeRepository.PersistPrototypeValidated or PrototypeContext.PrototypeRepository.PersistTestExecuted or PrototypeContext.PrototypeRepository.PersistTestPlanCreated or PrototypeContext.PrototypeRepository.PersistTestResultRecorded
  } with {
    briefly "Anything that writes PrototypeRepository"
    described as {
      |The persistence commands PrototypeRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository PrototypeRepository as flow is {
    inlet PrototypeRepositoryFromPrototypeAnalytics is type PrototypeRepositoryCommand    command PersistBuildStatusUpdated is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row BuildStatusUpdated applies to.
        }
      }
    } with {
      briefly "Persist BuildStatusUpdated"
      described as {
        |Instructs this repository to apply BuildStatusUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistComponentReceived is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row ComponentReceived applies to.
        }
      }
    } with {
      briefly "Persist ComponentReceived"
      described as {
        |Instructs this repository to apply ComponentReceived to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrototypeRetired is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrototypeRetired applies to.
        }
      }
    } with {
      briefly "Persist PrototypeRetired"
      described as {
        |Instructs this repository to apply PrototypeRetired to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrototypeUpdated is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrototypeUpdated applies to.
        }
      }
    } with {
      briefly "Persist PrototypeUpdated"
      described as {
        |Instructs this repository to apply PrototypeUpdated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTestExecuted is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row TestExecuted applies to.
        }
      }
    } with {
      briefly "Persist TestExecuted"
      described as {
        |Instructs this repository to apply TestExecuted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTestPlanCreated is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row TestPlanCreated applies to.
        }
      }
    } with {
      briefly "Persist TestPlanCreated"
      described as {
        |Instructs this repository to apply TestPlanCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistBuildStarted is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row BuildStarted applies to.
        }
      }
    } with {
      briefly "Persist BuildStarted"
      described as {
        |Instructs this repository to apply BuildStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrototypeCreated is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrototypeCreated applies to.
        }
      }
    } with {
      briefly "Persist PrototypeCreated"
      described as {
        |Instructs this repository to apply PrototypeCreated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistPrototypeValidated is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row PrototypeValidated applies to.
        }
      }
    } with {
      briefly "Persist PrototypeValidated"
      described as {
        |Instructs this repository to apply PrototypeValidated to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistTestResultRecorded is {
      prototypeId: PrototypeId with {
        briefly "Row addressed"
        described as {
          |Which stored row TestResultRecorded applies to.
        }
      }
    } with {
      briefly "Persist TestResultRecorded"
      described as {
        |Instructs this repository to apply TestResultRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet PrototypeRepositoryResponses is result Prototype.PrototypeResult
    record StoredPrototype is {
      prototypeId: PrototypeId with {
        briefly "prototypeId"
        described as {
          |The prototypeId column of the stored prototype row.
        }
      }
      info: PrototypeInfo with {
        briefly "info"
        described as {
          |The info column of the stored prototype row.
        }
      }
    } with {
      briefly "Stored prototype row"
      described as {
        |The persistence shape of prototype data as this repository stores it.
      }
    }
    schema PrototypeData is relational
      of prototypes as record StoredPrototype
        index on field StoredPrototype.prototypeId
        index on field StoredPrototype.info.projectId
 with {
      briefly "Prototype data schema"
      described as {
        |The relational schema holding prototype data for the PrototypeRepository.
      }
    }
    handler PrototypePersistence is {
      on persistBuildStatusUpdated: command PersistBuildStatusUpdated is {
        do "apply BuildStatusUpdated to the stored row"
      }
      on persistComponentReceived: command PersistComponentReceived is {
        do "apply ComponentReceived to the stored row"
      }
      on persistPrototypeRetired: command PersistPrototypeRetired is {
        do "apply PrototypeRetired to the stored row"
      }
      on persistPrototypeUpdated: command PersistPrototypeUpdated is {
        do "apply PrototypeUpdated to the stored row"
      }
      on persistTestExecuted: command PersistTestExecuted is {
        do "apply TestExecuted to the stored row"
      }
      on persistTestPlanCreated: command PersistTestPlanCreated is {
        do "apply TestPlanCreated to the stored row"
      }
      on persistBuildStarted: command PersistBuildStarted is {
        do "apply BuildStarted to the stored row"
      }
      on persistPrototypeCreated: command PersistPrototypeCreated is {
        do "apply PrototypeCreated to the stored row"
      }
      on persistPrototypeValidated: command PersistPrototypeValidated is {
        do "apply PrototypeValidated to the stored row"
      }
      on persistTestResultRecorded: command PersistTestResultRecorded is {
        do "apply TestResultRecorded to the stored row"
      }
      on query GetPrototypeStats is {
        let prototypeStatsView: type PrototypeStatsView = prompt("read the prototype stats projection")
        reply prototypeStatsView
      }
    } with {
      briefly "Persists prototype commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Prototype data persistence"
    described as {
      | The PrototypeRepository provides persistent storage for
      | prototypes, builds, and test results.
    }
  }
  // Projector for prototype analytics
  query GetPrototypeStats replies result PrototypeStatsView is {
    prototypeStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which prototype stats to retrieve.
      }
    }
  } with {
    briefly "Get prototype stats"
    described as {
      |Retrieves the prototype stats projection.
    }
  }
  result PrototypeStatsView is {
    prototypeStats: PrototypeAnalytics.PrototypeStats with {
      briefly "Prototype stats"
      described as {
        |The prototype stats being returned.
      }
    }
  } with {
    briefly "Prototype stats view"
    described as {
      |Read model view carrying the prototype stats projection.
    }
  }
  projector PrototypeAnalytics as flow is {
    updates repository PrototypeContext.PrototypeRepository
    outlet PrototypeAnalyticsToRepository is type PrototypeRepositoryCommand
    inlet PrototypeAnalyticsFromPrototype is type PrototypeEvent    record PrototypeStats is {
      projectId: ProjectId with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      totalPrototypes: Natural with {
        briefly "Prototypes"
        described as {
          |Total prototypes.
        }
      }
      totalBuilds: Natural with {
        briefly "Builds"
        described as {
          |Total builds.
        }
      }
      testPassRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Test pass rate.
        }
      }
      averageBuildTime: Duration with {
        briefly "Build time"
        described as {
          |Average build time.
        }
      }
    } with {
      briefly "Prototype statistics"
      described as {
        |Project prototype metrics.
      }
    }
    handler AnalyticsHandler is {
      on buildStatusUpdated: event Prototype.BuildStatusUpdated is {
        tell command PrototypeContext.PrototypeRepository.PersistBuildStatusUpdated(prototypeId = buildStatusUpdated.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "apply BuildStatusUpdated to the PrototypeAnalytics projection"
      }
      on componentReceived: event Prototype.ComponentReceived is {
        tell command PrototypeContext.PrototypeRepository.PersistComponentReceived(prototypeId = componentReceived.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "apply ComponentReceived to the PrototypeAnalytics projection"
      }
      on prototypeRetired: event Prototype.PrototypeRetired is {
        tell command PrototypeContext.PrototypeRepository.PersistPrototypeRetired(prototypeId = prototypeRetired.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "apply PrototypeRetired to the PrototypeAnalytics projection"
      }
      on prototypeUpdated: event Prototype.PrototypeUpdated is {
        tell command PrototypeContext.PrototypeRepository.PersistPrototypeUpdated(prototypeId = prototypeUpdated.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "apply PrototypeUpdated to the PrototypeAnalytics projection"
      }
      on testExecuted: event Prototype.TestExecuted is {
        tell command PrototypeContext.PrototypeRepository.PersistTestExecuted(prototypeId = testExecuted.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "apply TestExecuted to the PrototypeAnalytics projection"
      }
      on testPlanCreated: event Prototype.TestPlanCreated is {
        tell command PrototypeContext.PrototypeRepository.PersistTestPlanCreated(prototypeId = testPlanCreated.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "apply TestPlanCreated to the PrototypeAnalytics projection"
      }
      on prototypeCreated: event Prototype.PrototypeCreated is {
        tell command PrototypeContext.PrototypeRepository.PersistPrototypeCreated(prototypeId = prototypeCreated.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "Update prototype counts"
      }
      on buildStarted: event Prototype.BuildStarted is {
        tell command PrototypeContext.PrototypeRepository.PersistBuildStarted(prototypeId = buildStarted.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "Update build counts"
      }
      on testResultRecorded: event Prototype.TestResultRecorded is {
        tell command PrototypeContext.PrototypeRepository.PersistTestResultRecorded(prototypeId = testResultRecorded.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "Update test metrics"
      }
      on prototypeValidated: event Prototype.PrototypeValidated is {
        tell command PrototypeContext.PrototypeRepository.PersistPrototypeValidated(prototypeId = prototypeValidated.prototypeId) to repository PrototypeContext.PrototypeRepository
        do "Update validation metrics"
      }
      on testFailed: event Prototype.TestFailed is {
        do "a test failed changes nothing this projection keeps"
      }
    } with {
      briefly "Maintains prototype analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Prototype analytics projections"
    described as {
      |Maintains prototype analytics data.
    }
  }
  // ---- Event publication for Prototype ----
  type PrototypeEvent is one of {
    PrototypeContext.Prototype.PrototypeCreated or PrototypeContext.Prototype.PrototypeUpdated or PrototypeContext.Prototype.BuildStarted or PrototypeContext.Prototype.BuildStatusUpdated or PrototypeContext.Prototype.ComponentReceived or PrototypeContext.Prototype.TestPlanCreated or PrototypeContext.Prototype.TestExecuted or PrototypeContext.Prototype.TestResultRecorded or PrototypeContext.Prototype.PrototypeValidated or PrototypeContext.Prototype.PrototypeRetired or Prototype.TestFailed
  } with {
    briefly "Prototype event alternation"
    described as {
      |Union of all Prototype events, for streaming and event-sourced
      |persistence.
    }
  }
  streamlet PrototypeEventSplit as split is {
    outlet PrototypeEventSplitToToNotificationService is type PrototypeEvent
    outlet PrototypeEventSplitToToDefectTrackingService is type PrototypeEvent
    outlet PrototypeEventSplitToToTestEquipmentService is type PrototypeEvent
    outlet PrototypeEventSplitToToProcurementService is type PrototypeEvent
    inlet PrototypeEventSplitIn is type PrototypeEvent    outlet PrototypeEventSplitToPrototypeAnalytics is type PrototypeEvent
    handler PrototypeEventSplitHandler is {
      on prototypeCreated: event Prototype.PrototypeCreated is {
        send prototypeCreated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell prototypeCreated to entity PrototypeContext.Prototype
      }
      on prototypeUpdated: event Prototype.PrototypeUpdated is {
        send prototypeUpdated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell prototypeUpdated to entity PrototypeContext.Prototype
      }
      on buildStarted: event Prototype.BuildStarted is {
        send buildStarted to outlet PrototypeEventSplitToPrototypeAnalytics
        send buildStarted to outlet PrototypeEventSplitToToProcurementService
        send buildStarted to outlet PrototypeEventSplitToToNotificationService
        tell buildStarted to entity PrototypeContext.Prototype
      }
      on buildStatusUpdated: event Prototype.BuildStatusUpdated is {
        send buildStatusUpdated to outlet PrototypeEventSplitToPrototypeAnalytics
        send buildStatusUpdated to outlet PrototypeEventSplitToToNotificationService
        tell buildStatusUpdated to entity PrototypeContext.Prototype
      }
      on componentReceived: event Prototype.ComponentReceived is {
        send componentReceived to outlet PrototypeEventSplitToPrototypeAnalytics
        tell componentReceived to entity PrototypeContext.Prototype
      }
      on testPlanCreated: event Prototype.TestPlanCreated is {
        send testPlanCreated to outlet PrototypeEventSplitToPrototypeAnalytics
        send testPlanCreated to outlet PrototypeEventSplitToToTestEquipmentService
        tell testPlanCreated to entity PrototypeContext.Prototype
      }
      on testExecuted: event Prototype.TestExecuted is {
        send testExecuted to outlet PrototypeEventSplitToPrototypeAnalytics
        tell testExecuted to entity PrototypeContext.Prototype
      }
      on testResultRecorded: event Prototype.TestResultRecorded is {
        send testResultRecorded to outlet PrototypeEventSplitToPrototypeAnalytics
        tell testResultRecorded to entity PrototypeContext.Prototype
      }
      on prototypeValidated: event Prototype.PrototypeValidated is {
        send prototypeValidated to outlet PrototypeEventSplitToPrototypeAnalytics
        send prototypeValidated to outlet PrototypeEventSplitToToNotificationService
        tell prototypeValidated to entity PrototypeContext.Prototype
      }
      on prototypeRetired: event Prototype.PrototypeRetired is {
        send prototypeRetired to outlet PrototypeEventSplitToPrototypeAnalytics
        tell prototypeRetired to entity PrototypeContext.Prototype
      }
      on testFailed: event Prototype.TestFailed is {
        send testFailed to outlet PrototypeEventSplitToToDefectTrackingService
        send testFailed to outlet PrototypeEventSplitToToNotificationService
      }
      on other is {
        error "Unexpected message for processor PrototypeEventSplit"
      }
    } with {
      briefly "Prototype event fan-out handler"
      described as {
        |Delivers each Prototype event to all of its consumers.
      }
    }
  } with {
    briefly "Prototype event fan-out"
    described as {
      |Fans Prototype events out to the repository and projectors.
    }
  }
  connector 'ToTestEquipmentService Feed' is from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToToTestEquipmentService to inlet PrototypeContext.ToTestEquipmentService.ToTestEquipmentServiceIn with {
    briefly "The Prototype events ToTestEquipmentService translates, on their way to it"
  }
  connector 'ToProcurementService Feed' is from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToToProcurementService to inlet PrototypeContext.ToProcurementService.ToProcurementServiceIn with {
    briefly "The Prototype events ToProcurementService translates, on their way to it"
  }
  connector 'ToNotificationService Feed' is from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToToNotificationService to inlet PrototypeContext.ToNotificationService.ToNotificationServiceIn with {
    briefly "The Prototype events ToNotificationService translates, on their way to it"
  }
  connector 'ToDefectTrackingService Feed' is from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToToDefectTrackingService to inlet PrototypeContext.ToDefectTrackingService.ToDefectTrackingServiceIn with {
    briefly "The Prototype events ToDefectTrackingService translates, on their way to it"
  }
  connector 'PrototypeEvent Stream' is from outlet PrototypeContext.Prototype.PrototypeEvents2 to inlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitIn with {
    briefly "Prototype events, fanned out to storage and read models"
  }
  connector 'PrototypeAnalytics Feed' is from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToPrototypeAnalytics to inlet PrototypeContext.PrototypeAnalytics.PrototypeAnalyticsFromPrototype with {
    briefly "Prototype events feeding the PrototypeAnalytics projection"
  }
  connector 'PrototypeAnalytics Storage' is from outlet PrototypeContext.PrototypeAnalytics.PrototypeAnalyticsToRepository to inlet PrototypeContext.PrototypeRepository.PrototypeRepositoryFromPrototypeAnalytics with {
    briefly "PrototypeAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for prototype management"
  described as {
    | The PrototypeContext is the bounded context for prototype
    | lifecycle, build tracking, and validation testing.
  }
}
