// Prototype Management - Prototype Context
context PrototypeContext is {
  include "types.riddl"
  include "Prototype.riddl"
  // Repository for prototype persistence
  repository PrototypeRepository is {
    inlet PrototypeRepositoryFromPrototype is type PrototypeEvent
    inlet PrototypeRepositoryFromPrototypeAnalytics is type PrototypeEvent
    outlet PrototypeRepositoryResponses is type Prototype.PrototypeResult
    schema PrototypeData is relational
      of prototypes as type Prototype
        index on field Prototype.prototypeId
        index on field Prototype.info.projectId
      with {
      briefly "Prototype data schema"
      described as {
        |The relational schema holding prototype data for the PrototypeRepository.
      }
    }

    handler PrototypePersistence is {
      on command Prototype.CreatePrototype is {
        tell event Prototype.PrototypeCreated to entity PrototypeContext.Prototype
        do "Store prototype record"
      }
      on command Prototype.UpdatePrototype is {
        tell event Prototype.PrototypeUpdated to entity PrototypeContext.Prototype
        do "Update prototype info"
      }
      on command Prototype.StartBuild is {
        tell event Prototype.BuildStarted to entity PrototypeContext.Prototype
        do "Store build record"
      }
      on command Prototype.UpdateBuildStatus is {
        tell event Prototype.BuildStatusUpdated to entity PrototypeContext.Prototype
        do "Update build status"
      }
      on command Prototype.ReceiveComponent is {
        tell event Prototype.ComponentReceived to entity PrototypeContext.Prototype
        do "Update component status"
      }
      on command Prototype.CreateTestPlan is {
        tell event Prototype.TestPlanCreated to entity PrototypeContext.Prototype
        do "Store test plan"
      }
      on command Prototype.ExecuteTest is {
        do "Store test execution"
      }
      on command Prototype.RecordTestResult is {
        tell event Prototype.TestResultRecorded to entity PrototypeContext.Prototype
        do "Store test result"
      }
      on command Prototype.ValidatePrototype is {
        do "Update validation status"
      }
    } with {
      briefly "Persists prototype commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Prototype data persistence"
    described as {
      | The PrototypeRepository provides persistent storage for
      | prototypes, builds, and test results.
    }
  }
  // Projector for prototype analytics
  projector PrototypeAnalytics is {
    inlet PrototypeAnalyticsFromPrototype is type PrototypeEvent
    outlet PrototypeAnalyticsOut is type PrototypeEvent
    updates repository PrototypeContext.PrototypeRepository
    record PrototypeStats is  {
      projectId: ProjectId with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      totalPrototypes: Natural with {
        briefly "Prototypes"
        described as {
          |Total prototypes.
        }
      }
      totalBuilds: Natural with {
        briefly "Builds"
        described as {
          |Total builds.
        }
      }
      testPassRate: Decimal(5,2) with {
        briefly "Pass rate"
        described as {
          |Test pass rate.
        }
      }
      averageBuildTime: Duration with {
        briefly "Build time"
        described as {
          |Average build time.
        }
      }
    } with {
      briefly "Prototype statistics"
      described as {
        |Project prototype metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Prototype.PrototypeCreated is {
        tell event Prototype.PrototypeCreated to repository PrototypeContext.PrototypeRepository
        do "Update prototype counts"
      }
      on event Prototype.BuildStarted is {
        tell event Prototype.BuildStarted to repository PrototypeContext.PrototypeRepository
        do "Update build counts"
      }
      on event Prototype.TestResultRecorded is {
        tell event Prototype.TestResultRecorded to repository PrototypeContext.PrototypeRepository
        do "Update test metrics"
      }
      on event Prototype.PrototypeValidated is {
        tell event Prototype.PrototypeValidated to repository PrototypeContext.PrototypeRepository
        do "Update validation metrics"
      }
    } with {
      briefly "Maintains prototype analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Prototype analytics projections"
    described as {
      |Maintains prototype analytics data.
    }
  }
  // ---- Event publication for Prototype ----
  type PrototypeEvent is one of {
    PrototypeContext.Prototype.PrototypeCreated,
    PrototypeContext.Prototype.PrototypeUpdated,
    PrototypeContext.Prototype.BuildStarted,
    PrototypeContext.Prototype.BuildStatusUpdated,
    PrototypeContext.Prototype.ComponentReceived,
    PrototypeContext.Prototype.TestPlanCreated,
    PrototypeContext.Prototype.TestExecuted,
    PrototypeContext.Prototype.TestResultRecorded,
    PrototypeContext.Prototype.PrototypeValidated,
    PrototypeContext.Prototype.PrototypeRetired
  } with {
    briefly "Prototype event alternation"
    described as {
      |Union of all Prototype events, for streaming and event-sourced
      |persistence.
    }
  }
  processor PrototypeEventSource as source is {
    outlet PrototypeEvents is type PrototypeEvent
    handler PrototypeSourceHandler is {
      on event Prototype.PrototypeCreated is {
        send event Prototype.PrototypeCreated to outlet PrototypeEvents
      }
      on event Prototype.PrototypeUpdated is {
        send event Prototype.PrototypeUpdated to outlet PrototypeEvents
      }
      on event Prototype.BuildStarted is {
        send event Prototype.BuildStarted to outlet PrototypeEvents
      }
      on event Prototype.BuildStatusUpdated is {
        send event Prototype.BuildStatusUpdated to outlet PrototypeEvents
      }
      on event Prototype.ComponentReceived is {
        send event Prototype.ComponentReceived to outlet PrototypeEvents
      }
      on event Prototype.TestPlanCreated is {
        send event Prototype.TestPlanCreated to outlet PrototypeEvents
      }
      on event Prototype.TestExecuted is {
        send event Prototype.TestExecuted to outlet PrototypeEvents
      }
      on event Prototype.TestResultRecorded is {
        send event Prototype.TestResultRecorded to outlet PrototypeEvents
      }
      on event Prototype.PrototypeValidated is {
        send event Prototype.PrototypeValidated to outlet PrototypeEvents
      }
      on event Prototype.PrototypeRetired is {
        send event Prototype.PrototypeRetired to outlet PrototypeEvents
      }
      on other is {
        error "Unexpected message for source PrototypeEventSource"
      }
    } with {
      briefly "Prototype source handler"
      described as {
        |Publishes Prototype events onto the outlet.
      }
    }
  } with {
    briefly "Prototype event source"
    described as {
      |Publishes Prototype entity events into the streaming topology.
    }
  }
  processor PrototypeEventSink as sink is {
    inlet PrototypeInlet is type PrototypeEvent
    handler PrototypeSinkHandler is {
      on event Prototype.PrototypeCreated is {
        tell event Prototype.PrototypeCreated to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.PrototypeUpdated is {
        tell event Prototype.PrototypeUpdated to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.BuildStarted is {
        tell event Prototype.BuildStarted to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.BuildStatusUpdated is {
        tell event Prototype.BuildStatusUpdated to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.ComponentReceived is {
        tell event Prototype.ComponentReceived to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.TestPlanCreated is {
        tell event Prototype.TestPlanCreated to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.TestExecuted is {
        tell event Prototype.TestExecuted to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.TestResultRecorded is {
        tell event Prototype.TestResultRecorded to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.PrototypeValidated is {
        tell event Prototype.PrototypeValidated to repository PrototypeContext.PrototypeRepository
      }
      on event Prototype.PrototypeRetired is {
        tell event Prototype.PrototypeRetired to repository PrototypeContext.PrototypeRepository
      }
      on other is {
        error "Unexpected message for sink PrototypeEventSink"
      }
    } with {
      briefly "Prototype sink handler"
      described as {
        |Persists Prototype events via the repository.
      }
    }
  } with {
    briefly "Prototype event sink"
    described as {
      |Receives Prototype events for persistence.
    }
  }
  connector PrototypeEventFlow is {
    from outlet PrototypeContext.PrototypeEventSource.PrototypeEvents to
      inlet PrototypeContext.PrototypeEventSink.PrototypeInlet
  } with {
    briefly "Prototype event flow"
    described as {
      |Connects the Prototype source to its sink.
    }
  }
  processor PrototypeEventSplit is {
    inlet PrototypeEventSplitIn is type PrototypeEvent
    outlet PrototypeEventSplitToPrototypeRepository is type PrototypeEvent
    outlet PrototypeEventSplitToPrototypeAnalytics is type PrototypeEvent
    handler PrototypeEventSplitHandler is {
      on event Prototype.PrototypeCreated is {
        send event Prototype.PrototypeCreated to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.PrototypeCreated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.PrototypeCreated to entity PrototypeContext.Prototype
      }
      on event Prototype.PrototypeUpdated is {
        send event Prototype.PrototypeUpdated to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.PrototypeUpdated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.PrototypeUpdated to entity PrototypeContext.Prototype
      }
      on event Prototype.BuildStarted is {
        send event Prototype.BuildStarted to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.BuildStarted to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.BuildStarted to entity PrototypeContext.Prototype
      }
      on event Prototype.BuildStatusUpdated is {
        send event Prototype.BuildStatusUpdated to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.BuildStatusUpdated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.BuildStatusUpdated to entity PrototypeContext.Prototype
      }
      on event Prototype.ComponentReceived is {
        send event Prototype.ComponentReceived to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.ComponentReceived to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.ComponentReceived to entity PrototypeContext.Prototype
      }
      on event Prototype.TestPlanCreated is {
        send event Prototype.TestPlanCreated to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.TestPlanCreated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.TestPlanCreated to entity PrototypeContext.Prototype
      }
      on event Prototype.TestExecuted is {
        send event Prototype.TestExecuted to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.TestExecuted to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.TestExecuted to entity PrototypeContext.Prototype
      }
      on event Prototype.TestResultRecorded is {
        send event Prototype.TestResultRecorded to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.TestResultRecorded to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.TestResultRecorded to entity PrototypeContext.Prototype
      }
      on event Prototype.PrototypeValidated is {
        send event Prototype.PrototypeValidated to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.PrototypeValidated to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.PrototypeValidated to entity PrototypeContext.Prototype
      }
      on event Prototype.PrototypeRetired is {
        send event Prototype.PrototypeRetired to outlet PrototypeEventSplitToPrototypeRepository
        send event Prototype.PrototypeRetired to outlet PrototypeEventSplitToPrototypeAnalytics
        tell event Prototype.PrototypeRetired to entity PrototypeContext.Prototype
      }
      on other is {
        error "Unexpected message for processor PrototypeEventSplit"
      }
    } with {
      briefly "Prototype event fan-out handler"
      described as {
        |Delivers each Prototype event to all of its consumers.
      }
    }
  } with {
    briefly "Prototype event fan-out"
    described as {
      |Fans Prototype events out to the repository and projectors.
    }
  }
  connector LinkPrototypeToPrototypeEventSplit is {
    from outlet PrototypeContext.Prototype.PrototypeEvents2 to
      inlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitIn
  } with {
    briefly "LinkPrototypeToPrototypeEventSplit"
  }
  connector LinkPrototypeEventSplitToPrototypeRepository is {
    from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToPrototypeRepository to
      inlet PrototypeContext.PrototypeRepository.PrototypeRepositoryFromPrototype
  } with {
    briefly "LinkPrototypeEventSplitToPrototypeRepository"
  }
  connector LinkPrototypeEventSplitToPrototypeAnalytics is {
    from outlet PrototypeContext.PrototypeEventSplit.PrototypeEventSplitToPrototypeAnalytics to
      inlet PrototypeContext.PrototypeAnalytics.PrototypeAnalyticsFromPrototype
  } with {
    briefly "LinkPrototypeEventSplitToPrototypeAnalytics"
  }
  connector LinkPrototypeAnalyticsToPrototypeRepository is {
    from outlet PrototypeContext.PrototypeAnalytics.PrototypeAnalyticsOut to
      inlet PrototypeContext.PrototypeRepository.PrototypeRepositoryFromPrototypeAnalytics
  } with {
    briefly "LinkPrototypeAnalyticsToPrototypeRepository"
  }
} with {
  briefly "Bounded context for prototype management"
  described as {
    | The PrototypeContext is the bounded context for prototype
    | lifecycle, build tracking, and validation testing.
  }
}
