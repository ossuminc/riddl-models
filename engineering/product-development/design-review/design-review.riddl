// Design Review Domain Model
// Engineering design review, approval, and change management
domain DesignReview is {
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ReviewCoordinator is "person managing review processes" with {
    briefly "Review Coordinator"
    described as {
      |Person coordinating design reviews.
    }
  }
  user DesignEngineer is "engineer submitting designs for review" with {
    briefly "Design Engineer"
    described as {
      |Person creating designs for review.
    }
  }
  user Reviewer is "engineer reviewing designs" with {
    briefly "Design Reviewer"
    described as {
      |Person reviewing and approving designs.
    }
  }
  epic DesignApprovalEpic is {
    user DesignEngineer wants to "to submit designs for review" so that "changes can be validated before implementation"
    case SubmitDesignForReview is {
      user DesignEngineer wants to "to submit a design for formal review" so that "stakeholders can evaluate the proposal"
      step is "Engineer prepares" "design package" "with documentation" with {
        briefly "Prepare package"
        described as {
          |Assemble design materials.
        }
      }
      step is "Engineer selects" "review type" "based on change scope" with {
        briefly "Select type"
        described as {
          |Choose appropriate review.
        }
      }
      step take input DesignReviewApp.DesignReviewScreen.SubmitReviewInput from user DesignEngineer with {
        briefly "Submit review"
        described as {
          |Create review request.
        }
      }
      step is "System notifies" "assigned reviewers" "of pending review" with {
        briefly "Notify reviewers"
        described as {
          |Send notifications.
        }
      }
    } with {
      briefly "Design submission workflow"
      described as {
        |Standard flow for submitting designs.
      }
    }
  } with {
    briefly "Design approval processing"
    described as {
      | Epic covering design review from submission
      | through evaluation and approval.
    }
  }
  include "ReviewContext.riddl"
  include "external-contexts.riddl"
  application context DesignReviewApp as flow is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DesignReview are delivered.
      }
    }
    group DesignReviewScreen is {
      input SubmitReviewInput acquires command ReviewContext.Review.SubmitReview with {
        briefly "Submit review control"
        described as {
          |The control through which a user submits the submit review request.
        }
      }
    } with {
      briefly "Design review screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppReviewCommands is type ReviewContext.Review.ReviewCommand
    inlet AppReviewRepositoryResponses is type ReviewContext.Review.ReviewResult    handler DesignReviewAppHandler is {
      on other is {
        error "Unexpected message for application context DesignReviewApp"
      }
    } with {
      briefly "DesignReviewApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DesignReviewApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ReviewCommand Stream' is from outlet DesignReviewApp.AppReviewCommands to inlet ReviewContext.Review.ReviewCommands with {
    briefly "Review commands from the application"
  }
  persistent connector 'ReviewResult Stream' is from outlet ReviewContext.ReviewRepository.ReviewRepositoryResponses to inlet DesignReviewApp.AppReviewRepositoryResponses with {
    briefly "Review query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DesignReviewApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Design review domain"
  described as {
    | The DesignReview domain handles engineering design reviews,
    | approval workflows, and change management processes.
  }
}
