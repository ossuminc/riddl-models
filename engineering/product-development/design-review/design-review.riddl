// Design Review Domain Model
// Engineering design review, approval, and change management
domain DesignReview is {
  persistent connector 'UserDirectoryServiceReply Stream' is from outlet UserDirectoryService.UserDirectoryServiceRepliesOut to inlet ReviewContext.ToUserDirectoryService.ToUserDirectoryServiceReplies with {
    briefly "What UserDirectoryService answers ReviewContext"
  }
  persistent connector 'DocumentServiceEvent Stream' is from outlet DocumentService.DocumentServiceEventsOut to inlet ReviewContext.FromDocumentService.FromDocumentServiceIn with {
    briefly "What DocumentService tells ReviewContext, unasked"
  }
  persistent connector 'PLMServiceEvent Stream' is from outlet PLMService.PLMServiceEventsOut to inlet ReviewContext.FromPLMService.FromPLMServiceIn with {
    briefly "What PLMService tells ReviewContext, unasked"
  }
  persistent connector 'WorkflowServiceEvent Stream' is from outlet WorkflowService.WorkflowServiceEventsOut to inlet ReviewContext.FromWorkflowService.FromWorkflowServiceIn with {
    briefly "What WorkflowService tells ReviewContext, unasked"
  }
  persistent connector 'UserDirectoryServiceRequest Stream' is from outlet ReviewContext.ToUserDirectoryService.ToUserDirectoryServiceOut to inlet UserDirectoryService.UserDirectoryServiceRequests with {
    briefly "What ReviewContext asks UserDirectoryService to send"
  }
  persistent connector 'WorkflowServiceRequest Stream' is from outlet ReviewContext.ToWorkflowService.ToWorkflowServiceOut to inlet WorkflowService.WorkflowServiceRequests with {
    briefly "What ReviewContext asks WorkflowService to send"
  }
  persistent connector 'DocumentServiceRequest Stream' is from outlet ReviewContext.ToDocumentService.ToDocumentServiceOut to inlet DocumentService.DocumentServiceRequests with {
    briefly "What ReviewContext asks DocumentService to send"
  }
  persistent connector 'NotificationServiceRequest Stream' is from outlet ReviewContext.ToNotificationService.ToNotificationServiceOut to inlet NotificationService.NotificationServiceRequests with {
    briefly "What ReviewContext asks NotificationService to send"
  }
  author OssumInc is {
    name = "Ossum Inc."
    email = "support@ossuminc.com"
  } with {
    briefly "Domain author"
    described as {
      |Organization maintaining this domain model.
    }
  }
  user ReviewCoordinator is "person managing review processes" with {
    briefly "Review Coordinator"
    described as {
      |Person coordinating design reviews.
    }
  }
  user DesignEngineer is "engineer submitting designs for review" with {
    briefly "Design Engineer"
    described as {
      |Person creating designs for review.
    }
  }
  user Reviewer is "engineer reviewing designs" with {
    briefly "Design Reviewer"
    described as {
      |Person reviewing and approving designs.
    }
  }
  epic DesignApprovalEpic is {
    user DesignEngineer wants to "to submit designs for review" so that "changes can be validated before implementation"
    case SubmitDesignForReview is {
      user DesignEngineer wants to "to submit a design for formal review" so that "stakeholders can evaluate the proposal"
      step is "Engineer prepares" "design package" "with documentation" with {
        briefly "Prepare package"
        described as {
          |Assemble design materials.
        }
      }
      step is "Engineer selects" "review type" "based on change scope" with {
        briefly "Select type"
        described as {
          |Choose appropriate review.
        }
      }
      step take input DesignReviewApp.DesignReviewScreen.SubmitReviewInput from user DesignEngineer with {
        briefly "Submit review"
        described as {
          |Create review request.
        }
      }
      step is "System notifies" "assigned reviewers" "of pending review" with {
        briefly "Notify reviewers"
        described as {
          |Send notifications.
        }
      }
    } with {
      briefly "Design submission workflow"
      described as {
        |Standard flow for submitting designs.
      }
    }
  } with {
    briefly "Design approval processing"
    described as {
      | Epic covering design review from submission
      | through evaluation and approval.
    }
  }
  include "ReviewContext.riddl"
  include "external-contexts.riddl"
  application context DesignReviewApp as router is {
    inlet ErrorSink is record Riddl.GeneratorError with {
      option error-sink()
      briefly "Hard error destination"
      described as {
        |Where hard errors raised anywhere in DesignReview are delivered.
      }
    }
    group DesignReviewScreen is {
      input GetReviewStatsInput acquires query ReviewContext.GetReviewStats with {
        briefly "Get review stats control"
        described as {
          |The control through which a user asks the get review stats question.
        }
      }
      input GetReviewInput acquires query ReviewContext.Review.GetReview with {
        briefly "Get review control"
        described as {
          |The control through which a user asks the get review question.
        }
      }
      input AddCommentInput acquires command ReviewContext.Review.AddComment with {
        briefly "Add comment control"
        described as {
          |The control through which a user submits the add comment request.
        }
      }
      input CancelReviewInput acquires command ReviewContext.Review.CancelReview with {
        briefly "Cancel review control"
        described as {
          |The control through which a user submits the cancel review request.
        }
      }
      input RecordDecisionInput acquires command ReviewContext.Review.RecordDecision with {
        briefly "Record decision control"
        described as {
          |The control through which a user submits the record decision request.
        }
      }
      input RequestRevisionInput acquires command ReviewContext.Review.RequestRevision with {
        briefly "Request revision control"
        described as {
          |The control through which a user submits the request revision request.
        }
      }
      input ResolveCommentInput acquires command ReviewContext.Review.ResolveComment with {
        briefly "Resolve comment control"
        described as {
          |The control through which a user submits the resolve comment request.
        }
      }
      input RespondToCommentInput acquires command ReviewContext.Review.RespondToComment with {
        briefly "Respond to comment control"
        described as {
          |The control through which a user submits the respond to comment request.
        }
      }
      input SubmitRevisionInput acquires command ReviewContext.Review.SubmitRevision with {
        briefly "Submit revision control"
        described as {
          |The control through which a user submits the submit revision request.
        }
      }
      input SubmitReviewInput acquires command ReviewContext.SubmitReview with {
        briefly "Submit review control"
        described as {
          |The control through which a user submits the submit review request.
        }
      }
    } with {
      briefly "Design review screen"
      described as {
        |The screen through which users act on this domain.
      }
    }
    outlet AppReviewRepositoryQueries is query ReviewContext.GetReviewStats
    inlet AppReviewRepositoryReplies is result ReviewContext.ReviewStatsView
    outlet AppReviewQueries is query ReviewContext.Review.GetReview
    outlet AppReviewCommands is type ReviewContext.ReviewRequest
    inlet AppReviewRepositoryResponses is result ReviewContext.Review.ReviewResult
    handler DesignReviewAppHandler is {
      on other is {
        error "Unexpected message for application context DesignReviewApp"
      }
    } with {
      briefly "DesignReviewApp handler"
      described as {
        |Originates commands and receives query responses.
      }
    }
  } with {
    briefly "DesignReviewApp application"
    described as {
      |Placeholder for the UI-bearing application that originates
      |commands and consumes query responses.
    }
  }
  persistent connector 'ReviewRepositoryQuery Stream' is from outlet DesignReviewApp.AppReviewRepositoryQueries to inlet ReviewContext.ReviewRepositoryQueriesIn with {
    briefly "DesignReviewApp's look-ups of the review repository"
  }
  persistent connector 'ReviewRepositoryReply Stream' is from outlet ReviewContext.ReviewRepositoryRepliesOut to inlet DesignReviewApp.AppReviewRepositoryReplies with {
    briefly "The review repository's answers returned to DesignReviewApp"
  }
  persistent connector 'ReviewQuery Stream' is from outlet DesignReviewApp.AppReviewQueries to inlet ReviewContext.ReviewQueriesIn with {
    briefly "DesignReviewApp's look-ups of the review"
  }
  persistent connector 'ReviewCommand Stream' is from outlet DesignReviewApp.AppReviewCommands to inlet ReviewContext.ReviewCommandStreamIn with {
    briefly "Review commands from the application"
  }
  persistent connector 'ReviewResult Stream' is from outlet ReviewContext.ReviewResultStreamOut to inlet DesignReviewApp.AppReviewRepositoryResponses with {
    briefly "Review query results returned to the application"
  }
  connector ErrorsToSink is from outlet Riddl.ForeverEmpty.void to inlet DesignReviewApp.ErrorSink with {
    briefly "Hard errors to the domain error sink"
    described as {
      |No modelled component emits a GeneratorError; generators do, at run
      |time. ForeverEmpty states that honestly rather than inventing a
      |producer.
    }
  }
} with {
  briefly "Design review domain"
  described as {
    | The DesignReview domain handles engineering design reviews,
    | approval workflows, and change management processes.
  }
}
