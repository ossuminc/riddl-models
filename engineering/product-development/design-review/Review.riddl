// Design Review - Review Entity
entity Review as router is {
  type ReviewCommand is one of {
    Review.AssignReviewer or Review.StartReview or Review.AddComment or Review.RespondToComment or Review.ResolveComment or Review.RecordDecision or Review.RequestRevision or Review.SubmitRevision or Review.FinalizeReview or Review.CancelReview
  } with {
    briefly "Review command alternation"
    described as {
      |Commands accepted by the Review entity.
    }
  }
  inlet ReviewQueries is query GetReview with {
    briefly "Look-ups of this review"
    described as {
      |What DesignReviewApp asks of the review, by way of ReviewContext.
    }
  }
  outlet ReviewReplies is result ReviewResult
 with {
    briefly "This review's answers"
    described as {
      |What the review answers, on its way back to ReviewContext.
    }
  }
  inlet ReviewCommands is type ReviewCommand
  outlet ReviewEvents2 is type ReviewEvent
  query GetReview replies result ReviewResult is {
    reviewId: ReviewId with {
      briefly "ID"
      described as {
        |Identifier of the Review to retrieve.
      }
    }
  } with {
    briefly "Get Review"
    described as {
      |Retrieve Review data by identifier.
    }
  }
  result ReviewResult is {
    reviewId: ReviewId with {
      briefly "Review addressed"
      described as {
        |Which review this message concerns. Named directly rather
        |than left to a wrapped record, because a nested record cannot say
        |which instance is addressed.
      }
    }
    reviewData: Review.DraftStateData with {
      briefly "Review data"
      described as {
        |The requested Review data.
      }
    }
  } with {
    briefly "Review result"
    described as {
      |Result carrying the requested Review data.
    }
  }
  // Commands
  command AssignReviewer is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review identifier.
      }
    }
    assignment: ReviewerAssignment with {
      briefly "Assignment"
      described as {
        |Reviewer assignment.
      }
    }
  } with {
    briefly "Assign reviewer"
    described as {
      |Assigns a reviewer to the review.
    }
  }
  command StartReview is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review to start.
      }
    }
    startedBy: EngineerId with {
      briefly "Started by"
      described as {
        |Initiating coordinator.
      }
    }
  } with {
    briefly "Start review"
    described as {
      |Begins the review process.
    }
  }
  command AddComment is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review identifier.
      }
    }
    comment: ReviewComment with {
      briefly "Comment"
      described as {
        |Review comment.
      }
    }
  } with {
    briefly "Add comment"
    described as {
      |Adds a reviewer comment.
    }
  }
  command RespondToComment is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review identifier.
      }
    }
    commentId: UUID with {
      briefly "Comment ID"
      described as {
        |Comment to respond to.
      }
    }
    response: String(1,2000) with {
      briefly "Response"
      described as {
        |Engineer response.
      }
    }
  } with {
    briefly "Respond to comment"
    described as {
      |Responds to a review comment.
    }
  }
  command ResolveComment is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review identifier.
      }
    }
    commentId: UUID with {
      briefly "Comment ID"
      described as {
        |Comment to resolve.
      }
    }
    status: CommentStatus with {
      briefly "Status"
      described as {
        |Resolution status.
      }
    }
  } with {
    briefly "Resolve comment"
    described as {
      |Resolves a review comment.
    }
  }
  command RecordDecision is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review identifier.
      }
    }
    decision: ReviewDecision with {
      briefly "Decision"
      described as {
        |Review decision.
      }
    }
  } with {
    briefly "Record decision"
    described as {
      |Records a reviewer decision.
    }
  }
  command RequestRevision is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review identifier.
      }
    }
    requestedBy: EngineerId with {
      briefly "Requested by"
      described as {
        |Requesting reviewer.
      }
    }
    reason: String(1,2000) with {
      briefly "Reason"
      described as {
        |Revision reason.
      }
    }
  } with {
    briefly "Request revision"
    described as {
      |Requests design revision.
    }
  }
  command SubmitRevision is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review identifier.
      }
    }
    newVersion: String(1,50) with {
      briefly "Version"
      described as {
        |New design version.
      }
    }
    changes: String(1,2000) with {
      briefly "Changes"
      described as {
        |Changes made.
      }
    }
    documents: DesignDocument+ with {
      briefly "Documents"
      described as {
        |Updated documents.
      }
    }
  } with {
    briefly "Submit revision"
    described as {
      |Submits revised design.
    }
  }
  command FinalizeReview is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review to finalize.
      }
    }
    finalizedBy: EngineerId with {
      briefly "Finalized by"
      described as {
        |Finalizing coordinator.
      }
    }
    outcome: ReviewOutcome with {
      briefly "Outcome"
      described as {
        |Final outcome.
      }
    }
    summary: String(1,2000) with {
      briefly "Summary"
      described as {
        |Review summary.
      }
    }
  } with {
    briefly "Finalize review"
    described as {
      |Completes the review process.
    }
  }
  command CancelReview is {
    reviewId: ReviewId with {
      briefly "Review ID"
      described as {
        |Review to cancel.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
  } with {
    briefly "Cancel review"
    described as {
      |Cancels the design review.
    }
  }
  // Events
  event ReviewSubmitted is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    info: ReviewInfo with {
      briefly "Info"
      described as {
        |Review info.
      }
    }
    documents: DesignDocument+ with {
      briefly "Documents"
      described as {
        |Design documents.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Review was submitted"
    described as {
      |Emitted when review is submitted.
    }
  }
  event ReviewerAssigned is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    assignment: ReviewerAssignment with {
      briefly "Assignment"
      described as {
        |Reviewer assignment.
      }
    }
    assignedAt: TimeStamp with {
      briefly "Assigned"
      described as {
        |Assignment time.
      }
    }
  } with {
    briefly "Reviewer was assigned"
    described as {
      |Emitted when reviewer is assigned.
    }
  }
  event ReviewStarted is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    startedBy: EngineerId with {
      briefly "Started by"
      described as {
        |Initiator.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Review was started"
    described as {
      |Emitted when review begins.
    }
  }
  event CommentAdded is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    comment: ReviewComment with {
      briefly "Comment"
      described as {
        |New comment.
      }
    }
    addedAt: TimeStamp with {
      briefly "Added"
      described as {
        |Addition time.
      }
    }
  } with {
    briefly "Comment was added"
    described as {
      |Emitted when comment is added.
    }
  }
  event CommentResponded is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    commentId: UUID with {
      briefly "Comment"
      described as {
        |Comment ID.
      }
    }
    response: String(1,2000) with {
      briefly "Response"
      described as {
        |Response text.
      }
    }
    respondedAt: TimeStamp with {
      briefly "Responded"
      described as {
        |Response time.
      }
    }
  } with {
    briefly "Comment was responded"
    described as {
      |Emitted when comment receives response.
    }
  }
  event CommentResolved is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    commentId: UUID with {
      briefly "Comment"
      described as {
        |Comment ID.
      }
    }
    status: CommentStatus with {
      briefly "Status"
      described as {
        |Resolution status.
      }
    }
    resolvedAt: TimeStamp with {
      briefly "Resolved"
      described as {
        |Resolution time.
      }
    }
  } with {
    briefly "Comment was resolved"
    described as {
      |Emitted when comment is resolved.
    }
  }
  event DecisionRecorded is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    decision: ReviewDecision with {
      briefly "Decision"
      described as {
        |Review decision.
      }
    }
    recordedAt: TimeStamp with {
      briefly "Recorded"
      described as {
        |Record time.
      }
    }
  } with {
    briefly "Decision was recorded"
    described as {
      |Emitted when decision is made.
    }
  }
  event RevisionRequested is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    requestedBy: EngineerId with {
      briefly "Requested by"
      described as {
        |Requester.
      }
    }
    reason: String(1,2000) with {
      briefly "Reason"
      described as {
        |Revision reason.
      }
    }
    requestedAt: TimeStamp with {
      briefly "Requested"
      described as {
        |Request time.
      }
    }
  } with {
    briefly "Revision was requested"
    described as {
      |Emitted when revision is requested.
    }
  }
  event RevisionSubmitted is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    newVersion: String(1,50) with {
      briefly "Version"
      described as {
        |New version.
      }
    }
    changes: String(1,2000) with {
      briefly "Changes"
      described as {
        |Changes made.
      }
    }
    submittedAt: TimeStamp with {
      briefly "Submitted"
      described as {
        |Submission time.
      }
    }
  } with {
    briefly "Revision was submitted"
    described as {
      |Emitted when revision is submitted.
    }
  }
  event ReviewFinalized is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    outcome: ReviewOutcome with {
      briefly "Outcome"
      described as {
        |Final outcome.
      }
    }
    summary: String(1,2000) with {
      briefly "Summary"
      described as {
        |Review summary.
      }
    }
    finalizedAt: TimeStamp with {
      briefly "Finalized"
      described as {
        |Finalization time.
      }
    }
  } with {
    briefly "Review was finalized"
    described as {
      |Emitted when review is completed.
    }
  }
  event ReviewCancelled is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Review was cancelled"
    described as {
      |Emitted when review is cancelled.
    }
  }
  // State Records
  record DraftStateData is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    info: ReviewInfo with {
      briefly "Info"
      described as {
        |Review info.
      }
    }
    documents: DesignDocument+ with {
      briefly "Documents"
      described as {
        |Design documents.
      }
    }
    createdAt: TimeStamp with {
      briefly "Created"
      described as {
        |Creation time.
      }
    }
  } with {
    briefly "Draft state data"
    described as {
      |State data for draft review.
    }
  }
  record ActiveStateData is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    info: ReviewInfo with {
      briefly "Info"
      described as {
        |Review info.
      }
    }
    reviewStatus: ReviewStatus with {
      briefly "Status"
      described as {
        |Current status.
      }
    }
    documents: DesignDocument+ with {
      briefly "Documents"
      described as {
        |Design documents.
      }
    }
    reviewers: ReviewerAssignment+ with {
      briefly "Reviewers"
      described as {
        |Assigned reviewers.
      }
    }
    comments: ReviewComment+ with {
      briefly "Comments"
      described as {
        |Review comments.
      }
    }
    decisions: ReviewDecision+ with {
      briefly "Decisions"
      described as {
        |Review decisions.
      }
    }
    revisionCount: Natural with {
      briefly "Revisions"
      described as {
        |Revision count.
      }
    }
    startedAt: TimeStamp with {
      briefly "Started"
      described as {
        |Start time.
      }
    }
  } with {
    briefly "Active state data"
    described as {
      |State data for active review.
    }
  }
  record CompletedStateData is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    info: ReviewInfo with {
      briefly "Info"
      described as {
        |Review info.
      }
    }
    outcome: ReviewOutcome with {
      briefly "Outcome"
      described as {
        |Final outcome.
      }
    }
    summary: String(1,2000) with {
      briefly "Summary"
      described as {
        |Review summary.
      }
    }
    comments: ReviewComment+ with {
      briefly "Comments"
      described as {
        |Review comments.
      }
    }
    decisions: ReviewDecision+ with {
      briefly "Decisions"
      described as {
        |Review decisions.
      }
    }
    finalizedAt: TimeStamp with {
      briefly "Finalized"
      described as {
        |Finalization time.
      }
    }
  } with {
    briefly "Completed state data"
    described as {
      |State data for completed review.
    }
  }
  record CancelledStateData is {
    reviewId: ReviewId with {
      briefly "Review"
      described as {
        |Review ID.
      }
    }
    info: ReviewInfo with {
      briefly "Info"
      described as {
        |Review info.
      }
    }
    reason: String(1,500) with {
      briefly "Reason"
      described as {
        |Cancellation reason.
      }
    }
    cancelledAt: TimeStamp with {
      briefly "Cancelled"
      described as {
        |Cancellation time.
      }
    }
  } with {
    briefly "Cancelled state data"
    described as {
      |State data for cancelled review.
    }
  }
  // States
  state DraftState of record Review.DraftStateData is {
    initial handler DraftStateInitHandler is {
      on query GetReview is {
        let reviewResult: type ReviewResult = prompt("read the review from the store")
        reply reviewResult
      }
      on startReview: command StartReview is {
        morph entity ReviewContext.Review to state ReviewContext.Review.ActiveState with record Review.ActiveStateData(reviewId = startReview.reviewId, info = DraftStateData.info, reviewStatus = prompt("the review status of this active state data"), documents = DraftStateData.documents, reviewers = prompt("the reviewers of this active state data"), comments = prompt("the comments of this active state data"), decisions = prompt("the decisions of this active state data"), revisionCount = prompt("the revision count of this active state data"), startedAt = prompt("the started at of this active state data"))
        tell event ReviewStarted(reviewId = startReview.reviewId, startedBy = startReview.startedBy, startedAt = system.now) to entity ReviewContext.Review
      }
      on cancelReview: command CancelReview is {
        morph entity ReviewContext.Review to state ReviewContext.Review.CancelledState with record Review.CancelledStateData(reviewId = cancelReview.reviewId, reason = cancelReview.reason, info = DraftStateData.info, cancelledAt = prompt("the cancelled at of this cancelled state data"))
        tell event ReviewCancelled(reviewId = cancelReview.reviewId, reason = cancelReview.reason, cancelledAt = system.now) to entity ReviewContext.Review
      }
    } with {
      briefly "DraftState init handler"
      described as {
        |Initializes the DraftState state.
      }
    }
  } with {
    briefly "DraftState state"
    described as {
      |The DraftState state of the Review.
    }
  }
  state ActiveState of record Review.ActiveStateData is {
    initial handler ActiveStateHandler is {
      on finalizeReview: command FinalizeReview is {
        morph entity ReviewContext.Review to state ReviewContext.Review.CompletedState with record Review.CompletedStateData(reviewId = finalizeReview.reviewId, outcome = finalizeReview.outcome, summary = finalizeReview.summary, info = ActiveStateData.info, comments = ActiveStateData.comments, decisions = ActiveStateData.decisions, finalizedAt = prompt("the finalized at of this completed state data"))
        tell event ReviewFinalized(reviewId = finalizeReview.reviewId, outcome = finalizeReview.outcome, summary = finalizeReview.summary, finalizedAt = system.now) to entity ReviewContext.Review
      }
      on cancelReview: command CancelReview is {
        morph entity ReviewContext.Review to state ReviewContext.Review.CancelledState with record Review.CancelledStateData(reviewId = cancelReview.reviewId, reason = cancelReview.reason, info = ActiveStateData.info, cancelledAt = prompt("the cancelled at of this cancelled state data"))
        tell event ReviewCancelled(reviewId = cancelReview.reviewId, reason = cancelReview.reason, cancelledAt = system.now) to entity ReviewContext.Review
      }
    } with {
      briefly "While ActiveState"
      described as {
        |The commands and folds accepted while the entity is in ActiveState.
      }
    }
  } with {
    briefly "ActiveState state"
    described as {
      |The ActiveState state of the Review.
    }
  }
  state CompletedState of record Review.CompletedStateData with {
    briefly "CompletedState state"
    described as {
      |The CompletedState state of the Review.
    }
  }
  state CancelledState of record Review.CancelledStateData with {
    briefly "CancelledState state"
    described as {
      |The CancelledState state of the Review.
    }
  }
  // Handler
  handler ReviewHandler is {
    on init(info: type ReviewInfo, documents: type DesignDocument+) is {
      morph entity ReviewContext.Review to state ReviewContext.Review.DraftState with record Review.DraftStateData(reviewId = self.id, info = info, documents = documents, createdAt = prompt("the created at of this draft state data"))
      tell event ReviewSubmitted(reviewId = self.id, info = info, documents = documents, submittedAt = prompt("the submitted at of this review submitted")) to entity ReviewContext.Review
    }
    on assignReviewer: command AssignReviewer is {
      tell event ReviewerAssigned(reviewId = assignReviewer.reviewId, assignment = assignReviewer.assignment, assignedAt = system.now) to entity ReviewContext.Review
    }
    on addComment: command AddComment is {
      tell event CommentAdded(reviewId = addComment.reviewId, comment = addComment.comment, addedAt = system.now) to entity ReviewContext.Review
    }
    on respondToComment: command RespondToComment is {
      tell event CommentResponded(reviewId = respondToComment.reviewId, commentId = respondToComment.commentId, response = respondToComment.response, respondedAt = system.now) to entity ReviewContext.Review
    }
    on resolveComment: command ResolveComment is {
      tell event CommentResolved(reviewId = resolveComment.reviewId, commentId = resolveComment.commentId, status = resolveComment.status, resolvedAt = system.now) to entity ReviewContext.Review
    }
    on recordDecision: command RecordDecision is {
      tell event DecisionRecorded(reviewId = recordDecision.reviewId, decision = recordDecision.decision, recordedAt = system.now) to entity ReviewContext.Review
    }
    on requestRevision: command RequestRevision is {
      tell event RevisionRequested(reviewId = requestRevision.reviewId, requestedBy = requestRevision.requestedBy, reason = requestRevision.reason, requestedAt = system.now) to entity ReviewContext.Review
    }
    on submitRevision: command SubmitRevision is {
      tell event RevisionSubmitted(reviewId = submitRevision.reviewId, newVersion = submitRevision.newVersion, changes = submitRevision.changes, submittedAt = system.now) to entity ReviewContext.Review
    }
    on commentAdded: event CommentAdded is {
      do "apply CommentAdded to the review so it can be persisted and replayed"
    }
    on commentResolved: event CommentResolved is {
      do "apply CommentResolved to the review so it can be persisted and replayed"
    }
    on commentResponded: event CommentResponded is {
      do "apply CommentResponded to the review so it can be persisted and replayed"
    }
    on decisionRecorded: event DecisionRecorded is {
      do "apply DecisionRecorded to the review so it can be persisted and replayed"
    }
    on reviewCancelled: event ReviewCancelled is {
      do "apply ReviewCancelled to the review so it can be persisted and replayed"
    }
    on reviewFinalized: event ReviewFinalized is {
      do "apply ReviewFinalized to the review so it can be persisted and replayed"
    }
    on reviewStarted: event ReviewStarted is {
      do "apply ReviewStarted to the review so it can be persisted and replayed"
    }
    on reviewSubmitted: event ReviewSubmitted is {
      do "apply ReviewSubmitted to the review so it can be persisted and replayed"
    }
    on reviewerAssigned: event ReviewerAssigned is {
      do "apply ReviewerAssigned to the review so it can be persisted and replayed"
    }
    on revisionRequested: event RevisionRequested is {
      do "apply RevisionRequested to the review so it can be persisted and replayed"
    }
    on revisionSubmitted: event RevisionSubmitted is {
      do "apply RevisionSubmitted to the review so it can be persisted and replayed"
    }
  } with {
    briefly "Processes review commands"
    described as {
      | Handles design review lifecycle including comments,
      | decisions, revisions, and finalization.
    }
  }
} with {
  briefly "Design review aggregate"
  described as {
    | The Review entity manages design review processes
    | including reviewer assignments, comments, and approvals.
  }
}
