// Design Review - Review Context
context ReviewContext is {
  adaptor FromDocumentService from context DocumentService is { 
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentUploaded is {
        do "the model receives document uploaded"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is { 
    handler ToDocumentServiceHandler is {
      on command DocumentService.UploadDocument is {
        do "the model sends upload document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendReviewNotification is {
        do "the model sends send review notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPLMService from context PLMService is { 
    handler FromPLMServiceHandler is {
      on event PLMService.DesignReleased is {
        do "the model receives design released"
      }
      on event PLMService.DesignUpdated is {
        do "the model receives design updated"
      }
      on other is {
        error "Unexpected message for adaptor FromPLMService"
      }
    } with {
      briefly "from plm service"
      described as {
        |Carries messages from the external PLMService.
      }
    }
  } with {
    briefly "PLMService integration"
    described as {
      |The model's side of the PLMService conversation.
    }
  }
  adaptor FromUserDirectoryService from context UserDirectoryService is { 
    handler FromUserDirectoryServiceHandler is {
      on result UserDirectoryService.ReviewerList is {
        do "the model receives reviewer list"
      }
      on other is {
        error "Unexpected message for adaptor FromUserDirectoryService"
      }
    } with {
      briefly "from user directory service"
      described as {
        |Carries messages from the external UserDirectoryService.
      }
    }
  } with {
    briefly "UserDirectoryService integration"
    described as {
      |The model's side of the UserDirectoryService conversation.
    }
  }
  adaptor ToUserDirectoryService to context UserDirectoryService is { 
    handler ToUserDirectoryServiceHandler is {
      on query UserDirectoryService.GetReviewers is {
        do "the model sends get reviewers"
      }
      on other is {
        error "Unexpected message for adaptor ToUserDirectoryService"
      }
    } with {
      briefly "to user directory service"
      described as {
        |Carries messages to the external UserDirectoryService.
      }
    }
  } with {
    briefly "UserDirectoryService integration"
    described as {
      |The model's side of the UserDirectoryService conversation.
    }
  }
  adaptor FromWorkflowService from context WorkflowService is { 
    handler FromWorkflowServiceHandler is {
      on event WorkflowService.WorkflowCompleted is {
        do "the model receives workflow completed"
      }
      on other is {
        error "Unexpected message for adaptor FromWorkflowService"
      }
    } with {
      briefly "from workflow service"
      described as {
        |Carries messages from the external WorkflowService.
      }
    }
  } with {
    briefly "WorkflowService integration"
    described as {
      |The model's side of the WorkflowService conversation.
    }
  }
  adaptor ToWorkflowService to context WorkflowService is { 
    handler ToWorkflowServiceHandler is {
      on command WorkflowService.TriggerApprovalWorkflow is {
        do "the model sends trigger approval workflow"
      }
      on other is {
        error "Unexpected message for adaptor ToWorkflowService"
      }
    } with {
      briefly "to workflow service"
      described as {
        |Carries messages to the external WorkflowService.
      }
    }
  } with {
    briefly "WorkflowService integration"
    described as {
      |The model's side of the WorkflowService conversation.
    }
  }
  include "types.riddl"
  include "Review.riddl"
  // Repository for review persistence
  repository ReviewRepository is {
    inlet ReviewRepositoryFromReview is type ReviewEvent    inlet ReviewRepositoryFromReviewAnalytics is type ReviewEvent    outlet ReviewRepositoryResponses is type Review.ReviewResult
    record StoredReview is  {
      reviewId: ReviewId with {
        briefly "reviewId"
        described as {
          |The reviewId column of the stored review row.
        }
      }
      info: ReviewInfo with {
        briefly "info"
        described as {
          |The info column of the stored review row.
        }
      }
    } with {
      briefly "Stored review row"
      described as {
        |The persistence shape of review data as this repository stores it.
      }
    }
    schema ReviewData is relational
      of reviews as type StoredReview
        index on field StoredReview.reviewId
        index on field StoredReview.info.projectId
 with {
      briefly "Review data schema"
      described as {
        |The relational schema holding review data for the ReviewRepository.
      }
    }
    handler ReviewPersistence is {
      on query GetReviewStats is {
        do "read the review stats projection"
        yield result ReviewStatsView
      }
      on command Review.SubmitReview is {
        tell event Review.ReviewSubmitted to entity ReviewContext.Review
        do "Store review record"
      }
      on command Review.AssignReviewer is {
        tell event Review.ReviewerAssigned to entity ReviewContext.Review
        do "Store reviewer assignment"
      }
      on command Review.StartReview is {
        tell event Review.ReviewStarted to entity ReviewContext.Review
        do "Update review status to active"
      }
      on command Review.AddComment is {
        tell event Review.CommentAdded to entity ReviewContext.Review
        do "Store review comment"
      }
      on command Review.RespondToComment is {
        do "Update comment with response"
      }
      on command Review.ResolveComment is {
        do "Update comment status"
      }
      on command Review.RecordDecision is {
        tell event Review.DecisionRecorded to entity ReviewContext.Review
        do "Store review decision"
      }
      on command Review.RequestRevision is {
        do "Update review status to needs revision"
      }
      on command Review.SubmitRevision is {
        tell event Review.RevisionSubmitted to entity ReviewContext.Review
        do "Store revision details"
      }
      on command Review.FinalizeReview is {
        tell event Review.ReviewFinalized to entity ReviewContext.Review
        do "Update review to completed"
      }
      on command Review.CancelReview is {
        tell event Review.ReviewCancelled to entity ReviewContext.Review
        do "Update review to cancelled"
      }
    } with {
      briefly "Persists review commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Review data persistence"
    described as {
      | The ReviewRepository provides persistent storage for
      | design reviews, comments, and decisions.
    }
  }
  // Projector for review analytics
  query GetReviewStats is  {
    reviewStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which review stats to retrieve.
      }
    }
  } with {
    briefly "Get review stats"
    described as {
      |Retrieves the review stats projection.
    }
  }
  result ReviewStatsView is  {
    reviewStats: ReviewAnalytics.ReviewStats with {
      briefly "Review stats"
      described as {
        |The review stats being returned.
      }
    }
  } with {
    briefly "Review stats view"
    described as {
      |Read model view carrying the review stats projection.
    }
  }
  projector ReviewAnalytics is {
    updates repository ReviewContext.ReviewRepository
    inlet ReviewAnalyticsFromReview is type ReviewEvent    outlet ReviewAnalyticsOut is type ReviewEvent
    record ReviewStats is  {
      projectId: ProjectId with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      totalReviews: Natural with {
        briefly "Reviews"
        described as {
          |Total reviews.
        }
      }
      pendingReviews: Natural with {
        briefly "Pending"
        described as {
          |Pending reviews.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval rate"
        described as {
          |Approval percentage.
        }
      }
      averageReviewTime: Duration with {
        briefly "Review time"
        described as {
          |Average review duration.
        }
      }
      averageComments: Decimal(5,2) with {
        briefly "Comments"
        described as {
          |Average comments per review.
        }
      }
    } with {
      briefly "Review statistics"
      described as {
        |Project review metrics.
      }
    }
    handler AnalyticsHandler is {
      on event Review.ReviewSubmitted is {
        tell event Review.ReviewSubmitted to repository ReviewContext.ReviewRepository
        do "Update review counts"
      }
      on event Review.ReviewStarted is {
        tell event Review.ReviewStarted to repository ReviewContext.ReviewRepository
        do "Update active review metrics"
      }
      on event Review.CommentAdded is {
        tell event Review.CommentAdded to repository ReviewContext.ReviewRepository
        do "Update comment metrics"
      }
      on event Review.ReviewFinalized is {
        tell event Review.ReviewFinalized to repository ReviewContext.ReviewRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains review analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Review analytics projections"
    described as {
      |Maintains design review analytics data.
    }
  }
  // ---- Event publication for Review ----
  type ReviewEvent is one of {
    ReviewContext.Review.ReviewSubmitted or ReviewContext.Review.ReviewerAssigned or ReviewContext.Review.ReviewStarted or ReviewContext.Review.CommentAdded or ReviewContext.Review.CommentResponded or ReviewContext.Review.CommentResolved or ReviewContext.Review.DecisionRecorded or ReviewContext.Review.RevisionRequested or ReviewContext.Review.RevisionSubmitted or ReviewContext.Review.ReviewFinalized or ReviewContext.Review.ReviewCancelled
  } with {
    briefly "Review event alternation"
    described as {
      |Union of all Review events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReviewEventSource as source is {
    outlet ReviewEvents is type ReviewEvent
    handler ReviewSourceHandler is {
      on event Review.ReviewSubmitted is {
        send event Review.ReviewSubmitted to outlet ReviewEvents
      }
      on event Review.ReviewerAssigned is {
        send event Review.ReviewerAssigned to outlet ReviewEvents
      }
      on event Review.ReviewStarted is {
        send event Review.ReviewStarted to outlet ReviewEvents
      }
      on event Review.CommentAdded is {
        send event Review.CommentAdded to outlet ReviewEvents
      }
      on event Review.CommentResponded is {
        send event Review.CommentResponded to outlet ReviewEvents
      }
      on event Review.CommentResolved is {
        send event Review.CommentResolved to outlet ReviewEvents
      }
      on event Review.DecisionRecorded is {
        send event Review.DecisionRecorded to outlet ReviewEvents
      }
      on event Review.RevisionRequested is {
        send event Review.RevisionRequested to outlet ReviewEvents
      }
      on event Review.RevisionSubmitted is {
        send event Review.RevisionSubmitted to outlet ReviewEvents
      }
      on event Review.ReviewFinalized is {
        send event Review.ReviewFinalized to outlet ReviewEvents
      }
      on event Review.ReviewCancelled is {
        send event Review.ReviewCancelled to outlet ReviewEvents
      }
      on other is {
        error "Unexpected message for source ReviewEventSource"
      }
    } with {
      briefly "Review source handler"
      described as {
        |Publishes Review events onto the outlet.
      }
    }
  } with {
    briefly "Review event source"
    described as {
      |Publishes Review entity events into the streaming topology.
    }
  }
  processor ReviewEventSink as sink is {
    inlet ReviewInlet is type ReviewEvent    handler ReviewSinkHandler is {
      on event Review.ReviewSubmitted is {
        tell event Review.ReviewSubmitted to repository ReviewContext.ReviewRepository
      }
      on event Review.ReviewerAssigned is {
        tell event Review.ReviewerAssigned to repository ReviewContext.ReviewRepository
      }
      on event Review.ReviewStarted is {
        tell event Review.ReviewStarted to repository ReviewContext.ReviewRepository
      }
      on event Review.CommentAdded is {
        tell event Review.CommentAdded to repository ReviewContext.ReviewRepository
      }
      on event Review.CommentResponded is {
        tell event Review.CommentResponded to repository ReviewContext.ReviewRepository
      }
      on event Review.CommentResolved is {
        tell event Review.CommentResolved to repository ReviewContext.ReviewRepository
      }
      on event Review.DecisionRecorded is {
        tell event Review.DecisionRecorded to repository ReviewContext.ReviewRepository
      }
      on event Review.RevisionRequested is {
        tell event Review.RevisionRequested to repository ReviewContext.ReviewRepository
      }
      on event Review.RevisionSubmitted is {
        tell event Review.RevisionSubmitted to repository ReviewContext.ReviewRepository
      }
      on event Review.ReviewFinalized is {
        tell event Review.ReviewFinalized to repository ReviewContext.ReviewRepository
      }
      on event Review.ReviewCancelled is {
        tell event Review.ReviewCancelled to repository ReviewContext.ReviewRepository
      }
      on other is {
        error "Unexpected message for sink ReviewEventSink"
      }
    } with {
      briefly "Review sink handler"
      described as {
        |Persists Review events via the repository.
      }
    }
  } with {
    briefly "Review event sink"
    described as {
      |Receives Review events for persistence.
    }
  }
  connector ReviewEventFlow is from outlet ReviewContext.ReviewEventSource.ReviewEvents to inlet ReviewContext.ReviewEventSink.ReviewInlet with {
    briefly "Review event flow"
    described as {
      |Connects the Review source to its sink.
    }
  }
  processor ReviewEventSplit is {
    inlet ReviewEventSplitIn is type ReviewEvent    outlet ReviewEventSplitToReviewRepository is type ReviewEvent
    outlet ReviewEventSplitToReviewAnalytics is type ReviewEvent
    handler ReviewEventSplitHandler is {
      on event Review.ReviewSubmitted is {
        send event Review.ReviewSubmitted to outlet ReviewEventSplitToReviewRepository
        send event Review.ReviewSubmitted to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.ReviewSubmitted to entity ReviewContext.Review
      }
      on event Review.ReviewerAssigned is {
        send event Review.ReviewerAssigned to outlet ReviewEventSplitToReviewRepository
        send event Review.ReviewerAssigned to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.ReviewerAssigned to entity ReviewContext.Review
      }
      on event Review.ReviewStarted is {
        send event Review.ReviewStarted to outlet ReviewEventSplitToReviewRepository
        send event Review.ReviewStarted to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.ReviewStarted to entity ReviewContext.Review
      }
      on event Review.CommentAdded is {
        send event Review.CommentAdded to outlet ReviewEventSplitToReviewRepository
        send event Review.CommentAdded to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.CommentAdded to entity ReviewContext.Review
      }
      on event Review.CommentResponded is {
        send event Review.CommentResponded to outlet ReviewEventSplitToReviewRepository
        send event Review.CommentResponded to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.CommentResponded to entity ReviewContext.Review
      }
      on event Review.CommentResolved is {
        send event Review.CommentResolved to outlet ReviewEventSplitToReviewRepository
        send event Review.CommentResolved to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.CommentResolved to entity ReviewContext.Review
      }
      on event Review.DecisionRecorded is {
        send event Review.DecisionRecorded to outlet ReviewEventSplitToReviewRepository
        send event Review.DecisionRecorded to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.DecisionRecorded to entity ReviewContext.Review
      }
      on event Review.RevisionRequested is {
        send event Review.RevisionRequested to outlet ReviewEventSplitToReviewRepository
        send event Review.RevisionRequested to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.RevisionRequested to entity ReviewContext.Review
      }
      on event Review.RevisionSubmitted is {
        send event Review.RevisionSubmitted to outlet ReviewEventSplitToReviewRepository
        send event Review.RevisionSubmitted to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.RevisionSubmitted to entity ReviewContext.Review
      }
      on event Review.ReviewFinalized is {
        send event Review.ReviewFinalized to outlet ReviewEventSplitToReviewRepository
        send event Review.ReviewFinalized to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.ReviewFinalized to entity ReviewContext.Review
      }
      on event Review.ReviewCancelled is {
        send event Review.ReviewCancelled to outlet ReviewEventSplitToReviewRepository
        send event Review.ReviewCancelled to outlet ReviewEventSplitToReviewAnalytics
        tell event Review.ReviewCancelled to entity ReviewContext.Review
      }
      on other is {
        error "Unexpected message for processor ReviewEventSplit"
      }
    } with {
      briefly "Review event fan-out handler"
      described as {
        |Delivers each Review event to all of its consumers.
      }
    }
  } with {
    briefly "Review event fan-out"
    described as {
      |Fans Review events out to the repository and projectors.
    }
  }
  connector 'ReviewEvent Stream' is from outlet ReviewContext.Review.ReviewEvents2 to inlet ReviewContext.ReviewEventSplit.ReviewEventSplitIn with {
    briefly "Review events, fanned out to storage and read models"
  }
  connector 'ReviewEvent Storage' is from outlet ReviewContext.ReviewEventSplit.ReviewEventSplitToReviewRepository to inlet ReviewContext.ReviewRepository.ReviewRepositoryFromReview with {
    briefly "Review events on their way to storage"
  }
  connector 'ReviewAnalytics Feed' is from outlet ReviewContext.ReviewEventSplit.ReviewEventSplitToReviewAnalytics to inlet ReviewContext.ReviewAnalytics.ReviewAnalyticsFromReview with {
    briefly "Review events feeding the ReviewAnalytics projection"
  }
  connector 'ReviewAnalytics Storage' is from outlet ReviewContext.ReviewAnalytics.ReviewAnalyticsOut to inlet ReviewContext.ReviewRepository.ReviewRepositoryFromReviewAnalytics with {
    briefly "The ReviewAnalytics projection on its way to storage"
  }
} with {
  briefly "Bounded context for design reviews"
  described as {
    | The ReviewContext is the bounded context for design
    | review management, approval workflows, and tracking.
  }
}
