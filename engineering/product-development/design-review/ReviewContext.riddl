// Design Review - Review Context
context ReviewContext as router is {
  inlet ReviewCommandStreamIn is type ReviewCommand  outlet ReviewCommandStreamOut is type ReviewCommand
  inlet ReviewResultStreamIn is type Review.ReviewResult  outlet ReviewResultStreamOut is type Review.ReviewResult
  handler ReviewContextBoundary is {
    on submitReview: command Review.SubmitReview is {
      send submitReview to outlet ReviewContext.ReviewCommandStreamOut
    }
    on assignReviewer: command Review.AssignReviewer is {
      send assignReviewer to outlet ReviewContext.ReviewCommandStreamOut
    }
    on startReview: command Review.StartReview is {
      send startReview to outlet ReviewContext.ReviewCommandStreamOut
    }
    on addComment: command Review.AddComment is {
      send addComment to outlet ReviewContext.ReviewCommandStreamOut
    }
    on respondToComment: command Review.RespondToComment is {
      send respondToComment to outlet ReviewContext.ReviewCommandStreamOut
    }
    on resolveComment: command Review.ResolveComment is {
      send resolveComment to outlet ReviewContext.ReviewCommandStreamOut
    }
    on recordDecision: command Review.RecordDecision is {
      send recordDecision to outlet ReviewContext.ReviewCommandStreamOut
    }
    on requestRevision: command Review.RequestRevision is {
      send requestRevision to outlet ReviewContext.ReviewCommandStreamOut
    }
    on submitRevision: command Review.SubmitRevision is {
      send submitRevision to outlet ReviewContext.ReviewCommandStreamOut
    }
    on finalizeReview: command Review.FinalizeReview is {
      send finalizeReview to outlet ReviewContext.ReviewCommandStreamOut
    }
    on cancelReview: command Review.CancelReview is {
      send cancelReview to outlet ReviewContext.ReviewCommandStreamOut
    }
    on reviewResult: result Review.ReviewResult is {
      send reviewResult to outlet ReviewContext.ReviewResultStreamOut
    }
    on other is {
      error "Unexpected message at the ReviewContext boundary"
    }
  } with {
    briefly "Context boundary relay"
    described as {
      |The context is the port at its own boundary: peers connect here, never
      |to a definition inside. Inbound messages are relayed to the definition
      |that owns them; outbound ones are republished from here.
    }
  }
  connector 'ReviewCommand Stream Intake' is from outlet ReviewContext.ReviewCommandStreamOut to inlet ReviewContext.Review.ReviewCommands  connector 'ReviewResult Stream Egress' is from outlet ReviewContext.ReviewRepository.ReviewRepositoryResponses to inlet ReviewContext.ReviewResultStreamIn  adaptor FromDocumentService from context DocumentService is { 
    handler FromDocumentServiceHandler is {
      on event DocumentService.DocumentUploaded is {
        do "the model receives document uploaded"
      }
      on other is {
        error "Unexpected message for adaptor FromDocumentService"
      }
    } with {
      briefly "from document service"
      described as {
        |Carries messages from the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor ToDocumentService to context DocumentService is { 
    handler ToDocumentServiceHandler is {
      on command DocumentService.UploadDocument is {
        do "the model sends upload document"
      }
      on other is {
        error "Unexpected message for adaptor ToDocumentService"
      }
    } with {
      briefly "to document service"
      described as {
        |Carries messages to the external DocumentService.
      }
    }
  } with {
    briefly "DocumentService integration"
    described as {
      |The model's side of the DocumentService conversation.
    }
  }
  adaptor FromNotificationService from context NotificationService is { 
    handler FromNotificationServiceHandler is {
      on event NotificationService.NotificationSent is {
        do "the model receives notification sent"
      }
      on other is {
        error "Unexpected message for adaptor FromNotificationService"
      }
    } with {
      briefly "from notification service"
      described as {
        |Carries messages from the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor ToNotificationService to context NotificationService is { 
    handler ToNotificationServiceHandler is {
      on command NotificationService.SendReviewNotification is {
        do "the model sends send review notification"
      }
      on other is {
        error "Unexpected message for adaptor ToNotificationService"
      }
    } with {
      briefly "to notification service"
      described as {
        |Carries messages to the external NotificationService.
      }
    }
  } with {
    briefly "NotificationService integration"
    described as {
      |The model's side of the NotificationService conversation.
    }
  }
  adaptor FromPLMService from context PLMService is { 
    handler FromPLMServiceHandler is {
      on event PLMService.DesignReleased is {
        do "the model receives design released"
      }
      on event PLMService.DesignUpdated is {
        do "the model receives design updated"
      }
      on other is {
        error "Unexpected message for adaptor FromPLMService"
      }
    } with {
      briefly "from plm service"
      described as {
        |Carries messages from the external PLMService.
      }
    }
  } with {
    briefly "PLMService integration"
    described as {
      |The model's side of the PLMService conversation.
    }
  }
  adaptor FromUserDirectoryService from context UserDirectoryService is { 
    handler FromUserDirectoryServiceHandler is {
      on result UserDirectoryService.ReviewerList is {
        do "the model receives reviewer list"
      }
      on other is {
        error "Unexpected message for adaptor FromUserDirectoryService"
      }
    } with {
      briefly "from user directory service"
      described as {
        |Carries messages from the external UserDirectoryService.
      }
    }
  } with {
    briefly "UserDirectoryService integration"
    described as {
      |The model's side of the UserDirectoryService conversation.
    }
  }
  adaptor ToUserDirectoryService to context UserDirectoryService is { 
    handler ToUserDirectoryServiceHandler is {
      on query UserDirectoryService.GetReviewers is {
        do "the model sends get reviewers"
      }
      on other is {
        error "Unexpected message for adaptor ToUserDirectoryService"
      }
    } with {
      briefly "to user directory service"
      described as {
        |Carries messages to the external UserDirectoryService.
      }
    }
  } with {
    briefly "UserDirectoryService integration"
    described as {
      |The model's side of the UserDirectoryService conversation.
    }
  }
  adaptor FromWorkflowService from context WorkflowService is { 
    handler FromWorkflowServiceHandler is {
      on event WorkflowService.WorkflowCompleted is {
        do "the model receives workflow completed"
      }
      on other is {
        error "Unexpected message for adaptor FromWorkflowService"
      }
    } with {
      briefly "from workflow service"
      described as {
        |Carries messages from the external WorkflowService.
      }
    }
  } with {
    briefly "WorkflowService integration"
    described as {
      |The model's side of the WorkflowService conversation.
    }
  }
  adaptor ToWorkflowService to context WorkflowService is { 
    handler ToWorkflowServiceHandler is {
      on command WorkflowService.TriggerApprovalWorkflow is {
        do "the model sends trigger approval workflow"
      }
      on other is {
        error "Unexpected message for adaptor ToWorkflowService"
      }
    } with {
      briefly "to workflow service"
      described as {
        |Carries messages to the external WorkflowService.
      }
    }
  } with {
    briefly "WorkflowService integration"
    described as {
      |The model's side of the WorkflowService conversation.
    }
  }
  include "types.riddl"
  include "Review.riddl"
  // Repository for review persistence
  type ReviewRepositoryCommand is one of {
    ReviewContext.ReviewRepository.PersistCommentAdded or ReviewContext.ReviewRepository.PersistCommentResolved or ReviewContext.ReviewRepository.PersistCommentResponded or ReviewContext.ReviewRepository.PersistDecisionRecorded or ReviewContext.ReviewRepository.PersistReviewCancelled or ReviewContext.ReviewRepository.PersistReviewFinalized or ReviewContext.ReviewRepository.PersistReviewStarted or ReviewContext.ReviewRepository.PersistReviewSubmitted or ReviewContext.ReviewRepository.PersistReviewerAssigned or ReviewContext.ReviewRepository.PersistRevisionRequested or ReviewContext.ReviewRepository.PersistRevisionSubmitted
  } with {
    briefly "Anything that writes ReviewRepository"
    described as {
      |The persistence commands ReviewRepository accepts. Entity events never
      |reach it directly; a projector turns each into one of these.
    }
  }
  repository ReviewRepository as flow is {
    inlet ReviewRepositoryFromReviewAnalytics is type ReviewRepositoryCommand
    command PersistCommentResolved is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentResolved applies to.
        }
      }
    } with {
      briefly "Persist CommentResolved"
      described as {
        |Instructs this repository to apply CommentResolved to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommentResponded is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentResponded applies to.
        }
      }
    } with {
      briefly "Persist CommentResponded"
      described as {
        |Instructs this repository to apply CommentResponded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistDecisionRecorded is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row DecisionRecorded applies to.
        }
      }
    } with {
      briefly "Persist DecisionRecorded"
      described as {
        |Instructs this repository to apply DecisionRecorded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewCancelled is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewCancelled applies to.
        }
      }
    } with {
      briefly "Persist ReviewCancelled"
      described as {
        |Instructs this repository to apply ReviewCancelled to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewerAssigned is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewerAssigned applies to.
        }
      }
    } with {
      briefly "Persist ReviewerAssigned"
      described as {
        |Instructs this repository to apply ReviewerAssigned to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRevisionRequested is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row RevisionRequested applies to.
        }
      }
    } with {
      briefly "Persist RevisionRequested"
      described as {
        |Instructs this repository to apply RevisionRequested to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistRevisionSubmitted is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row RevisionSubmitted applies to.
        }
      }
    } with {
      briefly "Persist RevisionSubmitted"
      described as {
        |Instructs this repository to apply RevisionSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistCommentAdded is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row CommentAdded applies to.
        }
      }
    } with {
      briefly "Persist CommentAdded"
      described as {
        |Instructs this repository to apply CommentAdded to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewFinalized is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewFinalized applies to.
        }
      }
    } with {
      briefly "Persist ReviewFinalized"
      described as {
        |Instructs this repository to apply ReviewFinalized to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewStarted is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewStarted applies to.
        }
      }
    } with {
      briefly "Persist ReviewStarted"
      described as {
        |Instructs this repository to apply ReviewStarted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    command PersistReviewSubmitted is  {
      reviewId: ReviewId with {
        briefly "Row addressed"
        described as {
          |Which stored row ReviewSubmitted applies to.
        }
      }
    } with {
      briefly "Persist ReviewSubmitted"
      described as {
        |Instructs this repository to apply ReviewSubmitted to the stored row. A
        |persistence command, not a domain command: it declares no `yields`
        |because storing a row records no new entity state.
      }
    }
    outlet ReviewRepositoryResponses is type Review.ReviewResult
    record StoredReview is  {
      reviewId: ReviewId with {
        briefly "reviewId"
        described as {
          |The reviewId column of the stored review row.
        }
      }
      info: ReviewInfo with {
        briefly "info"
        described as {
          |The info column of the stored review row.
        }
      }
    } with {
      briefly "Stored review row"
      described as {
        |The persistence shape of review data as this repository stores it.
      }
    }
    schema ReviewData is relational
      of reviews as type StoredReview
        index on field StoredReview.reviewId
        index on field StoredReview.info.projectId
 with {
      briefly "Review data schema"
      described as {
        |The relational schema holding review data for the ReviewRepository.
      }
    }
    handler ReviewPersistence is {
      on persistCommentResolved: command PersistCommentResolved is {
        do "apply CommentResolved to the stored row"
      }
      on persistCommentResponded: command PersistCommentResponded is {
        do "apply CommentResponded to the stored row"
      }
      on persistDecisionRecorded: command PersistDecisionRecorded is {
        do "apply DecisionRecorded to the stored row"
      }
      on persistReviewCancelled: command PersistReviewCancelled is {
        do "apply ReviewCancelled to the stored row"
      }
      on persistReviewerAssigned: command PersistReviewerAssigned is {
        do "apply ReviewerAssigned to the stored row"
      }
      on persistRevisionRequested: command PersistRevisionRequested is {
        do "apply RevisionRequested to the stored row"
      }
      on persistRevisionSubmitted: command PersistRevisionSubmitted is {
        do "apply RevisionSubmitted to the stored row"
      }
      on persistCommentAdded: command PersistCommentAdded is {
        do "apply CommentAdded to the stored row"
      }
      on persistReviewFinalized: command PersistReviewFinalized is {
        do "apply ReviewFinalized to the stored row"
      }
      on persistReviewStarted: command PersistReviewStarted is {
        do "apply ReviewStarted to the stored row"
      }
      on persistReviewSubmitted: command PersistReviewSubmitted is {
        do "apply ReviewSubmitted to the stored row"
      }
      on query GetReviewStats is {
        let reviewStatsView: type ReviewStatsView = prompt("read the review stats projection")
        reply reviewStatsView
      }
    } with {
      briefly "Persists review commands"
      described as {
        |Handles command-driven persistence.
      }
    }
  } with {
    briefly "Review data persistence"
    described as {
      | The ReviewRepository provides persistent storage for
      | design reviews, comments, and decisions.
    }
  }
  // Projector for review analytics
  query GetReviewStats replies result ReviewStatsView is  {
    reviewStatsKey: String(1,100) with {
      briefly "Key"
      described as {
        |Identifies which review stats to retrieve.
      }
    }
  } with {
    briefly "Get review stats"
    described as {
      |Retrieves the review stats projection.
    }
  }
  result ReviewStatsView is  {
    reviewStats: ReviewAnalytics.ReviewStats with {
      briefly "Review stats"
      described as {
        |The review stats being returned.
      }
    }
  } with {
    briefly "Review stats view"
    described as {
      |Read model view carrying the review stats projection.
    }
  }
  projector ReviewAnalytics as flow is {
    outlet ReviewAnalyticsToRepository is type ReviewRepositoryCommand
    updates repository ReviewContext.ReviewRepository
    inlet ReviewAnalyticsFromReview is type ReviewEvent
    record ReviewStats is  {
      projectId: ProjectId with {
        briefly "Project"
        described as {
          |Project ID.
        }
      }
      totalReviews: Natural with {
        briefly "Reviews"
        described as {
          |Total reviews.
        }
      }
      pendingReviews: Natural with {
        briefly "Pending"
        described as {
          |Pending reviews.
        }
      }
      approvalRate: Decimal(5,2) with {
        briefly "Approval rate"
        described as {
          |Approval percentage.
        }
      }
      averageReviewTime: Duration with {
        briefly "Review time"
        described as {
          |Average review duration.
        }
      }
      averageComments: Decimal(5,2) with {
        briefly "Comments"
        described as {
          |Average comments per review.
        }
      }
    } with {
      briefly "Review statistics"
      described as {
        |Project review metrics.
      }
    }
    handler AnalyticsHandler is {
      on commentResolved: event Review.CommentResolved is {
        tell command ReviewContext.ReviewRepository.PersistCommentResolved(reviewId = commentResolved.reviewId) to repository ReviewContext.ReviewRepository
        do "apply CommentResolved to the ReviewAnalytics projection"
      }
      on commentResponded: event Review.CommentResponded is {
        tell command ReviewContext.ReviewRepository.PersistCommentResponded(reviewId = commentResponded.reviewId) to repository ReviewContext.ReviewRepository
        do "apply CommentResponded to the ReviewAnalytics projection"
      }
      on decisionRecorded: event Review.DecisionRecorded is {
        tell command ReviewContext.ReviewRepository.PersistDecisionRecorded(reviewId = decisionRecorded.reviewId) to repository ReviewContext.ReviewRepository
        do "apply DecisionRecorded to the ReviewAnalytics projection"
      }
      on reviewCancelled: event Review.ReviewCancelled is {
        tell command ReviewContext.ReviewRepository.PersistReviewCancelled(reviewId = reviewCancelled.reviewId) to repository ReviewContext.ReviewRepository
        do "apply ReviewCancelled to the ReviewAnalytics projection"
      }
      on reviewerAssigned: event Review.ReviewerAssigned is {
        tell command ReviewContext.ReviewRepository.PersistReviewerAssigned(reviewId = reviewerAssigned.reviewId) to repository ReviewContext.ReviewRepository
        do "apply ReviewerAssigned to the ReviewAnalytics projection"
      }
      on revisionRequested: event Review.RevisionRequested is {
        tell command ReviewContext.ReviewRepository.PersistRevisionRequested(reviewId = revisionRequested.reviewId) to repository ReviewContext.ReviewRepository
        do "apply RevisionRequested to the ReviewAnalytics projection"
      }
      on revisionSubmitted: event Review.RevisionSubmitted is {
        tell command ReviewContext.ReviewRepository.PersistRevisionSubmitted(reviewId = revisionSubmitted.reviewId) to repository ReviewContext.ReviewRepository
        do "apply RevisionSubmitted to the ReviewAnalytics projection"
      }
      on reviewSubmitted: event Review.ReviewSubmitted is {
        tell command ReviewContext.ReviewRepository.PersistReviewSubmitted(reviewId = reviewSubmitted.reviewId) to repository ReviewContext.ReviewRepository
        do "Update review counts"
      }
      on reviewStarted: event Review.ReviewStarted is {
        tell command ReviewContext.ReviewRepository.PersistReviewStarted(reviewId = reviewStarted.reviewId) to repository ReviewContext.ReviewRepository
        do "Update active review metrics"
      }
      on commentAdded: event Review.CommentAdded is {
        tell command ReviewContext.ReviewRepository.PersistCommentAdded(reviewId = commentAdded.reviewId) to repository ReviewContext.ReviewRepository
        do "Update comment metrics"
      }
      on reviewFinalized: event Review.ReviewFinalized is {
        tell command ReviewContext.ReviewRepository.PersistReviewFinalized(reviewId = reviewFinalized.reviewId) to repository ReviewContext.ReviewRepository
        do "Update completion metrics"
      }
    } with {
      briefly "Maintains review analytics"
      described as {
        |Projects events into analytics views.
      }
    }
  } with {
    briefly "Review analytics projections"
    described as {
      |Maintains design review analytics data.
    }
  }
  // ---- Event publication for Review ----
  type ReviewEvent is one of {
    ReviewContext.Review.ReviewSubmitted or ReviewContext.Review.ReviewerAssigned or ReviewContext.Review.ReviewStarted or ReviewContext.Review.CommentAdded or ReviewContext.Review.CommentResponded or ReviewContext.Review.CommentResolved or ReviewContext.Review.DecisionRecorded or ReviewContext.Review.RevisionRequested or ReviewContext.Review.RevisionSubmitted or ReviewContext.Review.ReviewFinalized or ReviewContext.Review.ReviewCancelled
  } with {
    briefly "Review event alternation"
    described as {
      |Union of all Review events, for streaming and event-sourced
      |persistence.
    }
  }
  processor ReviewEventSplit as flow is {
    inlet ReviewEventSplitIn is type ReviewEvent
    outlet ReviewEventSplitToReviewAnalytics is type ReviewEvent
    handler ReviewEventSplitHandler is {
      on reviewSubmitted: event Review.ReviewSubmitted is {
        send reviewSubmitted to outlet ReviewEventSplitToReviewAnalytics
        tell reviewSubmitted to entity ReviewContext.Review
      }
      on reviewerAssigned: event Review.ReviewerAssigned is {
        send reviewerAssigned to outlet ReviewEventSplitToReviewAnalytics
        tell reviewerAssigned to entity ReviewContext.Review
      }
      on reviewStarted: event Review.ReviewStarted is {
        send reviewStarted to outlet ReviewEventSplitToReviewAnalytics
        tell reviewStarted to entity ReviewContext.Review
      }
      on commentAdded: event Review.CommentAdded is {
        send commentAdded to outlet ReviewEventSplitToReviewAnalytics
        tell commentAdded to entity ReviewContext.Review
      }
      on commentResponded: event Review.CommentResponded is {
        send commentResponded to outlet ReviewEventSplitToReviewAnalytics
        tell commentResponded to entity ReviewContext.Review
      }
      on commentResolved: event Review.CommentResolved is {
        send commentResolved to outlet ReviewEventSplitToReviewAnalytics
        tell commentResolved to entity ReviewContext.Review
      }
      on decisionRecorded: event Review.DecisionRecorded is {
        send decisionRecorded to outlet ReviewEventSplitToReviewAnalytics
        tell decisionRecorded to entity ReviewContext.Review
      }
      on revisionRequested: event Review.RevisionRequested is {
        send revisionRequested to outlet ReviewEventSplitToReviewAnalytics
        tell revisionRequested to entity ReviewContext.Review
      }
      on revisionSubmitted: event Review.RevisionSubmitted is {
        send revisionSubmitted to outlet ReviewEventSplitToReviewAnalytics
        tell revisionSubmitted to entity ReviewContext.Review
      }
      on reviewFinalized: event Review.ReviewFinalized is {
        send reviewFinalized to outlet ReviewEventSplitToReviewAnalytics
        tell reviewFinalized to entity ReviewContext.Review
      }
      on reviewCancelled: event Review.ReviewCancelled is {
        send reviewCancelled to outlet ReviewEventSplitToReviewAnalytics
        tell reviewCancelled to entity ReviewContext.Review
      }
      on other is {
        error "Unexpected message for processor ReviewEventSplit"
      }
    } with {
      briefly "Review event fan-out handler"
      described as {
        |Delivers each Review event to all of its consumers.
      }
    }
  } with {
    briefly "Review event fan-out"
    described as {
      |Fans Review events out to the repository and projectors.
    }
  }
  connector 'ReviewEvent Stream' is from outlet ReviewContext.Review.ReviewEvents2 to inlet ReviewContext.ReviewEventSplit.ReviewEventSplitIn with {
    briefly "Review events, fanned out to storage and read models"
  }
  connector 'ReviewAnalytics Feed' is from outlet ReviewContext.ReviewEventSplit.ReviewEventSplitToReviewAnalytics to inlet ReviewContext.ReviewAnalytics.ReviewAnalyticsFromReview with {
    briefly "Review events feeding the ReviewAnalytics projection"
  }
  connector 'ReviewAnalytics Storage' is from outlet ReviewContext.ReviewAnalytics.ReviewAnalyticsToRepository to inlet ReviewContext.ReviewRepository.ReviewRepositoryFromReviewAnalytics with {
    briefly "ReviewAnalytics updates on their way to storage"
  }
} with {
  briefly "Bounded context for design reviews"
  described as {
    | The ReviewContext is the bounded context for design
    | review management, approval workflows, and tracking.
  }
}
